<div class="loader-new" ng-if="vm.loader"></div>
<!--<dc-left-menu></dc-left-menu>-->
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Brokerage Invoice Generation</h4>
    <sol-header></sol-header>
    <form name="brokerageInvoiceGeneration" role="form">


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-3"></div>
                    <div class="col-sm-3">
                        <label for="blaNo" class="control-label">Name of the Bond Scheme</label>
                    </div>
                    <div class="col-sm-2">
                        <input type="text" class="form-control" id="schemeCode"
                               ng-model="vm.subDesc"
                               chars="alpha-numeric" readonly required>
                    </div>
                    <div class="col-sm-3">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                           id="treasurySearch"
                           ng-click="vm.getModuleName();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.subDesc ='';"></i>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="form-group">
                    <div class="col-sm-3"></div>
                    <div class="col-sm-3">
                        <label class="control-label">Broker Agency Code</label>
                    </div>
                    <div class="col-sm-2">
                        <input type="text" class="form-control" id="brokerId"
                               ng-model="vm.brokerName"
                               chars="alpha-numeric" disabled >
                    </div>
                    <div class="col-sm-3">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch1"
                           ng-click="vm.brokerAgencyCode();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.brokerId =''; vm.brokerName = '';"></i>
                    </div>
                </div>
            </div>





        <!--From Date-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="fromDate" class="control-label">CAS Payment
                        From Date(DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-3 inner-addon right-addon">
                    <p class="input-group">
                        <input type="text" class="form-control" id="fromDate"
                               name="fromDate" ng-model="vm.fromDate"
                               uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.fromDate='';vm.fromToDateValidation();"
                               datepicker-options="vm.dateFromOptions"
                               is-open="vm.fromDatePicker.opened"
                               ng-change="vm.fromToDateValidation();" close-text="Close"
                               ng-blur="vm.textableDatePicker('fromDate',vm.fromDate);"
                               ng-keyup="vm.autoslashing('fromDate')" chars="numbers-slash"
                               required > <span class="input-group-btn" >
									<button type="button" class="btn btn-secondary"
                                            ng-click="vm.fromDatePicker.opened = true;"
                                            id="fromDateSearcher">
										<i class="glyphicon glyphicon-calendar"></i>
									</button>
								</span>
                    </p>
                </div>
            </div>
        </div>

        <!--To Date-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="toDate" class="control-label">CAS Payment
                        To Date(DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-3 inner-addon right-addon">
                    <p class="input-group">
                        <input type="text" class="form-control" id="toDate"
                               name="toDate" ng-model="vm.toDate" ng-init="vm.toDate=''"
                               uib-datepicker-popup="dd/MM/yyyy"
                               datepicker-options="vm.dateToOptions"

                               is-open="vm.toDatePicker.opened" close-text="Close"
                               maxlength="10"   ng-blur="vm.textableDatePicker('toDate',vm.toDate);"
                               ng-keyup="vm.autoslashing('toDate')" chars="numbers-slash"
                               required> <span
                            ng-hide="!vm.fromDate" class="input-group-btn">
									<button type="button" class="btn btn-secondary"
                                            id="toDateSearcher" ng-click="vm.toDatePicker.opened = true;vm.fromToDateValidation()">
										<i class="glyphicon glyphicon-calendar"></i>
									</button>
								</span>
                    </p>
                </div>
            </div>
        </div>







            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ui-sref="brokerage_invoice_generation.inquiry_detail({obj:{
                            'fromDate' : vm.fromDate,
                            'toDate' : vm.toDate,
                            'schemeCode' : vm.schemeCode,
                            'brokerId': vm.brokerId
                              }})"
                        ng-disabled="brokerageInvoiceGeneration.$invalid">Submit</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel</button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>

    </form>
</div>


<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'schemeCode'">
                                <tr>
                                    <!--                                    <th ng-click="(sortedColumn == 'schemeCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeCode';" ng-class="(sortedColumn == 'schemeCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME CODE</th>-->
                                    <th ng-click="(sortedColumn == 'subDesc')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subDesc';" ng-class="(sortedColumn == 'subDesc')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME NAME</th>
                                    <th ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME STATUS</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.schemeCode;vm.subDesc= x.subDesc;" data-bs-dismiss="modal">
                                    <!--                                    <td>{{x.schemeCode}}</td>-->
                                    <td>{{x.subDesc}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>


<!--brokerModal Modal-->
<div class="modal" id="brokerModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Broker List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.brokerTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchCustomerId" chars="alpha-numeric"ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';" ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Agency Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';" ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Name</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.brokerTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.brokerId = x.brokerName; vm.brokerName = x.brokerAgencyCode" data-bs-dismiss="modal">
                                    <td>{{x.brokerName}}</td>
                                    <td>{{x.brokerAgencyCode}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.brokerTorchList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>