
<user-left-menu></user-left-menu>
<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">User Parameters - Verify/Reject</h4>
    <form name="verDelUserParamForm" role="form">
        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>

            <tr>
                <th>Particular</th>
                <th>{{(vm.users.perviousOperation == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.users.perviousOperation == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>

            <tr>
                <td>Dormancy Period(In Days)</td>
                <td class="old-value">{{(vm.users && vm.users.dormancyPeriod)?
                    (vm.users.dormancyPeriod | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
                </td>
                <td ng-if="vm.users.perviousOperation == 'M'" class="new-value">
                    {{(vm.users && vm.users.dormancyPeriod1)?
                    (vm.users.dormancyPeriod1 | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
                </td>
            </tr>

            <tr>
                <td>No of Retries for Log in Attempts</td>
                <td class="old-value">{{(vm.users && vm.users.noOfRetries)?
                    (vm.users.noOfRetries) : ('')}}
                </td>
                <td ng-if="vm.users.perviousOperation == 'M'" class="new-value">
                    {{(vm.users && vm.users.noOfRetries1)?
                    (vm.users.noOfRetries1) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Activation Period(In Days)</td>
                <td class="old-value">{{(vm.users && vm.users.activationPeriod)?
                    (vm.users.activationPeriod) : ('')}}
                </td>
                <td ng-if="vm.users.perviousOperation == 'M'" class="new-value">
                    {{(vm.users && vm.users.activationPeriod1)?
                    (vm.users.activationPeriod1) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Maximum Acceptable Period of User inactivity</td>
                <td class="old-value">{{(vm.users && vm.users.maxAccPeriod)?
                    (vm.users.maxAccPeriod) : ('')}}
                </td>
                <td ng-if="vm.users.perviousOperation== 'M'" class="new-value">
                    {{(vm.users && vm.users.maxAccPeriod1)?
                    (vm.users.maxAccPeriod1) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Rejection Remarks</td>
                <td>{{ vm.users.remarks ? vm.users.remarks : 'Not Rejected/Verified Successfully' }}</td>
            </tr>


            </tbody>
        </table>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.users.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.users.lastModifiedBy) ? (vm.users.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.users.verifiedBy) ? (vm.users.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.users.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.users.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.users.lastModifiedDate) ? (vm.users.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.users.verifiedDate) ? (vm.users.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div  class="col-sm-offset-5 col-sm-8 form_submit">
            <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="verDelUserParamForm.$invalid" ng-click="vm.verifySubmit()">Verify</button>
            <button type="button" class="btn btn-default" id="submitButton" ng-disabled="verDelUserParamForm.$invalid" ng-click="vm.rejectReason()">Reject</button>
            <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="vm.showCancelConfirmation()">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>



    <div class="modal" id="permissionMappingDelete" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                    <h4 class="modal-title"> REJECTION REMARKS</h4>
                </div>
                <div class="modal-body">
                    <div class="loader_popup"></div>
                    <div class="list_wrapper">
                        <form name="permissionDelete" role="form">

                            <div class="row">
                                <div class="form-group">
                                    <div class="col-sm-2"></div>
                                    <label class="control-label col-sm-3">Remarks</label>
                                    <div class="col-sm-5">
                                        <!--
                                                                            <textarea class="form-control"   ng-keypress="vm.validateInput($event,'remarks')" id="remarks" name="remarks" ng-model="vm.remarks" maxlength="80" required></textarea>
                                        -->
                                        <select class="form-control list_wrapper" id="remarks[$index]"
                                                name="remarks[$index]"
                                                ng-model="vm.deleteRemark" ng-init="vm.getRemarksList();" required>
                                            <option value="">Select</option>
                                            <option ng-repeat="item in vm.remarksList"
                                                    name="{{item.subCode + parentIndex}}"
                                                    id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">
                                                {{item.subCodeDescription}}
                                            </option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-offset-5 col-sm-8 form_submit">
                                <button type="button" class="btn btn-default" data-bs-dismiss="modal"
                                        ng-disabled="permissionDelete.$invalid" ng-click="vm.deleteSubmit()">Submit
                                </button>
                                <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>
