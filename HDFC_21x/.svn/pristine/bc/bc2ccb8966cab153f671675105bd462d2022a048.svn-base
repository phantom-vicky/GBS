<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">TOC Slab Maintenance - Verify</h4>
    <sol-header></sol-header>
    <form name="tocSlabMaintenanceForm" role="form">

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="moduleName" class="control-label">Module Name</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="moduleName" name="moduleName"
                            ng-model="vm.moduleId"
                            ng-init="vm.getModuleName();" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.moduleNameList" ng-hide="item.subCode == 'ALL'" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default"
                    ui-sref="common_toc_slab_maintenance.verify_detail({obj:{
                                    moduleId: vm.moduleId
								}})"
                    ng-disabled="tocSlabMaintenanceForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/common_toc_slab_maintenance/action/inquiry';">Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
