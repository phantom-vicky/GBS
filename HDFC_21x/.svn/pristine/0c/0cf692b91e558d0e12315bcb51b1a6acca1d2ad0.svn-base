<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Transfer In From Other Bank - Verify</h4>
    <sol-header></sol-header>
    <div class="col-sm-3">
        <div class="form-group">
            <label>
                Show
                <select class="form-control record-filter" ng-model="vm.itemsPerPage">
                    <option value='5'>5</option>
                    <option value='10'>10</option>
                    <option value='25'>25</option>
                    <option value='50'>50</option>
                </select>
                records per page
            </label>
        </div>
    </div>
    <div class="col-sm-3 pull-right-search">
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-addon"><i class="glyphicon glyphicon-search"></i></div>
                <input type="text" class="form-control" ng-model="search" placeholder="Search"  chars="alpha-numeric"chars="alpha-numeric">
            </div>
        </div>
    </div>

    <table class="table table-bordered table-striped list">
        <thead>
        <!--        <tr>-->
        <!--            <th colspan="11" class="form_heading feature-heading">-->
        <!--                <div style="display: flex; justify-content: space-between; align-items: center;">-->
        <!--                    <span style="text-align: center; flex-grow: 1;">BLA Opening Cum Subscription – Verify/Reject</span>-->
        <!--                </div>-->
        <!--            </th>-->

        <!--        </tr>-->
        <tr>
            <th>S No</th>
            <th>Name of the Holder</th>
            <th>Holder Pan No / First Holder PAN No</th>
            <th>Scheme Name</th>
            <th>Mode of Holding</th>
            <th>BLA No</th>
            <th>Subscription Id</th>
            <th>Bond Type</th>
            <th>Created / Modified</th>
            <th class="hidden">Scheme Code</th>
            <th>Action Button</th>
        </tr>
        </thead>
        <tbody>
        <tr dir-paginate="item in vm.getVerifyDetails | filter:search | itemsPerPage:vm.itemsPerPage">
            <td>{{$index + 1}}</td>
            <td>{{item.nameOfTheBondHolder}}</td>
            <td width="10%">{{item.PanNum}}</td>
            <td>{{item.schemeName}}</td>
            <td>{{item.modeOfHolding}}</td>
            <td width="12%">{{item.blaNo}}</td>
            <td width="12%">{{item.subscriptionId}}</td>
            <td>{{item.jointHolderType}}</td>
            <td>{{item.createModifyBy}}</td>
            <td class="hidden">{{item.schemeCode}}</td>

            <td>
                <i class="glyphicons-regular glyphicons-user-structure"
                   style="cursor:pointer;"
                   ui-sref="rbi_bond_transfer_in.verify_detail({obj:{
            schemeCode: item.schemeCode,
            schemeName: item.schemeName,
            blaNo: item.blaNo,
            modeOfHolding: item.modeOfHolding,
            subscriptionId: item.subscriptionId
      }})"
                   title="Manage Roles"></i>
            </td>
        </tr>
        </tbody>
    </table>

    <!-- Pagination Controls -->
    <dir-pagination-controls direction-links="true" boundary-links="true"></dir-pagination-controls>

    <!-- No Records Message -->
</div>






