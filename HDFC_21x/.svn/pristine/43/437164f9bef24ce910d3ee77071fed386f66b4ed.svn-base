    @Column(name = "ACCOUNT_OPEN_DATE")
    private String ACCOUNTOPENDATE;

    @Column(name = "FIRST_JOINT_HLDR_NAME")
    private String FIRSTJOINTHLDRNAME;

    public String getBONDSUBSCRIPTIONID() {
        return BONDSUBSCRIPTIONID;
    }

    public void setBONDSUBSCRIPTIONID(String BONDSUBSCRIPTIONID) {
        this.BONDSUBSCRIPTIONID = BONDSUBSCRIPTIONID;
    }

    @Column(name = "BOND_SUBSCRIPTION_ID")
    private String BONDSUBSCRIPTIONID;



    public String getFIRSTJOINTHLDRNAME() {
        return FIRSTJOINTHLDRNAME;
    }

    public void setFIRSTJOINTHLDRNAME(String FIRSTJOINTHLDRNAME) {
        this.FIRSTJOINTHLDRNAME = FIRSTJOINTHLDRNAME;
    }

    public String getACCOUNTOPENDATE() {
        return ACCOUNTOPENDATE;
    }

    public void setACCOUNTOPENDATE(String ACCOUNTOPENDATE) {
        this.ACCOUNTOPENDATE = ACCOUNTOPENDATE;
    }

    public String getCUSTOMERNAME() {
        return CUSTOMERNAME;
    }

    public void setCUSTOMERNAME(String CUSTOMERNAME) {
        this.CUSTOMERNAME = CUSTOMERNAME;
    }

    public String getBONDHOLDERNAME() {
        return BONDHOLDERNAME;
    }

    public void setBONDHOLDERNAME(String BONDHOLDERNAME) {
        this.BONDHOLDERNAME = BONDHOLDERNAME;
    }

    public String getMODEOFHOLDING() {
        return MODEOFHOLDING;
    }

    public void setMODEOFHOLDING(String MODEOFHOLDING) {
        this.MODEOFHOLDING = MODEOFHOLDING;
    }

    public String getBONDSUBCRIPTIONAMOUNT() {
        return BONDSUBCRIPTIONAMOUNT;
    }

    public void setBONDSUBCRIPTIONAMOUNT(String BONDSUBCRIPTIONAMOUNT) {
        this.BONDSUBCRIPTIONAMOUNT = BONDSUBCRIPTIONAMOUNT;
    }

    public String getSUBCRIPTIONDATE() {
        return SUBCRIPTIONDATE;
    }

    public void setSUBCRIPTIONDATE(String SUBCRIPTIONDATE) {
        this.SUBCRIPTIONDATE = SUBCRIPTIONDATE;
    }

    public String getMODEOFINTERESTPAYMENT() {
        return MODEOFINTERESTPAYMENT;
    }

    public void setMODEOFINTERESTPAYMENT(String MODEOFINTERESTPAYMENT) {
        this.MODEOFINTERESTPAYMENT = MODEOFINTERESTPAYMENT;
    }

    public String getCREAATEDDATE() {
        return CREATEDDATE;
    }

    public void setCREAATEDDATE(String CREAATEDDATE) {
        this.CREATEDDATE = CREAATEDDATE;
    }

    public String getSINGLEBONDLEDGERACCOUNTNUMBER() {
        return SINGLEBONDLEDGERACCOUNTNUMBER;
    }

    public void setSINGLEBONDLEDGERACCOUNTNUMBER(String SINGLEBONDLEDGERACCOUNTNUMBER) {
        this.SINGLEBONDLEDGERACCOUNTNUMBER = SINGLEBONDLEDGERACCOUNTNUMBER;
    }

    public String getFIRSTJOINTHOLDERBLANO() {
        return FIRSTJOINTHOLDERBLANO;
    }

    public void setFIRSTJOINTHOLDERBLANO(String FIRSTJOINTHOLDERBLANO) {
        this.FIRSTJOINTHOLDERBLANO = FIRSTJOINTHOLDERBLANO;
    }

    public String getGBMTRANID() {
        return GBMTRANID;
    }

    public void setGBMTRANID(String GBMTRANID) {
        this.GBMTRANID = GBMTRANID;
    }

    public String getID() {
        return ID;
    }

    public void setID(String ID) {
        this.ID = ID;
    }


    public String getBRANCHID() {
        return BRANCHID;
    }

    public void setBRANCHID(String BRANCHID) {
        this.BRANCHID = BRANCHID;
    }

    public String getGBMTRANREFID() {
        return GBMTRANREFID;
    }

    public void setGBMTRANREFID(String GBMTRANREFID) {
        this.GBMTRANREFID = GBMTRANREFID;
    }

    public String getSCHCODE() {
        return SCHCODE;
    }

    public void setSCHCODE(String SCHCODE) {
        this.SCHCODE = SCHCODE;
    }
