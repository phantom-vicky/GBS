                                        (vm.getSubscriptionDetails.C038.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C038? (vm.getSubscriptionDetails.C038.newValue) : ('')}}
