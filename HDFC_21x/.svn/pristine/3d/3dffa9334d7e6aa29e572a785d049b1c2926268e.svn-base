package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class DataCopersondetails {
    private String coparcenersName;
    private String coparcenersRelation;
    private String coparcenersDob;

    public String getCoparcenersName() {
        return coparcenersName;
    }

    public void setCoparcenersName(String coparcenersName) {
        this.coparcenersName = coparcenersName;
    }

    public String getCoparcenersRelation() {
        return coparcenersRelation;
    }

    public void setCoparcenersRelation(String coparcenersRelation) {
        this.coparcenersRelation = coparcenersRelation;
    }

    public String getCoparcenersDob() {
        return coparcenersDob;
    }

    public void setCoparcenersDob(String coparcenersDob) {
        this.coparcenersDob = coparcenersDob;
    }
}