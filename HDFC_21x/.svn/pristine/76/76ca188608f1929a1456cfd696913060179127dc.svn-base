<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <form name="blaForm" role="form">
        <h4 class="form_heading">BOND Freeze / Un-Freeze ADD</h4>
        <sol-header></sol-header>
        <div class="container from_wrapper new_form_wrapper" ng-if="vm.responseResultForAdd.length>0">
            <div class="row">
                <div class="col-sm-12">
                    <table class="table table-bordered table-striped list old-new-value-table">
                        <thead>
                        <tr>
                            <td width="50%">Name of the Bond Scheme</td>
                            <td width="50%">
                                <label class="data-bind" id="blaNo"
                                       ng-model="vm.addList.bondHolderName">{{vm.schemeName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">PAN No</td>
                            <td width="50%">
                                <label class="data-bind" id="panNo">{{vm.panNoName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required"><label class="control-label">Does the principal
                                amount need to be frozen?</label></td>
                            <td width="50%" class="form-group required">
                                <label>
                                    <input type="radio" name="principal_freeze" ng-model="vm.amountFreeze" value="Y"
                                           required> Yes
                                </label>
                                <label>
                                    <input type="radio" name="principal_freeze" ng-model="vm.amountFreeze" value="N"
                                           required> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required"><label class="control-label">Does the Interest
                                Payment need to be frozen?</label></td>

                            <td width="50%" class="form-group required">

                                <label>
                                    <input type="radio" name="Interest_freeze" ng-model="vm.interestFreeze" value="Y"
                                           required> Yes
                                </label>
                                <label>
                                    <input type="radio" name="Interest_freeze" ng-model="vm.interestFreeze" required
                                           value="N"> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required">Is transferring out from another bank allowed?
                            </td>
                            <td width="50%" class="form-group required">
                                <label>
                                    <input type="radio" name="transferring_freeze" ng-model="vm.transferAnotherBank"
                                           value="Y" required> Yes
                                </label>
                                <label>
                                    <input type="radio" name="transferring_freeze" ng-model="vm.transferAnotherBank"
                                           value="N" required> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required">
                                <label class="control-label">Maker Reason</label>
                            </td>
                            <td width="50%">
                    <textarea class="form-control required" rows="3" maxlength="200" id="remarks" name="remarks"
                              ng-model="vm.remarks" required
                              ng-keypress="vm.validateInput($event,'remarks')"
                              ng-paste="vm.validatePaste($event,'remarks')"></textarea>
                            </td>
                        </tr>
                    </table>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list nowrap table-textWrap">
                            <thead>
                            <th>Name of the Holder</th>
                            <th>DOB</th>
                            <th>BLA No</th>
                            <th>Subscription ID</th>
                            <th>Bond Type</th>
                            <th>Subscription Amount</th>
                            <th>Account Open Date</th>
                            <th>Maturity Date</th>
                            <th>Last Interest Paid</th>
                            </thead>
                            <tbody>
                            <tr ng-repeat="items in vm.responseResultForAdd">
                                <td>{{items.name}}</td>
                                <td>{{items.dob}}</td>
                                <td>{{items.blaNo}}</td>
                                <td>{{items.subscriptionId}}</td>
                                <td>{{items.bondType}}</td>
                                <td>{{vm.indianNumberFormat(items.subscriptionAmount)}}</td>
                                <td>{{items.accountOpenDate}}</td>
                                <td>{{items.maturityDate}}</td>
                                <td>{{items.lastInterestPaid}}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="blaForm.$invalid" ng-click="vm.addSubmit()">Submit
            </button>
            <button type="button" id="cancelButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/freeze_unfreeze/add';">Cancel
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>





