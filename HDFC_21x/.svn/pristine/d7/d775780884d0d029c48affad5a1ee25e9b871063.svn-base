                                           placeholder="Enter PAN Number" maxlength="10"
                                           ng-pattern="/^[A-Z0-9]*$/" required />
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </ng-form>-->
<!--            </div>-->

            <!--            <div class="row">-->
            <!--                <div class="form-group required">-->
            <!--                    <div class="col-sm-6">-->
            <!--                        <label for="closureType" class="control-label">Whether Penalty is to be recovered? Yes/No</label>-->
            <!--                    </div>-->

            <!--                    <div class="col-sm-4">-->
            <!--                        <select class="form-control"  name="penalityToBeRecovered" id="penalityToBeRecovered" ng-model="vm.penalityToBeRecovered"  required>-->
            <!--                            <option value="">Select</option>-->
            <!--                            <option  value="Y" >YES</option>-->
            <!--                            <option  value="N" >NO</option>-->
            <!--                        </select>-->
            <!--                    </div>-->
            <!--                </div>-->
            <!--            </div>-->
            <!--								penalityToBeRecovered : vm.penalityToBeRecovered,-->

            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ui-sref="rbi_bond_sub_acc_closure_on_matur_death.add_detail({obj:{
								blaNo: vm.blaNo,
								boSubsId : vm.boSubsId,
								schemeCode : vm.schemeCode,
								proceedsToBePaid : vm.proceedsToBePaid,
								closureType : vm.closureType,
								schemeName : vm.schemeName,
								legalHeirsDetailsList : vm.legalHeirsDetailsList,
								nomineeDetailsList : vm.nomineeDetailsList,
								panNumber : vm.panNumber
								}})"
                        ng-disabled="vm.panValid">Submit</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel</button>
                <button type="button" class="btn btn-primary" id="panValidation"
                        ng-click="vm.getPanValidation()"
                        ng-disabled="bondSubAccClosureForm.$invalid &&  vm.panValid">Pan Validation
                </button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>



<div class="modal" id="bondSubsIdSearch" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Subscription ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.bondSubsList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'boSubsId'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Holder Name</th>
                                    <th ng-click="(sortedColumn == 'boSubsId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'boSubsId';" ng-class="(sortedColumn == 'boSubsId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Subscription ID</th>
                                    <th ng-click="(sortedColumn == 'maturityDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'maturityDate';" ng-class="(sortedColumn == 'subsAmt')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Maturity Date</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.bondSubsList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.boSubsId = x.boSubsId;" data-bs-dismiss="modal">

                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.boSubsId}}</td>
                                    <td>{{x.maturityDate}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.bondSubsList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>



<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" dat a-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Ledger Account Number List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <!--                                    <th ng-click="(sortedColumn == 'holderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>-->
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                    <th ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';" ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verified status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaDataList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo= x.blaNo;vm.modeOfHolding = x.modeOfHolding;vm.nameOfTheBondHolder=x.bondHolderName;vm.holderType = x.holderType;vm.modeOfHoldingCode = x.modeOfHoldingCode" data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <!--                                    <td>{{x.holderType}}</td>-->
                                    <td>{{x.modeOfHolding}}</td>
                                    <td>{{x.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>




<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'schemeCode'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME NAME</th>
                                    <th ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">STATUS</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.schemeCode;vm.schemeName= x.schemeName;" data-bs-dismiss="modal">
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->

<div class="modal" id="panNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN Details</h4>
            </div>
            <div class="modal-body">
                <div class="list_wrapper" ng-if="vm.panNumberDetailList.length>0">
                    <div class="list_wrapper">
                        <div class="col-sm-8 form_submit">
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </div>
                                    <input type="text" class="form-control"
                                           ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                           placeholder="Search">
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-sm-12">

                                <table class="table table-bordered list scroll sort">

                                    <thead ng-init="reverseOrder = false; sortedColumn = 'panNo'">
                                    <tr>
                                        <th width="50%" class="modal-title title-case" ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';" ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN Number</th>
                                        <th width="50%" class="modal-title title-case" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Customer Name</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr class="cp"
                                        ng-repeat="x in vm.panNumberDetailList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                        data-bs-dismiss="modal"
                                        ng-click="vm.panNumber = x.panNo;">
                                        <td width="50%">{{x.panNo}}</td>
                                        <td width="50%">{{x.bondHolderName}}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                    <div class="list_wrapper" ng-if="vm.panNumberDetailList.length==0">No records found to display.</div>
                </div>

            </div>
        </div>
    </div>
</div>
