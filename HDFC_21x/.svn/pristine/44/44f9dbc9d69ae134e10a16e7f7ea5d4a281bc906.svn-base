                <div class="col-sm-2">
                    <input type="text" class="form-control" id="spreadRate"
                        ng-keypress="vm.handlePercentageInput($event);"
                        oninput="this.value = this.value.replace(/[^0-9.]/g, '')"
                        ng-change="vm.firstCharDotServiceRate(); vm.validatePercentageValue('C031');"
                        ng-model="vm.cbdtSchemeParameter.C031.oldValue" required />
