<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">E-TDS Report</h4>
  <sol-header></sol-header>

  <form name="ETDSReportForm" role="form">
    <!--Module name-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-2">
          <label><b>RBI Bond</b></label>
        </div>
      </div>
    </div>

    <!--FROM DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">From Date</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
                    type="text"
                    class="form-control"
                    id="efffromDate1"
                    name="efffromDate"
                    ng-model="vm.fromDate"
                    uib-datepicker-popup="dd/MM/yyyy"
                    ng-init="vm.fromDate=''; vm.fromDateVal()"
                    ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
                    datepicker-options="vm.fromDateOptions"
                    is-open="vm.efffromDatePicker.opened"
                    close-text="Close"
                    maxlength="10"
                    ng-blur="vm.textableDatePicker('efffromDate1',vm.fromDate)"
                    ng-keyup="vm.autoslashing('efffromDate1')"
                    chars="numbers-slash"
                    required
            />
            <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.efffromDatePicker.opened = true" id="efffromDateSearcher1">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--TO DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">To Date</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
                    type="text"
                    class="form-control"
                    id="efftoDate"
                    name="efftoDate"
                    ng-model="vm.toDate"
                    uib-datepicker-popup="dd/MM/yyyy"
                    ng-init="vm.toDate=''"
                    datepicker-options="vm.toDateOptions"
                    is-open="vm.efftoDatePicker.opened"
                    close-text="Close"
                    maxlength="10"
                    ng-blur="vm.textableDatePicker('efftoDate',vm.toDate)"
                    ng-keyup="vm.autoslashing('efftoDate')"
                    chars="numbers-slash"
                    required
            />
            <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.efftoDatePicker.opened = true" id="efftoDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>
    <!--Submit & Cancel Button-->
    <div class="text-center form_submit">
      <button
        type="submit"
        id="submitButton"
        class="btn btn-default"
        ui-sref="e-tds_report.inquiry_details({obj:{
                             fromDate :vm.fromDate,
                             toDate: vm.toDate,
                        }})"
        ng-disabled="ETDSReportForm.$invalid"
      >
        Submit
      </button>
      <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
    </div>
    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>
