<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.model">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!';" id="homeButton">Home</button>
        <button type="button" id="backButton" class="btn btn-cancel"
                onclick="window.location.href='#!/appendix_ii_register_of_bla_all_holders/action/inquiry';">Back</button>
        <button type="submit" class="btn btn-default"
                id="printButton" ng-click="vm.printpage();">Print</button>
    </div>
    <div class="container from_wrapper new_form_wrapper" id="section-to-print">
        <div class="row">
            <sol-header></sol-header>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                           ui-jq="dataTable" ui-options="vm.dataTableOption">
                        <thead>
                        <tr>
                            <th style="border: none;text-align: center;" colspan="7"><p>Register of Bond Ledger Accounts - All holders</p></th>
                        </tr>
                        <tr>
                            <th style="border: none;border-bottom: 1px solid black;text-align: center;" colspan="7">
                                <p>For the period from {{vm.fromDate | date:"dd/MM/yyyy"}} to {{vm.toDate | date:"dd/MM/yyyy"}}</p>
                            </th>
                        </tr>
                        <tr>
                            <th style="border: none;text-align: left;" colspan="7"><p>Name of the Receiving Office : {{vm.bankName}}</p></th>
                        </tr>
                        <tr>
                            <th style="border: none;text-align: left;" colspan="7"><p>Name of the Branch: {{vm.branchName}}</p></th>
                        </tr>
                        <tr class="thalign">
                            <th></th>
                            <th colspan="2">Investment</th>
                            <th colspan="2">Repayment</th>
                            <th colspan="2">Progressive Total</th>
                        </tr>
                        <tr class="thalign">
                            <th>Date of Transaction</th>
                            <th>No. of Accounts</th>
                            <th>Amount</th>
                            <th>No. of Accounts</th>
                            <th>Amount</th>
                            <th>No. of Accounts</th>
                            <th>Amount</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="x in vm.model">
                            <td align="center">{{x.dateOfTransaction}}</td>
                            <td align="center">{{x.noOfInvestmentAcc}}</td>
                            <td align="right">{{x.totInvestmentAmt}}</td>
                            <td align="center">{{x.noOfRepayAcc}}</td>
                            <td align="right">{{x.noOfRepayAmt}}</td>
                            <td align="center">{{x.totAcc}}</td>
                            <td align="right">{{x.totAmt}}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="button" class="btn btn-cancel"
                    onclick="window.location.href='#!/appendix_ii_register_of_bla_all_holders/action/inquiry';">Cancel</button>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Appendix II - Register of BLA - All Holders</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-cancel"
                    onclick="window.location.href='#!/appendix_ii_register_of_bla_all_holders/action/inquiry';">Back</button>
        </center>
    </div>
</div>
