<left-menu-directive></left-menu-directive>
<div class="loader-new" ng-show="loader"></div>
<div class="container from_wrapper" ng-if="displayForm == true">
	<h4 class="form_heading  feature-heading">List Of Transaction Codes - {{action}}</h4>
	<div  ng-if="action == 'modify' || action == 'add'">
		<notice-message-directive ></notice-message-directive>
	</div>
	<form name="transactionCodesForm" role="form" ng-submit="submitForm(transactionCodesForm.$valid)" novalidate>
		<div class="row">
			<div class="form-group" ng-class="requiredClass">
			<div class="col-sm-3"></div>
				<label for="clgTranCode" class="control-label col-sm-3">Clearing Transaction Code</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="clgTranCode" id="clgTranCode" ng-model="transactionCodesList.clgTranCode" maxlength="5" required ng-if="action == 'modify' || action == 'add'">
					<label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.clgTranCode}}</label>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="clgTranCodeDesc" class="control-label col-sm-3">Transaction Code Description</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="clgTranCodeDesc" id="clgTranCodeDesc" ng-model="transactionCodesList.clgTranCodeDesc" maxlength="40" ng-if="action == 'modify' || action == 'add'">
	                <label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.clgTranCodeDesc}}</label>			
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="instrumentType" class="control-label col-sm-3">Type of Instrument</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="instrumentType" id="instrumentType" ng-model="transactionCodesList.instrumentType" maxlength="5" ng-if="action == 'modify' || action == 'add'">
					<label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.instrumentType}}</label>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText1" class="control-label col-sm-3">Additional Text1</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText1" id="addText1" ng-model="transactionCodesList.addText1" maxlength="40" ng-if="action == 'modify' || action == 'add'">
					<label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.addText1}}</label>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText2" class="control-label col-sm-3">Additional Text2</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText2" id="addText2" ng-model="transactionCodesList.addText2" maxlength="40" ng-if="action == 'modify' || action == 'add'">
					<label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.addText2}}</label>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText3" class="control-label col-sm-3">Additional Text3</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText3" id="addText3" ng-model="transactionCodesList.addText3" maxlength="40" ng-if="action == 'modify' || action == 'add'">
					<label ng-if="action == 'delete' || action == 'verify' || action == 'inquiry'">: {{transactionCodesList.addText3}}</label>
				</div>
			</div>
		</div>
		<div class="row">
			 <div class="col-sm-offset-5 col-sm-8 form_submit">
				 <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="transactionCodesForm.$invalid" ng-if="action == 'add'">Submit</button>
				 <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="transactionCodesForm.$invalid" ng-if="action == 'modify'">Update</button>
				 <button type="button" class="btn btn-default" id="submitButton" ng-click="verify(transactionCodesList.id)" ng-disabled="transactionCodesForm.$invalid" ng-if="action == 'verify'">Verify</button>
				 <button type="button" class="btn btn-default" id="submitButton" ng-click="delete(transactionCodesList.id)" ng-disabled="transactionCodesForm.$invalid" ng-if="action == 'delete'">Delete</button>
				 <button type="button" class="btn btn-default" id="submitButton" ng-click="inquiry(transactionCodesList.id)" ng-disabled="transactionCodesForm.$invalid" ng-if="action == 'inquiry'">Back</button>
				 
				 <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="cancelOperation(action)" >Cancel</button>
			</div>
		</div>
	</form>
</div>


<div class="container list_wrapper" ng-if="baseRecordList.length > 0">
 <h4 class="feature-heading">List Of Transaction Codes - {{action}}</h4>
 <div class="col-sm-3">
			<div class="form-group">
				<label>
				Show
					<select class="form-control record-filter" ng-model="itemsPerPage" id="itemsPerPage" name="itemsPerPage"  ng-change="setItemsPerPage(itemsPerPage)" >
						<option value='5'>5</option>
						<option value='10'>10</option>
						<option value='25'>25</option>
						<option value='50'>50</option>
					</select>
				records per page
				</label>
			</div>
		</div>
		<div class="col-sm-3 pull-right">				    
			  <div class="form-group">
			   <div class="input-group">
					      <div class="input-group-addon"><i class="glyphicon glyphicon-search"></i></div>
					      <input type="text" class="form-control" ng-model="searchKeyword" ng-change="searchInquiryFn(searchKeyword)" placeholder="Search">
					    </div>
			  </div>
		</div>
		<div ng-if="totalItems > 0">
		<table class="table table-bordered table-striped list" >
			<thead>
				<tr>
					<th>Clearing Transaction Code</th>
					<th>Clearing Transaction Code Desc</th>
					<th>Type of Instrument</th>
					<th>Scheme Code</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th style="width: 100px;">Status</th>
					<th>Created Date</th>
					<th ng-if="action" class="capitalize">{{action}}</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in recordsList.slice(((currentPage-1)*itemsPerPage), ((currentPage)*itemsPerPage))">
					<td>{{item.clgTranCode}}</td>
					<td>{{item.clgTranCodeDesc}}</td>
					<td>{{item.instrumentType}}</td>
					<td>{{item.schemeCode}}</td>
					<td>{{item.addText1}}</td>
					<td>{{item.addText2}}</td>
					<td>{{item.addText3}}</td>
					<td ng-if="item.isVerified == true">Verified</td>
					<td ng-if="item.isVerified == false">Unverified</td>
					<td>{{item.createdDate}}</td>
					<td ng-if="action=='modify'"><i class="glyphicon glyphicon-edit cp" ng-click="modifyForm(item.id)"></i></td>
					<td ng-if="action=='verify'"><i class="glyphicon glyphicon-ok cp" ng-click="verifyForm(item.id)"></i></td>
					<td ng-if="action=='delete'"><i class="glyphicon glyphicon-remove cp" ng-click="deleteForm(item.id)"></i></td>
					<td ng-if="action=='inquiry'"><i class="glyphicon glyphicon-search cp" ng-click="inquiryForm(item.id)"></i></td>
				</tr>
			</tbody>
		</table>
		<ul uib-pagination total-items="totalItems" ng-model="currentPage" max-size="maxSize" class="pagination-sm" boundary-links="true" force-ellipses="true" items-per-page="itemsPerPage"></ul>
		</div>
		<div class="list_wrapper no_records_message padding-top-50" ng-if="totalItems <= 0">No records matched with<i>"{{searchKeyword}}"</i>.</div>
		
</div>
<div class="container list_wrapper" ng-if="baseRecordList.length <= 0 && loader == false && displayForm == false">
	<h4 class="feature-heading">List Of Transaction Codes - {{action}}</h4>
	<div class="no_records_message">No records found to display.</div>
</div>