                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.getDetails.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.getDetails.previousOperationType == 'M'">New Value</th>
                                </tr>
                                <tr>
                                    <td>Co-Person Name</td>
                                    <td class="old-value">{{(item && item.C004)?
                                        (item.C004.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{item &&
                                        item.C004? (item.C004.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Relationship with Karta</td>
                                    <td class="old-value">{{(item && item.C005)?
                                        (item.C005.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{item &&
                                        item.C005? (item.C005.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>DOB</td>
                                    <td class="old-value">{{(item && item.C006)?
                                        (item.C006.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{item &&
                                        item.C006? (item.C006.newValue) : ('')}}
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-bordered table-striped list old-new-value-table" ng-if="vm.getDetails.masterDetailsValueModel[0].C016.oldValue == 'Y' || vm.getDetails.masterDetailsValueModel[0].C016.newValue == 'Y'">
                                <thead>
                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.getDetails.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.getDetails.previousOperationType == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>
                                <h4 class="form_heading" ng-if="vm.getDetails.masterDetailsValueModel[0].C016.oldValue == 'Y' || vm.getDetails.masterDetailsValueModel[0].C016.newValue == 'Y'">GUARDIAN DETAILS</h4>
                                <div>
                                    <tr>
                                        <td>Guardian ID</td>
