<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>

<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">Brokerage Invoice And Email Body Letter</h4>
  <sol-header></sol-header>

  <form name="brokerageInvoiceEmailBodyLetter" role="form">
    <!--Name of the Bond Scheme Field-->

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-5">
          <label><b>RBI Bond</b></label>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Bond Scheme</label>
        </div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="schemeCode" ng-model="vm.subDesc" chars="alpha-numeric" readonly required />
        </div>
        <div class="col-sm-3">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode" id="treasurySearch" ng-click="vm.getModuleName();"></i>
          <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.subDesc =''; vm.toDate='';vm.invoiceType='';vm.brokerId='';vm.fromDate='';"></i>
        </div>
      </div>
    </div>

    <!--Type Of Invoice-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Type Of Invoice</label>
        </div>
        <div class="col-sm-2" data-ng-init="vm.getInvoiceType()">
          <select class="form-control" id="month" name="invoice" ng-model="vm.invoiceType" ng-init="vm.invoiceIn=''" required>
            <option value="">Select</option>
            <option ng-repeat="item in vm.InvoiceType" value="{{item.invoiceType}}" data-ng-bind="item.invoiceType"></option>
          </select>
        </div>
      </div>
    </div>

    <!--Broker Agency Code Field-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Broker Agency Code</label>
        </div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="brokerId" ng-model="vm.brokerId" chars="alpha-numeric" disabled />
        </div>
        <div class="col-sm-3">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="treasurySearch1" ng-click="vm.brokerAgencyCode()"></i>
          <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.brokerId =''; vm.brokerName = '';"></i>
        </div>
      </div>
    </div>

    <!--Payment From Date Field-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Payment From Date(DD/MM/YYYY)</label>
        </div>
        <div class="col-sm-2 inner-addon right-addon">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="effFromDate1"
              name="effFromDate"
              ng-model="vm.fromDate"
              uib-datepicker-popup="dd/MM/yyyy"
              ng-init="vm.fromDate=''; vm.fromDateVal()"
              datepicker-options="vm.fromDateOptions"
              is-open="vm.effFromDatePicker.opened"
              ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
              close-text="Close"
              maxlength="10"
              ng-blur="vm.textableDatePicker('effFromDate1',vm.fromDate)"
              ng-keyup="vm.autoslashing('effFromDate1')"
              chars="numbers-slash"
              required
            />
            <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.effFromDatePicker.opened = true;" id="fromDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--Payment To Date Field-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Payment To Date(DD/MM/YYYY)</label>
        </div>
        <div class="col-sm-2 inner-addon right-addon">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="effToDate"
              name="effToDate"
              ng-model="vm.toDate"
              ng-init="vm.toDate=''"
              uib-datepicker-popup="dd/MM/yyyy"
              datepicker-options="vm.toDateOptions"
              is-open="vm.effToDatePicker.opened"
              close-text="Close"
              maxlength="10"
              ng-blur="vm.textableDatePicker('effToDate',vm.toDate)"
              ng-keyup="vm.autoslashing('effToDate')"
              chars="numbers-slash"
              required
            />
            <span ng-hide="!vm.fromDate" class="input-group-btn">
              <button type="button" class="btn btn-secondary" id="effToDateSearcher" ng-click="vm.effToDatePicker.opened = true">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--Submit & Cancel Button-->
    <div class="text-center form_submit">
      <button
        type="submit"
        class="btn btn-default"
        id="submitButton"
        ui-sref="brokerage_invoice_and_email_body_letter.inquiry_details({obj:{
                            'fromDate' : vm.fromDate,
                            'toDate' : vm.toDate,
                            'schemeCode' : vm.schemeCode,
                            'schemeName' : vm.subDesc,
                            'brokerId': vm.brokerId,
                            'invoiceType': vm.invoiceType,
                              }})"
        ng-disabled="brokerageInvoiceEmailBodyLetter.$invalid"
      >
        Submit
      </button>
      <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href='#!/rbibond_gu_functionality'">Cancel</button>
    </div>
    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>

<!-- Scheme Modal -->
<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.modalSearch=''">&times;</button>
        <h4 class="modal-title">Scheme Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input type="text" class="form-control" ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="">
                <thead ng-init="reverseOrder=true;sortedColumn = 'subDesc'">
                  <tr>

                    <th scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Scheme Name
                    </th>
                    <th scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder" ng-click="vm.schemeCode = x.schemeCode; vm.subDesc = x.schemeName;" data-bs-dismiss="modal">
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemestatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="brokerModal" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchCustomerId=''">&times;</button>
        <h4 class="modal-title">Broker List</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.brokerTorchList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input type="text" class="form-control" ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''" placeholder="Search" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll" aria-label="">
                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                  <tr>
                    <th scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'brokerId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerId';"
                      ng-class="(sortedColumn == 'brokerId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Agency Code
                    </th>
                    <th scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';"
                      ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Name
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" ng-repeat="x in vm.brokerTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder" ng-click="vm.brokerId = x.brokerCode; vm.brokerName = x.brokerName" data-bs-dismiss="modal">
                    <td>{{x.brokerCode}}</td>
                    <td>{{x.brokerName}}</td>
                    <td>{{x.branchId}}</td>
                    <td>{{x.verifyStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.brokerTorchList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>
