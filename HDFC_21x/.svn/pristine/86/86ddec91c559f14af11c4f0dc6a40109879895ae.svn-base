<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">BOND SUBSCRIPTION ACCOUNT CLOSURE BEFORE MATURITY - DEATH - inquiry</h4>


    <form name="vm.bondClosureBefMaturForm" role="form">
        <table class="table table-bordered">
            <h5 class="form_heading">BOND HOLDER DETAILS</h5>

            <tbody>
            <tr>
                <td width="25%">Name of the Bond Scheme</td>
                <td width="25%">
                    <label class="data-bind" id="bondScheme">{{vm.schemeName}}</label>
                </td>
                <td width="25%">Mode of Holding</td>
                <td width="25%">
                    <label class="data-bind" id="modeOfHolding">{{vm.blaDetails.modeOfHolding}}</label>
                </td>
            </tr>
            <tr>
                <td width="25%">BLA Number</td>
                <td width="25%">
                    <label class="data-bind" id="blaNo">{{vm.blaNo}}</label>
                </td>

                <td width="25%"> Holder Type</td>
                <td width="25%">
                    <label class="data-bind" id="holderType">{{vm.blaDetails.holderType}}</label>
                </td>

            </tr>


            <tr ng-if="vm.blaDetails.modeOfHoldingCode=='MH003' || vm.blaDetails.modeOfHoldingCode=='MH002'">
                <td width="25%">First Joint Bond Holder BLA No</td>
                <td width="25%">
                    <label class="data-bind" id="joinBlaNo">{{vm.blaDetails.firstJointBondHolderBLA}}</label>
                </td>
                <td width="25%">First Joint Bond Holder Name</td>
                <td width="25%">
                    <label class="data-bind" id="firstJointHolderName">{{vm.blaDetails.firstJointBondHolderName}}</label>
                </td>
            </tr>
            <tr ng-if="vm.blaDetails.modeOfHoldingCode=='MH003' || vm.blaDetails.modeOfHoldingCode=='MH002'">
                <td width="25%">Second Joint Bond Holder BLA No</td>
                <td width="25%" >
                    <label class="data-bind" id="secJointHolderBlaNo">{{vm.blaDetails.secondJointBondHolderBLA}}</label>
                </td>
                <td width="25%">Second Joint Bond Holder Name</td>
                <td width="25%">
                    <label class="data-bind" id="secJointHolderName">{{vm.blaDetails.secondJointBondHolderName}}</label>
                </td>
            </tr>

            <tr>

                <td width="25%" ng-if="vm.blaDetails.modeOfHoldingCode=='MH001' || vm.blaDetails.modeOfHoldingCode=='MH004' || vm.blaDetails.modeOfHoldingCode=='MH005'">Bond Holder Name</td>
                <td width="25%" ng-if="vm.blaDetails.modeOfHoldingCode=='MH001' || vm.blaDetails.modeOfHoldingCode=='MH004' || vm.blaDetails.modeOfHoldingCode=='MH005'">
                    <label class="data-bind" id="holderName">{{vm.blaDetails.bondHolderName }}</label>
                </td>


                <td width="25%">Is NRI? Yes/No.</td>
                <td width="25%">
                    <label class="data-bind" id="isNri">{{vm.blaDetails.isNri | getLabelFromValuesArray : vm.commonYesNoMetaData}}</label>

                </td>
            </tr>

            <tr>

                <td width="25%" >Date of Death of Bond Holder</td>
                <td width="25%" >
                    <label class="data-bind" id="dodBondHolder">{{vm.bondDetails.dodBondHolder}}</label>
                </td>


                <td width="25%">Date of Receipt of Death Certificate</td>
                <td width="25%">
                    <label class="data-bind" id="dateOfReceiptDod">{{vm.bondDetails.dateOfReceiptDod}}</label>

                </td>
            </tr>



            </tbody>
        </table>

        <!--BOND SUBSCRIPTION DETAILS:-->
        <table class="table table-bordered">
            <h5 class="form_heading">BOND SUBSCRIPTION DETAILS</h5>
            <tbody>

            <tr>
                <td width="25%" ><label>Subscription Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails.subsDate | uppercase}}</label>
                </td>
                <td width="25%" ><label>Subscription ID</label></td>
                <td width="25%" ><label>{{vm.bondDetails.boSubsId}}</label>
            </tr>


            <tr>

                <td width="25%" ><label>Subscription  Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails.subsAmt}}</label>

                <td width="25%" ><label>Bond Type</label></td>
                <td width="25%" ><label>{{vm.bondDetails.bondType}}</label>

            </tr>



            <tr>

                <td width="25%" ><label>Maturity Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails.maturityDate |uppercase}}</label>

            </tr>

            </tbody>
        </table>


        <!--ACCOUNT CLOSURE  DETAILS-->

        <table class="table table-bordered">
            <h5 class="form_heading">ACCOUNT CLOSURE  DETAILS</h5>
            <tbody>




            <tr>
                <td width="25%" ><label>Account Closed Date</label></td>
                <td width="25%" > <label>{{vm.subsDate | uppercase}}</label> </td>


                <td width="25%" ><label>Proceeds to be Paid to</label></td>
                <td width="25%" > <label>{{vm.proceedsToBePaidDetail }}</label> </td>
            </tr>



            <tr>
                <td width="25%" ><label>Interest Paid up to</label></td>
                <td width="25%" > <label>{{vm.bondDetails.intPaidUpto }}</label> </td>

                <td width="25%" ><label>Whether Penalty is to be recovered? </label></td>
                <td width="25%" ><label>{{vm.bondDetails.penalityToBeRecovered |getLabelFromValuesArray : vm.commonYesNoMetaData }}</label></td>

            </tr>

            <tr>
                <td width="25%" ><label>Interest Calculation From Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails.intCalFromDate | uppercase}}</label>
                </td>

                <td width="25%" ><label>Interest Calculation to Date</label></td>
                <td width="25%" > <label>{{vm.bondDetails.intCalToDate | uppercase}}</label>
            </tr>

            <tr>
                <td width="25%" ><label>Last half Year Period Interest Rate</label></td>
                <td width="25%" ><label>{{vm.bondDetails.lastHalfYrIntRate}}</label>
                </td>

                <td width="25%" ><label>Last half Year Period Interest amount</label></td>
                <td width="25%" > <label>{{vm.bondDetails.lastHalfYrIntAmt}}</label>
            </tr>




            <tr>
                <td width="25%" ><label>Penalty To be recovered</label></td>
                <td width="25%" > <label>{{vm.bondDetails.penality}}</label>

                    <!--                <td width="25%" ng-if="vm.bondDetails.islastYearIntPaid=='N'"><label>Net Interest for the Last half year period</label></td>-->
                    <!--                <td width="25%" ng-if="vm.bondDetails.islastYearIntPaid=='N'"> <label>{{vm.bondDetails.netIntLastHalfYr}}</label>-->
                <td width="25%" ><label>Net Interest for the Last half year period</label></td>
                <td width="25%" > <label>{{vm.bondDetails.netIntLastHalfYr}}</label>
            </tr>

            <tr>
                <td width="25%" ><label>Pending Interest</label></td>
                <td width="25%" ><label>{{vm.bondDetails.pendingInterest }}</label></td>

                <td width="25%" ><label>Total Interest before TDS</label></td>
                <td width="25%" ><label>{{vm.bondDetails.totIntBefTDS }}</label>

            </tr>

            <tr>
                <td width="25%" ><label>TDS Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails.tdsAmt}}</label>

                <td width="25%" ><label>Total Interest after TDS</label></td>
                <td width="25%" ><label>{{vm.bondDetails.totIntAftTDS}}</label>

            </tr>


            <tr>
                <td width="25%" ><label>Total Amount to be paid</label></td>
                <td width="25%" ><label>{{vm.bondDetails.amtPaid}}</label>

                <td width="25%" >
                    <div class="row">
                        <div class="form-group required">
                            <div class="col-sm-6">
                                <label for="closeRemarks" class="control-label">Closure Remarks</label>
                            </div>
                        </div>
                    </div>


                </td>
                <td width="25%" ><input type="text" class="form-control" id="closeRemarks"
                                        chars="alpha-numeric"
                                        limit-to="100" name="closeRemarks"
                                        ng-model="vm.bondDetails.closureRemarks" required readonly>
                    <!--                    //value="Due to Death"-->
                </td>

            </tr>


            </tbody>
        </table>



        <div ng-if="vm.proceedsToBePaid=='N'" >
            <table class="table table-bordered"  ng-if="vm.proceedsToBePaid=='N'">
                <h5 class="form_heading">NOMINEE  DETAILS </h5>
                <thead>
                <tr>
                    <th>S.No.</th>
                    <th width="25%">Nominee ID</th>
                    <th width="25%">Nominee Name</th>
                    <th >Share %</th>
                    <th width="25%">Amount Settled Rs.</th>

                    <th>Payment Mode</th>
                    <th width="25%">Credit Account Number</th>
                    <th width="25%">Credit Account Branch</th>
                    <th width="25%">Remarks</th>

                </tr>
                </thead>
                <tbody>
                <tr ng-repeat="x in vm.nomineeDetailsList">

                    <td align="center">{{$index+1}}</td>
                    <td align="center">{{x.nomineeId}}</td>
                    <td align="center">{{x.nomineeName}}</td>
                    <td align="center">{{x.sharePercentage}}</td>
                    <td align="center">{{x.shareAmountSettled}}</td>

                    <td width="25%" > <select class="form-control" id="modeOfInterestPay" name="modeOfInterestPay"
                                              ng-change="vm.creditAccAndBranch(x)" ng-model="x.modeOfInterestPay"  disabled required readonly>
                        <option value="">Select</option>
                        <option  value="MP001" >Credit Account</option>
                        <option  value="MP002" >DD/PO</option>
                        <!--                        <option  value="MP003" >NEFT</option>-->
                    </select>
                    </td>
                    <td width="25%"><input type="text" class="form-control" id="x.accNum" name="x.creditAccNo"
                                           ng-model="x.accNum"   readonly
                                           style="width: fit-content;"></td>
                    <td width="25%"> <input type="text" class="form-control" id="x.accBranch" name="x.creditAccBranch"
                                            ng-model="x.accBranch"   readonly
                                            style="width: 100%;"></td>
                    <td> <input type="text" id="x.remarks" name="x.remarks" ng-model="x.remarks"  readonly ></td>
                </tr>
                </tbody>

                <table>
                    <tr>
                        <td width="30%" align="right"
                            style="padding-right: 15px;
                               font-weight: bolder;">Total (%)</td>
                        <td width="5%" align="center" >
                            <input type="text" class="form-control" id="totalPer[$index]"
                                   limit-to="3" min="1" max="100"
                                   ng-model="vm.totalPer='100'" required readonly>

                        </td>
                    </tr>
                </table>


            </table>
        </div>



        <div ng-if="vm.proceedsToBePaid=='L'">
            <h5 class="form_heading" >LEGAL HEIRS DETAILS</h5>

            <table class="table table-bordered table-striped" style="margin-bottom: 40px;" ng-repeat="x in vm.legalHeirDeatailList">

                <tbody  ng-init="vm.getTotalSharePer()">


                <tr>
                    <td colspan="4"><h4 class="form_heading" style="height: 17px;padding: 0;margin:0;font-size: 15px;">LEGAL HEIRS DETAILS {{$index+1}}</h4></td>
                </tr>
                <tr>

                    <td colspan="4" align="right"><a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-if="vm.enableDelete" ng-click="vm.removeRange($index)">
                        <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                    </a>
                    </td>

                    </td>
                </tr>
                <tr>
                    <td width="25%" class="form-group required">
                        <label for="legalheirName[$index]" class="required control-label">Name</label></td>
                    <td class="form-group">
                        <input type="text" class="form-control" id="legalheirName[$index]"
                               chars="only-letters"
                               limit-to="50" name="legalheirName"
                               ng-model="x.legalheirName" required readonly >
                    </td>
                    <td width="25%" class="form-group required"><label  class="required control-label">Relation</label></td>

                    <td width="25%" >
                        {{x.relationShip | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsList)}}
                    </td>

                </tr>

                <tr>
                    <td width="25%" class="form-group required"><label for="sharePercentage[$index]" class="required control-label">Share %</label></td>
                    <td>
                        <input type="text" class="form-control" id="sharePercentage[$index]"
                               limit-to="3" name="sharePercentage"

                               ng-model="x.sharePercentage" ng-change="vm.totSharePercen(vm.legalHeirDeatailList,x);" required readonly>
                    </td>
                    <td width="25%" class="form-group required"><label for="shareAmountSettled[$index]" class="required control-label">Amount Settled</label></td>

                    <td><input type="text" class="form-control" id="shareAmountSettled[$index]"
                               name="shareAmountSettled"
                               ng-model="x.shareAmountSettled" required readonly>
                    </td>
                </tr>
                <tr>

                    <td width="25%" class="form-group required"> <label  class="required control-label">Payment Mode</label></td>

                    <td>
                        <select class="form-control" id="modeOfInterestPay" name="modeOfInterestPay"
                                ng-change=" x.accBranch='';vm.creditAccAndBranch(x)" ng-model="x.modeOfInterestPay" disabled required readonly>
                            <option value="">Select</option>
                            <option  value="MP001" >Credit Account</option>
                            <option  value="MP002" >DD/PO</option>
                            <!--                        <option  value="MP003" >NEFT</option>-->
                        </select>
                    </td>

                    <td width="25%" class="form-group required"><label class="control-label">Credit Account Number</label></td>
                    <td>
                        <input type="text" class="form-control" id="accNum[$index]"
                               chars="alpha-numeric"
                               limit-to="20" name="city"
                               ng-model="x.accNum" ng-change="vm.legalHeirPayBranchId(x)"  readonly>
                        <span class="alert-danger" ng-if="vm.message" ng-bind="vm.message"></span>

                    </td>
                </tr>
                <tr >
                    <td width="25%" class="form-group required"><label class="control-label">Credit Account Branch ID</label></td>
                    <td>
                        <input type="text" class="form-control" id="phoneNo[$index]"
                               chars="only-numbers"
                               limit-to="10" name="phoneNo"
                               ng-model="x.accBranch"  readonly>
                    </td>
                    <td width="25%" class="form-group "><label class="control-label">Remarks</label></td>
                    <td>
                        <input type="text" class="form-control" id="remarks[$index]"
                               limit-to="6" name="remarks"
                               ng-model="x.remarks" readonly>
                    </td>
                </tr>

                <tr></tr>
                <tr></tr>

                </tbody>
            </table>
            <table class="table" ng-if="vm.legalHeirDeatailList.length >=1">
                <tr ng-if="vm.legalHeirDeatailList.length >=1">

                    <td width="25%" class="form-group required"><label class="control-label">Total (%)</label></td>
                    <td width="25%"> <input type="text" class="form-control" id="totSharePercenValue[$index]"
                                            limit-to="3" min="1" max="100" name="totSharePercenErr"
                                            ng-model="vm.totSharePercenValue='100'" required readonly>
                        <span class="alert-danger" ng-if="vm.totSharePercenErr" ng-bind="vm.totSharePercenErr"></span>
                    </td>

                </tr>
                <br>
            </table>
        </div>








        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.auditInfo.createdDate}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.verifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>



        <div class="text-center form_submit">
<!--           -->
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbi_bond_sub_acc_closure_before_matur_death/action/inquiry';">Close
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>

        </div>
    </form>
</div>





