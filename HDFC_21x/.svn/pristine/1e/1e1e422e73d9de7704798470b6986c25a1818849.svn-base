                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C009.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch City Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C010)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C010.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
