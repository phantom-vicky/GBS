<!--                            <td></td>-->
<!--                            <td>II. Part Transfers</td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                            <td></td>-->
<!--                        </tr>-->
                        <tr>
                            <td></td>
                            <td style="text-align:center"><strong>Total</strong></td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partCNonCumulativeTotalAmount)}}</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:right">{{vm.formatIndianCurrency(vm.partCCumulativeTotalAmount)}}</td>
                            <td></td>
                            <td></td>
                        </tr>
                        </tbody>

                        <!--Part D-->
                        <thead>
                        <tr>
                            <th scope="col" colspan="2" style="text-align:center">Part D</th>
                            <th scope="col" colspan="6" rowspan="2" style="text-align:center">HDFC BANK LTD</th>
                            <th scope="col" colspan="1"></th>
                            <th scope="col" colspan="2" style="text-align:center"ng-if="vm.schemeCode=='0017'"><strong>APPENDIX VII</strong></th>
                            <th scope="col" colspan="2" style="text-align:center"ng-if="vm.schemeCode!='0017'"><strong>APPENDIX IV</strong></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="2" style="text-align:center"><strong>Mumbai</strong></th>
<!--                            <th scope="col" colspan="6"></th>-->
                            <th scope="col" colspan="1"></th>
                            <th scope="col" colspan="2" style="text-align:center"><strong>{{vm.schemeName}}</strong></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="11" style="text-align:center">
                                REPAYMENT POSITION {{vm.toDate ? (vm.toDate | date:'MMM yyyy' | uppercase) : '' }}
                            </th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="6" style="text-align:center">NON-CUMULATIVE</th>
                            <th scope="col" colspan="5" style="text-align:center">CUMULATIVE</th>
                        </tr>
                        <tr class="thalign">
                            <th scope="col" style="text-align:center">S No.</th>
                            <th scope="col" style="text-align:center">BLA No.</th>
                            <th scope="col" colspan="2" style="text-align:center">AMOUNT</th>
                            <th scope="col" style="text-align:center">DUE DATE OF REPAYMENT</th>
                            <th scope="col" style="text-align:center">Repayment On</th>
                            <th scope="col" style="text-align:center">S No.</th>
                            <th scope="col" style="text-align:center">BLA No.</th>
                            <th scope="col" style="text-align:center">AMOUNT</th>
                            <th scope="col" style="text-align:center">DUE DATE OF REPAYMENT</th>
                            <th scope="col" style="text-align:center">Repayment On</th>
                        </tr>
                        </thead>

                        <tbody>
                        <tr ng-repeat="d in vm.mergedPartDList track by $index">
                            <td style="text-align:center">{{ (vm.partDNonCumulativeList.length > 0 && $index < vm.partDNonCumulativeList.length) ? ($index + 1) : '' }}</td>
                            <td style="text-align:center">{{d.nonCumulative.partDNcBla}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(d.nonCumulative.partDNcAmount)}}</td>
                            <td style="text-align:center">{{d.nonCumulative.partDNcDueDate}}</td>
                            <td style="text-align:center">{{d.nonCumulative.partDNcRepaymentOn}}</td>
                            <td style="text-align:center">{{ (vm.partDCumulativeList.length > 0 && $index < vm.partDCumulativeList.length) ? ($index + 1) : '' }}</td>
                            <td style="text-align:center">{{d.cumulative.partDCBla}}</td>
                            <td style="text-align:right">{{vm.formatIndianCurrency(d.cumulative.partDCAmount)}}</td>
                            <td style="text-align:center">{{d.cumulative.partDCDueDate}}</td>
                            <td style="text-align:center">{{d.cumulative.partDCRepaymentOn}}</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td style="text-align:center"><strong>Total</strong></td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partDNonCumulativeTotalAmount)}}</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td style="text-align:center"><strong>Total</strong></td>
                            <td  style="text-align:right">{{vm.formatIndianCurrency(vm.partDCumulativeTotalAmount)}}</td>
                            <td></td>
                        </tr>
                        </tbody>

                        <!--Part E-->
                        <thead>
                        <tr>
                            <th scope="col" colspan="2" style="text-align:center">Part E</th>
                            <th scope="col" colspan="6" rowspan="2" style="text-align:center">HDFC BANK LTD</th>
                            <th scope="col" colspan="1"></th>
                            <th scope="col" colspan="2" style="text-align:center"ng-if="vm.schemeCode=='0017'"><strong>APPENDIX VII</strong></th>
                            <th scope="col" colspan="2" style="text-align:center"ng-if="vm.schemeCode!='0017'"><strong>APPENDIX IV</strong></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="2" style="text-align:center"><strong>Mumbai</strong></th>
<!--                            <th scope="col" colspan="6"></th>-->
                            <th scope="col" colspan="1"></th>
                            <th scope="col" colspan="2" style="text-align:center"><strong>{{vm.schemeName}}</strong></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="11" style="text-align:center">
                                Summary Position {{vm.toDate ? (vm.toDate | date:'MMM yyyy' | uppercase) : '' }}
                            </th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="6" style="text-align:center">NON-CUMULATIVE</th>
                            <th scope="col" colspan="5" style="text-align:center">CUMULATIVE</th>
                        </tr>
                        <tr class="thalign">
                            <th scope="col" colspan="2"></th>
                            <th scope="col" colspan="2" style="text-align:center">No of Accounts</th>
                            <th scope="col" colspan="2" style="text-align:center">AMOUNT</th>
                            <th scope="col" colspan="2"></th>
                            <th scope="col" colspan="2" style="text-align:center">No of Accounts</th>
                            <th scope="col" colspan="1" style="text-align:center">AMOUNT</th>
                        </tr>
                        </thead>

                        <tbody>
                        <tr>

                            <td colspan="2"><strong>Progressive Opening Balance B/F</strong></td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianNumber(vm.partTotalAmtAcc[1].totalaPartiAccounts)}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partTotalAmtAcc[1].totalaPartiAmount)}}</td>
                            <td colspan="2"><strong>Progressive Opening Balance B/F</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partTotalAmtAcc[0].totalaPartiAccounts)}}</td>
                            <td colspan="1" style="text-align:right">{{vm.formatIndianCurrency(vm.partTotalAmtAcc[0].totalaPartiAmount)}}</td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Part A + (Add)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partANonCumulativeList.length)}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partANonCumulativeTotalAmount)}}</td>
                            <td colspan="2"><strong>Part A + (Add)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partACumulativeList.length)}}</td>
                            <td colspan="1" style="text-align:right">{{vm.formatIndianCurrency(vm.partACumulativeTotalAmount)}}</td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Part B + (Add)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partBNonCumulativeList.length)}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partBNonCumulativeTotalAmount)}}</td>
                            <td colspan="2"><strong>Part B + (Add)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partBCumulativeList.length)}}</td>
                            <td colspan="1" style="text-align:right">{{vm.formatIndianCurrency(vm.partBCumulativeTotalAmount)}}</td>
                        </tr>


                        <tr>
                            <td colspan="2"><strong>Total</strong></td>

                            <!-- Count -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianNumber(vm.partANonCumulativeList.length + vm.partBNonCumulativeList.length)
                                }}
                            </td>

                            <!-- Amount -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianCurrency(
                                vm.partANonCumulativeTotalAmount + vm.partBNonCumulativeTotalAmount
                                )
                                }}
                            </td>

                            <td colspan="2"><strong>Total</strong></td>

                            <!-- Cumulative Count -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianNumber(vm.partACumulativeList.length + vm.partBCumulativeList.length)
                                }}
                            </td>

                            <!-- Cumulative Amount -->
                            <td colspan="1" style="text-align:right">
                                {{
                                vm.formatIndianCurrency(
                                vm.partACumulativeTotalAmount + vm.partBCumulativeTotalAmount
                                )
                                }}
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Part C - (Less)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partCNonCumulativeList.length)}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partCNonCumulativeTotalAmount)}}</td>
                            <td colspan="2"><strong>Part C - (Less)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partCCumulativeList.length)}}</td>
                            <td colspan="1" style="text-align:right">{{vm.formatIndianCurrency(vm.partCCumulativeTotalAmount)}}</td>
                        </tr>
                        <tr>
                            <td colspan="2"><strong>Part D - (Less)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partDNonCumulativeList.length)}}</td>
                            <td colspan="2" style="text-align:right">{{vm.formatIndianCurrency(vm.partDNonCumulativeTotalAmount)}}</td>
                            <td colspan="2"><strong>Part D - (Less)</strong></td>
                            <td colspan="2"style="text-align:right">{{vm.formatIndianNumber(vm.partDCumulativeList.length)}}</td>
                            <td colspan="1" style="text-align:right">{{vm.formatIndianCurrency(vm.partDCumulativeTotalAmount)}}</td>
                        </tr>



                        <tr>
                            <td colspan="2"><strong>part D Balance</strong></td>

                            <!-- Count Balance -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianNumber(vm.partDNonCumulativeList.length)
                                }}
                            </td>

                            <!-- Amount Balance (format AFTER calculation) -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianCurrency(vm.partDNonCumulativeTotalAmount)
                                }}
                            </td>

                            <td colspan="2"><strong>part D Balance</strong></td>

                            <!-- Cumulative Count -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianNumber(vm.partDCumulativeList.length)
                                }}
                            </td>

                            <!-- Cumulative Amount -->
                            <td colspan="1" style="text-align:right">
                                {{
                                vm.formatIndianCurrency(vm.partDCumulativeTotalAmount)

                                }}
                            </td>
                        </tr>

                        <tr>
                            <td colspan="2">
                                <strong>Net i.e. Total of Part A + Part B - Total of Part C + Part D</strong>
                            </td>

                            <!-- Count -->
                            <td colspan="2" style="text-align:right">
                                {{
                                vm.formatIndianNumber(vm.totalNCumAccount)
                                }}
                            </td>

                            <!-- Amount -->
                            <td colspan="2" style="text-align:right">
                                  {{vm.formatIndianCurrency(vm.totalNCumAmount)}}

                            </td>
                            <td colspan="2">
                                <strong>Net i.e. Total of Part A + Part B - Total of Part C + Part D</strong>
                            </td>
                            <td colspan="2" style="text-align:right">
                                {{
                            vm.formatIndianNumber(vm.totalCumAccount)
                                }}
                            </td>

                            <!-- Cumulative Amount -->
                            <td colspan="1" style="text-align:right">

                                {{vm.formatIndianCurrency(vm.totalCumAmount)}}

                            </td>
                        </tr>




                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>

