<div class="container from_wrapper">
		<left-menu-directive></left-menu-directive>
		<form name="systemParameterForm" role="form" ng-submit="submitForm(systemParameterForm.$valid, this)" novalidate>
			<h4 class="form_heading">System Parameter - Inquiry</h4>
			
			<notice-message-directive ></notice-message-directive>
			<div class="row" ng-repeat="systemParameter in systemParameters">
				<div class="form-group required">
					<div class="col-sm-2"></div>
					<label for="" class="control-label col-sm-5">{{systemParameter.parameterDesc}}</label>
					<div class="col-sm-3">
					
						<span  ng-if="systemParameter.parameterType == 'N'">
							<p   
								ng-repeat="item in systemParametersDetails" 
								ng-if="item.parameterId == systemParameter.parameterId && item.parameterValues == systemParameter.parameterValue" 
								value="{{item.parameterValues}}" >
								{{item.parameterValDesc}}
							</p>
							</span>
						<span  ng-if="systemParameter.parameterType == 'Y'">{{systemParameterScope[systemParameter.parameterId]}}</span>
					  	
					</div>
				</div>
			</div>
				
			<div class="col-sm-offset-5 col-sm-8 form_submit">
				<!--  <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="systemParameterForm.$invalid">Update</button> -->
				 <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="moveTo()">Cancel</button>
			</div>
		</form>

</div>
<!-- /.container-fluid -->	
				
				 