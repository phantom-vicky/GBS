<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.detailsList">

    <div class="text-right form_submit">

        <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/dc';" id="homeButton">Home</button>

        <button type="submit" id="backButton" class="btn btn-cancel" onclick="window.location.href= '#!/Access_Control_Matrix_Report/action/inquiry';">Back</button>

    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="col-sm-12">
            <h4 class="form_heading">Access Control Matrix Report</h4>
            <table class="table report-title-table">
                <tr>
                    <td>
                        <h5 class="modal-title">Bank Name : {{vm.bankName}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title"> Branch Name : {{vm.loginSolDesc}} </h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Branch Code : {{vm.loginSolId}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">As On Date : {{vm.solDate}}</h5>
                    </td>
                </tr>
            </table>
            <table width="100%" class="table table-bordered">
                <tr height="40">
<!--                    <h4 class="form_heading">Access Control Matrix Report</h4>-->
                </tr>
            </table>
                <div class="row">
                    <div class="col-sm-12">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                                   ui-jq="dataTable" ui-options="vm.dataTableOption">
                                <thead>
                                <tr class="thalign">
                                    <th>S.No</th>
                                    <th>Roles/Group</th>
                                    <th>Permission/Schemes</th>
                                    <th>Created By/Date & Time</th>
                                    <th>Modified By/Date & Time</th>
                                    <th>Verified By/Date & Time</th>
                                </tr>
                                <tbody>
<!--                            <tr >-->
                            <tr ng-repeat="x in vm.detailsList">
                                <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
<!--                                <td>{{x.sNo}}</td>-->
                                <td>{{x.roles}}</td>
                                <td>{{x.permissions}}</td>
                                <td>{{x.createdByCreatedDate}}</td>
                                <td>{{x.modifiedByModifiedDate}}</td>
                                <td>{{x.verifiedByVerifiedDate}}</td>
                            </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
        </div>
    </div>
</div>

 <div class="container" ng-if="vm.noDataFound">
     <div class="list_wrapper no_records_message">
         <h4 class="form_heading">Access Control Matrix Report</h4>
         No records found to display.
         <center>
             <button type="button" class="btn btn-default"
                     onclick="window.location.href= '#!/Access_Control_Matrix_Report/action/inquiry';" >Back</button>
         </center>
     </div>
 </div>


