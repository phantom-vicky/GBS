package com.isl.gbm.rbibond.dto.scrolls;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class BondInterestRepayDTO {
    private String branchId;
    private String branchName;
    private String schemeCode;
    private String intertestPaidFor;
    private String finacialYear;
    private String sNo;
    private String blaNo;
    private String principalAmt;
    private String dueDateRepay;
    private String interestAmt;
    private String dateOfInterCredit;
    private String creditAccNo;
    private String remarks;
    private String initials;
    private String total;
    private String schemeName;

    public String getSchemeName() {
        return schemeName;
    }

    public void setSchemeName(String schemeName) {
        this.schemeName = schemeName;
    }

    public String getBranchId() {
        return branchId;
    }

    public void setBranchId(String branchId) {
        this.branchId = branchId;
    }

    public String getBranchName() {
        return branchName;
    }

    public void setBranchName(String branchName) {
        this.branchName = branchName;
    }

    public String getSchemeCode() {
        return schemeCode;
    }

    public void setSchemeCode(String schemeCode) {
        this.schemeCode = schemeCode;
    }

    public String getIntertestPaidFor() {
        return intertestPaidFor;
    }

    public void setIntertestPaidFor(String intertestPaidFor) {
        this.intertestPaidFor = intertestPaidFor;
    }

    public String getFinacialYear() {
        return finacialYear;
    }

    public void setFinacialYear(String finacialYear) {
        this.finacialYear = finacialYear;
    }

    public String getsNo() {
        return sNo;
    }

    public void setsNo(String sNo) {
        this.sNo = sNo;
    }

    public String getBlaNo() {
        return blaNo;
    }

    public void setBlaNo(String blaNo) {
        this.blaNo = blaNo;
    }

    public String getPrincipalAmt() {
        return principalAmt;
    }

    public void setPrincipalAmt(String principalAmt) {
        this.principalAmt = principalAmt;
    }

    public String getDueDateRepay() {
        return dueDateRepay;
    }

    public void setDueDateRepay(String dueDateRepay) {
        this.dueDateRepay = dueDateRepay;
    }

    public String getInterestAmt() {
        return interestAmt;
    }

    public void setInterestAmt(String interestAmt) {
        this.interestAmt = interestAmt;
    }

    public String getDateOfInterCredit() {
        return dateOfInterCredit;
    }

    public void setDateOfInterCredit(String dateOfInterCredit) {
        this.dateOfInterCredit = dateOfInterCredit;
    }

    public String getCreditAccNo() {
        return creditAccNo;
    }

    public void setCreditAccNo(String creditAccNo) {
        this.creditAccNo = creditAccNo;
    }

    public String getRemarks() {
        return remarks;
    }

    public void setRemarks(String remarks) {
        this.remarks = remarks;
    }

    public String getInitials() {
        return initials;
    }

    public void setInitials(String initials) {
        this.initials = initials;
    }

    public String getTotal() {
        return total;
    }

    public void setTotal(String total) {
