<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Other Bank Details - Verify</h4>
    <sol-header></sol-header>
    <form name="otherBankDetailsForm" role="form">

        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.verifyDeleteLists.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.verifyDeleteLists.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Bank Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C001)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C001.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue &&
                    vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C001)? (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C001.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Bank Name</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C002)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C002.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C002)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C002.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Bank Short Name</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C003.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text1</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C005.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C005.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text2</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C006)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C006.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C006)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C006.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text3</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C007)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C007.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C007)?
                    (vm.verifyDeleteLists.cbsOtherBankDetailsOldNewValue.C007.newValue) : ('')}}
                </td>
            </tr>
            </tbody>
        </table>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.verifyDeleteLists.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.verifyDeleteLists.lastModifiedBy) ? (vm.verifyDeleteLists.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.verifyDeleteLists.verifiedBy) ? (vm.verifyDeleteLists.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.verifyDeleteLists.verifiedFlag  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.verifyDeleteLists.creatDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.verifyDeleteLists.modDate) ? (vm.verifyDeleteLists.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.verifyDeleteLists.verDate) ? (vm.verifyDeleteLists.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="vm.otherBankDetailsForm.$invalid" ng-click="vm.deleteSubmit()">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    ng-click="vm.showCancelConfirmation('cbs_other_bank_details.list');">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
