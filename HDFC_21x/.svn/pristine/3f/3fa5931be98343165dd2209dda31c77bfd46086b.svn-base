<!--					<input type="text" class="form-control" name="additionalText2"-->
<!--						id="additionalText2" chars="alpha-numeric"-->
<!--						ng-model="vm.cbsOtherBankDetails.C006" maxlength="40">-->
<!--				</div>-->
<!--			</div>-->
<!--		</div>-->
<!--		<div class="row">-->
<!--			<div class="form-group">-->
<!--				<div class="col-sm-3"></div>-->
<!--				<div class="col-sm-3">-->
<!--					<label for="additionalText3" class="control-label">Additional-->
<!--						Text3</label>-->
<!--				</div>-->
<!--				<div class="col-sm-3">-->
<!--					<input type="text" class="form-control" name="additionalText3"-->
<!--						id="additionalText3" chars="alpha-numeric"-->
<!--						ng-model="vm.cbsOtherBankDetails.C007" maxlength="40">-->
<!--				</div>-->
<!--			</div>-->
<!--		</div>-->

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">Addr1</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						   id="additionalText3"
						   ng-model="vm.cbsOtherBankDetails.C008" maxlength="100" oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ,.\-\/]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">Addr2</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						   id="additionalText3"
						   ng-model="vm.cbsOtherBankDetails.C009" maxlength="100" oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ,.\-\/]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">City</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						   id="additionalText3" chars="only-letters"
						   ng-model="vm.cbsOtherBankDetails.C010" maxlength="50" oninput="this.value = this.value.replace(/\s+/g, '')">
				</div>
			</div>
		</div>


		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">PinCode</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						   id="additionalText3" chars="only-numbers"
						   ng-model="vm.cbsOtherBankDetails.C011" maxlength="6" oninput="this.value = this.value.replace(/\s+/g, '')">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="text-center form_submit">
				<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="otherBankDetailsForm.$invalid" ng-click="vm.add()">Submit</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="vm.showCancelConfirmation('cbs_other_bank_details.list');">Cancel</button>
			</div>
		</div>
		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>

