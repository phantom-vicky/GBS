                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C004.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>MICR Branch Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C005.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C005.newValue) : ('')}}
