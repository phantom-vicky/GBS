<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">Pre-Maturity Marking Report</h4>
  <sol-header></sol-header>
  <form name="preMaturityMarkingReportFrom" role="form">
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">Name of the Module</label></div>
        <div class="col-sm-2">
          <label><strong>RBI Bond</strong></label>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="schemeName" class="control-label">Name of the Bond Scheme</label></div>
        <div class="col-sm-2"><input type="text" class="form-control" id="schemeName" data-ng-model="vm.schemeName" required readonly /></div>
        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0">
          <span class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearch" data-ng-click="vm.getSchemeName()"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.schemeCode =''; vm.schemeName=''; vm.bondHolderName=''; vm.panNum =''; vm.blaNo =''; vm.subscriptionID ='';vm.fromDate='';vm.toDate=''"></span>
        </div>
      </div>
    </div>



      <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="panNum" class="control-label">PAN No</label></div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="panNum" data-ng-model="vm.panNum" data-ng-init="vm.panNum= ''; " data-chars="alpha-numeric" minlength="4" maxlength="10" oninput="this.value=this.value.replace(/\s+/g, '')" />
        </div>

        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0" data-ng-if="(vm.panNum && vm.panNum.length >=5) && vm.schemeName">
          <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="panTreasurySearch" data-ng-click="vm.getPanNumber();"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.panNum =''; vm.blaNo =''; vm.subscriptionID ='';vm.bondHolderName='';"></span>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="BLA No" class="control-label">BLA No</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input type="text" class="form-control" id="BLA No" chars="only-numbers"
                    data-ng-model="vm.blaNo" maxlength="14" oninput="this.value=this.value.replace(/\s+/g, '')" /></p>
        </div>
        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0" data-ng-if="(vm.blaNo && vm.blaNo.length >=5) && vm.schemeName">
          <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="BLATreasurySearch" data-ng-click="vm.getBLANumber()"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.blaNo ='';vm.subscriptionID ='';"></span>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="subscriptionID" class="control-label">Subscription ID</label></div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="subscriptionID" data-ng-init="vm.subscriptionID=''" data-chars="alpha-numeric" data-ng-model="vm.subscriptionID" oninput="this.value=this.value.replace(/\s+/g, '')" />
        </div>
        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0" data-ng-if=" vm.panNum && vm.blaNo && vm.schemeName">
          <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="subscriptionIdSearch" data-ng-click="vm.getSubscriptionID(); vm.searchSolId=''"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.subscriptionID = ''"></span>
        </div>
      </div>
    </div>
    <div class="row"  data-ng-if="!vm.panNum && !vm.blaNo && !vm.subscriptionID">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label"> Pre Maturity Marked From Date(DD/MM/YYYY)</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
                    type="text"
                    class="form-control"
                    id="effFromDate"
                    name="effFromDate"
                    ng-model="vm.fromDate"
                    uib-datepicker-popup="dd/MM/yyyy"
                    ng-init="vm.fromDate='';vm.dateValidation();"
                    datepicker-options="vm.dateOptions"
                    ng-change="vm.dateValidation();"
                    is-open="vm.effFromDatePicker.opened"
                    close-text="Close"
                    maxlength="10"
                    ng-blur="vm.textableDatePicker('effromDate',vm.fromDate)"
                    ng-keyup="vm.autoslashing('effFromDate')" chars="numbers-slash"
                    required
            />
            <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.effFromDatePicker.opened = true" id="effFromDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <div class="row" data-ng-if="!vm.panNum && !vm.blaNo && !vm.subscriptionID">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Pre Maturity Marked To Date(DD/MM/YYYY)</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
                    type="text"
                    class="form-control"
                    id="effToDate"
                    name="effToDate"
                    ng-model="vm.toDate"
                    uib-datepicker-popup="dd/MM/yyyy"
                    ng-init="vm.toDate=''; vm.dateValidation();"
                    ng-keyup="vm.autoslashing('effToDate')"
                    ng-change="vm.dateValidation();"
                    datepicker-options="vm.dateToOptions"
                    is-open="vm.effToDatePicker.opened"
                    close-text="Close"
                    maxlength="10"   chars="numbers-slash"
                    required
            />


            <span class="input-group-btn" ng-if="vm.fromDate">
              <button type="button" class="btn btn-secondary" ng-click="vm.effToDatePicker.opened = true" id="effToDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>


    <div class="text-center form_submit">
      <button
        type="submit"
        id="submitButton"
        class="btn btn-default"
        data-ui-sref="pre_maturity_marking_report.inquiry_details({obj:{
                            schemeCode      :   vm.schemeCode,
                            panNo          :   vm.panNum,
                            blaNo           :   vm.blaNo,
                            subscriptionID  :   vm.subscriptionID,
                            fromDate        :   vm.fromDate,
                            toDate          :   vm.toDate,
                            schemeName      :   vm.schemeName
                        }})"
        data-ng-disabled="preMaturityMarkingReportFrom.$invalid">
        Submit
      </button>
      <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
    </div>

    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>

<!--Torch Modals-->
<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.modalSearch=''">&times;</button>
        <h4 class="modal-title">Scheme Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input type="text" class="form-control" data-ng-model="vm.modalSearch" data-ng-init="vm.modalSearch = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="Certificate of Holding">
                <thead data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      SCHEME NAME
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      STATUS
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    data-ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                    data-ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemeStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="panModel" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.panSearch=''">&times;</button>
        <h4 class="modal-title">PAN No</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.PanTorch.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input type="text" class="form-control" data-ng-model="vm.panSearch" data-ng-init="vm.panSearch = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="Certificate of Holding">
                <thead data-ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                      data-ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      PAN No
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                      data-ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Holder Name
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" data-ng-repeat="x in vm.PanTorch | filter:vm.panSearch | orderBy:sortedColumn:reverseOrder" data-ng-click="vm.panNum= x.panNo; vm.bondHolderName= x.holderName;" data-bs-dismiss="modal">
                    <td>{{x.panNo}}</td>
                    <td>{{x.holderName}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.PanTorch.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="blaModel" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.blaSearch=''">&times;</button>
        <h4 class="modal-title">BLA List</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input
                  type="text"
                  class="form-control"
                  data-ng-model="vm.blaSearch"
                  data-ng-init="vm.blaSearch = ''"
                  placeholder="Search"
                  data-chars="alpha-numeric"
                  oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="Certificate of Holding">
                <thead data-ng-init="reverseOrder=false;sortedColumn = 'blaNumber'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';"
                      data-ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      BLA No
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'panNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNumber';"
                      data-ng-class="(sortedColumn == 'panNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      PAN No
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';"
                      data-ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Holder Name
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                      data-ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Mode of Holding
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    data-ng-repeat="x in vm.blaAccNoList | filter:vm.blaSearch | orderBy:sortedColumn:reverseOrder"
                    data-ng-click="vm.blaNo = x.blaNo; vm.panNum = x.panNo; vm.bondHolderName = x.holderName; vm.modeOfHolding = x.modeOfHolding;"
                    data-bs-dismiss="modal">
                    <td>{{x.blaNo}}</td>
                    <td>{{x.panNo}}</td>
                    <td>{{x.holderName}}</td>
                    <td>{{x.modeOfHolding}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="subscriptionIDModal" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
        <h4 class="modal-title">Bond Subscription ID</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.subscriptionIdList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input type="text" class="form-control" data-ng-model="vm.searchSolId" data-ng-init="vm.searchSolId = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="Certificate of Holding">
                <thead data-ng-init="reverseOrder=true;sortedColumn = 'subscriptionID'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'bondSubscriptionId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondSubscriptionId';"
                      data-ng-class="(sortedColumn == 'bondSubscriptionId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Subscription ID
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'panNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNumber';"
                      data-ng-class="(sortedColumn == 'panNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      PAN No
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'holder_name')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holder_name';"
                      data-ng-class="(sortedColumn == 'holder_name')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Holder Name
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                      data-ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Mode of Holding
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" data-ng-repeat="x in vm.subscriptionIdList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder" data-ng-click="vm.subscriptionID = x.subscriptionId" data-bs-dismiss="modal">
                    <td>{{x.subscriptionId }}</td>
                    <td>{{x.panNo}}</td>
                    <td>{{x.holderName}}</td>
                    <td>{{x.modeOfHolding}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.subscriptionIdList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>
