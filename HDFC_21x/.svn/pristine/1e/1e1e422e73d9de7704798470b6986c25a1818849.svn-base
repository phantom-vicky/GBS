                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C006)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C006.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch Address1</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C007)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C007.oldValue) : ('')}}
                </td>
