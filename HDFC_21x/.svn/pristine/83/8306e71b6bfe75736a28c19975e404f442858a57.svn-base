                                        (vm.getDetails.masterDetailsValueModel[0].C022.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C022? (vm.getDetails.masterDetailsValueModel[0].C022.newValue) : ('')}}
