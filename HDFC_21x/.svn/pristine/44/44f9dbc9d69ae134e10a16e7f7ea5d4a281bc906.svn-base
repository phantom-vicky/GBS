        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">RBI Brokerage percentage (%)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="rbiBrokerage"
                        ng-keypress="vm.percentageCheckNew($event);"
                        ng-change="vm.percentageCheckChange1('vm.cbdtSchemeParameter.C044.oldValue');vm.decimalRbiBrokerageM(vm.cbdtSchemeParameter.C044.oldValue);"
                        ng-model="vm.cbdtSchemeParameter.C044.oldValue" limit-to="5" oninput="
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/^(\.)/g, '')
            " required />
                    <!--                           -->

                    <!--                    <input type="text" inputmode="numeric" class="form-control" id="handlingCharges" ng-init="" limit-To="4" min="0"
                    oninput="this.value =-->
                    <!-- !!this.value && Math.abs(this.value) >= 0 ? Math.abs(this.value) : null"-->
                    <!--                           name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C030" required>-->
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker’s percentage share (%)</label>
                </div>
                <div class="col-sm-2">
                    <!--                    <input type="text"  class="form-control" id="handlingCharges" name="handlingCharges"-->
                    <!--                           ng-model="vm.cbdtSchemeParameter.C030"-->
                    <!--                           ng-change="vm.decimalConvertHandlingCharges(vm.cbdtSchemeParameter.C030);"-->
                    <!--                           ng-pattern="/^[0-9]{1}[.]{1}[0-9]{5}$/" limit-To="7"-->
                    <!--                           required>-->

                    <input type="text" class="form-control" id="brshare" ng-keypress="vm.percentageCheckNew($event);"
                        ng-change="vm.percentageCheckChange1('vm.cbdtSchemeParameter.C045.oldValue');vm.decimalPercentageShareM(vm.cbdtSchemeParameter.C045.oldValue);"
                        ng-model="vm.cbdtSchemeParameter.C045.oldValue" limit-to="5" oninput="
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/^(\.)/g, '')
            " required />
                    <!--                           -->

                    <!--                    <input type="text" inputmode="numeric" class="form-control" id="handlingCharges" ng-init="" limit-To="4" min="0"
                    oninput="this.value =-->
                    <!-- !!this.value && Math.abs(this.value) >= 0 ? Math.abs(this.value) : null"-->
                    <!--                           name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C030" required>-->
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Difference Percentage with bank share (%)</label>
                </div>
                <div class="col-sm-2">
                    <!--                    <input type="text"  class="form-control" id="handlingCharges" name="handlingCharges"-->
                    <!--                           ng-model="vm.cbdtSchemeParameter.C030"-->
                    <!--                           ng-change="vm.decimalConvertHandlingCharges(vm.cbdtSchemeParameter.C030);"-->
                    <!--                           ng-pattern="/^[0-9]{1}[.]{1}[0-9]{5}$/" limit-To="7"-->
                    <!--                           required>-->
                    <label id="diffPercentageShare">{{vm.cbdtSchemeParameter.C046.oldValue}}</label>
                    <!--<input type="text" class="form-control" id="diffshare"

                           ng-keypress="vm.percentageCheckNew($event);" ng-change="vm.percentageCheckChange(vm.cbdtSchemeParameter.C046,'C046');"   ng-model="vm.cbdtSchemeParameter.C046.oldValue" limit-to="5"
                           oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/^(\.)/g, '')" required>-->
                    <!--                           -->

                    <!--                    <input type="text" inputmode="numeric" class="form-control" id="handlingCharges" ng-init="" limit-To="4" min="0"
                    oninput="this.value =-->
                    <!-- !!this.value && Math.abs(this.value) >= 0 ? Math.abs(this.value) : null"-->
                    <!--                           name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C030" required>-->
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Rejection Remarks</label>
                </div>
                <div class="col-sm-5">
                    <label>{{(vm.auditInfo.remarks)}} </label>
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="modifyButton"
                ng-disabled="schemeParameterCreationForm.$invalid && vm.invalidDate!=null">
                Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton" onclick="
          window.location.href = '#!/rbibond_scheme_parameter/action/modify'
        ">
                Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!-- Version Details -->
<div class="modal" id="rateCodeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">Rate Code List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.interstRateCodeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.versionNoSearch"
                                    placeholder="Search" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                    <tr>
                                        <th ng-click="(sortedColumn == 'versionNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'versionNo';"
                                            ng-class="(sortedColumn == 'versionNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                            Rate Code
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="cp"
                                        ng-repeat="x in vm.interstRateCodeList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.cbdtSchemeParameter.C014.oldValue = x;" data-bs-dismiss="modal">
                                        <td>{{x}}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.interstRateCodeList.length==0">
                    No records found to display.
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Treasury Details - End -->

<!-- Version Details -->
<div class="modal" id="postOfficeRateCodeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">
                    &times;
                </button>
                <h4 class="modal-title">Rate Code List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.interstRateCodeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.versionNoSearch"
                                    placeholder="Search" />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                    <tr>
                                        <th ng-click="(sortedColumn == 'versionNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'versionNo';"
                                            ng-class="(sortedColumn == 'versionNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                            Rate Code
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="cp"
                                        ng-repeat="x in vm.interstRateCodeList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
