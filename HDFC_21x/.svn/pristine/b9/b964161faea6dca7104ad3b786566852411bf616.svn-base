package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class PanValidationRetriggerDTO {

    private String panStatusValidateDate;
    private String fileMode;
    private String fileStatus;
    private String fileStatusFlg;
    private String schemeCode;
    private String schemeName;
    private String referenceId;

    public String getReferenceId() {
        return referenceId;
    }

    public void setReferenceId(String referenceId) {
        this.referenceId = referenceId;
    }

    public String getFileStatusFlg() {
        return fileStatusFlg;
    }

    public void setFileStatusFlg(String fileStatusFlg) {
        this.fileStatusFlg = fileStatusFlg;
    }

    public String getPanStatusValidateDate() {
        return panStatusValidateDate;
    }

    public void setPanStatusValidateDate(String panStatusValidateDate) {
        this.panStatusValidateDate = panStatusValidateDate;
    }

    public String getFileMode() {
        return fileMode;
    }

    public void setFileMode(String fileMode) {
        this.fileMode = fileMode;
    }

    public String getFileStatus() {
        return fileStatus;
    }

    public void setFileStatus(String fileStatus) {
        this.fileStatus = fileStatus;
    }

    public String getSchemeCode() {
        return schemeCode;
    }

    public void setSchemeCode(String schemeCode) {
        this.schemeCode = schemeCode;
    }

    public String getSchemeName() {
        return schemeName;
    }

    public void setSchemeName(String schemeName) {
        this.schemeName = schemeName;
    }
}
