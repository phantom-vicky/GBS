        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Address 1</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control"
                           id="address1" name="address1" ng-model="vm.address1" oninput="this.value = this.value.replace(/^\s*/, '')"
                           maxlength="200" required>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Address 2</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control"
                           id="address2" name="address2" ng-model="vm.address2" oninput="this.value = this.value.replace(/^\s*/, '')"
                           maxlength="200">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >Pin Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text"  class="form-control" id="pinCode" ng-model="vm.pinCode" name="pinCode"
                           maxlength="6" chars="only-numbers"  ng-pattern="/^\d{6}$/"  required leading-space>
                    <span ng-show="tdsparameter.pinCode.$error.pattern && tdsparameter.pinCode.$touched" style="color: red;">
                        Please enter a valid 6-digit pin code.
                    </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >City</label>
                </div>
                <div class="col-sm-2">
                    <input type="text"  class="form-control" id="city" ng-model="vm.city" name="city"
                           maxlength="50" chars="only-letters"   required leading-space>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >State</label>
                </div>
                <div class="col-sm-2">

                    <select class="form-control" id="state" name="state"
                            ng-model="vm.state" ng-init="vm.getState()" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.stateList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                    </select>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Phone No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" minlength="6" maxlength="12"
                           id="phoneNumber" ng-model="vm.phoneNumber"
                           chars="only-numbers" onkeypress="return isNumber(event)">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >Fax</label>
                </div>
                <div class="col-sm-2">
                    <input type="text"  class="form-control" id="fax" ng-model="vm.fax" name="fax"
                           maxlength="20" chars="only-numbers" leading-space>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Mobile No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" minlength="10" maxlength="10"
                           id="mobileNumber" ng-model="vm.mobileNumber"
                           chars="only-numbers" onkeypress="return isNumber(event)">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Email ID</label>
                </div>
                <div class="col-sm-2">
                    <textarea type="email" class="form-control"
                           id="emailId" name="emailId" maxlength="50"
                              ng-model="vm.emailId"  ng-pattern="vm.emailPattern" oninput="this.value = this.value.replace(/\s+/g, '')"  chars="email"></textarea>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="remark" class="control-label">Remarks</label>
                </div>
                <div class="col-sm-2">
                    <textarea class="form-control" chars="alpha-numeric" rows="3" id="remark" maxlength="50" name="remark" ng-model="vm.remarks" oninput="this.value = this.value.replace(/^\s*/, '')"></textarea>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="tdsparameter.$invalid" ng-click="vm.submitAddForm()">Submit</button>
            <button type="button" id="subButton" class="btn btn-cancel"
                    ng-click="vm.showCancelConfirmation('broker_master_rbi_bond.inquiry');">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
<!--modal-->
<div class="modal" id="rbiCodeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.nonHdfcTorchList">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric"
                                       ng-model="vm.search" ng-init="vm.search = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'bankName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankName';" ng-class="(sortedColumn == 'bankName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Name</th>
                                  <!--  <th ng-click="(sortedColumn == 'instIfscCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'instIfscCode';" ng-class="(sortedColumn == 'instIfscCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">IFSC Code</th>
                                    <th ng-click="(sortedColumn == 'micrBankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBankCode';" ng-class="(sortedColumn == 'micrBankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Bank Code</th>
                                    <th ng-click="(sortedColumn == 'micrBranchCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBranchCode';" ng-class="(sortedColumn == 'micrBranchCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Branch Code</th>
                               -->     <!--                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bla No</th>-->
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.nonHdfcTorchList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.nonBankName= x.bankName;vm.bankCode = x.bankCode;" data-bs-dismiss="modal">
                                    <td>{{x.bankName}}</td>
<!--                                    <td>{{x.bankCode}}</td>-->
                               <!--     <td>{{x.instIfscCode}}</td>
                                    <td>{{x.micrBankCode}}</td>
                                    <td>{{x.micrBranchCode}}</td>-->
                                    <!--                                    <td>{{x.blaNo}}</td>-->

                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.panDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<div class="modal" id="rbiCodeModalIfsc" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"></h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.nonHdfcTorchList">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric"
                                       ng-model="vm.search" ng-init="vm.search = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'bankName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankName';" ng-class="(sortedColumn == 'bankName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Name</th>
                                    <th ng-click="(sortedColumn == 'instIfscCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'instIfscCode';" ng-class="(sortedColumn == 'instIfscCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">IFSC Code</th>
                                    <th ng-click="(sortedColumn == 'micrBankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBankCode';" ng-class="(sortedColumn == 'micrBankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Bank Code</th>
                                    <th ng-click="(sortedColumn == 'micrBranchCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBranchCode';" ng-class="(sortedColumn == 'micrBranchCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Branch Code</th>
                                    <!--                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bla No</th>-->
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.nonHdfcTorchList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.instIfscCode=vm.sanitizeIfscCode(x.instIfscCode);vm.micrBankCode=x.micrBankCode;vm.micrBranchCode=x.micrBranchCode;vm.micrCodeLoc = x.micrCodeLoc;" data-bs-dismiss="modal">
                                    <td>{{x.bankName}}</td>
                                    <td>{{x.instIfscCode}}</td>
                                    <td>{{x.micrBankCode}}</td>
                                    <td>{{x.micrBranchCode}}</td>
                                    <!--                                    <td>{{x.blaNo}}</td>-->

                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.panDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<div class="modal" id="otherBankDetailsModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Other Bank Details List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchTranCode"
                                       ng-init="vm.searchTranCode = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'clgTranCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'bankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankCode';" ng-class="(sortedColumn == 'bankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Code</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.otherBankDetailsTorchList | filter:vm.searchTranCode | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.bankCode = x.bankCode;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.bankCode}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length==0">No
                    records found to display.</div>
            </div>

        </div>
    </div>
</div>

