<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <form name="rbi_bond_centralized_trial_run" role="form"><h4 class="form_heading">Bond Centralized Interest Trial Run - Verify/Reject</h4>


        <div class="col-sm-6 col-sm-offset-3">

            <sol-header></sol-header>
            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label>BOD Date</label>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-control">{{vm.solDate | date : 'dd/MM/yyyy'}}</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="moduleName">Name of the module</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="moduleName" ng-model="vm.moduleName"
                               required readonly>
                    </div>
                </div>
            </div>


            <!-- <div class="row" ng-init="vm.getModuleName();">
                 <div class="form-group required">
                     <div class="col-sm-6">
                         <label for="bondScheme" class="control-label">Name of the Bond Scheme</label>
                     </div>
                     <div class="col-sm-4">
                         <select class="form-control" id="bondScheme" name="bondScheme"
                                 ng-model="vm.schemeCode" ng-change="vm.getUnverifiedDetails()" required>
                             <option value="">Select</option>
                             <option ng-repeat="item in vm.schemeList" value="{{item.subCode}}" ng-bind="vm.schemeName = item.subCodeDescription"></option>
                         </select>
                     </div>
                 </div>
             </div>
-->
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="schemeName" class="control-label">Name of the Bond scheme</label>
                    </div>

                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="schemeName"
                               ng-model="vm.schemeName"  readonly required>
                    </div>

                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="schemeCodeSearch"
                           ng-click="vm.getTorchDetailsVerify('scheme');vm.interestForHalfYear='';vm.schemeCode='';vm.schemeName = '';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.schemeName = '';vm.schemeCode='';vm.interestForHalfYear='';"></i>
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label>Interest for the Half Year</label>
                    </div>
                    <div class="col-sm-4">
                        <select class="form-control" id="interestForHalfYear" name="interestForHalfYear"
                                ng-model="vm.interestForHalfYear"  ng-disabled="!vm.schemeCode"
                                required>
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="items in vm.interestHalfYearList" value="{{items.interestForHalfYear}}" ng-bind="items.interestForHalfYear"></option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label>Year</label>
                    </div>
                    <div class="col-sm-4">
                        <label class="form-control" ng-model="vm.financeyear">{{vm.financeyear}}</label>
                    </div>
                </div>
            </div>
            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ng-disabled="rbi_bond_centralized_trial_run.$invalid"
                        ui-sref="rbi_bond_centralized_trial_run.verify_detail({obj:{

                                year : vm.year,
                                interestForHalfYear : vm.interestForHalfYear,
                                schemeCode : vm.schemeCode,
                                schemeName : vm.schemeName
                            }})"
                >Next</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/rbi_bond_centralized_trial_run/add'">Cancel</button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>

<div class="modal" id="branchIdSearcher" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">

                            <table class="table table-bordered list scroll sort">

                                <thead ng-init="reverseOrder = false; sortedColumn = 'schemeName'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Status</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName;vm.schemeStatus = x.schemeStatus;vm.getTorchDetailsVerify('interestHalfYear');"
                                    data-bs-dismiss="modal">
                                    <!--                                    <td>{{x.schemeCode}}</td>-->
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>

                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!--Branch ID  Modal-->
<div class="modal" id="branchSearcher" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Branch ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.search" ng-init="vm.search = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'branchId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchId';" ng-class="(sortedColumn == 'branchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Id</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchDescription')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchDescription';" ng-class="(sortedColumn == 'branchDescription')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Description</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.branchIdList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.branchId = x.branchId; vm.branchDescription = x.branchDescription" data-bs-dismiss="modal">
                                    <td>{{x.branchId}}</td>
                                    <td>{{x.branchDescription}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

