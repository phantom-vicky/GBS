<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">BOND Subscription Account Closure On Maturity Death - Add</h4>
    <sol-header></sol-header>
    <form name="bondSubAccClosureForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">





            <!--            <div class="row" ng-init="vm.getModuleName();">-->
            <!--                <div class="form-group required">-->
            <!--                    <div class="col-sm-6">-->
            <!--                        <label for="bondScheme" class="control-label">Name of the Bond Scheme</label>-->
            <!--                    </div>-->
            <!--                    <div class="col-sm-4">-->
            <!--                        <select class="form-control" id="bondScheme" name="bondScheme"-->
            <!--                                ng-model="vm.schemeCode" required>-->
            <!--                            <option value="">Select</option>-->
            <!--                            <option ng-repeat="item in vm.schemeList" value="{{item.subCode}}" ng-bind="item.subCodeDescription"></option>-->
            <!--                        </select>-->
            <!--                    </div>-->
            <!--                </div>-->
            <!--            </div>-->







            <div class="row">
                <div class="form-group required">


                    <div class="col-sm-6">
                        <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="schemeCode"
                               ng-model="vm.schemeName"
                               chars="alpha-numeric" readonly required>
                    </div>
                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                           id="treasurySearch"
                           ng-click="vm.getAddDetails('scheme');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.schemeCode ='';vm.schemeName ='';vm.panNumber='';vm.blaNo ='';vm.boSubsId='';vm.proceedsToBePaid='';"></i>
                    </div>
                </div>
            </div>





            <div class="row">
                <div class="form-group required">

                    <div class="col-sm-6">
                        <label for="panNumber" class="control-label">PAN NO.</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="panNumber"
                               name="panNumber" chars="alpha-numeric"
                               ng-model="vm.panNumber"
                               readonly
                               required>

                    </div>
                    <div class="col-sm-2" ng-if="vm.schemeCode">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="panNoSearch"
                           ng-click="vm.getAddDetails('pan');vm.panNumber='';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNumber = '';vm.blaNo ='';vm.boSubsId='';vm.proceedsToBePaid='';"></i>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="blaNo" class="control-label">Bond Ledger Account Number</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="blaNo"
                               ng-model="vm.blaNo" ng-init="vm.blaNo = '';"
                               chars="alpha-numeric" minlength="5" maxlength="20" readonly required>
                    </div>
                    <div class="col-sm-2" ng-if="vm.panNumber">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="blaNo1"
                           ng-click="vm.getAddDetails('bla');vm.boSubsId='';"></i>
                        <i
                                class="glyphicon glyphicon-remove clear cp"
                                ng-click="vm.blaNo ='';vm.boSubsId='';vm.proceedsToBePaid='';"></i>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="boSubsId" class="control-label">Bond Subscription ID</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="boSubsId"
                               ng-init="vm.boSubsId=''" ng-model="vm.boSubsId" required readonly>
                    </div>
                    <div class="col-sm-2"  ng-if="vm.blaNo">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="bondSubsId1"
                           ng-click="vm.getAddDetails('boSubsId')"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.boSubsId = '';vm.proceedsToBePaid='';"></i>
                    </div>
                </div>
            </div>




            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="closureType" class="control-label">Closure Type</label>
                    </div>

                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="closureType"
                               ng-init="vm.closureType='Due to Death'" ng-model="vm.closureType"  readonly>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="closureType" class="control-label">Proceeds to be Paid to</label>
                    </div>

                    <div class="col-sm-4">
                        <select class="form-control" name="proceedsToBePaid" id="proceedsToBePaid"
                                ng-model="vm.proceedsToBePaid" ng-change="vm.getAddDetails('det');" ng-disabled="!vm.boSubsId" required>
                            <option value="">Select</option>
                            <option value="N">Nominees</option>
                            <option value="L">Legal Heirs</option>
                        </select>
                    </div>
                </div>
            </div>
            <div ng-if="vm.proceedsToBePaid == 'N'">
                <ng-form name ="vm.nominationDetailsForm">

                    <table ng-repeat = "item in vm.nomineeDetailsList track by $index" id="nominee{{$index}}" class="table table-bordered">
                        <tbody>

                        <tr>
                            <td colspan="4"><h4 class="form_heading">NOMINEE DETAILS {{$index+1}}</h4></td>
                        </tr>

                        <tr>
                            <td width="25%" class="form-group required">
                                <label class="control-label">Nominee First Name</label></td>
                            <td width="25%"><input type="text" class="form-control" id="firstName[$index]" chars="only-letters"
                                                   maxlength="50" name="firstName[$index]"
                                                   ng-model="item.nomineeName" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"></td>
                        </tr>

                        <tr>
                            <td width="25%" class="form-group required" >
                                <label class="control-label text-wrap">Date Of Birth(DD/MM/YYYY)</label></td>
                            <td width="25%">
                                <p class="input-group">
                                    <input type="text" class="form-control" id="dateofBirth[$index]"
                                           name="dateofBirth[$index]"
                                           ng-model="item.dateOfBirthOfMinor"
                                           uib-datepicker-popup="dd/MM/yyyy"
                                           is-open="item.dateOfBirthOptions.opened"
                                           close-text="Close" maxlength="10"  ng-blur="vm.textableDatePicker('dateofBirth[$index]',item.dateOfBirthOfMinor);vm.futureNotAllowed('dateofBirth[$index]',item.dateOfBirthOfMinor)"
                                           ng-keyup="vm.autoslashing('dateofBirth[$index]')" chars="numbers-slash" required>
                                    <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="item.dateOfBirthOptions.opened = true"
                                id="sadateOptions">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td width="25%" class="form-group required">
                                <label class="control-label">PAN No</label></td>
                            <td width="25%">
                                <input type="text" class="form-control" id="panNumber[$index]"
                                       name="panNumber[$index]" maxlength="10" chars="alpha-numeric"
                                       ng-model="item.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
                            </td>
                        </tr>



                        </tbody>
                    </table>
                    <!--<div class="row" >
                        <div class="form-group">
                            <div class="col-sm-3">
                                <label for="total" class="control-label">Total %</label>
                            </div>
                            <div class="col-sm-2">
                                <input type="text" class="form-control text-right" id="total" ng-init="vm.calculateSum();"
                                       chars="float" maxlength="5" ng-model="vm.total" readonly>
                            </div>
                        </div>
                    </div>-->



                </ng-form>
            </div>

            <div ng-if="vm.proceedsToBePaid == 'L'">
                <ng-form name="vm.legalHeirsDetailsListDetailsForm">
                    <div>
                        <table id="legalHeirsDetailsList{{$index}}" class="table table-bordered">
                            <tbody>
                            <tr>
                                <td colspan="4"><h4 class="form_heading">Legal Heirs</h4></td>
                            </tr>

                            <!-- Legal Heirs Name -->
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Legal Heirs Name</label>
                                </td>
                                <td width="25%">
                                    <input type="text" class="form-control" id="nomineeName{{$index}}"
                                           chars="only-letters" maxlength="50" name="nomineeName{{$index}}"
                                           ng-model="vm.legalHeirsDetailsList[0].nomineeName" required
                                           oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')">
                                </td>
                            </tr>

                            <!-- Legal Heirs DOB -->
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label for="dateofBirth{{$index}}" class="control-label">Legal Heirs DOB (DD-MMM-YYYY)</label>
                                </td>
                                <td width="75%">
                                    <div class="input-group">
                                        <!-- Display the formatted date -->
                                        <input type="text" class="form-control" id="dateofBirth{{$index}}"
                                               name="dateofBirth{{$index}}"
                                               ng-model="vm.legalHeirsDetailsList[0].dateOfBirthOfMinor"
                                               uib-datepicker-popup="dd-MMM-yyyy"
                                               datepicker-options="vm.dateOfBirthOptions"
                                               is-open="vm.dateOfBirthOptions.opened"
                                               ng-required="vm.proceedsToBePaid === 'L'" readonly />
                                        <span class="input-group-btn">
                                    <button type="button" class="btn btn-secondary"
                                            ng-click="vm.dateOfBirthOptions.opened = true">
                                        <i class="glyphicon glyphicon-calendar"></i>
                                    </button>
                                </span>
                                    </div>
                                </td>
                            </tr>

                            <!-- Legal Heirs PAN No -->
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Legal Heirs PAN No</label>
                                </td>
                                <td width="25%">
                                    <input type="text" class="form-control" id="panNumber{{$index}}"
                                           name="panNumber{{$index}}" maxlength="10" chars="alpha-numeric"
                                           ng-model="vm.legalHeirsDetailsList[0].panNo" ng-pattern="vm.panPattern"
                                           required  oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
                                </td>
                            </tr>

                            </tbody>
                        </table>
                    </div>
                </ng-form>
            </div>

            <!--            <div  ng-show="vm.proceedsToBePaid === 'L'">-->
                <!--<ng-form name="vm.nominationDetailsForm">
                    <div ng-repeat="item in vm.legalHeirsDetailsList">
                        <table class="table table-bordered" id="legalHeirs{{$index}}">
                            <tbody>
                            <tr>
                                <td colspan="4">
                                    <h4 class="form_heading">Legal Heirs</h4>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label for="firstName{{$index}}" class="control-label">Legal Heirs Name</label>
                                </td>
                                <td width="75%">
                                    <input type="text" class="form-control" id="firstName{{$index}}"
                                           name="firstName{{$index}}" ng-model="item.legalFirstName"
                                           placeholder="Enter Legal Heir's Name"
                                           maxlength="50" required
                                           ng-pattern="/^[a-zA-Z\s]*$/" />
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label for="dateofBirth{{$index}}" class="control-label">Legal Heirs DOB (DD/MM/YYYY)</label>
                                </td>
