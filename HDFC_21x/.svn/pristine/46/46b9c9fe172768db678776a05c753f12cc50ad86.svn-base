package com.isl.gbm.rbibond.dto.scrolls;

public class SubscriptionMandateDTO {

    private String schemeCode;
    private String schemeName;
    private String schemeStatus;
    private String fromDate;
    private  String cumAmount;
    private  String cumNonCumAmount;

    public String getCumAmount() {
        return cumAmount;
    }

    public void setCumAmount(String cumAmount) {
        this.cumAmount = cumAmount;
    }

    public String getCumNonCumAmount() {
        return cumNonCumAmount;
    }

    public void setCumNonCumAmount(String cumNonCumAmount) {
        this.cumNonCumAmount = cumNonCumAmount;
    }

    public String getCumTotalTran() {
        return cumTotalTran;
    }

    public void setCumTotalTran(String cumTotalTran) {
        this.cumTotalTran = cumTotalTran;
    }

    public String getNonCumTotalTran() {
        return nonCumTotalTran;
    }

    public void setNonCumTotalTran(String nonCumTotalTran) {
        this.nonCumTotalTran = nonCumTotalTran;
    }

    private String cumTotalTran;
    private String nonCumTotalTran;




    public String getSchemeCode() {
        return schemeCode;
    }

    public void setSchemeCode(String schemeCode) {
        this.schemeCode = schemeCode;
    }

    public String getSchemeName() {
        return schemeName;
    }

    public void setSchemeName(String schemeName) {
        this.schemeName = schemeName;
    }

    public String getSchemeStatus() {
        return schemeStatus;
    }

    public void setSchemeStatus(String schemeStatus) {
        this.schemeStatus = schemeStatus;
    }

    public String getFromDate() {
        return fromDate;
    }

    public void setFromDate(String fromDate) {
        this.fromDate = fromDate;
    }

    public String getToDate() {
        return toDate;
    }

    public void setToDate(String toDate) {
        this.toDate = toDate;
    }

    public String getFlag() {
        return flag;
    }

    public void setFlag(String flag) {
        this.flag = flag;
    }

    public String getNumber() {
        return number;
    }

    public void setNumber(String number) {
        this.number = number;
    }

    private String toDate;
    private String flag;
    private String number;
}
