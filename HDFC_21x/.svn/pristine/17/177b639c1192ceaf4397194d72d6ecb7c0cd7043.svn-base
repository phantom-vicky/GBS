<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.ListOfDtos.length > 0">
  <div class="container from_wrapper new_form_wrapper">
    <div class="text-right form_submit">
      <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/rbibond_gu_functionality';" id="homeButton">Home</button>
      <button type="button" id="cancel_Button" class="btn btn-cancel" onclick="window.location.href= '#!/BLA_statement_for_Bondholders_report/action/inquiry';">Back</button>
    </div>
    <div class="row">
      <h4 class="form_heading">BLA statement for bondholders</h4>
      <sol-header></sol-header>
      <div>
        <table style="width: 100%" class="table table-bordered" aria-label="">
          <tr>
            <th scope="col" colspan="1">Name of the Bond Scheme</th>
            <td colspan="1">{{vm.schemeName}}</td>
          </tr>
          <tr>
            <th scope="col" colspan="1">Total Count</th>
            <td colspan="1">{{vm.total}}</td>
          </tr>
          <tr data-ng-if="vm.fromDate">
            <th scope="col" colspan="1">From Date(DD/MM/YYYY)</th>
            <td colspan="1">{{vm.fromDate | date : 'dd/MM/yyyy'}}</td>
          </tr>
          <tr data-ng-if="vm.toDate">
            <th scope="col" colspan="1">To Date(DD/MM/YYYY)</th>
            <td colspan="2">{{vm.toDate | date : 'dd/MM/yyyy'}}</td>
          </tr>
        </table>
      </div>
    </div>

    <div class="row">
      <div class="col-sm-12">
        <div class="row" style="display: flex; align-items: center; justify-content: space-between">
          <!-- Show Dropdown -->
          <div class="col-sm-3" style="flex: 1">
            <div class="form-group">
              <label>
                Show
                <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                        ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                        ng-change="vm.pageNo = 1; vm.getDetails();" ng-disabled="vm.noDataFoundInSearch"
                >
                  <option value="5">5 per page</option>
                  <option value="10">10 per page</option>
                  <option value="20">20 per page</option>
                  <option value="50">50 per page</option>
                </select>
              </label>
            </div>
          </div>

          <!-- Search and Export Controls -->
          <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
            <!-- Search -->
            <div class="form-group" style="margin-right: 15px">
              <div class="input-group">
                <input type="text" id="search" class="form-control" data-ng-model="vm.searchText" placeholder="Search"/>
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search" data-ng-click=" vm.pageNo = 1; vm.getDetails()"></span>
                </div>
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchText=''; vm.pageNo = 1; vm.getDetails()"></span>
                </div>
              </div>
            </div>

            <!-- Export -->
            <div class="form-group">
              <select class="form-control" id="export" name="export" ng-model="vm.downloadType" data-ng-disabled="vm.noDataFoundInSearch" ng-init="vm.downloadType=''" ng-change="vm.downloadReport()" ng-disabled="vm.noDataFoundInSearch"
              >
                <option value="">EXPORT</option>
                <option value="excel">EXCEL</option>
                <option value="csv">CSV</option>
              </select>
            </div>
          </div>
        </div>


        <div class="table-responsive">
          <table class="table table-bordered table-striped list nowrap table-textWrap datatable" data-ng-if="(vm.schemeCode && vm.blaNo && !vm.panNum || vm.schemeCode && vm.blaNo && vm.panNum && !vm.fromDate && !vm.toDate)">
            <thead data-ng-if="!vm.noDataFoundInSearch">
              <tr>
                <th colspan="1">BLA No</th>
                <th colspan="1">{{vm.blaNo}}</th>
                <th colspan="1" data-ng-if="vm.bondHolderName">Holder Name</th>
                <th colspan="4">{{vm.bondHolderName}}</th>
              </tr>
              <tr>
                <th colspan="1">Address</th>
                <td colspan="6">{{vm.ListOfDtos.address}}</td>
              </tr>
              <tr class="thalign">
                <th>S.No</th>
                <th>Date of Subscription</th>
                <th>Subscription ID</th>
                <th>Bond Type</th>
                <th>Maturity Date</th>
                <th>Subscription Amount Rs.</th>
                <th>Subscription Status</th>
              </tr>
            </thead>
            <tbody data-ng-if="!vm.noDataFoundInSearch">
            <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
              <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                <td>{{x.dateOfSubscription}}</td>
                <td>{{x.subcriptionId}}</td>
                <td>{{x.bondtype}}</td>
                <td>{{x.maturitydate}}</td>
                <td>{{vm.indianNumberFormat(x.subcriptionamount)}}</td>
                <td>{{x.subsStatus}}</td>
              </tr>
            </tbody>

            <tfoot data-ng-if="!vm.noDataFoundInSearch">
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th class="text-bold">Total</th>
                <th class="text-right">{{vm.totalAmountInIndianFormat}}</th>
                <th></th>
              </tr>
            </tfoot>

            <tbody data-ng-if="vm.noDataFoundInSearch">
            <tr>
              <td>No Records Found</td>
            </tr>
            </tbody>
          </table>

          <table
            class="table table-bordered table-striped list nowrap table-textWrap datatable"
            data-ng-if="vm.schemeCode && vm.fromDate && vm.toDate && !vm.panNum && !vm.blaNo || (vm.schemeCode && vm.blaNo && vm.panNum && vm.bondHolderName && vm.fromDate && vm.toDate)"
          >
            <thead data-ng-if="!vm.noDataFoundInSearch">
              <tr class="thalign">
                <th scope="col">S.No</th>
                <th scope="col">Customer Name</th>
                <th scope="col">Address</th>
                <th scope="col">PAN No</th>
                <th scope="col">BLA No</th>
                <th scope="col">Date of Subscription</th>
                <th scope="col">Subscription ID</th>
                <th scope="col">Bond Type</th>
                <th scope="col">Maturity Date</th>
                <th scope="col">Subscription Amount Rs.</th>
                <th scope="col">Subscription Status</th>
              </tr>
            </thead>
            <tbody data-ng-if="!vm.noDataFoundInSearch">
            <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
              <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                <td>{{x.bondholdername}}</td>
                <td>{{x.address}}</td>
                <td>{{x.panNo}}</td>
                <td>{{x.blaNumber}}</td>
                <td>{{x.dateOfSubscription}}</td>
                <td>{{x.subcriptionId}}</td>
                <td>{{x.bondtype}}</td>
                <td>{{x.maturitydate}}</td>
                <td>{{vm.indianNumberFormat(x.subcriptionamount)}}</td>
                <td>{{x.subsStatus}}</td>
              </tr>
            </tbody>

            <tfoot data-ng-if="!vm.noDataFoundInSearch">
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th scope="col" class="text-bold">Total</th>
                <th scope="col" class="text-right">{{vm.totalAmountInIndianFormat}}</th>
                <th scope="col"></th>
              </tr>
            </tfoot>

            <tbody data-ng-if="vm.noDataFoundInSearch">
            <tr>
              <td>No Records Found</td>
            </tr>
            </tbody>

          </table>

          <table class="table table-bordered table-striped list nowrap table-textWrap datatable" data-ng-if="vm.schemeCode && vm.panNum && !vm.blaNo" aria-label="">
            <thead data-ng-if="!vm.noDataFoundInSearch">
              <tr>
                <th scope="col" colspan="2">PAN No</th>
                <th scope="col" colspan="2">{{vm.panNum}}</th>
                <th scope="col" colspan="2" data-ng-if="vm.bondHolderName">Holder Name</th>
                <th scope="col" colspan="2">{{vm.bondHolderName}}</th>
              </tr>
              <tr>
                <th scope="col" colspan="1">Address</th>
                <td colspan="6">{{vm.ListOfDtos.address}}</td>
              </tr>
              <tr class="thalign">
                <th scope="col">S.No</th>
                <th scope="col">BLA No</th>
                <th scope="col">Subscription ID</th>
                <th scope="col">Date of Subscription</th>
                <th scope="col">Bond Type</th>
                <th scope="col">Maturity Date</th>
                <th scope="col">Subscription Amount Rs.</th>
                <th scope="col">Subscription Status</th>
              </tr>
            </thead>
            <tbody data-ng-if="!vm.noDataFoundInSearch">
            <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
              <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                <td>{{x.blaNumber}}</td>
                <td>{{x.subcriptionId}}</td>
                <td>{{x.dateOfSubscription}}</td>
                <td>{{x.bondtype}}</td>
                <td>{{x.maturitydate}}</td>
                <td style="text-align:right">{{vm.indianNumberFormat(x.subcriptionamount)}}</td>
                <td>{{x.subsStatus}}</td>
              </tr>
            </tbody>

            <tfoot data-ng-if="!vm.noDataFoundInSearch">
              <tr>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th></th>
                <th scope="col" class="text-bold">Total</th>
                <th scope="col" class="text-right">{{vm.totalAmountInIndianFormat}}</th>
              </tr>
            </tfoot>

            <tbody data-ng-if="vm.noDataFoundInSearch">
            <tr>
              <td>No Records Found</td>
            </tr>
            </tbody>
          </table>
        </div>
        <br />
        <div class="text-center form_submit">
              <span ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev</button>
              </span>

          <span>
                <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

          <span ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();">Next</button>
              </span>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="container" ng-if="vm.noDataFound">
  <div class="list_wrapper no_records_message">
    <h4 class="form_heading">BLA statement for bondholders</h4>
    No records found to display.
    <center>
      <button type="button" class="btn btn-default" onclick="window.location.href= '#!/BLA_statement_for_Bondholders_report/action/inquiry';">Back</button>
    </center>
  </div>
</div>
