package com.isl.gbm.rbibond.dto.reports;


import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import java.io.Serializable;

@Entity
@Table(name = "GBM_RBI_BOND_SUBSCRIPTION_FLOW")
public class SubscriptionFlowTableDTO  implements Serializable {

    @Id
    @Column(name = "ID")
    private String ID;

    @Column(name = "BRANCH_ID")
    private String BRANCHID;

    @Column(name = "GBM_TRAN_REF_ID")
    private String GBMTRANREFID;

    @Column(name = "SCH_CODE")
    private String SCHCODE;

    @Column(name = "GBM_TRAN_ID")
    private String GBMTRANID;


    @Column(name = "SUBSCRIPTION_AMOUNT")
    private String BONDSUBCRIPTIONAMOUNT;

    @Column(name = "SUBCRIPTION_DATE")
    private String SUBCRIPTIONDATE;

    @Column(name = "MODE_OF_INTEREST_PAYMENT")
    private String MODEOFINTERESTPAYMENT;

    @Column(name = "CREATED_DATE")
    private String CREATEDDATE;

    @Column(name = "SINGLE_BOND_LEDGER_ACC_NUM")
    private String SINGLEBONDLEDGERACCOUNTNUMBER;

    @Column(name = "FIRST_JOINT_HLDR_BLA_NO")
    private String FIRSTJOINTHOLDERBLANO;


    @Column(name = "BOND_HOLDER_NAME")
