<!-- Second Page-->
<div class="container from_wrapper">

<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<h4 class="form_heading">CAS ACKNOWLEDGEMENT NUMBER MAINTENANCE  -Delete</h4>
<sol-header></sol-header>

<!--<div class="container from_wrapper new_form_wrapper">-->
    <div class="row">
        <div class="col-sm-12">
            <div class="table-responsive">
                <table class="table table-bordered table-striped list">

                    <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Bond Ledger Account Number</th>
                        <th>Holder Name</th>
                        <th>Subscription ID</th>
                        <th>Subscription Amount</th>
                        <th>Bond Type</th>
                        <th>CAS Acknowledgement Number</th>
                        <th>CAS Acknowledgement Date (dd/mm/yyyy)</th>

                    </tr>
                    </thead>
                    <tbody>
                    <tr ng-repeat="items in vm.model" ng-init="parentIndex=$index;">
                        <td>{{vm.itemsPerPage*(vm.currentPage-1)+$index+1}}</td>
                        <td>{{items.bondLedgeAccNum}}</td>
                        <td>{{items.holderName}}</td>
                        <td>{{items.subsId}}</td>
                        <td>{{items.subsAmt}}</td>
                        <td>{{items.bondType}}</td>
                        <td>
                            <input type="text" class="form-control" id="casAckNum"
                                   name="casAckNum" chars="only-numbers" ng-value="items.casAckNum" ng-model="items.casAckNum" >
                        </td>
                        <td>
                            <input type="text" class="form-control" id="casAckDate"
                                   name="casAckDate"  ng-value="items.casAckDate" ng-model="items.casAckDate" >
                        </td>
                        <!--                            <td input type="text" ng-model="vm.casAckNum" id="casAckNum" name="casAckNum"></td>-->
                        <!--                                <td input type="text" ng-model="vm.casAckDate" id="casAckDate" name="casAckDate"></td>-->
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified By </b> : {{(vm.auditInfo.lastModifiedBy) ? (vm.auditInfo.lastModifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified By </b> : {{(vm.auditInfo.lastVerifiedBy) ? (vm.auditInfo.lastVerifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified On</b> : {{ (vm.auditInfo.lastModifiedDate) ? (vm.auditInfo.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified On </b> : {{(vm.auditInfo.lastVerifiedDate) ? (vm.auditInfo.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
            </div>
        </div>
    </div>

<!--</div>-->

<div class="text-center form_submit">
    <button type="submit" class="btn btn-default" id="submitButton"
            ng-click="vm.submitDeleteForm();">Submit</button>

    <button type="button" id="otherpen_cancelButton" class="btn btn-cancel"
            onclick="window.location.href= '#!/cas_acknowledgement_number_maintenance/action/inquiry';">Cancel</button>
</div>

</div>