                                    </tr>
                                    <tr>
                                        <td>Guardian Middle Name</td>
                                        <td class="old-value">{{(vm.getDetails.guardianDetailsValueModel[0] && vm.getDetails.guardianDetailsValueModel[0].C007)?
                                            (vm.getDetails.guardianDetailsValueModel[0].C007.oldValue) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.guardianDetailsValueModel[0] &&
