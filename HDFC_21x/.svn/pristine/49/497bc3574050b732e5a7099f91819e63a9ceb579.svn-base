<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">User Work Class
        Information - Delete</h4>
    <sol-header></sol-header>
    <form name="userDetailsForm" role="form">

        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.verifyDeleteLists.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.verifyDeleteLists.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>User ID</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C001)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C001.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue &&
                    vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C001)? (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C001.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User work class</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C003.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Sol ID</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C004)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C004.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C004)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C004.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User Sol
                    Tenor</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C005.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C005)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C005.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User
                    Max Inactive Time</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C006)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C006.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C006)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C006.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User
                    Account Expiry Date</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C007)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C007.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C007)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C007.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User
                    Appl Name</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C009)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C009.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C009)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C009.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>User
                    Password Expiry Date</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C008)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C008.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C008)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C008.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>New User
                    Flag</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C010)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C010.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C010)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C010.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Default
                    term ID</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C011)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C011.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C011)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C011.newValue) : ('')}}
                </td>
            </tr><tr>
                <td>Virtual Flag</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C012)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C012.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C012)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C012.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Additional Text1</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C014)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C014.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C014)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C014.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text2</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C015)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C015.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C015)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C015.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text3</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C016)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C016.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsUserDetailsOldNewValue && vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C016)?
                    (vm.verifyDeleteLists.cbsUserDetailsOldNewValue.C016.newValue) : ('')}}
                </td>
            </tr>
            </tbody>
        </table>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.verifyDeleteLists.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.verifyDeleteLists.modifiedBy) ? (vm.verifyDeleteLists.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.verifyDeleteLists.verifiedBy) ? (vm.verifyDeleteLists.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.verifyDeleteLists.verifiedFlag  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.verifyDeleteLists.creatDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.verifyDeleteLists.modDate) ? (vm.verifyDeleteLists.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.verifyDeleteLists.verDate) ? (vm.verifyDeleteLists.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="vm.userDetailsForm.$invalid" ng-click="vm.deleteSubmit()">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    ng-click="vm.showCancelConfirmation('cbs_user_work_class_information.delete');">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
