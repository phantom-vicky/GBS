<!--<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>-->

<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.model.length>0">

    <div class="container from_wrapper new_form_wrapper">
        <div class="text-right form_submit">
            <button
                    type="submit"
                    class="btn btn-default"
                    onclick="window.location.href ='#!/';"
                    id="homeButton"
            >
                Home
            </button>
            <button
                    type="button"
                    class="btn btn-cancel"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';"
                    id="homeButton1"
            >
                Back
            </button>
        </div>
        <div class="row">
            <h4 class="form_heading">
                List of Bond Investments Pending Receipt of CAS Advice No
            </h4>
            <sol-header></sol-header>
<!--            <form-->
<!--                    name="listofBondinvestmentForm"-->
<!--                    role="form"-->
<!--                    data-ng-init="vm.getListofbondInvestmentReport();"-->
<!--            ></form>-->
                <table style="width:100%" class="table table-bordered"
                       aria-label="table">
                    <tr>
                        <th scope="" style="width:20%">Total Count</th>
                        <td style="width:20%">{{vm.total}}</td>
                    </tr>
                </table>
            <div class="row" data-ng-if="vm.model">
                <div class="col-sm-12">

                    <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                        <div class="col-sm-3" style="flex: 1">
                            <div class="form-group">
                                <table style="border-spacing: 2" aria-label="BPRR">
                                    <tr>
                                        <th scope="col"></th>
                                    </tr>
                                    <tr>
                                        <td>Show&nbsp;</td>
                                        <td>
                                            <select
                                                    class="form-control pageDropDown"
                                                    id="pageSize"
                                                    name="pageSize"
                                                    ng-model="vm.pageSize"
                                                    ng-init="vm.pageSize='5'"
                                                    ng-change="vm.pageNo='1'; vm.getListofbondInvestmentReport();"
                                                    data-ng-disabled="vm.noDataFoundInSearch"
                                            >
                                                <option value="5">5 per page</option>
                                                <option value="10">10 per page</option>
                                                <option value="20">20 per page</option>
                                                <option value="50">50 per page</option>
                                            </select>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                            <div class="form-group" style="margin-right: 15px">
                                <div class="input-group">
                                    <input type="text" id="search" class="form-control" data-ng-model="vm.searchValue" placeholder="Search" />
                                    <div class="input-group-addon">
                                        <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getListofbondInvestmentReport()"></span>
                                    </div>
                                    <div class="input-group-addon">
                                        <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchValue='';vm.pageNo = 1; vm.getListofbondInvestmentReport(); "></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <select
                                        class="form-control"
                                        id="export"
                                        name="export"
                                        data-ng-model="vm.downloadType"
                                        data-ng-init="vm.downloadType=''"
                                        data-ng-change="vm.downloadReport()"
                                        data-ng-disabled="vm.noDataFoundInSearch"
                                >
                                    <option value="">EXPORT</option>
                                    <option value="excel">EXCEL</option>
                                    <option value="csv">CSV</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">


                        <table class="table table-bordered table-striped list table-textWrap datatable"  aria-label="List of bond investment details">
                            <thead data-ng-if="!vm.noDataFoundInSearch">
                            <tr class="thalign">
                                <th scope="col">S.No.</th>
                                <th scope="col">BLA Number</th>
                                <th scope="col">Bond Scheme</th>
                                <th scope="col">Subscription Date</th>
                                <th scope="col">Subscription Amount</th>
                            </tr>
                            </thead>
                            <tbody data-ng-if="!vm.noDataFoundInSearch">
                            <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">


                                <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                                <td>{{x.blaNumber}}</td>
                                <td>{{x.schemeName}}</td>
                                <td>{{x.subsDate}}</td>
                                <td  style="text-align: right">{{vm.indianNumberFormat(x.subsAmount)}}</td>
                            </tr>
                            <tr>
                                <th scope="col"  style="text-align: left" colspan="3"></th>
                                <th scope="col"  style="text-align: left">Total</th>
                                <th scope="col" class="text-right">{{vm.indianNumberFormat(vm.SubscriptionTotalAmount)}}</th>
                            </tr>

                            </tbody>
                            <tbody data-ng-if="vm.noDataFoundInSearch">
                            <tr>
                                <td style="text-align:center">No Records Found</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                    <br/>
                    <div class="text-center form_submit">
              <span data-ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
              </span>

                        <span>
                <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

                        <span data-ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
              </span>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">List of Bond Investments Pending Receipt of CAS Advice No</h4>
        No records found to display.
        <div style="text-align: center">
            <button type="button" class="btn btn-default" onclick="window.location.href='#!/rbibond_gu_functionality';">Back</button>
        </div>
    </div>
</div>
