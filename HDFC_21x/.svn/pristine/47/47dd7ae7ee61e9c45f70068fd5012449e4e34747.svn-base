package com.isl.gbm.cbs.integration.dto.wrapper;

import java.util.List;

public class BCIFRequestDTO {

    private String id;

    public List<BCIFResponseDTO> getBcifList() {
        return bcifList;
    }

    public void setBcifList(List<BCIFResponseDTO> bcifList) {
        this.bcifList = bcifList;
    }

    private List<BCIFResponseDTO> bcifList;

    public String getId() {
        return id;
    }

    public void setId(String id) {
        this.id = id;
    }

    public String getRqUID() {
        return rqUID;
    }

    public void setRqUID(String rqUID) {
        this.rqUID = rqUID;
    }

    private String rqUID;
}
