<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">TDS Eligibility Report</h4>
    <sol-header></sol-header>

    <form name="accountOpeningForm" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <!--Scheme name-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="schemeCode" ng-model="vm.schemeName"
                           required />
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearcher" ng-click="vm.getModuleName();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.schemeCode ='';vm.schemeName =''; vm.schemeStatus='';vm.panNo=''; vm.fromdate=''; vm.todate='';"></i>
                </div>
            </div>
        </div>



        <!--PAN NO-->
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">PAN NO</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input
                                type="text"
                                class="form-control"
                                name="panNo"
                                ng-model="vm.panNo"
                                chars="alpha-numeric"
                                ng-pattern="vm.panPattern"
                                minlength="4"
                                maxlength="10"
                                oninput="this.value = this.value.replace(/\s+/g, '')"
                        />
                    </p>
                </div>
                <div class="col-sm-2" ng-if="vm.panNo || vm.schemeName">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getPanTorch();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.panNo ='';"></i>
                </div>
            </div>
        </div>

        <!--FROM DATE-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label class="control-label">TDS Deduction From Date</label></div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input
                                type="text"
                                class="form-control"
                                id="efffromDate1"
                                name="efffromDate"
                                ng-model="vm.fromDate"
                                uib-datepicker-popup="dd/MM/yyyy"
                                ng-init="vm.fromDate=''; vm.fromDateVal()"
                                ng-change="vm.toDateVal(vm.fromdate); vm.todate=''"
                                datepicker-options="vm.fromDateOptions"
                                is-open="vm.efffromDatePicker.opened"
                                close-text="Close"
                                maxlength="10"
                                ng-blur="vm.textableDatePicker('effFromDate1',vm.fromDate)"
                                ng-keyup="vm.autoslashing('effFromDate1')" chars="numbers-slash"
                                required
                        />
                        <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.efffromDatePicker.opened = true" id="efffromDateSearcher1">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
                    </p>
                </div>
            </div>
        </div>

        <!--TO DATE-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label class="control-label">TDS Deduction To Date</label></div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input
                                type="text"
                                class="form-control"
                                id="efftoDate"
                                name="efftoDate"
                                ng-model="vm.toDate"
                                uib-datepicker-popup="dd/MM/yyyy"
                                ng-init="vm.toDate=''"
                                datepicker-options="vm.toDateOptions"
                                is-open="vm.efftoDatePicker.opened"
                                close-text="Close"
                                maxlength="10"
                                ng-blur="vm.textableDatePicker('efftoDate',vm.toDate)"
                                ng-keyup="vm.autoslashing('efftoDate')" chars="numbers-slash"
                                required
                        />
                        <span class="input-group-btn">
              <button type="button" class="btn btn-secondary" ng-click="vm.efftoDatePicker.opened = true" id="efftoDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
                    </p>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button
                    type="submit"
                    class="btn btn-default"
                    id="submitButton"
                    ui-sref="tds_eligibility_report.inquiry_detail({obj:{
								schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								schemestatus: vm.schemestatus,
                                panNo: vm.panNo,
                                toDate : vm.toDate,
                                fromDate: vm.fromDate,
								}})"
                    ng-disabled="accountOpeningForm.$invalid"
            >
                Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!--Scheme Name  and Status Model-->
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.modalSearch=''">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''" placeholder="Search"
                                       oninput = "this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <th scope="col"
                                        class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                        ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        Scheme Name
                                    </th>
                                    <th scope="col"
                                        class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                        ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr
                                        class="cp"
                                        ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                                        data-bs-dismiss="modal"
                                >

                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>


<!--panNo modal-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search"  minlength="4"
                                       maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                                <tr>
                                    <th scope="col"
                                        ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                                        ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        PAN NO
                                    </th> <th scope="col"
                                        ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';"
                                        ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        BLA NO
                                    </th>
                                    <th scope="col"
                                        ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                        ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        HOLDER NAME
                                    </th>   <th scope="col"
                                        ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                                        ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        MODE OF HOLDING
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr
                                        class="cp"
                                        ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.panNo= x.panNo; vm.holderName= x.holderName; vm.blaNo =x.blaNo; vm.modeOfHolding=x.modeOfHolding;"
                                        data-bs-dismiss="modal"
                                >
                                    <td>{{x.panNo}}</td>
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.holderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>
