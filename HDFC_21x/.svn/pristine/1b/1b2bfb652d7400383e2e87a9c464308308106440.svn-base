.panel-default.ng-isolate-scope.panel .panel-heading {
    background-color: #b6cde2;
}

.panel-default.ng-isolate-scope.panel.panel-open .panel-heading {
    background-color: #1f629a;
    color: #fff;
}
a.accordion-toggle {
	    text-decoration: none;
}
/*Accordion*/

.form-control {
    text-transform: uppercase;
    min-height: 34px;
    height: 100%;
}

.text-link{
	color: blue;
	text-decoration: underline;
}

.no-margin-top-bottom{
	margin-top: 0px !important;
	margin-bottom: 0px !important;
}

.no-margin-top{
	margin-top: 0px !important;
}


.space-10{
	height: 10px;
	display: block;
}


/* List Permissions */
.well{
    min-height: 20px;
    padding: 19px;
    margin-bottom: 20px;
    background-color: #f5f5f5;
    border: 1px solid #e3e3e3;
    border-radius: 4px;
    box-shadow: inset 0 1px 1px rgba(0,0,0,.05);
}

.custom-trigger{
    padding: .75em;
    margin-top: 1.5em;
    border: 1px solid #ccc;
    cursor: pointer;
}

/* End List Permissions */

/* Date Picker UIB */
.uib-datepicker-popup.dropdown-menu{
	background: #fff;
}
.uib-daypicker{
	outline: 0px;
}
.uib-right.btn-default,
.uib-right.btn-default:hover,
.uib-left.btn-default,
.uib-left.btn-default:hover,
.uib-year .btn-default,
.uib-year .btn-default:hover,
.uib-month .btn-default,
.uib-month .btn-default:hover,
.uib-daypicker .btn-default,
.uib-daypicker .btn-default:hover{
	background: #fff;
	color:#1f629a;
	border: 0px;
}

/* Date Picker UIB */

.panel .panel-heading .accordion-toggle:before {
    /* symbol for "opening" panels */
    font-family: 'Glyphicons Halflings';
    float: left;
    content: "\002b";
    margin-right: 10px;
}
.panel.panel-open .panel-heading .accordion-toggle:before {
    /* symbol for "collapsed" panels */
    content: "\2212";
}
/* nested accordion pannel */
#nested-uib .panel .panel-heading .accordion-toggle:before {
    /* symbol for "opening" panels */
    content: "\002b" !important;
}
#nested-uib .panel.panel-open .panel-heading .accordion-toggle:before {
    /* symbol for "collapsed" panels */
    content: "\2212" !important;
}


/* Dual List style start */
.v-center {
    min-height: 200px;
    display: flex;
    justify-content: center;
    flex-flow: column wrap;
}

.ngduallist .left-container .left-sub-container {
    height: 300px;
    overflow-y: auto;
    border: 1px solid #e5e5e5;
}

.ngduallist .right-container .right-sub-container {
    height: 300px;
    overflow-y: auto;
    border: 1px solid #e5e5e5;
}

.ngduallist .input-group {
    margin-bottom: 20px;
    width: 100%;
}

.ngduallist .input-group .input-group-addon {
    width: 10px;
}

.ngduallist label {
    display: block;
    color: #578ebe;
    text-transform: uppercase;
}

.ngduallist .info {
    display: inline-block;
    margin-bottom: 5px;
    font-size: 11px;
}

/* Dual list style end*/

