<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper" ng-if="vm.result.verifiedStatus != null">
	<h4 class="form_heading">Branches Of the Bank -
		Delete</h4>
	<sol-header></sol-header>


	<table class="table table-bordered table-striped list old-new-value-table">
		<thead>
		<tr>
			<th width="50%">Particular</th>
			<th width="25%">{{(vm.result.prevOperationType == 'M')?('Old Value'): ('Value')}}</th>
			<th width="25%" ng-if="vm.result.prevOperationType == 'M'">New Value</th>
		</tr>
		</thead>
		<tbody>
		<tr>
			<td>SOL ID</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C001)?
				(vm.oldNewValueList.C001.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C001? (vm.oldNewValueList.C001.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>Branch Name Description</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C002)?
				(vm.oldNewValueList.C002.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C002? (vm.oldNewValueList.C002.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>Bank Code</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C003)?
				(vm.oldNewValueList.C003.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C003? (vm.oldNewValueList.C003.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>Branch Code</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C004)?
				(vm.oldNewValueList.C004.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C004? (vm.oldNewValueList.C004.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>MICR Center Code</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C005)?
				(vm.oldNewValueList.C005.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C005? (vm.oldNewValueList.C005.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>MICR Bank Code</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C006)?
