<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">User Work Class
        Information - Delete</h4>
    <sol-header></sol-header>
    <form name="userDetailsForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="userId" class="control-label">User ID</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="userId"
                               ng-model="vm.userId" readonly required>
                    </div>
                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="userIdSearch"
                           ng-click="vm.verifyDeleteTorch();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.userId ='';"></i>
                    </div>
                </div>
            </div>
            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ui-sref="cbs_user_work_class_information.delete_detail({obj:{
								userId: vm.userId,
								verifyDeleteLists : vm.verifyDeleteLists,
								}})"
                        ng-disabled="userDetailsForm.$invalid">Submit</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href = '#!/cbs_master_updation'">Cancel</button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>


<!-- UserId Start-->
<div class="modal" id="verifyDeleteModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">User ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.verifyDeleteLists.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'userId'">
                                <tr>
                                    <th width="27%" ng-click="(sortedColumn == 'userId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'userId';" ng-class="(sortedColumn == 'userId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">User Id</th>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.verifyDeleteLists | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.userId= x.userId;vm.verifyDeleteTorch();" data-bs-dismiss="modal">
                                    <td width="27%">{{x.userId}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.verifyDeleteLists.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- UserId End-->