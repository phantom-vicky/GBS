<!-- Modal SOL ID-->
	<div class="modal" id="solIDModal" role="dialog">
	  <div class="modal-dialog">
	    <!-- Modal content-->
	    <div class="modal-content">
	      <div class="modal-header">
	        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
	        <h4 class="modal-title">Help Index</h4>
	      </div>
	      <div class="modal-body">
	        <div class="list_wrapper" ng-if="list.length>0">
		        <div class="col-sm-8 form_submit">				    
					  <div class="form-group">
					    <div class="input-group">
					      <div class="input-group-addon"><i class="glyphicon glyphicon-search"></i></div>
					      <input type="text" class="form-control" ng-model="searchSolId" placeholder="Search">
					    </div>
					  </div>
				</div>
				<div class="col-sm-4 form_submit"></div>
				<div class="row">
					<div class="col-sm-12">
						<table class="table table-bordered list scroll">
						    <thead>
						      <tr>
						        <th>Sol ID.</th>
						        <th>Description</th>
						      </tr>
						    </thead>
						    <tbody>
						      <tr class="cp" ng-repeat="x in list | filter:searchSolId" ng-click="setSolID(x);">
						        <td>{{x.solId}}</td>
						        <td>{{x.solDescription}}</td>
						      </tr>
						    </tbody>
						 </table>
					</div>
				</div>
			</div>
			<div class="list_wrapper" ng-if="list.length==0">No records found to display.</div>
	      </div>
	    </div>
	  </div>
	</div>
	<!-- Modal SOL ID - End -->
	
	
	<!-- list result -->
	<div class="loader" style="display: none;"></div>
	<div class="container list_wrapper" ng-if="bodStatusInquiryList.length>0">
		<table class="table table-bordered table-striped list">
		    <thead>
		      <tr>
		      	<th>Sl. No.</th>
		      	<th>Sol ID</th>
		      	<th>Sol Description</th>
		      	<th>BOD Date</th>
		      	<th>Scheme Name</th>
		      	<th>BOD Status</th>
		      </tr>
		    </thead>
		    <tbody>
		      <tr ng-repeat="x in bodStatusInquiryList">
		        <td>{{$index + 1}}</td>
		        <td>{{x.solId}}</td>
		        <td>{{x.solDescription}}</td>
		        <td>{{x.bodDate | date : "dd/MM/y"}}</td>
		        <td>{{x.schemeName}}</td>
		        <td>{{x.statusName}}</td>
		      </tr>
		    </tbody>
	 	</table>
	</div>
	<div class="list_wrapper no_records_message" ng-if="bodStatusInquiryList.length==0">No records found to display.</div>
	<!-- list result - End -->
	