<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container"   data-ng-if="
     vm.partANonCumulativeList.length > 0 || vm.partACumulativeList.length > 0 ||
            vm.partBNonCumulativeList.length > 0 || vm.partBCumulativeList.length > 0 ||
            vm.partCNonCumulativeList.length > 0 || vm.partCCumulativeList.length > 0 ||
            vm.partDNonCumulativeList.length > 0 || vm.partDCumulativeList.length > 0
">

    <div class="container from_wrapper new_form_wrapper">
        <div class="text-right form_submit">
            <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/'" id="homeButton">Home</button>
            <button type="button" id="cancel_Button" class="btn btn-cancel"
                    onclick="window.location.href= '#!/Appendix_IV_8_Mar_2024/action/inquiry';">Back
            </button>
        </div>
        <h4 class="form_heading">Appendix IV 8%</h4>

        <table style="width:100%" class="table table-bordered" aria-label="">

            <tr>
                <th scope="col" >Name of the Bond Scheme</th>
                <td>{{vm.schemeName}}</td>
            </tr>
            <tr>
                <th scope="col" >From Date</th>
                <td>{{vm.fromDate | date : 'dd/MM/yyyy'}}</td>
            </tr>
            <tr>
                <th scope="col" >To Date</th>
                <td>{{vm.toDate | date : 'dd/MM/yyyy'}}</td>
            </tr>
        </table>

        <div class="row">
            <div class="col-sm-12">
                <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                    <div class="col-sm-3" style="flex: 1; visibility:hidden">
                        <div class="form-group">
                            <table style="border-spacing: 2" aria-label="">
                                <tr>
                                    <th scope="col"></th>
                                </tr>
                                <tr>
                                    <td>Show&nbsp;</td>
                                    <td>
                                        <select id="pageSize" class="form-control filter-control" data-ng-model="vm.pageSize"
                                                data-ng-change="vm.updatePageSize()"
                                                data-ng-options="option for option in vm.pageSizeOptions"></select>
                                    </td>
                                    <td>&nbsp;records per page</td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                        <div class="form-group" style="margin-right: 15px; visibility:hidden">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" id="search" class="form-control" data-ng-change="vm.updateFilteredRecords()"
                                       data-ng-model="vm.searchText" placeholder="Search"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <select class="form-control" id="export" name="export" data-ng-model="vm.downloadType"
                                    data-ng-init="vm.downloadType=''" data-ng-change="vm.downloadReport()">
                                <option value="">EXPORT</option>
                                <option value="excel">EXCEL</option>
                                <!--<option value="csv">CSV</option>-->
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive" id="myTable">
                    <table id="myTable1" class="table table-bordered table-striped list table-textWrap" aria-label="">
                        <thead>
                        <tr>
                            <th scope="col" colspan="2">PART A</th>
                            <th scope="col" colspan="7" rowspan="2" style="text-align:center">HDFC BANK LTD</th>
                            <th scope="col"></th>
                            <th scope="col">APPENDIX IV</th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="2">Mumbai</th>
                            <th scope="col"></th>
                            <th scope="col"></th>
                            <th scope="col"></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="2">8% Relief Bond</th>
                            <th scope="col"></th>
                            <th scope="col"></th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="11" style="text-align:center">
                                Statement of Bonds Issued/Transferred/Repaid etc for the month of {{vm.fromDate ? (vm.fromDate | date:'MMM yyyy' | uppercase) : '' }}
                            </th>
                        </tr>
                        <tr>
                            <th scope="col" colspan="11" style="text-align:center">
