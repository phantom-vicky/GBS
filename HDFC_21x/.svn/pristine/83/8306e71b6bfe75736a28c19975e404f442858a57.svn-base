                                </tbody>
                            </table>
                            <table class="table table-bordered table-striped list old-new-value-table" ng-if=" vm.getDetails.masterDetailsValueModel[0].C003.oldValue =='MH004' && vm.getDetails.coparsDetailsValueModel.length > 0">
                                <thead>
                                </thead>
