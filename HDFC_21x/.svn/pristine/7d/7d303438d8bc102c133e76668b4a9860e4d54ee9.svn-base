<div class="loader-new" ng-if="vm.loader"></div>

<div class="container from_wrapper new_form_wrapper" ng-if="!vm.loader && vm.detailRows.length">
    <div class="text-right form_submit no-print">
        <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/dc';" id="homeButton">Home</button>
        <button type="button" class="btn btn-default" ng-click="vm.printpage('Transfer Report')">Print</button>
        <button type="button" class="btn btn-cancel" onclick="window.location.href= '#!/transfer_report/action/inquiry';">Back</button>
    </div>

    <h4 class="form_heading">Transfer Report</h4>
    <sol-header></sol-header>

    <div class="row report-subtitle-row">
        <div class="col-sm-12">
            <table class="table table-bordered report-title-table" aria-label="Transfer report criteria">
                <tr>
                    <th scope="col" class="report-label-col-w-25">Name of the Bond Scheme</th>
                    <td>{{vm.schemeName || 'Across Scheme'}}</td>
                    <th scope="col" class="report-label-col-w-25">Transfer Type</th>
                    <td>{{vm.displayTransferType(vm.transferType) || 'All'}}</td>
                </tr>
                <tr ng-if="vm.panNum">
                    <th scope="col">PAN No</th>
                    <td colspan="3">{{vm.panNum}}</td>
                </tr>
                <tr ng-if="vm.blaNo">
                    <th scope="col">BLA No</th>
                    <td colspan="3">{{vm.blaNo}}</td>
                </tr>
                <tr ng-if="vm.fromDate && vm.toDate">
                    <th scope="col">Transfer From Date</th>
                    <td>{{vm.fromDate | date:'dd/MM/yyyy'}}</td>
                    <th scope="col">Transfer To Date</th>
                    <td>{{vm.toDate | date:'dd/MM/yyyy'}}</td>
                </tr>
            </table>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-striped list nowrap table-textWrap datatable" aria-label="Transfer report data">
            <thead>
            <tr class="thalign">
                <th scope="col" rowspan="2">S No</th>
                <th scope="col" rowspan="2">Name of the Bond Scheme</th>
                <th scope="col" rowspan="2">Transfer Type</th>
                <th scope="colgroup" colspan="8" class="text-center">From BLA Holder Details</th>
                <th scope="colgroup" colspan="10" class="text-center">To BLA Holder Details</th>
                <th scope="colgroup" colspan="6" class="text-center">Subscription Details</th>
            </tr>
            <tr class="thalign">
                <th scope="col">From BLA Mode of Holding</th>
                <th scope="col">From BLA Account Number</th>
                <th scope="col">Transferor Holder Name 1</th>
                <th scope="col">Transferor Holder 1 PAN No</th>
                <th scope="col">Transferor Holder Name 2</th>
                <th scope="col">Transferor Holder 2 PAN No</th>
                <th scope="col">Transferor Holder Name 3</th>
                <th scope="col">Transferor Holder 3 PAN No</th>
                <th scope="col">To BLA Account Number</th>
                <th scope="col">To BLA Mode of Holding</th>
                <th scope="col">Transferee Holder Name 1</th>
                <th scope="col">Transferee Holder 1 PAN No</th>
                <th scope="col">Transferee Holder Name 2</th>
                <th scope="col">Transferee Holder 2 PAN No</th>
                <th scope="col">Transferee Holder Name 3</th>
                <th scope="col">Transferee Holder 3 PAN No</th>
                <th scope="col">Date of Transfer</th>
                <th scope="col">Remarks</th>
                <th scope="col">S No</th>
                <th scope="col">From Subscription ID</th>
                <th scope="col">To Subscription ID</th>
                <th scope="col">CFD Date</th>
                <th scope="col">Maturity Date</th>
                <th scope="col">Subscription Amount</th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat="row in vm.detailRows track by $index">
                <td>{{row.sNo}}</td>
                <td>{{row.bondSchemeName}}</td>
                <td>{{vm.displayTransferType(row.transferType)}}</td>
                <td>{{row.fromBlaModeOfHolding}}</td>
                <td>{{row.fromBlaAccountNumber}}</td>
                <td>{{row.transferorHolderName1}}</td>
                <td>{{row.transferorHolder1PanNo}}</td>
                <td>{{row.transferorHolderName2}}</td>
                <td>{{row.transferorHolder2PanNo}}</td>
                <td>{{row.transferorHolderName3}}</td>
                <td>{{row.transferorHolder3PanNo}}</td>
                <td>{{row.toBlaAccountNumber}}</td>
                <td>{{row.toBlaModeOfHolding}}</td>
                <td>{{row.transfereeHolderName1}}</td>
                <td>{{row.transfereeHolder1PanNo}}</td>
                <td>{{row.transfereeHolderName2}}</td>
                <td>{{row.transfereeHolder2PanNo}}</td>
                <td>{{row.transfereeHolderName3}}</td>
                <td>{{row.transfereeHolder3PanNo}}</td>
                <td>{{vm.formatDisplayDate(row.dateOfTransfer)}}</td>
                <td>{{row.remarks}}</td>
                <td>{{row.sNo}}</td>
                <td>{{row.transferorSubscriptionId}}</td>
                <td>{{row.transferredSubscriptionId}}</td>
                <td>{{vm.formatDisplayDate(row.cfdDate)}}</td>
                <td>{{vm.formatDisplayDate(row.maturityDate)}}</td>
                <td class="text-right">{{vm.formatIndianCurrency(row.subscriptionAmount)}}</td>
            </tr>
            </tbody>
        </table>
    </div>

    <div class="text-center form_submit no-print">
        <button type="button" class="btn btn-cancel"
                onclick="window.location.href= '#!/transfer_report/action/inquiry';">Back
        </button>
    </div>
</div>

<div class="container" ng-if="!vm.loader && vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Transfer Report</h4>
        <p>No records found to display.</p>
        <div class="text-center">
            <button type="button" class="btn btn-cancel"
                    onclick="window.location.href= '#!/transfer_report/action/inquiry';">Cancel
            </button>
        </div>
    </div>
</div>