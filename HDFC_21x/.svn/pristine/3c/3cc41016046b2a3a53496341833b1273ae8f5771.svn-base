package com.isl.gbm.cbs.integration.dto;

import com.fasterxml.jackson.annotation.JsonIgnoreProperties;
import com.fasterxml.jackson.annotation.JsonInclude;

import java.util.Date;

/**
 * @author Vasanthi
 *
 */
@JsonIgnoreProperties(ignoreUnknown = true)
@JsonInclude(JsonInclude.Include.NON_NULL)
public class BankDetailsIntegrationDto {

    private String bankCode;

    private Character bankCorresFlag;

    private Character bankLocalClgFlag;

    private String bankName;

    private String bankShortName;

    private Character bankWeeklyOff;

    private String imdNumber;

    private Date lchgTime;

    private String lchgUserId;

    private Character primeBankFlag;

    private Date rcreTime;

    private String rcreUserId;

    private Number tsCount;

    private Character deleteFlag;

    /**
     * @return the bankCode
     */
    public String getBankCode() {
        return bankCode;
    }

    /**
     * @return the bankCorresFlag
     */
    public Character getBankCorresFlag() {
        return bankCorresFlag;
    }

    /**
     * @return the bankLocalClgFlag
     */
    public Character getBankLocalClgFlag() {
        return bankLocalClgFlag;
    }

    /**
     * @return the bankName
     */
    public String getBankName() {
        return bankName;
    }

    /**
     * @return the bankShortName
     */
    public String getBankShortName() {
        return bankShortName;
    }

    /**
     * @return the bankWeeklyOff
     */
    public Character getBankWeeklyOff() {
        return bankWeeklyOff;
    }

    /**
     * @return the deleteFlag
     */
    public Character getDeleteFlag() {
        return deleteFlag;
    }

    /**
     * @return the imdNumber
     */
    public String getImdNumber() {
        return imdNumber;
    }

    /**
     * @return the lchgTime
     */
    public Date getLchgTime() {
        return lchgTime;
    }

    /**
     * @return the lchgUserId
     */
    public String getLchgUserId() {
        return lchgUserId;
    }

    /**
     * @return the primeBankFlag
     */
    public Character getPrimeBankFlag() {
        return primeBankFlag;
    }

    /**
     * @return the rcreTime
     */
    public Date getRcreTime() {
        return rcreTime;
    }

    /**
     * @return the rcreUserId
     */
    public String getRcreUserId() {
        return rcreUserId;
    }

    /**
     * @return the tsCount
     */
    public Number getTsCount() {
        return tsCount;
    }

    /**
     * @param bankCode
     *            the bankCode to set
     */
    public void setBankCode(String bankCode) {
        this.bankCode = bankCode;
    }

    /**
     * @param bankCorresFlag
     *            the bankCorresFlag to set
     */
    public void setBankCorresFlag(Character bankCorresFlag) {
        this.bankCorresFlag = bankCorresFlag;
    }

    /**
     * @param bankLocalClgFlag
     *            the bankLocalClgFlag to set
     */
    public void setBankLocalClgFlag(Character bankLocalClgFlag) {
        this.bankLocalClgFlag = bankLocalClgFlag;
    }

    /**
     * @param bankName
     *            the bankName to set
     */
    public void setBankName(String bankName) {
        this.bankName = bankName;
    }

    /**
     * @param bankShortName
     *            the bankShortName to set
     */
    public void setBankShortName(String bankShortName) {
        this.bankShortName = bankShortName;
    }

    /**
     * @param bankWeeklyOff
     *            the bankWeeklyOff to set
     */
    public void setBankWeeklyOff(Character bankWeeklyOff) {
        this.bankWeeklyOff = bankWeeklyOff;
    }

    /**
     * @param deleteFlag
     *            the deleteFlag to set
     */
    public void setDeleteFlag(Character deleteFlag) {
        this.deleteFlag = deleteFlag;
    }

    /**
     * @param imdNumber
     *            the imdNumber to set
     */
    public void setImdNumber(String imdNumber) {
        this.imdNumber = imdNumber;
    }

    /**
     * @param lchgTime
     *            the lchgTime to set
     */
    public void setLchgTime(Date lchgTime) {
        this.lchgTime = lchgTime;
    }

    /**
     * @param lchgUserId
     *            the lchgUserId to set
     */
    public void setLchgUserId(String lchgUserId) {
        this.lchgUserId = lchgUserId;
    }

    /**
     * @param primeBankFlag
     *            the primeBankFlag to set
     */
    public void setPrimeBankFlag(Character primeBankFlag) {
        this.primeBankFlag = primeBankFlag;
    }

    /**
     * @param rcreTime
     *            the rcreTime to set
     */
    public void setRcreTime(Date rcreTime) {
        this.rcreTime = rcreTime;
    }

    /**
     * @param rcreUserId
     *            the rcreUserId to set
     */
    public void setRcreUserId(String rcreUserId) {
        this.rcreUserId = rcreUserId;
    }

    /**
     * @param tsCount
     *            the tsCount to set
     */
    public void setTsCount(Number tsCount) {
        this.tsCount = tsCount;
    }

    @Override
    public String toString() {
        return "BankDetailsIntegrationDto [bankCode=" + bankCode + ", bankName=" + bankName + "]";
    }

}
