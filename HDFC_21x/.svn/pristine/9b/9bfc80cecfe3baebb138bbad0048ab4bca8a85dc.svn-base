<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper" ng-init="vm.getSubCodeList();">

    <h4 class="form_heading">Bond Account Transfer Out - Verify/Reject</h4>
    <sol-header></sol-header>

    <div class="tab-content">
        <div id="pensionmastersa" class="tab-pane fade in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="pensionMastersaForm" role="form" novalidate>

                        <div uib-accordion-group id="satreasury-details" class="panel"
                             heading="Bond Account Transfer Out - Verify" is-open="true"
                             ng-class="(vm.treasuryDetailsForm.$invalid) ? 'panel-danger' : 'panel-default'">

                            <div class="row">
                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">Name of the Bond Scheme
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind" >{{vm.schemeName}}</label>
                                    </div>
                                    <div class="col-sm-1"></div>
                                    <label  class="control-label col-sm-3">Transfer Out To Other Banks</label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind" >{{vm.bondTransferOutDetails.isTranOutToOtherBank | getLabelFromValuesArray : vm.commonYesNoMetaData}} </label>
                                    </div>
                                </div>
                            </div>

                            <div class="row">

                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">Mode of Holding
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind"  >{{vm.modeOfHolding}}</label>
                                    </div>
                                    <div class="col-sm-1"></div>
                                    <label for="isNri" class="control-label col-sm-3">Holder Type
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label id="isNri" class="data-bind" >{{vm.bondHolderDetails[0].holderType }} </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row">

                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">BLA Number
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind"  >{{vm.blaNo}}</label>
                                    </div>
                                    <div class="col-sm-1" ng-if="vm.bondHolderDetails[0].singleBondHolderName"></div>
                                    <label for="isNri" class="control-label col-sm-3" ng-if="vm.bondHolderDetails[0].singleBondHolderName">Bond Holder Name
                                    </label>
                                    <div class="col-sm-2" ng-if="vm.bondHolderDetails[0].singleBondHolderName">
                                        :
                                        <label id="isNri" class="data-bind" >{{vm.bondHolderDetails[0].singleBondHolderName}} </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row" ng-if="vm.bondHolderDetails[0].firstJointHolderName || vm.bondHolderDetails[0].firstJointHolderBlaNo">

                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">First Joint Bond Holder BLA No.
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind"  >{{vm.bondHolderDetails[0].firstJointBlaNo}}</label>
                                    </div>
                                    <div class="col-sm-1"></div>
                                    <label for="isNri" class="control-label col-sm-3">First joint Bond Holder Name
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label id="isNri" class="data-bind" >{{vm.bondHolderDetails[0].firstJointHolderName}} </label>
                                    </div>
                                </div>
                            </div>
                            <div class="row" ng-if="vm.bondHolderDetails[0].secondJointHolderBlaNo || vm.bondHolderDetails[0].secondJointHolderName">

                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">Second Joint Bond Holder BLA No.
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind"  >{{vm.bondHolderDetails[0].secondJointBlaNo}}</label>
                                    </div>
                                    <div class="col-sm-1"></div>
                                    <label for="isNri" class="control-label col-sm-3">Second Joint Bond Holder Name
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label id="isNri" class="data-bind" >{{vm.bondHolderDetails[0].secondJointHolderName}} </label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div uib-accordion-group id="sapensioner-details" class="panel panel-default"
                             heading="BOND SUBSCRIPTION  DETAILS">
                            <ng-form name="vm.bondSubscriptionDetails" >
                                <div class="table-responsive">

                                    <table class="table table-bordered table-striped list table-textWrap"
                                    >
                                        <thead>
                                        <tr>
                                            <th>Check Box</th>
                                            <th>Subscription Date</th>
                                            <th>Subscription Id</th>
                                            <th>Subscription Amount</th>
                                            <th>Bond Type</th>

                                            <th>Maturity Date</th>
                                            <th>Rate Of Interest %</th>
                                            <th>Interest Paid up to</th>
                                            <th>Transfer Amount</th>


                                        </tr>

                                        </thead>
                                        <tbody>
                                        <tr ng-repeat="x in vm.bondSubscriptionDetails">
                                            <!--                                    <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>-->
                                            <td>
                                                <input type="checkbox" id="x.isSelected" name="x.isSelected" ng-model="x.isSelected" ng-change="vm.getNomineeDetails();"
                                                       value="x.isSelected" ng-init="x.isSelected=true">
                                            </td>
                                            <td align="center">{{x.subscriptionDate}}</td>
                                            <td align="center">{{x.subscriptionId}}</td>
                                            <td align="center">{{vm.indianNumberFormat(x.subscriptionAmount)}}</td>
                                            <td align="center">{{x.bondType}}</td>
                                            <td align="center">{{x.maturityDate}}</td>
                                            <td align="center">{{x.rateOfInterest}}</td>
                                            <td align="center">{{x.interestPaidUpTo}}</td>
                                            <td align="center">{{vm.indianNumberFormat(x.transferAmount)}}</td>

                                        </tr>

                                        </tbody>
                                    </table>
                                </div>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="bond-nominee-details"  class="panel panel-default"
                             heading='NOMINATION DETAILS'
                             ng-if="vm.getNomineeDetailsList.length > 0"
                             >

                                <div class="table-responsive">

                                    <table class="table table-bordered table-striped list table-textWrap">
                                        <thead>
                                        <tr>
                                            <th>sl No</th>
                                            <th>Subscription ID</th>
                                            <th>Nominee Name</th>
                                            <th>Nominee Share(%)</th>
                                        </tr>

                                        </thead>
                                        <tbody>
                                        <tr ng-repeat="x in vm.getNomineeDetailsList">

                                            <!--                                    <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>-->
                                            <td>{{$index+1}}</td>
                                            <td align="center">{{x.subscriptionId}}</td>
                                            <td align="center">{{x.nomineeName}}</td>
                                            <td align="center">{{x.nomineeShare}}</td>
                                        </tr>

                                        </tbody>
                                    </table>
                                </div>

                        </div>

                        <div uib-accordion-group id="sapensioner-details-three" class="panel panel-default"
                             heading="TRANSFER OUT DETAILS">

                            <ng-form name="vm.bondTransactionDetails" >
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr ng-if="vm.bondTransferOutDetails.isTranOutToOtherBank =='Y'">

                                        <td width="25%" class="form-group">
                                            <label class="control-labelaria-controls">Transfer to Bank Name</label></td>
                                        <td width="25%">
                                            <label class="control-labelaria-controls">{{vm.bondTransferOutDetails.transferOutToBankName}}</label></td>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Transfer to Branch Name</label></td>
                                        <td width="25%">
                                            <label class="control-labelaria-controls">{{vm.bondTransferOutDetails.transferOutToBranchName}}</label></td>
                                        </td>
                                    </tr>



                                    <tr ng-if="vm.bondTransferOutDetails.isTranOutToOtherBank =='N'">

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Transfer to Branch Id</label>
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-labelaria-controls">{{vm.bondTransferOutDetails.transferInToBranchId}}</label></td>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Transfer to Branch Name</label>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label class="control-labelaria-controls">{{vm.bondTransferOutDetails.transferInToSameBranchName}}</label></td>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label></td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.bondTransferOutDetails.remarks}}</label></td>
                                        </td>

                                        <td width="25%" class="form-group required">
                                        <td width="25%">

                                        </td>
                                    </tr>

                                    </tbody>
                                </table>
                            </ng-form>

                        </div>

                    </form>
                </uib-accordion>
            </div>
        </div>


    </div>

    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
            </div>
            <div class="col-md-3">
            </div>
            <div class="col-md-3">
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.getDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>

    </div>

    <div class="text-center form_submit">
        <button type="submit" class="btn btn-default" id="submitButton"
                 ng-click="vm.verifySubmit();">Verify</button>
        <button type="submit" class="btn btn-default" id="rejectButton"
                ng-disabled="tdsparameter.$invalid" ng-click="vm.rejectReason()">Reject</button>
        <button type="button" id="otherpen_cancelButton" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbi_bnd_acc_trans_out/action/verify';">Cancel</button>
    </div>

</div>


<!--Delete Get Remarks-->

<div class="modal" id="permissionMappingDelete" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"> REJECTION REMARKS</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" >
                    <form name="permissionDelete" role="form">

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-2"></div>
                                <label class="control-label col-sm-3">Remarks</label>
                                <div class="col-sm-5">
                                    <!--
                                                                        <textarea class="form-control"   ng-keypress="vm.validateInput($event,'remarks')" id="remarks" name="remarks" ng-model="vm.remarks" maxlength="80" required></textarea>
                                    -->
                                    <select class="form-control list_wrapper" id="remarks[$index]" name="remarks[$index]"
                                            ng-model="vm.remarks" ng-init="vm.getRemarksList();"   required>
                                        <option value="">Select</option>
                                        <option ng-repeat="item in vm.remarksList"
                                                name="{{item.subCode + parentIndex}}" id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">{{item.subCodeDescription}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-offset-5 col-sm-8 form_submit">
                            <button type="button" class="btn btn-default" data-bs-dismiss="modal" ng-disabled="permissionDelete.$invalid" ng-click="vm.deleteSubmit()" >Submit</button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>
