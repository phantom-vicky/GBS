package com.isl.gbm.common.audit.log.model;

import java.io.Serializable;

/**
 * The Class ColumnDefinitionDetails.
 */
public class ColumnDefinitionDetails implements Serializable {

    /**
     * The Constant serialVersionUID.
     */
    private static final long serialVersionUID = 1L;

    /**
     * The column name.
     */
    private String columnName;

    /**
     * The column property.
     */
    private String columnProperty;

    /**
     * Gets the column name.
     *
     * @return the column name
     */
    public String getColumnName() {
        return this.columnName;
    }

    /**
     * Gets the column property.
     *
     * @return the column property
     */
    public String getColumnProperty() {
        return this.columnProperty;
    }

    /**
     * Sets the column name.
     *
     * @param columnName the new column name
     */
    public void setColumnName(final String columnName) {
        this.columnName = columnName;
    }

    /**
     * Sets the column property.
     *
     * @param columnProperty the new column property
     */
    public void setColumnProperty(final String columnProperty) {
        this.columnProperty = columnProperty;
    }

    /*
     * (non-Javadoc)
     *
     * @see java.lang.Object#toString()
     */
    @Override
    public String toString() {
        return "ColumnDefinitionDetails [columnName=" + this.columnName + ", columnProperty=" + this.columnProperty
                + "]";
    }

}
