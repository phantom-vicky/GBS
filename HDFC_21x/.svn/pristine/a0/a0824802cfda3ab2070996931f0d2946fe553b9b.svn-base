package com.isl.gbm.cbs.integration.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class RemittanceCalenderMaintenanceResponseDTO {

    private String scrollDate;
    private String scrollDay;
    private String holiday;
    private String cashRemittance;
    private String transferRemittance;
    private String clearingRemittance;
    private String internetRemittance;
    private String cardsRemittance;

    public String getScrollDate() {
        return scrollDate;
    }

    public void setScrollDate(String scrollDate) {
        this.scrollDate = scrollDate;
    }

    public String getScrollDay() {
        return scrollDay;
    }

    public void setScrollDay(String scrollDay) {
        this.scrollDay = scrollDay;
    }

    public String getHoliday() {
        return holiday;
    }

    public void setHoliday(String holiday) {
        this.holiday = holiday;
    }

    public String getCashRemittance() {
        return cashRemittance;
    }

    public void setCashRemittance(String cashRemittance) {
        this.cashRemittance = cashRemittance;
    }

    public String getTransferRemittance() {
        return transferRemittance;
    }

    public void setTransferRemittance(String transferRemittance) {
        this.transferRemittance = transferRemittance;
    }

    public String getClearingRemittance() {
        return clearingRemittance;
    }

    public void setClearingRemittance(String clearingRemittance) {
        this.clearingRemittance = clearingRemittance;
    }

    public String getInternetRemittance() {
        return internetRemittance;
    }

    public void setInternetRemittance(String internetRemittance) {
        this.internetRemittance = internetRemittance;
    }

    public String getCardsRemittance() {
        return cardsRemittance;
    }

    public void setCardsRemittance(String cardsRemittance) {
        this.cardsRemittance = cardsRemittance;
    }
}
