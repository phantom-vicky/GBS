package com.isl.gbm.rbibond.dto.reports;

public class InetPortfolioResponseDTO {

    private String requestId;
    private String panNo;
    private String reqDateTime;
    private String resDateTime;
    private String resStatus;

    public String getRequestId() {
        return requestId;
    }

    public void setRequestId(String requestId) {
        this.requestId = requestId;
    }

    public String getPanNo() {
        return panNo;
    }

    public void setPanNo(String panNo) {
        this.panNo = panNo;
    }

    public String getReqDateTime() {
        return reqDateTime;
    }

    public void setReqDateTime(String reqDateTime) {
        this.reqDateTime = reqDateTime;
    }

    public String getResDateTime() {
        return resDateTime;
    }

    public void setResDateTime(String resDateTime) {
        this.resDateTime = resDateTime;
    }

    public String getResStatus() {
        return resStatus;
    }

    public void setResStatus(String resStatus) {
        this.resStatus = resStatus;
    }

    @Override
    public String toString() {
        return "InetPortfolioResponseDTO{" +
                "requestId='" + requestId + '\'' +
                ", panNo='" + panNo + '\'' +
                ", reqDateTime='" + reqDateTime + '\'' +
                ", resDateTime='" + resDateTime + '\'' +
                ", resStatus='" + resStatus + '\'' +
                '}';
    }
}
