<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">TDS Parameters for RBI Bond - Add</h4>
    <sol-header></sol-header>
    <form name="tdsparameter" role="form" ng-submit="vm.submitAddForm();">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label  class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-2">
                    <label  class="form-control"><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label  class="control-label">Version No</label>
                </div>
                <div class="col-sm-2" ng-init="vm.versionNo = '00001'">
                    <label  class="form-control">{{vm.versionNo}}</label>
                </div>

                <div class="col-sm-3">
                    <label  class="control-label">TDS Param Code</label>
                </div>
                <div class="col-sm-2">
                    <label  class="form-control">{{vm.tdsParamCode}}</label>
                </div>

            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label  class="control-label">TDS Param Code Description</label>
                </div>
                <div class="col-sm-2">
                    <textarea class="form-control" readonly>{{vm.tdsParamCodeDesc}}</textarea>
                </div>
                <div class="col-sm-3">
                    <label  class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <label  class="form-control">{{vm.moduleName}}</label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label  class="control-label">TDS Effective from  Date(dd/mm/yyyy)</label>
                </div>
                <div class="col-sm-2">
                    <label  class="form-control">{{vm.effFromDate | date : 'dd/MM/yyyy'}}</label>
                </div>
                <div class="col-sm-3">
                    <label for="tdsAnnualInterest" class="control-label">TDS Exemption on Annual interest</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="tdsAnnualInterest" chars="only-numbers"
                           ng-model="vm.tdsAnnualInterest" limit-To="6" min="0"
                           maxlength="6" required>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label for="tdsRatePan" class="control-label">TDS Rate if PAN available / Active (%)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="tdsRatePan" ng-blur="vm.formatPercentage(vm.tdsRatePan,'PA');"
                           ng-model="vm.tdsRatePan" ng-keypress="vm.percentageCheck($event);" ng-change="vm.percentageCheckChange(vm.tdsRatePan);" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1').replace(/^(\d{1,3}(\.\d{0,2})?).*$/, '$1')"
                           chars="float" maxlength="6" required>
                </div>
                <div class="col-sm-3">
                    <label for="tdsRateNoPan" class="control-label">TDS Rate if PAN not available / Double the Normal Rate (%)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="tdsRateNoPan" ng-blur="vm.formatPercentage(vm.tdsRateNoPan,'PN');"
                           ng-keypress="vm.percentageCheck($event);" ng-change="vm.percentageCheckChange(vm.tdsRateNoPan);" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1').replace(/^(\d{1,3}(\.\d{0,2})?).*$/, '$1')"
                           ng-model="vm.tdsRateNoPan" chars="float" maxlength="6" required>
                   </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label for="educationCess" class="control-label">Education Cess (%)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="educationCess"  ng-keypress="vm.percentageCheck($event);" ng-change="vm.percentageCheckChange(vm.educationCess);" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1').replace(/^(\d{1,2}(\.\d{0,2})?).*$/, '$1')"
                           ng-model="vm.educationCess" required>
                  </div>
                <div class="col-sm-3">
                    <label for="otherCess" class="control-label">Other Cess (%)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="otherCess"  ng-keypress="vm.percentageCheck($event);" ng-change="vm.percentageCheckChange(vm.otherCess);" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1').replace(/^(\d{1,2}(\.\d{0,2})?).*$/, '$1')"
                           ng-model="vm.otherCess" required>
                    </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label for="fifteenGlimit" class="control-label">15 G Limit</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control ng-valid-maxlength ng-not-empty ng-dirty ng-valid-parse ng-valid ng-valid-required ng-touched" id="fifteenGlimit" chars="only-numbers" ng-model="vm.fifteenGlimit" maxlength="7" required>
                </div>
                <div class="col-sm-3">
                    <label for="fifteenHlimit" class="control-label">15 H Limit</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control ng-valid-maxlength ng-not-empty ng-dirty ng-valid-parse ng-valid ng-valid-required ng-touched" id="fifteenHlimit" chars="only-numbers" ng-model="vm.fifteenHlimit" maxlength="7" required>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-1"></div>
                <div class="col-sm-3">
                    <label for="remark" class="control-label">Remarks</label>
                </div>
                <div class="col-sm-6">
                   <textarea class="form-control" rows="3" id="remark" maxlength="50" name="remark" ng-model="vm.remark"></textarea>
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="tdsparameter.$invalid">Submit</button>
            <button type="button" id="subButton" class="btn btn-cancel"
                    ng-click="vm.showCancelConfirmation('tds_parameter_rbi_bond.add');">Cancel</button>
        </div>
    </form>
</div>
