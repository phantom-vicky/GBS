<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.filteredRecords.length >0">
    <div class="container from_wrapper new_form_wrapper" >

        <div class="text-right form_submit">
            <button type="submit" class="btn btn-default"
                    onclick="window.location.href ='#!/';" id="homeButton">Home
            </button>

            <button type="button" id="cancel_Button" class="btn btn-cancel"
                    onclick="window.location.href= '#!/tds_deduction_at_other_than_normal_tds_rate_report/action/inquiry';">Back
            </button>
        </div>

        <h4 class="form_heading">TDS Deduction at other than normal TDS rate report</h4>

        <sol-header></sol-header>


        <div>
            <table style ="width:100%" class="table table-bordered" style="padding: 10px">
                <tr>
                    <th scope="col" ng-if="vm.schemeName">Name of the Bond Scheme</th>
                    <td ng-if="vm.schemeName">{{vm.schemeName}}</td>
                    <th scope="" style="width:20%">Total Count</th>
                    <td style="width:20%">{{vm.total}}</td>
                </tr>
                <tr>
                    <th scope="col" ng-if="vm.HolderName">Name</th>
                    <td ng-if="vm.HolderName">{{vm.HolderName}}</td>
                </tr>
                <tr>
                    <th scope="col" ng-if="vm.panNo">PAN No</th>
                    <td ng-if="vm.panNo">{{vm.panNo}}</td>
                </tr>
                <tr>
                    <th scope="col" ng-if="vm.blaNo">BLA No</th>
                    <td ng-if="vm.blaNo">{{vm.blaNo}}</td>
                </tr>
                <tr>
                    <th scope="col" ng-if="vm.financialYear">FinancialYear</th>
                    <td ng-if="vm.financialYear">{{vm.financialYear}}</td>
                </tr>

            </table>
        </div>

        <form name="vm.bondNominationsForm" role="form">


            <div class="row" style="display: flex; align-items: center; justify-content: space-between;">
                <!-- Show Dropdown -->
                <div class="col-sm-3" style="flex: 1">
                    <div class="form-group">
                        <table style="border-spacing: 2">
                            <caption style="display: none">
                                TDS Deduction at other than normal TDS rate report
                            </caption>
                            <tr>
                                <th scope="col"></th>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- Search and Export Controls -->
                <div class="row">
                    <div class="col-sm-3"  style="display: flex; align-items: center; justify-content: flex-end;">
                        <div class="form-group" style="margin-right: 15px;">
                            <div class="input-group">
                                <input type="text" class="form-control searchButton"
                                       ng-model="vm.searchValue" ng-init="vm.searchValue = ''"
                                       placeholder="Search">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search" ng-click="vm.getDetailspage()"></i>
                                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.searchValue = '';vm.pageNo='1';vm.getDetailspage()" ></i>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-2">
                        <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                                ng-model="vm.pageSize" ng-init="vm.pageSize='10'" ng-change="vm.pageNo='1'; vm.getDetailspage();" ng-disabled="vm.noDataFoundInSearch">
                            <option value="10" >10 per page</option>
                            <option value="20">20 per page</option>
                            <option value="50">50 per page</option>
                        </select>
                    </div>

                    <div class=" form-group col-lg-3">
                        <select class="form-control"
                                id="downloadOptions"
                                name="export"
                                ng-disabled="vm.noDataFoundInSearch"
                                ng-model="vm.downloadType"
                                ng-init="vm.downloadType=''"
                                ng-change="vm.getDownload()" ng-disabled="vm.noDataFoundInSearch">
                            <option value="">EXPORT</option>
                            <option value="excel">EXCEL</option>
                            <option value="csv">CSV</option>
                            <!--                                <option value="pdf">PDF</option>-->
                        </select>
                    </div>
                    <!--                    Pagination End-->
                </div>
            </div>


            <div class="table-responsive">
                <table class="table table-bordered table-striped list nowrap table-textWrap datatable">
                    <thead ng-if="!vm.noDataFoundInSearch">
                    <tr>
                        <th scope="col">S.No</th>
                        <th scope="col">PAN No</th>
                        <th scope="col">BLA No</th>
                        <th scope="col">Customer Name</th>
                        <th scope="col">Bond Subscription Id</th>
                        <th scope="col">Financial year</th>
                        <th scope="col">Type of Certificate</th>
                        <th scope="col">Tax Excemption Limit</th>
                        <th scope="col">Low/No Tax Percentage</th>
                        <th scope="col">PAN Status</th>
                        <th scope="col">Interest Payment Date</th>
                        <th scope="col">Total Interest Rs</th>
                        <th scope="col">TDS Amount Rs</th>
                        <th scope="col">TDS Deducted Percentage</th>
                        <th scope="col">TDS Deducted Amount(Rs)</th>
                        <th scope="col">Ner Interest Amount Paid</th>

                    </tr>
                    </thead>
                    <tbody ng-if="!vm.noDataFoundInSearch">
<!--                    <tr ng-repeat="x in vm.filteredRecords.slice((vm.currentPage-1)*vm.pageSize, vm.currentPage*vm.pageSize)">-->
                        <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                            <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                        <td>{{x.panNo}}</td>
                        <td>{{x.blaNo}}</td>
                        <td>{{x.holderName}}</td>
                        <td>{{x.subsId}}</td>
                        <td>{{x.financialYear}}</td>
                        <td>{{x.typeofCertificate}}</td>
                        <td>{{x.taxExcemlimit}}</td>
                        <td>{{x.lownotaxper}}</td>
                        <td>{{x.panStatus}}</td>
                        <td>{{x.interestPaymentDate}}</td>
                        <td>{{vm.indianNumberFormat(x.totalInterest |number:2)}}</td>
                        <td>{{vm.indianNumberFormat(x.tdsAmt |number :2)}}</td>
                        <td>{{x.tdsDeductionper}}</td>
                        <td>{{vm.indianNumberFormat(x.tdsDeductionAmt |number:2)}}</td>
                        <td>{{vm.indianNumberFormat(x.netInterestAmt |number:2)}}</td>
                    </tr>
                    </tbody>
                    <tfoot ng-if="!vm.noDataFoundInSearch">



                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th></th>
                    <th scope="col">{{ vm.indianNumberFormat(vm.totalIntrest | number :2)}}</th>
                    <th scope="col">{{ vm.indianNumberFormat(vm.tdsAmt | number :2)}}</th>
                    <th></th>
                    <th scope="col">{{ vm.indianNumberFormat(vm.tdsDeductionAmt | number :2)}}</th>
                    <th scope="col">{{ vm.indianNumberFormat(vm.netInterestAmt | number :2)}}</th>
                    </tfoot>
                    <tbody ng-if="vm.noDataFoundInSearch">
                        <tr>
                            <td>No Records Found</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="row">
                <div class="text-center form_submit">
                        <span ng-show="vm.showPrevious">
                        <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev
                        </button>
                        </span>

                    <span>
                          <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}
                          </button>
                        </span>

                    <span ng-show="vm.showNext">
                        <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();" >Next
                        </button>
                        </span>
                </div>
            </div>
        </form>
    </div>
</div>

