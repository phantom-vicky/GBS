<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">TDS Parameters for RBI Bond - Inquiry</h4>
    <sol-header></sol-header>
    <form name="tdsparameter" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-12">
                    <label class="control-label">Version No: </label>
                    <label><b>{{vm.versionNo}}</b></label>
                </div>
            </div>
        </div>

        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.verificationDetails == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.verificationDetails == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Name of the Module</td>
                <td class="old-value"><b>RBI Bond</b></td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value"><b>RBI Bond</b>
                </td>
            </tr>
            <tr>
                <td>Name of the bond scheme</td>
                <td class="old-value">{{vm.moduleName}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">{{vm.moduleName}}
                </td>
            </tr>
            <tr>
                <td>TDS Effective from Date(dd/mm/yyyy)</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C005)?
                    (vm.tdsParameterList.C005.oldValue | date : 'dd/MM/yyyy') : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">{{(vm.tdsParameterList &&
                    vm.tdsParameterList.C005)? (vm.tdsParameterList.C005.newValue | date : 'dd/MM/yyyy') : ('')}}
                </td>
            </tr>
            <tr>
                <td>TDS Exemption on Annual interest </td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C007)?
                    (vm.tdsParameterList.C007.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C007)?
                    (vm.tdsParameterList.C007.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>TDS Rate if PAN available / Active (%)</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C008)?
                    (vm.tdsParameterList.C008.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C008)?
                    (vm.tdsParameterList.C008.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>TDS Rate if PAN not available /  Double the Normal Rate  (%)</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C009)?
                    (vm.tdsParameterList.C009.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C009)?
                    (vm.tdsParameterList.C009.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Education Cess (%)</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C010)?
                    (vm.tdsParameterList.C010.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C010)?
                    (vm.tdsParameterList.C010.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Other Cess (%)</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C011)?
                    (vm.tdsParameterList.C011.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C011)?
                    (vm.tdsParameterList.C011.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>15 G Limit</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C013)?
                    (vm.tdsParameterList.C013.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C013)?
                    (vm.tdsParameterList.C013.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>15 H Limit</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C014)?
                    (vm.tdsParameterList.C014.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C014)?
                    (vm.tdsParameterList.C014.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Remarks</td>
                <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C012)?
                    (vm.tdsParameterList.C012.oldValue) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.tdsParameterList && vm.tdsParameterList.C012)?
                    (vm.tdsParameterList.C012.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Rejection Remarks</td>
                <td class="old-value">{{(vm.verifyDetailsList && vm.verifyDetailsList.rejectionRemarks)?
                    (vm.verifyDetailsList.rejectionRemarks) : ('')}}</td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.verifyDetailsList && vm.verifyDetailsList.rejectionRemarks)?
                    (vm.verifyDetailsList.rejectionRemarks) : ('')}}
                </td>
            </tr>
            </tbody>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.verifyDetailsList.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.verifyDetailsList.modifiedBy) ? (vm.verifyDetailsList.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.verifyDetailsList.verifiedBy) ? (vm.verifyDetailsList.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.verifyDetailsList.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.verifyDetailsList.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.verifyDetailsList.modifiedDate) ? (vm.verifyDetailsList.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.verifyDetailsList.verifiedDate) ? (vm.verifyDetailsList.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
           <!-- <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="tdsparameter.$invalid" ng-click="vm.submitAddForm()">Verify</button>-->
            <button type="button" id="subButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/tds_parameter_rbi_bond/action/inquiry';">Cancel</button>
        </div>

    </form>
</div>
