package com.isl.gbm.common.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class AccountValidationDto {
    private String accountName;

    private String isCentralized;
    private String isCentralizedInet;

    private String accNo;
    private String accNoInet;

    private String branchId;

    private String cbsAccNo;

    private String cbsAccType;

    private String validityFlag;

    private String reasonForInvalid;

    private String cbsBal;

    private String transfermicrOut;


    public String getTransfermicrOut() {
        return transfermicrOut;
    }

    public void setTransfermicrOut(String transfermicrOut) {
        this.transfermicrOut = transfermicrOut;
    }

    public String getIsCentralizedInet() {
        return isCentralizedInet;
    }

    public void setIsCentralizedInet(String isCentralizedInet) {
        this.isCentralizedInet = isCentralizedInet;
    }

    public String getAccNoInet() {
        return accNoInet;
    }

    public void setAccNoInet(String accNoInet) {
        this.accNoInet = accNoInet;
    }

    public String getCbsBal() {
        return cbsBal;
    }

    public void setCbsBal(String cbsBal) {
        this.cbsBal = cbsBal;
    }

    public String getAccountName() {
        return accountName;
    }

    public void setAccountName(String accountName) {
        this.accountName = accountName;
    }

    public String getAccNo() {
        return accNo;
    }

    public void setAccNo(String accNo) {
        this.accNo = accNo;
    }

    public String getBranchId() {
        return branchId;
    }

    public void setBranchId(String branchId) {
        this.branchId = branchId;
    }

    public String getIsCentralized() {
        return isCentralized;
    }

    public void setIsCentralized(String isCentralized) {
        this.isCentralized = isCentralized;
    }

    public String getCbsAccNo() {
        return cbsAccNo;
    }

    public void setCbsAccNo(String cbsAccNo) {
        this.cbsAccNo = cbsAccNo;
    }

    public String getCbsAccType() {
        return cbsAccType;
    }

    public void setCbsAccType(String cbsAccType) {
        this.cbsAccType = cbsAccType;
    }

    public String getValidityFlag() {
        return validityFlag;
    }

    public void setValidityFlag(String validityFlag) {
        this.validityFlag = validityFlag;
    }

    public String getReasonForInvalid() {
        return reasonForInvalid;
    }

    public void setReasonForInvalid(String reasonForInvalid) {
        this.reasonForInvalid = reasonForInvalid;
    }
}
