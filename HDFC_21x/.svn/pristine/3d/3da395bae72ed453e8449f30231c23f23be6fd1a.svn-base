<!-- Output Screen-->


<div class="loader-new" ng-if="vm.loader"></div>

<div class="container" data-ng-if="vm.model">


    <div class="container from_wrapper new_form_wrapper">

        <div class="text-right form_submit">
            <button type="submit" class="btn btn-default"
                    onclick="window.location.href ='#!';" id="homeButton">Home
            </button>

            <button type="button" id="cancel_Button" class="btn btn-cancel"
                    onclick="window.location.href= '#!/Bond_Balance_Report/action/inquiry';">Back
            </button>
        </div>


        <table style="width:100%" class="table table-bordered" aria-label="">

            <tr>
                <h4 class="form_heading">Bond Balance Report
                </h4>
                <sol-header></sol-header>

                <table style="width:100%" class="table table-bordered" style="padding: 10px" aria-label="">
                    <tr>
                        <th scope="col">Name of the Bond Scheme</th>
                        <td>{{vm.schemeName}}</td>
                        <th scope="" style="width:20%">Total Count</th>
                        <td style="width:20%">{{vm.total}}</td>
                    </tr>
                    <tr>
                        <th scope="col" style="width: 25%">From Date</th>
                        <td style="width: 35%">{{vm.fromDate | date:'dd/MM/yyyy'}}</td>
                        <th scope="col" style="width: 20%">To Date</th>
                        <td style="width: 20%">{{vm.toDate | date:'dd/MM/yyyy'}}</td>
                    </tr>
                    <tr>
                        <th scope="col" style="width: 25%" ng-if="vm.HolderName">Name</th>
                        <td style="width: 35%" ng-if="vm.HolderName">{{vm.HolderName}}</td>
                        <th scope="col" style="width: 20%" ng-if="vm.panNo">Pan No.</th>
                        <td style="width: 20%" ng-if="vm.panNo">{{vm.panNo}}</td>

                    </tr>
                    <tr>
                        <th scope="col" style="width: 20%" ng-if="vm.blaNum">BLA No</th>
                        <td style="width: 20%" ng-if="vm.blaNum">{{vm.blaNum}}</td>
                        <th scope="col" style="width: 20%" ng-if="vm.subscriptionId">SubscriptionId</th>
                        <td style="width: 20%" ng-if="vm.subscriptionId">{{vm.subscriptionId}}</td>
                    </tr>
                </table>


            </tr>
        </table>

        <div class="row">
            <div class="col-sm-12">

                <br>

                <div class="row">
                    <div class="col-sm-12">
                        <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                            <div class="col-sm-3" style="flex: 1">
                                <div class="form-group">
                                    <table style="border-spacing: 2" aria-label="BPRR">
                                        <tr>
                                            <th scope="col"></th>
                                        </tr>
                                        <tr>
                                            <td>Show&nbsp;</td>
                                            <td>
                                                <select
                                                        class="form-control pageDropDown"
                                                        id="pageSize"
                                                        name="pageSize"
                                                        ng-model="vm.pageSize"
                                                        ng-init="vm.pageSize='5'"
                                                        ng-change="vm.pageNo='1'; vm.getbondBalanceReport();"
                                                        data-ng-disabled="vm.noDataFoundInSearch"
                                                >
                                                    <option value="5">5 per page</option>
                                                    <option value="10">10 per page</option>
                                                    <option value="20">20 per page</option>
                                                    <option value="50">50 per page</option>
                                                </select>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                                <div class="form-group" style="margin-right: 15px">
                                    <div class="input-group">
                                        <input type="text" id="search" class="form-control" data-ng-model="vm.searchValue" placeholder="Search" />
                                        <div class="input-group-addon">
                                            <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getbondBalanceReport()"></span>
                                        </div>
                                        <div class="input-group-addon">
                                            <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchValue='';vm.pageNo = 1; vm.getbondBalanceReport(); "></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <select
                                            class="form-control"
                                            id="export"
                                            name="export"
                                            data-ng-model="vm.downloadType"
                                            data-ng-init="vm.downloadType=''"
                                            data-ng-change="vm.downloadReport()"
                                            data-ng-disabled="vm.noDataFoundInSearch"
                                    >
                                        <option value="">EXPORT</option>
                                        <option value="excel">EXCEL</option>
                                        <option value="csv">CSV</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive" style="overflow: hidden;">



                            <table class="table table-bordered table-striped list table-textWrap datatable" aria-label=""
                            >
                                <thead data-ng-if="!vm.noDataFoundInSearch">
                                <tr class="thalign">
                                    <th id="sno">S.No</th>
                                    <th id="bla-no">BLA No.</th>
                                    <th id="subscription-id">Subscription ID</th>
                                    <th id="bond-type">Bond Type</th>
                                    <th id="subscription-date">Subscription Date</th>
                                    <th id="maturity-date">Subscription Maturity Date</th>
                                    <th id="current-balance">Current Balance (Rs)</th>
                                    <th id="subscription-status">Subscription Status</th>
                                </tr>
                                </thead>
                                <tbody data-ng-if="!vm.noDataFoundInSearch">
                                <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                                    <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.subscriptionId}}</td>
                                    <td>{{x.bondType}}</td>
                                    <td>{{x.subscriptionDate | date : 'dd/MM/yyyy'}}</td>
                                    <td>{{x.subscriptionMaturityDate | date : 'dd/MM/yyyy'}}</td>
                                    <td style="text-align:right">{{vm.indianNumberFormat(x.currentBalance | number:2)}}</td>
                                    <td>{{x.subStatus}}</td>
                                </tr>
                                <tr>
                                    <th scope="col" class="text-bold" colspan="5"></th>
                                    <th id="grand-total" class="text-right">Grand Total RS.</th>
                                    <th id="modee" class="text-right">{{vm.indianNumberFormat(vm.totalAmount | number:2)}}</th>
                                    <th></th>
                                </tr>

                                </tbody>
                             <tbody data-ng-if="vm.noDataFoundInSearch">
                                <tr>
                                    <td style="text-align:center">No Records Found</td>
                                </tr>
                                </tbody>

                            </table>
                        </div>
                        <br/>
                        <div class="text-center form_submit">
              <span ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev</button>
              </span>

               <span>
                <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

              <span ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();">Next</button>
              </span>
                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Bond Balance Report</h4>
        No records found to display.
        <div style="text-align:center;">
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/Bond_Balance_Report/action/inquiry';">Back
            </button>
        </div>
    </div>
</div>