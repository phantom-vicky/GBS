        <!--                </div>-->
        <!--                <div class="col-sm-2">-->
        <!--                    <input type="text" class="form-control" id="spread" ng-keypress="vm.percentageCheckNew($event);" ng-change="vm.firstCharDot(vm.cbdtSchemeParameter.C024);"-->
        <!--                           ng-change="vm.percentageCheckChangeM(vm.cbdtSchemeParameter.C024.oldValue,'C024');" limit-to="5" oninput="this.value = this.value.replace(/[^0-9.]/g, '')" ng-model="vm.cbdtSchemeParameter.C024.oldValue" required>-->
        <!--                </div>-->
        <!--            </div>-->
        <!--        </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Premature Encashment Penalty Percentage.</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="spread" ng-keypress="vm.percentageCheckNew($event);"
                        ng-change="vm.firstCharDot(vm.cbdtSchemeParameter.C024); vm.percentageCheckChangeM(vm.cbdtSchemeParameter.C024.oldValue, 'C024');"
                        limit-to="5" oninput="
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/^(\.)/g, '')
            " ng-model="vm.cbdtSchemeParameter.C024.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Maximum No of Nominee allowed in the scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" inputmode="numeric" class="form-control" id="MaxNominee" maxlength="1"
                        ng-blur="vm.nomineeValidation();" oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                        ng-model="vm.cbdtSchemeParameter.C025.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Nominee Sharable Amount in Multiples of (Rs.)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="nomineeSharableAmountMultiples"
                        maxlength="6" oninput="this.value = this.value.replace(/[^\d]/g, '').slice(0, 6)"
                        name="nomineeSharableAmountMultiples" ng-model="vm.cbdtSchemeParameter.C050.oldValue"
                        ng-blur="vm.validateNomineeAmountMin(vm.cbdtSchemeParameter.C050.oldValue, 'M', 'C050')" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Nominee Minimum Amount (Rs.)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="nomineeMinimumAmount"
                        maxlength="20" oninput="this.value = this.value.replace(/[^\d]/g, '').slice(0, 20)"
                        name="nomineeMinimumAmount" ng-model="vm.cbdtSchemeParameter.C051.oldValue"
                        ng-blur="vm.validateNomineeAmountMin(vm.cbdtSchemeParameter.C051.oldValue, 'M', 'C051')" />
                </div>
            </div>
        </div>
