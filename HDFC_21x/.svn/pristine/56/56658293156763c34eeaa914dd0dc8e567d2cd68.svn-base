                        <td width="25%">
                            <p class="input-group">
                                <input type="text"  class="form-control" id="items.oldNewValueList.C009.oldValue{{$index}}"
                                       name="items.oldNewValueList.C009.oldValue{{$index}}" ng-model="items.C009.oldValue"
                                       uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.modifySelectDetails[$index].C009=items.C009.oldValue;"
                                       datepicker-options="vm.dateOptions"
                                       is-open="items.kkkkkk[$index].opened" close-text="Close" maxlength="10"  readonly  >
                                <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="items.kkkkkk[$index].opened = true"
                                                            id="kkkkkkSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                        </span>
                            </p>
