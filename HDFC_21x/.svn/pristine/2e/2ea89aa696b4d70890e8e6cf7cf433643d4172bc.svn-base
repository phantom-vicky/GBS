<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.showDetails">
    <div class="text-right form_submit">
        <button type="button" class="btn btn-default" data-ng-click="vm.downloadAllAsZip();">Download All</button>
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!';" id="homeButton">Home</button>
        <button type="button" id="backButton" class="btn btn-cancel"
                onclick="window.location.href='#!/brokerage_claim_handling_commission/action/inquiry';">Back</button>
    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="col-sm-12">
            <h4 class="form_heading">Brokerage Claim &amp; Handling Commission</h4>
            <sol-header></sol-header>

            <hr style="margin: 30px 0;"/>

            <div class="row">
                <div class="col-sm-12">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list">
                            <thead>
                            <tr class="thalign">
                                <th style="width: 10%;">S No</th>
                                <th style="width: 60%;">Header</th>
                                <th style="width: 30%;"></th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>1</td>
                                <td>Part 1 – Tax Invoice (Handling Commission)</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-default" ng-click="vm.downloadFile('TAX_INVOICE');">Download</button>
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>RBI Letter 1</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-default" ng-click="vm.downloadFile('RBI_LETTER_1');">Download</button>
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>RBI Letter 2</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-default" ng-click="vm.downloadFile('RBI_LETTER_2');">Download</button>
                                </td>
                            </tr>
                            <tr>
                                <td>4</td>
                                <td>Statement 1 – Bill Letter</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-default" ng-click="vm.downloadFile('STATEMENT_1_PDF');">Download</button>
                                </td>
                            </tr>
                            <tr>
                                <td>5</td>
                                <td>Brokerage Text File</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-default" ng-click="vm.downloadFile('TEXT_FILE');">Download</button>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-center form_submit">
                <button type="button" class="btn btn-cancel"
                        onclick="window.location.href='#!/brokerage_claim_handling_commission/action/inquiry';">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Brokerage Claim &amp; Handling Commission</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-cancel"
                    onclick="window.location.href='#!/brokerage_claim_handling_commission/action/inquiry';">Back</button>
        </center>
    </div>
</div>
