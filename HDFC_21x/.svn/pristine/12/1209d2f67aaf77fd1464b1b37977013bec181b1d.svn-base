package com.isl.gbm.cbs.integration.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class CalenderEntriesResponseDto {

    private String scrollDate;
    private String scrollDay;
    private String holiday;
    private String remarks;

    public String getScrollDate() {
        return scrollDate;
    }

    public void setScrollDate(String scrollDate) {
        this.scrollDate = scrollDate;
    }

    public String getScrollDay() {
        return scrollDay;
    }

    public void setScrollDay(String scrollDay) {
        this.scrollDay = scrollDay;
    }

    public String getHoliday() {
        return holiday;
    }

    public void setHoliday(String holiday) {
        this.holiday = holiday;
    }

    public String getRemarks() {
        return remarks;
    }

    public void setRemarks(String remarks) {
        this.remarks = remarks;
    }
}
