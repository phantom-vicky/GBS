                        <div class="text-center form_submit" ng-disabled="index == nominee.length()">


                            <!-- <button type="button" class="btn btn-default"
                                    id="prevButton"
                                    ng-click="vm.tabReferenceInquiry = 'nomineeForm' + ($index - 1)"
                                    ng-hide="$index === 0">
                                Previous
                            </button>
                            <button type="button" class="btn btn-default" id="nextButton"
                                    ng-click="vm.tabReferenceInquiry = 'nomineeForm' + ($index + 1)"


                                    ng-hide="$index === (vm.nominationDetails1.length - 1)">
                                Next
                            </button> -->

