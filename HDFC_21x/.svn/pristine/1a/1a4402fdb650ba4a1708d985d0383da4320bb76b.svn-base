                            <tr>
                                <td width="25%">PAN No.</td>
                                <td width="25%" class="form-group required" >
                                    <input type="text" class="form-control" id="panNumber"
                                           name="panNumber" maxlength="10" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                           ng-model="vm.customerMasterDetails.C036.oldValue" ng-pattern="vm.panPattern" required>
                                </td>
                                <td width="25%">Aadhaar No</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="aadharNum" chars="only-numbers" minlength="12" maxlength="12"
                                                       onkeypress="return isNumber(event)" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       name="aadharNum" ng-model="vm.customerMasterDetails.C037.oldValue"></td>
                            </tr>


                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Whether Form 15G/15H/Tax Exemption Certificate is Submitted?</label></td>
                                <td width="25%">
                                    <select class="form-control" id="sastate"
                                            name="state" ng-model="vm.customerMasterDetails.C038.oldValue" ng-change="vm.formFifteenGValidationM(vm.customerMasterDetails.C038.oldValue);"
                                            required>
                                        <option value="" hidden="true">Select</option>
                                        <option ng-repeat="item in vm.formList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                    </select>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C038.oldValue == 'TF001' || vm.customerMasterDetails.C038.oldValue == 'TF002' || vm.customerMasterDetails.C038.oldValue == 'TF003'} ">
                                    <label class="control-label">Date of Submission of Form 15G/15H/Tax Exemption Certificate</label>
                                </td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dretirDate1"
                                               name="retirDate" ng-model="vm.customerMasterDetails.C039.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.customerMasterDetails.C039.oldValue=''"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.dateOfSubTaxEx.opened" close-text="Close"
                                               maxlength="10"
                                               ng-required="vm.customerMasterDetails.C038.oldValue == 'TF001' || vm.customerMasterDetails.C038.oldValue == 'TF002' || vm.customerMasterDetails.C038.oldValue == 'TF003'" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.dateOfSubTaxEx.opened = true"
                                                            id="dateOfReceiptTerminalSearcher1">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>

                            </tr>

