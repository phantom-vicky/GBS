<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">RBI BOND - Minor to Major Intimation Notice</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default" onclick="window.location.href= '#!/rbiBond_minor_major_intimation_notice.inquiry/action/inquiry';">Back</button>
        </center>
