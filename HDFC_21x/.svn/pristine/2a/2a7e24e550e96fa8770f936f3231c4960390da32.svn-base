package com.isl.gbm.rbibond.dto.reports;


import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;

@Entity
@Table(name="GBM_RBI_BOND_INT_PAY_DTLS")
public class BondInterestPayMisReport {


    @Id
    @Column(name = "BRANCH_ID")
    private String BRANCHID;

    @Column(name = "INTEREST_AMT")
    private String INTERESTAMT;

    @Column(name = "CURRENT_TDS_AMOUNT")
    private String CURRTDSAMT;

    @Column(name = "ARREAR_TDS_AMOUNT")
    private String ARRTDSAMT;

    @Column(name = "NET_INTEREST_AMOUNT")
    private String NETTDSAMT;

    @Column(name = "IS_PAYMENT_DONE")
    private String ISPAYDONE;

    @Column(name = "CREATED_DATE")
    private String CREATEDDATE;


    public String getISPAYDONE() {
        return ISPAYDONE;
    }

    public void setISPAYDONE(String ISPAYDONE) {
        this.ISPAYDONE = ISPAYDONE;
    }

    public String getCREATEDDATE() {
        return CREATEDDATE;
    }

    public void setCREATEDDATE(String CREATEDDATE) {
        this.CREATEDDATE = CREATEDDATE;
    }

    public String getBRANCHID() {
        return BRANCHID;
    }

    public void setBRANCHID(String BRANCHID) {
        this.BRANCHID = BRANCHID;
    }

    public String getINTERESTAMT() {
        return INTERESTAMT;
    }

    public void setINTERESTAMT(String INTERESTAMT) {
        this.INTERESTAMT = INTERESTAMT;
    }

    public String getCURRTDSAMT() {
        return CURRTDSAMT;
    }

    public void setCURRTDSAMT(String CURRTDSAMT) {
        this.CURRTDSAMT = CURRTDSAMT;
    }

    public String getARRTDSAMT() {
        return ARRTDSAMT;
    }

    public void setARRTDSAMT(String ARRTDSAMT) {
        this.ARRTDSAMT = ARRTDSAMT;
    }

    public String getNETTDSAMT() {
        return NETTDSAMT;
    }

    public void setNETTDSAMT(String NETTDSAMT) {
        this.NETTDSAMT = NETTDSAMT;
    }
}
