<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.trialRunDetailsList.length>0">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/dc';" id="homeButton">Home</button>
        <button type="submit" id="backButton" class="btn btn-cancel"
                ng-click="vm.goPreviousState();">Back</button>
    </div>
    <div  class="container from_wrapper new_form_wrapper" id="tab">
        <div class="col-sm-12">
            <h4 class="form_heading">Bond Centralized Interest Trial Run - Eligible Accounts Report</h4>
            <table class="table report-title-table">
                <tr>
                    <td>
                        <h5 class="modal-title">Bank Name</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Branch Name : {{vm.loginSolDesc}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Branch Id : {{vm.loginSolId}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Bond Interest Trial Run Payment Details for the half year ended  {{vm.data.interestHalfYear}} {{vm.data.year}}</h5>
                    </td>
                </tr>
            </table>

            <div class="row">
                <div class="col-sm-12">
                    <div>
                        <table>
                            <tr>
                                <td>
                     <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                            ng-model="vm.pageSize" ng-init="vm.pageSize='5'" ng-change=" vm.pageNo='1'; vm.getTrialRunEligibleAccountsDetails();">
                            <option value="5" >5 per page</option>
                            <option value="10">10 per page</option>
                            <option value="50">50 per page</option>

                        </select>
                                </td>
                                <td>
                                    <select class="form-control" id="export" name="export"
                                            ng-model="vm.downloadType" ng-init="vm.downloadType=''" ng-change="vm.getTrialRunEligibleAccountsFile()">
                                        <option value="">EXPORT</option>
                                        <option value="excel">EXCEL</option>
                                        <option value="pdf">PDF</option>

                                    </select>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="input-group">
                        <input type="text" class="form-control searchButton"
                               ng-model="vm.searchValue" ng-init="vm.searchValue = ''" ng-blur="vm.getTrialRunEligibleAccountsDetails()"
                               placeholder="Search">
<!--                        <div class="input-group-addon">-->
<!--                            <i class="glyphicon glyphicon-search" ng-click="vm.getTrialRunEligibleAccountsDetails()"></i>-->
<!--                        </div>-->

                    </div>
                    <br>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list table-textWrap"

                           >
                        <thead style="font-weight: bold">
                        <tr class="thalign">

                            <td>S.No</td>

                            <td ng-click="sort('t1.branchId')">Branch Id
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.branchId'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>


                            <td ng-click="sort('t1.bondLedgerAccountNumber')">Bond Ledger Account Number
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.bondLedgerAccountNumber'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t2.firstJointHolderName')">Customer Name
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t2.firstJointHolderName'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.bondSubscriptionId')">Bond Subscription ID
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.bondSubscriptionId'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.subscriptionAmount')">Subscription Amount
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.subscriptionAmount'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.accountOpenDate')">Subscription Date
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.accountOpenDate'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.interestPeriodFrom')">Interest From Period
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.interestPeriodFrom'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.interestPeriodTo')">Interest To Period
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.interestPeriodTo'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t2.modeOfInterestPayment')">Interest payment mode
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t2.modeOfInterestPayment'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t2.creditAccountNumber')">Credit Account Number
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t2.creditAccountNumber'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.interestAmount')">Total Interest Rs
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.interestAmount'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.currentTdsAmount')">TDS Amount Rs
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.currentTdsAmount'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.arrearTdsAmount')">Arrear TDS Amount Rs
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.arrearTdsAmount'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                            <td ng-click="sort('t1.netInterestAmount')">Net Interest Amount Rs
                                <span class="glyphicon sort-icon" ng-show="sortKey=='t1.netInterestAmount'" ng-class="{'glyphicon-chevron-up':sortReverse,'glyphicon-chevron-down':!sortReverse}"></span>
                            </td>

                        </tr>
                        </thead>
                        <tbody>
                            <tr dir-paginate="x in vm.trialRunDetailsList | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                                <td>{{$index+1}}</td>
                                <td align="left">{{x.branchId}}</td>
                                <td align="left">{{x.bondLedgerAccountNumber}}</td>
                                <td align="left">{{x.firstJointHolderName}}</td>
                                <td align="left">{{x.bondSubscriptionId}}</td>
                                <td align="right">{{x.subscriptionAmount}}</td>
                                <td align="center">{{x.accountOpenDate | date : 'dd/MM/yyyy'}}</td>
                                <td align="center">{{x.interestPeriodFrom | date : 'dd/MM/yyyy'}}</td>
                                <td align="center">{{x.interestPeriodTo | date : 'dd/MM/yyyy'}}</td>
                                <td align="left">{{x.modeOfInterestPayment}}</td>
                                <td align="left">{{x.creditAccountNumber}}</td>
                                <td align="right">{{x.interestAmount}}</td>
                                <td align="right">{{x.currentTdsAmount}}</td>
                                <td align="right">{{x.arrearTdsAmount}}</td>
                                <td align="right">{{x.netInterestAmount}}</td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="text-right" colspan="11">Total</th>
                                <th class="text-right">{{vm.totalInterestRupees}}</th>
                                <th class="text-right">{{vm.totalTdsAmount}}</th>
                                <th class="text-right">{{vm.totalArrearTdsAmount}}</th>
                                <th class="text-right">{{vm.totalNetInterestAmount}}</th>
                            </tr>
                        </tfoot>
                    </table>
                    </div>
                    <div>
                    </div>
                </div>

            <br>
                <div class="text-center form_submit">
                        <span ng-show="vm.showPrevious">
                        <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev
                        </button>
                        </span>

                        <span>
                          <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.getTrialRunEligibleAccountsDetails();">{{vm.pageNo}} of {{vm.maxPages}}
                          </button>
                        </span>

                    <span ng-show="vm.showNext">
                        <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();" >Next
                        </button>
                        </span>
                </div>

                </div>

            </div>



</div>
</div>
<div class="container" ng-if="vm.trialRunDetailsList.length == 0 || vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Bond Interest Trial Run – Eligible Accounts Report</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    ng-click="vm.goPreviousState();">Back</button>
        </center>
    </div>
</div>
