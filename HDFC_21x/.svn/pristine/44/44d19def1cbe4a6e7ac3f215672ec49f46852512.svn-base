<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">Bond Actual Interest Run Credited Report</h4>
  <sol-header></sol-header>


  <form name="accountOpeningForm" role="form">


    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-5">
          <label><b>RBI Bond</b></label>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label for="moduleName" class="control-label">BOD Date</label>
        </div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="bodDate" name="dropDownFieldName" ng-model="vm.solDate" readonly required />
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label for="moduleName" class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="moduleName" name="moduleName" data-ng-model="vm.moduleName" readonly required />
        </div>
      </div>
    </div>

    <!--Scheme name-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
        </div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="schemeCode" data-ng-model="vm.schemeName" required readonly />
        </div>
        <div class="col-sm-2">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearcher" ng-click="vm.getModuleName();"></i>
          <i
            class="glyphicon glyphicon-remove clear cp"
            ng-click="vm.schemeCode ='';vm.schemeName =''; vm.schemeStatus=''; vm.fromdate='';
                        vm.todate=''; vm.panNo=''; vm.blaNo=''; vm.subscriptionId='';"
          ></i>
        </div>
      </div>
    </div>

    <!--FROM DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">Interest Payment From Date</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="efffromDate1"
              name="efffromDate"
              ng-model="vm.fromdate"
              uib-datepicker-popup="dd/MM/yyyy"
              ng-init="vm.fromdate=''; vm.fromDateVal()"
              ng-change="vm.toDateVal(vm.fromdate); vm.todate=''"
              datepicker-options="vm.fromDateOptions"
              is-open="vm.efffromDatePicker.opened"
              close-text="Close"
              maxlength="10"
              ng-blur="vm.textableDatePicker('efffromDate1',vm.fromdate)"
              ng-keyup="vm.autoslashing('efffromDate1')"
              chars="numbers-slash"
              required
            />
            <span class="input-group-btn" data-ng-if="vm.schemeName">
              <button type="button" class="btn btn-secondary" ng-click="vm.efffromDatePicker.opened = true" id="efffromDateSearcher1">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--TO DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">Interest Payment To Date</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="efftoDate"
              name="efftoDate"
              ng-model="vm.todate"
              uib-datepicker-popup="dd/MM/yyyy"
              ng-init="vm.todate=''"
              datepicker-options="vm.toDateOptions"
              is-open="vm.efftoDatePicker.opened"
              close-text="Close"
              maxlength="10"
              ng-blur="vm.textableDatePicker('efftoDate',vm.todate)"
              ng-keyup="vm.autoslashing('efftoDate')"
              chars="numbers-slash"
              required
            />
            <span class="input-group-btn" data-ng-if="vm.fromdate">
              <button type="button" class="btn btn-secondary" ng-click="vm.efftoDatePicker.opened = true" id="efftoDateSearcher">
                <i class="glyphicon glyphicon-calendar"></i>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--PAN NO-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">PAN NO</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input type="text" class="form-control" name="panNo" ng-model="vm.panNo" chars="alpha-numeric" maxlength="10" oninput="this.value = this.value.replace(/\s+/g, '')" />
          </p>
        </div>
        <div class="col-sm-2" ng-if="vm.panNo || vm.schemeName">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getPanTorch();"></i>
          <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.panNo ='';"></i>
        </div>
      </div>
    </div>

    <!--BLA NO-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Bond Ledger Account Number</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input type="text" class="form-control" id="blaNum" name="blaNum" ng-model="vm.blaNo" chars="only-numbers" minlength="5" maxlength="17" oninput="this.value = this.value.replace(/\s+/g, '')" />
          </p>
        </div>
        <div class="col-sm-2" ng-if="vm.panNo || vm.blaNo && vm.schemeName">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="" ng-click="vm.getBlaNo()"></i>
          <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaNo ='';"></i>
        </div>
      </div>
    </div>

    <!--            subscriptionid-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Bond Subscription ID</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input type="text" class="form-control" name="name" ng-model="vm.subscriptionId" maxlength="14" oninput="this.value = this.value.replace(/\s+/g, '')" />
          </p>
        </div>
        <div class="col-sm-2" ng-if="vm.blaNo || vm.subscriptionId && vm.schemeName">
          <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getSubscriptionId()"></i>
          <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.subscriptionId = '';"></i>
        </div>
      </div>
    </div>

    <div class="text-center form_submit">
      <button
        type="submit"
        class="btn btn-default"
        id="submitButton"
        ui-sref="bond_actual_interest_run_credited_report.inquiry_details({obj:{
								schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								schemeStatus: vm.schemeStatus,
                                bodDate: vm.solDate,
                                fromdate:vm.fromdate,
                                todate: vm.todate,
                                panNo:vm.panNo,
                                blaNo:vm.blaNo,
                                subscriptionId:vm.subscriptionId
								}})"
        ng-disabled="accountOpeningForm.$invalid"
      >
        Submit
      </button>
      <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
    </div>
    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>

<!--Scheme Name  and Status Model-->
<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.modalSearch = ''">&times;</button>
        <h4 class="modal-title">Scheme Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input type="text" class="form-control" ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                  <tr>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Scheme Name
                    </th>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                    data-bs-dismiss="modal"
                  >
                    <td style="display: none">{{x.schemeCode}}</td>
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemeStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<!--panNo modal-->
<div class="modal" id="panModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.searchSolId=''">&times;</button>
        <h4 class="modal-title">PAN No</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead ng-init="reverseOrder=false;sortedColumn = 'panNum'">
                  <tr>
                    <th scope="col" ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                      PAN NO
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'panHldName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panHldName';"
                      ng-class="(sortedColumn == 'panHldName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      PAN HOLDER NAME
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder" ng-click="vm.panNo= x.panNo;vm.HolderName= x.name;" data-bs-dismiss="modal">
                    <td>{{x.panNo}}</td>
                    <td>{{x.holderName}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<!--BLA modal-->
<div class="modal" id="blaModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.searchSolId=''">&times;</button>
        <h4 class="modal-title">BLA List</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.blaDataList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input
                  type="text"
                  class="form-control"
                  ng-model="vm.searchSolId"
                  ng-init="vm.searchSolId = ''"
                  placeholder="Search"
                  chars="alpha-numeric"
                  oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                  <tr>
                    <th scope="col" ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                      BLA NO
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                      ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      HOLDER NAME
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';"
                      ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Mode of Holding
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" ng-repeat="x in vm.blaDataList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder" ng-click="vm.blaNo= x.blaNo;vm.holderName= x.holderName;vm.modeOfHolding= x.modeOfHolding;" data-bs-dismiss="modal">
                    <td>{{x.blaNo}}</td>
                    <td>{{x.holderName}}</td>
                    <td>{{x.modeOfHolding}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.blaDataList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<!--Subscription Id modal-->
<div class="modal" id="subscriptionModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.searchSolId=''">&times;</button>
        <h4 class="modal-title">Subscription Id</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.subscriptionList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input
                  type="text"
                  class="form-control"
                  ng-model="vm.searchSolId"
                  ng-init="vm.searchSolId = ''"
                  placeholder="Search"
                  chars="alpha-numeric"
                  oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead ng-init="reverseOrder=false;sortedColumn = 'subscriptionId'">
                  <tr>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'subscriptionId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionId';"
                      ng-class="(sortedColumn == 'subscriptionId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      SUBSCRIPTION ID
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'subscriptionDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionDate';"
                      ng-class="(sortedColumn == 'subscriptionDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      SUBSCRIPTION DATE
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'subscriptionAmt')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionAmt';"
                      ng-class="(sortedColumn == 'subscriptionAmt')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      SUBSCRIPTION AMOUNT
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    ng-repeat="x in vm.subscriptionList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                    ng-click="vm.subscriptionId= x.subscriptionId; vm.subscriptionDate = x.subscriptionDate; vm.subscriptionAmt= x.subscriptionAmt"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.subscriptionId}}</td>
                    <td>{{x.subscriptionDate}}</td>
                    <td>{{x.subscriptionAmt}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.subscriptionList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>
