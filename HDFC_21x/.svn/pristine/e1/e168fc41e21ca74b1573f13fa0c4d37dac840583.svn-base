package com.isl.gbm.cbs.integration.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class FinacleStatusValidationDTO {
    private String status;

    private String reason;

    private String eodCompletedStatus;

    public String getReason() {
        return reason;
    }

    public void setReason(String reason) {
        this.reason = reason;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }

    public String getEodCompletedStatus() {
        return eodCompletedStatus;
    }

    public void setEodCompletedStatus(String eodCompletedStatus) {
        this.eodCompletedStatus = eodCompletedStatus;
    }
}
