<div class="container from_wrapper">
	<left-menu-directive></left-menu-directive>
	<h4 class="form_heading">VERIFIED (NORMAL) TRANSACTIONS IN FINACLE
	</h4>
	<form name="verifiedTransactionInFinacleReconciliationForm" role="form"
		ng-submit="submitForm(verifiedTransactionInFinacleReconciliationForm.$valid)"
		novalidate>
		<div class="form-group required">
			<label for="sol_ld" class="control-label col-sm-2">Sol ID :</label>
			<div class="col-sm-3 inner-addon right-addon">
				<input type="text" class="form-control" id="sol_ld" name="sol_ld"
					value="01220">
				<div
					ng-show="verifiedTransactionInFinacleReconciliationForm.min_age.$invalid && !verifiedTransactionInFinacleReconciliationForm.min_age.$pristine"
					class="help-block alert alert-danger">Please enter SOl ID</div>
			</div>
			<div class="col-sm-2"></div>
			<label for="sol_des" class="control-label col-sm-2">Sol
				Description :</label>
			<div class="col-sm-3 inner-addon right-addon">
				<input type="text" class="form-control" id="sol_des" name="sol_des"
					value="BANDRA KURLA COMPLEX" required>
				<div
					ng-show="verifiedTransactionInFinacleReconciliationForm.sol_des.$invalid && !verifiedTransactionInFinacleReconciliationForm.sol_des.$pristine"
					class="help-block alert alert-danger">Please enter SOl
					Description</div>
			</div>
		</div>
		<div class="form-group required">
			<label for="sol_ld" class="control-label col-sm-2">Scheme
				Code :</label>
			<div class="col-sm-3 inner-addon right-addon">
				<input type="text" class="form-control" id="sol_ld" name="sol_ld"
					value="New Pension Scheme">
				<div
					ng-show="verifiedTransactionInFinacleReconciliationForm.min_age.$invalid && !verifiedTransactionInFinacleReconciliationForm.min_age.$pristine"
					class="help-block alert alert-danger">Please enter SOl ID</div>
			</div>

		</div>


		<div class="col-sm-offset-5 col-sm-8 form_submit">
			<button type="submit" class="btn btn-default"
				ng-disabled="verifiedTransactionInFinacleReconciliationForm.$invalid"
				ng-click="showTheForm = !showTheForm">Submit</button>
			<button type="submit" class="btn btn-cancel">Cancel</button>
		</div>
	</form>
	</div>

<div class="container from_wrapper">
	<div style="clear: both;"></div>
	<form ng-show="showTheForm" ng-submit="processForm()">
		<h4 class="form_heading">
			Finacle GBM Reconsiliation </br> GBM VERIFIED (NORMAL) TRANSACTIONS IN
			FINACLE
		</h4>
		<div class="col-md-12 col-sm-12 table-responsive">
			<table class="table-bordered" width="100%">
				<tr>
					<th>&nbsp;S No</th>
					<th>&nbsp;GBM Tran Id</th>
					<th>&nbsp;GBM Amount</th>
					<th>&nbsp;GBM Dr/Cr</th>
					<th>&nbsp;Finacle Tran Id</th>
					<th>&nbsp;Finacle Amount</th>
					<th>&nbsp;Finacle Dr/Cr</th>
					<th>&nbsp;Branch Level</th>
				</tr>
				<tr>
					<td>&nbsp; 1</td>
					<td>&nbsp; NPS24</td>
					<td>&nbsp; 5000.00</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp; S5913</td>
					<td>&nbsp; 5000</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp;Terminal Branch</td>
				</tr>
				<tr>
					<td>&nbsp; 2</td>
					<td>&nbsp; NPS24</td>
					<td>&nbsp; 200.00</td>

					<td>&nbsp; Cr</td>
					<td>&nbsp; S5913</td>
					<td>&nbsp; 200</td>

					<td>&nbsp; Cr</td>
					<td>&nbsp;Terminal Branch</td>
				</tr>
				<tr>
					<td>&nbsp; 3</td>
					<td>&nbsp; NPS24</td>
					<td>&nbsp; 5000.00</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp; S5913</td>
					<td>&nbsp; 5000</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp;Terminal Branch</td>
				</tr>
				<tr>
					<td>&nbsp; 4</td>
					<td>&nbsp; NPS24</td>
					<td>&nbsp; 5000.00</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp; S5913</td>
					<td>&nbsp; 5000</td>
					<td>&nbsp; Cr</td>
					<td>&nbsp;Terminal Branch</td>
				</tr>
			</table>
		</div>

		<div class="col-sm-offset-5 col-sm-8 form_submit">
			
			<button type="submit" class="btn btn-default"
				ng-disabled="verifiedTransactionInFinacleReconciliationForm.$invalid">Submit</button>
			<button type="submit" class="btn btn-cancel">Cancel</button>
		</div>
	</form>
</div>

<div class="container from_wrapper">

	<h4 class="form_heading">NPS Message</h4>
	   <div class="row">
	 <div class="col-sm-3"></div>
		 <div class="col-sm-7">
		   <table class="table table-bordered list">
		   <thead>
		 	<tr>
		 	
			 <th>Message Description</th>		
			</tr>
			<tr>
			
			<td>Reconciliation Successfully done for NORMAL Transaction</td>
		</tr>
		</thead>
		</table>	
		</div>
	</div>
		<div class="col-sm-offset-5 col-sm-8 form_submit">
		
		 <button type="submit" class="btn btn-cancel">Back</button>
	   </div>
</div>	