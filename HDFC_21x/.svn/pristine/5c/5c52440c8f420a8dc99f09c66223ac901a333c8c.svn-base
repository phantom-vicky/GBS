<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper">
	<h4 class="form_heading  feature-heading">Branches Of the Bank -
		Delete</h4>
	<form name="branchesOfTheBankForm" role="form">
			<div class="row">
				<div class="form-group">
					<div class="col-sm-3"></div>
					<div class="col-sm-3 required">
						<label for="solId" class="control-label">Sol Id</label>
					</div>
					<div class="col-sm-3">
						<input type="text" class="form-control" name="solId"
							   id="solId" ng-model="vm.solId"
							   maxlength="10" chars="alpha-numeric" required>
					</div>
				</div>
			</div>
			<div class="text-center form_submit">
				<button   ng-disabled="branchesOfTheBankForm.$invalid" type="submit" class="btn btn-default" id="submitButton"
						  ui-sref="cbs_branches_of_the_bank.delete_detail({obj:{
                                    solId: vm.solId
								}})">Submit</button>
				<button type="button" class="btn btn-cancel"
						onclick="window.location.href= '#!/cbs_branches_of_the_bank/action/inquiry';" id="cancelButton">Cancel</button>
			</div>
			<div class="text-center">
				<notice-message-directive></notice-message-directive>
			</div>
	</form>
</div>


