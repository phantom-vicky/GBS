<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper">
	<h4 class="form_heading  feature-heading">Other Bank Details - Add</h4>
	<form name="otherBankDetailsForm" role="form">
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required ">
					<label for="bankCode" class="control-label">Bank Code</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankCode"
						id="bankCode" ng-model="vm.cbsOtherBankDetails.C001"
						maxlength="8" chars="alpha-numeric" required oninput="this.value = this.value.replace(/\s+/g, '')">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="bankName" class="control-label">Bank Name</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankName"
						id="bankName" ng-model="vm.cbsOtherBankDetails.C002" chars="only-character" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
						maxlength="50" leading-space>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="bankShortName" class="control-label">Bank Short
						Name</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankShortName"
						id="bankShortName" ng-model="vm.cbsOtherBankDetails.C003" chars="only-character" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
						maxlength="50" leading-space>
				</div>
			</div>
		</div>
<!--		<div class="row">-->
<!--			<div class="form-group">-->
<!--				<div class="col-sm-3"></div>-->
<!--				<div class="col-sm-3">-->
<!--					<label for="additionalText1" class="control-label">Additional-->
<!--						Text1</label>-->
<!--				</div>-->
<!--				<div class="col-sm-3">-->
<!--					<input type="text" class="form-control" name="additionalText1"-->
<!--						id="additionalText1" chars="alpha-numeric"-->
<!--						ng-model="vm.cbsOtherBankDetails.C005" maxlength="40">-->
<!--				</div>-->
<!--			</div>-->
