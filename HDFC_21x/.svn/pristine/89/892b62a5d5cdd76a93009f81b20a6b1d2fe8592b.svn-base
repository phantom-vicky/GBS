                <br/>
                <div class="row">
                    <div data-ng-if="vm.filteredRecords.length != 0" class="col-md-12 text-right">
                        <div class="pagination-container">
                            <ul class="pagination">
                                <li data-ng-class="{disabled: vm.currentPage === 1}">
                                    <a href="javascript:void(0)" data-ng-click="vm.firstPage()">First</a>
                                </li>
                                <li data-ng-class="{disabled: vm.currentPage === 1}">
                                    <a href="javascript:void(0)" data-ng-click="vm.prevPage()">Prev</a>
                                </li>
                                <li data-ng-repeat="page in vm.pages" data-ng-class="{active: vm.page === vm.currentPage}">
                                    <a href="javascript:void(0)" data-ng-click="vm.setPage(page)">{{page}}</a>
                                </li>
                                <li data-ng-class="{disabled: vm.currentPage === vm.totalPages}">
                                    <a href="javascript:void(0)" data-ng-click="vm.nextPage()">Next</a>
                                </li>
                                <li data-ng-class="{disabled: vm.currentPage === vm.totalPages}">
                                    <a href="javascript:void(0)" data-ng-click="vm.lastPage()">Last</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">Showing {{(vm.currentPage-1)*vm.pageSize + 1}} to {{vm.maxValue()}} of
                    {{vm.filteredRecords.length}} records
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Appendix IV 6.5%</h4>
        No records found to display.
        <div style="text-align: center">
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/Appendix_IV_805_Mar_2024/action/inquiry';">Back
            </button>
        </div>
    </div>
</div>