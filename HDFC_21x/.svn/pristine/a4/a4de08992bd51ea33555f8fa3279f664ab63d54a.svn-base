                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'clgZoneDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'clgZoneDate';" ng-class="(sortedColumn == 'clgZoneDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Zone Dates</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'micrClgFlag')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrClgFlag';" ng-class="(sortedColumn == 'micrClgFlag')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Flag</th>
                                </tr>
