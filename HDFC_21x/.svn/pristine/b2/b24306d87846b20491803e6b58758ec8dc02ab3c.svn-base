<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">Coparceners Details of Karta - Add/Modify</h4>
    <sol-header></sol-header>

    <form name="vm.bondKartaForm" role="form">
        <table class="table table-bordered">
            <tbody>
            <tr>
                <td width="25%">Name of the Bond Scheme</td>
                <td width="25%">
                    <label class="data-bind" id="bondScheme">{{vm.subDesc}}</label>
                </td>
                <td width="25%">Mode of Holding</td>
                <td width="25%">
                    <label class="data-bind" id="modeOfHolding">{{vm.modeOfHolding}}</label>
                </td>
            </tr>
            <tr>
                <td width="25%">BLA Number</td>
                <td width="25%">
                    <label class="data-bind" id="blaNo">{{vm.blaNo}}</label>
                </td>
                  <td width="25%">Primary Holder Name</td>
                <td width="25%">
                    <label class="data-bind" id="holderName">{{vm.nameOfTheBondHolder}}</label>
                </td>
            </tr>
            </tbody>
        </table>

        <div class="col-sm-12 text-right form_submit">
            <div class="row">
                <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-init="vm.addButtonClicked = false;" ng-click="vm.addRange(); vm.addButtonClicked = true;">
                    <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                </a>

            </div>
        </div>
        <table class="table table-bordered table-striped">
            <tbody ng-repeat="item in vm.kartaList">
            <tr>
                <td colspan="4">
                    <div class="col-sm-12 text-right form_submit">
                        <div class="row">
                            <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-click="vm.removeRange(item.id, $index)">
                                <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                            </a>
                        </div>
                    </div>
                </td>
            </tr>

            <tr>
                <td colspan="4"><h4 class="form_heading">Coparceners Details of Karta {{$index+1}}</h4></td>
            </tr>

<!--            <tr style="display: none;">-->
<!--                <td width="25%">ID</td>-->
<!--                <td>-->
<!--                    <input type="text" class="form-control" id="id[$index]"-->
<!--                           maxlength="50" name="id" onkeydown="return /[a-zA-Z]/i.test(event.key)" ng-pattern="/[a-zA-Z]/" oninput="this.value = this.value.replace(/[^a-zA-Z%\s]/g, '')"-->
<!--                           ng-model="item.id">-->
<!--                </td>-->
<!--            </tr>-->



            <tr>
                <td width="25%">Coparceners Name *</td>
                <td>
                    <input type="text" class="form-control" id="coparcenersName[$index]"
                           maxlength="70" name="coparcenersName" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/, '').replace(/^([^a-zA-Z]).*/, '')"
                           ng-model="item.coparcenersName" required>
                </td>
            </tr>
            <tr>
                <td width="25%">
                    <label class="control-label">Relationship with Karta</label>
                </td>

                <td>
                    <select class="form-control" id="relationWithKarta{{$index}}"
                            name="relationWithKarta" maxlength="50"
                            ng-model="item.coparcenersRelation"
                            ng-required="item.coparcenersRelation">

                        <option value="" hidden="true">Select</option>

                        <option ng-repeat="rel in vm.guardianDetailsListMetaData"
                                value="{{rel.SUBCODE}}">
                            {{rel.DESCRIPTION}}
                        </option>

                    </select>
                </td>




            </tr>
            <tr>

                <td width="25%">
                    <label for="dob" class="control-label">DOB</label>
                </td>
                <td>

                    <p class="input-group">
                        <input type="text" class="form-control" id="dob{{$index}}"
                               name="DOB{{$index}}" ng-model="item.coparcenersDob"
                               is-open="item.dateOptions.opened" close-text="Close"
                               uib-datepicker-popup="dd/MM/yyyy"
                               datepicker-options="item.dateOptions"  ng-change="vm.dateValidation(item);" ng-init="vm.dateValidation(item);"
                               ng-blur="vm.textableDatePicker('dob' + $index, item.coparcenersDob);
                                        vm.futureNotAllowed('dob' + $index, item.coparcenersDob)"
                               ng-keyup="vm.autoslashing('dob' + $index)"
                               chars="numbers-slash"
                               maxlength="10"  ng-required="item.coparcenersDob">

                        <span class="input-group-btn">
        <button type="button" class="btn btn-secondary"
                ng-click="item.dateOptions.opened = true"
                id="dateOptions{{$index}}">
            <i class="glyphicon glyphicon-calendar"></i>
        </button>
    </span>
                    </p>


                </td>

            </tr>


            </tbody>
            <tfoot>
            <tr>
                <td width="50%">Rejection Remarks</td>


                <td> <input type="text" class="form-control" id="remarks[$index]" name="remarks"
                            ng-model="vm.nomDet[0].remarks" ng-required="vm.nomDet[0].remarks" readonly>
                </td>
            </tr>
            </tfoot>
        </table>


        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="vm.bondKartaForm.$invalid || (vm.kartaList.length === 0 && !vm.addButtonClicked)"
                    ng-click="vm.modifyDetails()">Modify</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/karta_coparceners_details/action/inquiry';">Close
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>

        </div>
    </form>
</div>




