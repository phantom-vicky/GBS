package com.isl.gbm.common.dto.wrapper;


import com.isl.gbm.common.audit.log.dto.AuditLogDto;
import com.isl.gbm.common.dto.NpsSystemParameterDto;
import com.isl.gbm.common.dto.NpsSystemParametersDto;

/**
 * The Class NpsSystemParameterAuditLogWrapper.
 */
public class NpsSystemParameterAuditLogWrapper {

    /**
     * The dto.
     */
    private NpsSystemParameterDto dto;

    private NpsSystemParametersDto dtos;

    /**
     * The audit log dto.
     */
    private AuditLogDto auditLogDto;

    public NpsSystemParametersDto getDtos() {
        return dtos;
    }

    public void setDtos(NpsSystemParametersDto dtos) {
        this.dtos = dtos;
    }

    /**
     * Gets the audit log dto.
     *
     * @return the audit log dto
     */
    public AuditLogDto getAuditLogDto() {
        return this.auditLogDto;
    }

    /**
     * Gets the dto.
     *
     * @return the dto
     */
    public NpsSystemParameterDto getDto() {
        return this.dto;
    }

    /**
     * Sets the audit log dto.
     *
     * @param auditLogDto the new audit log dto
     */
    public void setAuditLogDto(final AuditLogDto auditLogDto) {
        this.auditLogDto = auditLogDto;
    }

    /**
     * Sets the dto.
     *
     * @param dto the new dto
     */
    public void setDto(final NpsSystemParameterDto dto) {
        this.dto = dto;
    }

    /*
     * (non-Javadoc)
     *
     * @see java.lang.Object#toString()
     */
    @Override
    public String toString() {
        return "NpsSystemParameterAuditLogWrapper [dto=" + this.dto + ", auditLogDto=" + this.auditLogDto + "]";
    }

}
