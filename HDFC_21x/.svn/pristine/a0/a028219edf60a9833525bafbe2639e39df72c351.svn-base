	<div class="col-sm-12">
		<div class="audit-details">
			<div class="row">
				<div class="col-md-3">
						<span>
							<b> Created By </b> : {{vm.result.createdBy}}
						</span>
				</div>
				<div class="col-md-3">
						<span>
							<b> Last Modified By </b> : {{(vm.result.lastModifiedBy) ? (vm.result.lastModifiedBy) : ('None')}}
						</span>
				</div>
				<div class="col-md-3">
						<span>
							<b> Last Verified By </b> : {{(vm.result.verifiedBy) ? (vm.result.verifiedBy) : ('None')}}
						</span>
				</div>
				<div class="col-md-3">
						<span>
							<b> Verify Status </b> : {{vm.result.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}
						</span>
				</div>
			</div>
			<div class="row">
				<div class="col-md-3">
						<span>
							<b> Created On </b> : {{ vm.result.createdDate1 | date : 'dd/MM/yyyy'}}
						</span>
				</div>
				<div class="col-md-3">
						<span>
							<b> Last Modified On</b> : {{ (vm.result.modifiedDate1) ? (vm.result.modifiedDate1 | date : 'dd/MM/yyyy') : ('None')}}
						</span>
				</div>
				<div class="col-md-3">
						<span>
							<b> Last Verified On </b> : {{(vm.result.verifiedDate1) ? (vm.result.verifiedDate1 | date : 'dd/MM/yyyy') : ('None')}}
						</span>
				</div>
				<div class="col-md-3"></div>
			</div>
		</div>
		<div class="row">
			<div class="col-sm-offset-5 col-sm-8 form_submit">
				<button type="button" class="btn btn-default" id="submitButton"
						ng-click="vm.deleteDetails()">Delete</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
						ui-sref="cbs_branches_of_the_bank.delete">Cancel</button>
			</div>
		</div>
		</form>
	</div>
</div>



<div class="container list_wrapper" ng-if="vm.noDataFound">
	<h4 class="feature-heading">Branches Of the Bank -
		Delete</h4>
	<div class="no_records_message">No records found to display.</div>
	<center>
		<button type="button" class="btn btn-default"
				onclick="window.location.href = '#!/cbs_branches_of_the_bank/action/delete'">Cancel</button>
	</center>
</div>





