    }

    public void setAchFileNumber(String achFileNumber) {
        this.achFileNumber = achFileNumber;
    }

    public String getControl2() {
        return control2;
    }

    public void setControl2(String control2) {
        this.control2 = control2;
    }

    public String getControl3() {
