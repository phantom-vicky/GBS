			</td>
		</tr>
		<tr>
			<td>Bank Status</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C023)?
				(vm.oldNewValueList.C023.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
