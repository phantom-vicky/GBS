package com.isl.gbm.cbs.integration.dto.wrapper;

public class TellerDTO {
    private String amount;
    private String errodesc;
    private String status;
    private String tellerTranId;
    private String cbsTranDate;
    private String debitAcctNum;
    private String creditAcctNum;

    public String getDebitAcctNum() {
        return debitAcctNum;
    }

    public void setDebitAcctNum(String debitAcctNum) {
        this.debitAcctNum = debitAcctNum;
    }

    public String getCreditAcctNum() {
        return creditAcctNum;
    }

    public void setCreditAcctNum(String creditAcctNum) {
        this.creditAcctNum = creditAcctNum;
    }

    public String getTellerTranId() {
        return tellerTranId;
    }

    public void setTellerTranId(String tellerTranId) {
        this.tellerTranId = tellerTranId;
    }

    public String getCbsTranDate() {
        return cbsTranDate;
    }

    public void setCbsTranDate(String cbsTranDate) {
        this.cbsTranDate = cbsTranDate;
    }

    public String getErrodesc() {
        return errodesc;
    }

    public void setErrodesc(String errodesc) {
        this.errodesc = errodesc;
    }

    public String getStatus() {
        return status;
    }

    public void setStatus(String status) {
        this.status = status;
    }



    public String getAmount() {
        return amount;
    }

    public void setAmount(String amount) {
        this.amount = amount;
    }
}

