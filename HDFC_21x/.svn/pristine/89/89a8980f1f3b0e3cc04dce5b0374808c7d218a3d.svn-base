<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Subscription - Reversal - Change of Account number  - Inquiry</h4>
        <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">

<!--Name of the Bond Scheme-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="schemeCode" ng-model="vm.schemeName" required readonly>
                </div>
                <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0">
                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName"
                          id="treasurySearch" ng-click="vm.getModuleName();"></span>
                    <span class="glyphicon glyphicon-remove clear cp"
                          ng-click="vm.reversalId ='';vm.schemeName='';"></span>
                </div>
            </div>
        </div>

<!--Reversal ID-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="reversalId" class="control-label">Reversal ID</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="reversalId" ng-model="vm.reversalId" required readonly>
                </div>
                <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0" ng-if="vm.schemeName">
                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                          id="customerIdSearch" ng-click="vm.getReversalId();"></span>
                    <span class="glyphicon glyphicon-remove clear cp"
                          ng-click="vm.reversalId='';"></span>
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="bond_subs_reversal_change_acc_no.inquiry_detail({obj:{
								schemeCode: vm.schemeCode,
								reversalId: vm.reversalId,
								schemeName : vm.schemeName
								}})"
                    ng-disabled="accountOpeningForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>

    </form>

</div>

<!--Bond Scheme Modal-->
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
                <h4 class="modal-title">Name of the Bond Scheme</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.searchSolId"
                                       ng-Byinit="vm.searchSolId = ''" placeholder="Search"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'bondType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondType';"
                                        ng-class="(sortedColumn == 'bondType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')" scope="">
                                        Name of the Bond Scheme
                                    </th>
                                    <th ng-click="(sortedColumn == 'bondType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondType';"
                                        ng-class="(sortedColumn == 'bondType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')" scope="">
                                        Scheme Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeName = x.schemeName;vm.schemeCode = x.schemeCode;vm.schemeStatus = x.schemeStatus"
                                    data-bs-dismiss="modal">
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<!--blaAccNoFrom Modal-->
<div class="modal" id="blaAccNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Ledger Account Number</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaAccNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNo'">
                                <tr>
                                    <th scope="" ng-click="(sortedColumn == 'blaAccNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaAccNo';" ng-class="(sortedColumn == 'blaAccNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th scope="" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Holder Name</th>
                                    <th scope="" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode Of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaAccNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaAccNo = x.fromBlaNo" data-bs-dismiss="modal">
                                    <td>{{x.fromBlaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!--subscriptionId Model-->
<div class="modal" id="subScriptionIdModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Subscription ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.subscriptionIdList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'bondScbId'">
                                <tr>
                                    <th scope="col" ng-click="(sortedColumn == 'bondScbId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondScbId';" ng-class="(sortedColumn == 'bondScbId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Subscription Id </th>
                                    <th scope="col" ng-click="(sortedColumn == 'subscriptionDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionDate';" ng-class="(sortedColumn == 'subscriptionDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription Date</th>
                                    <th scope="col" ng-click="(sortedColumn == 'subscriptionAmt')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionAmt';" ng-class="(sortedColumn == 'subscriptionAmt')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription Amount</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.subscriptionIdList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.bondScbId = x.subscriptionId;  vm.subscriptionDate = x.subscriptionDate; vm.subscriptionAmt = x.subscriptionAmt;" data-bs-dismiss="modal">
                                    <td>{{x.subscriptionId}}</td>
                                    <td>{{x.subscriptionDate}}</td>
                                    <td>{{x.subscriptionAmt}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.subscriptionIdList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!--blaAccNoTo-->
<div class="modal" id="blaAccNoToModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Ledger Account Number</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaAccNoToList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNoTo'">
                                <tr>
                                    <th scope="col" ng-click="(sortedColumn == 'blaAccNoTo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaAccNoTo';" ng-class="(sortedColumn == 'blaAccNoTo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th scope="col" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Holder Name</th>
                                    <th scope="col" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode Of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaAccNoToList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaAccNoTo = x.toBlaNo" data-bs-dismiss="modal">
                                    <td>{{x.toBlaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaAccNoToList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!--Reversal Id Modal-->
<div class="modal" id="reversalIdModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Reversal Id</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.reversalIdList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchReversalId" ng-init="vm.searchReversalId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll" aria-label="">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'reversalId'">
                                <tr>
                                    <th scope="col" class="modal-title title-case" ng-click="(sortedColumn == 'reversalId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'reversalId';" ng-class="(sortedColumn == 'reversalId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Reversal ID</th>
                                    <th scope="col" class="modal-title title-case" ng-click="(sortedColumn == 'subscriptionId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionId';" ng-class="(sortedColumn == 'subscriptionId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription ID </th>
                                    <th scope="col" class="modal-title title-case" ng-click="(sortedColumn == 'fromBlaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'fromBlaNo';" ng-class="(sortedColumn == 'fromBlaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">From BLA No</th>
                                    <th scope="col" class="modal-title title-case" ng-click="(sortedColumn == 'toBlaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'toBlaNo';" ng-class="(sortedColumn == 'toBlaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">To BLA No</th>
                                    <th scope="col" class="modal-title title-case" ng-click="(sortedColumn == 'verifyStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifyStatus';" ng-class="(sortedColumn == 'verifyStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verify Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.reversalIdList | filter:vm.searchReversalId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.reversalId= x.reversalId;" data-bs-dismiss="modal">
                                    <td>{{x.reversalId}}</td>
                                    <td>{{x.subscriptionId}}</td>
                                    <td>{{x.fromBlaNo}}</td>
                                    <td>{{x.toBlaNo}}</td>
                                    <td>{{x.verifyStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.reversalIdList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>