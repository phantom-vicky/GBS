package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class CafuFileFooterRecordDTO {

    private String recordIdentifier;
    private String totalNumberOfdeposits;
    private String totalAmount;
    private String totalChkum;

    public String getRecordIdentifier() {
        return recordIdentifier;
    }

    public void setRecordIdentifier(String recordIdentifier) {
        this.recordIdentifier = recordIdentifier;
    }

    public String getTotalNumberOfdeposits() {
        return totalNumberOfdeposits;
    }

    public void setTotalNumberOfdeposits(String totalNumberOfdeposits) {
        this.totalNumberOfdeposits = totalNumberOfdeposits;
    }

    public String getTotalAmount() {
        return totalAmount;
    }

    public void setTotalAmount(String totalAmount) {
        this.totalAmount = totalAmount;
    }

    public String getTotalChkum() {
        return totalChkum;
    }

    public void setTotalChkum(String totalChkum) {
        this.totalChkum = totalChkum;
    }
}
