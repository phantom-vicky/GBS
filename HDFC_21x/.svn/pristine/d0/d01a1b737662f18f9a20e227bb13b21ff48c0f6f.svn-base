                                </tr>

                                </tbody>
                            </table>
                        </div>

                        <div uib-accordion-group id="sapensioner-details-three" class="panel panel-default" ng-if="vm.getNomineeDetails.length > 0"
                             heading="NOMINEE DETAILS">
                            <table ng-repeat = "item in vm.getNomineeDetails" id="nominee{{$index}}" class="table table-bordered table-striped list old-new-value-table">
                                <thead>
                                <tr>
                                    <th width="50%">Particular - Nominee {{$index+1}}</th>
                                    <th>{{(vm.auditInfo.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.auditInfo.previousOperationType == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td>Nominee First Name</td>
                                    <td class="old-value">{{(item && item.C003)?
                                        (item.C003.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C003? (item.C003.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Nominee Middle Name</td>
                                    <td class="old-value">{{(item && item.C004)?
                                        (item.C004.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C004? (item.C004.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Nominee Last Name</td>
                                    <td class="old-value">{{(item && item.C005)?
                                        (item.C005.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C005? (item.C005.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Address1</td>
                                    <td class="old-value">{{(item && item.C006)?
                                        (item.C006.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C006? (item.C006.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Address2</td>
                                    <td class="old-value">{{(item && item.C007)?
                                        (item.C007.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C007? (item.C007.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>City</td>
                                    <td class="old-value">{{(item && item.C008)?
                                        (item.C008.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C008? (item.C008.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>State</td>
                                    <td class="old-value">{{(item && item.C009)?
                                        (item.C009.oldValue | getLabelFromValuesArray : vm.stateListLabelValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C009? (item.C009.newValue | getLabelFromValuesArray : vm.stateListLabelValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Pin Code</td>
                                    <td class="old-value">{{(item && item.C010)?
                                        (item.C010.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C010? (item.C010.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Phone No</td>
                                    <td class="old-value">{{(item && item.C011)?
                                        (item.C011.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C011? (item.C011.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Share Percentage</td>
                                    <td class="old-value">{{(item && item.C012)?
                                        (item.C012.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C012? (item.C012.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Operative Account No</td>
                                    <td class="old-value">{{(item && item.C013)?
                                        (item.C013.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C013? (item.C013.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Is Nominee a Minor</td>
                                    <td class="old-value">{{(item && item.C015)?
                                        (item.C015.oldValue | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C015? (item.C015.newValue | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Relation with Holder</td>
                                    <td class="old-value">{{(item && item.C016)?
                                        (item.C016.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsList)) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C016? (item.C016.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsList)) : ('')}}
                                    </td>
                                </tr>


                                <tr>
                                    <td>Date of Birth Of Minor</td>
                                    <td class="old-value">{{(item && item.C017)?
                                        (item.C017.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C017? (item.C017.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <th>Particular - Guardian Details  (Mandatory if Nominee is a Minor)</th>
                                    <th>{{(vm.verificationDetails == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.verificationDetails == 'M'">New Value</th>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian First Name</td>
                                    <td class="old-value">{{(item && item.C018)?
                                        (item.C018.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C018? (item.C018.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian Middle Name</td>
                                    <td class="old-value">{{(item && item.C019)?
                                        (item.C019.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C019? (item.C019.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
