package com.isl.gbm.transaction.channel;

/**
 * The Class CbsTransactionException.
 *
 * @author Rahul.Kumar
 */
public class CbsTransactionException extends RuntimeException {

    /**
     * Instantiates a new cbs transaction exception.
     *
     * @param message
     *            the message
     */
    public CbsTransactionException(final String message) {
        super(message);
    }

}
