package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class RbiBondTrailRunReportDto {


    private String branchId;
    private String bondLedgerAccountNumber;
    private String bondSubscriptionId;
    private String bondHolderName;
    private String modeOfHolding;
    private String firstJointHolderName;
    private String subscriptionAmount;
    private String accountOpenDate;
    private String interestPeriodFrom;
    private String interestPeriodTo;
    private String modeOfInterestPayment;
    private String ddPoAccNumber;
    private String creditAccountNumber;
    private String interestAmount;
    private String currentTdsAmount;
    private String arrearTdsAmount;
    private String netInterestAmount;

    public String getBranchId() {
        return branchId;
    }

    public void setBranchId(String branchId) {
        this.branchId = branchId;
    }

    public String getBondLedgerAccountNumber() {
        return bondLedgerAccountNumber;
    }

    public void setBondLedgerAccountNumber(String bondLedgerAccountNumber) {
        this.bondLedgerAccountNumber = bondLedgerAccountNumber;
    }

    public String getBondSubscriptionId() {
        return bondSubscriptionId;
    }

    public void setBondSubscriptionId(String bondSubscriptionId) {
        this.bondSubscriptionId = bondSubscriptionId;
    }

    public String getBondHolderName() {
        return bondHolderName;
    }

    public void setBondHolderName(String bondHolderName) {
        this.bondHolderName = bondHolderName;
    }

    public String getModeOfHolding() {
        return modeOfHolding;
    }

    public void setModeOfHolding(String modeOfHolding) {
        this.modeOfHolding = modeOfHolding;
    }

    public String getFirstJointHolderName() {
        return firstJointHolderName;
    }

    public void setFirstJointHolderName(String firstJointHolderName) {
        this.firstJointHolderName = firstJointHolderName;
    }

    public String getSubscriptionAmount() {
        return subscriptionAmount;
    }

    public void setSubscriptionAmount(String subscriptionAmount) {
        this.subscriptionAmount = subscriptionAmount;
    }

    public String getAccountOpenDate() {
        return accountOpenDate;
    }

    public void setAccountOpenDate(String accountOpenDate) {
        this.accountOpenDate = accountOpenDate;
    }

    public String getInterestPeriodFrom() {
        return interestPeriodFrom;
    }

    public void setInterestPeriodFrom(String interestPeriodFrom) {
        this.interestPeriodFrom = interestPeriodFrom;
    }

    public String getInterestPeriodTo() {
        return interestPeriodTo;
    }

    public void setInterestPeriodTo(String interestPeriodTo) {
        this.interestPeriodTo = interestPeriodTo;
    }

    public String getModeOfInterestPayment() {
        return modeOfInterestPayment;
    }

    public void setModeOfInterestPayment(String modeOfInterestPayment) {
        this.modeOfInterestPayment = modeOfInterestPayment;
    }

    public String getDdPoAccNumber() {
        return ddPoAccNumber;
    }

    public void setDdPoAccNumber(String ddPoAccNumber) {
        this.ddPoAccNumber = ddPoAccNumber;
    }

    public String getCreditAccountNumber() {
        return creditAccountNumber;
    }

    public void setCreditAccountNumber(String creditAccountNumber) {
        this.creditAccountNumber = creditAccountNumber;
    }

    public String getInterestAmount() {
        return interestAmount;
    }

    public void setInterestAmount(String interestAmount) {
        this.interestAmount = interestAmount;
    }

    public String getCurrentTdsAmount() {
        return currentTdsAmount;
    }

    public void setCurrentTdsAmount(String currentTdsAmount) {
        this.currentTdsAmount = currentTdsAmount;
    }

    public String getArrearTdsAmount() {
        return arrearTdsAmount;
    }

    public void setArrearTdsAmount(String arrearTdsAmount) {
        this.arrearTdsAmount = arrearTdsAmount;
    }

    public String getNetInterestAmount() {
        return netInterestAmount;
    }

    public void setNetInterestAmount(String netInterestAmount) {
        this.netInterestAmount = netInterestAmount;
    }

}
