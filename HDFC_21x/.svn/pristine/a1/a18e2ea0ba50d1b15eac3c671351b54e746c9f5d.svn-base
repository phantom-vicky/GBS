package com.isl.gbm.common.audit.log.common;

/**
 * The Enum OperationModes.
 */
public enum OperationModes {

    /**
     * The add.
     */
    ADD("ADD"),
    /**
     * The modify.
     */
    MODIFY("MODIFY"),
    /**
     * The delete.
     */
    DELETE("DELETE"),
    /**
     * The verify.
     */
    VERIFY("VERIFY"),

    /**
     * The revert.
     */
    REVERT("REVERT");

    /**
     * The operation mode.
     */
    private String operationMode;

    /**
     * Instantiates a new operation modes.
     *
     * @param operationMode the operation mode
     */
    private OperationModes(final String operationMode) {
        this.operationMode = operationMode;
    }

    /**
     * Gets the operation mode.
     *
     * @return the operation mode
     */
    public String getOperationMode() {
        return this.operationMode;
    }

}
