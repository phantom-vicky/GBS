<div class="container from_wrapper new_form_wrapper">
  <div class="loader-new" ng-if="vm.loader"></div>

  <h4 class="form_heading">Brokerage Claim_Monthly_Broker Wise Income & Expense</h4>

  <div class="row">
    <sol-header></sol-header>
  </div>

  <form name="brokerClaimForm" role="form">
    <div class="row">

      <div class="row">
        <div class="form-group">
          <div class="col-sm-3"></div>
          <div class="col-sm-3">
            <label class="control-label">Name of the Module</label>
          </div>
          <div class="col-sm-5">
            <label><b>RBI Bond</b></label>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-sm-offset-3">
        <!--Broker Agency Code-->
        <div class="row">
          <div class="form-group">
            <div class="col-sm-3"></div>
            <div class="col-sm-3">
              <label for="schemeCode" class="control-label">Broker Agency Code</label>
            </div>
            <div class="col-sm-3">
              <p class="input-group">
                <input type="text" class="form-control" id="BrokerAgencyCode" ng-model="vm.brokerAgencyCode" chars="alpha-numeric" />
              </p>
            </div>
            <div class="col-sm-2">
              <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.brokeragencyTorch();"></i>
              <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.brokerAgencyCode ='';"></i>
            </div>
          </div>
        </div>

        <!--Scheme Name-->
        <div class="row">
          <div class="form-group required">
            <div class="col-sm-3"></div>
            <div class="col-sm-3">
              <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
            </div>
            <div class="col-sm-3">
              <p class="input-group">
                <input type="text" class="form-control" id="schemeCode" ng-model="vm.schemeName" chars="alpha-numeric" readonly required />
              </p>
            </div>
            <div class="col-sm-2">
              <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getModuleName();"></i>
              <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.schemeName ='';vm.schemeCode = '';"></i>
            </div>
          </div>
        </div>

        <!--FROM DATE-->
        <div class="row">
          <div class="form-group required">
            <div class="col-sm-3"></div>
            <div class="col-sm-3"><label class="control-label">From Date</label></div>
            <div class="col-sm-4">
              <p class="input-group">
                <input
                  type="text"
                  class="form-control"
                  id="efffromDate1"
                  name="efffromDate"
                  ng-model="vm.fromdate"
                  uib-datepicker-popup="dd/MM/yyyy"
                  ng-init="vm.fromdate=''; vm.fromDateVal()"
                  ng-change="vm.toDateVal(vm.fromdate); vm.todate=''; vm.updateColumnHeaders()"
                  datepicker-options="vm.fromDateOptions"
                  is-open="vm.efffromDatePicker.opened"
                  close-text="Close"
                  maxlength="10"
                  ng-blur="vm.textableDatePicker('efffromDate1',vm.fromdate)"
                  ng-keyup="vm.autoslashing('efffromDate1')"
                  chars="numbers-slash"
                  required
                />
                <span class="input-group-btn">
                  <button type="button" class="btn btn-secondary" ng-click="vm.efffromDatePicker.opened = true" id="efffromDateSearcher1">
                    <i class="glyphicon glyphicon-calendar"></i>
                  </button>
                </span>
              </p>
            </div>
          </div>
        </div>

        <!--TO DATE-->
        <div class="row">
          <div class="form-group required">
            <div class="col-sm-3"></div>
            <div class="col-sm-3"><label class="control-label">To Date</label></div>
            <div class="col-sm-4">
              <p class="input-group">
                <input
                  type="text"
                  class="form-control"
                  id="efftoDate"
                  name="efftoDate"
                  ng-model="vm.todate"
                  uib-datepicker-popup="dd/MM/yyyy"
                  ng-init="vm.todate=''"
                  datepicker-options="vm.toDateOptions"
                  is-open="vm.efftoDatePicker.opened"
                  close-text="Close"
                  maxlength="10"
                  ng-blur="vm.textableDatePicker('efftoDate',vm.todate)"
                  ng-keyup="vm.autoslashing('efftoDate')"
                  chars="numbers-slash"
                  required
                />
                <span class="input-group-btn">
                  <button type="button" class="btn btn-secondary" ng-click="vm.efftoDatePicker.opened = true" id="efftoDateSearcher">
                    <i class="glyphicon glyphicon-calendar"></i>
                  </button>
                </span>
              </p>
            </div>
          </div>
        </div>

        <!--Submit & Cancel Button-->
        <div class="text-center form_submit">
          <button
            type="submit"
            id="submitbutton"
            class="btn btn-default"
            ui-sref="brokerage_claim_monthly_broker_wise_income&expense.inquiry_detail({obj:{
                               schemeName:vm.schemeName,
                               schemeCode:vm.schemeCode,
                               brokerAgencyCode:vm.brokerAgencyCode,
                               fromDate: vm.fromdate,
                               toDate : vm.todate
                        }})"
            ng-disabled="brokerClaimForm.$invalid"
          >
            Submit
          </button>
          <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">
            Cancel
          </button>
        </div>
        <div class="text-center">
          <notice-message-directive></notice-message-directive>
        </div>
      </div>
    </div>
  </form>
</div>

<!--Broker Agency Code-->
<div class="modal" id="brokerModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
        <h4 class="modal-title">Broker Agency Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input
                  type="text"
                  class="form-control"
                  ng-model="vm.searchSolId"
                  ng-init="vm.searchSolId = ''"
                  placeholder="Search"
                  oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead>
                  <tr>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';"
                      ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Agency Code
                    </th>
                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';"
                      ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Name
                    </th>

                    <th
                      scope="col"
                      ng-click="(sortedColumn == 'verifystatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifystatus';"
                      ng-class="(sortedColumn == 'verifystatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Verify Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    ng-repeat="x in vm.brokeragency | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                    ng-click="vm.brokerAgencyCode = x.brokerAgencyCode; vm.brokerName = x.brokerName;vm.verifyStatus=x.verifystatus"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.brokerAgencyCode}}</td>
                    <td>{{x.brokerName}}</td>
                    <td>{{x.verifystatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.brokeragency.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<!--Scheme Name  and Status Model-->
<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.modalSearch=''">&times;</button>
        <h4 class="modal-title">Scheme Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <i class="glyphicon glyphicon-search"></i>
                </div>
                <input
                  type="text"
                  class="form-control"
                  ng-model="vm.modalSearch"
                  ng-init="vm.modalSearch = ''"
                  placeholder="Search"
                  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort">
                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                  <tr>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Scheme Name
                    </th>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemeStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>
