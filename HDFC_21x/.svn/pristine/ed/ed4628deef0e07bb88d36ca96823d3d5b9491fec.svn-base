<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">Scheme Master - Verify/Reject</h4>
    <sol-header></sol-header>
    <form name="schemeMaster" role="form">
        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.details == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.details.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Name of the Module</td>
                <td class="old-value">
                    <label><b>RBI Bond</b></label>
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    <label><b>RBI Bond</b></label>
                </td>
            </tr>
            <tr>
                <td>Branch code</td>
                <td class="old-value">{{(vm.solId)?
                    (vm.solId) : ('')}}</td>
                <td ng-if="vm.details.previousOperationType == 'M'" class="new-value">
                    {{(vm.solId)?
                    (vm.solId) : ('')}}
                </td>
            </tr>

            <tr class="uppercase">
                <td>Branch Name</td>
                <td class="old-value" >
                    {{(vm.username)? (vm.username) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.username)?(vm.username) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Scheme Name</td>
                <td class="old-value">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C003.oldValue)? (vm.masterOldNewValueModel.C003.oldValue) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C003.newValue)? (vm.masterOldNewValueModel.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Status</td>
                <td class="old-value">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C004.oldValue)? (vm.masterOldNewValueModel.C004.oldValue) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C004.newValue)? (vm.masterOldNewValueModel.C004.newValue) : ('')}}
                </td>
            <tr>
            </tbody>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.details.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.details.modifiedBy) ? (vm.details.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.details.verifiedBy) ? (vm.details.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.details.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.details.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.details.modifiedDate) ? (vm.details.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.details.verifiedDate) ? (vm.details.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="verifyButton" ng-click="vm.verifySubmit();"
                    ng-disabled="schemeMaster.$invalid">Verify</button>
            <button type="submit" class="btn btn-default" id="deleteButton" ng-click="vm.rejectReason();"
                    ng-disabled="schemeMaster.$invalid">Reject</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/scheme_master_rbi_bond/action/verify';">Cancel
            </button>
        </div>

    </form>
</div>


<div class="modal" id="permissionMappingDelete" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"> REJECTION REMARKS</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" >
                    <form name="permissionDelete" role="form">

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-2"></div>
                                <label class="control-label col-sm-3">Remarks</label>
                                <div class="col-sm-5">
                                    <!--
                                                                        <textarea class="form-control"   ng-keypress="vm.validateInput($event,'remarks')" id="remarks" name="remarks" ng-model="vm.remarks" maxlength="80" required></textarea>
                                    -->
                                    <select class="form-control list_wrapper" id="remarks[$index]" name="remarks[$index]"
                                            ng-model="vm.remarks" ng-init="vm.getRemarksList();"   required>
                                        <option value="">Select</option>
                                        <option ng-repeat="item in vm.remarksList"
                                                name="{{item.subCode + parentIndex}}" id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">{{item.subCodeDescription}}</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-offset-5 col-sm-8 form_submit">
                            <button type="button" class="btn btn-default" data-bs-dismiss="modal" ng-disabled="permissionDelete.$invalid" ng-click="vm.deleteSubmit()" >Submit</button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>




