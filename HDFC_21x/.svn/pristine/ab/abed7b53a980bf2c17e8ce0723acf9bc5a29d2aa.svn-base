package com.isl.gbm.admin.service;

import com.isl.gbm.admin.dto.SackUserDto;

import java.util.List;

public interface SackUserService {

    /**
     * Gets the sack user list.
     *
     * @param userId the user id
     * @param solId  the sol id
     * @return the sack user list
     */
    List<SackUserDto> getSackUserList(final String userId, final String solId);

    /**
     * Gets the sol id.
     *
     * @param solId
     *            the sol id
     * @return the sol id
     */


    /**
     * Gets the sol id.
     *
     * @param userId the user id
     * @return the sol id
     */
    SackUserDto getSolId(final String userId);

    /**
     * Update sack user list.
     *
     * @param userId the user id
     * @param solId  the sol id
     * @param dto    the dto
     */
    public void updateSackUserList(final String userId, final String solId, final List<SackUserDto> dto);
}
