package com.isl.gbm.common.audit.log.model;

import java.io.Serializable;
import java.util.ArrayList;
import java.util.List;

/**
 * The Class ModifiedDataDetails.
 */
public class ModifiedDataDetails implements Serializable {

    /**
     * The Constant serialVersionUID.
     */
    private static final long serialVersionUID = 1L;

    /**
     * The column details list.
     */
    private List<ColumnDetails> columnDetailsList = new ArrayList<>();

    /**
     * The modified column detail list.
     */
    private List<ColumnDetails> modifiedColumnDetailList = new ArrayList<>();

    /**
     * Gets the column details list.
     *
     * @return the column details list
     */
    public List<ColumnDetails> getColumnDetailsList() {
        return this.columnDetailsList;
    }

    /**
     * Gets the modified column detail list.
     *
     * @return the modified column detail list
     */
    public List<ColumnDetails> getModifiedColumnDetailList() {
        return this.modifiedColumnDetailList;
    }

    /**
     * Sets the column details list.
     *
     * @param columnDetailsList the new column details list
     */
    public void setColumnDetailsList(final List<ColumnDetails> columnDetailsList) {
        this.columnDetailsList = columnDetailsList;
    }

    /**
     * Sets the modified column detail list.
     *
     * @param modifiedColumnDetailList the new modified column detail list
     */
    public void setModifiedColumnDetailList(final List<ColumnDetails> modifiedColumnDetailList) {
        this.modifiedColumnDetailList = modifiedColumnDetailList;
    }

}
