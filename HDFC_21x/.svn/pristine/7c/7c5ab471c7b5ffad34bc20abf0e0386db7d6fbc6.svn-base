<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Branch IFSC Codes - Inquiry</h4>
    <sol-header></sol-header>
    <form name="ppfSchemeParameterCreationForm" role="form">

         <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.resultInquiry.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.resultInquiry.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Bank Code</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C001)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C001.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue &&
                    vm.resultInquiry.branchIfscDetailsOldNewValue.C002)? (vm.resultInquiry.branchIfscDetailsOldNewValue.C001.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch code</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C002)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C002.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C002)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C002.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch IFSC code</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C003)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C003.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C003)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Payment System Id (RTGS)</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C004)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C004.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C004)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C004.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text1</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C006)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C006.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C006)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C006.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text2</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C007)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C007.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C007)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C007.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text3</td>
                <td class="old-value">{{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C008)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C008.oldValue) : ('')}}
                </td>
                <td ng-if="vm.resultInquiry.previousOperationType == 'M'" class="new-value">
                    {{(vm.resultInquiry.branchIfscDetailsOldNewValue && vm.resultInquiry.branchIfscDetailsOldNewValue.C008)?
                    (vm.resultInquiry.branchIfscDetailsOldNewValue.C008.newValue) : ('')}}
                </td>
            </tr>
            </tbody>
        </table>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.resultInquiry.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.resultInquiry.modifiedBy) ? (vm.resultInquiry.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.resultInquiry.verifiedBy) ? (vm.resultInquiry.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.resultInquiry.isVerified  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.resultInquiry.creatDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.resultInquiry.modDate) ? (vm.resultInquiry.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.resultInquiry.verDate) ? (vm.resultInquiry.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    ng-click="vm.showCancelConfirmation('branch_ifsc_codes.list');">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
