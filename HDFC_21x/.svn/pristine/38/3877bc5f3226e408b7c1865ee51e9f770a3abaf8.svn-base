<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Account Transfer Out - Inquiry</h4>
    <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">


        <div class="row" >
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-2">
                    <label class="control-label"><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="blaNo" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="schemeCode"
                           ng-model="vm.schemeName"
                           chars="alpha-numeric" readonly required>
                </div>
                <div class="col-sm-3">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                       id="treasurySearch"
                       ng-click="vm.getTorchDetails('SC');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.schemeName ='';vm.schemeCode='';vm.isTranOutToOtherBank='';vm.bondHolderName='';vm.blaNo='';vm.panNum='';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="bondHolderName" class="control-label">Holder Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control"  maxlength="150"
                           id="bondHolderName" name="bondHolderName" ng-model="vm.bondHolderName" oninput="this.value = this.value.replace(/\s+/g, '')"  maxlength="150" chars="only-letters" leading-space>

                </div>
                <div class="col-sm-3" ng-if="vm.schemeCode">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="bondHolderName"
                           id="treasurySearch"
                           ng-click="vm.getTorchDetails('N');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.bondHolderName ='';vm.blaNo='';vm.panNum=''"></i>
                </div>
                </div>
            </div>

        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="panNum" class="control-label">PAN No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="panNum"
                           ng-model="vm.panNum" ng-init="vm.panNum = '';" ng-disabled="!vm.schemeCode"
                           chars="alpha-numeric" minlength="5" maxlength="10" oninput="this.value = this.value.replace(/\s+/g, '')">
                </div>
                <div class="col-sm-3" ng-if="(vm.panNum  || vm.bondHolderName) && vm.schemeCode" >
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="treasurySearch"
                       ng-click="vm.getTorchDetails('P');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.panNum ='';vm.blaNo='';"></i>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="custId" class="control-label">Bond BLA No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="custId"
                           ng-model="vm.blaNo" ng-init="vm.blaNo = '';" ng-disabled="!vm.schemeCode"
                           chars="alpha-numeric" minlength="5" maxlength="20"  required>
                </div>
                <div class="col-sm-2"  ng-if="(vm.blaNo || (vm.panNum  && vm.bondHolderName)) && vm.schemeCode">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="treasurySearch"
                       ng-click="vm.getTorchDetails('B');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.blaNo =''; vm.bondSubsId='';"></i>
                </div>
            </div>
        </div>

        <div class="row" >
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Transfer out to Other Bank? (Yes/No)</label>
                </div>
                <div class="col-sm-2">
                    <input type="radio" id="isPaidY" name="isPaid" ng-model="vm.isTranOutToOtherBank" ng-init="vm.defaultSelectOption();" required value="Y">Yes
                    <input type="radio" id="isPaidN" name="isPaid" ng-model="vm.isTranOutToOtherBank" required value="N">No
                </div>
            </div>
        </div>


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Subscription ID</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="bondSubsId"
                           ng-model="vm.bondSubsId"
                           chars="alpha-numeric" disabled>
                </div>
                <div class="col-sm-2"  ng-if="vm.schemeCode && vm.blaNo && vm.isTranOutToOtherBank">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="bondSubsIdTor"
                       ng-click="vm.getTorchDetails('S');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.bondSubsId=''"></i>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="rbi_bnd_acc_trans_out.inquiry_detail({obj:{
						schemeCode: vm.schemeCode,
                        schemeName: vm.schemeName,
                        modeOfHolding: vm.modeOfHolding,
                        panNum:vm.panNum,
                        bondHolderName:vm.bondHolderName,
                        bondSubsId : vm.bondSubsId,
                        blaNo: vm.blaNo,
                        isTranOutToOtherBank: vm.isTranOutToOtherBank
								}})"
                    ng-disabled="accountOpeningForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!--bla modal-->
<div class="modal" id="blaModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';" ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo = x.blaNo; vm.modeOfHolding = x.modeOfHolding;" data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaTorchList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>


<!--bla modal-->
<div class="modal" id="nameModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Holder Name List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.nameTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'bondHolderName'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Holder Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN NO</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.nameTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo = x.blaNo;vm.modeOfHolding = x.modeOfHolding; vm.bondHolderName = x.bondHolderName;vm.panNum = x.panNum;" data-bs-dismiss="modal">
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                    <td>{{x.blaNo}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.nameTorchList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>
<!--Pan Number-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNum'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN NO</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN HOLDER NAME</th>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.panNum= x.panNum;vm.bondHolderName= x.bondHolderName;vm.blaNo = x.blaNo;" data-bs-dismiss="modal">
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.blaNo}}</td>

                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<div class="modal" id="subsModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Subscription ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.subsTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'bondSubsId'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'bondSubsId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondSubsId';" ng-class="(sortedColumn == 'bondSubsId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription ID</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.subsTorchList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.bondSubsId= x.bondSubsId;" data-bs-dismiss="modal">
                                    <td>{{x.bondSubsId}}</td>


                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.subsTorchList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>



<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'schemeCode'">
                                <tr>
                                    <!--                                    <th ng-click="(sortedColumn == 'schemeCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeCode';" ng-class="(sortedColumn == 'schemeCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME CODE</th>-->
                                    <th ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME NAME</th>
                                    <th ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME STATUS</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.schemeCode;vm.schemeName= x.schemeName;" data-bs-dismiss="modal">
                                    <!--                                    <td>{{x.schemeCode}}</td>-->
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>