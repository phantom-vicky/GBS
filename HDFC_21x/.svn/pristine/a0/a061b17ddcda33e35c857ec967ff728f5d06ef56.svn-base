<div class="container from_wrapper">
<div class="loader-new" ng-if="vm.loader"></div>
<left-menu-directive></left-menu-directive> 

        <h4 class="form_heading">Place Holders Definition - Inquiry	</h4>
        
        	<div class="row">
			 <div class="form-group">
			 <div class="col-sm-2"></div>
				  <label for="schemeType" class ="control-label col-sm-5"> Scheme Type</label>
				<div class="col-sm-2">
					<select class="form-control" id="schemeType" name="schemeType" ng-model="vm.schemeType" >
						 <option value="">Select</option>
						  <option value="common">Common</option>
					      <option value="cbdt">CBDT</option>
					      <option value="cbec">CBEC</option>
					</select>
					</div>
				</div>
	    </div>
	    
<!-- <div id="schemeType"  ng-if="vm.schemeType == ''" >  -->
<!-- common -->
<div id="schemeType"  ng-if="vm.schemeType == 'common'" >

      <h4 class="form_heading">Common	</h4>
      
      
      <div class="loader"></div>
	<table class="table table-bordered table-striped list">
	    <thead>
	      <tr>
	        <th>Particular</th>
	        <th>Value</th>
	        <th>Description</th>
	       
	      </tr>
	    </thead>
	    <tbody>
	      <tr>
	        <td>Budget Year End Period</td>
	        <td>{{vm.budgetEndDate / vm.budgetEndMonth}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Budget Year Start Period</td>
	        <td>{{vm.budgetStartDate / vm.budgetStartMonth}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Can EOD Continue If NFT Verification Is Pending</td>
	        <td>{{vm.eodpending}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Financial Year End Period</td>
	        <td>{{vm.financialYearEndDate / vm.financialYearEndMonth}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Financial Year Start Period</td>
	        <td>{{vm.financialYearStartDate / vm.financialYearStartMonth}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Instrument Type for Instrument Validation</td>
	        <td>{{vm.instrumentValidation}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td> Minimum TOC Amount</td>
	        <td>{{vm.tocAmount}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>Minor Age</td>
	        <td>{{vm.age}}</td>
	        <td></td>
	      </tr>
	      <tr>
	        <td>Cash Account Place Holder</td>
	        <td>{{vm.cashAccount}}</td>
	        <td>{{vm.cashAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>Clearing Sundry Account Place Holder</td>
	        <td>{{vm.clearingAccount}}</td>
	        <td>{{vm.clearingAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>DD Account Place Holder</td>
	        <td>{{vm.ddAccount}}</td>
	        <td>{{vm.ddAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>ECS Account Place Holder</td>
	        <td>{{vm.ecsAccount}}</td>
	        <td>{{vm.ecsAccountTitle}}</td>
	      </tr>
	        <tr>
	        <td>Focal Point Consolidation Account Place Holder</td>
	        <td>{{vm.focalPointAccount}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>RBI Relief Bond LC Consolidation Place Holder</td>
	        <td>{{vm.rbiBond}}</td>
	        <td>{{vm.rbiBondTitle}}</td>
	      </tr>
	       <tr>
	        <td>RBI/PSB Account Place Holder</td>
	        <td>{{vm.rbiAccount}}</td>
	        <td>{{vm.rbiAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>Local RBI Account Place Holder</td>
	        <td>{{vm.localRbiAccount}}</td>
	        <td>{{vm.localRbiAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>Pay Order Account Place Holder</td>
	        <td>{{vm.payOrderAccount}}</td>
	        <td>{{vm.payOrderAccountTitle}}</td>
	      </tr>
	       <tr>
	        <td>Sundry Account Place Holder</td>
	        <td>{{vm.sundryAccount}}</td>
	        <td></td>
	      </tr>
	       <tr>
	        <td>TDS A/C Place Holder</td>
	        <td>{{vm.tdsAccount}}</td>
	        <td>{{vm.tdsAccountTitle}}</td>
	      </tr>
	      <tr>
	        <td>Turn Over Commission Mode</td>
	        <td>{{vm.tocMode}}</td>
	        <td></td>
	      </tr>
    </tbody>
</table>
        </div>	      
	      
	<!-- common -->
	
	
	
	<!-- CBDT -->
	
