<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <form name="blaForm" role="form">
        <h4 class="form_heading">BOND Freeze / Un-Freeze Modify</h4>
        <sol-header></sol-header>
        <div class="container from_wrapper new_form_wrapper" ng-if="vm.responseResultForMod.length>0">
            <div class="row">
                <div class="col-sm-12">

                    <table class="table table-bordered table-striped list">
                        <thead>
                        <tr>
                            <td width="50%">Name of the Bond Scheme</td>
                            <td width="50%">
                                <label class="data-bind" id="schemeName">
                                    {{vm.schemeName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">PAN No</td>
                            <td width="50%">
                                <label class="data-bind" id="panNo">{{vm.panNoName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">BLA No</td>
                            <td width="50%">
                                <label class="data-bind" id="blaNo">{{vm.blaNo}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">Subscription Id</td>
                            <td width="50%">
                                <label class="data-bind" id="subId">{{vm.subId}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group  required"><label class="control-label">Does the
                                principal
                                amount need to be frozen?</label>
                            </td>
                            <td width="50%" class="form-group ng-dirty required">
                                <label>
                                    <input type="radio" name="principal_freeze" ng-model="vm.amountFreeze" value="Y">
                                    Yes
                                </label>
                                <label>
                                    <input type="radio" name="principal_freeze" ng-model="vm.amountFreeze" value="N"> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required"><label class="control-label">Does the
                                Interest
                                Payment need to be frozen?</label>
                            </td>
                            <td width="50%" class="form-group ng-dirty required">
                                <label>
                                    <input type="radio" name="Interest_freeze" ng-model="vm.interestFreeze"
                                           value="Y">
                                    Yes
                                </label>
                                <label>
                                    <input type="radio" name="Interest_freeze" ng-model="vm.interestFreeze"
                                           value="N">
                                    No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%" class="form-group required">Is transferring out from another bank allowed?
                            </td>
                            <td width="50%" class="form-group required">
                                <label>
                                    <input type="radio" name="transferring_freeze" ng-model="vm.transferAnotherBank"
                                           value="Y"> Yes
                                </label>
                                <label>
                                    <input type="radio" name="transferring_freeze" ng-model="vm.transferAnotherBank"
                                           value="N"> No
                                </label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">Maker Reason</td>
                            <td width="50%">
                                    <textarea class="form-control" rows="3"
                                              maxlength="200" id="remarks" name="makerRemarks"
                                              ng-model="vm.makerRemarks" required></textarea>
                            </td>
                        </tr>
                    </table>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list nowrap table-textWrap">
                            <thead>
                            <th>Name of the Holder</th>
                            <th>DOB</th>
                            <th>BLA No</th>
                            <th>Subscription ID</th>
                            <th>Bond Type</th>
                            <th>Subscription Amount</th>
                            <th>Account Open Date</th>
                            <th>Maturity Date</th>
                            <th>Last Interest Paid</th>
                            </thead>
                            <tbody>
                            <tr ng-repeat="items in vm.responseResultForMod">
                                <td>{{items.name}}</td>
                                <td>{{items.dob}}</td>
                                <td>{{items.blaNo}}</td>
                                <td>{{items.subscriptionId}}</td>
                                <td>{{items.bondType}}</td>
                                <td>{{vm.indianNumberFormat(items.subscriptionAmount)}}</td>
                                <td>{{items.accountOpenDate}}</td>
                                <td>{{items.maturityDate}}</td>
                                <td>{{items.lastInterestPaid}}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.audit.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.audit.modifiedBy) ? (vm.audit.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.audit.verifiedBy) ? (vm.audit.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.audit.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.audit.createdDate | date : 'dd-MM-yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.audit.modifiedDate) ? (vm.audit.modifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.audit.verifiedDate) ? (vm.audit.verifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="blaForm.$pristine || blaForm.$invalid" ng-click="vm.modifySubmit()">Modify
            </button>
            <button type="button" id="cancelButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/freeze_unfreeze/action/modify';">Cancel
            </button>
        </div>
    </form>
</div>





