<!--Input Screen-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>

<div class="container from_wrapper new_form_wrapper">
    <div class="loader-new" ng-if="vm.loader"></div>
    <dc-left-menu></dc-left-menu>


    <h4 class="form_heading">Bond Centralized Interest Trial Run - Add</h4>
    <div class="row">
        <sol-header></sol-header>
    </div>

    <form name="rbi_bond_centralized_trial_run" role="form" >
        <div class="row">
            <div class="col-sm-6 col-sm-offset-3">

                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-6">
                            <label>BOD Date</label>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-control">{{vm.solDate | date : 'dd/MM/yyyy'}}</label>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label for="moduleName">Name of the module</label>
                        </div>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" id="moduleName" ng-model="vm.moduleName"
                                   required readonly>
                        </div>
                    </div>
                </div>


               <!-- <div class="row" ng-init="vm.getModuleName();">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label for="bondScheme" class="control-label">Name of the Bond Scheme</label>
                        </div>
                        <div class="col-sm-4">
                            <select class="form-control" id="bondScheme" name="bondScheme"
                                    ng-model="vm.schemeCode" ng-change="vm.getUnverifiedDetails()" required>
                                <option value="">Select</option>
                                <option ng-repeat="item in vm.schemeList" value="{{item.subCode}}" ng-bind="vm.schemeName = item.subCodeDescription"></option>
                            </select>
                        </div>
                    </div>
                </div>
-->
                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label for="schemeName" class="control-label">Name of the Bond scheme</label>
                        </div>

                        <div class="col-sm-4">
                            <input type="text" class="form-control" id="schemeName"
                                   ng-model="vm.schemeName"  readonly required>
                        </div>

                        <div class="col-sm-2">
                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                               id="schemeCodeSearch"
                               ng-click="vm.getTorchDetails('scheme');vm.interestForHalfYear='';vm.schemeCode='';vm.schemeName = '';"></i> <i
                                class="glyphicon glyphicon-remove clear cp"
                                ng-click="vm.schemeName = '';vm.schemeCode='';vm.interestForHalfYear='';"></i>
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-6">
                            <label>Interest for the Half Year</label>
                        </div>
                        <div class="col-sm-4">
                            <select class="form-control" id="interestForHalfYear" name="interestForHalfYear"
                                    ng-model="vm.interestForHalfYear"  ng-disabled="!vm.schemeCode"
                                     required>
                                <option value="" hidden="true">Select</option>
                                <option ng-repeat="items in vm.interestHalfYearList" value="{{items.interestForHalfYear}}" ng-bind="items.interestForHalfYear"></option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-6">
                            <label>Year</label>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-control" ng-model="vm.financeyear">{{vm.financeyear}}</label>
                        </div>
                    </div>
                </div>


                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="continueTrialRun"
                            ng-disabled="rbi_bond_centralized_trial_run.$invalid"
                            ng-click="vm.getTrialRunProcess();">Continue Trial Run Process
                    </button>
                    <button type="submit" class="btn btn-default" id="unverifiedAccount"
                            ui-sref="rbi_bond_centralized_trial_run.add_detail({obj:{

                                year : vm.financeyear,
                                interestForHalfYear : vm.interestForHalfYear,
                                schemeCode : vm.schemeCode,
                                schemeName : vm.schemeName

								}})"
                            ng-disabled="rbi_bond_centralized_trial_run.$invalid">View Un verified BOND Account Details</button>
                    <button type="button" class="btn btn-default" id="downloadUnmergeButton"
                            ng-disabled="rbi_bond_centralized_trial_run.$invalid" ng-click="vm.download(
								   vm.schemeCode,
                                vm.financeyear,
                                vm.interestForHalfYear,'unmerged'						);">UnMerged</button>
                    <button type="button" class="btn btn-default" id="downloadMergeButton"
                            ng-disabled="rbi_bond_centralized_trial_run.$invalid" ng-click="vm.download(
								   vm.schemeCode,
                                vm.financeyear,
                                vm.interestForHalfYear	,'merged'						);">Merged</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            onclick="window.location.href= '#!/dc_rbi_bond_menu';">Cancel
                    </button>
                </div>

            </div>
        </div>
    </form>
</div>



<div class="modal" id="branchIdSearcher" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">

                            <table class="table table-bordered list scroll sort">

                                <thead ng-init="reverseOrder = false; sortedColumn = 'schemeName'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Status</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName;vm.schemeStatus = x.schemeStatus;vm.getTorchDetails('interestHalfYear');"
                                    data-bs-dismiss="modal">
                                    <!--                                    <td>{{x.schemeCode}}</td>-->
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>

                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!--Branch ID  Modal-->
<div class="modal" id="branchSearcher" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Branch ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.search" ng-init="vm.search = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'branchId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchId';" ng-class="(sortedColumn == 'branchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Id</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchDescription')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchDescription';" ng-class="(sortedColumn == 'branchDescription')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Description</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.branchIdList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.branchId = x.branchId; vm.branchDescription = x.branchDescription" data-bs-dismiss="modal">
                                    <td>{{x.branchId}}</td>
                                    <td>{{x.branchDescription}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>





<div class="modal" id="bondSubsIdSearch" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Subscription ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.bondSubsList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.search"
                                       placeholder="Search"  chars="alpha-numeric"ng-init="vm.search = ''">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'bondSubsId'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'bondSubsId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondSubsId';" ng-class="(sortedColumn == 'bondSubsId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Subscription ID</th>
                                    <th ng-click="(sortedColumn == 'accountOpenDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'accountOpenDate';" ng-class="(sortedColumn == 'accountOpenDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription Date</th>
                                    <th ng-click="(sortedColumn == 'subsAmount')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subsAmount';" ng-class="(sortedColumn == 'subsAmount')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Subscription Amount</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.bondSubsList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.bondSubsId = x.bondSubsId;" data-bs-dismiss="modal">
                                    <td>{{x.bondSubsId}}</td>
                                    <td>{{x.accountOpenDate}}</td>
                                    <td align="right">{{x.subsAmount}}</td>
                                </tr>
                                </tbody>
                            </table>

                            <div class="text-center form_submit">
                                <button type="submit"  class="btn btn-default" id="backButton"
                                        data-bs-dismiss="modal" ng-click="vm.selectInputVal()">OK</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.bondSubsList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>



<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Ledger Account Number List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.search" ng-init="vm.search = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                    <th ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';" ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verified status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaDataList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo= x.blaNo;vm.modeOfHolding = x.modeOfHolding;vm.nameOfTheBondHolder=x.nameOfTheBondHolder" data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.nameOfTheBondHolder}}</td>
                                    <td>{{x.jointHolderType}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                    <td>{{x.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>