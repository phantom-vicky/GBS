<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Broker Master Maintenance - Add</h4>
    <sol-header></sol-header>
    <form name="tdsparameter" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="moduleName" class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-2">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Agency Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerAgencyCode" ng-init="vm.brokerAgencyCode=''"   limit-To="30" min="1"
                           name="brokerAgencyCode" ng-model="vm.brokerAgencyCode" ng-blur = "vm.addValidation();vm.minValueOne($event,'brokerAgencyCode')"
                           oninput="this.value = (this.value.length === 1 && !/^[a-zA-Z0-9]/.test(this.value)) ? this.value.replace(/[^a-zA-Z0-9]/g, '') : this.value.replace(/[^a-zA-Z0-9,\/-]/g, '')"
                           required>
                    <span class="alert-danger" ng-if="vm.brokerAgencyCodeErrorMessage">{{vm.brokerAgencyCodeErrorMessage}}</span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerName"
                           name="brokerName" ng-model="vm.brokerName" ng-change="vm.removeChars(vm.brokerName);"
                           ng-keypress="vm.validateInputAlphaWithSpace($event,'brokerName')"   chars="only-letters" minlength="1" ng-maxlength="150" limit-to="50"
                           required >
                </div>
            </div>
        </div>


            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-2"></div>
                    <div class="col-sm-5">
                        <label class="control-label">Broker Group</label>
                    </div>
                    <div class="col-sm-2">
                        <select class="form-control" id="brokerGroup" name="brokerGroup"
                                ng-model="vm.brokerGroup" ng-init="vm.getBrokerGroupMetaData()" required>
                            <option value="" >Select</option>
                            <option ng-repeat="item in vm.brokerGroupList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                                   </select>
                    </div>


                </div>
            </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Sort code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerSortCode" chars="alpha-numeric" maxlength="10"
                           name="brokerSortCode" ng-blur = "vm.minValueOne($event,'brokerSortCode')" ng-model="vm.brokerSortCode" required oninput="this.value = this.value.replace(/\s+/g, '')">
                </div>
            </div>
        </div>
        <!--<div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <label class="control-label col-sm-5">
                    HDFC/OTHER BANK</label>
                <div class="col-sm-2">
                    <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.hdfcOtherBank" required value="Y">Yes
                    <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.hdfcOtherBank" required value="N">No
                </div>
            </div>
        </div>-->







       <!-- <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">HDFC Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchCode" ng-init=""
                           ng-blur = "vm.minValueOne($event,'branchCode')" name="branchCode" ng-model="vm.branchCode"  chars="alpha-numeric"  required leading-space>
                </div>
            </div>
        </div>-->

        <div class="row" ng-if="vm.brokerGroup=='I001'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Type Of Broker</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="brokerType" name="brokerType"
                            ng-model="vm.brokerType" ng-init="vm.getMetaData()" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.brokerTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                        <!--                        <option value="GR">GST registered</option>-->
<!--                        <option value="GU">GST unregistered</option>-->
<!--                        <option value="I">Individual</option>-->
<!--                        <option value="NI">Non-individual</option>-->
<!--                        <option value="CG">Composite GST</option>-->
<!--                        <option ng-repeat="item in vm.moduleNameList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>-->
                    </select>
                </div>
            </div>
        </div>




        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >GST No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text"  class="form-control" id="gstNo" ng-model="vm.gstNo" name="gstNo"
                           maxlength="15" chars="alpha-numeric" ng-blur = "vm.minValueOne($event,'gstNo')" leading-space>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="panTan" class="control-label">PAN</label>
                </div>
                <div class="col-sm-2" >
                    <input type="text"  class="form-control"  ng-pattern="vm.panPattern"name="panTan" id="panTan"
                           ng-model="vm.panTan"
                           chars="alpha-numeric"
                           maxlength="10"
                           leading-space required>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="dateOfBirth" class="control-label">Brokerage Create Date</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="brokerageCreateDate"
                               name="brokerageCreateDate"  ng-model="vm.brokerageCreateDate" maxlength="10"
                               uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.toDate='';vm.fromToDateValidation()"
                               is-open="vm.brokerageCreateDate.opened" close-text="Close"
                               datepicker-options="vm.dobCalenderOptions"   ng-blur="vm.textableDatePicker('brokerageCreateDate',vm.brokerageCreateDate);vm.futureNotAllowed('brokerageCreateDate',vm.brokerageCreateDate)"
                               ng-keyup="vm.autoslashing('brokerageCreateDate')" chars="numbers-slash"
                               required>
                        <span class="input-group-btn" >
                                    <button type="button" class="btn btn-secondary"
                                            ng-click="vm.brokerageCreateDate.opened = true"
                                            id="brokerageCreateDatePicker">
                                        <i class="glyphicon glyphicon-calendar"></i>
                                    </button>
                </span></p>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Payment Mode</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="paymentMode" name="paymentMode" ng-change="vm.bankCode='';vm.branchCode='';"
                            ng-model="vm.paymentMode" ng-init="vm.getPaymentMetaData()" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.paymentTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                        <!--                        <option value="GR">GST registered</option>-->
                        <!--                        <option value="GU">GST unregistered</option>-->
                        <!--                        <option value="I">Individual</option>-->
                        <!--                        <option value="NI">Non-individual</option>-->
                        <!--                        <option value="CG">Composite GST</option>-->
                        <!--                        <option ng-repeat="item in vm.moduleNameList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>-->
                    </select>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.paymentMode == 'MP001'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Operative Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="operativeAccNo" ng-init="vm.operativeAccNo=''" chars="only-numbers" maxlength="25"
                           name="operativeAccNo" ng-model="vm.operativeAccNo"   oninput="this.value = this.value.replace(/\s+/g, '')" required>

                </div>
            </div>
        </div>

        <div class="row"  ng-if="vm.paymentMode == 'MP003'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">DD Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="ddAccNo" ng-init="vm.operativeAccNo=''" chars="only-numbers" maxlength="25"
                           name="ddAccNo" ng-model="vm.operativeAccNo" required>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required" ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="rbiCode" class="control-label">Bank Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="nonBankName"
                           ng-model="vm.nonBankName" chars="alpha-numeric" required readonly>
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="nonBankNameSearch"
                           ng-click="vm.nonHdfcTorch('bankName');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.nonBankName='';vm.bankCode='';"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
        <div class="form-group required" ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Operative Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="operativeAccNo" ng-init="vm.operativeAccNo=''" chars="only-numbers" maxlength="25"
                           name="operativeAccNo" ng-model="vm.operativeAccNo" oninput="this.value = this.value.replace(/\s+/g, '')" required>
                </div>
            </div>
        </div>
        </div>
        <div class="row">
        <div class="form-group required" ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">IFSC Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="instIfscCode" name="instIfscCode"
                           ng-model="vm.instIfscCode"
                           ng-keypress="vm.ifscKeypress($event)"
                           ng-blur="vm.applyIfscToAddField()"
                           ng-pattern="vm.ifscPattern" maxlength="11"
                           ng-required="!(vm.micrCodeLoc && vm.micrCodeLoc.length > 0)">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="instIfscCodeSearch"
                           ng-click="vm.nonHdfcTorch('ifsc');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.instIfscCode='';"></i>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <div class="row">
        <div class="form-group " ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Code Loc</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrCodeLoc"
                           ng-model="vm.micrCodeLoc" maxlength="3" chars="alpha-numeric"
                           ng-required="!(vm.instIfscCode && vm.instIfscCode.length > 0)">
                </div>

            </div>
        </div>
        </div>
        <div class="row">
        <div class="form-group required" ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Bank Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBankCode"
                           ng-model="vm.micrBankCode" chars="alpha-numeric" maxlength="3">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="micrBankCodeSearch"
                           ng-click="vm.nonHdfcTorch('micrCodeBank');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.micrBankCode='';"></i>
                    </div>
                </div>
            </div>
        </div>
        </div>
        <div class="row">
        <div class="form-group required" ng-if="vm.paymentMode == 'MP002' || vm.paymentMode == 'MP004' || vm.paymentMode == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBranchCode"
                           ng-model="vm.micrBranchCode" chars="alpha-numeric" maxlength="3">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="micrBranchCodeSearch"
                           ng-click="vm.nonHdfcTorch('micrBranchCode');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.micrBranchCode='';"></i>
                    </div>
                </div>
            </div>
        </div>
        </div>
