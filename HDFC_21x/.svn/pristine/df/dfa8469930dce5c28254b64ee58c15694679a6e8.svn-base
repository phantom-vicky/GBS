<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.nomineeList.length > 0">
  <div class="container from_wrapper new_form_wrapper">
    <div class="text-right form_submit">
      <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/';" id="homeButton">Home</button>
      <button type="button" id="cancel_Button" class="btn btn-cancel" onclick="window.location.href= '#!/nominee_continuation_report/action/inquiry';">Back</button>
    </div>

    <div class="row">
      <h4 class="form_heading">Nominee Continuation Report</h4>

      <sol-header></sol-header>

      <table style="width: 100%; padding: 10px" class="table table-bordered" aria-label="">
        <tr>
          <th scope="col">Name of the Bond Scheme</th>
          <td>{{vm.schemeName}}</td>
          <th scope="col" style="width: 20%">Total Count</th>
          <td style="width: 20%">{{vm.total}}</td>
        </tr>
        <tr>
          <th scope="col">From Date</th>
          <td>{{vm.fromDate | date:'dd/MM/yyyy'}}</td>
        </tr>
        <tr>
          <th scope="col">To Date</th>
          <td>{{vm.toDate | date:'dd/MM/yyyy'}}</td>
        </tr>
      </table>
    </div>

    <div class="row">
      <div class="col-sm-12">
        <div class="row" style="display: flex; align-items: center; justify-content: space-between">
          <div class="col-sm-3" style="flex: 1">
            <div class="form-group">
              <table style="border-spacing: 2" aria-label="NC">
                <tr>
                  <th scope="col"></th>
                </tr>
                <tr>
                  <td>Show&nbsp;</td>
                  <td>
                    <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                            ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                            ng-change="vm.pageNo = 1; vm.getDetails();"
                            ng-disabled="vm.noDataFoundInSearch">
                      <option value="5">5 per page</option>
                      <option value="10">10 per page</option>
                      <option value="20">20 per page</option>
                      <option value="50">50 per page</option>
                    </select>
                  </td>

                </tr>
              </table>
            </div>
          </div>

          <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
            <div class="form-group" style="margin-right: 15px">
              <div class="input-group">
                <input type="text" id="search" class="form-control" data-ng-model="vm.searchText" placeholder="Search"/>
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getDetails()"></span>
                </div>
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchText='';vm.pageNo = 1; vm.getDetails()"></span>
                </div>
              </div>
            </div>

            <div class="form-group">
              <select class="form-control" id="downloadOptions"
                      name="export" data-ng-model="vm.downloadType"
                      data-ng-disabled="vm.noDataFoundInSearch"
                      data-ng-change="vm.downloadReport()">
                <option value="">EXPORT</option>
                <option value="excel">EXCEL</option>
<!--                <option value="csv">CSV</option>-->
              </select>
            </div>
          </div>
        </div>

        <div class="table-responsive">
          <table class="table table-bordered table-striped list nowrap table-textWrap datatable">
            <thead data-ng-if="!vm.noDataFoundInSearch">
            <tr class="thalign">
              <th rowspan="1">S.No.</th>
              <th rowspan="1">Name of the Bond Scheme</th>
              <th rowspan="1">Death Marked Holder PAN</th>
              <th rowspan="1">Death Holder Name</th>
              <th rowspan="1">Death Marked Holder BLA No</th>
              <th rowspan="1">Death Marked Holder Subscription ID</th>
              <th rowspan="1">Date of Death</th>
              <th rowspan="1">Date of Receipt of Death Certificate</th>
              <th rowspan="1">Death Marking Date</th>
              <th rowspan="1">Main Subscription Amount</th>
              <th rowspan="1">Nominee 1 ID</th>
              <th rowspan="1">Nominee 1 Name</th>
              <th rowspan="1">Nominee 1 Pan No</th>
              <th rowspan="1">Nominee 1 DOB</th>
              <th rowspan="1">Nominee 1 Share percentage</th>
              <th rowspan="1">Nominee 1 Bla</th>
              <th rowspan="1">Nominee 1 SubScriptionId</th>
              <th rowspan="1">Nominee 1 SubScription Amount</th>
              <th rowspan="1">Nominee 1 Mode Of Interest Payment</th>

              <th rowspan="1">Nominee 2 ID</th>
              <th rowspan="1">Nominee 2 Name</th>
              <th rowspan="1">Nominee 2 Pan No</th>
              <th rowspan="1">Nominee 2 DOB</th>
              <th rowspan="1">Nominee 2 Share percentage</th>
              <th rowspan="1">Nominee 2 Bla</th>
              <th rowspan="1">Nominee 2 SubScriptionId</th>
              <th rowspan="1">Nominee 2 SubScription Amount</th>
              <th rowspan="1">Nominee 2 Mode Of Interest Payment</th>

              <th rowspan="1">Nominee 3 ID</th>
              <th rowspan="1">Nominee 3 Name</th>
              <th rowspan="1">Nominee 3 Pan No</th>
              <th rowspan="1">Nominee 3 DOB</th>
              <th rowspan="1">Nominee 3 Share percentage</th>
              <th rowspan="1">Nominee 3 Bla</th>
              <th rowspan="1">Nominee 3 SubScriptionId</th>
              <th rowspan="1">Nominee 3 SubScription Amount</th>
              <th rowspan="1">Nominee 3 Mode Of Interest Payment</th>

              <th rowspan="1">Nominee 4 ID</th>
              <th rowspan="1">Nominee 4 Name</th>
              <th rowspan="1">Nominee 4 Pan No</th>
              <th rowspan="1">Nominee 4 DOB</th>
              <th rowspan="1">Nominee 4 Share percentage</th>
              <th rowspan="1">Nominee 4 Bla</th>
              <th rowspan="1">Nominee 4 SubScriptionId</th>
              <th rowspan="1">Nominee 4 SubScription Amount</th>
              <th rowspan="1">Nominee 4 Mode Of Interest Payment</th>

              <th>Bond Type</th>
              <th>Account Open Date</th>
              <th>Subscription Transferred to Nominee</th>
              <th>Period of Deposit</th>
              <th>Maturity Date</th>
            </tr>
            </thead>
            <tbody data-ng-if="!vm.noDataFoundInSearch">
            <tr dir-paginate="x in vm.nomineeList | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
              <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
              <td>{{vm.schemeName}}</td>
              <td>{{x.deathMarkedHolderPan}}</td>
              <td>{{x.deathHolderName}}</td>
              <td>{{x.deathMarkedHolderBlaNo}}</td>
              <td>{{x.deathMarkedHolderSubscriptionId}}</td>
              <td>{{x.dateOfDeathOfBondHolder}}</td>
              <td>{{x.dateOfReceiptOfDeathCertificate}}</td>
              <td>{{x.deathMarkingDate}}</td>
              <td>{{vm.indianNumberFormat(x.mainSubscriptionAmount)}}</td>
              <td>{{x.nominee1Id}}</td>
              <td>{{x.nominee1Name}}</td>
              <td>{{x.nominee1PanNo}}</td>
              <td>{{x.nominee1Dob}}</td>
              <td>{{x.nominee1SharePercentage}}</td>
              <td>{{x.nominee1BlaNo}}</td>
              <td>{{x.nominee1SubscriptionId}}</td>
              <td>{{vm.indianNumberFormat(x.nominee1SubscriptionAmount)}}</td>
              <td>{{x.nominee1ModeOfInterestPayment}}</td>

              <td>{{x.nominee2Id}}</td>
              <td>{{x.nominee2Name}}</td>
              <td>{{x.nominee2PanNo}}</td>
              <td>{{x.nominee2Dob}}</td>
              <td>{{x.nominee2SharePercentage}}</td>
              <td>{{x.nominee2BlaNo}}</td>
              <td>{{x.nominee2SubscriptionId}}</td>
              <td>{{vm.indianNumberFormat(x.nominee2SubscriptionAmount)}}</td>
              <td>{{x.nominee2ModeOfInterestPayment}}</td>

              <td>{{x.nominee3Id}}</td>
              <td>{{x.nominee3Name}}</td>
              <td>{{x.nominee3PanNo}}</td>
              <td>{{x.nominee3Dob}}</td>
              <td>{{x.nominee3SharePercentage}}</td>
              <td>{{x.nominee3BlaNo}}</td>
              <td>{{x.nominee3SubscriptionId}}</td>
              <td>{{vm.indianNumberFormat(x.nominee3SubscriptionAmount)}}</td>
              <td>{{x.nominee3ModeOfInterestPayment}}</td>

              <td>{{x.nominee4Id}}</td>
              <td>{{x.nominee4Name}}</td>
              <td>{{x.nominee4PanNo}}</td>
              <td>{{x.nominee4Dob}}</td>
              <td>{{x.nominee4SharePercentage}}</td>
              <td>{{x.nominee4BlaNo}}</td>
              <td>{{x.nominee4SubscriptionId}}</td>
              <td>{{vm.indianNumberFormat(x.nominee4SubscriptionAmount)}}</td>
              <td>{{x.nominee4ModeOfInterestPayment}}</td>

              <td>{{x.bondType}}</td>
              <td>{{x.accountOpenDate}}</td>
              <td>{{x.subscriptionTransferredToNominee}}</td>
              <td>{{x.periodOfDeposits}}</td>
              <td>{{x.maturityDate}}</td>
            </tr>
            </tbody>
            <tbody data-ng-if="vm.noDataFoundInSearch">
            <tr>
              <td style="text-align:center">No Records Found</td>
            </tr>
            </tbody>
          </table>
        </div>
        <br />
        <div class="text-center form_submit">
              <span ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev</button>
              </span>

          <span>
                <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

          <span ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();">Next</button>
              </span>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
  <div class="list_wrapper no_records_message">
    <h4 class="form_heading">Nominee Continuation Report</h4>
    No records found to display.
    <div style="text-align: center">
      <button type="button" class="btn btn-default" onclick="window.location.href= '#!/nominee_continuation_report/action/inquiry';">Back</button>
    </div>
  </div>
</div>
