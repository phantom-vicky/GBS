<user-left-menu></user-left-menu>
<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper">
    <h4 class="form_heading">Manage Roles ({{vm.userName}}) - {{vm.action}}</h4>
    <div class="col-md-12 margin-btm">
        <div class="row">
            <h5 class="text-center sub-title">Selected Roles for this User</h5>
            <div class="col-md-12 map-div">
                <div class="col-md-6">
                    <div>
                        <input type="text" class="form-control" id="unmappedPermSearcher" ng-model="unmappedPermSearcher" placeholder="Search">
                    </div>
                    <div class="row" style="height : 25px;"></div>
                    <h5>Unmapped Roles</h5>
                    <ul>
                        <li ng-repeat="item in vm.users.unmappedUserRoleList | filter : unmappedPermSearcher">{{item.name}}</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <div>
                        <input type="text" class="form-control" id="mappedPermSearcher" ng-model="mappedPermSearcher" placeholder="Search">
                    </div>
                    <div class="row" style="height : 25px;"></div>
                    <h5>Mapped Roles</h5>
                    <ul>
                        <li ng-repeat="item in vm.users.mappedUserRoleList | filter : mappedPermSearcher">{{item.name}}</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-12 map-div text-center" ng-if="vm.users.mappedUserRoleList.length == 0">
                <h5> No Records Found to Display</h5>
            </div>
        </div>
    </div>


    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created By </b> : {{vm.users.createdBy}} </span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified By </b> : {{(vm.users.lastModifiedBy) ? (vm.users.lastModifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified By </b> : {{(vm.users.verifiedBy) ? (vm.users.verifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.users.verifyStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created On </b> : {{ vm.users.createdDate}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified On</b> : {{ (vm.users.lastModifiedDate) ? (vm.users.lastModifiedDate) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified On </b> : {{(vm.users.verifiedDate) ? (vm.users.verifiedDate) : ('None')}}</span>
            </div>
            <div class="col-md-3">
            </div>
        </div>
    </div>

    <div class="text-center form_submit">
        <button type="submit" id="verifySubmitBtn" name="verifySubmitBtn" ng-if="vm.action == 'verify'"
                class="btn btn-default" ng-click="vm.verifySubmit()">Verify</button>
        <button type="button" class="btn btn-cancel" id="cancelButton"
                ui-sref="user_role_mapping.list({action: '{{vm.action}}'})">Cancel</button>
    </div>
</div>
