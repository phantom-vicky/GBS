<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.model">
    <div class="text-right form_submit" >
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/rbibond_gu_functionality';" id="homeButton">Home</button>
        <button type="button" id="cancel_Button" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbibond_principal_repayment_scroll/action/inquiry';">Back</button>
    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="row">
            <h4 class="form_heading">Appendix V - Bond Principal Repayment Scroll</h4>
            <h4 align="right">Appendix V</h4>
            <h4 align="right">Para 11.2</h4>
            <h4 align="right">Date:{{vm.currentDate}}</h4>
            <sol-header></sol-header>

        </div>
        <div class="row">

            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                           ui-jq="dataTable" ui-options="vm.dataTableOption">
                        <thead>
                        <tr>
                            <th style="border: none;text-align: center;" colspan="8"><p>Appendix V - Bond Principal Repayment Scroll</p></th>
                        </tr>
                        <tr >
                            <th  style="border: none;text-align: center;"  colspan="8" ><p>{{vm.schemeName}}</p></th>
                        </tr>
                        <tr>
                            <th  style="border: none;text-align: center;"  colspan="8"><p>For the period from {{vm.fromDate | date:"dd/MM/yyyy"}} to {{vm.toDate | date:"dd/MM/yyyy"}} </p></th>
                        </tr>

                        <tr class="thalign">
                            <th>S.No</th>
                            <th>Bond Ledger Account Number</th>
                            <th>Due date of Repayment</th>
                            <th>Date of Repayment</th>
                            <th>Amount of Repayment Rs.</th>
                            <th>Credited to Bank Account No.</th>
                            <th>Remarks</th>
                            <th>Initials</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="x in vm.model">
                            <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                            <td>{{x.blaNo}}</td>
                            <td align="center">{{x.dueDateRepay}}</td>
                            <td align="center">{{x.dateOfRepayment}}</td>
                            <td align="right">{{x.amtOfRepay}}</td>
                            <td>{{x.creditBankAcc}}</td>
                            <td>{{x.remarks}}</td>
                            <td>{{x.initials}}</td>
<!--                            <td align="right">{{x.operativeAccNo}}</td>-->
                        </tr>
                        </tbody>
                        <tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th class="text-right">Grand Total Rs.</th>
                            <th class="text-center">{{vm.mod}}</th>
                            <th></th>
                            <th></th>
                            <th></th>

                        </tr>
                        </tfoot>
                    </table>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Appendix V - Bond Principal Repayment Scroll</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/rbibond_principal_repayment_scroll.inquiry/action/inquiry';" >Back</button>
        </center>
    </div>
</div>