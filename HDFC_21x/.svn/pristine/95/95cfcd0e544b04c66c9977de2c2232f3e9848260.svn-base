<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">TDS Deduction at other than normal TDS rate report</h4>
    <sol-header></sol-header>

    <form name="accountOpeningForm" role="form">


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <!--Scheme name-->
        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="schemeCode" ng-model="vm.schemeName" readonly />
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearcher" ng-click="vm.getModuleName();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.schemeCode ='';vm.schemeName =''; vm.schemeStatus=''; vm.holderName='';vm.panNo='';
                       vm.blaNo=''; vm.financialYear='';"></i>
                </div>
            </div>
        </div>

        <!--name input field-->
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control"
                               id=""
                               name="holderName"
                               ng-model="vm.holderName"
                               maxlength="50"
                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                        />
                    </p>
                </div>
            </div>
        </div>

        <!--PAN NO-->
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">PAN NO</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input
                                type="text"
                                class="form-control"
                                name="panNo"
                                ng-model="vm.panNo"
                                chars="alpha-numeric"
                                ng-pattern="vm.panPattern"
                                minlength="4"
                                maxlength="10"
                                oninput="this.value = this.value.replace(/\s+/g, '')"
                        />
                    </p>
                </div>
                <div class="col-sm-2" ng-if="vm.panNo || vm.holderName && vm.schemeName">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getPanTorch();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.panNo ='';vm.holderName='';"></i>
                </div>
            </div>
        </div>

        <!--BLA NO-->
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">BLA NO</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input
                                type="text"
                                class="form-control"
                                name="blaNo"
                                ng-model="vm.blaNo"
                                chars="alpha-numeric"
                                minlength="4"
                                maxlength="14"
                                oninput="this.value = this.value.replace(/\s+/g, '')"
                        />
                    </p>
                </div>
                <div class="col-sm-2" ng-if="vm.panNo || vm.holderName && vm.schemeName">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" ng-click="vm.getblaTorch();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaNo ='';"></i>
                </div>
            </div>
        </div>

        <!--FINANCIAL YEAR-->
        <div class="row" data-ng-init="vm.getFinancialYears()">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Financial Year</label>
                </div>
                <div class="col-sm-2">
                    <select
                            class="form-control"
                            id="financial-year"
                            name="financial-year"
                            data-ng-model="vm.financialYear" readonly required>
                        <option value="" disabled selected>Select</option>
                        <option data-ng-repeat="year in vm.financialYears" value="{{year.financialYear}}" data-ng-bind="year.financialYear">
                        </option>
                    </select>
                </div>
            </div>
        </div>



        <div class="text-center form_submit">
            <button
                    type="submit"
                    class="btn btn-default"
                    id="submitButton"
                    ui-sref="tds_deduction_at_other_than_normal_tds_rate_report.inquiry_detail({obj:{
								schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								schemestatus: vm.schemestatus,
								holderName : vm.holderName,
                                panNo: vm.panNo,
                                blaNo: vm.blaNo,
                                financialYear: vm.financialYear,
								}})"
                    ng-disabled="accountOpeningForm.$invalid"
            >
                Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!--Scheme Name  and Status Model-->
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.modalSearch=''">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''" placeholder="Search"
                                       oninput = "this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                                />
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <th scope="col"
                                            class="modal-title title-case"
                                            ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                            ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        Scheme Name
                                    </th>
                                    <th scope="col"
                                            class="modal-title title-case"
                                            ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                            ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr
                                        class="cp"
                                        ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemestatus"
                                        data-bs-dismiss="modal"
                                >

                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemestatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>


<!--panNo modal-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.panList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search"  minlength="4"
                                       maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                                <tr>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                                            ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        PAN NO
                                    </th>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                            ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        HOLDER NAME
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr
                                        class="cp"
                                        ng-repeat="x in vm.panList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.panNo= x.panNo;vm.holderName= x.holderName;"
                                        data-bs-dismiss="modal"
                                >
                                    <td>{{x.panNo}}</td>
                                    <td>{{x.holderName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.panList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>


<!--blaNo modal-->
<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
                <h4 class="modal-title">BLA No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search"  minlength="4"
                                       maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                                            ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        BLA NO
                                    </th>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                                            ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        PAN NO
                                    </th>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                            ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        HOLDER NAME
                                    </th>
                                    <th scope="col"
                                            ng-click="(sortedColumn == 'modeofHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                            ng-class="(sortedColumn == 'modeofHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                                    >
                                        MODE OF HOLDING
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr
                                        class="cp"
                                        ng-repeat="x in vm.blaList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.panNo= x.panNo;vm.holderName= x.holderName; vm.blaNo = x.blaNo;vm.modeofHolding = x.modeofHolding"
                                        data-bs-dismiss="modal"
                                >
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.panNo}}</td>
                                    <td>{{x.holderName}}</td>
                                    <td>{{x.modeofHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>