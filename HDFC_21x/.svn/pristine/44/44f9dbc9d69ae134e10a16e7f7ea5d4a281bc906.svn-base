            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">CAS Transfer Days (T+)</label>
                </div>
                <div class="col-sm-2">
                    <input type="number" class="form-control" id="casTranDays"
                        ng-model="vm.cbdtSchemeParameter.C049.oldValue" name="casTranDays" oninput="
              this.value = this.value
                .replace(/\s+/g, '')
                .replace(/^0$/, '')
                .slice(0, 1)
            " maxlength="1" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">PAN No required for Subscription Amount greater than Rs</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" inputmode="numeric" class="form-control" id="subscriptionAmount" maxlength="8"
                        oninput="this.value = this.value.replace(/[^\d]/g, '').slice(0, 8)" name="maxNoOfChallan"
                        ng-model="vm.cbdtSchemeParameter.C028.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Ceiling Amount without PAN</label>
