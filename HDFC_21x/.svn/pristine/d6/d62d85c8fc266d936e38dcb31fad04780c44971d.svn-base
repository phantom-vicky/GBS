package com.isl.gbm.cbs.integration.service;

import com.isl.gbm.cbs.integration.dto.SolDetailsIntegrationDto;

import java.util.List;

/**
 * The Interface SolDetailsIntegrationService.
 */
public interface SolDetailsIntegrationService {

    /**
     * Gets the bank branches details.
     *
     * @param bankCode   the bank code
     * @param branchCode the branch code
     * @param solId      the sol id
     * @return the bank branches details
     */
    public List<SolDetailsIntegrationDto> getBankBranchesDetails(String bankCode, String branchCode, String solId);

    /**
     * Gets the sol details.
     *
     * @param solId the sol id
     * @return the sol details
     */
    public List<SolDetailsIntegrationDto> getSolDetails(final String solId);

}
