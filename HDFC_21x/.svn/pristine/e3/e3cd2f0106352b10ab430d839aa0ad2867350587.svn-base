						<label class="data-bind" id="ismcpallowed" ng-if="vm.schemeType.ismcpallowed == 'Y'">YES</label>
						<label class="data-bind" id="ismcpallowed" ng-if="vm.schemeType.ismcpallowed == 'N'">NO</label>
					</td>
					<td></td>
				</tr>
				<tr>
					<td>
						<label for="isintersolmcp" class="control-label">Is Funds transfer to LC instead of FP permitted during MCP</label>
					</td>
					<td>
						<label class="data-bind" id="isintersolmcp" ng-if="vm.schemeType.isintersolmcp == 'Y'">YES</label>
						<label class="data-bind" id="isintersolmcp" ng-if="vm.schemeType.isintersolmcp == 'N'">NO</label>
					</td>
					<td></td>
				</tr>
				<tr ng-if="vm.schemeType.isintersolmcp == 'Y'">
					<td>
						<label for="ph_hoac" class="control-label">Head Office Account Place Holder (UP Country)</label>
					</td>
					<td><label class="data-bind" id="ph_hoac">{{vm.schemeType.ph_hoac}}</label></td>
					<td><label class="data-bind" id="ph_hoac_Description">{{vm.schemeDescription.ph_hoac}}</label></td>
				</tr>
				<tr ng-if="vm.schemeType.isintersolmcp == 'Y'">
