            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">CGST Rate For Brokerage (%)</label>
                </div>
                <div class="col-sm-2">
                    <!--                    <input type="text"  class="form-control" id="handlingCharges" name="handlingCharges"-->
