<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Nominee Continuation – Inquiry</h4>
    <sol-header></sol-header>
    <form name="customerMasterForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">

            <div class="row" >
                <div class="form-group">
                    <div class="col-sm-6">
                        <label class="control-label">Name of the Module</label>
                    </div>
                    <div class="col-sm-4">
                        <label >RBI Bond</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="schemeCode"
                               ng-model="vm.schemeName"
                               chars="alpha-numeric" readonly required>
                    </div>
                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                           id="treasurySearch"
                           ng-click="vm.getInquirySelectDetails('');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.schemeCode ='';vm.schemeName =''"></i>
                    </div>
                </div>
            </div>

            <!-- <div class="row" ng-if="!vm.flag">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="modeOfHolding" class="control-label">Nominee Mode of Holding</label>
                    </div>
                    <div class="col-sm-4">

                        <select class="form-control" id="modeOfHolding1" name="modeOfHolding"
                                ng-model="vm.modeOfHolding"  ng-change="vm.onModeOfHoldingChange()" required>
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="item in vm.modeOfHoldingList" value="{{item.SUBCODE}}"  ng-bind="item.DESCRIPTION || vm.moduleCode" ng-click="vm.pan_No1 ='';vm.pan_No2 ='';vm.pan_No3 ='';"></option>
                        </select>
                    </div>
                </div>
            </div> -->


            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label for="panNum" class="control-label">Main Holder PAN Number</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="panNum"
                               ng-model="vm.panNum" ng-init="vm.panNum = '';" ng-readonly="!vm.schemeCode"
                               chars="alpha-numeric" minlength="5" maxlength="10" oninput="this.value = this.value.replace(/\s+/g, '')">
                    </div>
                    <div class="col-sm-2"  ng-if="vm.panNum ||  vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getInquirySelectDetails('P');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNum ='';vm.blaNo ='';vm.boSubsId ='';vm.bondHolderName='';"></i>
                    </div>
                </div>
            </div>



            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="blaNo" class="control-label">Main Holder BLA No</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="blaNo"
                               ng-model="vm.blaNo" ng-init="vm.blaNo = '';" ng-readonly="!vm.schemeCode && !vm.panNum"
                               chars="only-numbers" minlength="5" maxlength="17"  required>
                    </div>
                    <div class="col-sm-2"  ng-if="vm.panNum || vm.blaNo && vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getInquirySelectDetails('B');vm.boSubsId ='';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNum ='';vm.blaNo ='';vm.boSubsId ='';vm.bondHolderName='';"></i>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="boSubsId" class="control-label">Main Holder Bond Subscription ID</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="boSubsId"
                               ng-model="vm.boSubsId" ng-init="vm.boSubsId = '';" readonly
                               chars="only-numbers"  minlength="5" maxlength="20" required>
                    </div>
                    <div class="col-sm-2"  ng-if="vm.blaNo && vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getInquirySelectDetails('S');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.boSubsId ='';vm.nominationDetails1='';vm.nominationDetails1=[];"></i>
                    </div>
                </div>
            </div>



            <div ng-if="vm.nominationDetails1.length > 0  && vm.boSubsId">
                <ng-form name ="vm.nominationDetailsForm">

                    <table id="nominee0" class="table table-bordered">
                        <tbody>

                        <tr>
                            <td colspan="4"><h4 class="form_heading">NOMINEE DETAILS</h4></td>
                        </tr>

                        <tr>
                            <td width="25%" class="form-group required">
                                <label class="control-label">Nominee BLA No</label></td>
                            <td width="25%"><input type="text" class="form-control" id="nomineeBlaNo[0]" chars="only-letters"
                                                   maxlength="50" name="nomineeBlaNo[0]"
                                                   ng-model="vm.nominationDetails1[0].nomineeBlaNo" required readonly></td>
                        </tr>


                        <tr>
                            <td width="25%" class="form-group required">
                                <label class="control-label">Subscription Id</label></td>
                            <td width="25%">
                                <input type="text" class="form-control" id="nomineeBoSubsId[0]"
                                       name="nomineeBoSubsId[0]" maxlength="20" chars="alpha-numeric"
                                       ng-model="vm.nominationDetails1[0].nomineeBoSubsId" required readonly>
                            </td>
                        </tr>



                        </tbody>
                    </table>




                </ng-form>
            </div>


            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ui-sref="rbi_bond_nominee_continuation.list_detail({obj:{
								schemeCode: vm.schemeCode,
								blaNo: vm.blaNo,
								schemeName: vm.schemeName,
								panNum: vm.panNum,
								bondHolderName: vm.bondHolderName,
								boSubsId: vm.boSubsId,
								nominationDetails1: vm.nominationDetails1
								}})"
                        ng-disabled="customerMasterForm.$invalid || vm.disableFlag">Submit</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel</button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>
<!-- Cust Id Details Start-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNum'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN NO</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN HOLDER NAME</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.panNum= x.panNum;vm.bondHolderName= x.bondHolderName;" data-bs-dismiss="modal">
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->

<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'schemeCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-show="false">Scheme Code</th>
                                    <th ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME NAME</th>
                                    <th ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">STATUS</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.schemeCode;vm.schemeName= x.schemeName;" data-bs-dismiss="modal">
                                    <td style="display: none;">{{x.schemeCode}}</td>
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->

<!-- Cust Id Details Start-->
<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search" chars="alpha-numeric">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA NO</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Pan Number</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaDataList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo= x.blaNo;vm.panNum=x.panNum;vm.bondHolderName= x.bondHolderName;" data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.panNum}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->



<!-- Cust Id Details Start-->
<div class="modal" id="subscriptionModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Subscription Id</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'boSubsId'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA NO</th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">HOLDER NAME</th>
                                    <th ng-click="(sortedColumn == 'boSubsId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'boSubsId';" ng-class="(sortedColumn == 'boSubsId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"> SUBSCRIPTION ID </th>
                                    <th ng-click="(sortedColumn == 'subscriptionAmount')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionAmount';" ng-class="(sortedColumn == 'subscriptionAmount')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SUBSCRIPTION AMOUNT</th>
                                   </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.subscriptionList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.boSubsId= x.boSubsId;vm.subscriptionAmount=x.subscriptionAmount;vm.getInquirySelectDetails('N');" data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.boSubsId}}</td>
                                    <td>{{x.subscriptionAmount}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>