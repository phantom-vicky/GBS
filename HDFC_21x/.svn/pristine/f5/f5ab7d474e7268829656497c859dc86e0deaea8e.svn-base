                            <th scope="col" colspan="5" style="text-align:center">CUMULATIVE</th>
                        </tr>
                        <tr class="thalign">
                            <th scope="col">S. No.</th>
                            <th scope="col">BLA No</th>
                            <th scope="col">Amount</th>
                            <th scope="col">CAS</th>
                            <th scope="col">DUE DATE</th>


                            <th scope="col">S. No.</th>
                            <th scope="col">BLA No</th>
                            <th scope="col">Amount</th>
                            <th scope="col">CAS</th>
                            <th scope="col">DUE DATE</th>
                        </tr>
                        </thead>

                        <tbody>
                        <tr ng-repeat="x in vm.mergedPartAList track by $index">
                            <td data-ng-if="vm.partANonCumulativeList.length>0">{{$index + 1 }}</td>
                            <td>{{ x.nonCumulative.aNcBlaNumber}}</td>
                            <td style="text-align:right">{{ x.nonCumulative.aNcAmount}}</td>
                            <td>{{ x.nonCumulative.aNcCas}}</td>
                            <td>{{ x.nonCumulative.aNcDueDate}}</td>
                            <td>{{ x.nonCumulative.aNcSch}}</td>
                            <td data-ng-if="vm.partACumulativeList.length>0">{{$index + 1 }}</td>
                            <td>{{ x.cumulative.aCBlaNumber}}</td>
                            <td style="text-align:right">{{ x.cumulative.aCAmount}}</td>
                            <td>{{ x.cumulative.aCCas}}</td>
                            <td>{{ x.cumulative.aCDueDate}}</td>
                        </tr>
                        <tr>
                            <td></td>
