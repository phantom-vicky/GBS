                                </tbody>
                                <tr>
                                    <td>Total (%)</td>
                                    <td> 100
                                    </td>
                                </tr>
                            </table>
                        </div>

                    </form>
                </uib-accordion>
            </div>
        </div>


    </div>

    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified By </b> : {{(vm.auditInfo.lastModifiedBy) ? (vm.auditInfo.lastModifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified By </b> : {{(vm.auditInfo.lastVerifiedBy) ? (vm.auditInfo.lastVerifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified On</b> : {{ (vm.auditInfo.lastModifiedDate) ? (vm.auditInfo.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified On </b> : {{(vm.auditInfo.lastVerifiedDate) ? (vm.auditInfo.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
            </div>
        </div>
    </div>

    <div class="text-center form_submit">
        <button type="button" id="otherpen_cancelButton" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
    </div>

</div>
