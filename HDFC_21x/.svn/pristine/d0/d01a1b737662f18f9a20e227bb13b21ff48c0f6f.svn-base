<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Subscription Workflow - Inquiry</h4>
    <sol-header></sol-header>


    <div class="tab-content">
        <div id="pensionmastersa" class="tab-pane fade in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="pensionMastersaForm" role="form" novalidate>

                        <div uib-accordion-group id="satreasury-details" class="panel"
                             heading="BOND HOLDER DETAILS" is-open="true"
                             ng-class="(vm.treasuryDetailsForm.$invalid) ? 'panel-danger' : 'panel-default'">
                            <ng-form name="vm.treasuryDetailsForm">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Name of the Bond Scheme</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.schemeName}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Mode Of Holding</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C004.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.modeOfHoldingList)}}</label>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getSubscriptionDetails.C003.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">BLA Number</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C003.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C005.oldValue}}</label>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getSubscriptionDetails.C006.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">First Joint Bond Holder BLA No.</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C006.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">First Joint Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C007.oldValue}}</label>
                                        </td>
                                    </tr>
                                    <tr ng-if="vm.getSubscriptionDetails.C008.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Second Joint Bond Holder BLA No.</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C008.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Second Joint Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getSubscriptionDetails.C009.oldValue}}</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Is NRI?</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{ 'N' | getLabelFromValuesArray : vm.commonYesNoMetaData}}</label>
                                        </td>
<!--                                        vm.getSubscriptionDetails.C010.oldValue-->
                                        <td width="25%" class="form-group">
<!--                                            <label class="control-label">Second Joint Bond Holder Name</label></td>-->
                                        <td width="25%">
<!--                                            <label class="control-label" >{{vm.getDetails.masterDetailsValueModel[0].C003.oldValue | getLabelFromValuesArray : vm.commonYesNoMetaData}}</label>-->
                                        </td>
                                    </tr>

                                    </tbody>
                                </table>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="sapensioner-details" class="panel panel-default"
                             heading="BOND SUBSCRIPTION  DETAILS">
                            <table class="table table-bordered table-striped list old-new-value-table">
                                <thead>
                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.auditInfo.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.auditInfo.previousOperationType == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>

                                <tr>
                                    <td>Application No</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C011)?
                                        (vm.getSubscriptionDetails.C011.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C011? (vm.getSubscriptionDetails.C011.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Application Date</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C012)?
                                        (vm.getSubscriptionDetails.C012.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C012? (vm.getSubscriptionDetails.C012.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Broker ID</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C013)?
                                        (vm.getSubscriptionDetails.C013.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C013? (vm.getSubscriptionDetails.C013.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Subscription Amount</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C014)?
                                        (vm.getSubscriptionDetails.C014.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C014? (vm.getSubscriptionDetails.C014.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bond Type</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C016)?
                                        (vm.getSubscriptionDetails.C016.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C016? (vm.getSubscriptionDetails.C016.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Account Open Date (dd/mm/yyyy)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C017)?
                                        (vm.getSubscriptionDetails.C017.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C017? (vm.getSubscriptionDetails.C017.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Value Date (dd/mm/yyyy)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C018)?
                                        (vm.getSubscriptionDetails.C018.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C018? (vm.getSubscriptionDetails.C018.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Period Of Deposit (months)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C019)?
                                        (vm.getSubscriptionDetails.C019.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C019? (vm.getSubscriptionDetails.C019.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Maturity Date (dd/mm/yyyy)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C020)?
                                        (vm.getSubscriptionDetails.C020.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C020? (vm.getSubscriptionDetails.C020.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Rate of Interest (%)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C021)?
                                        (vm.getSubscriptionDetails.C021.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C021? (vm.getSubscriptionDetails.C021.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Mode of Interest Payment/ Principal Repayment</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C022)?
                                        (vm.getSubscriptionDetails.C022.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.modeOfInterestPaymentList)) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C022? (vm.getSubscriptionDetails.C022.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.modeOfInterestPaymentList)) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Operative Account Number</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C023)?
                                        (vm.getSubscriptionDetails.C023.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C023? (vm.getSubscriptionDetails.C023.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>DD/PO Account Number</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C025)?
                                        (vm.getSubscriptionDetails.C025.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C025? (vm.getSubscriptionDetails.C025.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bank Code</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C026)?
                                        (vm.getSubscriptionDetails.C026.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C026? (vm.getSubscriptionDetails.C026.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Branch Code</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C027)?
                                        (vm.getSubscriptionDetails.C027.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C027? (vm.getSubscriptionDetails.C027.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>IFSC Code of the Credit Bank</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C028)?
                                        (vm.getSubscriptionDetails.C028.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C028? (vm.getSubscriptionDetails.C028.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Name of the Payee</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C029)?
                                        (vm.getSubscriptionDetails.C029.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C029? (vm.getSubscriptionDetails.C029.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Credit Account Number</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C030)?
                                        (vm.getSubscriptionDetails.C030.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C030? (vm.getSubscriptionDetails.C030.newValue) : ('')}}
                                    </td>
                                </tr>


                                </tbody>
                            </table>
                        </div>

                        <div uib-accordion-group id="sapensioner-details-two" class="panel panel-default"
                             heading="TRANSACTION DETAILS">
                            <table class="table table-bordered table-striped list old-new-value-table">
                                <thead>
                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.auditInfo.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.auditInfo.previousOperationType == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>

                                <tr>
                                    <td>Transaction Mode</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C031)?
                                        (vm.getSubscriptionDetails.C031.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.transactionModeList)) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C031? (vm.getSubscriptionDetails.C031.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.transactionModeList)) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Debit Account Number</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C032)?
                                        (vm.getSubscriptionDetails.C032.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C032? (vm.getSubscriptionDetails.C032.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Branch ID</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C051)?
                                        (vm.getSubscriptionDetails.C051.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C051? (vm.getSubscriptionDetails.C051.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Instrument Type</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C034)?
                                        (vm.getSubscriptionDetails.C034.oldValue | getLabelFromValuesArray : vm.instrumentTypeMetaData) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C034? (vm.getSubscriptionDetails.C034.newValue | getLabelFromValuesArray : vm.instrumentTypeMetaData) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Instrument Number</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C035)?
                                        (vm.getSubscriptionDetails.C035.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C035? (vm.getSubscriptionDetails.C035.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Instrument Date (dd/mm/yyyy)</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C036)?
                                        (vm.getSubscriptionDetails.C036.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C036? (vm.getSubscriptionDetails.C036.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Instrument Amount</td>
                                    <td class="old-value">{{(vm.getSubscriptionDetails && vm.getSubscriptionDetails.C037)?
                                        (vm.getSubscriptionDetails.C037.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{vm.getSubscriptionDetails &&
                                        vm.getSubscriptionDetails.C037? (vm.getSubscriptionDetails.C037.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr>
