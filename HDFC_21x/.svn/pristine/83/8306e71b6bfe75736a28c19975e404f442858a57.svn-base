                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C025)?
                                        (vm.getDetails.masterDetailsValueModel[0].C025.oldValue) : ('')}}
                                    </td>
