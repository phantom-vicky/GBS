<div class="container from_wrapper">
	<left-menu-directive></left-menu-directive>
	<h4 class="form_heading">EOD Status Inquiry</h3>
	<form name="eodStatusInquiryForm" role="form" ng-submit="submitForm(eodStatusInquiryForm.$valid)" novalidate>
	    <div class="form-group required">
		  <label for="solId" class ="control-label col-sm-2">Sol ID</label>
			<div class="col-sm-3 inner-addon "> 					  
			  <input type="text" class="form-control" id="solId" name="solId" value="01220/BANDRA KURLA COMPLEX" required>
			 
			</div>
			<div class="col-sm-2"></div>
		  	<label for="status" class ="control-label col-sm-2">Status</label>
			<div class="col-sm-3">
			  <select class="form-control" id="status" name="status" ng-model="eodStatusInquiry.status">
					<option  ng-selected= "{{item.status == eodStatusInquiry.status}}" ng-repeat="item in statusList" value="{{item.status}}">{{item.statusName}}</option>
				</select>
			<p ng-show="eodStatusInquiryForm.status.$invalid && !eodStatusInquiryForm.status.$pristine" class="help-block alert alert-danger">Maximum age is 60</p>
			</div>
		</div>
		<div class="form-group required">
		  <label for="fromDate" class ="control-label col-sm-2">EOD From Date</label>
			<div class="col-sm-3">
			  <input type="text" class="form-control" id="fromDate" name="fromDate" ng-model="eodStatusInquiry.fromDate" required>
			</div>
			<div class="col-sm-2"></div>
		  	<label for="toDate" class ="control-label col-sm-2">EOD To Date</label>
			<div class="col-sm-3">
			  <input type="text" class="form-control" id="toDate" name="toDate" ng-model="eodStatusInquiry.toDate" required>
			</div>
		</div>	
	 <div class="col-sm-offset-5 col-sm-8 form_submit">
		 <button type="submit" class="btn btn-default" ng-disabled="eodStatusInquiryForm.$invalid">Submit</button>
		 <button type="submit" class="btn btn-cancel">Cancel</button>
	   </div>
	</form>
</div>
	
