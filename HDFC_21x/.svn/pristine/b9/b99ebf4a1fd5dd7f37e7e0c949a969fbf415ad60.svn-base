<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container" ng-if="vm.responseResult.length>0">
    <div class="container from_wrapper new_form_wrapper">
        <div class="row">
            <h4 class="form_heading">Pre – Maturity Closure Marking – Inquiry</h4>
        </div>
        <sol-header></sol-header>
        <form name="preMaturityForm" role="form">
            <table class="table table-bordered">
                <tbody>
                <tr>
                    <td width="25%">Name of the Bond Scheme</td>
                    <td width="25%">
                        <label class="data-bind">{{vm.schemeName}}</label>
                    </td>
                    <td width="25%">Name of the Module</td>
                    <td width="25%">
                        <label class="data-bind"><b>RBI Bond</b></label>
                    </td>
                </tr>
                <tr>
                    <td width="25%">BLA No</td>
                    <td width="25%">
                        <label class="data-bind">{{vm.blaNo}}</label>
                    </td>
                </tr>
                </tbody>
            </table>
            <div class="row">
                <div class="col-sm-12">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                               ui-jq="dataTable" ui-options="vm.dataTableOption">
                            <thead>
                            <tr class="thalign">
                                <th>S.No</th>
                                <th>PAN No</th>
                                <th>Holder Name</th>
                                <th>Age</th>
                                <th>BLA Number</th>
                                <th>Mode Of Holding</th>
                                <th>Subscription Id</th>
                                <th>Account Open Date</th>
                                <th>Maturity Date</th>
                                <th>Subscription Amount</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr data-ng-repeat="x in vm.responseResult">
                                <td class="text-center">{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                                <td>{{x.panNo}}</td>
                                <td>{{x.holderName}}</td>
                                <td>{{x.age}}</td>
                                <td>{{x.blaNo}}</td>
                                <td>{{x.modeOfHolding}}</td>
                                <td>{{x.subsId}}</td>
                                <td>{{x.accOpenDate}}</td>
                                <td>{{x.maturityDate}}</td>
                                <td>{{x.subsAmt}}</td>
                            </tr>
                            </tbody>
                            <tfoot>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td>Total</td>
                                <td>{{vm.totalAmt}}</td>
                            </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <div class="text-center">
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/pre_maturity_closure_marking/action/inquiry'">Cancel</button>
            </div>
        </form>
    </div>
</div>
<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Pre – Maturity Closure Marking – Inquiry</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/pre_maturity_closure_marking/action/inquiry';">Back</button>
        </center>
    </div>
</div>