<style>
    .displayN{display:none}
    .displayB{display:block}
</style>
<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class=" from_wrapper new_form_wrapper" ng-class="vm.ftsDetailFetch == true ? 'container' : 'container-fluid'">
    <div class="col-lg-1" ></div>
    <div class="" style="overflow-y:scroll;height:500px" ng-class="vm.ftsDetailFetch == true ? '' : 'col-lg-5'">

    <h4 class="form_heading">BLA Opening Cum Subscription – Modify</h4>
    <sol-header></sol-header>

    <ul class="nav nav-tabs"  ng-init="vm.tabReferenceModify = 'customerMasterForm'">
        <li ng-class="{ 'active': vm.tabReferenceModify == 'customerMasterForm'}"><a ng-click="vm.tabReferenceModify ='customerMasterForm'">BLA Opening – Modify</a></li>
        <li ng-class="{ 'active': vm.tabReferenceModify == 'bondSubscriptionFlowForm'}"><a ng-click="vm.tabReferenceModify ='bondSubscriptionFlowForm'">BOND SUBSCRIPTION WORKFLOW - Modify</a></li>
    </ul>
    <div class="tab-content">


        <div id="customerMasterForm"  ng-show="vm.tabReferenceModify=='customerMasterForm'"  class="tab-pane fade in active">
            <div class="tab-body">

                <uib-accordion close-others="oneAtATime">
                    <form name="vm.customerMasterForm" role="form"
                          ng-submit="vm.modifycustomerMaster(vm.customerMasterForm.$valid)">
                        <div uib-accordion-group id="general-details"
                             class="panel-default panel panel-open"
                             heading="Bond Ledger Account Maintenance - Modify" is-open="true">

                            <div class="row">
                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">Mode of Holding
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >Joint - Jointly</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >Joint - Anyone or Survivor</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH004'" >HUF</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH005'" >Legal Guardian</label>
                                    </div>
                                    <label class="control-label col-sm-3">Name of the Bond Scheme</label>
                                    <div class="col-sm-3">
                                        :
                                        <label class="data-bind">{{vm.schemeName}}</label>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div uib-accordion-group id="personal-details" class="panel"
                             heading='{{vm.titleText}}'
                             is-open="vm.personalDetailsOpen"
                             ng-class="(vm.customerMasterForm.$invalid) ? 'panel-danger' : 'panel-success'">

                            <body name="vm.customerMasterForm" ng-if="vm.getDetails" >
                            <table class="table table-bordered">
                                <tbody>

                                <tr>
                                    <td width="25%" class="form-group required"  ng-if="vm.modeOfHolding != 'MH004'" >
                                        <label
                                            for="subscriberFirstName" class="control-label">Bond Holder First
                                        Name</label></td>
                                    <td width="25%" ng-if="vm.modeOfHolding != 'MH004'"><input type="text" class="form-control"
                                                           id="subscriberFirstName" name="customerFirstName"
                                                           maxlength="150"
                                                           ng-model="vm.customerMasterDetails.C006.oldValue"
                                                           ng-disabled="vm.operativeAc == 'Y'"
                                                           chars="only-letters"
                                                           required  oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"></td>

                                    <td width="25%" class="form-group required" ng-if="vm.modeOfHolding == 'MH004'">
                                        <label
                                            for="subscriberFirstName" class="control-label">Bond Holder Name</label></td>
                                    <td width="25%" ng-if="vm.modeOfHolding == 'MH004'"><input type="text" class="form-control"
                                                           id="subscriberFirstName" name="customerFirstName"
                                                           maxlength="150"
                                                           ng-model="vm.customerMasterDetails.C006.oldValue"
                                                                                               ng-init="vm.holderNameModify()"
                                                           ng-disabled="vm.operativeAc == 'Y'"
                                                           chars="only-letters-spsace"
                                                           required ></td>
                                    <td width="25%" ng-if="vm.modeOfHolding != 'MH004'">Bond Holder Middle Name</td>
                                    <td width="25%" ng-if="vm.modeOfHolding != 'MH004'"><input type="text" class="form-control"
                                                           id="subscriberMiddleName" name="customerMiddleName"
                                                           maxlength="150"
                                                           ng-model="vm.customerMasterDetails.C007.oldValue" chars="only-letters"  oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" ng-if="vm.modeOfHolding != 'MH004'"> Bond Holder Last Name</td>
                                    <td width="25%" ng-if="vm.modeOfHolding != 'MH004'"><input type="text" class="form-control"
                                                           id="subscriberLastName" name="customerLastName"
                                                           maxlength="150"
                                                           ng-model="vm.customerMasterDetails.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                    </td>

                                    <td width="25%" class="form-group required"><label
                                            class="control-label">Holder Type</label></td>
                                    <td width="25%">
                                        <select class="form-control"
                                                ng-model="vm.customerMasterDetails.C012.oldValue" ng-change="vm.getValidations(vm.customerMasterDetails.C012.oldValue);" required ng-disabled="vm.getDetails.verifiedStatus=='Y'"  maxlength="10">
                                            <option value="" hidden="true">Select</option>
                                            <!--                                        <option ng-repeat="item in vm.C009List" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                            <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                        </select>
                                    </td>

                                </tr>
                                <tr>
                                    <td width="25%"><label
                                            for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="fatherName" name="fatherName"
                                                           maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                           ng-model="vm.customerMasterDetails.C013.oldValue"
                                                           chars="only-letters" ng-disabled="vm.getDetails.verifiedStatus=='Y'"></td>
                                    <td width="25%">
                                        <label  class="control-label">Mother's Maiden Name</label>
                                    </td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="motherName" name="motherName"
                                                           maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                           ng-model="vm.customerMasterDetails.C014.oldValue" chars="only-letters" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Gender</label></td>
                                    <td width="25%"><select class="form-control" id="gender"
                                                            name="state" ng-model="vm.customerMasterDetails.C015.oldValue"
                                                            ng-required="!vm.customerMasterDetails.C015.oldValue">
                                        <option value="" hidden="true">Select</option>
                                        <option value="M" >MALE</option>
                                        <option value="F" >FEMALE</option>
                                        <option value="O" >OTHERS</option>
                                    </select></td>


                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Is Minor (Y/N)?</label></td>
                                    <td width="25%"><select class="form-control" id="isMinor" ng-init="vm.checkAge(vm.customerMasterDetails.C016.oldValue, vm.customerMasterDetails.C009.oldValue,'modify','1')"
                                                            name="isMinor" ng-model="vm.customerMasterDetails.C016.oldValue"
                                                            ng-change="vm.checkAge(vm.customerMasterDetails.C016.oldValue, vm.customerMasterDetails.C009.oldValue,'modify','1')"
                                                            required >
                                        <option value="">Select</option>
                                        <option value="Y"  ng-selected="vm.customerMasterDetails.C016.oldValue == 'Y'">YES</option>
                                        <option value="N" ng-selected="vm.customerMasterDetails.C016.oldValue == 'N'">NO</option>
                                    </select></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                    <td width="25%">
                                        <p class="input-group" >
                                            <input type="text" class="form-control" id="bondHolderDateOfBirth12"
                                                   name="dateofBirth"
                                                   ng-model="vm.customerMasterDetails.C009.oldValue"
                                                   ng-change="vm.checkAge(vm.customerMasterDetails.C016.oldValue, vm.customerMasterDetails.C009.oldValue,'modify','1')"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.retirDatePickerValidation"
                                                   is-open="vm.dateOptions.opened"
                                                   close-text="Close" maxlength="10"
                                                   ng-blur="vm.textableDatePicker('bondHolderDateOfBirth12',vm.customerMasterDetails.C009.oldValue)"
                                                   ng-keyup="vm.autoslashing('bondHolderDateOfBirth12')" chars="numbers-slash"

                                                   required>
                                            <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                        </p>
                                    </td>
                                    <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C016.oldValue == 'Y'}"><label
                                            for="birthCertificateNo1" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="birthCertificateNo1" name="birthCertificateNo" ng-model="vm.customerMasterDetails.C017.oldValue"
                                                           maxlength="30" chars="letters" ng-required="vm.customerMasterDetails.C016.oldValue == 'Y'" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                    </td>


                                </tr>
                                </tr>
                                <tr>

                                    <td width="25%" class="form-group required"><label
                                            for="address1" class="control-label">Communication Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address1" name="address1" ng-model="vm.customerMasterDetails.C018.oldValue"
                                                           maxlength="200"
                                                           required  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                    <td width="25%" ><label
                                            for="address2" class="control-label">Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address2" name="address2"
                                                           ng-model="vm.customerMasterDetails.C019.oldValue" maxlength="200"
                                                           ng-init="vm.tempPresentPremise = vm.presentPremise"   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                </tr>
                                <tr>

                                    <td width="25%" ><label
                                            for="presentFlat" class="control-label">Address 3</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetails.C020.oldValue"
                                                           maxlength="200"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                    <td width="25%"  class="form-group required">
                                        <label class="control-label">City</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                           ng-model="vm.customerMasterDetails.C022.oldValue"  required></td>

                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">State</label></td>
                                    <td width="25%"><select class="form-control" id="state"
                                                            name="state" ng-model="vm.customerMasterDetails.C023.oldValue"
                                                            ng-init="vm.getState()" required>
                                        <option value="" hidden="true">Select State</option>
                                        <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                    </select></td>

                                    <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                           ng-model="vm.customerMasterDetails.C021.oldValue"  ng-blur="vm.getModAddressOne(vm.customerMasterDetails.C021.oldValue)"
                                                           onkeypress="return isNumber(event)" required></td>

                                </tr>
                                <tr>
                                    <td width="25%">Phone Number</td>
                                    <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                           id="saphoneNum" ng-model="vm.customerMasterDetails.C024.oldValue"
                                                           chars="numbers-with-special-characters" ></td>

                                    <td width="25%">Mobile Number</td>
                                    <td width="25%">
                                        <input type="text" class="form-control" minlength="10" maxlength="35"
                                               id="mobileNumber" ng-model="vm.customerMasterDetails.C025.oldValue"
                                               chars="numbers-with-special-characters"></td>


                                </tr>

                                <tr>

                                    <td width="25%" class="form-group"><label
                                            for="emailId" class="control-label">Email Id</label></td>
                                    <td width="25%" ><input type="text" class="form-control"
                                                            id="emailId" name="emailId" maxlength="50"
                                                            ng-model="vm.customerMasterDetails.C026.oldValue" ng-pattern="vm.emailPattern" chars="email"  oninput="this.value = this.value.replace(/\s+/g, '')">
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.C012.oldValue == 'HT001' || vm.customerMasterDetails.C012.oldValue == 'HT002')">
                                        <label for="powerOfattorneyNo" class="control-label"> HUF registration / Power of Attorney number</label>
                                    </td>



                                    <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.C012.oldValue == 'HT001' || vm.customerMasterDetails.C012.oldValue == 'HT002')">
                                        <input type="text" class="form-control" minlength="1" maxlength="20" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               id="powerOfattorneyNo" ng-model="vm.customerMasterDetails.C027.oldValue" chars="alpha-numeric"
                                               readonly></td>

                                </tr>


                                <tr >
                                    <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.C012.oldValue == 'HT001' || vm.customerMasterDetails.C012.oldValue == 'HT002')">
                                        <label for="kartaName" class="control-label ">Power of Attorney/Karta Name</label>
                                    </td>


                                    <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.C012.oldValue == 'HT001' || vm.customerMasterDetails.C012.oldValue == 'HT002')">
                                        <input type="text" class="form-control" minlength="1" maxlength="70"
                                               id="kartaName" ng-model="vm.customerMasterDetails.C028.oldValue">
                                    </td>



<!--                                    ng-disabled="vm.getDetails.verifiedStatus=='Y'"-->
                                </tr>



                                </tbody>
                            </table>

                            <table class="table table-bordered table-striped list old-new-value-table" ng-if="vm.modeOfHolding === 'MH004'">
                                <thead>
                                <tr>
                                    <td colspan="4">
                                        <h4 class="form_heading">Coparceners Details of Karta</h4>
                                    </td>
                                </tr>
                                </thead>
                                <tbody>
                                <tr ng-repeat="item in vm.getDetails.coparsDetailsValueModel track by $index">
                                    <td>
                                        <label class="control-label">Co-Person Name{{$index+1}} <span class="text-danger"> * </span></label>
                                        <input type="text" class="form-control required"
                                               id="coparcenersName{{$index}}" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="item.C004.oldValue" required
                                               readonly>
                                    </td>
                                    <td>
                                        <label class="control-label">Relationship with Karta{{$index+1}}</label>
                                        <!--{{(item && item.C005)?
                                        vm.getGuardianRelationName(item.C005.oldValue) : ('-')}}-->
                                        <input type="text" class="form-control"
                                               id="coparcenersRelation{{$index}}" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="item.C005.oldValue"   ng-value="vm.getGuardianRelationName(item.C005.oldValue)"
                                               readonly>
                                    </td>
                                    <td>
                                        <label class="control-label">DOB {{$index+1}}</label>
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="coparcenersDob{{$index}}"
                                                   name="coparcenersDob[$index]"
                                                   ng-model="item.C006.oldValue"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   ng-init="vm.dateOfBirthOptionsFunc();"
                                                   datepicker-options="vm.dateOfBirthOptions"
                                                   is-open="item.dateOfBirthOptions.opened"
                                                   close-text="Close" maxlength="10"
                                                   ng-blur="vm.textableDatePickerManual('coparcenersDob' + $index, item.C006.oldValue,item);vm.minorChecking('coparcenersDob' + $index, item.C006.oldValue,item);"
                                                   ng-keyup="vm.autoslashing('coparcenersDob' + $index )" chars="numbers-slash"
                                            >
                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="item.dateOfBirthOptions.opened = true"
                                id="nomineeDateOfBirthOptions">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                       <!-- <input type="text" class="form-control"
                                               id="coparcenersDob{{$index}}" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="item.C006.oldValue"
                                               >-->
                                </tr>
                                </tbody>
                            </table>




                            <h4 class="form_heading" ng-if="vm.customerMasterDetails.C016.oldValue=='Y'">GUARDIAN DETAILS</h4>
                            <div class="col-sm-12 text-right form_submit" ng-if="vm.customerMasterDetails.C016.oldValue=='Y'" ng-show="vm.isDateEntered()">
                                <div class="row">
                                    <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addGuardian()">
                                        <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                    </a>
                                    <a data-href="#" type="button" class="btn btn-danger" ng-click="vm.deleteGuardian()">
                                        <i class="glyphicon glyphicon-trash"></i> Delete
                                    </a>
                                </div>
                            </div>
                            <table class="table table-bordered" ng-if="vm.customerMasterDetails.C016.oldValue=='Y'">
                                <tbody>
                                <!-- Guardian Id -->
                                <tr>
                                    <td width="25%">
                                        <label for="guardianId" class="control-label">Guardian Id</label>
                                    </td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="guardianId"
                                                       name="guardianId"
                                                       ng-model="vm.guardianDetailsValueModel.C005.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            </div>
                                            <div class="col-sm-3 torch-top" ng-class="{ 'disabled': vm.getDetails.verifiedStatus === 'Y' }">
                                                <i class="glyphicon glyphicon-search cp"
                                                   data-bs-toggle="modal"
                                                   ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.getGuardianDetails('select');"
                                                   id="guardianIdSearcher"></i>
                                                <i class="glyphicon glyphicon-remove clear cp"
                                                   ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.clearGuardianDetails()"
                                                   id="guardianIdClose"></i>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Guardian Names -->
                                    <td width="25%" class="form-group required">
                                        <label for="guardianFirstName" class="control-label">Guardian First Name</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="guardianFirstName" name="guardianFirstName"
                                               maxlength="150" ng-model="vm.guardianDetailsValueModel.C006.oldValue"
                                               chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
                                               required>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%">
                                        Guardian Middle Name
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="guardianMiddleName" name="guardianMiddleName" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                               maxlength="150" ng-model="vm.guardianDetailsValueModel.C007.oldValue" chars="only-letters" >
                                    </td>
                                    <td width="25%">
                                        Guardian Last Name
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="guardianLastName" name="guardianLastName" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')"
                                               maxlength="150" ng-model="vm.guardianDetailsValueModel.C008.oldValue" chars="only-letters" >
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Relation with minor</label>
                                    </td>
                                    <td width="25%">
                                        <select class="form-control" id="relationWithMinor" name="relationWithMinor"
                                                ng-model="vm.guardianDetailsValueModel.C009.oldValue" required>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Date of Birth</label>
                                    </td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="guardianDateOfBirth1" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   name="guardianDateOfBirth" ng-model="vm.guardianDetailsValueModel.C010.oldValue"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.dobCalenderOptions"
                                                   is-open="vm.submissionfifteenGHPicker.opened" close-text="Close"


                                            >
                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.submissionfifteenGHPicker.opened = true"
                                id="submissionfifteenGHSearcher">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label for="address1" class="control-label">Communication Address</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="guardianAddress" name="guardianAddress"
                                               ng-model="vm.guardianDetailsValueModel.C011.oldValue" maxlength="200" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                    </td>
                                    <td width="25%">
                                        Mobile Number
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" minlength="10" maxlength="35"
                                               id="guardianMobileNumber" ng-model="vm.guardianDetailsValueModel.C012.oldValue"
                                               chars="numbers-with-special-characters" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label for="emailId" class="control-label">Email Id</label>
                                    </td>
                                    <td width="25%">
                                        <input type="email" class="form-control" id="guardianEmailId" name="guardianEmailId"
                                               maxlength="100" ng-model="vm.guardianDetailsValueModel.C013.oldValue" ng-pattern="vm.emailPattern"
                                               chars="email" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                        <span class="text-danger" ng-show="vm.customerMasterForm.emailId.$error.pattern">
                    Enter valid email address
                </span>
                                    </td>
                                </tr>
                                <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                    <td width="25%">
                                        <label for="dateOfDeathOfGuardian">Date of Death of Guardian<br>(DD/MM/YYYY)</label>
                                    </td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="dateOfDeathOfGuardian"
                                                   name="dateOfDeathOfGuardian" ng-model="vm.guardianDetailsValueModel.C014.oldValue"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.dobCalenderOptions"

                                                   is-open="vm.dateOfDeathOfGuardianPicker.opened" close-text="Close" maxlength="10"


                                                   ng-blur="vm.textableDatePicker('dateOfDeathOfGuardian',vm.guardianDetailsValueModel.C014.oldValue)"
                                                   ng-keyup="vm.autoslashing('dateOfDeathOfGuardian')" chars="numbers-slash"
                                            >
                                            <span class="input-group-btn">
                <button type="button" class="btn btn-secondary"
                        ng-click="vm.dateOfDeathOfGuardianPicker.opened = true"
                        id="dateOfDeathOfGuardianPicker">
                    <i class="glyphicon glyphicon-calendar"></i>
                </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>

                                <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                    <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel.C014.oldValue}">
                                        <label class="control-label">Date of Receipt of Death Certificate <br>(DD/MM/YYYY)</label>
                                    </td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="dateOfReceiptOfDeathCertificateThree1"
                                                   name="dateOfReceiptOfDeathCertificate"
                                                   ng-model="vm.guardianDetailsValueModel.C015.oldValue"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.dobCalenderOptions"
                                                   is-open="vm.dateOfReceiptOfDeathCertificateThreeOption.opened"
                                                   ng-required="vm.guardianDetailsValueModel.C014.oldValue"
                                                   ng-blur="vm.textableDatePicker('dateOfReceiptOfDeathCertificateThree1',vm.guardianDetailsValueModel.C015.oldValue)"
                                                   ng-keyup="vm.autoslashing('dateOfReceiptOfDeathCertificateThree1')" chars="numbers-slash"
                                                   close-text="Close" maxlength="10" >
                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfReceiptOfDeathCertificateThreeOption.opened = true"
                                id="dateOfReceiptOfDeathCertificateThreeOption">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>

                                <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                    <td width="25%" class="form-group">
                                        <label class="control-label">If Request from Current Guardian (Y/N)</label>
                                    </td>
                                    <td width="25%">
                                        <input type="radio" id="currentGuardianY" name="currentGuardian" ng-model="vm.guardianDetailsValueModel.C016.oldValue"  value="Y">Yes
                                        <input type="radio" id="currentGuardianN" name="currentGuardian" ng-model="vm.guardianDetailsValueModel.C016.oldValue"  value="N">No
                                    </td>

                                    <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel.C016.oldValue === 'Y'}">
                                        <label for="subscriberFirstName" class="control-label">Remarks</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="C026" name="C026"
                                               maxlength="200"
                                               ng-model="vm.guardianDetailsValueModel.C017.oldValue"
                                               ng-required="vm.guardianDetailsValueModel.C016.oldValue=='Y'"
                                               oninput="this.value = this.value.replace(/^\s/, '')">
                                    </td>
                                </tr>
                                </tbody>
                            </table>


                            <table class="table table-bordered table-striped" ng-if="vm.showGuardianDetails">
                                <tbody>
                                <tr>
                                    <td colspan="4"><h4 class="form_heading">GUARDIAN DETAILS {{$index + 1}}</h4></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label for="guardianId{{$index}}">Guardian Id</label>
                                    </td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="guardianId{{$index}}" ng-init="vm.getDetails.guardianDetailsValueModel.C005.oldValue= ''"
                                                       name="guardianId{{$index}}"
                                                       ng-model="vm.guardianDetailsValueModelOne.C005.oldValue">
                                            </div>
                                            <div class="col-sm-3 torch-top">
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                <i class="glyphicon glyphicon-remove clear cp"
                                                   ng-click=
                                                           "vm.getDetails.guardianDetailsValueModel.C005.oldValue = '';
                                               vm.getDetails.guardianDetailsValueModel.C006.oldValue= '';
                                               vm.getDetails.guardianDetailsValueModel.C007.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C008.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C009.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C010.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C011.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C012.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C013.oldValue=''; " id="guardianIdClose"></i>
                                            </div>
                                        </div>
                                    </td>

                                    <td width="25%" class="form-group required">
                                        <label for="guardianFirstName{{$index}}">Guardian First Name</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="guardianFirstName{{$index}}" name="guardianFirstName{{$index}}"
                                               maxlength="150"
                                               ng-model="vm.guardianDetailsValueModelOne.C006.oldValue"
                                               chars="only-letters" required  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
                                        >
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%">
                                        <label for="guardianMiddleName{{$index}}">Guardian Middle Name</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="guardianMiddleName{{$index}}" name="guardianMiddleName{{$index}}"
                                               maxlength="150"
                                               ng-model="vm.guardianDetailsValueModelOne.C007.oldValue" chars="only-letters"  oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                    </td>

                                    <td width="25%">
                                        <label for="guardianLastName{{$index}}">Guardian Last Name</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="guardianLastName{{$index}}" name="guardianLastName{{$index}}"
                                               maxlength="150"
                                               ng-model="vm.guardianDetailsValueModelOne.C008.oldValue" chars="only-letters"  oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label for="relationWithMinor{{$index}}">Relation with Minor</label>
                                    </td>
                                    <td width="25%">
                                        <select class="form-control" id="relationWithMinor{{$index}}"
                                                name="relationWithMinor{{$index}}" ng-model="vm.guardianDetailsValueModelOne.C009.oldValue" ng-init="vm.getDetails.guardianDetailsValueModel.C009.oldValue= ''"
                                                required>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>

                                    <td width="25%">
                                        <label for="guardianDateOfBirth{{$index}}">Date of Birth</label>
                                    </td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="guardianDateOfBirth1{{$index}}" ng-init="vm.getDetails.guardianDetailsValueModel.C010.oldValue= ''"
                                                   name="guardianDateOfBirth{{$index}}" ng-model="vm.guardianDetailsValueModelOne.C010.oldValue"
                                                   uib-datepicker-popup="dd/MM/yyyy" ng-blur="vm.textableDatePicker('guardianDateOfBirth1{{$index}










                                                   ]',vm.guardianDetailsValueModelOne.C010.oldValue)"
                                                   ng-keyup="vm.autoslashing('effToDate')" chars="numbers-slash"
                                                   datepicker-options="vm.dobCalenderOptions"
                                                   is-open="vm.dateOfBirthPicker.opened" close-text="Close" maxlength="10" >
                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfBirthPicker.opened = true"
                                id="dateOfBirthPicker{{$index}}">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%">
                                        <label for="guardianAddress{{$index}}">Communication Address</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="guardianAddress{{$index}}" name="guardianAddress{{$index}}"  ng-model="vm.guardianDetailsValueModelOne.C011.oldValue"
                                               maxlength="200"  oninput="this.value = this.value.replace(/\s+/g, '')">
                                    </td>

                                    <td width="25%">
                                        <label for="guardianMobileNumber{{$index}}">Mobile Number</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control" minlength="10" maxlength="35"
                                               id="guardianMobileNumber{{$index}}" ng-model="vm.guardianDetailsValueModelOne.C012.oldValue" ng-init="vm.getDetails.guardianDetailsValueModel.C012.oldValue= ''"
                                               chars="numbers-with-special-characters" >
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%">
                                        <label for="guardianEmailId{{$index}}">Email Id</label>
                                    </td>
                                    <td width="25%">
                                        <input type="email" class="form-control"
                                               id="guardianEmailId{{$index}}" name="guardianEmailId{{$index}}" maxlength="100" ng-init="vm.getDetails.guardianDetailsValueModel.C013.oldValue= ''"
                                               ng-model="vm.guardianDetailsValueModelOne.C013.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId{{$index}}.$error.pattern">Enter valid email address</span>
                                    </td>
                                </tr>


                                </tbody>
                            </table>




                            <h4 class="form_heading">Interest Payout Account Details</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label break-word">Whether the customer belongs to HDFC?</label>
                                    </td>
                                    <td width="25%">
                                        <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.C029.oldValue" value="Y" ng-change="vm.handleHdfcSelection()"> Yes
                                        <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.C029.oldValue" value="N" ng-change="vm.handleHdfcSelection()"> No
                                    </td>

                                    <!-- Conditionally render the following elements if customer belongs to HDFC -->
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C029.oldValue === 'Y'">
                                        <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C029.oldValue === 'Y'">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" minlength="9"
                                               ng-model="vm.customerMasterDetails.C030.oldValue"
                                               ng-required="vm.customerMasterDetails.C029.oldValue === 'Y'"
                                               oninput="this.value = this.value.replace(/\s+/g, '')">
                                        <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C029.oldValue === 'Y'">
                                        <button type="button" class="btn btn-primary"

                                                ng-disabled="!vm.customerMasterDetails.C030.oldValue">
                                            Fetch
                                        </button>
                                    </td>
                                </tr>





                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label break-word">Mode of Interest Payment/ Principal Repayment</label>
                                    </td>
                                    <td width="25%">
                                        <select class="form-control" id="modeOfInterestPayment" ng-init=""
                                                name="modeOfInterestPayment" ng-model="vm.customerMasterDetails.C049.oldValue" ng-change="vm.modeOfInterestPaymentValidation(vm.customerMasterDetails.C049);"
                                                required>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.modeOfInterestPaymentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>

                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C049.oldValue == 'MP001'">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C049.oldValue == 'MP001'">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20"

                                               ng-model="vm.customerMasterDetails.C053.oldValue" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                        <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                    </td>

                                </tr>

                                <tr>
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C049.oldValue == 'MP001'">
                                        <label class="control-label">Account Type code</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C049.oldValue == 'MP001'">
                                        <select class="form-control" id="accountType"
                                                name="accountType" ng-model="vm.customerMasterDetails.C055.oldValue"
                                                required>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.accountTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>
                                </tr>

                                <tr>

                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C049.oldValue == 'MP002'">
                                        <label class="control-label">DD/PO Account Number</label></td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C049.oldValue== 'MP002'">
                                        <input type="text" class="form-control"
                                               id="ddpoAccountNo" name="ddpoAccountNo" chars="alpha-numeric" maxlength="20"
                                               ng-model="vm.customerMasterDetails.C053.oldValue" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                    </td>
                                </tr>

                                    <tr ng-if="vm.customerMasterDetails.C049.oldValue == 'MP003' || vm.customerMasterDetails.C049.oldValue == 'MP004'">
                                        <td width="25%" class="form-group" >
                                            <label class="control-labelaria-controls">Bank Name</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="bankCode"
                                                           name="bankCode"
                                                           ng-model="vm.bankName"
                                                           chars="alpha-numeric" readonly>
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="otherBankSearcher"
                                                       ng-click="vm.getOtherBankDetailsTorchM('bankName');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.C050.oldValue='';vm.customerMasterDetails.C051.oldValue=''"></i>
                                                </div>
                                            </div>

                                    </td>

                                    <!--                                        <td width="25%" class="form-group required">-->
                                    <!--                                            <label class="control-label">Branch Code</label></td>-->
                                    <!--                                        <td width="25%">-->
                                    <!--                                            <input type="text" class="form-control"-->
                                    <!--                                                   id="branchCode" name="branchCode" chars="alpha-numeric" maxlength="20"-->
                                    <!--                                                   ng-model="vm.customerMasterDetails.C051.oldValue" disabled readonly required>-->
                                    <!--                                            <div class="col-sm-3 torch-top" ng-if="vm.customerMasterDetails.C050.oldValue">-->
                                    <!--                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                    <!--                                                   id="branchCode"-->
                                    <!--                                                   ng-click="vm.getOtherBankDetailsTorch('branchCode');"></i> <i-->
                                    <!--                                                    class="glyphicon glyphicon-remove clear cp"-->
                                    <!--                                                    ng-click="vm.customerMasterDetails.C051.oldValue='';"></i>-->
                                    <!--                                            </div>-->
                                    <!--                                        </td>-->


                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Branch Code</label></td>
<!--                                        <td width="25%">-->
<!--                                            <div class="row">-->
<!--                                                <div class="col-sm-9">-->
<!--                                                    <input type="text" class="form-control" id="branchCode"-->
<!--                                                           name="branchCodeNonMicr"-->
<!--                                                           ng-model="vm.customerMasterDetails.C051.oldValue"-->
<!--                                                           chars="alpha-numeric" disabled readonly required>-->
<!--                                                </div>-->
<!--                                                <div class="col-sm-3 torch-top" ng-if="vm.customerMasterDetails.C050.oldValue">-->
<!--                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
<!--                                                       id="branchCode"-->
<!--                                                       ng-click="vm.getOtherBankDetailsTorchM('branchCode');"></i> <i-->
<!--                                                        class="glyphicon glyphicon-remove clear cp"-->
<!--                                                        ng-click="vm.customerMasterDetails.C051.oldValue='';"></i>-->
<!--                                                </div>-->
<!--                                            </div>-->
<!--                                        </td>-->
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                            <input type="text" class="form-control"
                                                   id="branchCodeNonMicr" name="branchCodeNonMicr" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.customerMasterDetails.C051.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="micrBranchCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorchM('micrBranchCode');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.C051.oldValue='';"></i>
                                                </div>
                                            </div> </td>
                                    </tr>


                                    <tr ng-if="vm.customerMasterDetails.C049.oldValue == 'MP003'">
                                        <td width="25%">
                                            <label class="control-label">IFSC Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control"
                                                           id="aadharNum" chars="alpha-numeric" minlength="11" maxlength="11"
                                                           name="ifscCode" ng-model="vm.customerMasterDetails.C031.oldValue"
                                                           required oninput="this.value = this.value.replace(/\s+/g, '')">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="instIfscCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorchM('ifsc');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.C031.oldValue='';"></i>
                                                </div>
                                            </div>  </td>

                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Name of the Payee</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="nameOfthePayee" name="nameOfthePayee" chars="only-letters" maxlength="150" ng-init="vm.customerMasterDetails.C052.oldValue = vm.bondHolderName"
                                               ng-model="vm.customerMasterDetails.C052.oldValue" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                    </td>
                                </tr>

                                <tr ng-if="vm.customerMasterDetails.C049.oldValue == 'MP003'">
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Credit Account Number</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="creditAccNo" name="creditAccNo" chars="alpha-numeric" maxlength="20"
                                               ng-model="vm.customerMasterDetails.C053.oldValue" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                    </td>

                                    <tr ng-if="vm.customerMasterDetails.C049.oldValue == 'MP004'">
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Operative Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.customerMasterDetails.C053.oldValue" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">IFSC Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                            <input type="text" class="form-control"
                                                   id="ifscCode" chars="alpha-numeric" minlength="11" maxlength="11"
                                                   ng-required="!vm.customerMasterDetails.C054.oldValue"
                                                   name="ifscCode" ng-model="vm.customerMasterDetails.C031.oldValue"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="instIfscCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorchM('ifsc');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.C031.oldValue='';"></i>
                                                </div>
                                            </div>  </td>
                                    </tr>
                                    <tr ng-if="vm.customerMasterDetails.C049.oldValue == 'MP004'">

                                        <td width="25%">
                                            <label class="control-label">Micr Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                            <input type="text" class="form-control"
                                                   id="micrCode" chars="alpha-numeric" minlength="9" maxlength="9"
                                                   ng-required="!vm.customerMasterDetails.C031.oldValue"
                                                   name="micrCode" ng-model="vm.customerMasterDetails.C054.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="micrBankCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorchM('micrCodeBank');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.C054.oldValue='';"></i>
                                                </div>
                                            </div></td>
                                    </tr>

                                <tr>
                                    <td width="25%" class="form-group required">Pan No</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="panNum" minlength="10" maxlength="10"
                                                           ng-change="vm.validatePanLetterM(vm.customerMasterDetails.C002.oldValue);"
                                                           onkeypress="return isNumber(event)" chars="alpha-numeric" required
                                                           ng-pattern="/[A-Z]{5}[0-9]{4}[A-Z]{1}/"
                                                           name="panNum" ng-model="vm.customerMasterDetails.C002.oldValue" oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
                                        <span class="text-danger" ng-show="vm.validationMessages">{{ vm.validationMessages }}</span></td>
                                </tr>
                                </tbody>
                            </table>
                            <h4 class="form_heading">WITNESS DETAILS</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameOne" name="witnessNameOne"
                                                           maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           ng-model="vm.customerMasterDetails.C033.oldValue"
                                                           chars="only-letters"></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           id="witnessAddressOne" name="witnessAddressOne"
                                                           maxlength="200"
                                                           ng-model="vm.customerMasterDetails.C034.oldValue"></td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameTwo" name="witnessNameTwo"
                                                           maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           ng-model="vm.customerMasterDetails.C035.oldValue"
                                                           chars="only-letters"></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           id="witnessAddressTwo" name="witnessAddressTwo"
                                                           maxlength="200"
                                                           ng-model="vm.customerMasterDetails.C036.oldValue"></td>
                                </tr>

                                </tbody>
                            </table>
                            <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                            <table class="table table-bordered">
                                <div class="col-md-12 map-div">
                                    <input type="checkbox" id="birthCertificate" name="birthCertificate"
                                           ng-model="vm.customerMasterDetails.C037.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="birthCertificate">Birth Certificate</label><br>

                                    <input type="checkbox" id="passport" name="passport"
                                           ng-model="vm.customerMasterDetails.C038.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="passport">Passport</label><br>

                                    <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard"
                                           ng-model="vm.customerMasterDetails.C039.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="seniorCitizenCard">Senior Citizen Card</label><br>

                                    <input type="checkbox" id="voterId" name="voterId"
                                           ng-model="vm.customerMasterDetails.C040.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="voterId">Voter ID Card</label><br>

                                    <input type="checkbox" id="panCard" name="panCard"
                                           ng-model="vm.customerMasterDetails.C041.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="panCard">Pan Card</label><br>

                                    <input type="checkbox" id="drivingLicence" name="drivingLicence"
                                           ng-model="vm.customerMasterDetails.C042.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="drivingLicence">Driving Licence</label><br>

                                    <input type="checkbox" id="rationCard" name="rationCard"
                                           ng-model="vm.customerMasterDetails.C043.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="rationCard">Ration Card</label><br>

                                    <input type="checkbox" id="others" name="others"
                                           ng-model="vm.customerMasterDetails.C044.oldValue"
                                           ng-true-value="'Y'" ng-false-value="'N'">
                                    <label for="others">Others</label><br>
                                </div>




                                <tr>

                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C044.oldValue === 'Y'">
                                        <label class="control-label">Details for Others</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.C044.oldValue === 'Y'">
                                        <input type="text" class="form-control"
                                               id="otherDetails" name="remarks"
                                               maxlength="200"
                                               ng-model="vm.customerMasterDetails.C045.oldValue"
                                                required oninput="this.value = this.value.replace(/^\s/, '')">
                                    </td>


                                    <td width="25%" class="form-group">
                                        <label class="control-label">Remarks</label>
                                    </td>
                                    <td width="25%" >
                                        <input type="text" class="form-control"
                                               id="remarks" name="remarks"
                                               maxlength="200"
                                               ng-model="vm.customerMasterDetails.C046.oldValue" oninput="this.value = this.value.replace(/^\s/, '')">
                                    </td>
                                </tr>

                            </table>

                            </ng-form>
                            </body>
                        </div>

                        <div uib-accordion-group id="joint-personal-details" class="panel"
                             heading="SECOND JOINT ACCOUNT HOLDER DETAILS"
                             is-open="vm.secondHolderDetails"
                             ng-class="(vm.secondJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.getDetails.masterDetailsValueModel.length >= 2">
                            <ng-form name="vm.secondJoinAccountHolderDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Bond Second Holder First
                                            Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberFirstName" name="customerFirstName"
                                                               maxlength="50"
                                                               ng-model="vm.customerMasterDetailsTwo.C006.oldValue"
                                                               ng-disabled="vm.operativeAc == 'Y'"
                                                               chars="only-letters"
                                                               required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"></td>
                                        <td width="25%">Bond Second Holder Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberMiddleName" name="customerMiddleName"
                                                               maxlength="50"
                                                               ng-model="vm.customerMasterDetailsTwo.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">Bond Second Holder Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberLastName" name="customerLastName"
                                                               maxlength="50"
                                                               ng-model="vm.customerMasterDetailsTwo.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                        <td width="25%" class="form-group"><label
                                                class="control-label">Holder Type</label></td>
                                        <td width="25%">
                                            <select class="form-control"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    ng-model="vm.customerMasterDetailsTwo.C012.oldValue" ng-change="vm.getValidations(vm.customerMasterDetailsTwo.C012.oldValue);">
                                                <option value="" hidden="true">Select</option>
                                                <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label
                                                for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="fatherName" name="fatherName" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                               ng-model="vm.customerMasterDetailsTwo.C013.oldValue"
                                                               chars="only-letters" readonly></td>
                                        <td width="25%">
                                            <label  class="control-label">Mother's Maiden Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="motherName" name="motherName" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                               ng-model="vm.customerMasterDetailsTwo.C014.oldValue" chars="only-letters" readonly>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Gender</label></td>
                                        <td width="25%"><select class="form-control" id="gender"
                                                                name="state" ng-model="vm.customerMasterDetailsTwo.C015.oldValue"
                                                                ng-required="!vm.customerMasterDetailsTwo.C015.oldValue">
                                            <option value="" hidden="true">Select</option>
                                            <option value="M" >MALE</option>
                                            <option value="F" >FEMALE</option>
                                            <option value="O" >OTHERS</option>
                                        </select></td>


                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Is Minor (Y/N)?</label></td>
                                        <td width="25%"><select class="form-control" id="isMinor" ng-init="vm.checkAge(vm.customerMasterDetailsTwo.C016.oldValue, vm.customerMasterDetailsTwo.C009.oldValue,'modify','2')"
                                                                name="isMinor" ng-model="vm.customerMasterDetailsTwo.C016.oldValue"
                                                                ng-change="vm.checkAge(vm.customerMasterDetailsTwo.C016.oldValue, vm.customerMasterDetailsTwo.C009.oldValue,'modify','2')"
                                                                required>
                                            <option value="" hidden="true">Select</option>
                                            <option value="Y"  ng-selected="vm.customerMasterDetailsTwo.C016.oldValue == 'Y'">YES</option>
                                            <option value="N" ng-selected="vm.customerMasterDetailsTwo.C016.oldValue == 'N'">NO</option>
                                        </select></td>
                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                        <td width="25%">
                                            <p class="input-group" >
                                                <input type="text" class="form-control" id="bondHolderDateOfBirth1"
                                                       name="dateofBirth"
                                                       ng-model="vm.customerMasterDetailsTwo.C009.oldValue"
                                                       ng-change="vm.checkAge(vm.customerMasterDetailsTwo.C016.oldValue, vm.customerMasterDetailsTwo.C009.oldValue,'modify','2')"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.retirDatePickerValidation"
                                                       is-open="vm.dateOptions.opened"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('bondHolderDateOfBirth1',vm.customerMasterDetailsTwo.C009.oldValue)"
                                                       ng-keyup="vm.autoslashing('bondHolderDateOfBirth1')" chars="numbers-slash"
                                                       >
                                                <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions1" >
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                            </p>
                                        </td>
                                        <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsTwo.C016.oldValue == 'Y'}"><label
                                                for="birthCertificateNo1" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="birthCertificateNo1" name="birthCertificateNo" ng-model="vm.customerMasterDetailsTwo.C017.oldValue"
                                                               maxlength="30" chars="letters"  ng-required="vm.customerMasterDetailsTwo.C016.oldValue == 'Y'" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address1" name="address1" ng-model="vm.customerMasterDetailsTwo.C018.oldValue"
                                                               maxlength="200"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" ><label
                                                for="address2" class="control-label">Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address2" name="address2"
                                                               ng-model="vm.customerMasterDetailsTwo.C019.oldValue" maxlength="200"
                                                               ng-init="vm.tempPresentPremise = vm.presentPremise" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                    </tr>
                                    <tr>

                                        <td width="25%" ><label
                                                for="presentFlat" class="control-label">Address 3</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsTwo.C020.oldValue"
                                                               maxlength="200" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%"  class="form-group ">
                                            <label class="control-label">City</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                               ng-model="vm.customerMasterDetailsTwo.C022.oldValue"></td>

                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label">State</label></td>
                                        <td width="25%"><select class="form-control" id="state"
                                                                name="state" ng-model="vm.customerMasterDetailsTwo.C023.oldValue"
                                                                ng-init="vm.getState()" >
                                            <option value="" hidden="true">Select State</option>
                                            <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                        </select></td>

                                        <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                               ng-model="vm.customerMasterDetailsTwo.C021.oldValue"  ng-blur="vm.getModAddressTwo(vm.customerMasterDetailsTwo.C021.oldValue)"
                                                               onkeypress="return isNumber(event)" ></td>

                                    </tr>
                                    <tr>
                                        <td width="25%">Phone Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                               id="saphoneNum" ng-model="vm.customerMasterDetailsTwo.C024.oldValue"
                                                               chars="numbers-with-special-characters" ></td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35"
                                                   id="mobileNumber" ng-model="vm.customerMasterDetailsTwo.C025.oldValue"
                                                   chars="numbers-with-special-characters" ></td>


                                    </tr>

                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%" ><input type="email" class="form-control"
                                                                id="emailId" name="emailId" maxlength="100"
                                                                ng-model="vm.customerMasterDetailsTwo.C026.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsTwo.C012.oldValue == 'HT001' || vm.customerMasterDetailsTwo.C012.oldValue == 'HT002')">
                                            <label for="powerOfattorneyNo" class="control-label " > HUF registration / Power of Attorney number</label>
                                        </td>
                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004') && (vm.customerMasterDetailsTwo.C012.oldValue == 'HT001' || vm.customerMasterDetailsTwo.C012.oldValue == 'HT002')">
                                            <input type="text" class="form-control" minlength="1" maxlength="20"  chars="only-numbers"
                                                   id="powerOfattorneyNo" ng-model="vm.customerMasterDetailsTwo.C027.oldValue" readonly></td>

                                    </tr>


                                    <tr >
                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsTwo.C012.oldValue == 'HT001' || vm.customerMasterDetailsTwo.C012.oldValue == 'HT002')">
                                            <label for="kartaName" class="control-label ">Power of Attorney/Karta Name</label>
                                        </td>
                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsTwo.C012.oldValue == 'HT001' || vm.customerMasterDetailsTwo.C012.oldValue == 'HT002')">
                                            <input type="text" class="form-control" minlength="1" maxlength="70"  chars="only-letters"
                                                   id="kartaName" ng-model="vm.customerMasterDetailsTwo.C028.oldValue">
                                        </td>




                                    </tr>
                                    </tbody>
                                </table>


                                <h4 class="form_heading" ng-if="vm.customerMasterDetailsTwo.C016.oldValue=='Y'">GUARDIAN DETAILS</h4>
                                <div class="col-sm-12 text-right form_submit" ng-if="vm.customerMasterDetailsTwo.C016.oldValue=='Y'" ng-show="vm.isDateEntered1()">
                                    <div class="row">
                                        <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addGuardianTwo()">
                                            <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                        </a>
                                        <a data-href="#" type="button" class="btn btn-danger" ng-click="vm.deleteGuardianTwo()">
                                            <i class="glyphicon glyphicon-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                                <table class="table table-bordered" ng-if="vm.customerMasterDetailsTwo.C016.oldValue=='Y'">
                                    <tbody>
                                    <tr>
                                        <td width="25%">
                                            <label for="guardianId" class="control-label">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId"
                                                           name="guardianId"
                                                           ng-model="vm.guardianDetailsValueModel2.C005.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                                </div>

                                                <div class="col-sm-3 torch-top" ng-class="{ 'disabled': vm.getDetails.verifiedStatus === 'Y' }">
                                                    <i class="glyphicon glyphicon-search cp"
                                                       data-bs-toggle="modal"
                                                       ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.getGuardianDetails('select');"
                                                       id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.clearGuardianDetails()"
                                                       id="guardianIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label for="subscriberFirstName" class="control-label">Guardian First Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianFirstName" name="guardianFirstName"
                                                   maxlength="150" chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"

                                                   ng-model="vm.guardianDetailsValueModel2.C006.oldValue"
                                                    required>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">Guardian Middle Name</td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianMiddleName" name="guardianMiddleName"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModel2.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>

                                        <td width="25%">Guardian Last Name</td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianLastName" name="guardianLastName"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModel2.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation with minor</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor"
                                                    name="state" ng-model="vm.guardianDetailsValueModel2.C009.oldValue"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Birth</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth123"
                                                       name="guardianDateOfBirth" ng-model="vm.guardianDetailsValueModel2.C010.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.submissionfifteenGH"
                                                       is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth123',vm.guardianDetailsValueModel2.C010.oldValue)"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth123')" chars="numbers-slash"

                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.submissionfifteenGHPicker.opened = true"
                                id="submissionfifteenGHSearcher">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="address1" class="control-label">Communication Address</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianAddress" name="guardianAddress" ng-model="vm.guardianDetailsValueModel.C011.oldValue"
                                                   maxlength="200" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                        </td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35"
                                                   id="guardianMobileNumber" ng-model="vm.guardianDetailsValueModel2.C012.oldValue"
                                                   chars="numbers-with-special-characters"  ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="emailId" class="control-label">Email Id</label>
                                        </td>
                                        <td width="25%">
                                            <input type="email" class="form-control"
                                                   id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                   ng-model="vm.guardianDetailsValueModel2.C013.oldValue" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span>
                                        </td>


                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group"  ng-if="vm.getDetails.verifiedStatus=='Y'">
                                            <label class="control-label">Date of Death of Guardian<br>(DD/MM/YYYY)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="dateOfDeathOfBondHolderThree1"
                                                       name="dateOfDeathOfBondHolderThree"
                                                       ng-model="vm.guardianDetailsValueModel2.C014.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfDeathOfBondHolderThreeOption.opened"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('dateOfDeathOfBondHolderThree1',vm.guardianDetailsValueModel2.C014.oldValue)"
                                                       ng-keyup="vm.autoslashing('dateOfDeathOfBondHolderThree1')" chars="numbers-slash"


                                                >
                                                <span class="input-group-btn" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfDeathOfBondHolderThreeOption.opened = true"
                                id="dateOfDeathOfBondHolderThreeOption">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel2.C014.oldValue}">
                                            <label class="control-label">Date of Receipt of Death Certificate <br>(DD/MM/YYYY)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="dateOfReceiptOfDeathCertificateThree"
                                                       name="dateOfReceiptOfDeathCertificateThree"
                                                       ng-model="vm.guardianDetailsValueModel2.C015.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfReceiptOfDeathCertificateThreeOption.opened"
                                                       ng-required="vm.guardianDetailsValueModel2.C014.oldValue"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('dateOfReceiptOfDeathCertificateThree',vm.guardianDetailsValueModel2.C015.oldValue)"
                                                       ng-keyup="vm.autoslashing('dateOfReceiptOfDeathCertificateThree')" chars="numbers-slash"
                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfReceiptOfDeathCertificateThreeOption.opened = true"
                                id="dateOfReceiptOfDeathCertificateThreeOption">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">If Request from Current Guardian (Y/N)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="radio" id="currentGuardianY2" name="currentGuardian" ng-model="vm.guardianDetailsValueModel2.C016.oldValue"  value="Y">Yes
                                            <input type="radio" id="currentGuardianN2" name="currentGuardian" ng-model="vm.guardianDetailsValueModel2.C016.oldValue"  value="N">No
                                        </td>

                                        <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel2.C016.oldValue === 'Y'}">
                                            <label for="subscriberFirstName" class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="C026" name="C026"
                                                   maxlength="200"
                                                   ng-model="vm.guardianDetailsValueModel2.C017.oldValue"
                                                   ng-required="vm.guardianDetailsValueModel2.C016.oldValue=='Y'"
                                                   oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>



                                <table class="table table-bordered table-striped" ng-if="vm.showGuardianDetailsTwo">
                                    <tbody>
                                    <tr>
                                        <td colspan="4"><h4 class="form_heading">GUARDIAN DETAILS {{$index + 1}}</h4></td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="guardianId{{$index}}">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId{{$index}}"
                                                           name="guardianId{{$index}}"
                                                           ng-model="vm.guardianDetailsValueModelTwo.C005.oldValue">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click=
                                                               "vm.getDetails.guardianDetailsValueModel.C005.oldValue = '';
                                               vm.getDetails.guardianDetailsValueModel.C006.oldValue= '';
                                               vm.getDetails.guardianDetailsValueModel.C007.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C008.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C009.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C010.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C011.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C012.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C013.oldValue=''; " id="guardianIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label for="guardianFirstName{{$index}}">Guardian First Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianFirstName{{$index}}" name="guardianFirstName{{$index}}"
                                                   maxlength="50"
                                                   ng-model="vm.guardianDetailsValueModelTwo.C006.oldValue"
                                                   chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
                                            >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianMiddleName{{$index}}">Guardian Middle Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianMiddleName{{$index}}" name="guardianMiddleName{{$index}}"
                                                   maxlength="50"
                                                   ng-model="vm.guardianDetailsValueModelTwo.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>

                                        <td width="25%">
                                            <label for="guardianLastName{{$index}}">Guardian Last Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianLastName{{$index}}" name="guardianLastName{{$index}}"
                                                   maxlength="50"
                                                   ng-model="vm.guardianDetailsValueModelTwo.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label for="relationWithMinor{{$index}}">Relation with Minor</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor{{$index}}"
                                                    name="relationWithMinor{{$index}}" ng-model="vm.guardianDetailsValueModelTwo.C009.oldValue"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%">
                                            <label for="guardianDateOfBirth{{$index}}">Date of Birth</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth11{{$index}}" ng-init="vm.getDetails.guardianDetailsValueModel.C010.oldValue= ''"
                                                       name="guardianDateOfBirth{{$index}}" ng-model="vm.guardianDetailsValueModelTwo.C010.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfBirthPicker.opened" close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth11{{$index}}',vm.guardianDetailsValueModelTwo.C010.oldValue)"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth11{{$index}}')" chars="numbers-slash" >

                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfBirthPicker.opened = true"
                                id="dateOfBirthPicker{{$index}}">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianAddress{{$index}}">Communication Address</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianAddress{{$index}}" name="guardianAddress{{$index}}"  ng-model="vm.guardianDetailsValueModelTwo.C011.oldValue"
                                                   maxlength="200" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>

                                        <td width="25%">
                                            <label for="guardianMobileNumber{{$index}}">Mobile Number</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35"
                                                   id="guardianMobileNumber{{$index}}" ng-model="vm.guardianDetailsValueModelTwo.C012.oldValue"
                                                   chars="numbers-with-special-characters" >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianEmailId{{$index}}">Email Id</label>
                                        </td>
                                        <td width="25%">
                                            <input type="email" class="form-control"
                                                   id="guardianEmailId{{$index}}" name="guardianEmailId{{$index}}" maxlength="50"
                                                   ng-model="vm.guardianDetailsValueModelTwo.C013.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId{{$index}}.$error.pattern">Enter valid email address</span>
                                        </td>
                                    </tr>


                                    </tbody>
                                </table>



                                <h4 class="form_heading">Interest Payout Account Details</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label break-word">Whether the customer belongs to HDFC?</label></td>
                                        <td width="25%">
                                            <input type="radio" id="hdfcOtherBankY1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.C029.oldValue"  value="Y">Yes
                                            <input type="radio" id="hdfcOtherBankN1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.C029.oldValue"  value="N">No
                                        </td>

                                        <!--                                        <td width="25%" class="form-group">-->
                                        <!--                                            <label class="control-label">Operative Account Number</label></td>-->
                                        <!--                                        <td width="25%"><input type="text" class="form-control"-->
                                        <!--                                                               id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" ng-blur="vm.getSchemeTypeListOperative(vm.customerMasterDetailsTwo.operativeAccNum, 'acctNum')"-->
                                        <!--                                                               ng-model="vm.customerMasterDetailsTwo.C030.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">-->
                                        <!--                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                        <!--                                        </td>-->
                                        <td width="25%"  class="form-group required">
                                            <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsTwo.C030.oldValue ==''"
                                                   id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" minlength="9"
                                                   ng-model="vm.customerMasterDetailsTwo.C030.oldValue"
                                                   ng-required="vm.customerMasterDetailsTwo.C029.oldValue == 'Y'"
                                                   ng-disabled="vm.customerMasterDetailsTwo.C029.oldValue != 'Y'"
                                                   oninput="this.value = this.value.toUpperCase()"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                        </td>
                                        <td width="25%" >
                                            <button type="button" class="btn btn-primary"

                                                    ng-disabled="!vm.customerMasterDetailsTwo.C030.oldValue || vm.customerMasterDetailsTwo.C029.oldValue != 'Y'">
                                                Fetch
                                            </button>
                                    </tr>



                                    <tr>
                                        <td width="25%" class="form-group required">Pan No</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="panNum" minlength="10" maxlength="10"
                                                               ng-change="vm.validatePanLetter1M(vm.customerMasterDetailsTwo.C002.oldValue);"
                                                               onkeypress="return isNumber(event)" chars="alpha-numeric" required
                                                               ng-pattern="/[A-Z]{5}[0-9]{4}[A-Z]{1}/"
                                                               name="aadharNum" ng-model="vm.customerMasterDetailsTwo.C002.oldValue" oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
                                            <span class="text-danger" ng-show="vm.validationMessages1">{{ vm.validationMessages1 }}</span></td>

                                    </tr>



                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.C033.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               chars="only-letters"></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressOne" name="witnessAddressOne" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="200"
                                                               ng-model="vm.customerMasterDetailsTwo.C034.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"
                                        ></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               ng-model="vm.customerMasterDetailsTwo.C035.oldValue"
                                                               chars="only-letters"></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressTwo" name="witnessAddressTwo" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="200"
                                                               ng-model="vm.customerMasterDetailsTwo.C036.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"
                                        ></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">

                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificate" name="birthCertificate"
                                               ng-model="vm.customerMasterDetailsTwo.C037.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="birthCertificate">Birth Certificate</label><br>

                                        <input type="checkbox" id="passport" name="passport"
                                               ng-model="vm.customerMasterDetailsTwo.C038.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="passport">Passport</label><br>

                                        <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard"
                                               ng-model="vm.customerMasterDetailsTwo.C039.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="seniorCitizenCard">Senior Citizen Card</label><br>

                                        <input type="checkbox" id="voterId" name="voterId"
                                               ng-model="vm.customerMasterDetailsTwo.C040.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="voterId">Voter ID Card</label><br>

                                        <input type="checkbox" id="panCard" name="panCard"
                                               ng-model="vm.customerMasterDetailsTwo.C041.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="panCard">Pan Card</label><br>

                                        <input type="checkbox" id="drivingLicence" name="drivingLicence"
                                               ng-model="vm.customerMasterDetailsTwo.C042.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="drivingLicence">Driving Licence</label><br>

                                        <input type="checkbox" id="rationCard" name="rationCard"
                                               ng-model="vm.customerMasterDetailsTwo.C043.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="rationCard">Ration Card</label><br>

                                        <input type="checkbox" id="others" name="others"
                                               ng-model="vm.customerMasterDetailsTwo.C044.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="others">Others</label><br>
                                    </div>

                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsTwo.C044.oldValue === 'Y' ">
                                            <label class="control-label">Details for Others</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsTwo.C044.oldValue === 'Y' ">
                                            <input type="text" class="form-control"
                                                   id="otherDetails" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsTwo.C045.oldValue" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsTwo.C046.oldValue" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>

                        <div uib-accordion-group id="joint-personal-details-three" class="panel"
                             heading="THIRD JOINT ACCOUNT HOLDER DETAILS"
                             is-open="vm.thirdHolderDetails"
                             ng-class="(vm.thirdJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.getDetails.masterDetailsValueModel.length >= 3">
                            <ng-form name="vm.thirdJoinAccountHolderDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Bond Third Holder First
                                            Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberFirstName" name="customerFirstName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetailsThree.C006.oldValue"
                                                               chars="only-letters"
                                                               required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"></td>
                                        <td width="25%">Bond Third Holder Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberMiddleName" name="customerMiddleName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetailsThree.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">Bond Third Holder Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberLastName" name="customerLastName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetailsThree.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                        <td width="25%" class="form-group"><label
                                                class="control-label">Holder Type</label></td>
                                        <td width="25%">
                                            <select class="form-control"
                                                    ng-model="vm.customerMasterDetailsThree.C012.oldValue" ng-change="vm.getValidations(vm.customerMasterDetailsThree.C012.oldValue);"  readonly ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label
                                                for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="fatherName" name="fatherName" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                               ng-model="vm.customerMasterDetailsThree.C013.oldValue"
                                                               chars="only-letters" readonly></td>
                                        <td width="25%">
                                            <label  class="control-label">Mother's Maiden Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="motherName" name="motherName" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"
                                                               ng-model="vm.customerMasterDetailsThree.C014.oldValue" chars="only-letters" readonly>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Gender</label></td>
                                        <td width="25%"><select class="form-control" id="gender"
                                                                name="state" ng-model="vm.customerMasterDetailsThree.C015.oldValue"
                                                                ng-required="!vm.customerMasterDetailsThree.C015.oldValue">
                                            <option value="" hidden="true">Select</option>
                                            <option value="M" >MALE</option>
                                            <option value="F" >FEMALE</option>
                                            <option value="O" >OTHERS</option>
                                        </select></td>


                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Is Minor (Y/N)?</label></td>
                                        <td width="25%"><select class="form-control" id="isMinor" ng-init="vm.checkAge(vm.customerMasterDetailsThree.C016.oldValue, vm.customerMasterDetailsThree.C009.oldValue,'modify','3')"
                                                                name="isMinor" ng-model="vm.customerMasterDetailsThree.C016.oldValue"
                                                                ng-change="vm.checkAge(vm.customerMasterDetailsThree.C016.oldValue, vm.customerMasterDetailsThree.C009.oldValue,'modify','3')"
                                                                required >
                                            <option value="" hidden="true">Select</option>
                                            <option value="Y"  ng-selected="vm.customerMasterDetailsThree.C016.oldValue == 'Y'">YES</option>
                                            <option value="N" ng-selected="vm.customerMasterDetailsThree.C016.oldValue == 'N'">NO</option>
                                        </select></td>
                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                        <td width="25%">
                                            <p class="input-group" >
                                                <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                       name="dateofBirth"
                                                       ng-model="vm.customerMasterDetailsThree.C009.oldValue"
                                                       ng-change="vm.checkAge(vm.customerMasterDetailsThree.C016.oldValue, vm.customerMasterDetailsThree.C009.oldValue,'modify','3')"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.retirDatePickerValidation"
                                                       is-open="vm.dateOptions.opened"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('bondHolderDateOfBirth',vm.customerMasterDetailsThree.C009.oldValue)"
                                                       ng-keyup="vm.autoslashing('bondHolderDateOfBirth')" chars="numbers-slash">
                                                <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions2">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                            </p>
                                        </td>
                                        <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C016.oldValue == 'Y'}"><label
                                                for="birthCertificateNo1" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="birthCertificateNo1" name="birthCertificateNo" ng-model="vm.customerMasterDetailsThree.C017.oldValue"
                                                               maxlength="30" chars="letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address1" name="address1" ng-model="vm.customerMasterDetailsThree.C018.oldValue"
                                                               maxlength="200"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" ><label
                                                for="address2" class="control-label">Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address2" name="address2"
                                                               ng-model="vm.customerMasterDetailsThree.C019.oldValue" maxlength="200"
                                                               ng-init="vm.tempPresentPremise = vm.presentPremise" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                    </tr>
                                    <tr>

                                        <td width="25%" ><label
                                                for="presentFlat" class="control-label">Address 3</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsThree.C020.oldValue"
                                                               maxlength="200" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%"  class="form-group ">
                                            <label class="control-label">City</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                               ng-model="vm.customerMasterDetailsThree.C022.oldValue" ></td>

                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label">State</label></td>
                                        <td width="25%"><select class="form-control" id="state"
                                                                name="state" ng-model="vm.customerMasterDetailsThree.C023.oldValue"
                                                                ng-init="vm.getState()" >
                                            <option value="" hidden="true">Select State</option>
                                            <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                        </select></td>

                                        <td width="25%" class="form-group "><label class="control-label">Pin Code</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                               ng-model="vm.customerMasterDetailsThree.C021.oldValue"  ng-blur="vm.getModAddressThree(vm.customerMasterDetailsThree.C021.oldValue)"
                                                               onkeypress="return isNumber(event)" ></td>

                                    </tr>
                                    <tr>
                                        <td width="25%">Phone Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                               id="saphoneNum" ng-model="vm.customerMasterDetailsThree.C024.oldValue"
                                                               chars="numbers-with-special-characters"></td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35"
                                                   id="mobileNumber" ng-model="vm.customerMasterDetailsThree.C025.oldValue"
                                                   chars="numbers-with-special-characters"></td>


                                    </tr>

                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%" ><input type="email" class="form-control"
                                                                id="emailId" name="emailId" maxlength="100"
                                                                ng-model="vm.customerMasterDetailsThree.C026.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsThree.C012.oldValue == 'HT001' || vm.customerMasterDetailsThree.C012.oldValue == 'HT002')">
                                            <label for="powerOfattorneyNo" class="control-label " > HUF registration / Power of Attorney number</label>
                                        </td>



                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsThree.C012.oldValue == 'HT001' || vm.customerMasterDetailsThree.C012.oldValue == 'HT002')">
                                            <input type="text" class="form-control" minlength="1" maxlength="30"
                                                   id="powerOfattorneyNo" ng-model="vm.customerMasterDetailsThree.C027.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   readonly></td>

                                    </tr>


                                    <tr >
                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsThree.C012.oldValue == 'HT001' || vm.customerMasterDetailsThree.C012.oldValue == 'HT002')">
                                            <label for="kartaName" class="control-label ">Power of Attorney/Karta Name</label>
                                        </td>


                                        <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetailsThree.C012.oldValue == 'HT001' || vm.customerMasterDetailsThree.C012.oldValue == 'HT002')">
                                            <input type="text" class="form-control" minlength="1" maxlength="70"
                                                   id="kartaName" ng-model="vm.customerMasterDetailsThree.C028.oldValue"
                                                   ng-required=" vm.modeOfHolding=='MH004' || vm.customerMasterDetailsThree.C028.oldValue == 'HT001'">
                                        </td>




                                    </tr>



                                    </tbody>
                                </table>





                                <h4 class="form_heading" ng-if="vm.customerMasterDetailsThree.C016.oldValue=='Y'">
                                    GUARDIAN DETAILS</h4>
                                <div class="col-sm-12 text-right form_submit" ng-if="vm.customerMasterDetailsThree.C016.oldValue=='Y'" ng-show="vm.isDateEntered2()">
                                    <div class="row">
                                        <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addGuardianThree()">
                                            <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                        </a>
                                        <a data-href="#" type="button" class="btn btn-danger" ng-click="vm.deleteGuardian()">
                                            <i class="glyphicon glyphicon-trash"></i> Delete
                                        </a>
                                    </div>
                                </div>
                                <table class="table table-bordered" ng-if="vm.customerMasterDetailsThree.C016.oldValue=='Y'">
                                    <tbody>
                                    <tr>
                                        <td width="25%">
                                            <label for="guardianId" class="control-label">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId"
                                                           name="guardianId"
                                                           ng-model="vm.guardianDetailsValueModel3.C005.oldValue" disabled ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                                </div>
                                                <div class="col-sm-3 torch-top" ng-class="{ 'disabled': vm.getDetails.verifiedStatus === 'Y' }">
                                                    <i class="glyphicon glyphicon-search cp"
                                                       data-bs-toggle="modal"
                                                       ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.getGuardianDetails('select');"
                                                       id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="!vm.getDetails.verifiedStatus === 'Y' && vm.clearGuardianDetails()"
                                                       id="guardianIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label for="subscriberFirstName" class="control-label">Guardian First Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianFirstName" name="guardianFirstName"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModel3.C006.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"

                                                   chars="only-letters" required>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">Guardian Middle Name</td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianMiddleName" name="guardianMiddleName"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModel3.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>

                                        <td width="25%">Guardian Last Name</td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianLastName" name="guardianLastName"
                                                   maxlength="150"  oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')"
                                                   ng-model="vm.guardianDetailsValueModel3.C008.oldValue" chars="only-letters">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation with minor</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor"
                                                    name="state" ng-model="vm.guardianDetailsValueModel3.C009.oldValue"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Birth</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth"
                                                       name="guardianDateOfBirth" ng-model="vm.guardianDetailsValueModel3.C010.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       datepicker-options="vm.submissionfifteenGH"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth',vm.guardianDetailsValueModel3.C010.oldValue)"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth')" chars="numbers-slash"

                                                       is-open="vm.submissionfifteenGHPicker.opened" close-text="Close"
                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.submissionfifteenGHPicker.opened = true"
                                id="submissionfifteenGHSearcher">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="address1" class="control-label">Communication Address</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   id="guardianAddress" name="guardianAddress" ng-model="vm.guardianDetailsValueModel3.C011.oldValue"
                                                   maxlength="200" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   id="guardianMobileNumber" ng-model="vm.guardianDetailsValueModel3.C012.oldValue"
                                                   chars="numbers-with-special-characters" >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="emailId" class="control-label">Email Id</label>
                                        </td>
                                        <td width="25%">
                                            <input type="email" class="form-control"
                                                   id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                   ng-model="vm.guardianDetailsValueModel3.C013.oldValue" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Death of Guardian<br>(DD/MM/YYYY)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="dateOfDeathOfBondHolderThree"
                                                       name="dateOfDeathOfBondHolderThree"
                                                       ng-model="vm.guardianDetailsValueModel3.C014.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfDeathOfBondHolderThreeOption.opened"
                                                       close-text="Close" maxlength="10" ng-blur="vm.textableDatePicker('dateOfDeathOfBondHolderThree',vm.guardianDetailsValueModel3.C014.oldValue)"
                                                       ng-keyup="vm.autoslashing('dateOfDeathOfBondHolderThree')" chars="numbers-slash"
                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfDeathOfBondHolderThreeOption.opened = true"
                                id="dateOfDeathOfBondHolderThreeOption">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel3.C014.oldValue}">
                                            <label class="control-label">Date of Receipt of Death Certificate <br>(DD/MM/YYYY)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="dateOfReceiptOfDeathCertificateThree11"
                                                       name="dateOfReceiptOfDeathCertificateThree"
                                                       ng-model="vm.guardianDetailsValueModel3.C015.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfReceiptOfDeathCertificateThreeOption.opened"
                                                       ng-required="vm.guardianDetailsValueModel3.C051.oldValue"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('dateOfReceiptOfDeathCertificateThree11',vm.guardianDetailsValueModel3.C015.oldValue)"
                                                       ng-keyup="vm.autoslashing('dateOfReceiptOfDeathCertificateThree11')" chars="numbers-slash"

                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfReceiptOfDeathCertificateThreeOption.opened = true"
                                id="dateOfReceiptOfDeathCertificateThreeOption">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">If Request from Current Guardian (Y/N)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="radio" id="currentGuardianY3" name="currentGuardian" ng-model="vm.guardianDetailsValueModel3.C016.oldValue"  value="Y">Yes
                                            <input type="radio" id="currentGuardianN3" name="currentGuardian" ng-model="vm.guardianDetailsValueModel3.C016.oldValue"  value="N">No
                                        </td>

                                        <td width="25%" class="form-group" ng-class="{'required': vm.guardianDetailsValueModel3.C016.oldValue === 'Y'}">
                                            <label for="subscriberFirstName" class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="C026" name="C026"
                                                   maxlength="200"
                                                   ng-model="vm.guardianDetailsValueModel3.C017.oldValue"
                                                   ng-required="vm.guardianDetailsValueModel3.C016.oldValue=='Y'"
                                                   oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>



                                <table class="table table-bordered table-striped" ng-if="vm.showGuardianDetailsThree">
                                    <tbody>
                                    <tr>
                                        <td colspan="4"><h4 class="form_heading">GUARDIAN DETAILS {{$index + 1}}</h4></td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label for="guardianId{{$index}}">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId{{$index}}"
                                                           name="guardianId{{$index}}"
                                                           ng-model="vm.guardianDetailsValueModelThree.C005.oldValue">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click=
                                                               "vm.getDetails.guardianDetailsValueModel.C005.oldValue = '';
                                               vm.getDetails.guardianDetailsValueModel.C006.oldValue= '';
                                               vm.getDetails.guardianDetailsValueModel.C007.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C008.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C009.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C010.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C011.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C012.oldValue='';
                                               vm.getDetails.guardianDetailsValueModel.C013.oldValue=''; " id="guardianIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label for="guardianFirstName{{$index}}">Guardian First Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianFirstName{{$index}}" name="guardianFirstName{{$index}}"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModelThree.C006.oldValue"
                                                   chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')"
                                            >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianMiddleName{{$index}}">Guardian Middle Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianMiddleName{{$index}}" name="guardianMiddleName{{$index}}"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModelThree.C007.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>

                                        <td width="25%">
                                            <label for="guardianLastName{{$index}}">Guardian Last Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianLastName{{$index}}" name="guardianLastName{{$index}}"
                                                   maxlength="150"
                                                   ng-model="vm.guardianDetailsValueModelThree.C008.oldValue" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label for="relationWithMinor{{$index}}">Relation with Minor</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor{{$index}}"
                                                    name="relationWithMinor{{$index}}" ng-model="vm.guardianDetailsValueModelThree.C009.oldValue"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%">
                                            <label for="guardianDateOfBirth{{$index}}">Date of Birth</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth{{$index}}"
                                                       name="guardianDateOfBirth{{$index}}" ng-model="vm.guardianDetailsValueModelThree.C010.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobCalenderOptions"
                                                       is-open="vm.dateOfBirthPicker.opened" close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth{{$index}}',vm.guardianDetailsValueModelThree.C010.oldValue)"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth{{$index}}')" chars="numbers-slash"

                                                >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="vm.dateOfBirthPicker.opened = true"
                                id="dateOfBirthPicker{{$index}}">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianAddress{{$index}}">Communication Address</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="guardianAddress{{$index}}" name="guardianAddress{{$index}}"  ng-model="vm.guardianDetailsValueModelThree.C011.oldValue"
                                                   maxlength="200" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>

                                        <td width="25%">
                                            <label for="guardianMobileNumber{{$index}}">Mobile Number</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="35"
                                                   id="guardianMobileNumber{{$index}}" ng-model="vm.guardianDetailsValueModelThree.C012.oldValue"
                                                   chars="numbers-with-special-characters" >
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="guardianEmailId{{$index}}">Email Id</label>
                                        </td>
                                        <td width="25%">
                                            <input type="email" class="form-control"
                                                   id="guardianEmailId{{$index}}" name="guardianEmailId{{$index}}" maxlength="100"
                                                   ng-model="vm.guardianDetailsValueModelThree.C013.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId{{$index}}.$error.pattern">Enter valid email address</span>
                                        </td>
                                    </tr>


                                    </tbody>
                                </table>

                                <h4 class="form_heading">Interest Payout Account Details</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label break-word">Whether the customer belongs to HDFC?</label></td>
                                        <td width="25%">
                                            <input type="radio" id="hdfcOtherBankY2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.C029.oldValue"  value="Y">Yes
                                            <input type="radio" id="hdfcOtherBankN2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.C029.oldValue"  value="N">No
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsThree.C030.oldValue ==''"
                                                   id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" minlength="9"
                                                   ng-model="vm.customerMasterDetailsThree.C030.oldValue"
                                                   ng-required="vm.customerMasterDetailsThree.C029.oldValue == 'Y'"
                                                   ng-disabled="vm.customerMasterDetailsThree.C029.oldValue != 'Y'"
                                                   oninput="this.value = this.value.toUpperCase()"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                        </td>
                                        <td width="25%">
                                            <button type="button" class="btn btn-primary"

                                                    ng-disabled="!vm.customerMasterDetailsThree.C030.oldValue || vm.customerMasterDetailsThree.C029.oldValue !== 'Y'">
                                                Fetch
                                            </button>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">Pan No</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="panNum" minlength="10" maxlength="10"
                                                               ng-change="vm.validatePanLetter2M(vm.customerMasterDetailsThree.C002.oldValue);"
                                                               onkeypress="return isNumber(event)" chars="alpha-numeric" required
                                                               ng-pattern="/[A-Z]{5}[0-9]{4}[A-Z]{1}/"
                                                               name="aadharNum" ng-model="vm.customerMasterDetailsThree.C002.oldValue" oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
                                            <span class="text-danger" ng-show="vm.validationMessages1">{{ vm.validationMessages1 }}</span></td>

                                    </tr>



                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               ng-model="vm.customerMasterDetailsThree.C033.oldValue"
                                                               chars="only-letters"></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               id="witnessAddressOne" name="witnessAddressOne"
                                                               maxlength="200"
                                                               ng-model="vm.customerMasterDetailsThree.C034.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"
                                        ></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.C035.oldValue"
                                                               chars="only-letters"></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               id="witnessAddressTwo" name="witnessAddressTwo"
                                                               maxlength="200"
                                                               ng-model="vm.customerMasterDetailsThree.C036.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"
                                        ></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">
                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificate" name="birthCertificate"
                                               ng-model="vm.customerMasterDetailsThree.C037.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="birthCertificate">Birth Certificate</label><br>

                                        <input type="checkbox" id="passport" name="passport"
                                               ng-model="vm.customerMasterDetailsThree.C038.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="passport">Passport</label><br>

                                        <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard"
                                               ng-model="vm.customerMasterDetailsThree.C039.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="seniorCitizenCard">Senior Citizen Card</label><br>

                                        <input type="checkbox" id="voterId" name="voterId"
                                               ng-model="vm.customerMasterDetailsThree.C040.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="voterId">Voter ID Card</label><br>

                                        <input type="checkbox" id="panCard" name="panCard"
                                               ng-model="vm.customerMasterDetailsThree.C041.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="panCard">Pan Card</label><br>

                                        <input type="checkbox" id="drivingLicence" name="drivingLicence"
                                               ng-model="vm.customerMasterDetailsThree.C042.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="drivingLicence">Driving Licence</label><br>

                                        <input type="checkbox" id="rationCard" name="rationCard"
                                               ng-model="vm.customerMasterDetailsThree.C043.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="rationCard">Ration Card</label><br>

                                        <input type="checkbox" id="others" name="others"
                                               ng-model="vm.customerMasterDetailsThree.C044.oldValue"
                                               ng-true-value="'Y'" ng-false-value="'N'">
                                        <label for="others">Others</label><br>
                                    </div>
                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsThree.C044.oldValue === 'Y' ">
                                            <label class="control-label">Details for Others</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsThree.C044.oldValue === 'Y' ">
                                            <input type="text" class="form-control"
                                                   id="otherDetails" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsThree.C045.oldValue" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsThree.C046.oldValue" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>
                    </form>
                </uib-accordion>


                <div class="text-center form_submit">

                    <button type="submit" class="btn btn-default" id="submitButton"  ng-click="vm.tabReferenceModify ='bondSubscriptionFlowForm'"
                            ng-disabled="vm.customerMasterForm.$invalid">Next</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            data-bs-dismiss="modal" ng-click="vm.showCancelConfirmation('bla_acc_opening_cum_subscription.modify');">Cancel</button>
                </div>
            </div>
        </div>




        <div id="bondSubscriptionFlowForm" ng-show="vm.tabReferenceModify=='bondSubscriptionFlowForm'"   class="tab-pane fade in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="vm.bondSubscriptionFlowForm" role="form"
                          ng-submit="vm.submitAddForm">

                        <div uib-accordion-group id="personal-details" class="panel"
                             heading='BOND HOLDER DETAILS'
                             is-open="vm.personalDetailsOpen"
                             ng-class="(vm.customerPersonalDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" >
                                            <label  class="control-label">Name of the Bond Scheme</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">{{vm.schemeName}}</label>
                                        </td>
                                        <td width="15%" class="form-group">
                                            <label class="control-label">Application No</label></td>
                                        <td width="35%">
                                            <label class="control-label">{{vm.subscriptionDetailsValueModel.C047.oldValue}}</label>
                                        </td>

                                    </tr>

                                    <tr ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C003.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">BLA Number</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C003.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group" ng-if="vm.modeOfHolding=='MH004'">
                                            <label class="control-label">Bond Holder Name</label></td>
                                        <td width="25%" ng-if="vm.modeOfHolding=='MH004'">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C004.oldValue}}</label>
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C005.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">First Joint Bond Holder BLA No.</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C005.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">First Joint Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C006.oldValue}}</label>
                                        </td>
                                    </tr>
                                    <tr ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C007.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Second Joint Bond Holder BLA No.</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C007.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Second Joint Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C008.oldValue}}</label>
                                        </td>
                                    </tr>
                                    <tr ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C009.oldValue">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Third Joint Bond Holder BLA No.</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C009.oldValue}}</label>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Third Joint Bond Holder Name</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.getDetails.subscriptionDetailsValueModel[0].C010.oldValue}}</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group" ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C014.oldValue">
                                            <label class="control-label">Subscription Id</label></td>
                                        <td width="25%">
                                            <label class="control-label"  ng-if="vm.getDetails.subscriptionDetailsValueModel[0].C014.oldValue">{{vm.getDetails.subscriptionDetailsValueModel[0].C014.oldValue}}</label>
                                        </td>

                                    </tr>
                                    <!--                                    <tr ng-if="vm.modeOfHolding == 'MH001' ||vm.modeOfHolding  == 'MH004' || vm.modeOfHolding  == 'MH005'">-->
                                    <!--                                        <td width="25%" >-->
                                    <!--                                            <label  class="control-label">Bond Holder Name</label>-->
                                    <!--                                        </td>-->
                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label  class="control-label">{{vm.subscriptionDetailsValueModel.C004.oldValue}}</label>-->
                                    <!--                                        </td>-->

                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label class="control-label">Bond Ledger Account Number</label>-->
                                    <!--                                        </td>-->
                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label class="control-label">{{vm.subscriptionDetailsValueModel.C003.oldValue}}</label>-->
                                    <!--                                        </td>-->
                                    <!--                                    </tr>-->


                                    <!--                                    <tr ng-if="vm.bondHolderDetails[0].modeOfHoldingKeyword == 'MH002' || vm.bondHolderDetails[0].modeOfHoldingKeyword == 'MH003'">-->
                                    <!--                                        <td width="25%" >-->
                                    <!--                                            <label  class="control-label">First joint Bond Holder Name</label>-->
                                    <!--                                        </td>-->
                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label  class="control-label">{{vm.subscriptionDetailsValueModel.C006.oldValue}}</label>-->
                                    <!--                                        </td>-->

                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label class="control-label">First joint Bond Holder BLA No.</label>-->
                                    <!--                                        </td>-->
                                    <!--                                        <td width="25%">-->
                                    <!--                                            <label class="control-label">{{vm.subscriptionDetailsValueModel.C005.oldValue}}</label>-->
                                    <!--                                        </td>-->
                                    <!--                                    </tr>-->

                                    <!--                                    <div ng-if="vm.bondHolderDetails.length >= 2">-->
                                    <!--                                        <tr ng-if="vm.bondHolderDetails[0].modeOfHoldingKeyword == 'MH002' || vm.bondHolderDetails[0].modeOfHoldingKeyword == 'MH003' && vm.bondHolderDetails.length >= 2">-->
                                    <!--                                            <td width="25%" >-->
                                    <!--                                                <label  class="control-label">Second joint Bond Holder Name</label>-->
                                    <!--                                            </td>-->
                                    <!--                                            <td width="25%">-->
                                    <!--                                                <label  class="control-label">{{vm.subscriptionDetailsValueModel.C008.oldValue}}</label>-->
                                    <!--                                            </td>-->

                                    <!--                                            <td width="25%">-->
                                    <!--                                                <label class="control-label">Second joint Bond Holder BLA No.</label>-->
                                    <!--                                            </td>-->
                                    <!--                                            <td width="25%">-->
                                    <!--                                                <label class="control-label">{{vm.subscriptionDetailsValueModel.C007.oldValue}}</label>-->
                                    <!--                                            </td>-->
                                    <!--                                        </tr>-->

                                    <!--                                    </div>-->



                                    </tbody>
                                </table>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="bond-subscription-details" class="panel"
                             heading='BOND SUBSCRIPTION  DETAILS'
                             is-open="vm.bondSubscriptionDetailsOpen"
                             ng-class="(vm.bondSubscriptionDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.bondSubscriptionDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>



                                    <tr>
                                        <td width="25%" class="form-group ">
                                            <label for="brokerId" class="control-label">Broker Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="brokerId"
                                                       name="brokerId"
                                                       ng-init="vm.brokerId = ''"
                                                       ng-model="vm.subscriptionDetailsValueModel.C011.oldValue"
                                                       chars="alpha-numeric" readonly>
                                            </div>
                                            <div class="col-sm-3 torch-top">
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   ng-click="vm.getModifyBrokerTorch(vm.getDetails.invoiceFlag,vm.getDetails.paymentFlag);" id="brokerIdSearcher"></i>
                                                <!-- <i class="glyphicon glyphicon-remove clear cp"
                                                    ng-click="vm.brokerId = '';" id="brokerIdIdClose"></i>-->
                                            </div>
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Broker Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="brokerName"
                                                   name="brokerName"
                                                   ng-model="vm.subscriptionDetailsValueModel.C045.oldValue" readonly disabled>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label for="subscriptionAmount" class="control-label">Subscription Amount</label>
                                        </td>

                                        <td width="25%" >
                                            <!-- <input type="text" class="form-control" maxlength="11"
                                                    id="saphoneNum" ng-model="vm.subscriptionDetailsValueModel.C012.oldValue | number : 2" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    chars="only-numbers"  required>-->
                                            <label class="control-label" >{{vm.indianNumberFormat(vm.subscriptionDetailsValueModel.C012.oldValue)}}</label>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label for="amtInWords" class="control-label">Amount in Words</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="amtInWords"
                                                   ng-model="vm.amtInWords"
                                                   ng-disabled="vm.getDetails.verifiedStatus === 'Y'"
                                                   required />
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Bond Type</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="bondType"
                                                    name="bondType" ng-model="vm.subscriptionDetailsValueModel.C013.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option value="NC">Non-Cumulative</option>
                                                <option value="C">Cumulative</option>
                                            </select>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">Account Open Date (dd/mm/yyyy)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="effFromDate"
                                                       name="effFromDate"
                                                       ng-model="vm.subscriptionDetailsValueModel.C015.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.effFromDateOptionsM"
                                                       is-open="vm.efffromDateOptions.opened"
                                                       close-text="Close" maxlength="10" required
                                                       ng-blur="vm.textableDatePicker('effFromDate',vm.subscriptionDetailsValueModel.C015.oldValue)"
                                                       ng-keyup="vm.autoslashing('effFromDate')" chars="numbers-slash"

                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                                <!--<span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.efffromDateOptions.opened = true"
                                    id="efffromDateOptions">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>

                                        </td>

                                    </tr>


                                    <tr>
                                        <td width="25%">
                                            <label class="control-label">Value Date (dd/mm/yyyy)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="effFromDate1"
                                                       name="effFromDate"
                                                       ng-model="vm.subscriptionDetailsValueModel.C016.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.effFromDateOptionsM1"
                                                       is-open="vm.efffromDateOptions1.opened"
                                                       close-text="Close" maxlength="10" required
                                                       ng-blur="vm.textableDatePicker('effFromDate1',vm.subscriptionDetailsValueModel.C016.oldValue)"
                                                       ng-keyup="vm.autoslashing('effFromDate1')" chars="numbers-slash"

                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                              <!--  <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.efffromDateOptions1.opened = true"
                                    id="efffromDateOptions1">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">Period of Deposit (months)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="periodOfDeposit" ng-model="vm.subscriptionDetailsValueModel.C017.oldValue"
                                                   chars="only-numbers"  required ng-disabled="vm.getDetails.verifiedStatus=='Y'">

                                        </td>

                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label class="control-label">Maturity Date (dd/mm/yyyy)</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.subscriptionDetailsValueModel.C018.oldValue}}</label>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">Rate of Interest(%)</label>
                                        </td>
                                        <td width="25%">
                                            <!--                        <label class="control-label">{{vm.rateOfInterest}}</label>-->
                                            <input type="text" class="form-control"
                                                   id="rateOfInterest" ng-model="vm.subscriptionDetailsValueModel.C019.oldValue"
                                                   chars="only-numbers" ng-disabled="vm.getDetails.verifiedStatus=='Y'" required>
                                        </td>

                                    </tr>
                                    <tr>


                                        <td width="25%" class="form-group ">
                                            <label for="wocBranchCode" class="control-label">Branch code- WBO</label>
                                        </td>
                                        <td width="25%">

                                            <input type="text" class="form-control" id="wocBranchCode"
                                                   name="wocBranchCode"
                                                   ng-model="vm.subscriptionDetailsValueModel.C041.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   chars="alpha-numeric" >

                                        </td>
                                        <td width="25%" class="form-group ">
                                            <label for="wocBranchName" class="control-label">Branch Name- WBO</label>
                                        </td>
                                        <td width="25%">

                                            <input type="text" class="form-control" id="wocBranchName"
                                                   name="wocBranchName"
                                                   ng-model="vm.subscriptionDetailsValueModel.C042.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   chars="alpha-numeric" >

                                        </td>

                                    </tr>
                                    <tr>
                                    <td width="25%" class="form-group required">
                                    <label class="control-label">Segment</label>
                                    </td>
                                    <td width="25%">
                                    <select class="form-control" id="segment"
                                            name="segment" ng-model="vm.subscriptionDetailsValueModel.C043.oldValue"
                                            required readonly>
                                        <option value="" hidden="true">Select</option>
                                        <option ng-repeat="item in vm.segmentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                    </select>
                                    </td>
                                        <td width="25%">
                                            <label class="control-label">Mode Of Operation</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" ng-model="vm.modeOfOperation" ng-if="vm.modeOfOperation == 'MH002' || vm.modeOfOperation == 'MH003'">
                                                <option value="MH002">Joint - Jointly</option>
                                                <option value="MH003">Joint - Anyone or Survivor</option>
                                            </select>
                                            <label class="data-bind" ng-if="vm.modeOfOperation=='MH001'" >Single</label>

                                            <label class="data-bind" ng-if="vm.modeOfOperation=='MH004'" >HUF</label>
                                            <label class="data-bind" ng-if="vm.modeOfOperation=='MH005'" >Legal Guardian</label>
                                        </td>
                                    </tr>


                                    </tbody>
                                </table>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="bond-transaction-detailss" class="panel"
                             heading='DEBIT ACCOUNT DETAILS'
                             is-open="vm.bondTransactionDetailsOpen"
                             ng-class="(vm.bondTransactionDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.bondTransactionDetails" >
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Transaction Mode</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="transactionMode"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    name="transactionMode" ng-model="vm.subscriptionDetailsValueModel.C027.oldValue" ng-change="vm.validateMultiples(vm.subscriptionDetailsValueModel.C027,'add');vm.debitAccNo='';
vm.subscriptionDetailsValueModel.C029.oldValue='';
vm.subscriptionDetailsValueModel.C030.oldValue='';
vm.subscriptionDetailsValueModel.C031.oldValue='';
vm.subscriptionDetailsValueModel.C032.oldValue='';
vm.subscriptionDetailsValueModel.C033.oldValue='';
vm.subscriptionDetailsValueModel.C034.oldValue='';
vm.subscriptionDetailsValueModel.C035.oldValue='';
vm.subscriptionDetailsValueModel.C036.oldValue='';
vm.subscriptionDetailsValueModel.C037.oldValue='';
vm.subscriptionDetailsValueModel.C038.oldValue='';"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.transactionModeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'T'" width="25%" class="form-group">
                                            <label class="control-label">Debit Account Number</label></td>
                                        <td width="25%" ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'T'">
                                            <input type="text" class="form-control"
                                                   id="debitAccNo" name="debitAccNo" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.subscriptionDetailsValueModel.C028.oldValue" disabled>
                                            <span class="alert-danger" ng-if="vm.cbsErrorMessageForDebit">{{vm.cbsErrorMessageForDebit}}</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <!--                                        <td ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'T'" width="25%" class="form-group required">-->
                                        <!--                                            <label class="control-label">Branch ID</label></td>-->
                                        <!--                                        <td width="25%" ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'T'">-->
                                        <!--                                            <input type="text" class="form-control"-->
                                        <!--                                                   id="debitBranchId" name="debitBranchId" chars="alpha-numeric" maxlength="20"-->
                                        <!--                                                   ng-model="vm.subscriptionDetailsValueModel.C027.oldValue" required readonly>-->
                                        <!--                                        </td>-->

                                        <td ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'" width="25%" ng-class="vm.subscriptionDetailsValueModel.C027.oldValue!='CL' ? 'form-group required' : 'form-group'">
                                            <label class="control-label">Instrument Type</label>
                                        </td>
                                        <td ng-if="vm.subscriptionDetailsValueModel.C027.oldValue =='T'  || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'" width="25%">

                                            <select class="form-control" id="instrumentType"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    name="instrumentType" ng-model="vm.subscriptionDetailsValueModel.C029.oldValue"
                                                    ng-required="vm.subscriptionDetailsValueModel.C027.oldValue!='CL'">
                                                <option value="" hidden="true">Select</option>
                                                <option ng-if="vm.subscriptionDetailsValueModel.C029.oldValue=='NETBK'" value="NETBK">NETBK</option>
                                                <option ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'" value="CHQ">CHEQUE</option>
                                                <option ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'"  value="DD">DD</option>
                                            </select>
                                        </td>

                                    </tr>


                                    <tr>
                                        <td width="25%"  ng-if="vm.subscriptionDetailsValueModel.C027.oldValue =='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'" ng-class="vm.subscriptionDetailsValueModel.C029.oldValue =='DD' ? 'form-group required' : 'form-group'">
                                            <label class="control-label">Instrument Number</label></td>
                                        <td width="25%" ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'">
                                            <input type="text" class="form-control"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   id="instrumentNo" name="instrumentNo" chars="only-numbers" limit-to="6"
                                                   ng-model="vm.subscriptionDetailsValueModel.C030.oldValue"  ng-required="vm.subscriptionDetailsValueModel.C027.oldValue =='CL'">
                                            <span class="alert-danger" ng-if="vm.insErrorMessage">{{vm.insErrorMessage}}</span>
                                        </td>




                                        <td width="25%"  ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'" ng-class="vm.subscriptionDetailsValueModel.C029.oldValue =='DD' ? 'form-group required' : 'form-group'">
                                            <label class="control-label">Instrument Date<br> (DD/MM/YYYY)</label></td>
                                        <td width="25%" ng-if="vm.subscriptionDetailsValueModel.C027.oldValue=='T' || vm.subscriptionDetailsValueModel.C027.oldValue=='CL'">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="effToDate"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       name="effToDate" ng-model="vm.subscriptionDetailsValueModel.C031.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dateToOptionsInstrumentDate"
                                                       is-open="vm.effToDatePickerDtOfSubTwo.opened" close-text="Close"
                                                       ng-disabled="vm.subscriptionDetailsValueModel.C027.oldValue == 'C'"
                                                       maxlength="10"
                                                       ng-blur="vm.textableDatePicker('effToDate',vm.subscriptionDetailsValueModel.C031.oldValue)"
                                                       ng-keyup="vm.autoslashing('effToDate')" chars="numbers-slash"

                                                       ng-required="vm.subscriptionDetailsValueModel.C027.oldValue =='DD'">
                                                <!--<span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effToDatePickerDtOfSubTwo.opened = true"
                                    id="effToDateSearcher">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>
                                        </td>

                                    </tr>

                                    <tr ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'T' || vm.subscriptionDetailsValueModel.C027.oldValue == 'CL'">
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Instrument Amount</label></td>
                                        <!--<td width="25%">
                                            <input type="text" class="form-control"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   id="instrumentAmount" name="instrumentAmount" chars="only-numbers" maxlength="20"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   ng-model="vm.subscriptionDetailsValueModel.C032.oldValue"  required>
                                        </td>-->
                                        <td width="25%"> <label class="control-label" >{{vm.indianNumberFormat(vm.subscriptionDetailsValueModel.C032.oldValue)}}</label></td>

                                    </tr>


                                    <tr ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'CL'">
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Tran Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="tranCode"
                                                           name="tranCode"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           ng-model="vm.subscriptionDetailsValueModel.C033.oldValue"
                                                           chars="alpha-numeric" disabled readonly >
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-eye-open" data-bs-toggle="modal"
                                                       ng-click="vm.getTranCodeDetails();" id="tranCodeSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="vm.tranCode = ''" id="tranCodeolIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Zone Code</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="zoneCode" name="zoneCode" chars="alpha-numeric" maxlength="20"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   ng-model="vm.subscriptionDetailsValueModel.C034.oldValue"  >
                                        </td>

                                    </tr>

                                    <tr ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'CL'">
                                        <td width="25%" class="form-group" >
                                            <label class="control-label">Zone Date<br> (DD/MM/YYYY)</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="zoneDate"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       name="effToDate" ng-model="vm.subscriptionDetailsValueModel.C035.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dateToOptionsZoneDate"
                                                       is-open="vm.effToDatePickerZoneDate.opened" close-text="Close"

                                                       maxlength="10"

                                                       ng-blur="vm.textableDatePicker('zoneDate',vm.subscriptionDetailsValueModel.C035.oldValue)"
                                                       ng-keyup="vm.autoslashing('zoneDate')" chars="numbers-slash"
                                                >
                                               <!-- <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effToDatePickerZoneDate.opened = true"
                                    id="effToDateSearcherZone">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Bank Name (Non-MICR)</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="bankCodeNonMicr"
                                                           name="bankCodeNonMicr"
                                                           ng-model="vm.bankCodeNonMicr"
                                                           chars="alpha-numeric" disabled>
                                                </div>
                                                <!--                            <div class="col-sm-3 torch-top">-->
                                                <!--                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                                <!--                                   ng-click="vm.getOtherBankDetailsMicrTorch();" id="bankCodeNonMicrSearcher"></i>-->
                                                <!--                                <i class="glyphicon glyphicon-remove clear cp"-->
                                                <!--                                   ng-click="vm.bankCodeNonMicr = ''; vm.branchCodeNonMicr = ''" id="bankCodeNonMicrolIdClose"></i>-->
                                                <!--                            </div>-->
                                               <!-- <div class="col-sm-3 torch-top">latest
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="bankCodeNonMicrSearcher"
                                                       ng-click="vm.getOtherBankDetailsTorchDADM('bankName');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.subscriptionDetailsValueModel.C036.oldValue='';vm.subscriptionDetailsValueModel.C037.oldValue='';"></i>
                                                </div>-->
                                            </div>
                                        </td>
                                        <!--<td width="25%" class="form-group required">
                                            <label class="control-label">Bank Code (Non-MICR)</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="bankCodeNonMicr"
                                                           name="bankCodeNonMicr"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                           ng-model="vm.subscriptionDetailsValueModel.C036.oldValue"
                                                           chars="alpha-numeric" disabled readonly required>
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getOtherBankDetailsMicrTorchM();" id="bankCodeNonMicrSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="vm.subscriptionDetailsValueModel.C036.oldValue = ''; vm.vm.subscriptionDetailsValueModel.C037.oldValue = ''" id="bankCodeNonMicrolIdClose"></i>
                                                </div>
                                            </div>
                                        </td>-->

                                    </tr>

                                    <tr ng-if="vm.subscriptionDetailsValueModel.C027.oldValue == 'CL'">
                                        <td width="25%" class="form-group" >
                                            <label class="control-label">Branch Code (Non-MICR)</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                            <input type="text" class="form-control"
                                                   id="branchCodeNonMicr" name="branchCodeNonMicr" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.subscriptionDetailsValueModel.C037.oldValue" readonly disabled>

                                                </div>
                                                <!--                            <div class="col-sm-3 torch-top">-->
                                                <!--                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                                <!--                                   ng-click="vm.getOtherBankDetailsMicrTorch();" id="bankCodeNonMicrSearcher"></i>-->
                                                <!--                                <i class="glyphicon glyphicon-remove clear cp"-->
                                                <!--                                   ng-click="vm.bankCodeNonMicr = ''; vm.branchCodeNonMicr = ''" id="bankCodeNonMicrolIdClose"></i>-->
                                                <!--                            </div>-->
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="bankCodeNonMicrSearcher"
                                                       ng-click="vm.getOtherBankDetailsTorchDADM('micrBranchCode');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.subscriptionDetailsValueModel.C036.oldValue='';vm.subscriptionDetailsValueModel.C037.oldValue='';"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group" >
                                            <label class="control-label">Sort Code</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="sortCode" name="sortCode" chars="alpha-numeric" maxlength="9"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   ng-model="vm.subscriptionDetailsValueModel.C038.oldValue">
                                        </td>

                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" ng-model="vm.subscriptionDetailsValueModel.C039.oldValue"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   id="remarks" name="remarks" maxlength="200" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Do You want to add Nominee?</label></td>
                                        <td width="25%">
                                            <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                                                <input type="radio" name="isNominee" id="isNominee{{$index}}" ng-change="vm.validateNominee();"
                                                       ng-model="vm.subscriptionDetailsValueModel.C040.oldValue" ng-value="item.value" required ng-disabled="vm.getDetails.verifiedStatus=='Y'">{{item.label}}
                                            </ng-container>
                                        </td>
                                    </tr>

                                    </tbody>
                                </table>
                            </ng-form>
                        </div>




                        <div uib-accordion-group id="bond-transaction-details" class="panel"
                             heading='NOMINEE DETAILS'
                             is-open="vm.bondNomineeDetailsOpen"
                             ng-class="(vm.bondNomineeDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.subscriptionDetailsValueModel.C040.oldValue =='Y'">

                            <ng-form name="vm.bondNomineeDetails" >

                                <table ng-repeat = "item in vm.getDetails.nomineeDetailsValueModel" id="nominee{{$index}}" class="table table-bordered">
                                    <tbody>


                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Nominee First Name</label></td>
                                        <td width="25%"><input type="text" class="form-control" id="firstName[$index]" chars="only-letters"
                                                               maxlength="150" name="firstName[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               ng-model="item.C003.oldValue"  required></td>
                                        <td width="25%">Nominee Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control" id="middleName[$index]" chars="only-letters"
                                                               maxlength="150" name="middleName[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               ng-model="item.C004.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%">Nominee Last Name</td>
                                        <td width="25%"><input type="text" class="form-control" id="lastName[$index]" chars="only-letters"
                                                               maxlength="150" name="lastName[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               ng-model="item.C005.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')"></td>

                                        <td width="25%" class="form-group ">
                                            <label class="control-label">Address1</label></td>
                                        <td width="25%"><input type="text" class="form-control" id="address1[$index]"
                                                               chars="alpha-numeric"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               maxlength="200" name="address1[$index]"
                                                               ng-model="item.C006.oldValue"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Address2</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="address2[$index]"
                                                   chars="alpha-numeric"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   maxlength="200" name="address2[$index]"
                                                   ng-model="item.C007.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" >
                                        </td>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label">City</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="city[$index]"
                                                   chars="only-letters-spsace"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   maxlength="35" name="city[$index]"
                                                   ng-model="item.C008.oldValue"   oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label">State</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="state[$index]"
                                                    name="state[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    ng-model="item.C009.oldValue"  >
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                                <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.statesRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                            </select>
                                        </td>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label">Pin Code</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="pinCode[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   chars="alpha-numeric"
                                                   limit-to="10" name="pinCode[$index]"  ng-blur="vm.getModAddressNominee(item,item.C010.oldValue)"
                                                   ng-model="item.C010.oldValue"  oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label">Phone No</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="phoneNo[$index]"
                                                   onkeypress="return event.charCode>=48 && event.charCode<=57"
                                                   limit-to="20" name="phoneNo[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   ng-model="item.C011.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Nominee Status</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="nomineeStatus[$index]"
                                                    name="nomineeStatus[$index]"
                                                    ng-model="item.C029.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.getNomineeStatusMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label required">Nominee Sharable Amount (Rs.)</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="nomineeSharableAmount[$index]"
                                                   name="nomineeSharableAmount[$index]"
                                                   chars="only-numbers"
                                                   maxlength="20"
                                                   oninput="this.value = this.value.replace(/[^\d]/g, '').slice(0, 20);"
                                                   ng-model="item.C031.oldValue"
                                                   ng-change="vm.calculateSharePercentage(item, true); vm.validateTotalSharableAmount(true, false)"
                                                   ng-blur="vm.validateNomineeSharableAmount(item, true, true)"
                                                   ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   required>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label required">Share Percentage</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="sharePercentage[$index]"

                                                  name="sharePercentage[$index]"
                                                   ng-model="item.C012.oldValue "
                                                   ng-value="item.C012.oldValue | number:2"
                                                   required readonly
                                                   ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            <span class="alert-danger" name="errorMsg{{$index}}" ng-show="vm.errorMsg[{{$index}}]">Entered Input should not exceed 100</span>
                                        </td>
                                    </tr>
                                    <tr>

                                        <td width="25%">
                                            <label class="control-label">Operative Account No</label>
                                        </td>
                                        <td width="25%">

                                            <input type="text" class="form-control" id="operativeNo[$index]" name="operativeNo[$index]" maxlength="16"

                                                   chars="alpha-numeric"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   ng-model="item.C013.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <!--                                                <span class="alert-danger" ng-show="vm.errorNomineeOperativeAcctNo[{{$index}}]">Invalid Account Number</span>-->
                                        </td>

                                        <!--                                            ng-blur="vm.getSchemeTypeListOperativeNominee('', item.C013.oldValue, 'nomineeOperativeAcctNo', $index)"-->

                                        <!--                                            <td width="25%" class="form-group">-->
                                        <!--                                                <label class="control-label">Branch Id</label>-->
                                        <!--                                            </td>-->
                                        <!--                                            <td width="25%">-->
                                        <!--                                                <input type="text" class="form-control" id="operativeBranchId[$index]"-->
                                        <!--                                                       chars="alpha-numeric"-->
                                        <!--                                                       maxlength="20" name="operativeBranchId[$index]"-->
                                        <!--                                                       ng-model="item.C014.oldValue"  readonly>-->
                                        <!--                                            </td>-->
                                        <td width="25%" class="form-group required">
                                            <label class="control-label required">Is Nominee a Minor</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="nomineeMinor[$index]"
                                                    name="nomineeMinor[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    ng-model="item.C014.oldValue"
                                                    required>
                                                <option value="" hidden=true">Select</option>
                                                <option value="Y">Yes</option>
                                                <option value="N">No</option>
                                            </select>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label required">Relation with Holder</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithHolder[$index]"
                                                    name="relationWithHolder[$index]"
                                                    ng-model="item.C015.oldValue"  required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.relationRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                            </select>
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label text-wrap break-word">Date Of Birth(DD/MM/YYYY)</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="dateofBirth{{$index}}"
                                                       name="dateofBirth[$index]"
                                                       ng-model="item.C016.oldValue"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       ng-init="vm.dateOfBirthOptionsFunc();"
                                                       datepicker-options="vm.dateOfBirthOptions"
                                                       is-open="item.dateOfBirthOptions.opened"
                                                       close-text="Close" maxlength="10"
                                                       ng-blur="vm.textableDatePickerManual('dateofBirth' + $index, item.C016.oldValue,item);vm.minorChecking('dateofBirth' + $index, item.C016.oldValue,item);"
                                                       ng-keyup="vm.autoslashing('dateofBirth' + $index )" chars="numbers-slash"
                                                       >
                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="item.dateOfBirthOptions.opened = true"
                                id="nomineeDateOfBirthOptions">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>

                                    <tr ng-if="item.C014.oldValue == 'Y'">
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Guardian First Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianFirstName[$index]" chars="only-letters"
                                                   maxlength="150" name="guardianFirstName[$index]"
                                                   ng-model="item.C017.oldValue"  required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">Guardian Middle Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianMiddleName[$index]" chars="only-letters"
                                                   maxlength="150" name="guardianMiddleName[$index]"
                                                   ng-model="item.C018.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')">
                                        </td>
                                    </tr>
                                    <tr ng-if="item.C014.oldValue == 'Y'">
                                        <td width="25%">
                                            <label class="control-label">Guardian Last Name</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianLastName[$index]" chars="only-letters"
                                                   maxlength="150" name="guardianLastName[$index]"
                                                   ng-model="item.C019.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')">
                                        </td>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label ">Address1</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianAddress1[$index]"
                                                   chars="alpha-numeric"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   maxlength="200" name="guardianAddress1[$index]"
                                                   ng-model="item.C020.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>
                                    </tr>
                                    <tr ng-if="item.C014.oldValue == 'Y'">
                                        <td width="25%">
                                            <label class="control-label">Address2</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianAddress2[$index]"
                                                   chars="alpha-numeric"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   maxlength="200" name="guardianAddress2[$index]"
                                                   ng-model="item.C021.oldValue" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">City</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianCity[$index]"
                                                   chars="only-letters-spsace"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   maxlength="35" name="guardianCity[$index]"
                                                   ng-model="item.C022.oldValue" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr ng-if="item.C014.oldValue == 'Y'">
                                        <td width="25%">
                                            <label class="control-label">State</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="guardianState[$index]"
                                                    name="guardianState[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                    ng-model="item.C023.oldValue" >
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                                <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.statesRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                            </select>
                                        </td>
                                        <td width="25%" class="form-group ">
                                            <label class="control-label ">Pin Code</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianPinCode[$index]"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   onkeypress="return isNumber(event)" chars="only-numbers"
                                                   limit-to="6" name="guardianPinCode[$index]" ng-blur="vm.getModAddressGuardianNominee(item,item.C024.oldValue)"
                                                   ng-model="item.C024.oldValue" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label">Mobile No</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="guardianMobileNo[$index]"
                                          ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                   minlength="10" maxlength="35" name="phoneNo[$index]"
                                                   ng-model="item.C025.oldValue" chars="numbers-with-special-characters">
                                        </td>

                                        <td width="25%" class="form-group"><label class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                               id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                               ng-model="item.C026.oldValue" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    </tr>
                                    <tr  ng-if="item.C014.oldValue == 'Y'">
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation of Guardian with Minor</label></td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor" ng-init=""
                                                    name="relationWithMinor" ng-model="item.C030.oldValue"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>
                                    </tr>

                                    </tbody>
                                </table>
                                <div class="row">
                                    <div class="form-group">
                                        <div class="col-sm-3">
                                            <label for="total" class="control-label">Total %</label>
                                        </div>
                                        <div class="col-sm-2">
                                            <input type="text" class="form-control text-right" id="total" ng-init="vm.calculateSumM();"
                                                   chars="float" maxlength="5" ng-model="vm.total"  readonly>
                                        </div>
                                    </div>
                                </div>


                            </ng-form></div>
                    </form>
                </uib-accordion>
                <table class="table table-bordered table-striped list old-new-value-table">
                    <tbody width="100%">
                    <tr>
                        <th width="50%">Authorization Remarks</th>
                    </tr>
                    <td width="50%">
                        <input
                                type="text"
                                class="form-control"
                                id="otherDetails"
                                name="remarks"
                                ng-model="vm.authRemarks"
                                ng-disabled="true"
                                oninput="this.value = this.value.replace(/^\s/, '')" maxlength="200"
                        />
                    </td>
                    </tbody>
                </table>




                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="submitButton"
                            ng-disabled="vm.bondSubscriptionFlowForm.$invalid || vm.depositMultiplesErrMsg"   ng-click="vm.modifycustomerMaster();" >Submit</button>

                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            ng-click="vm.tabReferenceModify ='customerMasterForm'">Back
                    </button>
                </div>
            </div>
            </form>

            </uib-accordion>
        </div>
    </div>
    </div>

    <div class="col-lg-6"
         style="overflow-y: scroll; height: 500px; position: relative;"
         ng-class="vm.ftsDetailFetch == true ? 'displayN' : 'displayB'">
        <div class="container-fluid text-center" style="position: relative;">
            <!-- Left Arrow -->
            <div style="position: absolute; top: 10px; left: 10px; z-index: 10;">
                <button class="btn btn-primary btn-sm" ng-click="vm.ftsFunction('left')">
                    <i class="glyphicon glyphicon-chevron-left" style="color:white"></i>
                </button>
            </div>
            <!-- Center Controls -->
            <div style="position: absolute; left: 50%; transform: translateX(-50%);
                display: flex; gap: 20px; align-items: center; z-index: 10;
                 padding: 12px 15px; border-radius: 8px;">
                <button class="btn btn-primary btn-sm" ng-click="vm.rotateImage(-90)">⟲</button>
                <button class="btn btn-primary btn-sm" ng-click="vm.zoomImage(1.2)">＋</button>
                <!-- Title -->
                <p style="color: #337ab7; font-weight: bold; white-space: nowrap;z-index: 10;">
                    {{vm.ftsFile[vm.ftsIndex].Indexing_Name}}
                </p>
                <button class="btn btn-primary btn-sm" ng-click="vm.zoomImage(0.8)">－</button>
                <button class="btn btn-primary btn-sm" ng-click="vm.rotateImage(90)">⟳</button>
            </div>
            <!-- Right Arrow -->
            <div style="position: absolute; top: 10px; right: 10px; z-index: 10;">
                <button class="btn btn-primary btn-sm" ng-click="vm.ftsFunction('right')">
                    <i class="glyphicon glyphicon-chevron-right" style="color:white"></i>
                </button>
            </div>
            <!-- Image -->
            <img src="data:image/png;base64,{{vm.ftsFile[vm.ftsIndex].encrypted_value}}"
                 style="width: 100%; transform: rotate({{vm.imageRotation}}deg) scale({{vm.imageZoom}});
                    transition: transform 0.2s ease; margin-top: 60px;">
        </div>
    </div>
</div>



<div class="modal" id="blaModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA No List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.versionNoSearch"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                    <th ng-click="(sortedColumn == 'nameOfBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfBondHolder';" ng-class="(sortedColumn == 'nameOfBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaNoList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.customerMaster.blaAccNo = x.blaNo; vm.jointHolderTypeCode = x.jointHolderTypeCode; vm.getBlaAccNoDetails(); " data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.nameOfBondHolder}}</td>
                                    <td>{{x.jointHolderType}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<div class="modal" id="blaJointModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA No List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.versionNoSearch"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                    <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaNoList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.customerMaster.blaAccNo = x.blaNo; vm.jointHolderTypeCode = x.jointHolderTypeCode; vm.getBlaAccNoDetails(); " data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.nameOfTheBondHolder}}</td>
                                    <td>{{x.jointHolderType}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>


<div class="modal" id="blaModalTwo" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA No List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaNoListTwo.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.versionNoSearch"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                    <th ng-click="(sortedColumn == 'nameOfBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfBondHolder';" ng-class="(sortedColumn == 'nameOfBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaNoListTwo | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.customerMasterTwo.blaAccNo = x.blaNo; vm.jointHolderTypeCodeTwo = x.jointHolderTypeCode; vm.getBlaAccNoDetailsTwo(); " data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.nameOfBondHolder}}</td>
                                    <td>{{x.jointHolderType}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
