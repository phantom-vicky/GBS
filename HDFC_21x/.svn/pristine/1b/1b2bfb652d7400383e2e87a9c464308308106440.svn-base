.modal-content {
    height: 90%;
}

.modal-body {
    height: 88%;
    overflow-y: auto;
}*/
.torch-top {
  top: 7px;
  padding-left: 0px;
}

.new_form_wrapper .form-torch-col {
  padding-left: 0;
}

.report-subtitle-row {
  margin-bottom: 15px;
}

.report-label-col-w-25 {
  width: 25%;
}
.glyphicon {
  color: #1f629a;
  font-size: 18px;
}
.top-msg {
  position: fixed;
  width: 100%;
  top: 0;
  z-index: 10000;
  border-radius: 0px;
}
.top-msg p {
  margin: 0 !important;
}
.loader, .loader-new {
  position: fixed;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  z-index: 99999999999;
  background: rgba(0, 0, 0, 0.5);
}
.loader:before,
.loader-new:before{
  background:  url('../images/loader.gif') 50% 50% no-repeat #fff;
  width: 6em;
  height: 6em;
  border-radius: 8px;
  content: '';
  margin: auto;
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  z-index: -1;
}
.loader{
	display: none;
}
.loader_popup {
  position: fixed;
  left: 0px;
  top: 0px;
  width: 100%;
  height: 100%;
  z-index: 9999;
  background: url('../images/loader.gif') 50% 50% no-repeat rgba(0, 0, 0, 0.5);
  display: none;
}
.small_loader{
	background: url('../images/small_loader.gif');
	position: relative;
	vertical-align: middle;
	-webkit-border-radius: 20%;
	-moz-border-radius: 20%;
	border-radius: 20%;
	display: inline-block;
	margin: 3px 0px;
	width: 24px;
    height: 24px;
}

.modal-dialog-large {
  width: 1024px;
}
.dropdown-submenu {
  position: relative;
}
.dropdown-submenu > .dropdown-menu {
  top: 0;
  left: 100%;
  margin-top: -6px;
  margin-left: -1px;
  -webkit-border-radius: 0 6px 6px 6px;
  -moz-border-radius: 0 6px 6px;
  border-radius: 0 6px 6px 6px;
}
.dropdown-submenu:hover > .dropdown-menu {
  display: block;
}
.dropdown_menu1:hover > .dropdown-menu {
  display: block;
}
.dropdown-toggle {
  display: block;
}
@media (min-width: 768px)
.container-fluid>.navbar-collapse, .container-fluid>.navbar-header, .container>.navbar-collapse, .container>.navbar-header {
    margin-right: 0 ! important;
    margin-left: 3% ! important;
}


.dropdown-submenu > a:after {
  display: block;
  content: " ";
  float: right;
  width: 0;
  height: 0;
  border-color: transparent;
  border-style: solid;
  border-width: 5px 0 5px 5px;
  border-left-color: #ccc;
  margin-top: 5px;
  margin-right: -10px;
}
.dropdown-submenu:hover > a:after {
  border-left-color: #fff;
}
.dropdown-submenu.pull-left {
  float: none;
}
.dropdown-submenu.pull-left > .dropdown-menu {
  left: -100%;
  margin-left: 10px;
  -webkit-border-radius: 6px 0 6px 6px;
  -moz-border-radius: 6px 0 6px 6px;
  border-radius: 6px 0 6px 6px;
}
.dropdown-menu {
  max-width: 614px;
  min-width: 0;
}
/***************************
 table design
****************************/
.guideline-table {
  margin-bottom: 25px;
  line-height: 20px;
  font-size: 12px;
  color: #000;
}
.no_records_message {
  line-height: 100px;
  text-align: center;
  font-weight: 500;
  font-size: 25px;
}
.capitalize {
  text-transform: capitalize;
}
i.glyphicon.glyphicon-home,
.glyphicon-user {
  color: #fff;
}
.glyphicon {
  top: 0px;
}
.padding-right-20 {
  padding-right: 20px;
}
.padding-left-20 {
  padding-left: 20px;
}
.text-bold {
  font-weight: bold;
}

/******************
pagination
*******************/
.pagination-custom,
.pagination {
    display: block;
    padding-left: 0;
    margin: 20px 0;
    text-align: center;
}
.pagination-custom li,
.pagination li{
	display: inline-block;
}
.record-filter {
    display: inline-block;
    width: 70px;
}
.pagination-custom .page-disabled,
.pagination .page-disabled{
	opacity: 0.5;
}


.generalSetupForm .row{
	margin-bottom: 10px;
}

.padding-top-50{
	padding-top: 50px;
}

.table-bordered>tbody>tr>td,
.table-bordered>tfoot>tr>td,
.table-bordered>thead>tr>td
{
	word-break: break-all;
}
.master-table >tbody >tr >td:nth-child(odd),
 uib-accordion .panel-body .table>tbody >tr >td:nth-child(odd){
    background-color: #edf4ff;
}
uib-accordion .panel-default .table>tbody >tr >td:nth-child(odd){
    background: none;
}
uib-accordion .panel-body .list>tbody >tr >td:nth-child(odd){
    background: none;
}
uib-accordion .table thead{
    background: #ebeff2;
}
.notice-message{
	margin-bottom: 15px;
	padding: 10px;
	text-align: center;
}
