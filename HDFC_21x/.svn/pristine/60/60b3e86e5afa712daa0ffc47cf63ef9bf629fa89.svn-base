<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

	<h4 class="form_heading">Branch IFSC Codes - Verify</h4>
	<sol-header></sol-header>
	<form name="ppfSchemeParameterCreationForm" role="form">

		<table class="table table-bordered table-striped list old-new-value-table">
			<thead>
			<tr>
				<th>Particular</th>
				<th>{{(vm.verifyDeleteLists.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
				<th ng-if="vm.verifyDeleteLists.previousOperationType == 'M'">New Value</th>
			</tr>
			</thead>
			<tbody>
			<tr>
				<td>Bank Code</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C001)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C001.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue &&
					vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C002)? (vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C001.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Branch code</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C002)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C002.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C002)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C002.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Branch IFSC code</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C003)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C003.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C003)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C003.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Payment System Id (RTGS)</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C004)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C004.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C004)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C004.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Additional Text1</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C006)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C006.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C006)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C006.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Additional Text2</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C007)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C007.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C007)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C007.newValue) : ('')}}
				</td>
			</tr>
			<tr>
				<td>Additional Text3</td>
				<td class="old-value">{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C008)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C008.oldValue) : ('')}}
				</td>
				<td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
					{{(vm.verifyDeleteLists.branchIfscDetailsOldNewValue && vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C008)?
					(vm.verifyDeleteLists.branchIfscDetailsOldNewValue.C008.newValue) : ('')}}
				</td>
			</tr>
			</tbody>
		</table>
		<div class="audit-details">
			<div class="row">
				<div class="col-md-3">
					<span> <b> Created By </b> : {{vm.verifyDeleteLists.createdBy}} </span>
				</div>
				<div class="col-md-3">
					<span> <b> Last Modified By </b> : {{(vm.verifyDeleteLists.modifiedBy) ? (vm.verifyDeleteLists.modifiedBy) : ('None')}}</span>
				</div>
				<div class="col-md-3">
					<span> <b> Last Verified By </b> : {{(vm.verifyDeleteLists.verifiedBy) ? (vm.verifyDeleteLists.verifiedBy) : ('None')}}</span>
				</div>
				<div class="col-md-3">
					<span> <b> Verify Status </b> : {{vm.verifyDeleteLists.isVerified  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
				</div>
			</div>
			<div class="row">
				<div class="col-md-3">
					<span> <b> Created On </b> : {{ vm.verifyDeleteLists.creatDate | date : 'dd/MM/yyyy'}}</span>
				</div>
				<div class="col-md-3">
					<span> <b> Last Modified On</b> : {{ (vm.verifyDeleteLists.modDate) ? (vm.verifyDeleteLists.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
				</div>
				<div class="col-md-3">
					<span> <b> Last Verified On </b> : {{(vm.verifyDeleteLists.verDate) ? (vm.verifyDeleteLists.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
				</div>
				<div class="col-md-3">
				</div>
			</div>
		</div>

		<div class="text-center form_submit">
			<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="vm.ppfSchemeParameterCreationForm.$invalid" ng-click="vm.verifySubmit()">Submit</button>
			<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="vm.showCancelConfirmation('branch_ifsc_codes.list');">Cancel</button>
		</div>

		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>
