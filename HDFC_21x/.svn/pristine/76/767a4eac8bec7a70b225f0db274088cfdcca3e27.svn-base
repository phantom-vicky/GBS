                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[2] &&
                                            vm.getDetails.masterDetailsValueModel[2].C062? (vm.getDetails.masterDetailsValueModel[2].C062.newValue | getLabelFromValuesArray : vm.supportingDocumentsMetaData) : ('')}}
                                        </td>
                                    </tr>


                                    <tr>
                                        <td>Detail for Others</td>
                                        <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[2] && vm.getDetails.masterDetailsValueModel[1].C041)?
                                            (vm.getDetails.masterDetailsValueModel[2].C041.oldValue | getLabelFromValuesArray : vm.supportingDocumentsMetaData) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[2] &&
                                            vm.getDetails.masterDetailsValueModel[2].C041? (vm.getDetails.masterDetailsValueModel[2].C041.newValue | getLabelFromValuesArray : vm.supportingDocumentsMetaData) : ('')}}
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.getDetails.masterDetailsValueModel[2].C053.newValue!=null || vm.getDetails.masterDetailsValueModel[2].C053.oldValue!=null">
                                        <td>BLA Closure Date (dd/mm/yyyy)</td>
                                        <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[2] && vm.getDetails.masterDetailsValueModel[2].C053)?
                                            (vm.getDetails.masterDetailsValueModel[2].C053.oldValue) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[2] &&
                                            vm.getDetails.masterDetailsValueModel[2].C053? (vm.getDetails.masterDetailsValueModel[2].C053.newValue) : ('')}}
                                        </td>
                                    </tr>
                                    <tr ng-if="vm.getDetails.masterDetailsValueModel[2].C054.newValue!=null || vm.getDetails.masterDetailsValueModel[2].C054.oldValue!=null">
                                        <td>BLA Closure Remarks</td>
                                        <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[2] && vm.getDetails.masterDetailsValueModel[2].C054)?
                                            (vm.getDetails.masterDetailsValueModel[2].C054.oldValue) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[2] &&
                                            vm.getDetails.masterDetailsValueModel[2].C054? (vm.getDetails.masterDetailsValueModel[2].C054.newValue) : ('')}}
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>Remarks</td>
                                        <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[2] && vm.getDetails.masterDetailsValueModel[2].C042)?
                                            (vm.getDetails.masterDetailsValueModel[2].C042.oldValue) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[2] &&
                                            vm.getDetails.masterDetailsValueModel[2].C042? (vm.getDetails.masterDetailsValueModel[2].C042.newValue) : ('')}}
                                        </td>
                                    </tr>
                                    <!--                                <tr>-->
                                    <!--                                    <td>Remarks</td>-->
                                    <!--                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C042)?-->
                                    <!--                                        (vm.getDetails.masterDetailsValueModel[0].C042.oldValue) : ('')}}-->
                                    <!--                                    </td>-->
                                    <!--                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&-->
                                    <!--                                        vm.getDetails.masterDetailsValueModel[0].C042? (vm.getDetails.masterDetailsValueModel[0].C042.newValue) : ('')}}-->
                                    <!--                                    </td>-->
                                    <!--                                </tr>-->

                                </div>
                                </tbody>
                            </table>

                        </div>

                    </form>
                </uib-accordion>
            </div>
        </div>


    </div>

    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created By </b> : {{vm.getDetails.createdBy}} </span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified By </b> : {{(vm.getDetails.lastModifiedBy) ? (vm.getDetails.lastModifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified By </b> : {{(vm.getDetails.lastVerifiedBy) ? (vm.getDetails.lastVerifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.getDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created On </b> : {{ vm.getDetails.createdDate | date : 'dd/MM/yyyy'}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified On</b> : {{ (vm.getDetails.lastModifiedDate) ? (vm.getDetails.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified On </b> : {{(vm.getDetails.lastVerifiedDate) ? (vm.getDetails.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
            </div>
        </div>
    </div>

    <div class="text-center form_submit">
        <button type="submit" class="btn btn-default" id="main_submitButton" ng-click="vm.verifyCustomerMaster();">Verify</button>
        <button type="button" id="otherpen_cancelButton" class="btn btn-cancel"
                ng-click="vm.showCancelConfirmation('bond_ledger_acc_main.verify');">Cancel</button>
    </div>

</div>