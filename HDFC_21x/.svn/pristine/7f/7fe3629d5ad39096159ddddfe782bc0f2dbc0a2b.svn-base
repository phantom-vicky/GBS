<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper">
	<cbs-left-menu></cbs-left-menu>	
	<h4 class="form_heading  feature-heading">List Of Transaction Codes - Modify</h4>
	
		<notice-message-directive ></notice-message-directive>
	
	<form name="transactionCodesForm" role="form" ng-submit="submitForm(transactionCodesForm.$valid)" novalidate>
		<div class="row">
			<div class="form-group" ng-class="requiredClass">
			<div class="col-sm-3"></div>
				<label for="clgTranCode" class="control-label col-sm-3">Clearing Transaction Code</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="clgTranCode" id="clgTranCode" ng-model="vm.cbsTransactionCodesList.clgTranCode" maxlength="5" required >
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="clgTranCodeDesc" class="control-label col-sm-3">Transaction Code Description</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="clgTranCodeDesc" id="clgTranCodeDesc" ng-model="vm.cbsTransactionCodesList.clgTranCodeDesc" maxlength="40" >
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="instrumentType" class="control-label col-sm-3">Type of Instrument</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="instrumentType" id="instrumentType" ng-model="vm.cbsTransactionCodesList.instrumentType" maxlength="5" >
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText1" class="control-label col-sm-3">Additional Text1</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText1" id="addText1" ng-model="vm.cbsTransactionCodesList.addText1" maxlength="40" >
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText2" class="control-label col-sm-3">Additional Text2</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText2" id="addText2" ng-model="vm.cbsTransactionCodesList.addText2" maxlength="40" >
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
			<div class="col-sm-3"></div>
				<label for="addText3" class="control-label col-sm-3">Additional Text3</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="addText3" id="addText3" ng-model="vm.cbsTransactionCodesList.addText3" maxlength="40" >
				</div>
			</div>
		</div>
		<div class="row">
			 <div class="col-sm-offset-5 col-sm-8 form_submit">
				 <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="transactionCodesForm.$invalid">Update</button>
				  <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="cancelOperation(action)" >Cancel</button>
			</div>
		</div>
	</form>
</div>

