package com.isl.gbm.user.management.dto;

import java.util.HashMap;
import java.util.List;

public class EodSessionDto {
    List<EodSessionDto> activeUserDtoList;

    HashMap<String, ActiveUserDto> activeUsersMap;

    HashMap<String, ActiveUserDto> branchIdList;

    public HashMap<String, ActiveUserDto> getBranchIdList() {
        return branchIdList;
    }

    public void setBranchIdList(HashMap<String, ActiveUserDto> branchIdList) {
        this.branchIdList = branchIdList;
    }

    public HashMap<String, ActiveUserDto> getActiveUsersMap() {
        return activeUsersMap;
    }

    public void setActiveUsersMap(HashMap<String, ActiveUserDto> activeUsersMap) {
        this.activeUsersMap = activeUsersMap;
    }

    public List<EodSessionDto> getActiveUserDtoList() {
        return activeUserDtoList;
    }

    public void setActiveUserDtoList(List<EodSessionDto> activeUserDtoList) {
        this.activeUserDtoList = activeUserDtoList;
    }
}
