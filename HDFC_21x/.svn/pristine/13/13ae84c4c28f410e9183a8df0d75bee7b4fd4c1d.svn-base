<div class="loader-new" ng-show="loader"></div>
<left-menu-directive></left-menu-directive>
<div class="container from_wrapper" ng-if="sackUsers.length > 0">
		<h4 class="form_heading">
			Sack User
		</h3>
		<div class="form_block" ng-if="showForm == true">
			<div class="col-sm-6 col-sm-offset-3">
				<form name="sackUserForm" role="form" ng-submit="submitForm(sackUserForm.$valid)" novalidate>
					<div class="row">
						<div class="form-group white-bg text-center">
							<label for="sol_Id" class="control-label text-bold">Sol ID : {{solId}} / {{solDescription}}</label>
						</div>
					</div>
					<div class="row">
						<div class="col-sm-12 ">
							<table class="table table-bordered table-striped list" width="100%">
								<thead>
									<tr>
										<th>
											<input  oninput="this.value = this.value.replace(/\s+/g, '')"
												type="checkbox" 
												name="select_all_user_name" 
												ng-model="IsAllChecked"
												ng-change="CheckUncheckAll($event)" 
												title="Select All">
										</th>
										<th>User Names</th>
										<th>Login Times</th>
									</tr>
								</thead>
								<tbody>
									<tr ng-repeat="sackUser in sackUsers">
										<td>
											<input  oninput="this.value = this.value.replace(/\s+/g, '')"
												type="checkbox"
												id="user_{{sackUser.id}}" 
												name="user_name"
												ng-model="sackUser.Selected" 
												ng-change="CheckUncheckHeader($event)" 
												>
										</td>
										<td>{{sackUser.userId}}</td>
										<td>{{sackUser.inTime | date: 'dd/MM/y hh:mm:ss a'}}</td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
					<div class="form_submit col-sm-offset-4 col-sm-4">
						<button type="submit" class="btn btn-default"
							ng-disabled="sackUserForm.$invalid">Submit</button>
						<button type="button" ng-click="cancelOperation()" class="btn btn-cancel">Cancel</button>
					</div>
				</form>
			</div>
		</div>
</div>

<div class="container list_wrapper" ng-if="sackUsers.length <= 0">
	<h4 class="feature-heading">Sack User</h4>
	<div class="no_records_message">No Users Currently Logged in.</div>
</div>

