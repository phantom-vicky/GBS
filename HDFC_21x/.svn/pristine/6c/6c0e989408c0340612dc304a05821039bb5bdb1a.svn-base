<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">RBI Bond Centralized EOD</h4>
    <sol-header></sol-header>

    <form name="efreight_centralized_eod" role="form" ng-init="vm.timeValidation()">
        <div class="row">
            <div class="col-sm-6 col-sm-offset-3">
                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label class="control-label">EOD Date</label>
                        </div>
                        <div class="col-sm-4">
                            <label class="form-control">{{vm.masterSolDate}}</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label class="control-label">Module Name</label>
                        </div>
                        <div class="col-sm-4">
                            <select class="form-control" id="moduleName" name="moduleName" style="text-transform:none"
                                    ng-model="vm.moduleName" ng-blur="vm.getLevelName()"  required>
                                <option value="" hidden="true">SELECT</option>
                                <option value="rbibond">RBI Bond</option>
                                <!--                        <option ng-repeat="x in vm.scrollMonthList" value="{{x.srollMonth}}">{{x.srollMonth}}</option>-->
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label class="control-label">Branch Level Name</label>
                        </div>
                        <div class="col-sm-4">
                            <select class="form-control" id="branchLevelName" name="branchLevelName"
                                    ng-model="vm.branchLevelName"  required>
                                <option value=""  hidden="true">SELECT</option>
                                <option ng-repeat="x in vm.levelCodeList" value="{{x.levelId}}">{{x.levelName}}</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="form-group">
                        <div class="col-sm-6">
                            <label for="branch" class="control-label">Branch ID</label>
                        </div>
                        <div class="col-sm-4">
                            <input type="text" class="form-control" id="branch"
                                   ng-model="vm.branchId" chars="only-numbers" maxlength="25" readonly>
                            <!--                <select class="form-control" id="branch" name="branch" id="branch" class="form-group"  required multiple>-->
                            <!--                    <option value="" disabled selected>SELECT</option>-->
                            <!--                    <option ng-repeat="x in vm.branchIdList"  ng-model="vm.branchId"value="{{x.branchId}}">{{x.branchId}}/{{x.branchDescription}}</option>-->
                            <!--                </select>-->
                            <!--                    <div ng-repeat="x in vm.branchIdList">-->
                            <!--                    <input  id="branchIdS_{{x.branchId}}" type="checkbox" ng-click="vm.callMe(x.branchId)" ng-model="vm.branch">-->
                            <!--                    {{x.branchId}}-->
                            <!--                    </div>-->
                        </div>
                        <div class="col-sm-2">
                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                               id="treasurySearch"
                               ng-click="vm.getBranchId();"></i>
                            <i class="glyphicon glyphicon-remove clear cp"
                               ng-click="vm.branch=''; vm.branchId='';"></i>
                        </div>
                    </div>
                </div>

                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="efreight_centralized_eod.$invalid"
                            ng-click="vm.navigateToNextState()">Start</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            onclick="window.location.href= '#!/dc_rbi_bond_menu';">Cancel</button>
                </div>
            </div>
        </div>
    </form>
</div>
<div class="modal" id="treasurySearcher" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Branch ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length>0">
                    <!--                    <div class="col-sm-8 form_submit">-->
                    <!--                        <div class="form-group">-->
                    <!--                            <div class="input-group">-->
                    <!--                                <div class="input-group-addon">-->
                    <!--                                    <i class="glyphicon glyphicon-search"></i>-->
                    <!--                                </div>-->
                    <!--                                <input type="text" class="form-control"-->
                    <!--                                       ng-model="vm.searchtreasuryId" ng-init="vm.searchtreasuryId = ''"-->
                    <!--                                       placeholder="Search">-->
                    <!--                            </div>-->
                    <!--                        </div>-->
                    <!--                    </div>-->
                    <!--                    <div class="col-sm-4 form_submit"></div>-->
                    <!--                    <div class="row">-->
                    <!--                        <div class="col-sm-8 form_submit">-->
                    <!--                            <select id="branchId" class="form-group"  multiple>-->
                    <!--                                <option value="" disabled selected>Choose your country</option>-->
                    <!--                                <option ng-repeat="x in vm.branchIdList" value="{{x.branchId}}">{{x.branchId}}/{{x.branchDescription}}</option>-->
                    <!--                            </select>-->
                    <!--                        </div>-->
                    <!--                    </div>-->
                    <!--                    <div class="col-sm-4 form_submit"></div>-->
                    <table class="table table-bordered table-striped list">
                        <thead>
                        <tr class="thalign">
                            <th>Select All Check Box
                                <input type="checkbox" id="selectedAllItem" ng-change="vm.optionToggled('ALL');"
                                       name="selectedAllItem" ng-model="vm.selectedAllItem" >
                            </th>
                            <th>Branch Id</th>
                            <th>Branch Description</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="x in vm.branchIdList">
                            <td class="text-center">
                                <input type="checkbox" id="selectedItem{{$index}}"
                                       name="selectedItem{{$index}}" ng-model="x.selected" ng-click="vm.branchId = x.branchId; vm.branchDescription = x.branchDescription ;" ng-change="vm.optionToggled();">
                            </td>
                            <td >{{x.branchId}}</td>
                            <td>{{x.branchDescription}}</td>
                        </tr>
                        </tbody>
                    </table>
                    <div class="text-center form_submit">
                        <button type="submit"  class="btn btn-default" id="backButton"
                                data-bs-dismiss="modal" ng-click="vm.selectInputVal()">OK</button>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.branchIdList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
