#new--
# Please note that below path locations need to be created in UAT for proceeding Testing in UAT
# SFTP Folder Location where Payment Files need to be placed
bond.payments.file.sftp.path=/ACH/IN/
# Process Response File Post that move to Done Path in SFTP Folder
bond.payments.file.sftp.response.file.done.path=/ACH/DONE/
bond.payments.file.sftp.response.file.nck.path=/ACH/NCK/
# Payment File Pick up Location in SFTP
sftp.payment.file.location.ext=/ACH/OUT/
# Our App Folder location where the payment File need to be downloaded
sftp.payment.file.location.app=/gsp_pv/files/ACH/IN/
# Our App Folder location where the payment File Processed Successfully then we can move to done location
sftp.payment.file.location.done=/gsp_pv/files/ACH/DONE/


# SFTP Folder Path for Bond Sub Acc Closure Before Maturity Screen in Payment File
#SFTP IN Folder where Payment File need to be placed
sftp.payment.file.bond.sub-acc.closure.before-maturity.in.path=/BEFORE_MATURITY/IN/
#SFTP OUT Folder where Sub Acc Closure Before Maturity Payment File need to be picked
sftp.payment.bond.sub-acc.closure.before-maturity.out.path=/BEFORE_MATURITY/OUT/
#SFTP OUT Folder where Sub Acc Closure Before Maturity Payment File need to be dropped in case of wrong format
sftp.payment.file.bond.sub-acc.closure.before-maturity.nck.path=/BEFORE_MATURITY/NCK/
#SFTP OUT Folder where Sub Acc Closure Before Maturity Payment File need to be dropped in case of Success Processing and Valid File
sftp.payment.file.bond.sub-acc.closure.before-maturity.done.path=/BEFORE_MATURITY/DONE/

#Our GBS App Server Folder Location for Sub Acc Closure Before Maturity where we are processing the File.
app.bond.sub-acc.closure.before-maturity.payment.file.location.app.in.folder=/gsp_pv/files/BEFORE_MATURITY/IN/
app.bond.sub-acc.closure.before-maturity.payment.file.location.app.done.folder=/gsp_pv/files/BEFORE_MATURITY/DONE/

# SFTP Folder Path for Bond Sub Acc Closure On Maturity Screen in Payment File
#SFTP IN Folder where Payment File need to be placed
sftp.payment.file.bond.sub-acc.closure.on-maturity.in.path=/ON_MATURITY/IN/
#SFTP OUT Folder where Sub Acc Closure Before Maturity Payment File need to be picked
sftp.payment.bond.sub-acc.closure.on-maturity.out.path=/ON_MATURITY/OUT/
#SFTP OUT Folder where Sub Acc Closure on Maturity Payment File need to be dropped in case of wrong format
sftp.payment.file.bond.sub-acc.closure.on-maturity.nck.path=/ON_MATURITY/NCK/
#SFTP OUT Folder where Sub Acc Closure on Maturity Payment File need to be dropped in case of Success Processing and Valid File
sftp.payment.file.bond.sub-acc.closure.on-maturity.done.path=/ON_MATURITY/DONE/

#Our GBS App Server Folder Location for Sub Acc Closure ON Maturity where we are processing the File.
app.bond.sub-acc.closure.on-maturity.payment.file.location.app.in.folder=/gsp_pv/files/ON_MATURITY/IN/
app.bond.sub-acc.closure.on-maturity.payment.file.location.app.done.folder=/gsp_pv/files/ON_MATURITY/DONE/

#--new end

