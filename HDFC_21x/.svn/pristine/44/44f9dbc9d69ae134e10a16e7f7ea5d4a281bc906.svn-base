        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Govt Notification No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="govtNotificationNo"
                        ng-keypress="vm.specialNotAllowed(vm.cbdtSchemeParameter.C026);"
                        oninput="this.value = this.value.replace(/\s+/g, '')" maxlength="20" name="maxNoOfChallan"
                        ng-model="vm.cbdtSchemeParameter.C026.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Govt Notification Date(DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="govtNotiDate" name="effNotificationDate"
                            ng-model="vm.cbdtSchemeParameter.C027.oldValue" uib-datepicker-popup="dd/MM/yyyy"
                            ng-blur="vm.textableDatePicker('govtNotiDate',vm.cbdtSchemeParameter.C027.oldValue)"
                            ng-keyup="vm.autoslashing('govtNotiDate')" chars="numbers-slash"
                            datepicker-options="vm.effNotificationDateOptions"
                            is-open="vm.effNotificationDateOptions.opened" close-text="Close" maxlength="10" />
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                ng-click="vm.effNotificationDateOptions.opened = true"
                                id="effNotificationDateOptions11">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>

