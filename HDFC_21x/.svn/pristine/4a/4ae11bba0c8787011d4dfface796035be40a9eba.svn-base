package com.isl.gbm.user.management.dao;

import com.isl.gbm.user.management.model.PasswordHistory;

import java.util.List;


/**
 * The Interface PasswordHistoryDao.
 *
 * @author anoop.kumar
 */
public interface PasswordHistoryDao {

    /**
     * Save.
     *
     * @param passwordHistory the password history
     */
    void save(PasswordHistory passwordHistory);


    /**
     * Gets the password history.
     *
     * @param username the username
     * @param limit    the limit
     * @return the password history
     */
    List<PasswordHistory> getPasswordHistory(String username, int limit);

}
