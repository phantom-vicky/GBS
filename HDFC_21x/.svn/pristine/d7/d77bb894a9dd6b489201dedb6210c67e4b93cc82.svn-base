    <table class="table table-bordered table-striped list old-new-value-table">
      <tbody width="100%">
        <tr>
          <th width="50%">Rejection Remarks</th>
          <td width="50%">{{vm.remarks}}</td>
        </tr>
      </tbody>
    </table>

    <div class="audit-details">
      <div class="row">
        <div class="col-md-3">
          <span> <b> Created By </b> : {{vm.verifyDetailsList.createdBy}} </span>
        </div>
        <div class="col-md-3">
          <span> <b> Last Modified By </b> : {{(vm.verifyDetailsList.modifiedBy) ? (vm.verifyDetailsList.modifiedBy) : ('None')}}</span>
        </div>
        <div class="col-md-3">
          <span> <b> Last Verified By </b> : {{(vm.verifyDetailsList.verifiedBy) ? (vm.verifyDetailsList.verifiedBy) : ('None')}}</span>
        </div>
        <div class="col-md-3">
          <span> <b> Verify Status </b> : {{vm.verifyDetailsList.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
        </div>
      </div>
      <div class="row">
        <div class="col-md-3">
          <span> <b> Created On </b> : {{ vm.verifyDetailsList.createdDate | date : 'dd/MM/yyyy'}}</span>
        </div>
        <div class="col-md-3">
          <span>
            <b> Last Modified On</b> : {{ (vm.verifyDetailsList.modifiedDate) ? (vm.verifyDetailsList.modifiedDate | date : 'dd/MM/yyyy') :
            ('None')}}</span
          >
        </div>
        <div class="col-md-3">
          <span>
            <b> Last Verified On </b> : {{(vm.verifyDetailsList.verifiedDate) ? (vm.verifyDetailsList.verifiedDate | date : 'dd/MM/yyyy') :
            ('None')}}</span
          >
        </div>
        <div class="col-md-3"></div>
      </div>
    </div>

    <div class="text-center form_submit">
      <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="tdsparameter.$invalid" ng-click="vm.submitVerifyForm()">
        Verify
      </button>
      <button type="submit" class="btn btn-default" id="rejectButton" ng-disabled="tdsparameter.$invalid" ng-click="vm.rejectReason()">Reject</button>
      <button type="button" id="subButton" class="btn btn-cancel" ng-click="vm.showCancelConfirmation('broker_master_rbi_bond.verify');">
        Cancel
      </button>
    </div>
  </form>
</div>

<!--Delete Get Remarks-->
<div class="modal" id="permissionMappingDelete" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
        <h4 class="modal-title">REJECTION REMARKS</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper">
          <form name="permissionDelete" role="form">
            <div class="row">
              <div class="form-group">
                <div class="col-sm-2"></div>
                <label class="control-label col-sm-3">Remarks</label>
                <div class="col-sm-5">
                  <!--
                                                                        <textarea class="form-control"   ng-keypress="vm.validateInput($event,'remarks')" id="remarks" name="remarks" ng-model="vm.remarks" maxlength="80" required></textarea>
                                    -->
                  <select
                    class="form-control list_wrapper"
                    id="remarks[$index]"
                    name="remarks[$index]"
                    ng-model="vm.remarks"
                    ng-init="vm.getRemarksList();"
                    required
                  >
                    <option value="">Select</option>
                    <option
                      ng-repeat="item in vm.remarksList"
                      name="{{item.subCode + parentIndex}}"
                      id="{{item.subCode + parentIndex}}"
                      value="{{item.subCodeDescription}}"
                    >
                      {{item.subCodeDescription}}
                    </option>
                  </select>
                </div>
              </div>
            </div>

            <div class="col-sm-offset-5 col-sm-8 form_submit">
              <button type="button" class="btn btn-default" data-bs-dismiss="modal" ng-disabled="permissionDelete.$invalid" ng-click="vm.submitDeleteForm()">
                Submit
              </button>
              <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

