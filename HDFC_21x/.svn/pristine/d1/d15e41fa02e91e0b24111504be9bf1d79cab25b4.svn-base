<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.showDetails">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!';" id="homeButton">Home</button>
        <button type="submit" id="backButton" class="btn btn-cancel"
                onclick="window.location.href='#!/scheme_wise_outstanding_balance_report/action/inquiry';">Back</button>
        <button type="submit" class="btn btn-default"
                id="printButton" ng-click="vm.printpage();">Print</button>
        <button type="button" class="btn btn-default"
                id="downloadButton" ng-click="vm.downloadOutstandingBalanceReport();">Download</button>
    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="col-sm-12">
            <h4 class="form_heading">Scheme Wise Outstanding Balance Report</h4>
            <sol-header></sol-header>

            <!-- Scheme Wise Outstanding Balance Table (print section) -->
            <div class="row" id="section-to-print">
                <div class="col-sm-12">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list nowrap table-textWrap">
                            <thead>
                                <tr class="thalign">
                                    <th style="width: 10%; text-align: center;">Sr No</th>
                                    <th style="width: 15%; text-align: center;">Scheme Code</th>
                                    <th style="width: 45%; text-align: center;">Scheme Name</th>
                                    <th style="width: 30%; text-align: center;">Balance as on {{vm.toDateDisplay}}</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="x in vm.outstandingBalanceData">
                                    <td style="text-align: center;">{{$index + 1}}</td>
                                    <td style="text-align: center;">{{x.schemeCode}}</td>
                                    <td>{{x.schemeName}}</td>
                                    <td style="text-align: right;">
                                        {{x.balance != null && x.balance !== '' ? x.balance : (x.outstandingBalance != null && x.outstandingBalance !== '' ? x.outstandingBalance : '-')}}
                                    </td>
                                </tr>
                                <tr ng-if="!vm.outstandingBalanceData || vm.outstandingBalanceData.length === 0">
                                    <td colspan="4" class="text-center">No records found to display.</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="text-center form_submit">
                <button type="button" class="btn btn-cancel"
                        onclick="window.location.href='#!/scheme_wise_outstanding_balance_report/action/inquiry';">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Scheme Wise Outstanding Balance Report</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-cancel"
                    onclick="window.location.href='#!/scheme_wise_outstanding_balance_report/action/inquiry';">Back</button>
        </center>
    </div>
</div>
