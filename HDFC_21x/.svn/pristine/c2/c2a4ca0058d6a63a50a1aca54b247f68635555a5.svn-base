package com.isl.gbm.common.dto;

import java.util.List;
import java.util.Map;

public class CommonDataDTO {

    private List<String> referenceIdList;

    private List<GenericDataDTO> genericRequestList;

    private Map<String,String> metaDataList;

    private Map<String,String> genericDataList;

    public List<GenericDataDTO> getGenericRequestList() {
        return genericRequestList;
    }

    public void setGenericRequestList(List<GenericDataDTO> genericRequestList) {
        this.genericRequestList = genericRequestList;
    }

    public List<String> getReferenceIdList() {
        return referenceIdList;
    }

    public void setReferenceIdList(List<String> referenceIdList) {
        this.referenceIdList = referenceIdList;
    }


    public Map<String, String> getMetaDataList() {
        return metaDataList;
    }

    public void setMetaDataList(Map<String, String> metaDataList) {
        this.metaDataList = metaDataList;
    }

    public Map<String, String> getGenericDataList() {
        return genericDataList;
    }

    public void setGenericDataList(Map<String, String> genericDataList) {
        this.genericDataList = genericDataList;
    }
}
