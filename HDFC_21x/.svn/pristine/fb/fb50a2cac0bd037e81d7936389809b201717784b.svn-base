<user-left-menu></user-left-menu>
<!-- <left-menu-directive></left-menu-directive> -->
<div class="loader">
</div>
<div class="container from_wrapper">
    <h4 class="form_heading">Modify Permission</h4>
    <form name="modifyPermissionForm" role="form" ng-submit="vm.modifyPermissionConfirmation()" novalidate>
        <notice-message-directive></notice-message-directive>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <label for="displayName" class="control-label col-sm-3">Permission Display Name</label>
                <div class="col-sm-3">
                    <label class="col-sm-5" ng-bind="vm.permission.displayName"></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <label for="description" class="control-label col-sm-3">Permission Description</label>
                <div class="col-sm-3">
                   <textarea class="form-control" id="description" name="description" ng-model="vm.permission.description" maxlength="80"></textarea>
                </div>
            </div>
        </div>
        
        <div class="col-sm-offset-5 col-sm-8 form_submit">
            <button type="submit" id="submit" name="submit" class="btn btn-default" ng-disabled="modifyPermissionForm.$invalid">Submit</button>
            <button type="button"  id="cancel" name="cancel" class="btn btn-cancel" ng-click="vm.showCancelConfirmation()">Cancel</button>
        </div>
    </form>
</div>