package com.isl.gbm.common.dto;

/**
 * The Class NpsSystemParameterDto.
 *
 * @author harishbabu.t
 */
public class NpsSystemParameterDto {

    /** The parameter id. */
    private String parameterId;

    /** The parameter desc. */
    private String parameterDesc;

    /** The parameter value. */
    private String parameterValue;

    /** The parameter type. */
    private Character parameterType;
    /**
     *
     */
    private String schCode;

    /**
     *
     * @return
     */
    public String getSchCode() {
        return schCode;
    }

    /**
     *
     * @param schCode
     */
    public void setSchCode(String schCode) {
        this.schCode = schCode;
    }

    /**
     * Gets the parameter desc.
     *
     * @return the parameterDesc
     */
    public String getParameterDesc() {
        return this.parameterDesc;
    }

    /**
     * Gets the parameter id.
     *
     * @return the parameterId
     */
    public String getParameterId() {
        return this.parameterId;
    }

    /**
     * Gets the parameter type.
     *
     * @return the parameterType
     */
    public Character getParameterType() {
        return this.parameterType;
    }

    /**
     * Gets the parameter value.
     *
     * @return the parameterValue
     */
    public String getParameterValue() {
        return this.parameterValue;
    }

    /**
     * Sets the parameter desc.
     *
     * @param parameterDesc
     *            the parameterDesc to set
     */
    public void setParameterDesc(final String parameterDesc) {
        this.parameterDesc = parameterDesc;
    }

    /**
     * Sets the parameter id.
     *
     * @param parameterId
     *            the parameterId to set
     */
    public void setParameterId(final String parameterId) {
        this.parameterId = parameterId;
    }

    /**
     * Sets the parameter type.
     *
     * @param parameterType
     *            the parameterType to set
     */
    public void setParameterType(final Character parameterType) {
        this.parameterType = parameterType;
    }

    /**
     * Sets the parameter value.
     *
     * @param parameterValue
     *            the parameterValue to set
     */
    public void setParameterValue(final String parameterValue) {
        this.parameterValue = parameterValue;
    }

}
