<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading  feature-heading">Branches of Other Bank -
        Modify</h4>

    <form name="branchesOfOtherBankForm" role="form">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3">
                    <label for="branchCode" class="control-label">Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchCode"
                           chars="alpha-numeric" name="branchCode"
                           ng-model="vm.cbsBranchesOfOtherBank.C001"  ng-disabled = "vm.result.verifiedFlag =='Y'"
                           ng-init="vm.cbsBranchesOfOtherBank.C001 = vm.result.branchCode"  maxlength="6">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3 required">
                    <label for="bankCode" class="control-label">Bank Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="bankCode"
                           chars="alpha-numeric" name="bankCode"
                           ng-model="vm.cbsBranchesOfOtherBank.C002"  ng-disabled = "vm.result.verifiedFlag =='Y'"
                           ng-init="vm.cbsBranchesOfOtherBank.C002= vm.result.bankCode" maxlength="6"
                           required>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3">
                    <label for="micrCentreCode" class="control-label">MICR
                        Center Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrCentreCode"
                           name="micrCentreCode" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C003" ng-disabled = "vm.result.verifiedFlag =='Y'"
                           ng-init="vm.cbsBranchesOfOtherBank.C003 = vm.result.micrCentreCode" maxlength="3">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="micrBankCode" class="control-label">MICR Bank
                        Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBankCode"
                           name="micrBankCode" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C004" ng-disabled = "vm.result.verifiedFlag =='Y'"
                           ng-init="vm.cbsBranchesOfOtherBank.C004 = vm.result.micrBankCode" maxlength="3">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3">
                    <label for="micrBranchCode" class="control-label">MICR
                        Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBranchCode"
                           name="micrBranchCode" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C005"  ng-disabled = "vm.result.verifiedFlag =='Y'" ng-init="vm.cbsBranchesOfOtherBank.C005 = vm.result.micrBranchCode" maxlength="3">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="branchName" class="control-label">Branch Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchName"
                           chars="alpha-numeric" name="branchName"
                           ng-model="vm.cbsBranchesOfOtherBank.C006" ng-init="vm.cbsBranchesOfOtherBank.C006 = vm.result.branchName" maxlength="20">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3">
                    <label for="branchAddr1" class="control-label">Branch
                        Address1</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchAddr1"
                           name="branchAddr1" oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ,.\-\/]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                           ng-model="vm.cbsBranchesOfOtherBank.C007" ng-init="vm.cbsBranchesOfOtherBank.C007 = vm.result.branchAddr1" maxlength="45">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="branchAddr2" class="control-label">Branch
                        Address2</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchAddr2"
                           name="branchAddr2" oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ,.\-\/]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                           ng-model="vm.cbsBranchesOfOtherBank.C008" ng-init="vm.cbsBranchesOfOtherBank.C008 = vm.result.branchAddr2" maxlength="45">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3">
                    <label for="branchAddr3" class="control-label">Branch
                        Address3</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchAddr3"
                           name="branchAddr3" oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ,.\-\/]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                           ng-model="vm.cbsBranchesOfOtherBank.C009" ng-init="vm.cbsBranchesOfOtherBank.C009 = vm.result.branchAddr3" maxlength="45">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="branchCityCode" class="control-label">Branch
                        City Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchCityCode"
                           name="branchCityCode" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C010" ng-disabled = "vm.result.verifiedFlag =='Y'" ng-init="vm.cbsBranchesOfOtherBank.C010 = vm.result.branchCityCode" maxlength="30" oninput="this.value = this.value.replace(/^\s+/g, '')">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group ">
                <div class="col-sm-3">
                    <label for="branchStateCode" class="control-label">Branch
                        State Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchStateCode"
                           name="branchStateCode" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C011" ng-disabled = "vm.result.verifiedFlag =='Y'" ng-init="vm.cbsBranchesOfOtherBank.C011 = vm.result.branchStateCode" maxlength="30" oninput="this.value = this.value.replace(/^\s+/g, '')">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="branchPinCode" class="control-label">Branch Pin
                        Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchPinCode"
                           name="branchPinCode"
                           ng-model="vm.cbsBranchesOfOtherBank.C012" ng-init="vm.cbsBranchesOfOtherBank.C012 = vm.result.branchPinCode" maxlength="10"
                           chars="only-numbers">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3">
                    <label for="additionalText1" class="control-label">Additional
                        Text1</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" name="additionalText1"
                           id="additionalText1" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C013" ng-init="vm.cbsBranchesOfOtherBank.C013 = vm.result.additionalText1"
                           maxlength="40">
                </div>
                <div class="col-sm-2"></div>
                <div class="col-sm-3">
                    <label for="additionalText2" class="control-label">Additional
                        Text2</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" name="additionalText2"
                           id="additionalText2" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C014" ng-init="vm.cbsBranchesOfOtherBank.C014 = vm.result.additionalText2"
                           maxlength="40">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3">
                    <label for="additionalText3" class="control-label">Additional
                        Text3</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" name="additionalText3"
                           id="additionalText3" chars="alpha-numeric"
                           ng-model="vm.cbsBranchesOfOtherBank.C015" ng-init="vm.cbsBranchesOfOtherBank.C015 = vm.result.additionalText3"
                           maxlength="40">
                </div>
            </div>
        </div>


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3 required">
                    <label for="bankIfscCode" class="control-label">IFSC Code
                        Text3</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" name="bankIfscCode"
                           id="bankIfscCode" chars="alpha-numeric"
                           maxlength="11"
                           ng-pattern="'^[a-zA-Z]{4}[0-9]{1}[a-zA-Z0-9]{6}$'"
                           ng-model="vm.cbsBranchesOfOtherBank.C017" ng-init="vm.cbsBranchesOfOtherBank.C017= vm.result.bankIfscCode"
                           maxlength="40" required>
                </div>
            </div>
        </div>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.result.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.result.lastModifiedBy) ? (vm.result.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.result.verifiedBy) ? (vm.result.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.result.verifiedFlag  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.result.creatDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.result.modDate) ? (vm.result.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.result.verDate) ? (vm.result.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-offset-5 col-sm-8 form_submit">

                <button type="submit" class="btn btn-default" id="submitButton"
                        ng-disabled="branchesOfOtherBankForm.$invalid" ng-click="vm.modifySubmit();">Submit</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        ng-click="vm.showCancelConfirmation('cbs_branches_of_other_bank.inquiry');">Cancel</button>
            </div>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

