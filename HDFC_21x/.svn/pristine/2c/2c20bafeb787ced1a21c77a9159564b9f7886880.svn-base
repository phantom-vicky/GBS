<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.1/xlsx.full.min.js"></script>

<div class="loader-new" ng-if="vm.loader"></div>

<div class="container" ng-if="vm.ListOfDtos.length > 0">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/rbibond_gu_functionality';" id="homeButton">Home
        </button>
        <button type="button" id="cancel_Button" class="btn btn-cancel"
                onclick="window.location.href= '#!/success_failure_report_for_brokerage_payment/action/inquiry';">Back
        </button>
    </div>

    <div class="container from_wrapper new_form_wrapper">
        <div class="row">
            <h4 class="form_heading">Success/Failure Report for Brokerage Payment</h4>
            <sol-header></sol-header>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                           >
                        <thead>
                        <tr>
                            <th>Brokerage Payment From Date</th>
                            <th>Brokerage Payment To Date</th>
                            <th>Name of the Module</th>
                            <th>Name of the Bond Scheme</th>
                            <th>Field Name</th>
                            <th>Download Option</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr >
                            <td>{{vm.fromDate | date : 'dd/MM/yyyy'}}</td>
                            <td>{{vm.toDate | date : 'dd/MM/yyyy'}}</td>
                            <td>{{vm.moduleName}}</td>
                            <td>{{vm.schemeName}}</td>
                            <td>{{vm.statusMapping[vm.status]}}</td>
                            <td>

                                <select
                                        class="form-control"
                                        id="export"
                                        name="export"
                                        ng-model="vm.downloadType"
                                        ng-init="vm.downloadType=''"
                                        ng-change="vm.downloadReport()"
                                >
                                    <option value="">EXPORT</option>
                                    <option value="excel">EXCEL</option>
                                    <option value="csv">CSV</option>


                                </select>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Success/Failure Report for Brokerage Payment</h4>
        <p>No records found to display.</p>
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/success_failure_report_for_brokerage_payment/action/inquiry';">
                Back
            </button>
        </center>
    </div>
</div>




