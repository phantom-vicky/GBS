<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">RBI Bond Scheme Parameters - Modify</h4>
    <sol-header></sol-header>
    <form name="schemeParameterCreationForm" role="form" ng-submit="vm.modifyCBDTParameterCreation();">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-5">
                    <label><b>{{vm.schemeName}}</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Bond Scheme Effective From Date (DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="effFromDate1" name="effFromDate1"
                            ng-model="vm.cbdtSchemeParameter.C003.oldValue" uib-datepicker-popup="dd/MM/yyyy"
                            ng-init="vm.fromDate1=''" datepicker-options="vm.dateOptions"
                            is-open="vm.effFromDatePicker1.opened" close-text="Close" maxlength="10" readonly
                            required />
                        <!--<span class="input-group-btn">
                  <button type="button" class="btn btn-secondary"
                          ng-click="vm.effFromDatePicker1.opened = true"
                          id="effFromDateSearcher1">
                  <i class="glyphicon glyphicon-calendar"></i>
                  </button>
                  </span>-->
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Bond Scheme Effective End Date (DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="effToDate" name="effToDate"
                            ng-model="vm.cbdtSchemeParameter.C004.oldValue" uib-datepicker-popup="dd/MM/yyyy"
                            ng-init="vm.toDate='';" datepicker-options="vm.dateOptionsM"
                            is-open="vm.effToDatePicker.opened" close-text="Close" maxlength="10"
                            ng-blur="vm.textableDatePicker('effToDate',vm.cbdtSchemeParameter.C004.oldValue);vm.fromToDateM();"
                            ng-keyup="vm.autoslashing('effToDate')" chars="numbers-slash" />
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary" ng-click="vm.effToDatePicker.opened = true"
                                id="effToDateSearcher1" ng-if="vm.cbdtSchemeParameter.C003.oldValue">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Parameters Effective From Date (DD/MM/YYYY)</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="effFromDate" name="effFromDate"
                            ng-model="vm.cbdtSchemeParameter.C005.oldValue" uib-datepicker-popup="dd/MM/yyyy"
                            datepicker-options="vm.dateOptionsM" is-open="vm.effFromDatePicker.opened"
                            close-text="Close" maxlength="10" readonly required />
                        <span class="input-group-btn">
                            <!--<button type="button" class="btn btn-secondary"
                          ng-click="vm.effFromDatePicker.opened = true"
                          id="effFromDateSearcher">
                  <i class="glyphicon glyphicon-calendar"></i>
                  </button>-->
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Minimum Deposit Rs</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="minDepositAmt"
                        ng-blur="vm.minMaxInput(vm.cbdtSchemeParameter.C006.oldValue,'M');" oninput="
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/(\..*)\./g, '$1')
                .slice(0, 6)
            " name="minDepositAmt" ng-model="vm.cbdtSchemeParameter.C006.oldValue" maxlength="6" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Maximum Deposit Amount Rs</label>
                </div>
                <div class="col-sm-2">
                    <!--                    <input type="text" chars="only-numbers" class="form-control" id="maxDepositAmout" ng-init="" maxlength="11"-->
                    <!--                           oninput="var startPos = this.selectionStart; var endPos = this.selectionEnd; this.value = this.value.slice(0, 11).replace(/[^0-9]/g, ''); this.setSelectionRange(startPos, endPos);"-->
                    <!--                           name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C007.oldValue" required>-->
                    <input type="text" class="form-control" id="maxDepositAmout" maxlength="11" oninput="
              var startPos = this.selectionStart;
              var endPos = this.selectionEnd;
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/^(\d*\.\d{0,2}).*$/, '$1')
                .replace(/(\..*)\./g, '$1');
              this.setSelectionRange(startPos, endPos);
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C007.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Maximum Limit for Cash Deposit Rs</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="maxLimitForcashDeposit" ng-init=""
                        maxlength="6" oninput="
              var startPos = this.selectionStart;
              var endPos = this.selectionEnd;
              this.value = this.value.slice(0, 6).replace(/[^0-9]/g, '');
              this.setSelectionRange(startPos, endPos);
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C008.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Deposit in Multiples of (Rs.)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="depositInMultiples" maxlength="6"
                        ng-blur="vm.validateRoundedValue(vm.cbdtSchemeParameter.C009.oldValue,'M')" oninput="
              var startPos = this.selectionStart;
              var endPos = this.selectionEnd;
              this.value = this.value.slice(0, 6).replace(/[^0-9]/g, '');
              this.setSelectionRange(startPos, endPos);
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C009.oldValue" required />
                    <div ng-if="vm.errorMessage" class="text-danger small-text-margin">
                        {{ vm.errorMessage }}
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Deposit Maturity Period (Months)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="depositMaturityPeriod" ng-init=""
                        maxlength="3" oninput="
              var startPos = this.selectionStart;
              var endPos = this.selectionEnd;
              this.value = this.value.slice(0, 3).replace(/[^0-9]/g, '');
              this.setSelectionRange(startPos, endPos);
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C010.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label" for="minimumTenure">Minimum Tenure of the Bond</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="minimumTenure" ng-init=""
                        maxlength="2" oninput="
              if (this.value.length > 2) this.value = this.value.slice(0, 2);
              this.value =
                this.value.trim() !== ''
                  ? Math.abs(parseInt(this.value, 10))
                  : null;
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C011.oldValue" required />
                </div>
            </div>
        </div>
        <!--        <div class="row">-->
        <!--            <div class="form-group required">-->
        <!--                <div class="col-sm-2"></div>-->
        <!--                <div class="col-sm-5">-->
        <!--                    <label class="control-label">Maximum Tenure of the Bond</label>-->
        <!--                </div>-->
        <!--                <div class="col-sm-2">-->
        <!--                    <input type="text" chars="only-numbers" class="form-control" id="maximumTenure" ng-init=""-->
        <!--                           maxlength="2"-->
        <!--                           oninput="if(this.value.length > 2) this.value = this.value.slice(0, 2); this.value = this.value.trim() !== '' ? Math.abs(parseInt(this.value, 10)) : null;"-->
        <!--                           name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C040.oldValue" required>-->
        <!--                </div>-->
        <!--            </div>-->
        <!--        </div>-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">TDS applicable (Y/N)?</label>
                </div>
                <td width="25%">
                    <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                        <input type="radio" name="isTdsActive" id="isTdsActive{{$index}}"
                            ng-model="vm.cbdtSchemeParameter.C012.oldValue" ng-value="item.value"
                            required />{{item.label}}
                    </ng-container>
                    <!-- <input type="radio" id="isTdsActiveY" name="isTdsActiveY"  ng-change="vm.isTdsActive= 'Y'; vm.isTdsActiveN=''" ng-model="vm.isTdsActiveY" ng-init="vm.isTdsActive='';"  value="Y">Yes
                     <input type="radio" id="isTdsActiveN" name="isTdsActiveN"  ng-change="vm.isTdsActive= 'N'; vm.isTdsActiveY=''" ng-model="vm.isTdsActiveN" ng-init="vm.isTdsActive='';" value="N">No
                -->
                </td>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Scheme Status</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="isSchemeActive" name="isSchemeActive"
                        ng-model="vm.cbdtSchemeParameter.C013.oldValue" required>
                        <option value="" hidden="true">SELECT</option>
                        <option value="C">Current Scheme</option>
                        <option value="A">Active Scheme</option>
                        <option value="CL">Closed</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="versionNo" class="control-label">Interest Rate code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="versionNo"
                        ng-model="vm.cbdtSchemeParameter.C014.oldValue" required readonly />
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="versionNoSearch"
                        ng-click="vm.schemeTorchFunction()"></i>
                    <i class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.cbdtSchemeParameter.C014.oldValue= '';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="interestpaymentFreq" class="control-label">Interest Payment Frequency</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="interestpaymentFreq" name="reportType"
                        ng-model="vm.cbdtSchemeParameter.C015.oldValue" required>
                        <option value="" hidden="true">SELECT</option>
                        <option value="H">Half Yearly</option>
                    </select>
                </div>
            </div>
        </div>
        <!--        <div class="row">-->
        <!--            <div class="form-group required">-->
        <!--                <div class="col-sm-2"></div>-->
        <!--                <div class="col-sm-5">-->
        <!--                    <label class="control-label">Interest Payment Date1 (DD/MM)</label>-->
        <!--                </div>-->
        <!--                <div class="col-sm-1">-->
        <!--                    <div class="row">-->
        <!--                        <select class="form-control" id="interstPayementDate11" name="reportTypeTwo"-->
        <!--                                ng-model="vm.intPaymntDayOneM" style="width:80%"-->
        <!--                                ng-init="vm.intPaymntDayOneM =''" ng-change="vm.interstPayementDateOneM()"  required>-->
        <!--                            <option value="" hidden="true">SELECT</option>-->
        <!--                            <option ng-repeat="x in vm.dateList" value="{{x}}">{{x}}</option>-->
        <!--                        </select>-->
        <!--                    </div>-->
        <!--                </div>-->
        <!--                <div class="col-sm-1">-->

        <!--                    <div class="row">-->
        <!--                        <select class="form-control" id="interstPayementDate22" name="reportTypeTwo"-->
        <!--                                ng-model="vm.intPaymntMonthOneM" style="width:80%"-->
        <!--                                ng-init="vm.intPaymntMonthOneM =''" ng-change="vm.interstPayementDateOneM()"  required>-->
        <!--                            <option value="" hidden="true">SELECT</option>-->
        <!--                            <option ng-repeat="x in vm.monthList" value="{{x}}">{{x}}</option>-->
        <!--                        </select>-->
        <!--                    </div>-->
        <!--                    <input type="text"  class="form-control" id="interstPayementDate111" name="brokeragePercentage"-->
        <!--                           ng-model="vm.cbdtSchemeParameter.C016.oldValue" readonly>-->
        <!--                </div>-->
        <!--            </div>-->
        <!--        </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Interest Payment Date1 (DD/MM)</label>
                </div>
                <div class="col-sm-1">
                    <div class="row">
                        <select class="form-control width-80" id="interstPayementDate11" name="reportTypeTwo"
                            ng-model="vm.intPaymntDayOneM" ng-change="vm.validateDateOneM()" required>
                            <option value="" hidden="true">SELECT</option>
                            <option ng-repeat="x in vm.dateList" value="{{x}}">{{x}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-1">
                    <div class="row">
                        <select class="form-control width-80" id="interstPayementDate22" name="reportTypeTwo"
                            ng-model="vm.intPaymntMonthOneM" ng-change="vm.validateDateOneM()" required>
                            <option value="" hidden="true">SELECT</option>
                            <option ng-repeat="x in vm.monthList" value="{{x}}">{{x}}</option>
                        </select>
                    </div>
                    <input type="text" class="form-control" id="interstPayementDate111" name="brokeragePercentage"
                        ng-model="vm.cbdtSchemeParameter.C016.oldValue" readonly required />
                </div>
            </div>
            <div class="text-danger bold-nowrap" ng-show="vm.invalidDate">
                Invalid date selected for the selected month.
            </div>
        </div>

        <!--        <div class="row">-->
        <!--            <div class="form-group required">-->
        <!--                <div class="col-sm-2"></div>-->
        <!--                <div class="col-sm-5">-->
        <!--                    <label class="control-label">Interest Payment Date2 (DD/MM)</label>-->
        <!--                </div>-->
        <!--                <div class="col-sm-1">-->
        <!--                    <div class="row">-->
        <!--                        <select class="form-control" id="interstPayementDate1" name="reportTypeTwo"-->
        <!--                                ng-model="vm.intPaymntDayM" style="width:80%"-->
        <!--                                ng-init="vm.intPaymntDayM =''" ng-change="vm.interstPayementDateM()"  required>-->
        <!--                            <option value="" hidden="true">SELECT</option>-->
        <!--                            <option ng-repeat="x in vm.dateList" value="{{x}}">{{x}}</option>-->
        <!--                        </select>-->
        <!--                    </div>-->
        <!--                </div>-->
        <!--                <div class="col-sm-1">-->

        <!--                    <div class="row">-->
        <!--                        <select class="form-control" id="interstPayementDate2" name="reportTypeTwo"-->
        <!--                                ng-model="vm.intPaymntMonthM" style="width:80%"-->
        <!--                                ng-init="vm.intPaymntMonthM =''" ng-change="vm.interstPayementDateM()"  required>-->
        <!--                            <option value="" hidden="true">SELECT</option>-->
        <!--                            <option ng-repeat="x in vm.monthList" value="{{x}}">{{x}}</option>-->
        <!--                        </select>-->
        <!--                    </div>-->
        <!--                    <input type="text"  class="form-control" id="interstPayementDate" name="brokeragePercentage"-->
        <!--                           ng-model="vm.cbdtSchemeParameter.C017.oldValue" readonly>-->
        <!--                </div>-->
        <!--            </div>-->
        <!--        </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Interest Payment Date2 (DD/MM)</label>
                </div>
                <div class="col-sm-1">
                    <div class="row">
                        <select class="form-control width-80" id="interstPayementDate1" name="reportTypeTwo"
                            ng-model="vm.intPaymntDayM" ng-init="vm.intPaymntDayM =''" ng-change="vm.validateDateM()"
                            required>
                            <option value="" hidden="true">SELECT</option>
                            <option ng-repeat="x in vm.dateList" value="{{x}}">{{x}}</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-1">
                    <div class="row">
                        <select class="form-control width-80" id="interstPayementDate2" name="reportTypeTwo"
                            ng-model="vm.intPaymntMonthM" ng-init="vm.intPaymntMonthM =''"
                            ng-change="vm.validateDateM()" required>
                            <option value="" hidden="true">SELECT</option>
                            <option ng-repeat="x in vm.monthList" value="{{x}}">{{x}}</option>
                        </select>
                    </div>
                    <input type="text" class="form-control" id="interstPayementDate" name="brokeragePercentage"
                        ng-model="vm.cbdtSchemeParameter.C017.oldValue" readonly required />
                </div>
            </div>
            <div class="text-danger bold-nowrap" ng-show="vm.invalidDateM">
                Invalid date selected for the selected month.
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="alternateInterstPaymentDay" class="control-label">In case of Holiday, Alternate Interest
                        Payment Day</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="alternateInterstPaymentDay" name="reportType"
                        ng-model="vm.cbdtSchemeParameter.C018.oldValue" ng-init="vm.cbdtSchemeParameter.C018=''"
                        required>
                        <option value="" hidden="true">SELECT</option>
                        <option value="P">Previous</option>
                        <option value="N">NextDay</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Is Age based Premature Encashment allowed under scheme
                        (Y/N)?</label>
                </div>
                <td width="25%">
                    <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                        <input type="radio" name="isAgeBasedPremature" id="isAgeBasedPremature{{$index}}"
                            ng-model="vm.cbdtSchemeParameter.C019.oldValue" ng-value="item.value"
                            required />{{item.label}}
                    </ng-container>

                    <!--                    <input type="radio"    id="isAgeBasedPrematureY" name="isAgeBasedPrematureY"  ng-change="vm.isAgeBasedPremature= 'Y'; vm.isAgeBasedPrematureN=''" ng-model="vm.isAgeBasedPrematureY" ng-init="vm.isAgeBasedPremature='';"   value="Y">Yes-->
                    <!--                    <input type="radio"   id="isAgeBasedPrematureN" name="isAgeBasedPrematureN"  ng-change="vm.isAgeBasedPremature= 'N'; vm.isAgeBasedPrematureY=''" ng-model="vm.isAgeBasedPrematureN" ng-init="vm.isAgeBasedPremature='';"  value="N">No-->
                </td>
            </div>
        </div>

        <div class="row" ng-if="vm.cbdtSchemeParameter.C019.oldValue =='N'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Is Normal Premature Encashment allowed under scheme (Y/N)?</label>
                </div>
                <td width="25%">
                    <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                        <input type="radio" name="isNormalPremature" id="isNormalPremature{{$index}}"
                            ng-model="vm.cbdtSchemeParameter.C020.oldValue" ng-value="item.value"
                            required />{{item.label}}
                    </ng-container>
                    <!--                    <input type="radio"    id="isNormalPrematureY" name="isNormalPrematureY"  ng-change="vm.isNormalPremature= 'Y'; vm.isNormalPrematureN=''" ng-model="vm.isNormalPrematureY" ng-init="vm.isNormalPremature='';"   value="Y">Yes-->
                    <!--                    <input type="radio"   id="isNormalPrematureN" name="isNormalPrematureN"  ng-change="vm.isNormalPremature= 'N'; vm.isNormalPrematureY=''" ng-model="vm.isNormalPrematureN" ng-init="vm.isNormalPremature='';"  value="N">No-->
                </td>
            </div>
        </div>

        <!--        <div class="row" ng-if="vm.cbdtSchemeParameter.C018.oldValue =='Y'">-->
        <div class="row" ng-if="vm.cbdtSchemeParameter.C019.oldValue =='N'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Minimum Lock-in Period (Years)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" ng-keypress="vm.validateInput($event,interstPaymentDate21)" chars="only-numbers"
                        class="form-control" id="interstPaymentDate21" maxlength="2" name="maxNoOfChallan"
                        ng-model="vm.cbdtSchemeParameter.C021.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row" ng-if="vm.cbdtSchemeParameter.C019.oldValue =='Y'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Minimum Lock-in Period (Years)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="interstPaymentDate213"
                        maxlength="2" name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter .C021.oldValue" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="typeOfBond" class="control-label">Type of Bond subscriptions allowed under bond
                        scheme</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="typeOfBond" name="reportType"
                        ng-model="vm.cbdtSchemeParameter.C022.oldValue" required>
                        <option value="" hidden="true">SELECT</option>
                        <option value="C">Cumulative</option>
                        <option value="NC">Non-Cumulative</option>
                        <option value="B">Both</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row" data-ng-if="vm.cbdtSchemeParameter.C022.oldValue == 'NC'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Maturity Amount Per Thousand (Rs.)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="maturityAmountPerthousand1"
                        ng-init="" limit-To="4" min="0" name="maxNoOfChallan"
                        ng-model="vm.cbdtSchemeParameter.C023.oldValue" />
                </div>
            </div>
        </div>

        <div class="row"
            data-ng-if="vm.cbdtSchemeParameter.C022.oldValue == 'C' || vm.cbdtSchemeParameter.C022.oldValue == 'B'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Maturity Amount Per Thousand (Rs.)</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" chars="only-numbers" class="form-control" id="maturityAmountPerthousand"
                        ng-init="" limit-To="4" min="1" oninput="
              this.value =
                !!this.value && Math.abs(this.value) >= 0
                  ? Math.abs(this.value)
                  : null
            " name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C023.oldValue" required />
                </div>
            </div>
        </div>

        <!--        <div class="row">-->
        <!--            <div class="form-group required">-->
        <!--                <div class="col-sm-2"></div>-->
        <!--                <div class="col-sm-5">-->
