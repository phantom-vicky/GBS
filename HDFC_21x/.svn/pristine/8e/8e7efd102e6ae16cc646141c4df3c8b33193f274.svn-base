<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">Half-Yearly interest advice- Post payment of interest- report and advice</h4>
    <sol-header></sol-header>
    <form name="HalfYearlyInterestAdviceForm" role="form">


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label for="schemeName" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="schemeName" data-ng-model="vm.schemeName" required
                           readonly/>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0">
                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearch"
                          data-ng-click="vm.getSchemeName()"></span>
                    <span class="glyphicon glyphicon-remove clear cp"
                          data-ng-click="vm.schemeCode =''; vm.schemeName=''"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Type of Report</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="status" data-ng-model="vm.reportType" required>
                        <option value="">Select</option>
                        <option value="pdf">Half-Yearly Advice (PDF)</option>
                        <option value="excel">Excel Report</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label for="holderName" class="control-label">Name</label></div>
                <div class="col-sm-2">
                    <input type="text" maxlength="50" class="form-control" id="holderName" name="holderName"
                           data-ng-model="vm.holderName"
                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label for="panNumber" class="control-label">PAN No</label></div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="panNumber" data-ng-model="vm.panNumber"
                           data-ng-init="vm.panNumber= ''; " data-chars="alpha-numeric" minlength="4" maxlength="10"
                           oninput="this.value=this.value.replace(/\s+/g, '')"/>
                </div>

                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0"
                     data-ng-if="vm.panNumber || vm.holderName && vm.schemeName">
                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="panTreasurySearch"
                          data-ng-click="vm.getPanNumber();"></span>
                    <span class="glyphicon glyphicon-remove clear cp"
                          data-ng-click="vm.panNumber =''; vm.blaNumber =''; vm.holderName='';"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label for="BLA No" class="control-label">BLA No</label></div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="BLA No" data-chars="alpha-numeric"
                               data-ng-model="vm.blaNumber" maxlength="14"
                               oninput="this.value=this.value.replace(/\s+/g, '')"/>
                    </p>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0"
                     data-ng-if="vm.panNumber || vm.blaNumber && vm.schemeName">
                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="BLATreasurySearch"
                          data-ng-click="vm.getBlaNumber()"></span>
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.blaNumber ='';"></span>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label class="control-label">From Date (dd/mm/yyyy)</label></div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="effFromDateR1" name="effFromDate"
                               data-ng-model="vm.fromDate" data-uib-datepicker-popup="dd/MM/yyyy"
                               data-ng-init="vm.fromDate=''; vm.fromDateVal()"
                               data-ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
                               data-datepicker-options="vm.fromDateOptions" data-is-open="vm.fromDatePicker.opened"
                               data-close-text="Close" maxlength="10"
                               ng-blur="vm.textableDatePicker('effFromDateR1',vm.fromDate)"
                               ng-keyup="vm.autoslashing('effFromDateR1')" chars="numbers-slash"
                               required>
                        <span class="input-group-btn" data-ng-if="vm.schemeName">
                            <button type="button" class="btn btn-secondary"
                                    data-ng-click="vm.fromDatePicker.opened = true" id="effFromDateSearcherR1">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row">

            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label class="control-label">To Date (dd/mm/yyyy)</label></div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="effToDateR" name="effToDate"
                               data-ng-model="vm.toDate" data-uib-datepicker-popup="dd/MM/yyyy" data-ng-init="vm.toDate=''"
                               data-datepicker-options="vm.toDateOptions" data-is-open="vm.effToDatePicker.opened"
                               data-close-text="Close" maxlength="10" ng-blur="vm.textableDatePicker('effToDateR',vm.toDate)"
                               ng-keyup="vm.autoslashing('effToDateR')" chars="numbers-slash" required>
                        <span class="input-group-btn" data-ng-if="vm.fromDate">
                            <button type="button" class="btn btn-secondary"
                                    data-ng-click="vm.effToDatePicker.opened = true" id="effToDateSearcherR">
                                <span class="glyphicon glyphicon-calendar"></span>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="button" class="btn btn-default" id="submitButton" data-ng-click="vm.getDetails()"
                    data-ng-disabled="HalfYearlyInterestAdviceForm.$invalid">Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!--Torch Modals-->
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal"
                        data-ng-click="vm.modalSearch=''">&times;
                </button>
                <h4 class="modal-title">Name of the Bond Scheme</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.modalSearch"
                                       data-ng-init="vm.modalSearch = ''" placeholder="Search"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                        data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        SCHEME NAME
                                    </th>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                        data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        STATUS
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                                    data-bs-dismiss="modal">
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal"
                        data-ng-click="vm.panSearch=''">&times;
                </button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.panSearch"
                                       data-ng-init="vm.panSearch = ''" placeholder="Search"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=false;sortedColumn = 'panNumber'">
                                <tr>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'panNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNumber';"
                                        data-ng-class="(sortedColumn == 'panNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN No
                                    </th>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                        data-ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Holder Name
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.PanTorch | filter:vm.panSearch | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.panNumber= x.panNumber; vm.holderName= x.holderName;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.panNumber}}</td>
                                    <td>{{x.holderName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal"
                        data-ng-click="vm.blaSearch=''">&times;
                </button>
                <h4 class="modal-title">BLA No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.blaSearch"
                                       data-ng-init="vm.blaSearch = ''" placeholder="Search" data-chars="alpha-numeric"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z0-9\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=false;sortedColumn = 'blaNumber'">
                                <tr>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'blaNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNumber';"
                                        data-ng-class="(sortedColumn == 'blaNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BLA No
                                    </th>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'panNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNumber';"
                                        data-ng-class="(sortedColumn == 'panNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN No
                                    </th>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                        data-ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Holder Name
                                    </th>
                                    <th scope="col"
                                        data-ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                                        data-ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Mode of Holding
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.blaAccNoList | filter:vm.blaSearch | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.blaNumber = x.blaNumber; vm.panNumber = x.panNumber; vm.holderName = x.holderName; vm.modeOfHolding = x.modeOfHolding;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.blaNumber}}</td>
                                    <td>{{x.panNumber}}</td>
                                    <td>{{x.holderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<div class="text-justify" id="section-to-print" style="display:none">
    <div data-ng-repeat="x in vm.groupedCustomers" class="page-break">
        <div style="padding: 1em; font-family: 'Times New Roman'; font-size: 14px; margin: 10px">
            <table style="width: 100%" aria-label="">
                <tr>
                    <td style="width:66%"></td>
                    <td style="width:34%">
                        <span>HDFC Bank Ltd.</span><br>
                        <span>CMS-GOI Bonds - 2nd Floor</span><br>
                        <span>GKS Technology Park, No- 94, </span><br>
                        <span>SP Estate Bus Stand, Wavin Main Road,</span><br>
                        <span>Mogappair Chennai-600058</span><br>
                        <span>Tel.: 044-69129917</span><br>
                        <span>Email : rrb.chennai@hdfcbank.com</span><br>
                        <span>CIN No : L65920MH1</span>
                    </td>
                </tr>
            </table>
            <table style="width: 100%" aria-label="">
                <tr>
                    <td>
                        <span>{{vm.solDate | date : 'dd/MM/yyyy'}}</span><br><br>
                        <span>{{x[0].holderName}}</span><br>
                        <span>{{x[0].address1}}</span><br>
                        <span>{{x[0].address2}}</span><br>
                        <span>{{x[0].city}}</span><br>
                        <span>{{x[0].state | getLabelFromValuesArray : vm.convertLabelValue(vm.stateListValues)}} -
                            {{x[0].pinCode}}</span><br>
                    </td>
                </tr>
            </table>

            <div>
                <br>
                <p>
                    <strong>Sub: {{vm.schemeName}} - Payment of Interest for Bond Ledger Account No.:
                        {{x[0].blaNumber}}</strong>
                </p><br>
            </div>
            <div>
                <p>Dear Sir/Madam,</p><br>
            </div>
            <div>
                <p>We have deposited your GOI Savings Taxable Bonds half-yearly interest (period ended
                    {{x[0].hyIntDate}}) for the
                    above-referred bond to your Account No. {{x[0].accountNumber}} with {{x[0].bankName}} with MICR Code
                    {{x[0].micrCode}} on {{x[0].creditDate}}</p>
                <br>
                <p>
                    Here are the details :<br>
                </p>

                <table border="1" style="border-collapse: collapse; width: 100%; border-spacing: 10px; margin-top: 15px"
                       data-ng-if="x[0].category=='MULTI DC WITH TAX'" aria-label="">
                    <tr>
                        <th scope="col" style="padding: 6px">INV Date (DD/MM/YYYY)</th>
                        <th scope="col" style="padding: 6px">Investment Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">TDS @_10.00% (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Paid</th>
                    </tr>
                    <tr data-ng-repeat="y in x">
                        <td style="padding: 6px">{{y.invDate}}</td>
                        <td style="padding: 6px">{{y.invAmount}}</td>
                        <td style="padding: 6px">{{y.intAmount}}</td>
                        <td style="padding: 6px">{{y.tdsAmount}}</td>
                        <td style="padding: 6px">{{y.intPaid}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px">Total (Rs)</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalInvAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalTdsAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntPaid}}</td>
                    </tr>
                </table>

                <table border="1" style="border-collapse: collapse; width: 100%; border-spacing: 10px; margin-top: 15px"
                       data-ng-if="x[0].category=='MULTI DC WITHOUT TAX'" aria-label="">
                    <tr>
                        <th scope="col" style="padding: 6px">INV Date (DD/MM/YYYY)</th>
                        <th scope="col" style="padding: 6px">Investment Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Paid</th>
                    </tr>
                    <tr data-ng-repeat="y in x">
                        <td style="padding: 6px">{{y.invDate}}</td>
                        <td style="padding: 6px">{{y.invAmount}}</td>
                        <td style="padding: 6px">{{y.intAmount}}</td>
                        <td style="padding: 6px">{{y.intPaid}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px">Total (Rs)</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalInvAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntPaid}}</td>
                    </tr>
                </table>

                <table border="1" style="border-collapse: collapse; width: 100%; border-spacing: 10px; margin-top: 15px"
                       data-ng-if="x[0].category=='MULTI ECS WITH TAX'" aria-label="">
                    <tr>
                        <th scope="col" style="padding: 6px">INV Date (DD/MM/YYYY)</th>
                        <th scope="col" style="padding: 6px">Investment Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">TDS @_10.00% (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Paid</th>
                    </tr>
                    <tr data-ng-repeat="y in x">
                        <td style="padding: 6px">{{y.invDate}}</td>
                        <td style="padding: 6px">{{y.invAmount}}</td>
                        <td style="padding: 6px">{{y.intAmount}}</td>
                        <td style="padding: 6px">{{y.tdsAmount}}</td>
                        <td style="padding: 6px">{{y.intPaid}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px">Total (Rs)</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalInvAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalTdsAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntPaid}}</td>
                    </tr>
                </table>

                <table border="1" style="border-collapse: collapse; width: 100%; border-spacing: 10px; margin-top: 15px"
                       data-ng-if="x[0].category=='MULTI ECS WITHOUT TAX'" aria-label="">
                    <tr>
                        <th scope="col" style="padding: 6px">INV Date (DD/MM/YYYY)</th>
                        <th scope="col" style="padding: 6px">Investment Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Amount (Rs)</th>
                        <th scope="col" style="padding: 6px">Interest Paid</th>
                    </tr>
                    <tr data-ng-repeat="y in x">
                        <td style="padding: 6px">{{y.invDate}}</td>
                        <td style="padding: 6px">{{y.invAmount}}</td>
                        <td style="padding: 6px">{{y.intAmount}}</td>
                        <td style="padding: 6px">{{y.intPaid}}</td>
                    </tr>
                    <tr>
                        <td style="padding: 6px">Total (Rs)</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalInvAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntAmount}}</td>
                        <td style="padding: 6px">{{vm.customerTotals[x[0].blaNumber].totalIntPaid}}</td>
                    </tr>
                </table>

                <table border="1" style="border-collapse: collapse; width: 100%; border-spacing: 10px; margin-top: 15px"
                       data-ng-if="x[0].category=='SINGLE DC WITH TAX'" aria-label="">
