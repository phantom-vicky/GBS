<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">TDS Exemption Master  - Inquiry</h4>
    <sol-header></sol-header>
    <form name="bondTaxExcemptionfrm" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-2">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="panNumber" class="control-label">PAN NO.</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="panNumber"
                           name="panNumber" chars="alpha-numeric" chars="alpha-numeric" minlength="5" maxlength="10" oninput="this.value = this.value.replace(/\s+/g, '')"
                           ng-model="vm.panNumber" ng-init="vm.panNumber=''"
                           onKeyDown="if(event.keyCode === 32) return false;"
                           required>
                </div>
                <div class="col-sm-2" ng-if="vm.panNumber"> <!--ng-if="vm.panNumber"-->
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="panNoSearch"
                       ng-click="vm.getInquiryDetails('torch');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNumber = '';vm.exemptionDocumentType='';vm.exemptionDocumentTypeCode='';vm.isPanSelected=false;"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="exemptionDocumentType" class="control-label">Exemption Document Type</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="exemptionDocumentType" ng-model="vm.exemptionDocumentType"
                           required readonly>
                </div>
                <div class="col-sm-2" ng-if="vm.isPanSelected">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="exemptionDocumentTypeSearch"
                       ng-click="vm.getInquiryDetails('exemption')"></i>
                    <i class="glyphicon glyphicon-remove clear cp"
                       ng-click="vm.exemptionDocumentType='';vm.exemptionDocumentTypeCode=''"></i>
                </div>
            </div>
        </div>
<!--        <div class="row" ng-if="vm.versionNo">-->
<!--            <div class="form-group required">-->
<!--                <div class="col-sm-3"></div>-->
<!--                <div class="col-sm-3">-->
<!--                    <label for="effFromDate" class="control-label">Effective From Date</label>-->
<!--                </div>-->
<!--                <div class="col-sm-2">-->
<!--                    <p class="input-group">-->
<!--                        <input type="text" class="form-control" id="effFromDate" name="effFromDate"-->
<!--                               ng-model="vm.effFromDate"-->
<!--                               ng-init="vm.getEffectFromDateInquiry()"-->
<!--                               uib-datepicker-popup="dd/MM/yyyy"-->
<!--                               datepicker-options="vm.effFromDateOptions"-->
<!--                               is-open="vm.effFromDateOptions.opened"-->
<!--                               close-text="Close"-->
<!--                               maxlength="10" required readonly>-->
<!--                    </p>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->





        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="tds_exemption_master.inquiry_detail({obj:{
								panNumber: vm.panNumber,
								tableId: vm.tableId,
								}})"
                    ng-disabled="bondTaxExcemptionfrm.$invalid">Submit</button>
            <button type="button" id="subButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

<!--modal-->

<div class="modal" id="exemptionDocumentTypeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Exemption Document Type</h4>
            </div>
            <div class="modal-body">
<!--                <div class="list_wrapper" ng-if="vm.versionNumberList.length>0">-->
                    <div class="list_wrapper" ng-if="vm.exemptionDocumentList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search">
<!--                                placeholder="Search" chars="only-numbers">-->
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'exemptionDocumentType'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'exemptionDocumentType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'exemptionDocumentType';" ng-class="(sortedColumn == 'exemptionDocumentType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Exemption Document Type</th>
                                    <th ng-click="(sortedColumn == 'declarationReceivedDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'declarationReceivedDate';" ng-class="(sortedColumn == 'declarationReceivedDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Declaration Received Date</th>
                                    <th ng-click="(sortedColumn == 'status')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'status';" ng-class="(sortedColumn == 'status')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.exemptionDocumentList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.setInquiryExemptionDocumentType(x); vm.tableId= x.tableId;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.exemptionDocumentType | getLabelFromValuesArray : vm.taxType}}</td>
                                    <td>{{x.declarationReceivedDate}}</td>
                                    <td>{{x.status}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="list_wrapper" ng-if="vm.exemptionDocumentList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<div class="modal" id="versionNumberModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Versions List</h4>
            </div>
            <div class="modal-body">
                <div class="list_wrapper" ng-if="vm.versionNumberList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search" chars="only-numbers">
                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNumber'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'versionNumber')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'versionNumber';" ng-class="(sortedColumn == 'versionNumber')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Version No</th>
                                    <th ng-click="(sortedColumn == 'effFromDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'effFromDate';" ng-class="(sortedColumn == 'effFromDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Effective From Date</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.versionNumberList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    data-bs-dismiss="modal">
                                    <td>{{x.versionNumber}}</td>
                                    <td>{{x.effFromDate}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>


                </div>
                <div class="list_wrapper" ng-if="vm.versionNumberList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>


<div class="modal" id="panNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN Details</h4>
            </div>
            <div class="modal-body">
                <div class="list_wrapper" ng-if="vm.panNumberDetailList.length>0">
                    <div class="list_wrapper">
                        <div class="col-sm-8 form_submit">
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </div>
                                    <input type="text" class="form-control"
                                           ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                           placeholder="Search" chars="alpha-numeric">
                                </div>
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-sm-12">

                                <table class="table table-bordered list scroll sort">

                                    <thead ng-init="reverseOrder = false; sortedColumn = 'panNo'">
                                    <tr>
                                        <th width="50%" class="modal-title title-case" ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';" ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN Number</th>
                                        <th width="50%" class="modal-title title-case" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Customer Name</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr class="cp"
                                        ng-repeat="x in vm.panNumberDetailList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                        data-bs-dismiss="modal"
                                        ng-click="vm.panNumber = x.panNo; vm.isPanSelected = true;">
                                        <td width="50%">{{x.panNo}}</td>
                                        <td width="50%">{{x.bondHolderName}}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                    <div class="list_wrapper" ng-if="vm.panNumberDetailList.length==0">No records found to display.</div>
                </div>

            </div>
        </div>
    </div>

</div>