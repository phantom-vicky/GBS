<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">{{vm.screenModule}} Interest Rate Code Maintenance for Investment schemes - Delete</h4>
    <sol-header></sol-header>
    <form name="interestRateCodeMaintenanceforInvestmentSchemesForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="moduleName" class="control-label">Module Name</label>
                    </div>
                    <div class="col-sm-4">
                        <select class="form-control" id="moduleName" name="moduleName"
                                ng-model="vm.moduleId"
                                ng-init="vm.getModuleName();" required>
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="item in vm.moduleList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="interestRateCode" class="control-label">Interest Rate Code</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="interestRateCode"
                               ng-model="vm.interestRateCode" maxlength="5" required readonly>
                    </div>
                    <div class="col-sm-2" ng-show="vm.moduleId">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getVerifyDeleteInterestRateCode();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.interestRateCode = vm.interestRateCodeDesc = vm.versionNo = vm.effectiveFromDate ='';"></i>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="interestRateCodeDescription" class="control-label">Interest Rate Description</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="interestRateCodeDescription"
                               ng-model="vm.interestRateCodeDesc" maxlength="50" required readonly>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="version" class="control-label">Version</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="version"
                               ng-model="vm.versionNo" maxlength="5" required readonly>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="version" class="control-label">Effective from  Date<br>
                            (dd/mm/yyyy)
                        </label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="effectiveFromDate"
                               ng-model="vm.effectiveFromDate" required readonly>
                    </div>
                </div>
            </div>

            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ng-click="vm.goNextState({
                              	moduleId : vm.moduleId,
                              	interestRateCode : vm.interestRateCode,
                              	interestRateCodeDesc : vm.interestRateCodeDesc,
                              	versionNo : vm.versionNo,
                              	screenModule : vm.screenModule,
                              	remarks : vm.remarks
                                })"
                        ng-disabled="interestRateCodeMaintenanceforInvestmentSchemesForm.$invalid">Next</button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        ng-click="vm.goPreviousState()">Cancel</button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>


<!-- Interest Rate Code Details Start-->
<div class="modal" id="interestRateCodeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Interest Rate Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.interestRateCodeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'INT_RATE_CODE'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'INT_RATE_CODE')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'INT_RATE_CODE';" ng-class="(sortedColumn == 'INT_RATE_CODE')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Interest rate code</th>
                                    <th ng-click="(sortedColumn == 'INT_RATE_DESC')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'INT_RATE_DESC';" ng-class="(sortedColumn == 'INT_RATE_DESC')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Interest Rate code description</th>
                                    <th ng-click="(sortedColumn == 'VERSION_NO')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'VERSION_NO';" ng-class="(sortedColumn == 'VERSION_NO')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Version no</th>
                                    <th ng-click="(sortedColumn == 'INT_EFF_FROM_DATE')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'INT_EFF_FROM_DATE';" ng-class="(sortedColumn == 'INT_EFF_FROM_DATE')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Effective From date</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.interestRateCodeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.interestRateCode= x.INT_RATE_CODE; vm.interestRateCodeDesc = x.INT_RATE_DESC;vm.versionNo = x.VERSION_NO;vm.remarks = x.REMARKS;vm.effectiveFromDate=x.INT_EFF_FROM_DATE;" data-bs-dismiss="modal">
                                    <td>{{x.INT_RATE_CODE}}</td>
                                    <td>{{x.INT_RATE_DESC}}</td>
                                    <td>{{x.VERSION_NO}}</td>
                                    <td>{{x.INT_EFF_FROM_DATE}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.interestRateCodeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Interest Rate Code Details End-->