<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper">
	<cbs-left-menu></cbs-left-menu>

	<h4 class="form_heading  feature-heading">Office Account Place
		Holder - Modify</h4>

	<notice-message-directive></notice-message-directive>

	<form name="officeAccountPlaceHolderForm" role="form"
		ng-submit="submitForm(officeAccountPlaceHolderForm.$valid)" novalidate>
		<div class="row">
			<div class="form-group required">
				<div class="col-sm-3"></div>
				<label for="bacid" class="control-label col-sm-3">Place
					Holder</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="bacid" name="bacid"
						ng-model="vm.officeAccountPlaceHolder.bacid" maxlength="16"
						required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group required">
				<div class="col-sm-3"></div>
				<label for="bacidDesc" class="control-label col-sm-3">Placeholder
					Description</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="bacidDesc"
						name="bacidDesc" ng-model="vm.officeAccountPlaceHolder.bacidDesc"
						maxlength="40" required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group required">
				<div class="col-sm-3"></div>
				<label for="schmType" class="control-label col-sm-3">Type of
					Scheme</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="schmType"
						name="schmType" ng-model="vm.officeAccountPlaceHolder.schmType"
						maxlength="5" required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<label for="additionalText1" class="control-label col-sm-3">Additional
					Text1</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText1"
						id="additionalText1"
						ng-model="vm.officeAccountPlaceHolder.additionalText1"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<label for="additionalText2" class="control-label col-sm-3">Additional
					Text2</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText2"
						id="additionalText2"
						ng-model="vm.officeAccountPlaceHolder.additionalText2"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<label for="additionalText3" class="control-label col-sm-3">Additional
					Text3</label>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						id="additionalText3"
						ng-model="vm.officeAccountPlaceHolder.additionalText3"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-sm-offset-5 col-sm-8 form_submit">

				<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="officeAccountPlaceHolderForm.$invalid"
					ng-click="vm.modify()">Update</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="window.location.href ='#!/';">Cancel</button>
			</div>
		</div>
	</form>
</div>


