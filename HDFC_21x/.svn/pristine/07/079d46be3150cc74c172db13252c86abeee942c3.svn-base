
<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
        <h4 class="form_heading">HUF Transfer – ADD </h4>
        <sol-header></sol-header>
        <ul class="nav nav-tabs"  ng-init="vm.tabReferenceAdd = 'customerMasterForm'" >
            <li  ng-class="{ 'active': vm.tabReferenceAdd == 'customerMasterForm'}" ng-click="vm.tabReferenceAdd ='customerMasterForm'"  >
                <a  id="blaOpeningForm"  ng-disabled="vm.isFieldsDisabled">BLA Opening – ADD</a>
            </li>
            <li ng-class="{ 'active': vm.tabReferenceAdd == 'reversalForm'}" ><a ng-click="vm.tabReferenceAdd ='reversalForm'" >BOND SUBSCRIPTION-REVERSAL-CHANGE - ADD</a></li>
        </ul>
        <div class="tab-content">
            <div id="customerMasterForm" ng-show="vm.tabReferenceAdd=='customerMasterForm'"   class="tab-pane fade in active">
                <div class="tab-body">
                    <uib-accordion close-others="oneAtATime">
                        <form name="vm.customerMasterForm" role="form"
                              ng-submit="vm.addcustomerMaster(vm.customerMasterForm.$valid)">

                            <div uib-accordion-group id="general-details"
                                 class="panel-default panel panel-open"
                                 heading="Bond Ledger Account Maintenance - Add" is-open="true">


                                <div class="row">
                                    <div class="form-group" ng-class="requiredClass">
                                        <label class="control-label col-sm-3">Mode of Holding
                                        </label>
                                        <div class="col-sm-2">
                                            :
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >Joint - Jointly</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >Joint - Anyone or Survivor</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH004'" >HUF</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH005'" >Legal Guardian</label>
                                        </div>
                                        <label class="control-label col-sm-3">Name of the Bond Scheme</label>
                                        <div class="col-sm-3">
                                            :
                                            <label class="data-bind">{{vm.schemeName}}</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div uib-accordion-group id="personal-details1" class="panel"
                                 heading='{{vm.titleText}}'
                                 is-open="vm.personalDetailsOpen"
                                 ng-class="(vm.customerMasterForm.$invalid) ? 'panel-danger' : 'panel-success'">

                                <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                    <table class="table table-bordered">
                                        <tbody>


                                        <tr>
                                            <td width="25%" class="form-group required" ng-if="vm.modeOfHolding=='MH004'">
                                                <label
                                                        for="subscriberFirstName" class="control-label">Bond Holder
                                                    Name</label></td>
                                            <td width="25%" class="form-group required" ng-if="vm.modeOfHolding!='MH004'"><label
                                                    for="subscriberFirstName" class="control-label">Bond Holder First
                                                Name</label></td>
                                            <td width="25%" ng-if="vm.modeOfHolding=='MH004'"><input type="text" class="form-control"
                                                                                                     id="subscriberFirstName" name="customerFirstName"
                                                                                                     maxlength="150"
                                                                                                     ng-model="vm.customerMasterDetails.bondHldFirstName"
                                                                                                     ng-disabled="vm.blaFlag == 'Y'"
                                                                                                     chars="only-letters-spsace"
                                                                                                     required
                                                                                                     ng-init="vm.holderName()"

                                            ></td>
                                            <td width="25% " ng-if="vm.modeOfHolding!='MH004'"><input type="text" class="form-control"
                                                                                                      id="subscriberFirstName" name="customerFirstName"
                                                                                                      maxlength="150"
                                                                                                      ng-model="vm.customerMasterDetails.bondHldFirstName"
                                                                                                      chars="only-letters"
                                                                                                      required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                            <td width="25%" ng-if="vm.modeOfHolding!='MH004'">Bond Holder Middle Name</td>
                                            <td width="25%" ng-if="vm.modeOfHolding!='MH004'"><input type="text" class="form-control"
                                                                                                     id="subscriberMiddleName" name="customerMiddleName"
                                                                                                     maxlength="150"
                                                                                                     ng-model="vm.customerMasterDetails.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                        <tr >
                                            <td width="25%" ng-if="vm.modeOfHolding!='MH004'">Bond Holder Last Name</td>
                                            <td width="25%" ng-if="vm.modeOfHolding!='MH004'"><input type="text" class="form-control"
                                                                                                     id="subscriberLastName" name="customerLastName"
                                                                                                     maxlength="150"
                                                                                                     ng-model="vm.customerMasterDetails.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" class="form-group required"><label
                                                    class="control-label">Holder Type</label></td>
                                            <td width="25%">
                                                <select class="form-control" ng-disabled="vm.blaFlag=='Y'"
                                                        ng-model="vm.customerMasterDetails.holderType" ng-change="vm.getValidations(vm.customerMasterDetails.holderType);" required>
                                                    <option value="" hidden="true">Select</option>
                                                    <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                                    <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                    <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                                </select>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%"><label
                                                    for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="fatherName" name="fatherName"
                                                                   maxlength="50" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                                   ng-model="vm.customerMasterDetails.fatherName"
                                                                   chars="only-letters" ng-disabled="vm.blaFlag=='Y'"
                                            ></td>
                                            <td width="25%">
                                                <label  class="control-label">Mother's Maiden Name</label>
                                            </td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="motherName" name="motherName"
                                                                   maxlength="50" ng-disabled="vm.blaFlag=='Y'"
                                                                   ng-model="vm.customerMasterDetails.motherName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Gender</label></td>
                                            <td width="25%" ng-if="vm.modeOfHolding!=='MH004'"><select class="form-control" id="gender"
                                                                                                       name="state" ng-model="vm.customerMasterDetails.gender"
                                                                                                       ng-required="!vm.customerMasterDetails.gender" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <option value="M" >MALE</option>
                                                <option value="F" >FEMALE</option>
                                                <option value="O" >OTHERS</option>
                                            </select></td>
                                            <td width="25%" ng-if="vm.modeOfHolding=='MH004'"><select class="form-control" id="gender"
                                                                                                      name="state" ng-model="vm.customerMasterDetails.gender"
                                                                                                      ng-required="!vm.customerMasterDetails.gender" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <option value="O" >OTHERS</option>
                                            </select></td>

                                            <td width="25%" class="form-group required" >
                                                <label class="control-label">Is Minor (Y/N)?</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       value="{{ vm.customerMasterDetails.isMinor === 'Y' ? 'YES' : 'NO' }}"
                                                       readonly>
                                            </td>


                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                            <td width="25%" ng-if="vm.modeOfHolding=='MH004'">
                                                <p class="input-group" >
                                                    <input type="text" class="form-control" id="bondHolderDateOfBirth12"
                                                           name="dateofBirth"
                                                           ng-model="vm.customerMasterDetails.bondHldDob" maxlength="10"
                                                           ng-blur="vm.textableDatePicker('bondHolderDateOfBirth12',vm.customerMasterDetails.bondHldDob);vm.futureNotAllowed('bondHolderDateOfBirth12',vm.customerMasterDetails.bondHldDob)"
                                                           ng-keyup="vm.autoslashing('bondHolderDateOfBirth12')"
                                                           chars="numbers-slash"

                                                           ng-change="vm.checkAge(vm.customerMasterDetails.isMinor, vm.customerMasterDetails.bondHldDob,'add','1')"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           datepicker-options="vm.retirDatePickerValidation"
                                                           is-open="vm.dateOptions.opened"
                                                           close-text="Close" maxlength="10"
                                                           readonly required>
                                                    <!--                                                                                                                    <span class="input-group-btn">-->
                                                    <!--                                                                                            <button type="button" class="btn btn-secondary"-->
                                                    <!--                                                                                                    ng-click="vm.dateOptions.opened = true"-->

                                                    <!--                                                                                                    ng-if="vm.blaFlag=='Y'"-->
                                                    <!--                                                                                                    id="bondHolderDateOfBirthOptions" ng-disabled="!vm.customerMasterDetails.isMinor">-->
                                                    <!--                                                                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                    <!--                                                                                            </button>-->
                                                    <!--                                                                                        </span>-->
                                                </p>
                                            </td>
                                            <td width="25%" ng-if="vm.modeOfHolding!=='MH004'">
                                                <p class="input-group" >
                                                    <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                           name="dateofBirth"
                                                           ng-model="vm.customerMasterDetails.bondHldDob"
                                                           ng-change="vm.checkAge(vm.customerMasterDetails.isMinor, vm.customerMasterDetails.bondHldDob,'add','1')"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           ng-blur="vm.textableDatePicker('bondHolderDateOfBirth',vm.customerMasterDetails.bondHldDob);vm.futureNotAllowed('bondHolderDateOfBirth',vm.customerMasterDetails.bondHldDob)"
                                                           ng-keyup="vm.autoslashing('bondHolderDateOfBirth')" chars="numbers-slash"

                                                           datepicker-options="vm.retirDatePickerValidation"
                                                           is-open="vm.dateOptions.opened"
                                                           close-text="Close" maxlength="10" readonly >
                                                    <!--                                                                                                                    <span class="input-group-btn" ng-if="vm.blaFlag=='Y'">-->
                                                    <!--                                                                                            <button type="button" class="btn btn-secondary"-->
                                                    <!--                                                                                                    ng-click="vm.dateOptions.opened = true"-->
                                                    <!--                                                                                                    id="bondHolderDateOfBirthOptions" ng-disabled="!vm.customerMasterDetails.isMinor">-->
                                                    <!--                                                                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                    <!--                                                                                            </button>-->
                                                    <!--                                                                                        </span>-->
                                                </p>
                                            </td>
                                            <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.isMinor == 'Y'}"><label
                                                    for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                            <td width="25%" ng-if="!vm.id && vm.blaFlag!='Y'"><input type="text" class="form-control"
                                                                                                     id="birthCertificateNo1" name="birthCertificateNo" ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"
                                                                                                     ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"

                                                                                                     maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetails.isMinor == 'Y'" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>


                                            <td width="25%" ng-if="(vm.id || vm.blaFlag=='Y')&&vm.customerMasterDetails.isMinor == 'Y'">
                                                <input type="text" class="form-control"
                                                       id="birthCertificateNo1" name="birthCertificateNo"
                                                       ng-model="vm.customerMasterDetails.detailsOfBirthCertificate" ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"
                                                       maxlength="30" chars="only-letters"
                                                       required ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" ng-if="(vm.id || vm.blaFlag=='Y')&&vm.customerMasterDetails.isMinor != 'Y'">
                                                <input type="text" class="form-control"
                                                       id="birthCertificateNo1" name="birthCertificateNo"
                                                       ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"  ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"
                                                       maxlength="30" chars="only-letters"
                                                       oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>


                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group required"><label
                                                    for="address1" class="control-label">Communication Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address1" name="address1" ng-model="vm.customerMasterDetails.bondHldAddOne"
                                                                   maxlength="200" ng-disabled="vm.blaFlag=='Y'"
                                                                   required   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                            <td width="25%" ><label
                                                    for="address2" class="control-label">Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address2" name="address2" ng-disabled="vm.blaFlag=='Y'"
                                                                   ng-model="vm.customerMasterDetails.bondHldAddTwo" maxlength="200"
                                                                   ng-init="vm.tempPresentPremise = vm.presentPremise"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                        </tr>
                                        <tr>

                                            <td width="25%" ><label
                                                    for="presentFlat" class="control-label">Address 3</label></td>
                                            <td width="25%"><input type="text" class="form-control" ng-disabled="vm.blaFlag=='Y'"
                                                                   id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetails.bondHldAddThree"
                                                                   maxlength="200"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                            <td width="25%"  class="form-group required">
                                                <label class="control-label">City</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" ng-disabled="vm.blaFlag=='Y'"
                                                                   ng-model="vm.customerMasterDetails.bondHldCity" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"></td>

                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">State</label></td>
                                            <td width="25%"><select class="form-control" id="state"
                                                                    name="state" ng-model="vm.customerMasterDetails.bondHldState"
                                                                    ng-init="vm.getState()" required ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select State</option>
                                                <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                            </select></td>

                                            <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6" ng-blur="vm.getAddressOne(vm.customerMasterDetails.bondHldPinCode)"
                                                                   ng-model="vm.customerMasterDetails.bondHldPinCode"
                                                                   onkeypress="return isNumber(event)" required oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>
                                        <tr>
                                            <td width="25%">Phone Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="saphoneNum" ng-model="vm.customerMasterDetails.bondHolderPhoneNumber"
                                                                   chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%">Mobile Number</td>
                                            <td width="25%">
                                                <input type="text" class="form-control" minlength="10" maxlength="35"
                                                       id="mobileNumber" ng-model="vm.customerMasterDetails.bondHldMobNum"
                                                       chars="numbers-with-special-characters" oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>


                                        </tr>

                                        <tr>

                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%" ><input type="email" class="form-control"
                                                                    id="emailId" name="emailId" maxlength="100"
                                                                    ng-model="vm.customerMasterDetails.bondHldEmail" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                            <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group':'form-group')" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.holderType == 'HT001' || vm.customerMasterDetails.holderType == 'HT002')">
                                                <label for="emailId" class="control-label " > HUF registration / Power of Attorney number</label>
                                            </td>



                                            <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004') && (vm.customerMasterDetails.holderType == 'HT001' || vm.customerMasterDetails.holderType == 'HT002')">
                                                <input type="text" class="form-control" minlength="1" maxlength="20" chars="alpha-numeric"
                                                       id="powerOfattorneyNo" ng-model="vm.customerMasterDetails.hufRegPowerOfAttorney" chars="alpha-numeric"
                                                       oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>


                                        <tr >
                                            <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group':'form-group')" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.holderType == 'HT001' || vm.customerMasterDetails.holderType == 'HT002')">
                                                <label for="emailId" class="control-label ">Power of Attorney/Karta Name</label>
                                            </td>


                                            <td width="25%" ng-if="(vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004')&&(vm.customerMasterDetails.holderType == 'HT001' || vm.customerMasterDetails.holderType == 'HT002')">
                                                <input type="text" class="form-control" minlength="1" maxlength="70"
                                                       id="kartaName" ng-model="vm.customerMasterDetails.powerOfAttorneyKartaName"
                                                       ng-keypress="vm.validateInput($event,'kartaName');" ng-disabled="vm.blaFlag=='Y'">
                                            </td>




                                        </tr>


                                        </tbody>
                                    </table>

                                    <h4 class="form_heading" ng-if="vm.modeOfHolding=='MH004'">Coparceners Details of Karta</h4>
                                    <div class="col-sm-12 text-right form_submit" ng-if="vm.modeOfHolding=='MH004'">
                                        <div class="row">
                                            <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRanges()">
                                                <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                            </a>

                                        </div>
                                    </div>
                                    <table class="table table-bordered table-striped" ng-if="vm.modeOfHolding=='MH004'">
                                        <tbody ng-repeat="item in vm.coparcenerslist">
                                        <tr>
                                            <td colspan="4">
                                                <div class="col-sm-12 text-right form_submit">
                                                    <div class="row">

                                                        <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-if="vm.enableDelete" ng-click="vm.removeRanges(item.id.oldValue, $index)">
                                                            <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td colspan="4"><h4 class="form_heading">Coparceners Details of Karta {{$index+1}}</h4></td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label for="coparcenersName[$index]">Coparceners  Name <span class="text-danger"> * </span></label></label></td>
                                            <td class="form-group">
                                                <input type="text" class="form-control" id="coparcenersName[$index]"
                                                       chars="only-letters"
                                                       limit-to="50" name="coparcenersName"
                                                       ng-model="item.coparcenersName" required leading-space ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" class="form-group" ><label class="control-label">Relationship with Karta</label></td>
                                            <td class="form-group" ng-required="item.coparcenersName">
                                                <select type="text" class="form-control" id="coparcenersRelation[$index]"
                                                        chars="alpha-numeric"
                                                        limit-to="50" name="coparcenersRelation"
                                                        ng-model="item.coparcenersRelation"  oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>
                                        </tr>




                                        <tr>
                                            <td width="25%" class="form-group" >
                                                <label class="control-label">DOB</label></td>
                                            <td class="form-group" ng-required="item.coparcenersName">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="coparcenersDob{{$index}}" name="coparcenersDob"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           ng-model="item.coparcenersDob" maxlengtth="10" ng-init="coparcener.datepickerOpened=false"
                                                           is-open="coparcener.datepickerOpened" close-text="Close" maxlength="10"
                                                           ng-blur="vm.textableDatePicker('coparcenersDob{{$index}}',item.coparcenersDob)"
                                                           ng-keyup="vm.autoslashing('coparcenersDob{{$index}}')" chars="numbers-slash"
                                                           ng-disabled="vm.blaFlag=='Y'"

                                                    >

                                                    <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="coparcener.datepickerOpened=true"  >


                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                                </p>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>


                                    <h4 class="form_heading" ng-if="vm.customerMasterDetails.isMinor=='Y'">GUARDIAN DETAILS</h4>
                                    <table class="table table-bordered" ng-if="vm.customerMasterDetails.isMinor=='Y'">
                                        <tbody>

                                        <tr>
                                            <td width="25%" >
                                                <label for="guardianId" class="control-label">Guardian Id</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="guardianId"
                                                               name="guardianId"
                                                               ng-model="vm.customerMasterDetails.guardianId" disabled>
                                                    </div>
                                                    <div class="col-sm-3 torch-top" >
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                        <i class="glyphicon glyphicon-remove clear cp"
                                                           ng-click=
                                                                   "vm.customerMasterDetails.guardianId = '';
                                               vm.customerMasterDetails.guardianFirstName= '';
                                               vm.customerMasterDetails.guardianMiddleName='';
                                               vm.customerMasterDetails.guardianLastName='';
                                               vm.customerMasterDetails.relationWithMinor='';
                                               vm.customerMasterDetails.guardianDateOfBirth='';
                                               vm.customerMasterDetails.guardianCommunicationAddress='';
                                               vm.customerMasterDetails.guardianMobileNo='';
                                               vm.customerMasterDetails.guardianEmailId=''; " id="guardianIdClose"></i>
                                                        <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="25%" class="form-group required"><label
                                                    for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianFirstName" name="guardianFirstName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetails.guardianFirstName"
                                                                   chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>

                                        <tr>
                                            <td width="25%">Guardian Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianMiddleName" name="guardianMiddleName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetails.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%">Guardian Last Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianLastName" name="guardianLastName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetails.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Relation with minor</label></td>
                                            <td width="25%">
                                                <select class="form-control" id="relationWithMinor" ng-init=""
                                                        name="relationWithMinor" ng-model="vm.customerMasterDetails.relationWithMinor"
                                                        required ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">Date of Birth</label></td>
                                            <td width="25%">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="guardianDateOfBirth1" ng-init="vm.isAgeValid();"
                                                           name="guardianDateOfBirth" ng-model="vm.customerMasterDetails.guardianDateOfBirth"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           datepicker-options="vm.dobCalenderOptions"
                                                           ng-blur="vm.textableDatePicker('guardianDateOfBirth1',vm.customerMasterDetails.guardianDateOfBirth)"
                                                           ng-keyup="vm.autoslashing('guardianDateOfBirth1')" chars="numbers-slash"

                                                           is-open="vm.submissionfifteenGHPicker.opened" close-text="Close"  ng-disabled="vm.blaFlag=='Y'">
                                                    <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                                </p>
                                            </td>
                                        </tr>


                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="address1" class="control-label">Communication Address</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetails.guardianCommunicationAddress"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%">Mobile Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="guardianMobileNumber" ng-model="vm.customerMasterDetails.guardianMobileNo"
                                                                   chars="numbers-with-special-characters" oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                                   ng-model="vm.customerMasterDetails.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        </tr>


                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">Interest Payout Account Details</h4>
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label break-word">Whether the customer belongs to HDFC?</label></td>
                                            <td width="25%">
                                                <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">Yes
                                                <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">No
                                            </td>

                                            <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'" class="form-group required">
                                                <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                                <!--                                                                <input type="text" class="form-control"  ng-init="vm.customerMasterDetails.operativeAccNum ==''"-->
                                                <!--                                                                       id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20"-->
                                                <!--                                                                       ng-model="vm.customerMasterDetails.operativeAccNum"-->
                                                <!--                                                                       ng-required="vm.customerMasterDetails.hdfcOtherBank == 'Y'"-->
                                                <!--                                                                       ng-disabled="vm.customerMasterDetails.hdfcOtherBank != 'Y'"-->
                                                <!--                                                                       oninput="this.value = this.value.toUpperCase()"-->
                                                <!--                                                                       oninput="this.value = this.value.replace(/\s+/g, '')">-->
                                                <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                                <input type="text" class="form-control"
                                                       ng-init="vm.customerMasterDetails.operativeAccNum ==''"
                                                       id="operativeAcc" name="operativeAcc" chars="only-numbers"  maxlength="20" minlength="9"
                                                       ng-model="vm.customerMasterDetails.operativeAccNum"
                                                       ng-required="vm.customerMasterDetails.hdfcOtherBank == 'Y'"
                                                       ng-disabled="vm.customerMasterDetails.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'"
                                                       oninput="this.value = this.value.toUpperCase().replace(/^\s+/g, '').replace(/\s+/g, '')">

                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                                <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetails(vm.customerMasterDetails.operativeAccNum);"
                                                        ng-disabled="!vm.customerMasterDetails.operativeAccNum || vm.customerMasterDetails.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'">
                                                    Fetch
                                                </button>
                                            </td>


                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label break-word">Mode of Interest Payment/ Principal Repayment</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="modeOfInterestPayment" ng-init=""
                                                        name="modeOfInterestPayment" ng-model="vm.customerMasterDetails.modeOfInterestPayment" ng-change="vm.modeOfInterestPaymentValidation(vm.customerMasterDetails.modeOfInterestPayment);"
                                                        required ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.modeOfInterestPaymentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>

                                            <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                                <label class="control-label">Operative Account Number</label>
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                                <input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                                       ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                            </td>

                                        </tr>

                                        <tr>

                                            <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                                <label class="control-label">Account Type code</label>
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                                <select class="form-control" id="modeOfInterestPayment"
                                                        name="accountType" ng-model="vm.customerMasterDetails.accountType"
                                                        required ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.accountTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>


                                            <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                                <label class="control-label">DD/PO Account Number</label></td>
                                            <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                                <input type="text" class="form-control"
                                                       id="ddpoAccountNo" name="ddpoAccountNo" chars="only-numbers" maxlength="20"
                                                       ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                        <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'||vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                            <td width="25%" class="form-group" >
                                                <label class="control-labelaria-controls">Bank Name</label></td>
                                            <!--                                                            <td width="25%">-->
                                            <!--                                                                <div class="row">-->
                                            <!--                                                                    <div class="col-sm-9">-->
                                            <!--                                                                        <input type="text" class="form-control" id="bankCode"-->
                                            <!--                                                                               name="bankCode"-->
                                            <!--                                                                               ng-model="vm.customerMasterDetails.bankCode"-->
                                            <!--                                                                               chars="alpha-numeric" disabled readonly required>-->
                                            <!--                                                                    </div>-->
                                            <!--                                                                    <div class="col-sm-3 torch-top">-->
                                            <!--                                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                            <!--                                                                           ng-click="vm.getOtherBankDetailsTorch();" id="otherBankSearcher"></i>-->
                                            <!--                                                                        <i class="glyphicon glyphicon-remove clear cp"-->
                                            <!--                                                                           ng-click="vm.bankCode = ''; vm.branchCode = ''" id="otherBankolIdClose"></i>-->
                                            <!--                                                                    </div>-->
                                            <!--                                                                </div>-->

                                            <!--                                                            </td>-->
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="bankName"
                                                               name="bankName"
                                                               ng-model="vm.customerMasterDetails.bankName"
                                                               chars="alpha-numeric" disabled>
                                                    </div>
                                                    <div class="col-sm-3 torch-top">
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           id="otherBankSearcher"
                                                           ng-click="vm.getOtherBankDetailsTorch('bankName');"></i> <i
                                                            class="glyphicon glyphicon-remove clear cp"
                                                            ng-click="vm.customerMasterDetails.bankCode='';vm.customerMasterDetails.branchCode=''"></i>
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="25%" class="form-group" >
                                                <label class="control-label">Branch Code</label></td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="micrBranchCode" maxlength="20"
                                                               ng-model="vm.customerMasterDetails.branchCode" chars="alpha-numeric" ng-disabled="vm.blaFlag=='Y'">
                                                    </div>
                                                    <div class="col-sm-3 torch-top">
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           id="micrBranchCodeSearch"
                                                           ng-click="vm.getOtherBankDetailsTorch('micrBranchCode');"></i> <i
                                                            class="glyphicon glyphicon-remove clear cp"
                                                            ng-click="vm.customerMasterDetails.branchCode='';"></i>
                                                    </div>
                                                </div>
                                            </td>
                                            <!--                                                            <td width="25%">-->
                                            <!--                                                                <div class="row">-->
                                            <!--                                                                    <div class="col-sm-9">-->
                                            <!--                                                                        <input type="text" class="form-control" id="branchCode"-->
                                            <!--                                                                               name="branchCodeNonMicr"-->
                                            <!--                                                                               ng-model="vm.customerMasterDetails.branchCode"-->
                                            <!--                                                                               chars="alpha-numeric" disabled readonly required>-->
                                            <!--                                                                    </div>-->
                                            <!--                                                                    <div class="col-sm-3 torch-top" ng-if="vm.customerMasterDetails.bankCode">-->
                                            <!--                                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                            <!--                                                                           id="branchCode"-->
                                            <!--                                                                           ng-click="vm.getOtherBankDetailsTorch('branchCode');"></i> <i-->
                                            <!--                                                                            class="glyphicon glyphicon-remove clear cp"-->
                                            <!--                                                                            ng-click="vm.customerMasterDetails.branchCode='';"></i>-->
                                            <!--                                                                    </div>-->
                                            <!--                                                                </div>-->
                                            <!--                                                            </td>-->
                                        </tr>

                                        <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                            <td width="25%"  >
                                                <label for="guardianId" class="control-label">IFSC Code</label>
                                            </td>
                                            <td width="25%" >
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="instIfscCode"
                                                               ng-model="vm.customerMasterDetails.ifscCode" chars="alpha-numeric"
                                                               maxlength="11" style="text-transform: uppercase"
                                                               oninput="this.value = this.value.toUpperCase()" ng-disabled="vm.blaFlag=='Y'">
                                                    </div>
                                                    <div class="col-sm-3 torch-top">
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           id="instIfscCodeSearch"
                                                           ng-click="vm.getOtherBankDetailsTorch('ifsc');"></i> <i
                                                            class="glyphicon glyphicon-remove clear cp"
                                                            ng-click="vm.customerMasterDetails.ifscCode='';"></i>
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Name of the Payee</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="nameOfthePayee" name="nameOfthePayee" chars="alpha-numeric" maxlength="150" ng-init="vm.customerMasterDetails.nameOfthePayee = vm.bondHolderName"
                                                       ng-model="vm.customerMasterDetails.nameOfthePayee" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                        <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                            <td width="25%" class="form-group required" >
                                                <label class="control-label">Credit Account Number</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="creditAccNo" name="creditAccNo" chars="only-numbers" maxlength="20"
                                                       ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%">
                                            <td width="25%">
                                            </td>
                                        </tr>

                                        <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Operative Account Number</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                                       ng-model="vm.customerMasterDetails.operativeAccNumber"  oninput="this.value = this.value.replace(/\s+/g, '')" required ng-disabled="vm.blaFlag=='Y'">
                                                <!--                                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                            </td>
                                            <td width="25%" >
                                                <label for="guardianId" class="control-label">IFSC Code</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="instIfscCode"
                                                               ng-model="vm.customerMasterDetails.ifscCode" chars="alpha-numeric"
                                                               maxlength="11" style="text-transform: uppercase"
                                                               oninput="this.value = this.value.toUpperCase()" ng-disabled="vm.blaFlag=='Y'">
                                                    </div>
                                                    <div class="col-sm-3 torch-top">
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           id="instIfscCodeSearch"
                                                           ng-click="vm.getOtherBankDetailsTorch('ifsc');"></i> <i
                                                            class="glyphicon glyphicon-remove clear cp"
                                                            ng-click="vm.customerMasterDetails.ifscCode='';vm.customerMasterDetails.micrCode=''"></i>
                                                    </div>
                                                </div>
                                            </td>

                                        </tr>
                                        <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">

                                            <td width="25%">
                                                <label class="control-label">MICR Code</label></td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="micrBankCode" minlength="9" maxlength="9"
                                                               ng-required="vm.customerMasterDetails.micrCode && vm.customerMasterDetails.micrCode.length > 0"
                                                               ng-model="vm.customerMasterDetails.micrCode" chars="alpha-numeric" ng-disabled="vm.blaFlag=='Y'">
                                                    </div>
                                                    <div class="col-sm-3 torch-top">
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           id="micrBankCodeSearch"
                                                           ng-click="vm.getOtherBankDetailsTorch('micrCodeBank');"></i> <i
                                                            class="glyphicon glyphicon-remove clear cp"
                                                            ng-click="vm.customerMasterDetails.micrCode='';"></i>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>


                                        <tr>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label">PAN No</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="panNumber"
                                                       name="panNumber" maxlength="10" chars="alpha-numeric" readonly
                                                       ng-model="vm.customerMasterDetails.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>


                                        </tr>


                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">WITNESS DETAILS</h4>
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameOne" name="witnessNameOne"
                                                                   maxlength="30"
                                                                   ng-model="vm.customerMasterDetails.witnessNameOne"
                                                                   chars="only-letters"  leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressOne" name="witnessAddressOne"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetails.witnessAddressOne"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameTwo" name="witnessNameTwo"
                                                                   maxlength="30"
                                                                   ng-model="vm.customerMasterDetails.witnessNameTwo"
                                                                   chars="only-letters" leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressTwo" name="witnessAddressTwo"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetails.witnessAddressTwo"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                    <table class="table table-bordered">
                                        <div class="col-md-12 map-div">
                                            <div width="50%">
                                                <input type="checkbox" id="birthCertificate" name="birthCertificate" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.birthCertificate" ng-required="vm.birthCertificate" ng-disabled="vm.blaFlag=='Y'">
                                                <label for="birthCertificate">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                            </div><div width="50%">
                                            <input type="checkbox" id="passport" name="passport" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.passport" ng-required="vm.passport" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="passport">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.seniorCitizenCard" ng-required="vm.seniorCitizenCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="seniorCitizenCard">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="voterId" name="voterId" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.voterIdCard" ng-required="vm.voterIdCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="voterId">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="panCard" name="panCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.panCard" ng-required="vm.panCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="panCard">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="drivingLicence" name="drivingLicence" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.drivingLicence" ng-required="vm.drivingLicence" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="drivingLicence">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="rationCard" name="rationCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.rationCard" ng-required="vm.rationCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="rationCard">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                        </div>
                                            <div width="50%">
                                                <input type="checkbox" id="others" name="others" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.otherDocuments" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                                <label for="others">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                            </div>
                                        </div>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="otherDetails" name="otherDetails"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetails.otherDetails" oninput="this.value = this.value.replace(/^\s/, '')" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Remarks</label>
                                            </td>
                                            <td width="25%" >
                                                <input type="text" class="form-control"
                                                       id="remarks" name="remarks"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetails.remarks" oninput="this.value = this.value.replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                    </table>

                                </ng-form>
                            </div>

                            <div uib-accordion-group id="joint-personal-details" class="panel"
                                 heading="SECOND JOINT ACCOUNT HOLDER DETAILS"
                                 is-open="vm.secondHolderDetails"
                                 ng-class="(vm.secondJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.noOfJointAcc >= 2">
                                <ng-form name="vm.secondJoinAccountHolderDetails">
                                    <table class="table table-bordered">
                                        <tbody>

                                        <tr>
                                            <td width="25%" class="form-group required"><label
                                                    for="subscriberFirstName" class="control-label">Bond Second Holder First
                                                Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberFirstName" name="customerFirstName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldFirstName"
                                                                   ng-disabled="vm.blaFlag=='Y'"
                                                                   chars="only-letters"
                                                                   required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')"></td>
                                            <td width="25%">Bond Second Holder Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberMiddleName" name="customerMiddleName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">Bond Second Holder Last Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberLastName" name="customerLastName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" class="form-group "><label
                                                    class="control-label">Holder Type</label></td>
                                            <td width="25%">
                                                <select class="form-control"
                                                        ng-model="vm.customerMasterDetailsTwo.holderType" ng-change="vm.getValidations(vm.customerMasterDetailsTwo.holderType);"   maxlength="10" ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT002">Power of Attorney</option>

                                                    <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                    <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                                </select>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td width="25%">
                                                <label for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label>
                                            </td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="fatherName" name="fatherName"
                                                                   maxlength="50"
                                                                   ng-model="vm.customerMasterDetailsTwo.fatherName"
                                                                   chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                            <td width="25%" >
                                                <label  class="control-label">Mother's Maiden Name</label>
                                            </td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="motherName" name="motherName"
                                                                   maxlength="50"
                                                                   ng-model="vm.customerMasterDetailsTwo.motherName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required" >
                                                <label class="control-label">Gender</label></td>
                                            <td width="25%"><select class="form-control" id="gender"
                                                                    name="state" ng-model="vm.customerMasterDetailsTwo.gender"
                                                                    ng-required="!vm.customerMasterDetailsTwo.gender" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <option value="M" >MALE</option>
                                                <option value="F" >FEMALE</option>
                                                <option value="O" >OTHERS</option>
                                            </select></td>


                                            <td width="25%" class="form-group required" >
                                                <label class="control-label">Is Minor (Y/N)?</label></td>
                                            <td width="25%">
                                                <!--                                                                <select class="form-control" id="isMinor"-->
                                                <!--                                                                                    name="isMinor" ng-model="vm.customerMasterDetailsTwo.isMinor"-->
                                                <!--                                                                                    ng-required="!vm.customerMasterDetailsTwo.isMinor"-->
                                                <!--                                                                                    ng-change ="vm.customerMasterDetailsTwo.bondHldDob=''"-->
                                                <!--                                                                                    required>-->
                                                <!--                                                                <option value="" hidden="true">Select</option>-->
                                                <!--                                                                <option value="Y" >YES</option>-->
                                                <!--                                                                <option value="N" >NO</option>-->
                                                <!--                                                            </select>-->
                                                <input type="text" class="form-control"
                                                       value="{{ vm.customerMasterDetailsTwoFlag === 'Y' ? 'YES' : 'NO' }}"

                                                       readonly>
                                            </td>



                                        </tr>
                                        <tr>


                                            <td width="25%" class="form-group">
                                                <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                            <td width="25%">

                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="customerMasterDetailsTwoBondHldDob"
                                                           name="effFromDate" ng-model="vm.customerMasterDetailsTwo.bondHldDob"
                                                           ng-change="vm.checkAge(vm.customerMasterDetailsTwoFlag, vm.customerMasterDetailsTwo.bondHldDob,'add','2')"
                                                           uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.customerMasterDetailsTwo.bondHldDob='';"
                                                           datepicker-options="vm.retirDatePickerValidation"
                                                           ng-blur="vm.textableDatePicker('customerMasterDetailsTwoBondHldDob',vm.customerMasterDetails.bondHldDob);vm.futureNotAllowed('customerMasterDetailsTwoBondHldDob',vm.customerMasterDetailsTwo.bondHldDob)"
                                                           ng-keyup="vm.autoslashing('customerMasterDetailsTwoBondHldDob')" chars="numbers-slash"

                                                           is-open="vm.effFromDatePickerTwo.opened" close-text="Close"
                                                           maxlength="10" readonly>
                                                    <!--                                                                                                                    <span class="input-group-btn">-->
                                                    <!--                                                                            <button type="button" class="btn btn-secondary"-->
                                                    <!--                                                                                    ng-click="vm.effFromDatePickerTwo.opened = true"-->
                                                    <!--                                                                                    id="customerMasterDetailsTwoBondHldDobSearcher" ng-if="vm.blaFlag=='Y'">-->
                                                    <!--                                                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                    <!--                                                                            </button>-->
                                                    <!--                                                                        </span>-->
                                                </p>



                                            <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsTwoFlag == 'Y'}"><label
                                                    for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br> as per norms</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                                                   ng-value="vm.customerMasterDetailsTwo.isMinor == 'Y' ? 'YES' : vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                                                   maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetailsTwoFlag == 'Y'"  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>


                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group"><label
                                                    for="address1" class="control-label">Communication Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address1" name="address1" ng-model="vm.customerMasterDetailsTwo.bondHldAddOne"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%" ><label
                                                    for="address2" class="control-label">Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address2" name="address2"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldAddTwo" maxlength="200"
                                                                   ng-init="vm.tempPresentPremise = vm.presentPremise"   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>
                                        <tr>

                                            <td width="25%" ><label
                                                    for="presentFlat" class="control-label">Address 3</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsTwo.bondHldAddThree"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%" class="form-group">
                                                <label class="control-label">City</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldCity" ng-disabled="vm.blaFlag=='Y'" ></td>

                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">State</label></td>
                                            <td width="25%"><select class="form-control" id="state"
                                                                    name="state" ng-model="vm.customerMasterDetailsTwo.bondHldState"
                                                                    ng-init="vm.getState()" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select State</option>
                                                <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                            </select></td>

                                            <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"  ng-blur="vm.getAddressTwo(vm.customerMasterDetailsTwo.bondHldPinCode)"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldPinCode"
                                                                   onkeypress="return isNumber(event)" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>
                                        <tr>
                                            <td width="25%">Phone Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="saphoneNum" ng-model="vm.customerMasterDetailsTwo.bondHolderPhoneNumber"
                                                                   chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%">Mobile Number</td>
                                            <td width="25%">
                                                <input type="text" class="form-control" minlength="10" maxlength="35"
                                                       id="mobileNumber" ng-model="vm.customerMasterDetailsTwo.bondHldMobNum"
                                                       chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>


                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="emailId" name="emailId" maxlength="100"
                                                                   ng-model="vm.customerMasterDetailsTwo.bondHldEmail" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>


                                        </tr>

                                        </tbody>
                                    </table>



                                    <h4 class="form_heading" ng-if="vm.customerMasterDetailsTwoFlag=='Y'">GUARDIAN DETAILS</h4>
                                    <table class="table table-bordered" ng-if="vm.customerMasterDetailsTwoFlag=='Y'">
                                        <tbody>

                                        <tr>
                                            <td width="25%" >
                                                <label for="guardianId" class="control-label">Guardian Id</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="guardianId"
                                                               name="guardianId"
                                                               ng-model="vm.customerMasterDetailsTwo.guardianId" disabled>
                                                    </div>
                                                    <div class="col-sm-3 torch-top" >
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           ng-click="vm.getGuardianDetailsTwo('select');" id="guardianIdSearcher"></i>
                                                        <i class="glyphicon glyphicon-remove clear cp"
                                                           ng-click="vm.customerMasterDetailsTwo.guardianId = '';
                                               vm.customerMasterDetailsTwo.guardianFirstName= '';
                                               vm.customerMasterDetailsTwo.guardianMiddleName='';
                                               vm.customerMasterDetailsTwo.guardianLastName='';
                                               vm.customerMasterDetailsTwo.relationWithMinor='';
                                               vm.customerMasterDetailsTwo.guardianDateOfBirth='';
                                               vm.customerMasterDetailsTwo.guardianCommunicationAddress='';
                                               vm.customerMasterDetailsTwo.guardianMobileNo='';
                                               vm.customerMasterDetailsTwo.guardianEmailId='';
                                            " id="guardianIdClose"></i>
                                                        <!--                                            "vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();"-->
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="25%" class="form-group required"><label
                                                    for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianFirstName" name="guardianFirstName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.guardianFirstName"
                                                                   chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>

                                        <tr>
                                            <td width="25%">Guardian Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianMiddleName" name="guardianMiddleName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%">Guardian Last Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianLastName" name="guardianLastName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsTwo.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Relation with minor</label></td>
                                            <td width="25%">
                                                <select class="form-control" id="relationWithMinor" ng-init=""
                                                        name="relationWithMinor" ng-model="vm.customerMasterDetailsTwo.relationWithMinor"
                                                        required ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">Date of Birth</label></td>
                                            <td width="25%">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="guardianDateOfBirth" ng-init="vm.isAgeValid();"
                                                           name="guardianDateOfBirth" ng-model="vm.customerMasterDetailsTwo.guardianDateOfBirth"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           readonly
                                                           datepicker-options="vm.submissionfifteenGH"
                                                           is-open="vm.submissionfifteenGHPicker.opened" close-text="Close"
                                                           ng-blur="vm.textableDatePicker('guardianDateOfBirth',vm.customerMasterDetailsTwo.guardianDateOfBirth)"
                                                           ng-keyup="vm.autoslashing('guardianDateOfBirth')" chars="numbers-slash"
                                                    >
                                                    <!--                                                <span class="input-group-btn" ng-if="vm.blaFlag!='Y'">-->
                                                    <!--                                                    <button type="button" class="btn btn-secondary"-->
                                                    <!--                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"-->
                                                    <!--                                                            id="submissionfifteenGHSearcher">-->
                                                    <!--                                                        <i class="glyphicon glyphicon-calendar"></i>-->
                                                    <!--                                                    </button>-->
                                                    <!--                                                </span>-->
                                                </p>
                                            </td>
                                        </tr>


                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="address1" class="control-label">Communication Address</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsTwo.guardianCommunicationAddress"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%">Mobile Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="guardianMobileNumber" ng-model="vm.customerMasterDetailsTwo.guardianMobileNo"
                                                                   chars="numbers-with-special-characters" oninput="this.value = this.value.replace(/\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                                   ng-model="vm.customerMasterDetailsTwo.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        </tr>


                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">Interest Payout Account Details</h4>

                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label break-word">Whether the customer belongs to HDFC?</label></td>
                                            <td width="25%">
                                                <input type="radio" id="hdfcOtherBankY1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">Yes
                                                <input type="radio" id="hdfcOtherBankN1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">No
                                            </td>

                                            <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'" class="form-group required">
                                                <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                                <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsTwo.operativeAccNum ==''"
                                                       id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20" minlength="9"
                                                       ng-model="vm.customerMasterDetailsTwo.operativeAccNum"
                                                       ng-required="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'"
                                                       ng-disabled="vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'"
                                                       oninput="this.value = this.value.toUpperCase()"
                                                       oninput="this.value = this.value.replace(/\s+/g, '')">
                                                <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                                <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetailsTwo(vm.customerMasterDetailsTwo.operativeAccNum);"
                                                        ng-disabled="!vm.customerMasterDetailsTwo.operativeAccNum || vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'">
                                                    Fetch1
                                                </button>
                                            </td>
                                        </tr>


                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">PAN No</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="panNumber"
                                                       name="panNumber" maxlength="10" chars="alpha-numeric" readonly
                                                       ng-model="vm.customerMasterDetailsTwo.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                        </tr>




                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">WITNESS DETAILS</h4>
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameOne" name="witnessNameOne"
                                                                   maxlength="30" chars="only-letters"
                                                                   ng-model="vm.customerMasterDetailsTwo.witnessNameOne"
                                                                   leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressOne" name="witnessAddressOne"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetailsTwo.witnessAddressOne"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameTwo" name="witnessNameTwo"
                                                                   maxlength="30"
                                                                   ng-model="vm.customerMasterDetailsTwo.witnessNameTwo"
                                                                   chars="only-letters" leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressTwo" name="witnessAddressTwo"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetailsTwo.witnessAddressTwo"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                    <table class="table table-bordered">
                                        <div class="col-md-12 map-div">
                                            <div width="50%">
                                                <input type="checkbox" id="birthCertificateTwo" name="birthCertificateTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.birthCertificate" ng-required="vm.birthCertificate" ng-disabled="vm.blaFlag=='Y'">
                                                <label for="birthCertificateTwo">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                            </div><div width="50%">
                                            <input type="checkbox" id="passportTwo" name="passportTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.passport" ng-required="vm.passport" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="passportTwo">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="seniorCitizenCardTwo" name="seniorCitizenCardTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.seniorCitizenCard" ng-required="vm.seniorCitizenCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="seniorCitizenCardTwo">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="voterIdTwo" name="voterIdTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.voterIdCard" ng-required="vm.voterIdCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="voterIdTwo">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="panCardTwo" name="panCardTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.panCard" ng-required="vm.panCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="panCardTwo">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="drivingLicenceTwo" name="drivingLicenceTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.drivingLicence" ng-required="vm.drivingLicence" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="drivingLicenceTwo">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="rationCardTwo" name="rationCardTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.rationCard" ng-required="vm.rationCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="rationCardTwo">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="othersTwo" name="othersTwo" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.otherDocuments" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="othersTwo">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                        </div>
                                        </div>

                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="otherDetails" name="otherDetails"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetailsTwo.otherDetails" oninput="this.value = this.value.replace(/^\s/, '')" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">Remarks</label>
                                            </td>
                                            <td width="25%" >
                                                <input type="text" class="form-control"
                                                       id="remarks" name="remarks"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetailsTwo.remarks" oninput="this.value = this.value.replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                    </table>

                                </ng-form>
                            </div>

                            <div uib-accordion-group id="joint-personal-details-three" class="panel"
                                 heading="THIRD JOINT ACCOUNT HOLDER DETAILS"
                                 is-open="vm.thirdHolderDetails"
                                 ng-class="(vm.thirdJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.noOfJointAcc >= 3">
                                <ng-form name="vm.thirdJoinAccountHolderDetails">
                                    <table class="table table-bordered">
                                        <tbody>

                                        <tr>
                                            <td width="25%" class="form-group required"><label
                                                    for="subscriberFirstName" class="control-label">Bond Third Holder First
                                                Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberFirstName" name="customerFirstName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldFirstName"
                                                                   chars="only-letters"
                                                                   required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                            <td width="25%">Bond Third Holder Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberMiddleName" name="customerMiddleName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldMidName" chars="only-letters"  oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">Bond Third Holder Last Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="subscriberLastName" name="customerLastName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                            <td width="25%" class="form-group"><label
                                                    class="control-label">Holder Type</label></td>
                                            <td width="25%">
                                                <select class="form-control"
                                                        ng-model="vm.customerMasterDetailsThree.holderType" ng-change="vm.getValidations(vm.customerMasterDetailsThree.holderType);"  maxlength="10" ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT002">Power of Attorney</option>

                                                    <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                    <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                                </select>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%"><label
                                                    for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="fatherName" name="fatherName"
                                                                   maxlength="50"
                                                                   ng-model="vm.customerMasterDetailsThree.fatherName"
                                                                   chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>
                                            <td width="25%">
                                                <label  class="control-label">Mother's Maiden Name</label>
                                            </td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="motherName" name="motherName"
                                                                   maxlength="50"
                                                                   ng-model="vm.customerMasterDetailsThree.motherName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required" >
                                                <label class="control-label">Gender</label></td>
                                            <td width="25%"><select class="form-control" id="gender"
                                                                    name="state" ng-model="vm.customerMasterDetailsThree.gender"
                                                                    ng-required="!vm.customerMasterDetailsThree.gender" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select</option>
                                                <option value="M" >MALE</option>
                                                <option value="F" >FEMALE</option>
                                                <option value="O" >OTHERS</option>
                                            </select></td>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Is Minor (Y/N)?</label>
                                            </td>
                                            <td width="25%">
                                                <!--                                                                <select class="form-control" id="isMinor"-->
                                                <!--                                                                                    name="isMinor" ng-model="vm.customerMasterDetailsThree.isMinor"-->
                                                <!--                                                                                    ng-required="!vm.customerMasterDetailsThree.isMinor"-->
                                                <!--                                                                                    ng-change ="vm.customerMasterDetailsThree.bondHldDob=''"-->
                                                <!--                                                                                    required>-->
                                                <!--                                                                <option value="" hidden="true">Select</option>-->
                                                <!--                                                                <option value="Y" >YES</option>-->
                                                <!--                                                                <option value="N" >NO</option>-->
                                                <!--                                                            </select>-->
                                                <input type="text" class="form-control"
                                                       value="{{vm.customerMasterDetailsThreeFlag === 'Y' ? 'YES' : 'NO' }}"
                                                       readonly>
                                            </td>
                                        </tr>
                                        <tr>

                                            <td> <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                            <td width="25%">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="effFromDate"
                                                           name="effFromDate" ng-model="vm.customerMasterDetailsThree.bondHldDob"
                                                           ng-change="vm.checkAge(vm.customerMasterDetailsThreeFlag , vm.customerMasterDetailsThree.bondHldDob,'add','3')"
                                                           readonly
                                                           uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.customerMasterDetailsThree.bondHldDob=''"
                                                           datepicker-options="vm.retirDatePickerValidation"
                                                           is-open="vm.effFromDatePicker.opened" close-text="Close"
                                                           ng-blur="vm.textableDatePicker('effFromDate',vm.customerMasterDetailsThree.bondHldDob);vm.futureNotAllowed('effFromDate',vm.customerMasterDetailsThree.bondHldDob)"
                                                           ng-keyup="vm.autoslashing('effFromDate')" chars="numbers-slash"

                                                           maxlength="10" readonly >
                                                    <!--                                                                                                                    <span class="input-group-btn" ng-if="vm.blaFlag!='Y'">-->
                                                    <!--                                                                            <button  type="button" class="btn btn-secondary"-->
                                                    <!--                                                                                    ng-click="vm.effFromDatePicker.opened = true"-->
                                                    <!--                                                                                    id="effFromDateSearcher">-->
                                                    <!--                                                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                    <!--                                                                            </button>-->
                                                    <!--                                                                        </span>-->
                                                </p>
                                            </td>


                                            <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThreeFlag  == 'Y'}"><label
                                                    for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br> as per norms</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetailsThree.detailsOfBirthCertificate"
                                                                   ng-value="vm.customerMasterDetailsThree.isMinor == 'Y' ? 'YES' : vm.customerMasterDetailsThree.detailsOfBirthCertificate"
                                                                   maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetailsThreeFlag  == 'Y'"  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>


                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group"><label
                                                    for="address1" class="control-label">Communication Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address1" name="address1" ng-model="vm.customerMasterDetailsThree.bondHldAddOne"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%" ><label
                                                    for="address2" class="control-label">Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="address2" name="address2"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldAddTwo" maxlength="200"
                                                                   ng-init="vm.tempPresentPremise = vm.presentPremise"   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>



                                        </tr>
                                        <tr>

                                            <td width="25%" ><label
                                                    for="presentFlat" class="control-label">Address 3</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsThree.bondHldAddThree"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%" class="form-group">
                                                <label class="control-label">City</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sadistrict" name="district" chars="only-letters-spsace" maxlength="35" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldCity" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>
                                        <tr>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">State</label></td>
                                            <td width="25%"><select class="form-control" id="state"
                                                                    name="state" ng-model="vm.customerMasterDetailsThree.bondHldState"
                                                                    ng-init="vm.getState()" ng-disabled="vm.blaFlag=='Y'">
                                                <option value="" hidden="true">Select State</option>
                                                <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                            </select></td>

                                            <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"  ng-blur="vm.getAddressThree(vm.customerMasterDetailsThree.bondHldPinCode)"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldPinCode"
                                                                   onkeypress="return isNumber(event)" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>
                                        <tr>
                                            <td width="25%">Phone Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="saphoneNum" ng-model="vm.customerMasterDetailsThree.bondHolderPhoneNumber"
                                                                   minlength="10" maxlength="35" chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%">Mobile Number</td>
                                            <td width="25%">
                                                <input type="text" class="form-control" minlength="10" maxlength="35"
                                                       id="mobileNumber" ng-model="vm.customerMasterDetailsThree.bondHldMobNum"
                                                       chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>


                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="emailId" name="emailId" maxlength="100"
                                                                   ng-model="vm.customerMasterDetailsThree.bondHldEmail" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>
                                        </tr>
                                        </tbody>
                                    </table>
                                    <h4 class="form_heading" ng-if="vm.customerMasterDetailsThreeFlag =='Y'">GUARDIAN DETAILS</h4>
                                    <table class="table table-bordered" ng-if="vm.customerMasterDetailsThreeFlag =='Y'">
                                        <tbody>

                                        <tr>
                                            <td width="25%" >
                                                <label for="guardianId" class="control-label">Guardian Id</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="guardianId"
                                                               name="guardianId"
                                                               ng-model="vm.customerMasterDetailsThree.guardianId" disabled>
                                                    </div>
                                                    <div class="col-sm-3 torch-top" >
                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                           ng-click="vm.getGuardianDetailsThree('select');" id="guardianIdSearcher"></i>
                                                        <i class="glyphicon glyphicon-remove clear cp"
                                                           ng-click=
                                                                   "vm.customerMasterDetailsThree.guardianId = '';
                                            vm.customerMasterDetailsThree.guardianFirstName= '';
                                            vm.customerMasterDetailsThree.guardianMiddleName='';
                                            vm.customerMasterDetailsThree.guardianLastName='';
                                            vm.customerMasterDetailsThree.relationWithMinor='';
                                            vm.customerMasterDetailsThree.guardianDateOfBirth='';
                                            vm.customerMasterDetailsThree.guardianCommunicationAddress='';
                                            vm.customerMasterDetailsThree.guardianMobileNo='';
                                            vm.customerMasterDetailsThree.guardianEmailId='';"
                                                           id="guardianIdClose"></i>




                                                        <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                                    </div>
                                                </div>
                                            </td>

                                            <td width="25%" class="form-group required"><label
                                                    for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianFirstName" name="guardianFirstName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.guardianFirstName"
                                                                   chars="only-letters" required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'"></td>

                                        </tr>

                                        <tr>
                                            <td width="25%">Guardian Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianMiddleName" name="guardianMiddleName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%">Guardian Last Name</td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianLastName" name="guardianLastName"
                                                                   maxlength="150"
                                                                   ng-model="vm.customerMasterDetailsThree.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Relation with minor</label></td>
                                            <td width="25%">
                                                <select class="form-control" id="relationWithMinor" ng-init=""
                                                        name="relationWithMinor" ng-model="vm.customerMasterDetailsThree.relationWithMinor"
                                                        required ng-disabled="vm.blaFlag=='Y'">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">Date of Birth</label></td>
                                            <td width="25%">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="guardianDateOfBirth2" ng-init="vm.isAgeValid();"
                                                           name="guardianDateOfBirth" ng-model="vm.customerMasterDetailsThree.guardianDateOfBirth"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           datepicker-options="vm.submissionfifteenGH"
                                                           ng-blur="vm.textableDatePicker('guardianDateOfBirth2',vm.customerMasterDetailsThree.guardianDateOfBirth)"
                                                           ng-keyup="vm.autoslashing('guardianDateOfBirth2')" chars="numbers-slash"

                                                           is-open="vm.submissionfifteenGHPicker.opened" close-text="Close"

                                                           ng-disabled="vm.blaFlag=='Y'" >
                                                    <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher" ng-disabled="vm.blaFlag=='Y'">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                                </p>
                                            </td>
                                        </tr>


                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="address1" class="control-label">Communication Address</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsThree.guardianCommunicationAddress"
                                                                   maxlength="200"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>


                                            <td width="25%">Mobile Number</td>
                                            <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="35"
                                                                   id="guardianMobileNumber" ng-model="vm.customerMasterDetailsThree.guardianMobileNo"
                                                                   chars="numbers-with-special-characters" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="emailId" class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                                   ng-model="vm.customerMasterDetailsThree.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" ng-disabled="vm.blaFlag=='Y'">
                                                <span class="text-danger"
                                                      ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        </tr>


                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">Interest Payout Account Details</h4>
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label break-word">Whether the customer belongs to HDFC?</label></td>
                                            <td width="25%">
                                                <input type="radio" id="hdfcOtherBankY2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">Yes
                                                <input type="radio" id="hdfcOtherBankN2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()" ng-disabled="vm.blaFlag=='Y'">No
                                            </td>

                                            <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'" class="form-group required">
                                                <label class="control-label break-word">Operative Account Number (Demo details)</label>
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'">
                                                <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsThree.operativeAccNum ==''"
                                                       id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20" minlength="9"
                                                       ng-model="vm.customerMasterDetailsThree.operativeAccNum"
                                                       ng-required="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'"
                                                       ng-disabled="vm.customerMasterDetailsThree.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'"
                                                       oninput="this.value = this.value.toUpperCase()"
                                                       oninput="this.value = this.value.replace(/\s+/g, '')">
                                                <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                            </td>
                                            <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'">
                                                <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetailsThree(vm.customerMasterDetailsThree.operativeAccNum);"
                                                        ng-disabled="!vm.customerMasterDetailsThree.operativeAccNum || vm.customerMasterDetailsThree.hdfcOtherBank != 'Y' || vm.blaFlag=='Y'">
                                                    Fetch
                                                </button>
                                            </td>
                                        </tr>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">PAN No.</label>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <input type="text" class="form-control" id="panNumber"
                                                   name="panNumber" maxlength="10" chars="alpha-numeric" readonly
                                                   ng-model="vm.customerMasterDetailsThree.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                        </tr>





                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">WITNESS DETAILS</h4>
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameOne" name="witnessNameOne"
                                                                   maxlength="30"
                                                                   ng-model="vm.customerMasterDetailsThree.witnessNameOne"
                                                                   chars="only-letters" leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressOne" name="witnessAddressOne"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetailsThree.witnessAddressOne"
                                                                   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessNameTwo" name="witnessNameTwo"
                                                                   maxlength="30"
                                                                   ng-model="vm.customerMasterDetailsThree.witnessNameTwo"
                                                                   chars="only-letters" leading-space ng-disabled="vm.blaFlag=='Y'"></td>

                                            <td width="25%" class="form-group"><label
                                                    for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                            <td width="25%"><input type="text" class="form-control"
                                                                   id="witnessAddressTwo" name="witnessAddressTwo"
                                                                   maxlength="200"
                                                                   ng-model="vm.customerMasterDetailsThree.witnessAddressTwo"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" ng-disabled="vm.blaFlag=='Y'"></td>
                                        </tr>

                                        </tbody>
                                    </table>
                                    <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                    <table class="table table-bordered">
                                        <div class="col-md-12 map-div">
                                            <div width="50%">
                                                <input type="checkbox" id="birthCertificateThree" name="birthCertificateThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.birthCertificate" ng-required="vm.birthCertificate" ng-disabled="vm.blaFlag=='Y'">
                                                <label for="birthCertificateThree">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                            </div><div width="50%">
                                            <input type="checkbox" id="passportThree" name="passportThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.passport" ng-required="vm.passport" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="passportThree">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="seniorCitizenCardThree" name="seniorCitizenCardThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.seniorCitizenCard" ng-required="vm.seniorCitizenCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="seniorCitizenCardThree">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="voterIdThree" name="voterIdThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.voterIdCard" ng-required="vm.voterIdCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="voterIdThree">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="panCardThree" name="panCardThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.panCard" ng-required="vm.panCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="panCardThree">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="drivingLicenceThree" name="drivingLicenceThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.drivingLicence" ng-required="vm.drivingLicence" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="drivingLicenceThree">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="rationCardThree" name="rationCardThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.rationCard" ng-required="vm.rationCard" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="rationCardThree">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                        </div><div width="50%">
                                            <input type="checkbox" id="othersThree" name="othersThree" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsThree.otherDocuments" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                            <label for="othersThree">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                        </div>
                                        </div>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control"
                                                       id="otherDetails" name="otherDetails"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetailsThree.otherDetails" oninput="this.value = this.value.replace(/^\s/, '')" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                            </td>

                                            <td width="25%" class="form-group">
                                                <label class="control-label">Remarks</label>
                                            </td>
                                            <td width="25%" >
                                                <input type="text" class="form-control"
                                                       id="remarks" name="remarks"
                                                       maxlength="200"
                                                       ng-model="vm.customerMasterDetailsThree.remarks" oninput="this.value = this.value.replace(/^\s/, '')" ng-disabled="vm.blaFlag=='Y'">
                                            </td>
                                        </tr>

                                    </table>

                                </ng-form>
                            </div>
                        </form>
                    </uib-accordion>
                    <div class="text-center form_submit">
                        <button type="submit" class="btn btn-default" id="submitButton" ng-click="vm.tabReferenceAdd ='reversalForm'"
                                ng-disabled="vm.customerMasterForm.$invalid">Next</button>
                        <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/huf_transfer_to_single_and_joint_type_change/add';">Cancel</button>
                    </div>
                </div>
            </div>
            <div id="reversalForm"  ng-show="vm.tabReferenceAdd=='reversalForm'" class="tab-pane  fade in active">
                <div class="tab-body">
                    <uib-accordion close-others="oneAtATime">
                        <form name="vm.reversalForm" role="form" ng-submit="vm.submitAddForm();">
                            <div uib-accordion-group id="personal1-details" class="panel"
                                 heading='BOND HOLDER REVERSAL DETAILS' is-open="vm.personalDetailsOpen"
                                 ng-class="(vm.customerPersonalDetails.$invalid) ? 'panel-danger' : 'panel-success'">
                                <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                    <table class="table table-bordered">
                                        <tbody>
                                        <tr>
                                            <td width="25%" >
                                                <label  class="control-label">Module Name</label>
                                            </td>
                                            <td width="25%">
                                                <label  class="control-label">RBI Bond</label>
                                            </td>
                                            <td width="25%">
                                                <label  class="control-label required">Name of the Bond Scheme</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <input type="text" class="form-control" id="schemeCode"
                                                               ng-model="vm.schemeName"
                                                               chars="alpha-numeric" readonly required leading-space>
                                                    </div>
                                                    <!-- <div class="col-sm-3 torch-top">
                                                         <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                                                            id="treasurySearch"
                                                            ng-click="vm.getAddModuleName();"></i> <i
                                                             class="glyphicon glyphicon-remove clear cp"
                                                             ng-click="vm.schemeCode ='';vm.schemeName ='';vm.bondHolderName='';vm.blaNo='';vm.blaNum='';vm.panNo='';"></i>
                                                     </div>-->
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%"><label
                                                    for="bondHolderName" class="control-label">Bond Holder Name</label></td>
                                            <td width="25%">
                                                <input type="text" class="form-control"  maxlength="50"
                                                       id="bondHolderName" name="bondHolderName" ng-model="vm.bondHolderName" chars="only-character" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" disabled>
                                            </td>
                                            <td width="25%"><label for="pan_No1" class="control-label">PAN No</label></td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <input type="text" class="form-control" id="pan_No1" ng-model="vm.pan_No1"
                                                               chars="alpha-numeric" oninput="this.value = this.value.replace(/\s+/g, '')" disabled></div>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">
                                                <label class="control-label required">Mode of Holding</label>
                                            </td>
                                            <td width="25%">
                                                <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                                <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >Joint - Jointly</label>
                                                <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >Joint - Anyone or Survivor</label>
                                            </td>
                                            <td width="25%">
                                                <label class="form-group required"> From BLA Account Number</label>
                                            </td>
                                            <td width="25%">
                                                <div class="row">
                                                    <div class="col-sm-9">
                                                        <input type="text" class="form-control" id="blaAccNo" ng-model="vm.blaAccNo"
                                                               oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                                               chars="only-numbers" minlength="5" maxlength="20" required disabled></div>
                                                    <div class="col-sm-3 torch-top" ng-if="vm.schemeName && vm.blaAccNo">
                                                                   <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="versionNoSearch"
                                                                         ng-click="vm.getBlaAccNo();vm.searchSolId='';"></span>
                                                        <!-- <span class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaAccNo = '';vm.bondScbId='';
                                                         vm.blaAccNoTo='';vm.reversalRemarks='';"></span>-->
                                                    </div></div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">
                                                <label class="control-label required">To BLA Account Number</label>
                                            </td>
                                            <td width="25%" ng-if="vm.blaFlag=='Y'">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <input type="text" class="form-control" id="blaAccNoTo"
                                                               ng-model="vm.blaAccNoTo"
                                                               chars="only-numbers" minlength="5" maxlength="20"  required disabled>
                                                    </div>
                                                    <!--<div class="col-sm-3 torch-top" ng-if="vm.schemeName && vm.blaAccNoTo">
                                                    <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                     id="blaAccNoToSearch" ng-click="vm.getBlaAccNoTo();vm.searchSolId='';"></span>
                                                        <span class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaAccNoTo = '';"></span>
                                                    </div>-->
                                                </div>
                                            </td>
                                            <td width="25%" ng-if="vm.blaFlag=='N'">
                                                <div class="row">
                                                    <div class="col-sm-12">
                                                        <input type="text" class="form-control" required disabled>
                                                    </div>
                                                </div>
                                            </td>
                                            <td width="25%">
                                                <label for="count" class="control-label">Subscription Count</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="count" maxlength="50" name="count" ng-model="vm.count" disabled>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">
                                                <label for="reversalRemarks" class="form-group required">Remarks</label>
                                            </td>
                                            <td width="25%">
                                                                        <textarea class="form-control" rows="3" id="reversalRemarks" maxlength="200" name="reversalRemarks" ng-model="vm.reversalRemarks" oninput="this.value = this.value.replace(/^\s/, '')"
                                                                                  required></textarea>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </ng-form>

                                <div class="table-responsive" ng-if="vm.subscriptionIdList.length>0">
                                    <table class="table table-bordered table-striped list table-textWrap align-middle">
                                        <thead>
                                        <tr class="thalign">
                                            <th>S.No</th>
                                            <th>Subscription Id</th>
                                            <th>Subscription Date</th>
                                            <th>Subscription Amount</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr ng-repeat="x in vm.subscriptionIdList">
                                            <td align="center">{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                                            <td align="center">{{x.subscriptionId}}</td>
                                            <td align="center">{{x.subscriptionDate}}</td>
                                            <td align="center">{{x.subscriptionAmt}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="text-center form_submit">

                                <!-- Button for blaFlag 'N and Y' -->
                                <button ng-if="vm.blaAccNo.length >= 13"
                                        type="submit" class="btn btn-default" id="submitButton"
                                        ng-disabled="vm.reversalForm.$invalid || vm.customerMasterForm.$invalid">Add
                                </button>
                                <button type="button" id="cancelButton" class="btn btn-cancel"
                                        onclick="window.location.href= '#!/huf_transfer_to_single_and_joint_type_change/add';">Cancel
                                </button>
                            </div>
                        </form>
                    </uib-accordion>
                </div>
            </div>
        </div>
</div>
            <!-- TranCode Details -->
            <div class="modal" id="otherBankDetailsModal" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                            <h4 class="modal-title">Other Bank Details List</h4>
                        </div>
                        <div class="modal-body">
                            <div class="loader_popup"></div>
                            <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length>0">
                                <div class="col-sm-8 form_submit">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="glyphicon glyphicon-search"></i>
                                            </div>
                                            <input type="text" class="form-control"
                                                   ng-model="vm.searchTranCode"
                                                   ng-init="vm.searchTranCode = ''"
                                                   placeholder="Search">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 form_submit"></div>
                                <div class="row">

                                    <div class="col-sm-12">
                                        <table class="table table-bordered list scroll">
                                            <thead ng-init="reverseOrder = false; sortedColumn = 'clgTranCode'">
                                            <tr>
                                                <th class="modal-title title-case" ng-click="(sortedColumn == 'bankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankCode';" ng-class="(sortedColumn == 'bankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Code</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr class="cp"
                                                ng-repeat="x in vm.otherBankDetailsTorchList | filter:vm.searchTranCode | orderBy:sortedColumn:reverseOrder"
                                                ng-click="vm.customerMasterDetails.bankCode = x.bankCode;"
                                                data-bs-dismiss="modal">
                                                <td>{{x.bankCode}}</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length==0">No
                                records found to display.</div>
                        </div>

                    </div>
                </div>
            </div>
            <!--blaAccNoFrom Modal-->
            <div class="modal" id="blaAccNoModal" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                            <h4 class="modal-title">From Bond Ledger Account Number</h4>
                        </div>
                        <div class="modal-body">
                            <div class="loader_popup"></div>
                            <div class="list_wrapper" ng-if="vm.blaAccNoList.length>0">
                                <div class="col-sm-8 form_submit">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <em class="glyphicon glyphicon-search"></em>
                                            </div>
                                            <input type="text" class="form-control"
                                                   ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 form_submit"></div>
                                <div class="row">

                                    <div class="col-sm-12">
                                        <table class="table table-bordered list scroll sort" aria-label="">
                                            <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNo'">
                                            <tr>
                                                <th scope="" ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Pan Number</th>
                                                <th scope="" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode Of Holding</th>
                                                <th scope="" ng-click="(sortedColumn == 'fromBlaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'fromBlaNo';" ng-class="(sortedColumn == 'fromBlaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr class="cp"
                                                ng-repeat="x in vm.blaAccNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                                ng-click="vm.blaAccNo = x.fromBlaNo;vm.getSubscriptionId(x.fromBlaNo);" data-bs-dismiss="modal">
                                                <td>{{x.panNum}}</td>
                                                <td>{{x.modeOfHolding}}</td>
                                                <td>{{x.fromBlaNo}}</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="list_wrapper" ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
                        </div>
                    </div>
                </div>
            </div>
            <!--blaAccNoTo-->
            <div class="modal" id="blaAccNoToModal" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                            <h4 class="modal-title">To Bond Ledger Account Number</h4>
                        </div>
                        <div class="modal-body">
                            <div class="loader_popup"></div>
                            <div class="list_wrapper" ng-if="vm.blaAccNoToList.length>0">
                                <div class="col-sm-8 form_submit">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <em class="glyphicon glyphicon-search"></em>
                                            </div>
                                            <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 form_submit"></div>
                                <div class="row">
                                    <div class="col-sm-12">
                                        <table class="table table-bordered list scroll sort" aria-label="">
                                            <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNoTo'">
                                            <tr>
