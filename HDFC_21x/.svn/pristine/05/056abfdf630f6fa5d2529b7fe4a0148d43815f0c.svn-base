<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">RBI Bond Interest Rate Code Maintenance - Inquiry</h4>
    <sol-header></sol-header>
    <form name="rbiBondInterestMaintenanceForm" role="form">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label  class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-3">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label"> Scheme Name :</label>
                </div>
                <div class="col-sm-3">
                    <label>{{vm.subCodeDescription}}</label>
                </div>
            </div>
        </div>


        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.verificationDetails == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.verificationDetails == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>

<!--            <tr>-->
<!--                <td>Scheme Name</td>-->
<!--                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C010)?-->
<!--                    (vm.inquiryDetail.masterOldNewValueModel.C010.oldValue) : ('')}}-->
<!--                </td>-->
<!--                <td ng-if="vm.verificationDetails == 'M'" class="new-value">-->
<!--                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C010)?-->
<!--                    (vm.inquiryDetail.masterOldNewValueModel.C010.newValue) : ('')}}-->
<!--                </td>-->
<!--            </tr>-->

            <tr>
                <td>Effective From  Date(dd/mm/yyyy)</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C004)?
                    (vm.inquiryDetail.masterOldNewValueModel.C004.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C004)?
                    (vm.inquiryDetail.masterOldNewValueModel.C004.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Interest Rate Code</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C001)?
                    (vm.inquiryDetail.masterOldNewValueModel.C001.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C001)?
                    (vm.inquiryDetail.masterOldNewValueModel.C001.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Interest Rate Code Description</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C001)?
                    (vm.inquiryDetail.masterOldNewValueModel.C002.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C001)?
                    (vm.inquiryDetail.masterOldNewValueModel.C002.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td> Fixed Interest rate / Floating Interest Rate</td>
                <td class="old-value">
                    {{ (vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C011 && vm.inquiryDetail.masterOldNewValueModel.C011.oldValue === 'Y') ? 'Fixed' : 'Floating' }}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{ (vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C011 && vm.inquiryDetail.masterOldNewValueModel.C011.newValue === 'Y') ? 'Fixed' : 'Floating' }}
                </td>
            </tr>


            <tr>
                <td>Version</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C003)?
                    (vm.inquiryDetail.masterOldNewValueModel.C003.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C003)?
                    (vm.inquiryDetail.masterOldNewValueModel.C003.newValue) : ('')}}
                </td>
            </tr>

            <tr ng-if="vm.inquiryDetail.masterOldNewValueModel.C011.oldValue == 'N'">
                <td>Interest Rate (%) on National Savings Certificate</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C005)?
                    (vm.inquiryDetail.masterOldNewValueModel.C005.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C005)?
                    (vm.inquiryDetail.masterOldNewValueModel.C005.newValue) : ('')}}
                </td>
            </tr>

            <tr ng-if="vm.inquiryDetail.masterOldNewValueModel.C011.oldValue == 'N'">
                <td>Spread Rate (%)</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C006)?
                    (vm.inquiryDetail.masterOldNewValueModel.C006.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C006)?
                    (vm.inquiryDetail.masterOldNewValueModel.C006.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Coupon / Interest Rate for Bond (%)</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C007)?
                    (vm.inquiryDetail.masterOldNewValueModel.C007.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C007)?
                    (vm.inquiryDetail.masterOldNewValueModel.C007.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td>Remarks</td>
                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C008)?
                    (vm.inquiryDetail.masterOldNewValueModel.C008.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.masterOldNewValueModel.C008)?
                    (vm.inquiryDetail.masterOldNewValueModel.C008.newValue) : ('')}}
                </td>
            </tr>

<!--            <tr>-->
<!--                <td>Rejection Remarks</td>-->
<!--                <td class="old-value">{{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.rejectionRemarks)?-->
<!--                    (vm.inquiryDetail.rejectionRemarks) : ('')}}-->
<!--                </td>-->
<!--                <td ng-if="vm.verificationDetails == 'M'" class="new-value">-->
<!--                    {{(vm.inquiryDetail.masterOldNewValueModel && vm.inquiryDetail.rejectionRemarks)?-->
<!--                    (vm.inquiryDetail.rejectionRemarks) : ('')}}-->
<!--                </td>-->
<!--            </tr>-->




            </tbody>
        </table>

        <table class="table table-bordered table-striped list old-new-value-table">
            <tbody width="100%">
            <tr>
                <th width="50%">Rejection Remarks</th>
                <td width="50%">{{vm.rejectionRemarks}}</td>
            </tr>


            </tbody>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.inquiryDetail.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.inquiryDetail.lastModifiedBy) ? (vm.inquiryDetail.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.inquiryDetail.lastVerifiedBy) ? (vm.inquiryDetail.lastVerifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.inquiryDetail.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.inquiryDetail.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.inquiryDetail.lastModifiedDate) ? (vm.inquiryDetail.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.inquiryDetail.lastVerifiedDate) ? (vm.inquiryDetail.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">

            <button type="button" class="btn btn-cancel" id="cancelButton"
                      onclick="window.location.href= '#!/rbi_bond_interest_rate_code_maintenance/action/inquiry';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>

</form>
</div>