<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper">
	<cbs-left-menu></cbs-left-menu>	
	<h4 class="form_heading  feature-heading">User Work Class Information - Modify</h4>
			<notice-message-directive ></notice-message-directive>
	
	<form name="userDetailsForm" role="form" ng-submit="submitForm(userDetailsForm.$valid)" enctype="multipart/form-data" novalidate>
		<div class="row">
		    <div class="form-group" ng-class="requiredClass">	
			  	<label for="userId" class ="control-label col-sm-3">User ID</label>
				<div class="col-sm-2 inner-addon right-addon">
					<input type="text" class="form-control" id="userId" name="userId" ng-model="vm.cbsUserDetails.userId" maxlength="15"  required ng-disabled="action === 'modify'">
				</div>
				<div class="col-sm-2"></div>
				 <label for="userWorkClass" class ="control-label col-sm-3">User work class</label>
				<div class="col-sm-2">
					<input type="text" class="form-control" id="userWorkClass" name="userWorkClass" ng-model="vm.cbsUserDetails.userWorkClass" maxlength="3">
				</div>
			</div>
		</div>
		<div class="row">
		 <div class="form-group" ng-class="requiredClass">
		  	<label for="solId" class ="control-label col-sm-3">Sol ID</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="solId" name="solId" ng-model="vm.cbsUserDetails.solId" maxlength="8" required>
			</div>
			<div class="col-sm-2"></div>
			<label for="userSolTenor" class ="control-label col-sm-3">User Sol Tenor</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="userSolTenor" name="userSolTenor" ng-model="vm.cbsUserDetails.userSolTenor" maxlength="1" >
			</div>
		</div>
		</div>
		<div class="row">
		<div class="form-group" ng-class="requiredClass">
		  	<label for="userMaxInactiveTime" class ="control-label col-sm-3">User Max Inactive Time</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="userMaxInactiveTime" name="userMaxInactiveTime" ng-model="vm.cbsUserDetails.userMaxInactiveTime" maxlength="3" allow-only-numbers required>
			</div>
			<div class="col-sm-2"></div>
			 <label for="userAccountExpiryDate" class ="control-label col-sm-3">User Account Expiry Date</label>
	
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="userAccountExpiryDate" name="userAccountExpiryDate" ng-model="vm.cbsUserDetails.userAccountExpiryDate"   onkeydown="return false;">
			</div>
		</div>	
		</div>
		<div class="row">
		<div class="form-group" ng-class="requiredClass">
		  	<label for="userApplicationName" class ="control-label col-sm-3">User Appl Name</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="userApplicationName" name="userApplicationName" ng-model="vm.cbsUserDetails.userApplicationName" maxlength="2" required>
			</div>
			<div class="col-sm-2"></div>
			<label for="userPasswordExpiryDate" class ="control-label col-sm-3">User Password Expiry Date</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="userPasswordExpiryDate" name="userPasswordExpiryDate" ng-model="vm.cbsUserDetails.userPasswordExpiryDate"  onkeydown="return false"  required >
			 </div>
		</div>	
		</div>
		<div class="row">
		<div class="form-group" ng-class="requiredClass">
		  	<label for="newUserFlag" class ="control-label col-sm-3">New User Flag</label>
			<div class="col-sm-2">
			  <select class="form-control" id="newUserFlag" name="newUserFlag" ng-model="vm.cbsUserDetails.newUserFlag" required>
						<option ng-selected= "{{userDetails.newUserFlag == ''}}" value="">Select</option>
						<option ng-selected= "{{userDetails.newUserFlag == 'true'}}" value="true" >Yes</option>
						<option ng-selected= "{{userDetails.newUserFlag == 'false'}}" value="false">No</option>
					</select>					
			</div>
			<div class="col-sm-2"></div>
			<label for="defaultTermId" class ="control-label col-sm-3">Default term ID</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="defaultTermId" name="defaultTermId" ng-model="vm.cbsUserDetails.defaultTermId" maxlength="15" required>
			</div>
		</div>	
		</div>
		<div class="row">
		<div class="form-group ">
		  	<div ng-class="requiredClass">	<label for="virtualFlag" class ="control-label col-sm-3">Virtual Flag</label></div>
			<div class="col-sm-2">
			  <select class="form-control" id="virtualFlag" name="virtualFlag" ng-model="vm.cbsUserDetails.virtualFlag" required>
						<option ng-selected= "{{userDetails.virtualFlag == ''}}" value="">Select</option>
						<option  ng-selected= "{{userDetails.virtualFlag == 'true'}}" value="true" >Yes</option>
						<option ng-selected= "{{userDetails.virtualFlag == 'false'}}" value="false">No</option>
					</select>					
			</div>
			<div class="col-sm-2"></div>
			 <label for="additionalText1" class ="control-label col-sm-3">Additional Text1</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="additionalText1" name="additionalText1" ng-model="vm.cbsUserDetails.additionalText1" maxlength="40" >
			</div>
		</div>	
		</div>
		<div class="row">
		<div class="form-group ">
		  	<label for="additionalText2" class ="control-label col-sm-3">Additional Text2</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="additionalText2" name="additionalText2" ng-model="vm.cbsUserDetails.additionalText2" maxlength="40">
			</div>
			<div class="col-sm-2"></div>
			 <label for="additionalText3" class ="control-label col-sm-3">Additional Text3</label>
			<div class="col-sm-2">
			  <input type="text" class="form-control" id="additionalText3" name="additionalText3" ng-model="vm.cbsUserDetails.additionalText3" maxlength="40">
			</div>
		</div>	
		</div>
	 	<div class="col-sm-offset-5 col-sm-8 form_submit">
				<button type="submit" class="btn btn-default" id="submitButton" ng-disabled="userDetailsForm.$invalid">Update</button>
				<button type="button" class="btn btn-cancel" id="cancelButton" ng-click="cancelOperation(action)" >Cancel</button>
	   </div>
	</form>
	
</div>


