package com.isl.gbm.common.dao;

import com.isl.gbm.common.model.GbmSubCodeMaster;

import java.util.List;

public interface GbmSubCodeMasterDao {

    /**
     * Gets the code details.
     *
     * @param code the code
     * @return the code details
     */
    public List<GbmSubCodeMaster> getCodeDetails(final String code);

    /**
     * Gets the sub code details not deleted for '0000','0004','0005'.
     *
     * @return the sub code details
     */
    public List<GbmSubCodeMaster> getGspmSchemeDetails();

    /**
     * Gets the present country.
     *
     * @return the present country
     */
    public GbmSubCodeMaster getPresentCountry();

    /**
     * Gets the sub code details.
     *
     * @param subCode the sub code
     * @return the sub code details
     */
    public GbmSubCodeMaster getSubCodeDetails(final String subCode);
}
