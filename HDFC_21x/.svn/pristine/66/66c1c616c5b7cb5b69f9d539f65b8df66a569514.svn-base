        <div class="modal fade" id="guardianModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Guardian List</h4>
                    </div>
                    <div class="modal-body">
                        <div class="loader_popup"></div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsList.length>0">
                            <div class="col-sm-8 form_submit">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="glyphicon glyphicon-search"></i>
                                        </div>
                                        <input type="text" class="form-control"
                                               ng-model="vm.versionNoSearch"
                                               placeholder="Search" chars="alpha-numeric">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">

                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll sort">
                                        <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                        <tr>
                                            <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                            <th ng-click="(sortedColumn == 'guardianName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'guardianName';" ng-class="(sortedColumn == 'guardianName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Guardian Name</th>
                                            <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                            <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.guardianDetailsList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetails.guardianId = x.guardianId; vm.getGuardianDetails();" data-dismiss="modal">
                                            <td>{{x.blaNo}}</td>
                                            <td>{{x.guardianName}}</td>
                                            <td>{{x.nameOfTheBondHolder}}</td>
                                            <td>{{x.modeOfHolding}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsList.length==0">No records found to display.</div>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal fade" id="guardianModalTwo" role="dialog">
