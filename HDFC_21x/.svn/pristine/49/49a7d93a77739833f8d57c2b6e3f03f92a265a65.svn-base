<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.model">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/';" id="homeButton">Home</button>
        <button type="button" id="cancel_Button" class="btn btn-cancel" onclick="window.location.href= '#!/Bond_Investment_Due_Date_Notice_report/action/inquiry';">Back</button>
        <button type="submit" class="btn btn-default" id="printButton" data-ng-click="vm.printPage();">Print</button>
    </div>
    <div class="text-justify" id="section-to-print" >
        <div data-ng-repeat="x in vm.model" class="page-break" style="border:1px solid black;border-radius:5px; padding:2em; margin:30px; width:100%; font-size:14px">
            <table style="width:100%" aria-label="">
                <tr>
                    <th scope="col" style="text-align:center">{{vm.bankName}}</th>
                </tr>
                <tr>
                    <th  scope="col" style="text-align:center">{{vm.branchOfTheBank}}</th>
                </tr>
                <tr>
                    <th scope="col" style="text-align:center">Branch Code: {{vm.branchCode}}<br><br></th>
                </tr>
                <tr>
                    <th scope="col" style="text-align:center; font-size:16px">Bond Investment Due Date Notice<br></th>
                </tr>

                <tr>
                    <td style="text-align:right"><br>Date: {{vm.formatDate(vm.solDate)}}</td>
                </tr>

                <tr>
                    <td>
                        To,<br><br>
                    </td>
                </tr>
                <tr>
                    <td>
                        {{x.holderName}}<br>
                        {{x.address}}<br><br><br>
                    </td>
                </tr>
                <tr>
                    <td>
                        <strong> Sub: Notice for Bond Due Date of Repayment<br><br><br></strong>
                    </td>
                </tr>
                <tr>
                    <td>
                        Dear Sir/Madam<br><br>
                    </td>
                </tr>
                <tr>
                    <td>
                        Your investment in Government RBI Bond under Scheme '<strong>{{vm.schemeName}}</strong>'
                        for the Bond Account Ledger Account No. <strong>{{x.blaNumber}}</strong>
                        with investment ID <strong>{{x.subscriptionID}}</strong> made on <strong>{{x.subscriptionDate}}</strong>
                        will be maturing on <strong>{{x.maturityDate}}</strong>.
                        <br>
                        <br>
                        Please visit the branch with Certificate of Holding for closure.
                        <br>
                        <br>
                        <br>
                        <br>

                        <strong>Branch Manager</strong>
                    </td>
                </tr>
            </table>
        </div>
    </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Bond Investment Due Date Notice report</h4>
        No records found to display.
        <div style="text-align: center">
            <button type="button" class="btn btn-default" onclick="window.location.href= '#!/Bond_Investment_Due_Date_Notice_report/action/inquiry';">Back</button>
        </div>
    </div>
</div>

<style>
  @media print {
    body {
      margin: 0;
      padding: 0;
      width: 100%;
    }

    #section-to-print {
      width: 90%;

    }

    .page-break {
      page-break-before: always;
      width: 100%;
      height:100%
    }

  }
</style>

