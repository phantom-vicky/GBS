							<td><select class="form-control" id="GBM_INT_07"
								name="GBM_INT_07" ng-model="vm.generalSetupNewScope.GBM_INT_07"
								string-to-number required >
									<option ng-value="3">Through CBS Web Service Calls</option>
							</select></td>
							<td><select class="form-control" id="GBM_INT_07_old"
								name="GBM_INT_07_old" ng-model="vm.generalSetupScope.GBM_INT_07"
								string-to-number required disabled>
									<option ng-value="3">Through CBS Web Service Calls</option>
							</select></td>
						</tr>
						<tr>
							<td>GBM/INT/08</td>
							<td>To get the list of accounts based on short name, scheme
								code, scheme type</td>
							<td><select class="form-control" id="GBM_INT_08"
								name="GBM_INT_08" ng-model="vm.generalSetupNewScope.GBM_INT_08"
								string-to-number required >
									<option ng-value="3">Through CBS Web Service Calls</option>
							</select></td>
							<td><select class="form-control" id="GBM_INT_08_old"
								name="GBM_INT_08_old" ng-model="vm.generalSetupScope.GBM_INT_08"
