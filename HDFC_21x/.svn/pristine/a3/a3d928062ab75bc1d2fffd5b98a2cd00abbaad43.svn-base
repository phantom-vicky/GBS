<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.records.length > 0">
    <div class="container from_wrapper new_form_wrapper">
        <div class="text-right form_submit">
            <button
                    type="submit"
                    class="btn btn-default"
                    onclick="window.location.href ='#!/';"
                    id="homeButton"
            >
                Home
            </button>
            <button
                    type="button"
                    id="cancel_Button"
                    class="btn btn-cancel"
                    onclick="window.location.href= '#!/register_of_bond_ledger_accounts_single_holders/action/inquiry';"
            >
                Back
            </button>
        </div>
        <div class="row">
            <h4 class="form_heading">
                Register of Bond Ledger Account – Individual Account
            </h4>
            <sol-header></sol-header>
            <h4 align="right">Appendix III Form B</h4>
            <table width="100%" class="table table-bordered" style="padding: 10px">
                <tr>
                    <th>Name of the Bond Scheme</th>
                    <td>{{vm.moduleName}}</td>
                    <th ng-if="vm.bondType">Bond Type</th>
                    <td ng-if="vm.bondType">{{vm.bondType}}</td>
                </tr>
                <tr>
                    <th style="width: 25%">From Date</th>
                    <td style="width: 35%">{{vm.fromDate | date:'dd/MM/yyyy'}}</td>
                    <th style="width: 20%">To Date</th>
                    <td style="width: 20%">{{vm.toDate | date:'dd/MM/yyyy'}}</td>
                </tr>
                <tr>
                    <th style="width: 25%" ng-if="vm.holderName">Name</th>
                    <td style="width: 35%" ng-if="vm.holderName">{{vm.holderName}}</td>
                    <th style="width: 20%" ng-if="vm.panNo">Pan No.</th>
                    <td style="width: 20%" ng-if="vm.panNo">{{vm.panNo}}</td>
                </tr>
                <tr>
                    <th style="width: 25%">Total Count</th>
                    <td style="width: 35%">{{vm.total}}</td>
                </tr>
            </table>
        </div>

        <div class="row" ng-if="vm.blaNo">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table
                            class="table table-bordered table-striped list nowrap table-textWrap datatable"
                    >
                        <thead>
                        <tr class="thalign">
                            <th>Bond Ledger Account No.</th>
                            <th>Address of the Single/First Holder</th>
                            <th>Nomination Registration No.</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr
                                ng-repeat="x in (vm.filteredRecords | limitTo: 1).slice((vm.currentPage-1)*vm.pageSize, vm.currentPage*vm.pageSize)"
                        >
                            <td align="center">{{vm.blaNo}}</td>
                            <td align="center">{{x.addressOfTheHolder}}</td>
                            <td align="center">{{x.nominationId}}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12">
                <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                    <div class="col-sm-3" style="flex: 1">
                        <div class="form-group">
                            <table style="border-spacing: 2" aria-label="BLA Account Number Details">
                                <tbody>
                                <tr>
                                    <th scope="col"></th>
                                </tr>
                                <tr>
                                    <td>Show&nbsp;</td>
                                    <td>
                                        <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                                                ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                                                ng-change="vm.pageNo = 1; vm.getRegBondLedgeAcc();" ng-disabled="vm.noDataFoundInSearch">
                                            <option value="5">5 per page</option>
                                            <option value="10">10 per page</option>
                                            <option value="20">20 per page</option>
                                            <option value="50">50 per page</option>
                                        </select>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                        <div class="form-group" style="margin-right: 15px">
                            <div class="input-group">
                                <input type="text" id="search" class="form-control" data-ng-model="vm.searchValue" placeholder="Search"/>
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getRegBondLedgeAcc()"></span>
                                </div>
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchValue='';vm.pageNo = 1; vm.getRegBondLedgeAcc()"></span>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <select class="form-control" id="export" name="export" data-ng-model="vm.downloadType" data-ng-disabled="vm.noDataFoundInSearch" data-ng-init="vm.downloadType=''" data-ng-change="vm.getDownload()">
                                <option value="">EXPORT</option>
                                <option value="excel">EXCEL</option>
<!--                                <option value="csv">CSV</option>-->
<!--                                <option value="pdf">PDF</option>-->
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable">
                        <thead data-ng-if="!vm.noDataFoundInSearch">
                        <tr class="thalign">
                            <th rowspan="2">S.NO</th>
                            <th rowspan="2">Date of Transaction</th>
                            <th colspan="2">Amount of Subscription</th>
                            <th rowspan="2">CAS Advice No. & Date</th>
                            <th rowspan="2">Initials</th>
                            <th colspan="3">Transfer</th>
                            <th rowspan="2">Due Date of Repayment</th>
                            <th colspan="2">Repayment</th>
                            <th rowspan="2">Balance (Investment Amt)</th>
                            <th rowspan="2">Remarks</th>
                            <th rowspan="2">Initials</th>
                        </tr>
                        <tr class="thalign">
                            <th>Investment Value</th>
                            <th>Maturity Value</th>
                            <th>Sale or Purchase @</th>
                            <th>Investment Amount</th>
                            <th>Maturity Value</th>
                            <th>Investment Amount</th>
                            <th>Maturity Value</th>
                        </tr>
                        </thead>
<!--                        <tbody>-->
                        <tbody ng-if="!vm.noDataFoundInSearch">
                        <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                            <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td></td>
                            <td align="center">{{x.dateOfTransaction}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.amtOfSubs)}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.maturityVal)}}</td>
                            <td align="center">{{x.casAdviceNoDate}}</td>
                            <td align="center">{{x.subsId}}</td>
                            <td align="center">{{x.transferSaleBurchase}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.transferNominalValue)}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.transferNominalAmt)}}</td>
                            <td align="center">{{x.dueDateOfRepayment}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.repaymntNominalAmt)}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.repaymntMaturityValue)}}</td>
                            <td align="center">{{vm.indianNumberFormat(x.balance)}}</td>
                            <td align="center">{{x.remarks}}</td>
                            <td align="center">{{x.initials}}</td>
                        </tr>
                        </tbody>
                        <tbody data-ng-if="vm.noDataFoundInSearch">
                        <tr>
                            <td style="text-align:center">No Records Found</td>
                        </tr>
                        </tbody>
                    </table>
                </div>
                <br />
                <div class="row">
                    <div class="text-center form_submit">
              <span data-ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
              </span>

                        <span>
                <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

                        <span data-ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
              </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">
            Register of Bond Ledger Accounts – Individual Account
        </h4>
        No records found to display.
        <center>
            <button
                    type="button"
                    class="btn btn-default"
                    onclick="window.location.href= '#!/register_of_bond_ledger_accounts_single_holders/action/inquiry';"
            >
                Back
            </button>
        </center>
    </div>
</div>