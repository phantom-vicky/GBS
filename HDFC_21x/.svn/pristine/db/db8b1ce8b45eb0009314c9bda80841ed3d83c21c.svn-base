<div class="container from_wrapper">
<left-menu-directive></left-menu-directive>
	<h4 class="form_heading  feature-heading">CBS Integration Bulk Upload</h3>
	<notice-message-directive></notice-message-directive>
	<form name="cbsBulkUploadForm" role="form" ng-submit="submitForm(cbsBulkUploadForm.$valid)" enctype="multipart/form-data" novalidate>
			<div class="row">
				<div class="form-group required">
				  <div class="col-sm-3"></div>
				  <label for="functionality" class ="control-label col-sm-3">Functionality</label>
					<div class="col-sm-3">
					<select class="form-control" id="functionality" name="functionality" ng-model="cbsBulkUpload.functionality" ng-dropdown required >
						  <option value="">Select Functionality</option>
						  <option value="bankbranch">Branches of the Bank</option>
						  <option value="officeaccountplaceholder">Office account Placeholder</option>
						  <option value="instruments">Instrument Details</option>
						  <option value="transactioncodes">List of Transaction Codes</option>	
						  <option value="otherbankdetails">Other Bank details </option>
						  <option value="otherbankbranches">Branches of Other Bank</option>
						  <option value="calendarentries">Maintenance of Calendar Entries</option>
						  <option value="schemecodes">Scheme Codes</option>
						  <option value="userdetails">User Work Class Information</option>
						  <option value="branchifscdetails">Branch IFSC Codes</option>		 
					</select>
					</div>
				</div>
				</div>
				<div class="row">
				 <div class="form-group required"> 
			        <div class="col-sm-3"></div>
				      <label for="hierarchyFile" class ="control-label col-sm-3">Upload File Name</label>
				        <div class="col-sm-3">
				        	<input id="file" name="file" type="file" ng-model="cbsBulkUpload.file" file-model="file" accept="application/vnd.ms-excel" runat="server" required valid-file>
				          <!-- <input type="file" class="form-control" id="file" name="file" ng-model="hierarchyBulkUpload.file"  required>
				          <button type="submit" class="btn btn-default">Browse</button>   -->
				        </div>
			       </div>
				</div>
				
	 <div class="col-sm-offset-5 col-sm-8 form_submit">
		 <button type="submit" class="btn btn-default" id="uploadButton" ng-disabled="cbsBulkUploadForm.$invalid">Upload</button>
		 <button type="submit" class="btn btn-cancel" id="cancelButton" ng-click="moveTo()">Cancel</button>
		 <img ng-if="fileUploadDataLoading" src="data:image/gif;base64,"/>
	   </div>
	</form>
</div>