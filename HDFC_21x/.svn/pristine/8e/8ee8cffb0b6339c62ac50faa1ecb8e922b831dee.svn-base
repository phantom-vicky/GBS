<!--                                                   id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"-->
<!--                                                   ng-model="vm.customerMasterDetailsTwo.operativeAccNumber"  oninput="this.value = this.value.replace(/\s+/g, '')" required>-->
<!--                                        </td>-->
<!--                                        <td width="25%">-->
<!--                                            <label class="control-label required">IFSC Code</label></td>-->
<!--                                        <td width="25%">-->
<!--                                            <input type="text" class="form-control"-->
<!--                                                   id="aadharNum" chars="alpha-numeric" minlength="11" maxlength="11"-->
<!--                                                   onkeypress="return isNumber(event)"  ng-pattern="vm.ifscPattern"-->
<!--                                                   name="ifscCode" ng-model="vm.customerMasterDetailsTwo.ifscCode"-->
<!--                                                   required  ng-required="!vm.customerMasterDetailsTwo.micrCode" oninput="this.value = this.value.replace(/\s+/g, '')">-->
<!--                                        </td>-->
<!--                                    </tr>-->
<!--                                    <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP004'">-->
<!--                                        <td width="25%">-->
<!--                                            <label class="control-label">MICR Code</label></td>-->
<!--                                        <td width="25%">-->
<!--                                            <input type="text" class="form-control"-->
<!--                                                   id="aadharNum" chars="alpha-numeric" minlength="9" maxlength="9"-->
<!--                                                   onkeypress="return isNumber(event)"-->
<!--                                                   name="ifscCode" ng-model="vm.customerMasterDetailsTwo.micrCode"-->
<!--                                                   ng-required="!vm.customerMasterDetailsTwo.ifscCode" oninput="this.value = this.value.replace(/\s+/g, '')">-->
<!--                                        </td>-->
<!--                                    </tr>-->
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">PAN No</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="panNumber"
                                                   name="panNumber" maxlength="10" chars="alpha-numeric"
                                                   ng-model="vm.customerMasterDetailsTwo.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessNameOne"
                                                               chars="only-letters"  leading-space></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressOne" name="witnessAddressOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessAddressOne"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessNameTwo"
                                                               chars="only-letters" leading-space></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressTwo" name="witnessAddressTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessAddressTwo"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">
                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificate" name="birthCertificate" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.birthCertificate" ng-required="vm.birthCertificate">
                                        <label for="birthCertificate">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="passport" name="passport" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.passport" ng-required="vm.passport">
                                        <label for="passport">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.seniorCitizenCard" ng-required="vm.seniorCitizenCard">
                                        <label for="seniorCitizenCard">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="voterId" name="voterId" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.voterIdCard" ng-required="vm.voterIdCard">
                                        <label for="voterId">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="panCard" name="panCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.panCard" ng-required="vm.panCard">
                                        <label for="panCard">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="drivingLicence" name="drivingLicence" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.drivingLicence" ng-required="vm.drivingLicence">
                                        <label for="drivingLicence">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="rationCard" name="rationCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.rationCard" ng-required="vm.rationCard">
                                        <label for="rationCard">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                        <input type="checkbox" id="others" name="others" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.otherDocuments" ng-required="vm.otherDocuments">
                                        <label for="others">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                    </div>

                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="detailsForOthers" name="detailsForOthers" maxlength="120"
                                                   ng-model="vm.customerMasterDetailsTwo.detailsForOthers" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.detailsForOthers">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsTwo.remarks" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>

                    </form>
                </uib-accordion>
                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="submitButton1"  ng-click="vm.tabReferenceAdd ='reversalForm'"
                            ng-disabled="vm.customerMasterForm.$invalid">Next</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton1"
                            onclick="window.location.href= '#!/Joint_type_change_Three_to_two/add';">Cancel</button>
                </div>
            </div>
        </div><div id="customerMasterForm1" ng-show="vm.tabReferenceAdd =='customerMasterForm1'"  class="tab-pane fade in active"  ng-if="vm.blaFlag=='Y'">
        <div class="tab-body">
            <uib-accordion close-others="oneAtATime">
                <form name="vm.customerMasterForm1" role="form"
                      ng-submit="vm.addcustomerMaster(vm.customerMasterForm1.$valid)">
                    <div uib-accordion-group id="general-details"
                         class="panel-default panel panel-open"
                         heading="Bond Ledger Account Maintenance - Add" is-open="true">
                        <div class="row">
                            <div class="form-group" ng-class="requiredClass">
                                <label class="control-label col-sm-3">Mode of Holding</label>
                                <div class="col-sm-2">:
                                    <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'">JOINT - JOINTLY</label>
                                </div>
                                <label class="control-label col-sm-3">Name of the Bond Scheme</label>
                                <div class="col-sm-3">:
                                    <label class="data-bind">{{vm.schemeName}}</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div uib-accordion-group id="personal-details" class="panel"
                         heading='{{vm.titleText}}'
                         is-open="vm.personalDetailsOpen"
                         ng-class="(vm.customerMasterForm.$invalid) ? 'panel-danger' : 'panel-success'">

                        <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                            <table class="table table-bordered">
                                <tbody>


                                <tr>
                                    <td width="25%" class="form-group required"><label
                                            for="subscriberFirstName" class="control-label">Bond Holder First
                                        Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberFirstName" name="customerFirstName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.bondHldFirstName"
                                                           chars="only-letters"
                                                           required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" readonly></td>
                                    <td width="25%">Bond Holder Middle Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberMiddleName" name="customerMiddleName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%">Bond Holder Last Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberLastName" name="customerLastName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" disabled>
                                    </td>
                                    <td width="25%" class="form-group required"><label
                                            class="control-label">Holder Type</label></td>
                                    <td width="25%">
                                        <select class="form-control"
                                                ng-model="vm.customerMasterDetails.holderType" ng-change="vm.getValidations(vm.customerMasterDetails.holderType);" required disabled>
                                            <option value="" hidden="true">Select</option>
                                            <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                            <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                            <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%"><label
                                            for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="fatherName" name="fatherName"
                                                           maxlength="30" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                           ng-model="vm.customerMasterDetails.fatherName"
                                                           chars="only-letters" disabled
                                    ></td>
                                    <td width="25%">
                                        <label  class="control-label">Mother's Maiden Name</label>
                                    </td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="motherName" name="motherName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.motherName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Gender</label></td>
                                    <td width="25%"><select class="form-control" id="gender"
                                                            name="state" ng-model="vm.customerMasterDetails.gender"
                                                            ng-required="!vm.customerMasterDetails.gender" disabled>
                                        <option value="" hidden="true">Select</option>
                                        <option value="M" >MALE</option>
                                        <option value="F" >FEMALE</option>
                                        <option value="O" >OTHERS</option>
                                    </select></td>


                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Is Minor (Y/N)?</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               value="{{ vm.customerMasterDetails.isMinor === 'Y' ? 'YES' : 'NO' }}"
                                               readonly>
                                    </td>


                                </tr>
                                <tr>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                    <td width="25%">
                                        <p class="input-group" >
                                            <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                   name="dateofBirth"
                                                   ng-model="vm.customerMasterDetails.bondHldDob"
                                                   ng-change="vm.checkAge(vm.customerMasterDetails.isMinor, vm.customerMasterDetails.bondHldDob,'add','1')"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.retirDatePickerValidation"
                                                   is-open="vm.dateOptions.opened"
                                                   close-text="Close" maxlength="10">
                                                                                               <span class="input-group-btn">
                                                                                           <button type="button" class="btn btn-secondary"
                                                                                               ng-click="vm.dateOptions.opened = true"
                                                                                               id="bondHolderDateOfBirthOptions">
                                                                                               <i class="glyphicon glyphicon-calendar"></i>
                                                                                           </button>
                                                                                        </span>
                                        </p>
                                    </td>
                                    <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.isMinor == 'Y'}"><label
                                            for="birthCertificateNo1" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                    <td width="25%" ng-if="!vm.id && vm.blaFlag!=='Y'"><input type="text" class="form-control"
                                                                                              id="birthCertificateNo2" name="birthCertificateNo" ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"
                                                                                              maxlength="30" chars="alpha-numeric" ng-required="vm.customerMasterDetails.isMinor == 'Y'" oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>


                                    <td width="25%" ng-if="vm.id || vm.blaFlag=='Y'">
                                        <input type="text" class="form-control"
                                               id="birthCertificateNo1" name="birthCertificateNo"
                                               ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"
                                               ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'Yes' : ''"
                                               maxlength="30" chars="alpha-numeric"
                                               ng-required="vm.customerMasterDetails.isMinor == 'Y'"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>


                                </tr>
                                <tr>

                                    <td width="25%" class="form-group required"><label
                                            for="address1" class="control-label">Communication Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address1" name="address1" ng-model="vm.customerMasterDetails.bondHldAddOne"
                                                           maxlength="200"
                                                           required   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>


                                    <td width="25%" ><label
                                            for="address2" class="control-label">Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address2" name="address2"
                                                           ng-model="vm.customerMasterDetails.bondHldAddTwo" maxlength="200"
                                                           ng-init="vm.tempPresentPremise = vm.presentPremise"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>



                                </tr>
                                <tr>

                                    <td width="25%" ><label
                                            for="presentFlat" class="control-label">Address 3</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetails.bondHldAddThree"
                                                           maxlength="200"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>


                                    <td width="25%"  class="form-group required">
                                        <label class="control-label">City</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sadistrict" name="district"  chars="only-letters"
                                                           limit-to="35"
                                                           ng-model="vm.customerMasterDetails.bondHldCity" onkeypress="return AvoidSpace(event)" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" readonly></td>

                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">State</label></td>
                                    <td width="25%"><select class="form-control" id="state"
                                                            name="state" ng-model="vm.customerMasterDetails.bondHldState"
                                                            ng-init="vm.getState()" required disabled>
                                        <option value="" hidden="true">Select State</option>
                                        <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                    </select></td>

                                    <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6" ng-blur="vm.getAddressOne(vm.customerMasterDetails.bondHldPinCode)"
                                                           ng-model="vm.customerMasterDetails.bondHldPinCode"
                                                           onkeypress="return isNumber(event)" required oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                </tr>
                                <tr>
                                    <td width="25%">Phone Number</td>
                                    <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="13"
                                                           id="saphoneNum" ng-model="vm.customerMasterDetails.bondHolderPhoneNumber"
                                                           chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                    <td width="25%">Mobile Number</td>
                                    <td width="25%">
                                        <input type="text" class="form-control" minlength="10" maxlength="13"
                                               id="mobileNumber" ng-model="vm.customerMasterDetails.bondHldMobNum"
                                               chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>


                                </tr>

                                <tr>

                                    <td width="25%" class="form-group"><label
                                            for="emailId" class="control-label">Email Id</label></td>
                                    <td width="25%" ><input type="email" class="form-control"
                                                            id="emailId" name="emailId" maxlength="100"
                                                            ng-model="vm.customerMasterDetails.bondHldEmail" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <label for="emailId" class="control-label " > HUF registration / Power of Attorney number</label>
                                    </td>



                                    <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <input type="text" class="form-control" minlength="1" maxlength="20" chars="alpha-numeric"
                                               id="powerOfattorneyNo" ng-model="vm.customerMasterDetails.hufRegPowerOfAttorney" chars="alpha-numeric"
                                               ng-required="vm.modeOfHolding=='MH004' || vm.customerMasterDetails.holderType == 'HT001' " oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                </tr>


                                <tr >
                                    <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <label for="emailId" class="control-label ">Power of Attorney/Karta Name</label>
                                    </td>


                                    <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <input type="text" class="form-control" minlength="1" maxlength="30"
                                               id="kartaName" ng-model="vm.customerMasterDetails.powerOfAttorneyKartaName"
                                               ng-required=" vm.modeOfHolding=='MH004' || vm.customerMasterDetails.holderType == 'HT001'"  ng-keypress="vm.validateInput($event,'kartaName');" disabled>
                                    </td>




                                </tr>


                                </tbody>
                            </table>

                            <h4 class="form_heading" ng-if="vm.modeOfHolding=='MH004'">Coparceners Details of Karta</h4>
                            <div class="col-sm-12 text-right form_submit" ng-if="vm.modeOfHolding=='MH004'">
                                <div class="row">
                                    <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRanges()">
                                        <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                    </a>

                                </div>
                            </div>
                            <table class="table table-bordered table-striped" ng-if="vm.modeOfHolding=='MH004'">
                                <tbody ng-repeat="item in vm.coparcenerslist">
                                <tr>
                                    <td colspan="4">
                                        <div class="col-sm-12 text-right form_submit">
                                            <div class="row">

                                                <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-if="vm.enableDelete" ng-click="vm.removeRanges(item.id.oldValue, $index)">
                                                    <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td colspan="4"><h4 class="form_heading">Coparceners Details of Karta {{$index+1}}</h4></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label for="coparcenersName[$index]">Coparceners  Name <span class="text-danger"> * </span></label></label></td>
                                    <td class="form-group">
                                        <input type="text" class="form-control" id="coparcenersName[$index]"
                                               chars="only-letters"
                                               limit-to="50" name="coparcenersName"
                                               ng-model="item.coparcenersName" required leading-space readonly>
                                    </td>
                                    <td width="25%" class="form-group" ><label class="control-label">Relationship with Karta</label></td>
                                    <td class="form-group" ng-required="item.coparcenersName">
                                        <input type="text" class="form-control" id="coparcenersRelation[$index]"
                                               chars="alpha-numeric"
                                               limit-to="50" name="coparcenersRelation"
                                               ng-model="item.coparcenersRelation"  oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>
                                </tr>




                                <tr>
                                    <td width="25%" class="form-group" >
                                        <label class="control-label">DOB</label></td>
                                    <td class="form-group" ng-required="item.coparcenersName">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="coparcenersDob{{$index}}" name="coparcenersDob"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   ng-model="item.coparcenersDob" maxlengtth="10" ng-init="coparcener.datepickerOpened=false"
                                                   is-open="coparcener.datepickerOpened" close-text="Close" maxlength="10"

                                                   ng-blur="vm.textableDatePicker('coparcenersDob{{$index}}',item.coparcenersDob)"
                                                   ng-keyup="vm.autoslashing('coparcenersDob{{$index}}')" chars="numbers-slash"


                                            >

                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="coparcener.datepickerOpened=true" >


                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>
                                </tbody>
                            </table>


                            <h4 class="form_heading" ng-if="vm.customerMasterDetails.isMinor=='Y'">GUARDIAN DETAILS</h4>
                            <table class="table table-bordered" ng-if="vm.customerMasterDetails.isMinor=='Y'">
                                <tbody>

                                <tr>
                                    <td width="25%" >
                                        <label for="guardianId" class="control-label">Guardian Id</label>
                                    </td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="guardianId"
                                                       name="guardianId"
                                                       ng-model="vm.customerMasterDetails.guardianId" disabled>
                                            </div>
                                            <div class="col-sm-3 torch-top" >
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                <i class="glyphicon glyphicon-remove clear cp"
                                                   ng-click=
                                                           "vm.customerMasterDetails.guardianId = '';
                                               vm.customerMasterDetails.guardianFirstName= '';
                                               vm.customerMasterDetails.guardianMiddleName='';
                                               vm.customerMasterDetails.guardianLastName='';
                                               vm.customerMasterDetails.relationWithMinor='';
                                               vm.customerMasterDetails.guardianDateOfBirth='';
                                               vm.customerMasterDetails.guardianCommunicationAddress='';
                                               vm.customerMasterDetails.guardianMobileNo='';
                                               vm.customerMasterDetails.guardianEmailId=''; " id="guardianIdClose"></i>
                                                <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                            </div>
                                        </div>
                                    </td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianFirstName" name="guardianFirstName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.guardianFirstName"
                                                           chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled></td>

                                </tr>

                                <tr>
                                    <td width="25%">Guardian Middle Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianMiddleName" name="guardianMiddleName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled>
                                    </td>

                                    <td width="25%">Guardian Last Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianLastName" name="guardianLastName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" disabled>
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Relation with minor</label></td>
                                    <td width="25%">
                                        <select class="form-control" id="relationWithMinor" ng-init=""
                                                name="relationWithMinor" ng-model="vm.customerMasterDetails.relationWithMinor"
                                                disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Date of Birth</label></td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="guardianDateOfBirth" ng-init="vm.isAgeValid();"
                                                   name="guardianDateOfBirth" ng-model="vm.customerMasterDetails.guardianDateOfBirth"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.dobCalenderOptions"
                                                   is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" readonly>
                                            <!-- <span class="input-group-btn">
                         <button type="button" class="btn btn-secondary"
                                 ng-click="vm.submissionfifteenGHPicker.opened = true"
                                 id="submissionfifteenGHSearcher">
                             <i class="glyphicon glyphicon-calendar"></i>
                         </button>
                     </span>-->
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="address1" class="control-label">Communication Address</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetails.guardianCommunicationAddress"
                                                           maxlength="200"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                    <td width="25%">Mobile Number</td>
                                    <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="13"
                                                           id="guardianMobileNumber" ng-model="vm.customerMasterDetails.guardianMobileNo"
                                                           chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" disabled></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="emailId" class="control-label">Email Id</label></td>
                                    <td width="25%"><input type="email" class="form-control"
                                                           id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                           ng-model="vm.customerMasterDetails.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>
                                </tr>
                                </tbody>
                            </table>
                            <h4 class="form_heading">OTHERS DETAILS</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Whether the customer belongs to <br> HDFC?</label></td>
                                    <td width="25%">
                                        <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()" disabled>Yes
                                        <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()" disabled>No
                                    </td>

                                    <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'" class="form-group required">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                        <input type="text" class="form-control"
                                               ng-init="vm.customerMasterDetails.operativeAccNum ==''"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetails.operativeAccNum"
                                               ng-required="vm.customerMasterDetails.hdfcOtherBank == 'Y'"
                                               ng-disabled="vm.customerMasterDetails.hdfcOtherBank != 'Y'"
                                               oninput="this.value = this.value.toUpperCase().replace(/^\s+/g, '').replace(/\s+/g, '')" disabled>

                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                        <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetails(vm.customerMasterDetails.operativeAccNum);"
                                                ng-disabled="!vm.customerMasterDetails.operativeAccNum || vm.customerMasterDetails.hdfcOtherBank != 'Y'" disabled>
                                            Fetch
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Mode of Interest Payment/ Principal<br> Repayment</label>
                                    </td>
                                    <td width="25%">
                                        <select class="form-control" id="modeOfInterestPayment" ng-init=""
                                                name="modeOfInterestPayment" ng-model="vm.customerMasterDetails.modeOfInterestPayment" ng-change="vm.modeOfInterestPaymentValidation(vm.customerMasterDetails.modeOfInterestPayment);"
                                                 disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.modeOfInterestPaymentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                        <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                        <label class="control-label">Account Type code</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                        <select class="form-control" id="accountType"
                                                name="accountType" ng-model="vm.customerMasterDetails.accountType"
                                                disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.accountTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>


                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                        <label class="control-label">DD/PO Account Number</label></td>
                                    <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                        <input type="text" class="form-control"
                                               id="ddpoAccountNo" name="ddpoAccountNo" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'||vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group required" >
                                        <label class="control-labelaria-controls">Bank Name</label></td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="bankCodeNonMicr"
                                                       name="bankCodeNonMicr"
                                                       ng-model="vm.customerMasterDetails.bankCode"
                                                       chars="alpha-numeric" disabled readonly required>
                                            </div>
                                            <!--<div class="col-sm-3 torch-top">
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   id="otherBankSearcher"
                                                   ng-click="vm.getOtherBankDetailsTorch('torch');"></i> <i
                                                    class="glyphicon glyphicon-remove clear cp"
                                                    ng-click="vm.customerMasterDetails.bankCode='';vm.customerMasterDetails.branchCode=''"></i>
                                            </div>-->
                                        </div>
                                    </td>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Branch Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="branchCode" name="branchCode" chars="alpha-numeric" maxlength="20"
                                               ng-model="vm.customerMasterDetails.branchCode" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group">
                                        <label class="control-label">IFSC Code of the Credit Bank</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="ifscCode" name="ifscCode" chars="alpha-numeric" maxlength="11"  ng-pattern="vm.ifscPattern"
                                               ng-model="vm.customerMasterDetails.ifscCode" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Name of the Payee</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="nameOfthePayee" name="nameOfthePayee" chars="alpha-numeric" maxlength="50"
                                               ng-model="vm.customerMasterDetails.nameOfthePayee" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Credit Account Number</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="creditAccNo" name="creditAccNo" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                    <td width="25%">
                                    <td width="25%">
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetails.operativeAccNumber"  oninput="this.value = this.value.replace(/\s+/g, '')" required disabled>
                                    </td>
                                    <td width="25%">
                                        <label class="control-label">IFSC Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="ifscCode" chars="alpha-numeric" maxlength="11"
                                               onkeypress="return isNumber(event)"  ng-pattern="vm.ifscPattern"
                                               name="ifscCode" ng-model="vm.customerMasterDetails.ifscCode"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">
                                    <td width="25%">
                                        <label class="control-label">MICR Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="micrCode" chars="alpha-numeric" minlength="9" maxlength="9"
                                               onkeypress="return isNumber(event)"
                                               name="micrCode" ng-model="vm.customerMasterDetails.micrCode"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">PAN No</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="panNumber"
                                               name="panNumber" maxlength="10" chars="alpha-numeric"
                                               ng-model="vm.customerMasterDetails.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                            <h4 class="form_heading">WITNESS DETAILS</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameOne" name="witnessNameOne"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.witnessNameOne"
                                                           chars="only-letters"  leading-space disabled></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessAddressOne" name="witnessAddressOne"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.witnessAddressOne"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameTwo" name="witnessNameTwo"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.witnessNameTwo"
                                                           chars="only-letters" leading-space disabled></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessAddressTwo" name="witnessAddressTwo"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetails.witnessAddressTwo"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                </tr>

                                </tbody>
                            </table>
                            <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                            <table class="table table-bordered">
                                <div class="col-md-12 map-div">
                                    <input type="checkbox" id="birthCertificate" name="birthCertificate" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.birthCertificate" ng-required="vm.birthCertificate" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="birthCertificate">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="passport" name="passport" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.passport" ng-required="vm.passport" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="passport">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.seniorCitizenCard" ng-required="vm.seniorCitizenCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="seniorCitizenCard">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="voterId" name="voterId" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.voterIdCard" ng-required="vm.voterIdCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="voterId">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="panCard" name="panCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.panCard" ng-required="vm.panCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="panCard">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="drivingLicence" name="drivingLicence" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.drivingLicence" ng-required="vm.drivingLicence" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="drivingLicence">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="rationCard" name="rationCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.rationCard" ng-required="vm.rationCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="rationCard">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="others" name="others" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetails.otherDocuments" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="others">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                </div>

                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="detailsForOthers" name="detailsForOthers" maxlength="120"
                                               ng-model="vm.customerMasterDetails.detailsForOthers" chars="only-letters"  oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.detailsForOthers">
                                    </td>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Remarks</label>
                                    </td>
                                    <td width="25%" >
                                        <input type="text" class="form-control"
                                               id="remarks" name="remarks"
                                               maxlength="200"
                                               ng-model="vm.customerMasterDetails.remarks" oninput="this.value = this.value.replace(/^\s/, '')" disabled>
                                    </td>
                                </tr>

                            </table>

                        </ng-form>
                    </div>

































                    <div uib-accordion-group id="joint-personal-details" class="panel"
                         heading="SECOND JOINT ACCOUNT HOLDER DETAILS"
                         is-open="vm.secondHolderDetails"
                         ng-class="(vm.secondJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'">
                        <ng-form name="vm.secondJoinAccountHolderDetails" ng-init="vm.customerMasterDetailsTwo">
                            <table class="table table-bordered">
                                <tbody>


                                <tr>
                                    <td width="25%" class="form-group required"><label
                                            for="subscriberFirstName" class="control-label">Bond Holder First
                                        Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberFirstName" name="customerFirstName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldFirstName"
                                                           chars="only-letters"
                                                           required oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" readonly></td>
                                    <td width="25%">Bond Holder Middle Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberMiddleName" name="customerMiddleName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%">Bond Holder Last Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="subscriberLastName" name="customerLastName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" disabled>
                                    </td>
                                    <td width="25%" class="form-group"><label
                                            class="control-label">Holder Type</label></td>
                                    <td width="25%">
                                        <select class="form-control"
                                                ng-model="vm.customerMasterDetailsTwo.holderType" ng-change="vm.getValidations(vm.customerMasterDetailsTwo.holderType);"  disabled>
                                            <option value="" hidden="true">Select</option>
                                            <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                            <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                            <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                            <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%"><label
                                            for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="fatherName" name="fatherName"
                                                           maxlength="30" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')"
                                                           ng-model="vm.customerMasterDetailsTwo.fatherName"
                                                           chars="only-letters" disabled
                                    ></td>
                                    <td width="25%">
                                        <label  class="control-label">Mother's Maiden Name</label>
                                    </td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="motherName" name="motherName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.motherName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Gender</label></td>
                                    <td width="25%"><select class="form-control" id="gender"
                                                            name="state" ng-model="vm.customerMasterDetailsTwo.gender"
                                                            ng-required="!vm.customerMasterDetailsTwo.gender" disabled>
                                        <option value="" hidden="true">Select</option>
                                        <option value="M" >MALE</option>
                                        <option value="F" >FEMALE</option>
                                        <option value="O" >OTHERS</option>
                                    </select></td>


                                    <td width="25%" class="form-group" >
                                        <label class="control-label">Is Minor (Y/N)?</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               value="{{ vm.customerMasterDetailsTwo.isMinor === 'Y' ? 'YES' : 'NO' }}"
                                               readonly>
                                    </td>


                                </tr>
                                <tr>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                    <td width="25%">
                                        <p class="input-group" >
                                            <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                   name="dateofBirth"
                                                   ng-model="vm.customerMasterDetailsTwo.bondHldDob"
                                                   ng-change="vm.checkAge(vm.customerMasterDetailsTwo.isMinor, vm.customerMasterDetailsTwo.bondHldDob,'add','1')"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.retirDatePickerValidation"
                                                   is-open="vm.dateOptions.opened"
                                                   close-text="Close" maxlength="10">
                                                                                               <span class="input-group-btn">
                                                                                           <button type="button" class="btn btn-secondary"
                                                                                               ng-click="vm.dateOptions.opened = true"
                                                                                               id="bondHolderDateOfBirthOptions">
                                                                                               <i class="glyphicon glyphicon-calendar"></i>
                                                                                           </button>
                                                                                        </span>
                                        </p>
                                    </td>
                                    <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsTwo.isMinor == 'Y'}"><label
                                            for="birthCertificateNo1" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                    <td width="25%" ng-if="!vm.id && vm.blaFlag!=='Y'"><input type="text" class="form-control"
                                                                                              id="birthCertificateNo2" name="birthCertificateNo" ng-model="vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                                                                              maxlength="30" chars="alpha-numeric" ng-required="vm.customerMasterDetailsTwo.isMinor == 'Y'" oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>


                                    <td width="25%" ng-if="vm.id || vm.blaFlag=='Y'">
                                        <input type="text" class="form-control"
                                               id="birthCertificateNo1" name="birthCertificateNo"
                                               ng-model="vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                               ng-value="vm.customerMasterDetailsTwo.isMinor == 'Y' ? 'Yes' : ''"
                                               maxlength="30" chars="alpha-numeric"
                                               ng-required="vm.customerMasterDetailsTwo.isMinor == 'Y'"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>


                                </tr>
                                <tr>

                                    <td width="25%" class="form-group"><label
                                            for="address1" class="control-label">Communication Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address1" name="address1" ng-model="vm.customerMasterDetailsTwo.bondHldAddOne"
                                                           maxlength="200"
                                                              oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>


                                    <td width="25%" ><label
                                            for="address2" class="control-label">Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="address2" name="address2"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldAddTwo" maxlength="200"
                                                           ng-init="vm.tempPresentPremise = vm.presentPremise"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>



                                </tr>
                                <tr>

                                    <td width="25%" ><label
                                            for="presentFlat" class="control-label">Address 3</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsTwo.bondHldAddThree"
                                                           maxlength="200"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" readonly></td>


                                    <td width="25%"  class="form-group">
                                        <label class="control-label">City</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sadistrict" name="district"  chars="only-letters"
                                                           limit-to="35"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldCity" onkeypress="return AvoidSpace(event)"  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s+/g, '')" readonly></td>

                                </tr>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">State</label></td>
                                    <td width="25%"><select class="form-control" id="state"
                                                            name="state" ng-model="vm.customerMasterDetailsTwo.bondHldState"
                                                            ng-init="vm.getState()"  disabled>
                                        <option value="" hidden="true">Select State</option>
                                        <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                    </select></td>

                                    <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6" ng-blur="vm.getAddressOne(vm.customerMasterDetailsTwo.bondHldPinCode)"
                                                           ng-model="vm.customerMasterDetailsTwo.bondHldPinCode"
                                                           onkeypress="return isNumber(event)"  oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                </tr>
                                <tr>
                                    <td width="25%">Phone Number</td>
                                    <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="13"
                                                           id="saphoneNum" ng-model="vm.customerMasterDetailsTwo.bondHolderPhoneNumber"
                                                           chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                    <td width="25%">Mobile Number</td>
                                    <td width="25%">
                                        <input type="text" class="form-control" minlength="10" maxlength="13"
                                               id="mobileNumber" ng-model="vm.customerMasterDetailsTwo.bondHldMobNum"
                                               chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>


                                </tr>

                                <tr>

                                    <td width="25%" class="form-group"><label
                                            for="emailId" class="control-label">Email Id</label></td>
                                    <td width="25%" ><input type="email" class="form-control"
                                                            id="emailId" name="emailId" maxlength="100"
                                                            ng-model="vm.customerMasterDetailsTwo.bondHldEmail" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetailsTwo.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <label for="emailId" class="control-label " > HUF registration / Power of Attorney number</label>
                                    </td>



                                    <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <input type="text" class="form-control" minlength="1" maxlength="20" chars="alpha-numeric"
                                               id="powerOfattorneyNo" ng-model="vm.customerMasterDetailsTwo.hufRegPowerOfAttorney" chars="alpha-numeric"
                                               ng-required="vm.modeOfHolding=='MH004' || vm.customerMasterDetailsTwo.holderType == 'HT001' " oninput="this.value = this.value.replace(/\s+/g, '')" readonly></td>

                                </tr>


                                <tr >
                                    <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetailsTwo.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <label for="emailId" class="control-label ">Power of Attorney/Karta Name</label>
                                    </td>


                                    <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                        <input type="text" class="form-control" minlength="1" maxlength="30"
                                               id="kartaName" ng-model="vm.customerMasterDetailsTwo.powerOfAttorneyKartaName"
                                               ng-required=" vm.modeOfHolding=='MH004' || vm.customerMasterDetailsTwo.holderType == 'HT001'"  ng-keypress="vm.validateInput($event,'kartaName');" disabled>
                                    </td>




                                </tr>


                                </tbody>
                            </table>

                            <h4 class="form_heading" ng-if="vm.modeOfHolding=='MH004'">Coparceners Details of Karta</h4>
                            <div class="col-sm-12 text-right form_submit" ng-if="vm.modeOfHolding=='MH004'">
                                <div class="row">
                                    <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRanges()">
                                        <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                    </a>

                                </div>
                            </div>
                            <table class="table table-bordered table-striped" ng-if="vm.modeOfHolding=='MH004'">
                                <tbody ng-repeat="item in vm.coparcenerslist">
                                <tr>
                                    <td colspan="4">
                                        <div class="col-sm-12 text-right form_submit">
                                            <div class="row">

                                                <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-if="vm.enableDelete" ng-click="vm.removeRanges(item.id.oldValue, $index)">
                                                    <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>

                                <tr>
                                    <td colspan="4"><h4 class="form_heading">Coparceners Details of Karta {{$index+1}}</h4></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label for="coparcenersName[$index]">Coparceners  Name <span class="text-danger"> * </span></label></label></td>
                                    <td class="form-group">
                                        <input type="text" class="form-control" id="coparcenersName[$index]"
                                               chars="only-letters"
                                               limit-to="50" name="coparcenersName"
                                               ng-model="item.coparcenersName" required leading-space readonly>
                                    </td>
                                    <td width="25%" class="form-group" ><label class="control-label">Relationship with Karta</label></td>
                                    <td class="form-group" ng-required="item.coparcenersName">
                                        <input type="text" class="form-control" id="coparcenersRelation[$index]"
                                               chars="alpha-numeric"
                                               limit-to="50" name="coparcenersRelation"
                                               ng-model="item.coparcenersRelation"  oninput="this.value = this.value.replace(/\s+/g, '')" readonly>
                                    </td>
                                </tr>




                                <tr>
                                    <td width="25%" class="form-group" >
                                        <label class="control-label">DOB</label></td>
                                    <td class="form-group" ng-required="item.coparcenersName">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="coparcenersDob{{$index}}" name="coparcenersDob"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   ng-model="item.coparcenersDob" maxlengtth="10" ng-init="coparcener.datepickerOpened=false"
                                                   is-open="coparcener.datepickerOpened" close-text="Close" maxlength="10"

                                                   ng-blur="vm.textableDatePicker('coparcenersDob{{$index}}',item.coparcenersDob)"
                                                   ng-keyup="vm.autoslashing('coparcenersDob{{$index}}')" chars="numbers-slash"


                                            >

                                            <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="coparcener.datepickerOpened=true" >


                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                        </p>
                                    </td>
                                </tr>
                                </tbody>
                            </table>


                            <h4 class="form_heading" ng-if="vm.customerMasterDetailsTwo.isMinor=='Y'">GUARDIAN DETAILS</h4>
                            <table class="table table-bordered" ng-if="vm.customerMasterDetailsTwo.isMinor=='Y'">
                                <tbody>

                                <tr>
                                    <td width="25%" >
                                        <label for="guardianId" class="control-label">Guardian Id</label>
                                    </td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="guardianId"
                                                       name="guardianId"
                                                       ng-model="vm.customerMasterDetailsTwo.guardianId" disabled>
                                            </div>
                                            <div class="col-sm-3 torch-top" >
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                <i class="glyphicon glyphicon-remove clear cp"
                                                   ng-click=
                                                           "vm.customerMasterDetailsTwo.guardianId = '';
                                               vm.customerMasterDetailsTwo.guardianFirstName= '';
                                               vm.customerMasterDetailsTwo.guardianMiddleName='';
                                               vm.customerMasterDetailsTwo.guardianLastName='';
                                               vm.customerMasterDetailsTwo.relationWithMinor='';
                                               vm.customerMasterDetailsTwo.guardianDateOfBirth='';
                                               vm.customerMasterDetailsTwo.guardianCommunicationAddress='';
                                               vm.customerMasterDetailsTwo.guardianMobileNo='';
                                               vm.customerMasterDetailsTwo.guardianEmailId=''; " id="guardianIdClose"></i>
                                                <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                            </div>
                                        </div>
                                    </td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianFirstName" name="guardianFirstName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.guardianFirstName"
                                                           chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled></td>

                                </tr>

                                <tr>
                                    <td width="25%">Guardian Middle Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianMiddleName" name="guardianMiddleName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z]/g, '')" disabled>
                                    </td>

                                    <td width="25%">Guardian Last Name</td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianLastName" name="guardianLastName"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/[^a-zA-Z ]/g, '').replace(/\s+/g, ' ')" disabled>
                                    </td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Relation with minor</label></td>
                                    <td width="25%">
                                        <select class="form-control" id="relationWithMinor" ng-init=""
                                                name="relationWithMinor" ng-model="vm.customerMasterDetailsTwo.relationWithMinor"
                                                disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Date of Birth</label></td>
                                    <td width="25%">
                                        <p class="input-group">
                                            <input type="text" class="form-control" id="guardianDateOfBirth" ng-init="vm.isAgeValid();"
                                                   name="guardianDateOfBirth" ng-model="vm.customerMasterDetailsTwo.guardianDateOfBirth"
                                                   uib-datepicker-popup="dd/MM/yyyy"
                                                   datepicker-options="vm.dobCalenderOptions"
                                                   is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" readonly>
                                            <!-- <span class="input-group-btn">
                         <button type="button" class="btn btn-secondary"
                                 ng-click="vm.submissionfifteenGHPicker.opened = true"
                                 id="submissionfifteenGHSearcher">
                             <i class="glyphicon glyphicon-calendar"></i>
                         </button>
                     </span>-->
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="address1" class="control-label">Communication Address</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsTwo.guardianCommunicationAddress"
                                                           maxlength="200"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                    <td width="25%">Mobile Number</td>
                                    <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="13"
                                                           id="guardianMobileNumber" ng-model="vm.customerMasterDetailsTwo.guardianMobileNo"
                                                           chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')" disabled></td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="emailId" class="control-label">Email Id</label></td>
                                    <td width="25%"><input type="email" class="form-control"
                                                           id="guardianEmailId" name="guardianEmailId" maxlength="100"
                                                           ng-model="vm.customerMasterDetailsTwo.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                        <span class="text-danger"
                                              ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>
                                </tr>
                                </tbody>
                            </table>
                            <h4 class="form_heading">OTHERS DETAILS</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Whether the customer belongs to <br> HDFC?</label></td>
                                    <td width="25%">
                                        <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()" disabled>Yes
                                        <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()" disabled>No
                                    </td>

                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'" class="form-group required">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                        <input type="text" class="form-control"
                                               ng-init="vm.customerMasterDetailsTwo.operativeAccNum ==''"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.operativeAccNum"
                                               ng-required="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'"
                                               ng-disabled="vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y'"
                                               oninput="this.value = this.value.toUpperCase().replace(/^\s+/g, '').replace(/\s+/g, '')" disabled>

                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                        <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetails(vm.customerMasterDetailsTwo.operativeAccNum);"
                                                ng-disabled="!vm.customerMasterDetailsTwo.operativeAccNum || vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y'" disabled>
                                            Fetch
                                        </button>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Mode of Interest Payment/ Principal<br> Repayment</label>
                                    </td>
                                    <td width="25%">
                                        <select class="form-control" id="modeOfInterestPayment"
                                                name="modeOfInterestPayment" ng-model="vm.customerMasterDetailsTwo.modeOfInterestPayment" ng-change="vm.modeOfInterestPaymentValidation(vm.customerMasterDetails.modeOfInterestPayment);"
                                                disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.modeOfInterestPaymentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP001'">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP001'">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                        <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP001'">
                                        <label class="control-label">Account Type code</label>
                                    </td>
                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP001'">
                                        <select class="form-control" id="accountType"
                                                name="accountType" ng-model="vm.customerMasterDetailsTwo.accountType"
                                                disabled>
                                            <option value="" hidden="true">Select</option>
                                            <option ng-repeat="item in vm.accountTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                        </select>
                                    </td>


                                    <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP002'">
                                        <label class="control-label">DD/PO Account Number</label></td>
                                    <td width="25%" ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP002'">
                                        <input type="text" class="form-control"
                                               id="ddpoAccountNo" name="ddpoAccountNo" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP004'||vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group required" >
                                        <label class="control-labelaria-controls">Bank Name</label></td>
                                    <td width="25%">
                                        <div class="row">
                                            <div class="col-sm-9">
                                                <input type="text" class="form-control" id="bankCodeNonMicr"
                                                       name="bankCodeNonMicr"
                                                       ng-model="vm.customerMasterDetailsTwo.bankCode"
                                                       chars="alpha-numeric" disabled readonly required>
                                            </div>
                                            <!--<div class="col-sm-3 torch-top">
                                                <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                   id="otherBankSearcher"
                                                   ng-click="vm.getOtherBankDetailsTorch('torch');"></i> <i
                                                    class="glyphicon glyphicon-remove clear cp"
                                                    ng-click="vm.customerMasterDetails.bankCode='';vm.customerMasterDetails.branchCode=''"></i>
                                            </div>-->
                                        </div>
                                    </td>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Branch Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="branchCode" name="branchCode" chars="alpha-numeric" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.branchCode" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group">
                                        <label class="control-label">IFSC Code of the Credit Bank</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="ifscCode" name="ifscCode" chars="alpha-numeric" maxlength="11"  ng-pattern="vm.ifscPattern"
                                               ng-model="vm.customerMasterDetailsTwo.ifscCode" oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Name of the Payee</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="nameOfthePayee" name="nameOfthePayee" chars="alpha-numeric" maxlength="50"
                                               ng-model="vm.customerMasterDetailsTwo.nameOfthePayee" required oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP003'">
                                    <td width="25%" class="form-group required" >
                                        <label class="control-label">Credit Account Number</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="creditAccNo" name="creditAccNo" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                    <td width="25%">
                                    <td width="25%">
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP004'">
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">Operative Account Number</label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="operativeAcc" name="operativeAcc" chars="only-numbers" maxlength="20"
                                               ng-model="vm.customerMasterDetailsTwo.operativeAccNumber"  oninput="this.value = this.value.replace(/\s+/g, '')" required disabled>
                                    </td>
                                    <td width="25%">
                                        <label class="control-label">IFSC Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="ifscCode" chars="alpha-numeric" maxlength="11"
                                               onkeypress="return isNumber(event)"  ng-pattern="vm.ifscPattern"
                                               name="ifscCode" ng-model="vm.customerMasterDetailsTwo.ifscCode"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr ng-if="vm.customerMasterDetailsTwo.modeOfInterestPayment == 'MP004'">
                                    <td width="25%">
                                        <label class="control-label">MICR Code</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="micrCode" chars="alpha-numeric" minlength="9" maxlength="9"
                                               onkeypress="return isNumber(event)"
                                               name="micrCode" ng-model="vm.customerMasterDetailsTwo.micrCode"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                <tr>
                                    <td width="25%" class="form-group required">
                                        <label class="control-label">PAN No</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="panNumber"
                                               name="panNumber" maxlength="10" chars="alpha-numeric"
                                               ng-model="vm.customerMasterDetailsTwo.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')" disabled>
                                    </td>
                                </tr>
                                </tbody>
                            </table>
                            <h4 class="form_heading">WITNESS DETAILS</h4>
                            <table class="table table-bordered">
                                <tbody>
                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameOne" name="witnessNameOne"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.witnessNameOne"
                                                           chars="only-letters"  leading-space disabled></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessAddressOne" name="witnessAddressOne"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.witnessAddressOne"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                </tr>

                                <tr>
                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessNameTwo" name="witnessNameTwo"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.witnessNameTwo"
                                                           chars="only-letters" leading-space disabled></td>

                                    <td width="25%" class="form-group"><label
                                            for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                    <td width="25%"><input type="text" class="form-control"
                                                           id="witnessAddressTwo" name="witnessAddressTwo"
                                                           maxlength="30"
                                                           ng-model="vm.customerMasterDetailsTwo.witnessAddressTwo"
                                                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');" disabled></td>
                                </tr>

                                </tbody>
                            </table>
                            <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                            <table class="table table-bordered">
                                <div class="col-md-12 map-div">
                                    <input type="checkbox" id="birthCertificate" name="birthCertificate" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.birthCertificate" ng-required="vm.birthCertificate" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="birthCertificate">Birth Certificate<span ng-if="vm.birthCertificate" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="passport" name="passport" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.passport" ng-required="vm.passport" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="passport">Passport<span ng-if="vm.passport" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.seniorCitizenCard" ng-required="vm.seniorCitizenCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="seniorCitizenCard">Senior Citizen Card<span ng-if="vm.seniorCitizenCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="voterId" name="voterId" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.voterIdCard" ng-required="vm.voterIdCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="voterId">Voter ID Card<span ng-if="vm.voterIdCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="panCard" name="panCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.panCard" ng-required="vm.panCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="panCard">Pan Card<span ng-if="vm.panCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="drivingLicence" name="drivingLicence" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.drivingLicence" ng-required="vm.drivingLicence" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="drivingLicence">Driving Licence<span ng-if="vm.drivingLicence" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="rationCard" name="rationCard" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.rationCard" ng-required="vm.rationCard" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="rationCard">Ration Card<span ng-if="vm.rationCard" style="color:red"> *</span></label><br>
                                    <input type="checkbox" id="others" name="others" ng-true-value="'Y'" ng-false-value="'N'" ng-model="vm.customerMasterDetailsTwo.otherDocuments" ng-true-value="'Y'" ng-false-value="'N'" ng-required="vm.otherDocuments" ng-disabled="vm.blaFlag=='Y'">
                                    <label for="others">Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label><br>
                                </div>

                                <tr>
                                    <td width="25%" class="form-group">
                                        <label class="control-label">Details for Others<span ng-if="vm.otherDocuments" style="color:red"> *</span></label>
                                    </td>
                                    <td width="25%">
                                        <input type="text" class="form-control"
                                               id="detailsForOthers" name="detailsForOthers" maxlength="120"
                                               ng-model="vm.customerMasterDetailsTwo.detailsForOthers" chars="only-letters"
                                               oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.detailsForOthers" ng-disabled="vm.blaFlag=='Y'">
                                    </td>

                                    <td width="25%" class="form-group">
                                        <label class="control-label">Remarks</label>
                                    </td>
                                    <td width="25%" >
                                        <input type="text" class="form-control"
                                               id="remarks" name="remarks"
                                               maxlength="200"
                                               ng-model="vm.customerMasterDetailsTwo.remarks" oninput="this.value = this.value.replace(/^\s/, '')" disabled>
                                    </td>
                                </tr>

                            </table>

                        </ng-form>
                    </div>















                </form>
            </uib-accordion>
            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton2" ng-click="vm.tabReferenceAdd ='reversalForm'"
                        ng-disabled="vm.customerMasterForm1.$invalid">Next</button>
                <button type="button" class="btn btn-cancel" id="cancelButton2"
                        onclick="window.location.href= '#!/Joint_type_change_Three_to_two/add';">Cancel</button>
            </div>
        </div>
    </div>
        <!-- TranCode Details -->
        <div class="modal" id="otherBankDetailsModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Other Bank Details List</h4>
                    </div>
                    <div class="modal-body">
                        <div class="loader_popup"></div>
                        <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length>0">
                            <div class="col-sm-8 form_submit">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="glyphicon glyphicon-search"></i>
                                        </div>
                                        <input type="text" class="form-control"
                                               ng-model="vm.searchTranCode"
                                               ng-init="vm.searchTranCode = ''"
                                               placeholder="Search">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll">
                                        <thead ng-init="reverseOrder = false; sortedColumn = 'clgTranCode'">
                                        <tr>
                                            <th class="modal-title title-case" ng-click="(sortedColumn == 'bankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankCode';" ng-class="(sortedColumn == 'bankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Name</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.otherBankDetailsTorchList | filter:vm.searchTranCode | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetails.bankCode = x.bankCode;vm.customerMasterDetails.bankName = x.bankName;"
                                            data-bs-dismiss="modal">
                                            <td>{{x.bankName}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.otherBankDetailsTorchList.length==0">No
                            records found to display.</div>
                    </div>
                </div>
            </div>
        </div>

