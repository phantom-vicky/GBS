                                <tr>
                                    <td>Details of Birth certificate submitted as per norms</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C017)?
                                        (vm.getDetails.masterDetailsValueModel[0].C017.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C017? (vm.getDetails.masterDetailsValueModel[0].C017.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Communication Address 1</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C018)?
                                        (vm.getDetails.masterDetailsValueModel[0].C018.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C018? (vm.getDetails.masterDetailsValueModel[0].C018.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Address 2</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C019)?
                                        (vm.getDetails.masterDetailsValueModel[0].C019.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C019? (vm.getDetails.masterDetailsValueModel[0].C019.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Address 3</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C020)?
                                        (vm.getDetails.masterDetailsValueModel[0].C020.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C020? (vm.getDetails.masterDetailsValueModel[0].C020.newValue) : ('')}}
