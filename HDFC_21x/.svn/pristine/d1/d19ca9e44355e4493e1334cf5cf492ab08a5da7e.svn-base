<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">{{vm.screenModule}} Level Master - Delete</h4>
    <sol-header></sol-header>
    <form name="levelMasterForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">


            <div class="row" ng-if="vm.screenModule=='ICEGATE'">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="moduleName" class="control-label">Module Name</label>
                    </div>
                    <div class="col-sm-4">
                        <label ng-init="vm.getUnVerifyRecords()">{{vm.screenModule}}</label>
                    </div>
                </div>
            </div>

            <div class="row" ng-if="vm.screenModule!='ICEGATE'">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="moduleName" class="control-label">Module Name</label>
                    </div>
                    <div class="col-sm-4">
                        <select class="form-control" id="moduleName" name="moduleName"
                                ng-model="vm.moduleId"
                                ng-init="vm.getModuleName();" ng-change="vm.getUnVerifyRecords();" required>
                            <option value="" >Select</option>
                            <option ng-repeat="item in vm.moduleList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="row " ng-if="vm.moduleId && vm.heirarchyLevel.length>0">
                <div class="table-responsive map-div">
                    <table class="table table-bordered table-stripped">
                        <thead>
                        <th>Level Code</th>
                        <th>Level Name</th>
                        <th>Parent Level Name</th>
                        </thead>
                        <tbody>
                        <tr ng-repeat="item in vm.heirarchyLevel">
                            <td>
                                <label class="control-label" ng-bind="item.levelId"></label>
                            </td>
                            <td>
                                <label class="control-label" ng-bind="item.levelName"></label>
                            </td>
                            <td>
                                <label class="control-label" ng-bind="(item.parentLevelName)?(item.parentLevelName):'NONE'"></label>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row" ng-if="vm.moduleId && vm.heirarchyLevel.length==0">
                <div class="text-center map-div">
                    No records found to display for this module id.
                </div>
            </div>
        </div>
        <div class="col-sm-9 col-sm-offset-3 audit-details" ng-if="vm.moduleId && vm.heirarchyLevel.length>0">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.levelMasterDetails.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.levelMasterDetails.verifiedBy) ? (vm.levelMasterDetails.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.levelMasterDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.levelMasterDetails.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.levelMasterDetails.verifiedDate) ? (vm.levelMasterDetails.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>


        <div class="col-sm-12 text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton" ng-click="vm.deleteSubmit();"
                    ng-disabled="levelMasterForm.$invalid">Delete</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    ng-click="vm.goToPreviousState()">Cancel</button>
        </div>
        <div class="col-sm-12 text-center">
            <notice-message-directive></notice-message-directive>
        </div>

    </form>
</div>
