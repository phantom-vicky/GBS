        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.verifyDeleteLists.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.verifyDeleteLists.lastModifiedBy) ? (vm.verifyDeleteLists.lastModifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.verifyDeleteLists.verifiedBy) ? (vm.verifyDeleteLists.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.verifyDeleteLists.verifiedFlag  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.verifyDeleteLists.creatDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.verifyDeleteLists.modDate) ? (vm.verifyDeleteLists.modDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.verifyDeleteLists.verDate) ? (vm.verifyDeleteLists.verDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="vm.cbsBranchesOfOtherBankForm.$invalid" ng-click="vm.verifySubmit()">Verify</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    ng-click="vm.showCancelConfirmation('cbs_branches_of_other_bank.inquiry');">Cancel</button>

            <button type="button" class="btn btn-default" id="cbsReject" ng-click="vm.rejectReason()"  >Reject</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>



<div class="modal" id="permissionMappingDelete" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"> REJECTION REMARKS</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper">
                    <form name="permissionDelete" role="form">

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-2"></div>
                                <label class="control-label col-sm-3">Remarks</label>
                                <div class="col-sm-5">
                                    <select class="form-control list_wrapper" id="remarks[$index]"
                                            name="remarks[$index]"
                                            ng-model="vm.remarks" ng-init="vm.getRemarksList();" required>
                                        <option value="">Select</option>
                                        <option ng-repeat="item in vm.remarksList"
                                                name="{{item.subCode + parentIndex}}"
                                                id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">
                                            {{item.subCodeDescription}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-offset-5 col-sm-8 form_submit">
                            <button type="button" class="btn btn-default" data-bs-dismiss="modal"
                                    ng-disabled="permissionDelete.$invalid"
                                    ng-click="vm.deleteSubmit(vm.remarks)">
                                Submit
                            </button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
