<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper" ng-if="!vm.newValueDispay">
	<h4 class="form_heading  feature-heading">Instrument Details -
		Modify</h4>
	<form name="instrumentDetailsForm" role="form">
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="drCrIndicator" class="control-label">Debit or
						Credit Indicator</label>
				</div>
				<div class="col-sm-3">
					<select class="form-control" id="drCrIndicator"
							name="drCrIndicator" ng-model="vm.instrumentDetails.drCrIndicator1"
							required>
						<option ng-selected="{{vm.instrumentDetails.drCrIndicator == ''}}"
								value="">Select</option>
						<option
								ng-selected="{{vm.instrumentDetails.drCrIndicator == 'C'}}"
								value="C">Credit</option>
						<option
								ng-selected="{{vm.instrumentDetails.drCrIndicator == 'D'}}"
								value="D">Debit</option>
					</select>

				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="instrumentType" class="control-label">Type of
						Instrument</label>
				</div>
				<div class="col-sm-3">
					<select class="form-control" id="instrumentType"
							name="instrumentType"
							ng-init="vm.getInstrumentTypes();vm.instrumentDetails.instrumentType = vm.typeOfInstrumentList[0]"
							ng-model="vm.instrumentDetails.instrumentType" ng-change="vm.getModifyDetails()" required>
						<option
								ng-selected="{{vm.instrumentDetails.instrumentType == ''}}"
								value="">Select</option>
						<option ng-selected="{{x == vm.instrumentDetails.instrumentType}}"
								ng-repeat="(x,y) in vm.typeOfInstrumentList" value="{{x}}">{{y}}</option>
					</select>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="schemeCode" class="control-label">Scheme Code</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="schemeCode"
						   id="schemeCode" ng-model="vm.result.schemeCode"
						   maxlength="5" chars="alpha-numeric" readonly required>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText1" class="control-label">Additional
						Text1</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText1"
						   id="additionalText1" chars="alpha-numeric"
						   ng-model="vm.result.additionalText1" maxlength="40">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText2" class="control-label">Additional
						Text2</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText2"
						   id="additionalText2" chars="alpha-numeric"
						   ng-model="vm.result.additionalText2" maxlength="40">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">Additional
						Text3</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						   id="additionalText3" chars="alpha-numeric"
						   ng-model="vm.result.additionalText3" maxlength="40">
				</div>
			</div>
		</div>

		<div class="col-sm-12">
			<div class="audit-details" ng-if="vm.result.schemeCode">
				<div class="row">
					<div class="col-md-3">
						<span>
							<b> Created By </b> : {{vm.result.createdBy}}
						</span>
					</div>
					<div class="col-md-3">
						<span>
							<b> Last Modified By </b> : {{(vm.result.modifiedBy) ? (vm.result.modifiedBy) : ('None')}}
						</span>
					</div>
					<div class="col-md-3">
						<span>
							<b> Last Verified By </b> : {{(vm.result.verifiedBy) ? (vm.result.verifiedBy) : ('None')}}
						</span>
					</div>
					<div class="col-md-3">
						<span>
							<b> Verify Status </b> : {{vm.result.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}
						</span>
					</div>
				</div>
				<div class="row">
					<div class="col-md-3">
						<span>
							<b> Created On </b> : {{ vm.result.createdDate1 | date : 'dd/MM/yyyy'}}
						</span>
					</div>
					<div class="col-md-3">
						<span>
							<b> Last Modified On</b> : {{ (vm.result.modifiedDate1) ? (vm.result.modifiedDate1 | date : 'dd/MM/yyyy') : ('None')}}
						</span>
					</div>
					<div class="col-md-3">
						<span>
							<b> Last Verified On </b> : {{(vm.result.verifiedDate1) ? (vm.result.verifiedDate1 | date : 'dd/MM/yyyy') : ('None')}}
						</span>
					</div>
					<div class="col-md-3"></div>
				</div>
			</div>
		</div>

		<div class="row">
			<div class="text-center form_submit">

				<button type="submit" class="btn btn-default" id="submitButton"
						ng-disabled="instrumentDetailsForm.$invalid" ng-click="vm.modify()">Update</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
						ng-click="vm.showCancelConfirmation('instrument_details.modify');">Cancel</button>
			</div>
		</div>
		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>

<div class="container list_wrapper" ng-if="vm.recordsList.length <= 0">
	<h4 class="feature-heading">Instrument Details - Modify</h4>
	<div class="no_records_message">No records found to display.</div>
	<center>
		<button type="button" class="btn btn-default"
			ui-sref="instrument_details.list()">Back</button>
	</center>
</div>