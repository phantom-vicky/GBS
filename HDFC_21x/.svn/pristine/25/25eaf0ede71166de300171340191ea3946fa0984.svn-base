

<div class="container">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/dc';" id="homeButton">Home</button>
        <button type="submit" class="btn btn-default"
                id="printButton" ng-click="vm.printpage();">Print</button>
        <button type="button" id="cancelButton" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbibond_gu_functionality';">Back</button>
    </div>
    <div  style="border:1px; border-style:solid; border-color:#ddd; padding:2em;" class="text-justify" id="section-to-print">
        <table width="100%" border="0" cellspacing="0" cellpadding="1" align="center">
            <tr>
                <td  valign="top" height="0">
                    <table border="0" cellspacing="0" cellpadding="0" width="100%">
                        <tr align="center" valign="top" height="40">
                            <td colspan="4" >
                                <p><font face="Times New Roman" size="3"><b><sol-header></sol-header></b>
                                </font>
                                </p><br>
                            </td>
                        </tr>
                        <tr align="center" valign="top" height="40">
                            <td colspan="4" >
                                <p><font face="Times New Roman" size="3"><b>Declaration</b>
                                </font>
                                </p><br>
                            </td>
                        </tr>


                        <tr valign="top" align="left" height="40">
                            <td align="left" valign="middle" colspan="2" >
                                <p align="justify">
                                    <font face="Times New Roman" size="3">
                                        I_____________________mother of___________________________(minor) applied for
                                        ________________________________hereby declare as under.

                                    </font>
                                </p><br>
                                <p>* That the minor is in my exclusive care and custody.</p><br>
                                <p>* That the father of the minor is not in actual charge of the affairs of the minor because of his indifference/because of an agreement between him and me.</p><br>
                                <p>* That the father of the minor is unable to take care of the minor because of his physical and / mental capacity and that I am entitled to act as natural guardian of the minor.</p><br>
                                <p>* Strike whichever is not applicable.</p><br>
                            </td>
                        </tr>

                        <tr valign="top" height="40" align="left">

                            <td align="left" valign="middle" width="69%"><p><font face="Times New Roman" size="3">

                                Place&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:<br><br>
                                Date&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;:<br><br>
                            </font></p>
                            </td>

                            <td align="left" valign="middle" width="69%"><p style="text-align:left;"><font face="Times New Roman" size="3">

                                (Signature)<br><br>
                                Name<br><br>
                            </font></p>
                            </td>

                        </tr>
                        </tr>
                    </table>

        </table>

    </div>
</div>