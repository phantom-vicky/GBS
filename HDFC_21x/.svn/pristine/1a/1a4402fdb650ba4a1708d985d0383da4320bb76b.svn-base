                        <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                        <table class="table table-bordered">
                            <div class="col-md-12 map-div">
                                <input type="checkbox" id="birthCertificate" name="birthCertificate" value="KD001" ng-model="vm.customerMasterDetails.C055.oldValue" ng-checked="vm.customerMasterDetails.C055.oldValue">
                                <label for="birthCertificate">Birth Certificate</label><br>
                                <input type="checkbox" id="passport" name="passport"  ng-model="vm.customerMasterDetails.C056.oldValue" ng-checked="vm.customerMasterDetails.C056.oldValue">
                                <label for="passport">Passport</label><br>
                                <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" value="KD003" ng-model="vm.customerMasterDetails.C057.oldValue" ng-checked="vm.customerMasterDetails.C057.oldValue">
                                <label for="seniorCitizenCard">Senior Citizen Card</label><br>
                                <input type="checkbox" id="voterId" name="voterId" value="KD004" ng-model="vm.customerMasterDetails.C058.oldValue" ng-checked="vm.customerMasterDetails.C058.oldValue">
                                <label for="voterId">Voter ID Card</label><br>
                                <input type="checkbox" id="panCard" name="panCard" value="KD005" ng-model="vm.customerMasterDetails.C059.oldValue" ng-checked="vm.customerMasterDetails.C059.oldValue">
                                <label for="panCard">Pan Card</label><br>
                                <input type="checkbox" id="drivingLicence" name="drivingLicence" value="KD006" ng-model="vm.customerMasterDetails.C060.oldValue" ng-checked="vm.customerMasterDetails.C060.oldValue">
                                <label for="drivingLicence">Driving Licence</label><br>
                                <input type="checkbox" id="rationCard" name="rationCard" value="KD007" ng-model="vm.customerMasterDetails.C061.oldValue" ng-checked="vm.customerMasterDetails.C061.oldValue">
                                <label for="rationCard">Ration Card</label><br>
                                <input type="checkbox" id="others" name="others" value="KD008" ng-model="vm.customerMasterDetails.C062.oldValue" ng-checked="vm.customerMasterDetails.C062.oldValue">
                                <label for="others">Others</label><br>
                            </div>

                            <tr>
                                <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.C062.oldValue == true">
                                    <label class="control-label">Details for Others</label>
                                </td>
                                <td width="25%" ng-if="vm.customerMasterDetails.C062.oldValue == true">
                                    <input type="text" class="form-control"
                                           id="otherDetails" name="remarks"
                                           maxlength="120"
                                           ng-model="vm.customerMasterDetails.C041.oldValue" chars="only-letters" required>
                                </td>
                            </tr>
                            <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                <td width="25%" class="form-group">
                                    <label class="control-label">BLA Closure Date<br> (DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="blaClosureDateOne"
                                               name="blaClosureDateOne" ng-model="vm.customerMasterDetails.C053.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.blaClosureDateOne.opened" close-text="Close"
                                               maxlength="10" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.blaClosureDateOne.opened = true"
                                                            id="blaClosureDateOneOption">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C053.oldValue} "><label
                                        for="subscriberFirstName" class="control-label">BLA Closure Remarks</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C026" name="C026"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C054.oldValue"
                                                       ng-required="vm.customerMasterDetails.C053.oldValue"
                                                       chars="only-letters"></td>

                            </tr>
                            <tr>

                                <td width="25%" class="form-group">
                                    <label class="control-label">Remarks</label>
                                </td>
                                <td width="25%" >
                                    <input type="text" class="form-control"
                                           id="remarks" name="remarks"
                                           maxlength="30"
                                           ng-model="vm.customerMasterDetails.C042.oldValue" chars="only-letters">
                                </td>
                            </tr>
                        </table>

                    </ng-form>
                </div>

                <div uib-accordion-group id="joint-personal-details" class="panel"
                     heading="SECOND JOINT ACCOUNT HOLDER DETAILS"
                     is-open="vm.secondHolderDetails"
                     ng-class="(vm.secondJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.getDetails.masterDetailsValueModel.length >= 2">

                    <ng-form name="vm.customerPersonalDetailsTwo" >
                        <table class="table table-bordered">
                            <tbody>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Operative Account Number</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" ng-blur="vm.getSchemeTypeListOperativeTwo(vm.customerMasterDetailsTwo.C034.oldValue, 'acctNum')"
                                                       ng-model="vm.customerMasterDetailsTwo.C034.oldValue" required>
                                    <!--                                    <span class="alert-danger" ng-if="vm.errorMessage">Invalid Account Number</span>-->
                                    <span class="alert-danger" ng-if="vm.cbsErrorMessageTwo">{{vm.cbsErrorMessageTwo}}</span>
                                </td>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMasterDetailsTwo.gbmTransactionMasterDto.tranMode == 'T'}">
                                    <label for="tranSolId" class="control-label">Operative Account Branch Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="tranSolId"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetailsTwo.C035.oldValue" chars="alpha-numeric" readonly disabled required>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMaster.nriFlag == 'Y'}">
                                    <label for="cbsCustomerId" class="control-label">CBS CIF ID</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="cbsCustomerId" ng-disabled="vm.customerMasterDetails.blaAccNo!=null"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetailsTwo.C004.oldValue"
                                                   chars="alpha-numeric" oninput="this.value = this.value.toUpperCase()" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            <span class="alert-danger" ng-if="vm.errmsgSingle && vm.customerMaster.customerMasterDetailsTwo">{{vm.errmsgSingle}}</span>
                                        </div>

                                        <div class="col-sm-3" >
                                            <button ng-if="vm.customerMasterDetailsTwo.C004.oldValue" type="button" class="btn btn-default" id="cbsBtnTwo" ng-click="vm.getCbsCustFstJoinDetailsTwoModify();"
                                                    ng-disabled="vm.getDetails.verifiedStatus=='Y' || !vm.customerMasterDetailsTwo.C004.oldValue || !vm.customerMasterDetailsTwo.C034.oldValue || vm.cbsErrorMessageTwo">Fetch</button>
                                        </div>
                                    </div>
                                </td>

                                <td width="25%">
                                    <label class="control-label">Bond Ledger Account Number</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="blaNo"
                                                   name="blaNo"
                                                   ng-model="vm.customerMasterDetailsTwo.C005.oldValue" disabled>
                                        </div>
                                        <div class="col-sm-3 torch-top" ng-if="vm.getDetails.verifiedStatus=='N'" >
                                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                               ng-click="vm.getBlaAccNoDetailsTwoModify('torch');" id="blaNoSearcher"></i>
                                            <i class="glyphicon glyphicon-remove clear cp"
                                               ng-click="vm.customerMasterDetailsTwo.C005.oldValue='';vm.getClearAllData();" id="blaNoClose"></i>
                                        </div>
                                    </div>
<!--                                    <div class="row">-->
<!--                                        <div class="col-sm-8">-->
<!--                                            <input type="text" class="form-control" id="bondLedgerAccNumber"-->
<!--                                                   name="bondLedgerAccNumber"-->
<!--                                                   ng-model="vm.customerMasterDetailsTwo.C005.oldValue"-->
<!--                                                   chars="alpha-numeric" oninput="this.value = this.value.toUpperCase()" >-->
<!--                                        </div>-->

<!--                                        <div class="col-sm-3" >-->
<!--                                            <button type="button" class="btn btn-default" id="blaBtnTwo" ng-click="vm.getBlaAccNoDetailsTwoModify('torch');"-->
<!--                                            >Fetch</button>-->
<!--                                        </div>-->
<!--                                    </div>-->
                                </td>

                            </tr>
                            <tr>
                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Bond Holder First
                                    Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberFirstName" name="customerFirstName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsTwo.C006.oldValue"
                                                       ng-disabled="vm.operativeAc == 'Y'"
                                                       chars="only-letters"
                                                       required></td>
                                <td width="25%">Bond Holder Middle Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberMiddleName" name="customerMiddleName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsTwo.C007.oldValue" chars="only-letters">
                                </td>
                            </tr>
                            <tr>
                                <td width="25%">Bond Holder Last Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberLastName" name="customerLastName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsTwo.C008.oldValue" chars="only-letters">
                                </td>
                                <td width="25%" class="form-group required"><label
                                        class="control-label">Holder Type</label></td>
                                <td width="25%">
                                    <select class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                            ng-model="vm.customerMasterDetailsTwo.C009.oldValue" ng-change="vm.getValidations(vm.customerMasterDetailsTwo.C009.oldValue);"   maxlength="10" required>
                                        <option value="">Select</option>
                                        <!--                                        <option ng-repeat="item in vm.C009List" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                        <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                    </select>
                                </td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group required" ><label
                                        class="control-label">Is NRI ?</label></td>
                                <td width="25%">
                                    <select class="form-control" ng-change="vm.customerMasterDetailsTwo.C065.oldValue = ''"
                                            ng-model="vm.customerMasterDetailsTwo.C003.oldValue" required>
                                        <option value="">Select</option>
                                        <option value="Y">Yes</option>
                                        <option value="N">No</option>
                                    </select>
                                </td>

                                <td ng-if="vm.customerMasterDetailsTwo.C003.oldValue=='Y'" width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsTwo.C003.oldValue == 'Y'}">
                                    <label class="control-label">Date of Becoming NRI<br>(DD/MM/YYYY)</label></td>
                                <td width="25%" ng-if="vm.customerMasterDetailsTwo.C003.oldValue=='Y'" >
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfBecomingNriTwo"
                                               name="dateOfBecomingNriTwo"
                                               ng-model="vm.customerMasterDetailsTwo.C065.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dobCalenderOptions"
                                               is-open="vm.dateOfBecomingNriTwo.opened"
                                               close-text="Close" maxlength="10" readonly required>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfBecomingNriTwo.opened = true"
                                                    id="dateOfBecomingNriTwoBtn">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                            </tr>


                            <tr>
                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C010" name="C010"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsTwo.C010.oldValue"
                                                       chars="only-letters"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       required></td>
                                <td width="25%" class="form-group required">
                                    <label for="subscriberFirstName" class="control-label">Mother Name</label>
                                </td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C011" name="C011"
                                                       maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsTwo.C011.oldValue" chars="only-letters" required>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Gender</label></td>
                                <td width="25%"><select class="form-control" id="C012"
                                                        ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        name="state" ng-model="vm.customerMasterDetailsTwo.C012.oldValue"
                                                        ng-required="!vm.customerMasterDetailsTwo.C012.oldValue">
                                    <option value="" hidden="true">Select</option>
                                    <option value="M" >MALE</option>
                                    <option value="F" >FEMALE</option>
                                </select></td>

                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Is Minor (Y/N)?</label></td>
                                <td width="25%"><select class="form-control" id="C014"
                                                        ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        ng-change="vm.customerMasterDetailsTwo.C013.oldValue=''"
                                                        name="C014" ng-model="vm.customerMasterDetailsTwo.C014.oldValue"
                                                        required>
                                    <option value="" hidden="true">Select</option>
                                    <option value="Y"  ng-selected="vm.customerMasterDetailsTwo.C014.oldValue == 'Y'">YES</option>
                                    <option value="N" ng-selected="vm.customerMasterDetailsTwo.C014.oldValue == 'N'">NO</option>
                                </select></td>





                            </tr>
                            <tr>




                                <td width="25%" class="form-group required">
                                    <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                               name="dateofBirth"
                                               ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="vm.customerMasterDetailsTwo.C013.oldValue"
                                               ng-change="vm.checkAge(vm.customerMasterDetailsTwo.C014.oldValue, vm.customerMasterDetailsTwo.C013.oldValue,'modify','2')"

                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.dateOptions.opened"
                                               close-text="Close" maxlength="10" readonly required>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
