<div class="row" >
				<div class="col-sm-7"></div>
				<label  ng-if="vm.newValueDispay == false" class="control-label col-sm-5"><b>Verify Status : Y</b></label>
				<label  ng-if="vm.newValueDispay == true" class="control-label col-sm-5"><b>Verify Status : N</b></label>
			</div>

	<div class="text-center form_submit">
		<button type="button" id="cancelButton" class="btn btn-cancel"
			onclick="window.location.href ='#!/';">Back</button>
	</div>
</div>

