		display: block;
		float: left;
		line-height: 37px;
		margin: 0;
		outline: medium none;
		overflow: hidden;
		padding: 0px 0;
		position: relative;
		color: @color;
		transition: width 0.15s ease-in-out 0s;
		width: 100px;
		z-index: 100030;
		text-decoration: none;
	}*/
.selectedDivSpan {
  float: left !important;
  display: block !important;
  margin-left: 3% !important;
  padding-top: 5px !important;
}
.left-menu-item{
 /*height: 35px;*/
}
.atss a div {
 /* font-size: 16px;*/
}
.atss a div span {
  display: none;
}
.atss a:hover div span,
.atss a .active div span {
  display: block;
  font-size: 15px;
  float: left;
  padding-left: 4%;
  background: #ddd;
  line-height: 35px;
  color: #337ab7;
  width: 94px;
}
.atss .leftMenuActive div span {
  display: block;
  background-color: #ddd;
  font-size: 15px;
  float: left;
  padding-left: 4%;
  line-height: 35px;
  width: 94px;
}
.atss .leftMenuActive div i {
  float: left;
  width: -1%;
}
/*
.atss a:hover div {
  font-size: 15px;
}

*/
.atss a div i {
  background-color: #ddd;
  background-color: #ddd;
  padding: 0px 8px;
  font-size: 19px;
  width: 20%;
  color: #337ab7;
  line-height: 35px;
}
/*.fa.fa-pencil-square-o {
    font-size: 21px;
}*/
li {
  list-style: none;
}
/*side menu End*/
@media screen and (max-width: 600px) {
  .atss-right {
    margin-top: 14%;
  }
}
.caret-up {
  width: 0;
  height: 0;
  border-left: 4px solid rgba(0, 0, 0, 0);
  border-right: 4px solid rgba(0, 0, 0, 0);
  border-bottom: 4px solid;
  display: inline-block;
  margin-left: 2px;
  vertical-align: middle;
}
.help-block {
  position: absolute;
  z-index: 999;
}
/* enable absolute positioning */
