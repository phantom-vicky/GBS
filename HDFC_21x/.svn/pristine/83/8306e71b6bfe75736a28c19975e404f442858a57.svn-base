                                        (vm.getDetails.masterDetailsValueModel[0].C016.oldValue | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C016? (vm.getDetails.masterDetailsValueModel[0].C016.newValue | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}}
