            </tr>
            <tr ng-if="item.C014.oldValue=='Y' || item.C014.newValue == 'Y'">
                <td>Relation of Guardian with Minor</td>
                <td class="old-value">{{(item && item.C030)?
                    (item.C030.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsList)) : ('-')}}
                </td>
                <td class="new-value"
                    ng-if="vm.verificationDetails == 'M'" ng-class="{ 'text-danger fw-bold': item.C030.oldValue != item.C030.newValue&& item.C030.newValue}">
                    {{ (item && item.C030)?
                    ((item.C030.oldValue == item.C030.newValue)
                    ? '-'
                    : (item.C030.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsList)))
                    : '-' }}
                </td>
            </tr>
            <tr>
                <td>Nominee Status</td>
                <td class="old-value">
                    {{(item && item.C029) ? vm.getNomineeStatusDescription(item.C029.oldValue) : ''}}
                </td>
                <td class="new-value" ng-if="vm.verificationDetails == 'M'" ng-class="{ 'text-danger fw-bold': item.C029.oldValue != item.C029.newValue&& item.C029.newValue}">
                    {{(item && item.C029) ? vm.getNomineeStatusDescription(item.C029.newValue) : ''}}
                </td>
            </tr>
            </tbody>
            <tr ng-if="vm.nomineeList1.length>0">
                <td>Total (%)</td>
                <td>100</td>
            </tr>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.modifiedBy) ? (vm.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.verifiedBy) ? (vm.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.createdDate | date : 'dd-MM-yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.modifiedDate) ? (vm.modifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.verifiedDate) ? (vm.verifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="sumitButton" ng-click="vm.verifyDetails()">Verify</button>
            <button type="submit" class="btn btn-default" id="sumitButton" ng-click="vm.rejectReason()">Reject</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/bond_nominations/action/inquiry';">
                Close
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>
