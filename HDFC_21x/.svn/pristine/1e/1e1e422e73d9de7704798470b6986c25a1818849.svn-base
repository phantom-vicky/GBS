                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C012.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C012)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C012.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text1</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C013)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C013.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C013)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C013.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Additional Text2</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C014)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C014.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C014)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C014.newValue) : ('')}}
