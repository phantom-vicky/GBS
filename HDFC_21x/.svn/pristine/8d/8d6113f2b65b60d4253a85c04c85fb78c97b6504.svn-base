<div class="container from_wrapper">
<left-menu-directive></left-menu-directive>
	<h4 class="form_heading">CBS Integration Bulk Upload Verify</h3>
	<notice-message-directive></notice-message-directive>
	<form name="cbsVerifyForm" role="form" ng-submit="submitForm(cbsVerifyForm.$valid)" enctype="multipart/form-data" novalidate>
			<div class="row">
				<div class="form-group required">
				  	<div class="col-sm-3"></div>
				  	<label for="functionality" class ="control-label col-sm-3">Functionality</label>
					<div class="col-sm-3">
						<select class="form-control" name="functionality" ng-model="cbsVerify.functionality" ng-dropdown required ng-change="getUnverifiedFiles()" >
							<option value="">Select Functionality</option>
							<option value="bankbranch">Branches of the Bank</option>
							<option value="officeaccountplaceholder">Office account Placeholder</option>
							<option value="instruments">Instrument Details</option>
							<option value="transactioncodes">List of Transaction Codes</option>	
							<option value="otherbankdetails">Other Bank details </option>
							<option value="otherbankbranches">Branches of Other Bank</option>
							<option value="calendarentries">Maintenance of Calendar Entries</option>
							<option value="schemecodes">Scheme Codes</option>
							<option value="userdetails">User Work Class Information</option>
							<option value="branchifscdetails">Branch IFSC Codes</option>		 
						</select>
					</div>
					<div class="col-sm-1">
						<img ng-if="functionalityDataLoading" src="data:image/gif;base64,"/>
					</div>
				</div>
				</div>
				
				<div class="row">
				<div class="form-group required">
				  <div class="col-sm-3"></div>
				  <label for="functionality" class ="control-label col-sm-3">Unverified File</label>
					<div class="col-sm-3">
						<select class="form-control" id="unverifiedFile" name="unverifiedFile" ng-model="cbsVerify.unverifiedFile" ng-dropdown required >
							<option  ng-selected= "{{y == cbsVerify.unverifiedFile}}" ng-repeat="(x,y) in unverifiedFileList" value="{{y}}">{{y}}</option> 
						</select>
					</div>
				</div>
				</div>
			
	 <div class="col-sm-offset-5 col-sm-8 form_submit">
		 <button type="submit" class="btn btn-default" id="cbsVerifySubmit"  ng-disabled="cbsVerifyForm.$invalid" ng-click="showContent=true" >Submit</button>
		 <button type="submit" class="btn btn-cancel"  id="cancelButton" ng-click="moveTo()">Cancel</button>
		 <img ng-if="fileDataLoading" src="data:image/gif;base64,"/>
	   </div>
	</form>
</div>



<div class="container list_wrapper" ng-show="showContent">
	<div class="row">
		<div class="col-sm-3">
			<div class="form-group">
				<label>
				Show 
					<select class="form-control record-filter" ng-model="itemsPerPage" id="itemsPerPage" name="itemsPerPage" >
						<option ng-selected="{{itemsPerPage == 5}}" value="5">5</option>
						<option ng-selected="{{itemsPerPage == 10}}" value="10">10</option>
						<option ng-selected="{{itemsPerPage == 25}}" value="25">25</option>
						<option ng-selected="{{itemsPerPage == 50}}" value="50">50</option>
					</select>
				records per page
				</label>
			</div>
		</div>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'instruments'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Dr Cr Indicator</th>
					<th>Instrument Type</th>
					<th>Scheme Code</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.drCrIndicator}}</td>
					<td>{{item.instrumentType}}</td>
					<td>{{item.schemeCode}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'officeaccountplaceholder'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>BACID</th>
					<th>BACID Description</th>
					<th>Scheme Type</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.bacid}}</td>
					<td>{{item.bacidDesc}}</td>
					<td>{{item.schmType}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'bankbranch'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>SOL_ID</th>
					<th>SOL_DESC</th>
					<th>BANK_CODE</th>
					<th>BR_CODE</th>
					<th>PIN_CODE</th>
					<th>PAN_GIR_NO</th>
					<th>TAX_DEDN_DETAILS</th>
					<th>TDS_CIRCLE_NAME</th>
					<th>DIVISION_NAME</th>
					<th>CIRCLE_OFFICE_NAME</th>
					<th>UNIFORM_BR_CODE</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.solId}}</td>
					<td>{{item.solDesc}}</td>
					<td>{{item.bankCode}}</td>
					<td>{{item.branchCode}}</td>
					<td>{{item.pinCode}}</td>
					<td>{{item.panGirNumber}}</td>
					<td>{{item.taxDednDetails}}</td>
					<td>{{item.tdsCircleName}}</td>
					<td>{{item.divisionName}}</td>
					<td>{{item.circlOfficeName}}</td>
					<td>{{item.uniformBrCode}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'transactioncodes'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>CLG Trans Code</th>
					<th>CLG Trans Code Description</th>
					<th>Instrument Type</th>
					<th>Scheme Code</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.clgTranCode}}</td>
					<td>{{item.clgTranCodeDesc}}</td>
					<td>{{item.instrumentType}}</td>
					<td>{{item.schemeCode}}</td>
					<td>{{item.addText1}}</td>
					<td>{{item.addText2}}</td>
					<td>{{item.addText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'otherbankdetails'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Bank Code</th>
					<th>Bank Name</th>
					<th>Bank Short Name</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.bankCode}}</td>
					<td>{{item.bankName}}</td>
					<td>{{item.bankShortName}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'branchifscdetails'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Bank Code</th>
					<th>Branch Code</th>
					<th>Bank Identifier</th>
					<th>PAYSYS Id</th>
					<th>Delete Flag</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.bankCode}}</td>
					<td>{{item.branchCode}}</td>
					<td>{{item.bankIdentifier}}</td>
					<td>{{item.paysysId}}</td>
					<td>{{item.deleted}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'otherbankbranches'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Branch Code</th>
					<th>Bank Code</th>
					<th>MICR Centre Code</th>
					<th>MICR Bank Code</th>
					<th>MICR Branch Code</th>
					<th>Address 1</th>
					<th>Address 2</th>
					<th>Address 3</th>
					<th>City Code</th>
					<th>State Code</th>
					<th>Pincode</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.branchCode}}</td>
					<td>{{item.bankCode}}</td>
					<td>{{item.micrCentreCode}}</td>
					<td>{{item.micrBankCode}}</td>
					<td>{{item.micrBranchCode}}</td>
					<td>{{item.branchAddr1}}</td>
					<td>{{item.branchAddr2}}</td>
					<td>{{item.branchAddr3}}</td>
					<td>{{item.branchCityCode}}</td>
					<td>{{item.branchStateCode}}</td>
					<td>{{item.branchPinCode}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'schemecodes'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Scheme Code</th>
					<th>Description</th>
					<th>GL Sub Head Code</th>
					<th>Scheme Type</th>
					<th>Additional Text1</th>
					<th>Additional Text2</th>
					<th>Additional Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.schemeCode}}</td>
					<td>{{item.description}}</td>
					<td>{{item.glSubHeadCode}}</td>
					<td>{{item.schemeType}}</td>
					<td>{{item.addText1}}</td>
					<td>{{item.addText2}}</td>
					<td>{{item.addText3}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'calendarentries'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>Calendar Type</th>
					<th>Calendar Code</th>
					<th>Month/Year</th>
					<th>Delete Flag</th>
					<th>Holiday String</th>
					<th>Status</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.calendarType}}</td>
					<td>{{item.calendarCode}}</td>
					<td>{{item.monthYear}}</td>
					<td>{{item.deleteFlag}}</td>
					<td>{{item.holidayString}}</td>
					<td>{{item.status}}</td>
					<td>{{item.createdDate | date: 'dd-MM-y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	<div class="table-responsive" ng-if="cbsVerify.functionality == 'userdetails'">
		<table class="table table-bordered table-striped list">
			<thead>
				<tr>
					<th>User Id</th>
					<th>Deleted</th>
					<th>User Work Class</th>
					<th>Sol Id</th>
					<th>User Sol Tenor</th>
					<th>User Max Inactive Time</th>
					<th>User Account Expiry Date</th>
					<th>User Password Expiry Date</th>
					<th>User Application Name</th>
					<th>New User Flag</th>
					<th>Default Term Id</th>
					<th>Virtual Flag</th>
					<th>Text1</th>
					<th>Text2</th>
					<th>Text3</th>
					<th>Created Date</th>
				</tr>
			</thead>
			<tbody>
				<tr ng-repeat="item in items |
       							offset: currentPage*itemsPerPage |
        						limitTo: itemsPerPage">
					<td>{{item.userId}}</td>
					<td>{{item.deleted}}</td>
					<td>{{item.userWorkClass}}</td>
					<td>{{item.solId}}</td>
					<td>{{item.userSolTenor}}</td>
					<td>{{item.userMaxInactiveTime}}</td>
					<td>{{item.userAccountExpiryDate | date: 'dd/MM/y'}}</td>
					<td>{{item.userPasswordExpiryDate | date: 'dd/MM/y'}}</td>
					<td>{{item.userApplicationName}}</td>
					<td>{{item.newUserFlag}}</td>
					<td>{{item.defaultTermId}}</td>
					<td>{{item.virtualFlag}}</td>
					<td>{{item.additionalText1}}</td>
					<td>{{item.additionalText2}}</td>
					<td>{{item.additionalText3}}</td>
					<td>{{item.createdDate | date: 'dd/MM/y'}}</td>
				</tr>
			</tbody>
		</table>
	</div>
	
	

	<div class="pagination-custom">
		<ul>
			<li ng-class="prevPageDisabled()"><a href ng-click="prevPage()">Prev</a>
			</li>
			<li><b>{{currentPage+1}}</b> of {{pageCount()+1}}</li>
			<li ng-class="nextPageDisabled()"><a href ng-click="nextPage()">Next
			</a></li>
		</ul>
	</div>
	<div class="col-sm-offset-5 col-sm-8 form_submit">
	 <button type="submit" class="btn btn-default" id="cbsVerify" ng-click="cbsVerify()" ng-class="buttonsDisabled()">Verify</button>
	 <button type="submit" class="btn btn-default" id="cbsDelete" ng-click="cbsDelete()">Delete</button>
	 <button type="submit" class="btn btn-cancel" id="cbsCancel" ng-click="initiateFunction()">Cancel</button>
	 <img ng-if="commonDataLoading" src="data:image/gif;base64,"/>
   </div>
</div> 


	
