                        ng-model="vm.cbdtSchemeParameter.C030.oldValue" required />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Service Charges (for year April - March) for New BLA Accounts
                        Rs.</label>
