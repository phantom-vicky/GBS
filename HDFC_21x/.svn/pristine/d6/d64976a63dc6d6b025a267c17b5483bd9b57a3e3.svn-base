
<div class="container from_wrapper new_form_wrapper">
    <div class="loader-new" ng-if="vm.loader"></div>

    <h4 class="form_heading">Bond Interest NOT Calculated Report</h4>
    <sol-header></sol-header>
    <form name="bondintersetcalculatedFrom" role="form">



        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control"
                               id="schemeCode"
                               ng-model="vm.schemeName"
                               chars="alpha-numeric" readonly required/>

                    </p>
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       ng-click="vm.getModuleName();"></i>
                    <i class="glyphicon glyphicon-remove clear cp"
                       ng-click="vm.schemeName ='';vm.schemeCode = '';vm.monthIn=''; vm.financialYear=''"></i>
                </div>
            </div>
        </div>


        <!--Month -->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Interest payment  for</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="month" name="month" ng-model="vm.monthIn" ng-init="vm.monthIn=''"required>
                        <option value="">Select</option>
<!--                        <option ng-repeat="item in vm.monthIns" value="{{item.month}}" data-ng-bind="item.month"></option>-->
                        <option value="JAN">JAN</option>
                        <option value="JUL">JUL</option>
                    </select>
                </div>
            </div>
        </div>

        <!--Year -->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Financial Year</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="financialYear" name="financialYear" ng-model="vm.financialYear" data-ng-change="vm.setFinancialYear(vm.financialYear)" required>
                        <option value="">Select</option>
                        <option ng-repeat="item in vm.financialYears" value="{{item.finYear}}" data-ng-bind="item.finYear"></option>
                    </select>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default"
                    ui-sref="Bond_Interest_NOT_Calculated_Report_collecting_branch.inquiry_details({obj:{
                            branchId:vm.branchId,
                            interestPaid:vm.monthIn,
                            financialYear:vm.financialYear,
                             schemeCode:vm.schemeCode,
                             schemeName: vm.schemeName
                        }})"
                    ng-disabled="bondintersetcalculatedFrom.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>


    <!-- Scheme Name-->
    <div class="modal" id="schemeModel" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-bs-dismiss="modal" ng-click="vm.searchSolId=''">&times;</button>
                    <h4 class="modal-title">SCHEME CODE</h4>
                </div>
                <div class="modal-body">
                    <div class="loader_popup"></div>
                    <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                        <div class="col-sm-8 form_submit">
                            <div class="form-group">
                                <div class="input-group">
                                    <div class="input-group-addon">
                                        <i class="glyphicon glyphicon-search"></i>
                                    </div>
                                    <input type="text" class="form-control"
                                           ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                           placeholder="Search"  oninput = "this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4 form_submit"></div>
                        <div class="row">

                            <div class="col-sm-12">
                                <table class="table table-bordered list scroll sort">
                                    <thead ng-init="reverseOrder=false;sortedColumn = 'subCode'">
                                    <tr>
<!--                                        <th class="modal-title title-case" ng-show="false">Scheme Code</th>-->
                                        <th ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Name</th>
                                        <th ng-click="(sortedColumn == 'status')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'status';" ng-class="(sortedColumn == 'status')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Status</th>

                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr class="cp"
                                        ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                        ng-click="vm.schemeCode= x.schemeCode;vm.schemeName= x.schemeName; vm.getMonth(); vm.getFinancialYear();" data-bs-dismiss="modal">

                                        <td>{{x.schemeName}}</td>
                                        <td >{{x.schemestatus}}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
                </div>

            </div>
        </div>
    </div>

</div>

