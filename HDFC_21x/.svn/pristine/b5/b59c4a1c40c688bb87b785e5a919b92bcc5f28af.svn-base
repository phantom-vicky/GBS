<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper" ng-init="vm.getSubCodeList();">

    <h4 class="form_heading">Bond Brokerage payment - Delete</h4>
    <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-4">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Broker Agency Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerId"
                           ng-model="vm.brokerId"
                           chars="alpha-numeric" disabled required>
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="treasurySearch"
                       ng-click="vm.verifySelectBrokerTorch();"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.brokerId =''; vm.gbsTranId = '';"></i>
                </div>
            </div>
        </div>

        <div class="row" ng-if="vm.brokerId">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">GBS Tran Id</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="gbsTranId"
                           ng-model="vm.gbsTranId"
                           chars="alpha-numeric" disabled required>
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="treasurySearch1"
                       ng-click="vm.verifyGbsTranIDTorch();"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.gbsTranId =''; vm.schemeCode = ''; vm.fromDate = ''; vm.toDate = '';"></i>
                </div>
            </div>
        </div>

        <div class="row" ng-if="vm.gbsTranId" ng-init="vm.getModuleName();">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="schemeCode" name="schemCode"
                            ng-model="vm.schemeCode"  ng-change="vm.alert(vm.schemeCode)"
                            disabled required>
                        <option value="">Select</option>
                        <option ng-repeat="item in vm.schemeList" value="{{item.subCode}}" ng-bind="item.subCodeDescription"></option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row" ng-if="vm.gbsTranId">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Brokerage Payment from Date</label>
                </div>
                <div class="col-sm-4">
                    <label><b>{{vm.fromDate}}</b></label>
                </div>
            </div>
        </div>

        <div class="row" ng-if="vm.gbsTranId">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Brokerage Payment to Date</label>
                </div>
                <div class="col-sm-4">
                    <label><b>{{vm.toDate}}</b></label>
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="rbi_bnd_brk_payment.delete_detail({obj:{
                               schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								brokerId: vm.brokerId,
								gbsTranId: vm.gbsTranId,
								fromDate: vm.fromDate,
								toDate: vm.toDate,
								}})"
                    ng-disabled="accountOpeningForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbi_bnd_brk_payment/action/inquiry';">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


<!--brokerModal Modal-->
<div class="modal" id="brokerModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Broker List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.brokerTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchId';" ng-class="(sortedColumn == 'branchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Id</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';" ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Agency Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';" ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';" ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verified status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.brokerTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.brokerId = x.brokerAgencyCode;" data-bs-dismiss="modal">
                                    <td>{{x.branchId}}</td>
                                    <td>{{x.brokerAgencyCode}}</td>
                                    <td>{{x.brokerName}}</td>
                                    <td>{{x.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.brokerTorchList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<!--gbmTranIdList modal-->
<div class="modal" id="gbsTranModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">GBS Tran Id List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.gbsTranIdTorchList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';" ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Agency Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'gbsTranId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'gbsTranId';" ng-class="(sortedColumn == 'gbsTranId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">GBS Tran Id</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerAmount')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAmount';" ng-class="(sortedColumn == 'brokerAmount')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Brokerage  Amount</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';" ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verified Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.gbsTranIdTorchList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.brokerId = x.brokerAgencyCode;
                                     vm.gbsTranId = x.gbsTranId;
                                      vm.schemeCode = x.schemeCode;
                                       vm.fromDate = x.fromDate;
                                        vm.toDate = x.toDate;" data-bs-dismiss="modal">
                                    <td>{{x.brokerAgencyCode}}</td>
                                    <td>{{x.gbsTranId}}</td>
                                    <td>{{x.brokerAmount}}</td>
                                    <td>{{x.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.gbsTranIdTorchList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>