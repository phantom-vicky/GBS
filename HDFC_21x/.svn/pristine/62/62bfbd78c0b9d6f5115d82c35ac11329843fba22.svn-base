                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C015.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C015)?
