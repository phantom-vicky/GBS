<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Branches of Other Bank - Delete</h4>
    <sol-header></sol-header>
    <form name="cbsBranchesOfOtherBankForm" role="form">

        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th>Particular</th>
                <th>{{(vm.verifyDeleteLists.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.verifyDeleteLists.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td>Bank Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C002)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C002.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue &&
                    vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C002)? (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C002.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C001)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C001.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C001)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C001.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>MICR Center Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C003.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C003)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>MICR Bank Code</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C004)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C004.oldValue) : ('')}}
