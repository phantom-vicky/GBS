package com.isl.gbm.cbs.integration.dto.wrapper;

import com.isl.gbm.cbs.integration.dto.GbmUserDetailsDto;
import com.isl.gbm.common.audit.log.dto.AuditLogDto;

public class GbmUserDetailsDtoAuditLogWrapper {

    private GbmUserDetailsDto dto;

    private AuditLogDto auditLogDto;

    public GbmUserDetailsDto getDto() {
        return dto;
    }

    public void setDto(GbmUserDetailsDto dto) {
        this.dto = dto;
    }

    public AuditLogDto getAuditLogDto() {
        return auditLogDto;
    }

    public void setAuditLogDto(AuditLogDto auditLogDto) {
        this.auditLogDto = auditLogDto;
    }

}
