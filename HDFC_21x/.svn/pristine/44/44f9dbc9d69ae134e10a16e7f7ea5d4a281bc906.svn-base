                    <input type="text" class="form-control" id="cgstRate" ng-keypress="vm.percentageCheckNew($event);"
                        ng-change="vm.percentageCheckChange(vm.cbdtSchemeParameter.C042,'C042');"
                        ng-model="vm.cbdtSchemeParameter.C042.oldValue" limit-to="5" required />
                </div>
            </div>
        </div>
