package com.isl.gbm.user.management.dto;

public class UserDetailsValidationDTO {

    private Boolean isActivationPeriodExpired;

    private Boolean isDormant;

    private Boolean isUserExpied;

    private Boolean isUserBlockTimeOver;
    private boolean userInactiveNoLoginAttemptEver;

    public boolean isUserInactiveNoLoginAttemptEver() {
        return userInactiveNoLoginAttemptEver;
    }

    public void setUserInactiveNoLoginAttemptEver(boolean userInactiveNoLoginAttemptEver) {
        this.userInactiveNoLoginAttemptEver = userInactiveNoLoginAttemptEver;
    }

    public Boolean getUserBlockTimeOver() {
        return isUserBlockTimeOver;
    }

    public void setUserBlockTimeOver(Boolean userBlockTimeOver) {
        isUserBlockTimeOver = userBlockTimeOver;
    }

    public Boolean getUserExpied() {
        return isUserExpied;
    }

    public void setUserExpied(Boolean userExpied) {
        isUserExpied = userExpied;
    }

    public Boolean getDormant() {
        return isDormant;
    }

    public void setDormant(Boolean dormant) {
        isDormant = dormant;
    }

    public Boolean getActivationPeriodExpired() {
        return isActivationPeriodExpired;
    }

    public void setActivationPeriodExpired(Boolean activationPeriodExpired) {
        isActivationPeriodExpired = activationPeriodExpired;
    }
}
