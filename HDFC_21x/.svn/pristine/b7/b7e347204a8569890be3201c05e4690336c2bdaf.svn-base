package com.isl.gbm.rbibond.externalservice.dto;

import com.fasterxml.jackson.annotation.JsonProperty;

import java.io.Serializable;

public class AccountValidationRequestDTO implements Serializable {

    @JsonProperty("FetchCustomerAccountAmlFatcaDetailsRequestDTO")
    private FetchCustomerAccountAmlFatcaDetailsRequestDTO fetchCustomerAccountAmlFatcaDetailsRequestDTO;
    @JsonProperty("sessionContext")
    private SessionContextDTO sessionContext;

    public FetchCustomerAccountAmlFatcaDetailsRequestDTO getFetchCustomerAccountAmlFatcaDetailsRequestDTO() {
        return fetchCustomerAccountAmlFatcaDetailsRequestDTO;
    }

    public void setFetchCustomerAccountAmlFatcaDetailsRequestDTO(FetchCustomerAccountAmlFatcaDetailsRequestDTO fetchCustomerAccountAmlFatcaDetailsRequestDTO) {
        this.fetchCustomerAccountAmlFatcaDetailsRequestDTO = fetchCustomerAccountAmlFatcaDetailsRequestDTO;
    }

    public SessionContextDTO getSessionContext() {
        return sessionContext;
    }

    public void setSessionContext(SessionContextDTO sessionContext) {
        this.sessionContext = sessionContext;
    }

    @Override
    public String toString() {
        return "AccountValidationRequestDTO{" +
                "fetchCustomerAccountAmlFatcaDetailsRequestDTO=" + fetchCustomerAccountAmlFatcaDetailsRequestDTO +
                ", sessionContext=" + sessionContext +
                '}';
    }
}
