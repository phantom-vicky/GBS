package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class CrisTranReportReqDTO {

            private String fromDate;
            private String toDate;
            private String tranStatus;
            private String debitBankAccountNo;
            private String creditBankAccountNo;
            private String fileFormat;

    public String getFromDate() {
        return fromDate;
    }

    public void setFromDate(String fromDate) {
        this.fromDate = fromDate;
    }

    public String getToDate() {
        return toDate;
    }

    public void setToDate(String toDate) {
        this.toDate = toDate;
    }

    public String getTranStatus() {
        return tranStatus;
    }

    public void setTranStatus(String tranStatus) {
        this.tranStatus = tranStatus;
    }

    public String getDebitBankAccountNo() {
        return debitBankAccountNo;
    }

    public void setDebitBankAccountNo(String debitBankAccountNo) {
        this.debitBankAccountNo = debitBankAccountNo;
    }

    public String getCreditBankAccountNo() {
        return creditBankAccountNo;
    }

    public void setCreditBankAccountNo(String creditBankAccountNo) {
        this.creditBankAccountNo = creditBankAccountNo;
    }

    public String getFileFormat() {
        return fileFormat;
    }

    public void setFileFormat(String fileFormat) {
        this.fileFormat = fileFormat;
    }
}
