        <div id="reversalForm"   ng-show="vm.tabReferenceInq  =='reversalForm'" class="tab-pane in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="reversalForm" role="form" novalidate>
                        <div uib-accordion-group id="satreasury-details1" class="panel" heading="BOND HOLDER REVERSAL DETAILS" is-open="true" ng-class="(vm.treasuryDetailsForm.$invalid) ? 'panel-danger' : 'panel-default'">
                            <ng-form name="vm.treasuryDetailsForm">
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" >
                                            <label  class="control-label">Module Name</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">RBI Bond</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label required">Name of the Bond Scheme</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="schemeCode"
                                                           ng-model="vm.schemeName"
                                                           chars="alpha-numeric" readonly required>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label for="bondHolderName" class="control-label">Bond Holder Name</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"  maxlength="50"
                                                   id="bondHolderName" name="bondHolderName" ng-model="vm.reversalObj.bondHolderName" chars="only-character" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" disabled>
                                        </td>
                                        <td width="25%"><label for="panNum" class="control-label">PAN No</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="panNum" ng-model="vm.reversalObj.panNum"
                                                           chars="alpha-numeric" oninput="this.value = this.value.replace(/\s+/g, '')" disabled></div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label required">Mode of Holding</label>
                                        </td>
                                        <td width="25%">
                                            <label class="data-bind">{{vm.selectedModeOfHolding}}</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label required">From BLA Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="fromBlaNo" ng-model="vm.reversalObj.fromBlaNo"
                                                           oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                                           chars="only-numbers" minlength="5" maxlength="20" required disabled></div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label required">To BLA Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="toBlaNo" ng-model="vm.reversalObj.toBlaNo"
                                                           chars="only-numbers" minlength="5" maxlength="20" required disabled>
                                                </div>
                                            </div>
                                        </td>
                                        <td width="25%">
                                            <label for="count" class="control-label">Subscription Count</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="count" maxlength="50" name="count" ng-model="vm.reversalObj.count" disabled>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label for="remarks" class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%">
                                            <textarea class="form-control" rows="3" id="remarks" maxlength="50" name="remarks" ng-model="vm.reversalObj.remarks" required disabled></textarea>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </ng-form>
                            <div class="table-responsive" ng-if="vm.subscriptionIdList.length>0">
                                <table class="table table-bordered table-striped list table-textWrap align-middle">
                                    <thead>
                                    <tr class="thalign">
                                        <th>S.No</th>
                                        <th>From Subscription Id</th>
                                        <th>To Subscription Id</th>
                                        <th>Subscription Date</th>
                                        <th>Subscription Amount</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr ng-repeat="x in vm.subscriptionIdList">
                                        <td align="center">{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                                        <td align="center">{{x.subscriptionId}}</td>
                                        <td align="center">{{x.toSubscriptionId}}</td>
                                        <td align="center">{{x.subscriptionDate}}</td>
                                        <td align="center">{{vm.indianNumberFormat(x.subscriptionAmt)}}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="text-center form_submit">
                            <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/Joint_type_change_Three_to_two/action/inquiry';">Cancel</button>
                        </div>
                    </form>
                </uib-accordion>
            </div>
        </div>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-4">
                    <span> <b> Created By </b> : {{vm.getDetails.createdBy}} </span>
                </div>
                <div class="col-md-4">
                    <span> <b> Last Verified By </b> : {{(vm.getDetails.lastVerifiedBy) ? (vm.getDetails.lastVerifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-4">
                    <span> <b> Verify Status </b> : {{vm.getDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <span> <b> Created On </b> : {{ vm.getDetails.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-4">
                    <span> <b> Last Verified On </b> : {{(vm.getDetails.lastVerifiedDate) ? (vm.getDetails.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-4">
                </div>
            </div>
        </div>
    </div>
</div>
