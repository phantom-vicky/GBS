.messages {
  font-size: smaller;
  padding-top: 5px;
  padding-bottom: 10px;
  color: red;
}

.has-error .form-control{
      border-color: red;
}

.panel:has(.ng-invalid) .panel-heading{
	color: blue !important;
}

.form-control.ng-invalid{
	border-color: red;
}

.report-title-table>tbody>tr>td,
.report-title-table>tbody>tr>th,
.report-title-table>tfoot>tr>td,
.report-title-table>tfoot>tr>th,
