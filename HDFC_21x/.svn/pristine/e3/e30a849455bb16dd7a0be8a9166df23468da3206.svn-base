package com.isl.gbm.rbibond.dto.scrolls;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class RedemptionTextFileDto {
    private String schemeCode;
    private String schemeName;
    private String schemeStatus;
    private String fromDate;
    private String toDate;
    private String flag;
    private String number;
    
    // Covering Letter fields
    private String bondType;
    private String interestAmount;
    private String investmentAmount;
    private String cumulativePrincipal;
    private String nonCumulativePrincipal;
    private String grandTotalPrincipal;
    private String cumulativeInterest;
    private String nonCumulativeInterest;
    private String grandTotalInterest;
    private String cumulativeTotal;
    private String nonCumulativeTotal;
    private String grandTotal;
    private String totalInWords;
    private String accountNo;
    private String principleAmount;
    private String paymentDate;
    private String blaNo;
    private String totalAmount;

    public String getBlaNo() {
        return blaNo;
    }

    public void setBlaNo(String blaNo) {
        this.blaNo = blaNo;
    }

    public String getPaymentDate() {
        return paymentDate;
    }

    public void setPaymentDate(String paymentDate) {
        this.paymentDate = paymentDate;
    }

    public String getPrincipleAmount() {
        return principleAmount;
    }

    public void setPrincipleAmount(String principleAmount) {
        this.principleAmount = principleAmount;
    }

    public String getTotalAmount() {
        return totalAmount;
    }

    public void setTotalAmount(String totalAmount) {
        this.totalAmount = totalAmount;
    }

    public String getNumber() {
        return number;
    }

    public void setNumber(String number) {
        this.number = number;
    }
    
    public String getBondType() {
        return bondType;
    }

    public void setBondType(String bondType) {
        this.bondType = bondType;
    }

    public String getInterestAmount() {
        return interestAmount;
    }

    public void setInterestAmount(String interestAmount) {
        this.interestAmount = interestAmount;
    }

    public String getInvestmentAmount() {
        return investmentAmount;
    }

    public void setInvestmentAmount(String investmentAmount) {
        this.investmentAmount = investmentAmount;
    }

    public String getCumulativePrincipal() {
        return cumulativePrincipal;
    }

    public void setCumulativePrincipal(String cumulativePrincipal) {
        this.cumulativePrincipal = cumulativePrincipal;
    }

    public String getNonCumulativePrincipal() {
        return nonCumulativePrincipal;
    }

    public void setNonCumulativePrincipal(String nonCumulativePrincipal) {
        this.nonCumulativePrincipal = nonCumulativePrincipal;
    }

    public String getGrandTotalPrincipal() {
        return grandTotalPrincipal;
    }

    public void setGrandTotalPrincipal(String grandTotalPrincipal) {
        this.grandTotalPrincipal = grandTotalPrincipal;
    }

    public String getCumulativeInterest() {
        return cumulativeInterest;
    }

    public void setCumulativeInterest(String cumulativeInterest) {
        this.cumulativeInterest = cumulativeInterest;
    }

    public String getNonCumulativeInterest() {
        return nonCumulativeInterest;
    }

    public void setNonCumulativeInterest(String nonCumulativeInterest) {
        this.nonCumulativeInterest = nonCumulativeInterest;
    }

    public String getGrandTotalInterest() {
        return grandTotalInterest;
    }

    public void setGrandTotalInterest(String grandTotalInterest) {
        this.grandTotalInterest = grandTotalInterest;
    }

    public String getCumulativeTotal() {
        return cumulativeTotal;
    }

    public void setCumulativeTotal(String cumulativeTotal) {
        this.cumulativeTotal = cumulativeTotal;
    }

    public String getNonCumulativeTotal() {
        return nonCumulativeTotal;
    }

    public void setNonCumulativeTotal(String nonCumulativeTotal) {
        this.nonCumulativeTotal = nonCumulativeTotal;
    }

    public String getGrandTotal() {
        return grandTotal;
    }

    public void setGrandTotal(String grandTotal) {
        this.grandTotal = grandTotal;
    }

    public String getTotalInWords() {
        return totalInWords;
    }

    public void setTotalInWords(String totalInWords) {
        this.totalInWords = totalInWords;
    }

    public String getAccountNo() {
        return accountNo;
    }

    public void setAccountNo(String accountNo) {
        this.accountNo = accountNo;
    }

    public String getFlag() {
        return flag;
    }

    public void setFlag(String flag) {
        this.flag = flag;
    }

    public String getSchemeCode() {
        return schemeCode;
    }

    public void setSchemeCode(String schemeCode) {
        this.schemeCode = schemeCode;
    }

    public String getSchemeName() {
        return schemeName;
    }

    public void setSchemeName(String schemeName) {
        this.schemeName = schemeName;
    }

    public String getSchemeStatus() {
        return schemeStatus;
    }

    public void setSchemeStatus(String schemeStatus) {
        this.schemeStatus = schemeStatus;
    }

    public String getFromDate() {
        return fromDate;
    }

    public void setFromDate(String fromDate) {
        this.fromDate = fromDate;
    }

    public String getToDate() {
        return toDate;
    }

    public void setToDate(String toDate) {
        this.toDate = toDate;
    }
}

