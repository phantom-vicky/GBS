<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">PAN Validation Re-trigger</h4>
    <sol-header></sol-header>
    <form name="panValidationRetriggerFrom" role="form">
        <div class="col-sm-6 col-sm-offset-3">
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="moduleName" class="control-label">Name of the Module</label>
                    </div>
                    <div class="col-sm-4">
                        <label id="moduleName"><b>RBI Bond</b></label>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label class="control-label">Scheme Name</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="schemeName"
                               name="schemeName" ng-model="vm.schemeName" readonly required>
                    </div>
                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="levelNameSearcher"
                           ng-click="vm.getModuleName();vm.searchlevelName = ''"></i>
                        <i class="glyphicon glyphicon-remove clear cp"
                           ng-click="vm.schemeName='';"></i>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="panStatusValidateDate" class="control-label">PanStatus Validated Date</label>
                    </div>
                    <div class="col-sm-4">
                        <p class="input-group">
                            <input type="text" class="form-control" id="panStatusValidateDate"
                                   name="panStatusValidateDate"  ng-model="vm.panStatusValidateDate" maxlength="10"
                                   uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.panStatusDateValidation();"
                                   is-open="vm.panStatusValidateDate.opened" close-text="Close"
                                   datepicker-options="vm.panStatusValidateDateCalenderOptions"  ng-blur="vm.textableDatePicker('panStatusValidateDate',vm.panStatusValidateDate);vm.futureNotAllowed('panStatusValidateDate',vm.panStatusValidateDate)"
                                   ng-keyup="vm.autoslashing('panStatusValidateDate')" chars="numbers-slash" required>
                            <span class="input-group-btn" >
                                    <button type="button" class="btn btn-secondary"
                                            ng-click="vm.panStatusValidateDate.opened = true"
                                            id="panStatusValidateDatePicker">
                                        <i class="glyphicon glyphicon-calendar"></i>
                                    </button>
                         </span></p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label for="fileMode" class="control-label">File Mode</label>
                    </div>
                    <div class="col-sm-4">
                        <select  class="form-control" id="fileMode" name="fileMode" ng-model="vm.fileMode">
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="item in vm.fileModeList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="fileStatus" class="control-label">File Status</label>
                    </div>
                    <div class="col-sm-4">
                        <select class="form-control" name="fileStatus" id="fileStatus" ng-model="vm.fileStatus" required>
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="item in vm.fileStatusList" value="{{item.fileStatusValue}}">{{item.fileStatus}}</option>
                        </select>
                    </div>
                </div>
            </div>
        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default"
                    ui-sref="pan_validation_retrigger.inquiry_details({obj:{
                             panStatusValidateDate:vm.panStatusValidateDate,
                             fileMode:vm.fileMode,
                             fileStatus:vm.fileStatus,
                             schemeCode:vm.schemeCode,
                             schemeName:vm.schemeName
                        }})"
                    ng-disabled="panValidationRetriggerFrom.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
        </div>
    </form>
</div>
<div class="modal" id="levelNameModal" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheme Master Name</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeNameList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchlevelName" ng-init="vm.searchlevelName = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'schemeName'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'status')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'status';" ng-class="(sortedColumn == 'status')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeNameList | filter:vm.searchlevelName | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeName=x.subCodeDescription;vm.schemeCode=x.schemeCode;vm.status=x.status;"  data-bs-dismiss="modal">
                                    <td>{{x.subCodeDescription}}</td>
                                    <td>{{x.status}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeNameList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>


