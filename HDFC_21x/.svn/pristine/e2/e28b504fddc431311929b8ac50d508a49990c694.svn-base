<div class="container from_wrapper">
	<left-menu-directive></left-menu-directive>
	<h4 class="form_heading">
		Sack User
		</h3>
		<form name="sackUserForm" role="form"
			ng-submit="submitForm(sackUserForm.$valid)" novalidate>
			<div class="form-group required">
				<label for="sol_ld" class="control-label col-sm-2">Sol ID :</label>
				<div class="col-sm-2 inner-addon right-addon">
					<input type="text" class="form-control" id="sol_ld" name="sol_ld" value="01220">
					<div
						ng-show="sackUserForm.min_age.$invalid && !sackUserForm.min_age.$pristine"
						class="help-block alert alert-danger">Please enter SOl ID</div>
				</div>
				<div class="col-sm-2"></div>
				<label for="sol_des" class="control-label col-sm-2">Sol Description :</label>
				<div class="col-sm-3 inner-addon right-addon">
					<input type="text" class="form-control" id="sol_des" name="sol_des" value="BANDRA KURLA COMPLEX" required> 
					<div
						ng-show="sackUserForm.sol_des.$invalid && !sackUserForm.sol_des.$pristine"
						class="help-block alert alert-danger">Please enter SOl Description</div>
				</div>
			</div>
			<div class="col-md-2"></div>
			<div class="col-md-8 col-sm-12">
				<table class="table-bordered" width="100%">
					<tr>
						<th>&nbsp;User Names</th>
						<th>&nbsp;Login Times</th>
					</tr>
					<tr>
						<td>&nbsp;<input type="checkbox" name="user_name" value="prem"> Prem</td>
						<td>&nbsp;15-09-2016:01:09:25</td>
					</tr>
				</table>
			</div>
			<div class="col-md-2"></div>
			<div class="col-sm-offset-5 col-sm-8 form_submit">
				<button type="submit" class="btn btn-default"
					ng-disabled="sackUserForm.$invalid">Submit</button>
				<button type="submit" class="btn btn-cancel">Cancel</button>
			</div>
		</form>
</div>

<div class="container from_wrapper">
	<h4 class="form_heading">NPS Message</h4>
	   <div class="row">
	 <div class="col-sm-3"></div>
		 <div class="col-sm-7">
		   <table class="table table-bordered list">
		   <thead>
		 	<tr>
		 	 <th>Message Code</th>
			 <th>Message Description</th>		
			</tr>
			<tr>
			<td>M6001022</td>
			<td>User Profile sacked Successfully.</td>
		</tr>
		</thead>
		</table>		</div>
		</div>
		<div class="col-sm-offset-5 col-sm-8 form_submit">
		
		 <button type="submit" class="btn btn-cancel">Back</button>
	   </div>
</div>	
		
