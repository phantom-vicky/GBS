<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.model">
    <div class="text-right form_submit" >
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/rbibond_gu_functionality';" id="homeButton">Home</button>
        <button type="button" id="cancel_Button" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbibond_ledger_inquiry_name_search_report/action/inquiry';">Back</button>
    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="row">
            <h4 class="form_heading">Bond Ledger Inquiry – Name Search</h4>
            <sol-header></sol-header>
              </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                           ui-jq="dataTable" ui-options="vm.dataTableOption">
                        <thead>
                        <tr class="thalign">
                            <th colspan="9">{{vm.bankName}}</th>
                        </tr>
                        <tr class="thalign">
                            <th colspan="9">{{vm.loginSolDesc}}</th>
                        </tr>
                        <tr class="thalign">
                            <th colspan="9">{{vm.loginSolId}}</th>
                        </tr>
                        <tr class="thalign">
                            <th colspan="9">Bond Ledger Inquiry – Name Search</th>
                        </tr>
                        <tr class="thalign">
                            <th colspan="9">{{vm.schemeName}}</th>
                        </tr>
                        <tr class="thalign">
                            <th>BLA No.</th>
                            <th>Bond Holder Name</th>
                            <th>Address</th>
                            <th>Mode of Holding</th>
                            <th>Holder Type</th>
                            <th>Subscription ID</th>
                            <th>Subscription Date</th>
                            <th>Subscription Amount</th>
                            <th>Subscription Status</th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="x in vm.model">
<!--                            <td align="left">{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>-->
                            <td align="left">{{x.blaNo}}</td>
                            <td align="left">{{x.holderName}}</td>
                            <td align="left">{{x.address}}</td>
                            <td align="left">{{x.modeOfHolding | getLabelFromValuesArray : vm.modeOfHoldingData}}</td>
                            <td align="left">{{x.holderType | getLabelFromValuesArray : vm.holderTypeData}}</td>
                            <td align="left">{{x.subscriptionId}}</td>
                            <td align="left">{{x.subscriptionDate}}</td>
                            <td align="left">{{x.subscriptionAmt}}</td>
                            <td align="left">{{x.subscriptionStatus}}</td>
                        </tr>
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
    </div>
</div>
<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Bond Ledger Inquiry – Name Search</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/rbibond_ledger_inquiry_name_search_report.inquiry/action/inquiry';" >Back</button>
        </center>
    </div>
</div>