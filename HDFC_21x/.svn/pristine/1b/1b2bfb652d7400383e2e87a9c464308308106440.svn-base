    .tooltip-container {
        position: relative;
        display: inline-block;
    }

    .tooltip-container .custom-tooltip {
        visibility: hidden;
        width: auto;
        background-color: green; /* Tooltip background color */
        color: white; /* Tooltip text color */
        text-align: center;
        border-radius: 5px;
        padding: 5px;
        position: absolute;
        z-index: 1;
        bottom: 125%; /* Position the tooltip above the element */
        left: 50%;
        transform: translateX(-50%);
        opacity: 0;
        transition: opacity 0.3s;
        white-space: nowrap; /* Prevent text from wrapping */
    }

    .tooltip-container:hover .custom-tooltip {
        visibility: visible;
        opacity: 1;
    }

    .tooltip-container .custom-tooltip::after {
        content: '';
        position: absolute;
        top: 100%; /* At the bottom of the tooltip */
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: black transparent transparent transparent; /* Arrow styling */
    }
