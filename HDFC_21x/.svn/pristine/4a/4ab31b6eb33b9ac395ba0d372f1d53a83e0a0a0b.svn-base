<div class="loader-new" ng-if="vm.loader"></div>

<div class="container" data-ng-if="vm.model.length>0">
  <div class="container from_wrapper new_form_wrapper">
    <div class="text-right form_submit">
      <button type="submit" class="btn btn-default" onclick="window.location.href ='#!';" id="homeButton">Home</button>

      <button type="button" id="cancel_Button" class="btn btn-cancel" onclick="window.location.href= '#!/e-tds_report/action/inquiry';">Back</button>
    </div>

    <h4 class="form_heading">E-TDS Report</h4>
    <sol-header></sol-header>
    <table style="width: 100%" class="table table-bordered" aria-label="Interest not Credited">
      <tr>
        <th scope="col">Name of the Module</th>
        <td>RBI Bond</td>

            <th scope="col">Total Count</th>
            <td style="width: 10%">{{vm.total}}</td>

      </tr>
      <tr data-ng-if="vm.financialYear">
        <th scope="col">Financial Year</th>
        <td>{{vm.financialYear}}</td>
      </tr>
      <tr data-ng-if="vm.monthIn">
        <th scope="col">Month</th>
        <td>{{vm.monthIn}}</td>
      </tr>
    </table>

    <div class="row">
      <div class="col-sm-12">
          <div class="row" style="display: flex; align-items: center; justify-content: space-between">
              <div class="col-sm-3" style="flex: 1">
                  <div class="form-group">
                      <table style="border-spacing: 2" aria-label="Interest not Credited">
                          <tr>
                              <th scope="col"></th>
                          </tr>
                          <tr>
                              <td>Show&nbsp;</td>
                              <td>
                                  <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                                          ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                                          ng-change="vm.pageNo = 1; vm.getDetails();"
                                          ng-disabled="vm.noDataFoundInSearch">
                                      <option value="5">5 per page</option>
                                      <option value="10">10 per page</option>
                                      <option value="20">20 per page</option>
                                      <option value="50">50 per page</option>
                                  </select>
                              </td>
                          </tr>
                      </table>
                  </div>
              </div>

              <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                  <div class="form-group" style="margin-right: 15px">
                      <div class="input-group">
                          <input type="text" id="search" class="form-control" data-ng-model="vm.searchText" placeholder="Search"/>
                          <div class="input-group-addon">
                              <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getDetails()"></span>
                          </div>
                          <div class="input-group-addon">
                              <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchText='';vm.pageNo = 1; vm.getDetails()"></span>
                          </div>
                      </div>
                  </div>
                  <div class="form-group">
                      <select class="form-control" id="export" name="export"
                              data-ng-model="vm.downloadType" data-ng-disabled="vm.noDataFoundInSearch"
                              data-ng-init="vm.downloadType=''" data-ng-change="vm.downloadReport()">
                          <option value="">EXPORT</option>
                          <option value="excel">EXCEL</option>
                          <!--<option value="csv">CSV</option>-->
                      </select>
                  </div>
              </div>
          </div>
        <div class="table-responsive">
          <table class="table table-bordered table-striped list table-textWrap datatable" aria-label="E-TDS">
            <thead data-ng-if="!vm.noDataFoundInSearch">
              <tr class="thalign">
                <th scope="col">S. No.</th>
                  <th scope="col"> Challan no</th>
                  <th scope="col"> Deductee Sr. no.</th>
                  <th scope="col">PAN</th>
                  <th scope="col">Name of the Deductee</th>
                  <th scope="col"> Section Code</th>
                  <th scope="col">Date of Payment or Credit (DD/MM/YYYY)</th>
                  <th scope="col"> Amount Paid/Credited</th>
                  <th scope="col"> Amount of cash withdrawal which is in excess of Rs. 1 crore referred to in section 393(3) (in case of person other than co-operative society)</th>
                  <th scope="col"> Amount of cash withdrawal which is in excess of Rs. 3 crore for cases covered by section 393(3) [Table: Sl No. 5] (in case of Co-operative Societies)</th>
                  <th scope="col"> Total Tax Deducted</th>
                  <th scope="col"> Total Tax Deposited</th>
                  <th scope="col"> Rate at Which Tax Deducted</th>
                  <th scope="col"> Date of Deduction</th>
                  <th scope="col"> Reason for non-deduction/lower deduction/higher deduction/threshold/Transporter etc.</th>
                  <th scope="col">Certificate number of certificate issued under section 395 for non-deduction/lower deduction</th>
                  <th scope="col"> Unique Identification Number of Form No.121 Submitted by deductee</th>
                  <th scope="col"> Whether the total amount of tax deducted as mentioned in Column (j) has been deposited (Yes/No)</th>
                  <th scope="col"> Cust ID/ Reference No</th>
               <!--   <th scope="col">PAN</th>
                  <th scope="col"> Section</th>-->
                  <th scope="col">Customer Name</th>
                  <th scope="col"> Address Line 1</th>
                  <th scope="col"> Address Line 2</th>
                  <th scope="col"> Address Line 3</th>
                  <th scope="col"> City</th>
                  <th scope="col"> State</th>
                  <th scope="col"> Country</th>
                  <th scope="col"> Pincode</th>
                  <th scope="col"> Email ID</th>


              </tr>
            </thead>

            <tbody data-ng-if="!vm.noDataFoundInSearch">
            <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                <td>{{x.challanNo}}</td>
                <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                <td>{{x.pan}}</td>
                <td>{{x.nameOfTheDeductee}}</td>
                <td>{{x.sectionCode}}</td>
                <td>{{x.dateOfPaymentOrCredit}}</td>
                <td>{{ x.amountPaidCredited ? (x.amountPaidCredited | number:2) : '0.00' }}</td>
                <td>{{x.amountOfCashWithdrawalExceedingRs1Crore}}</td>
                <td>{{x.amountOfCashWithdrawalExceedingRs3Crore}}</td>
                <td>{{x.totalTaxDeducted}}</td>
                <td>{{x.totalTaxDeposited}}</td>
                <td>{{x.rateAtWhichTaxDeducted ? x.rateAtWhichTaxDeducted + '%' : ''}}</td>
                <td>{{x.dateOfDeduction}}</td>
                <td>{{x.reasonForNonDeductionLowerDeductionHigherDeductionThresholdTransporter}}</td>
                <td>{{x.certificateNo}}</td>
                <td>{{x.uniqueIdentificationNumberOfForm121}}</td>
                <td>{{x.taxDeductedDeposited}}</td>

                <td>{{x.referenceNo}}</td>
           <!--     <td>{{x.pan}}</td>
                <td>{{x.sectionCode}}</td>-->
                <td>{{x.nameOfTheDeductee}}</td>
                <td>{{x.addressLine1}}</td>
                <td>{{x.addressLine2}}</td>
                <td>{{x.addressLine3}}</td>
                <td>{{x.city}}</td>
                <td>{{x.state}}</td>
                <td>{{x.country}}</td>
                <td>{{x.pinCode}}</td>
                <td>{{x.emailId}}</td>




            </tr>

            </tbody>
              <tbody data-ng-if="vm.noDataFoundInSearch">
              <tr>
                  <td style="text-align:center">No Records Found</td>
              </tr>
              </tbody>
          </table>
        </div>
        <br />
          <div class="text-center form_submit">
              <span data-ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
              </span>

              <span>
                <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

              <span data-ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
              </span>
          </div>
      </div>
    </div>
  </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
  <div class="list_wrapper no_records_message">
    <h4 class="form_heading">E-TDS Report</h4>
    No records found to display.
      <div style="text-align: center">
      <button type="button" class="btn btn-default" onclick="window.location.href= '#!/e-tds_report/action/inquiry';">Back</button>
    </div>
  </div>
</div>
