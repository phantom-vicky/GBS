package com.isl.gbm.common.audit.log.logger;

import com.isl.gbm.user.management.constants.FeatureNames;
import com.isl.gbm.user.management.constants.ModuleDisplayNames;

import java.util.Date;

/**
 * The Class AuditLoggerParams.
 */
public class AuditLoggerParams {

    /**
     * The current user.
     */
    private String currentUser;

    /**
     * The last modified user.
     */
    private String lastModifiedUser;

    /**
     * The current date.
     */
    private Date currentDate;

    /**
     * The old entity.
     */
    private Object oldEntity;

    /**
     * The new entity.
     */
    private Object newEntity;

    /**
     * The already verified record.
     */
    private boolean alreadyVerifiedRecord;

    /**
     * The column display name.
     */
    private String columnDisplayName;

    /**
     * The module display name.
     */
    private ModuleDisplayNames moduleDisplayName;

    /**
     * The deleted.
     */
    private Boolean deleted = Boolean.FALSE;

    /**
     * The feature name.
     */
    private FeatureNames featureName;

    /**
     * Gets the column display name.
     *
     * @return the column display name
     */
    public String getColumnDisplayName() {
        return this.columnDisplayName;
    }

    /**
     * Gets the current date.
     *
     * @return the current date
     */
    public Date getCurrentDate() {
        return this.currentDate;
    }

    /**
     * Gets the current user.
     *
     * @return the current user
     */
    public String getCurrentUser() {
        return this.currentUser;
    }

    /**
     * Gets the deleted.
     *
     * @return the deleted
     */
    public Boolean getDeleted() {
        return this.deleted;
    }

    /**
     * Gets the feature name.
     *
     * @return the feature name
     */
    public FeatureNames getFeatureName() {
        return this.featureName;
    }

    /**
     * Gets the last modified user.
     *
     * @return the last modified user
     */
    public String getLastModifiedUser() {
        return this.lastModifiedUser;
    }

    /**
     * Gets the module display name.
     *
     * @return the module display name
     */
    public ModuleDisplayNames getModuleDisplayName() {
        return this.moduleDisplayName;
    }

    /**
     * Gets the new entity.
     *
     * @return the new entity
     */
    public Object getNewEntity() {
        return this.newEntity;
    }

    /**
     * Gets the old entity.
     *
     * @return the old entity
     */
    public Object getOldEntity() {
        return this.oldEntity;
    }

    /**
     * Checks if is already verified record.
     *
     * @return true, if is already verified record
     */
    public boolean isAlreadyVerifiedRecord() {
        return this.alreadyVerifiedRecord;
    }

    /**
     * Sets the already verified record.
     *
     * @param alreadyVerifiedRecord the new already verified record
     */
    public void setAlreadyVerifiedRecord(final boolean alreadyVerifiedRecord) {
        this.alreadyVerifiedRecord = alreadyVerifiedRecord;
    }

    /**
     * Sets the column display name.
     *
     * @param columnDisplayName the new column display name
     */
    public void setColumnDisplayName(final String columnDisplayName) {
        this.columnDisplayName = columnDisplayName;
    }

    /**
     * Sets the current date.
     *
     * @param currentDate the new current date
     */
    public void setCurrentDate(final Date currentDate) {
        this.currentDate = currentDate;
    }

    /**
     * Sets the current user.
     *
     * @param currentUser the new current user
     */
    public void setCurrentUser(final String currentUser) {
        this.currentUser = currentUser;
    }

    /**
     * Sets the deleted.
     *
     * @param deleted the new deleted
     */
    public void setDeleted(final Boolean deleted) {
        this.deleted = deleted;
    }

    /**
     * Sets the feature name.
     *
     * @param featureName the new feature name
     */
    public void setFeatureName(final FeatureNames featureName) {
        this.featureName = featureName;
    }

    /**
     * Sets the last modified user.
     *
     * @param lastModifiedUser the new last modified user
     */
    public void setLastModifiedUser(final String lastModifiedUser) {
        this.lastModifiedUser = lastModifiedUser;
    }

    /**
     * Sets the module display name.
     *
     * @param moduleDisplayName the new module display name
     */
    public void setModuleDisplayName(final ModuleDisplayNames moduleDisplayName) {
        this.moduleDisplayName = moduleDisplayName;
    }

    /**
     * Sets the new entity.
     *
     * @param newEntity the new new entity
     */
    public void setNewEntity(final Object newEntity) {
        this.newEntity = newEntity;
    }

    /**
     * Sets the old entity.
     *
     * @param oldEntity the new old entity
     */
    public void setOldEntity(final Object oldEntity) {
        this.oldEntity = oldEntity;
    }

}
