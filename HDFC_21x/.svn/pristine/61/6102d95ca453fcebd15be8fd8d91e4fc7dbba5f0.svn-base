<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Transfer-in of Bond Account within Same Bank - Inquiry</h4>
    <sol-header></sol-header>
    <form name="bondNominationFrom" role="form">


        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-5">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" data-ng-model="vm.schemeName" required readonly>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left:0;">
                    <span class="glyphicon glyphicon-search cp" data-toggle="modal"
                          data-ng-click="vm.getSchemeName();"></span> <span class="glyphicon glyphicon-remove clear cp"
                                                                            data-ng-click="vm.schemeName = ''; vm.schemeCode = '';"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Account Transferred From Branch</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="accTranFrom" data-ng-init="vm.accTranFrom=''"
                           data-ng-model="vm.accTranFrom" required readonly>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left:0;"
                     data-ng-if="vm.schemeCode">
                    <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="accTranFromSearch"
                          data-ng-click="vm.getAccTranSameNo();vm.searchSolId='';"></span>
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.accTranFrom = '';"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3"><label for="holderName" class="control-label">Holder Name</label></div>

                <div class="col-sm-2">
                    <input type="text" maxlength="50" class="form-control" id="holderName" name="holderName"
                           data-ng-model="vm.holderName"
                           oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"/>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">PAN No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" data-ng-init="vm.panNo=''" data-ng-model="vm.panNo"
                           minlength="4" maxlength="10" oninput="this.value = this.value.replace(/\s+/g, '')">
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left:0;"
                     data-ng-if="vm.schemeCode && vm.holderName || vm.panNo">
                    <span class="glyphicon glyphicon-search cp" data-toggle="modal"
                          data-ng-click="vm.getPanNo();vm.searchSolId='';"></span>
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.panNo = '';"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Bond Ledger Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="blaAccNo" data-ng-init="vm.blaNo=''"
                           data-ng-model="vm.blaNo" minlength="4" maxlength="14"
                           oninput="this.value = this.value.replace(/[^a-zA-Z0-9]/g, '')" required>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left:0;"
                     data-ng-if="vm.schemeCode && vm.panNo || vm.blaNo">
                    <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="versionNoSearch"
                          data-ng-click="vm.getBlaAccNo();vm.searchSolId='';"></span>
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.blaNo = '';"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Bond Subscription ID</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="bondScbId" data-ng-init="vm.subsId=''"
                           data-ng-model="vm.subsId" oninput="this.value = this.value.replace(/[^a-zA-Z0-9]/g, '')"
                           required/>
                </div>
                <div class="col-sm-2"
                     style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left:0;"
                     data-ng-if="vm.schemeCode && vm.panNo || vm.blaNo">
                    <span class="glyphicon glyphicon-search cp" data-toggle="modal" id="subscriptionIdSearch"
                       data-ng-click="vm.getSubscriptionId();vm.searchSolId='';"></span>
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.subsId = ''"></span>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default" data-ui-sref="bond_transfer-in_from_same_bank.inquiry_detail({obj:{
                            schemeCode:vm.schemeCode,
                            accTransBranchId:vm.accTranFrom,
                            blaNo:vm.blaNo,
                            subsId:vm.subsId,
                            schemeName:vm.schemeName,
                            panNo : vm.panNo,
                            holderName : vm.holderName
                        }})" data-ng-disabled="bondNominationFrom.$invalid">Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


<!--SchemeName model-->
<div class="modal" id="schemeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Name of the Bond Scheme</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.searchSolId"
                                       data-ng-init="vm.searchSolId = ''"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <th scope="col" data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                        data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Scheme Name
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                        data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Scheme Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus; vm.schemeCode = x.schemeCode; "
                                    data-bs-dismiss="modal">
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>


<!--acc trans from branch model-->
<div class="modal" id="branchIdModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Account Transfered From Branch</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.accTransList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.searchSolId"
                                       data-ng-init="vm.searchSolId = ''" maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'branchId'">
                                <tr>
                                    <th scope="col" data-ng-click="(sortedColumn == 'branchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchId';"
                                        data-ng-class="(sortedColumn == 'branchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Branch Id
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'accTranFrom')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'accTranFrom';"
                                        data-ng-class="(sortedColumn == 'accTranFrom')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Name of the Branch
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.accTransList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.accTranFrom = x.branchId; vm.branchName = x.branchName; "
                                    data-bs-dismiss="modal">
                                    <td>{{x.branchId}}</td>
                                    <td>{{x.branchName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.accTransList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>


<!--PAN No model-->
<div class="modal" id="panNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.panNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.searchSolId"
                                       data-ng-init="vm.searchSolId = ''" maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'panNo'">
                                <tr>
                                    <th scope="col" data-ng-click="(sortedColumn == 'panNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNo';"
                                        data-ng-class="(sortedColumn == 'panNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN No
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                        data-ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Holder Name
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';"
                                        data-ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BLA No
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.panNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.blaNo = x.blaNo; vm.panNo = x.panNo; vm.holderName= x.holderName;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.panNo}}</td>
                                    <td>{{x.holderName}}</td>
                                    <td>{{x.blaNo}}</td>

                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.panNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!--blaAccNo model-->
<div class="modal" id="blaAccNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Ledger Account Number</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.searchSolId"
                                       data-ng-init="vm.searchSolId = ''" maxlength="10"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'blaAccNo'">
                                <tr>
                                    <th scope="col" data-ng-click="(sortedColumn == 'blaAccNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaAccNo';"
                                        data-ng-class="(sortedColumn == 'blaAccNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BOND BLA No.
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'holderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'holderName';"
                                        data-ng-class="(sortedColumn == 'holderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BOND Account Number
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                                        data-ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Bond Holder Name
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.blaAccNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.blaNo = x.blaNo; vm.holderName=holderName;vm.accNumber=accNumber; "
                                    data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.accNumber}}</td>
                                    <td>{{x.holderName}}</td>

                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!--subscriptionId Model-->
<div class="modal" id="subScriptionIdModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Bond Subscription ID</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" data-ng-if="vm.subscriptionIdList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <span class="glyphicon glyphicon-search"></span>
                                </div>
                                <input type="text" class="form-control" data-ng-model="vm.searchSolId"
                                       data-ng-init="vm.searchSolId = ''"
                                       oninput="this.value = this.value.replace(/^\s+/, '').replace(/[^0-9a-zA-Z\s]/g, '').replace(/\s{2,}/g, ' ')"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead data-ng-init="reverseOrder=true;sortedColumn = 'bondScbId'">
                                <tr>
                                    <th scope="col" data-ng-click="(sortedColumn == 'subsId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subsId';"
                                        data-ng-class="(sortedColumn == 'subsId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Bond Subscription Id
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'subsAmt')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subsAmt';"
                                        data-ng-class="(sortedColumn == 'subsAmt')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Subscription Amount
                                    </th>
                                    <th scope="col" data-ng-click="(sortedColumn == 'dateOfTransfer')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'dateOfTransfer';"
                                        data-ng-class="(sortedColumn == 'dateOfTransfer')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Date of Transfer
                                    </th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    data-ng-repeat="x in vm.subscriptionIdList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    data-ng-click="vm.subsId = x.subsId; vm.subsAmt = x.subsAmt; vm.dateOfTransfer = x.dateOfTransfer;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.subsId}}</td>
                                    <td>{{x.subsAmt}}</td>
                                    <td>{{x.dateOfTransfer}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" data-ng-if="vm.subscriptionIdList.length==0">No records found to display.
                </div>
            </div>
        </div>
    </div>
</div>