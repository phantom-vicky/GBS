/*@import url(https://fonts.googleapis.com/css?family=Open+Sans:400,300,600,700,800);*/
:root{
    --gradientBlue : radial-gradient(circle farthest-side at center 120%, #009cde, #003087 100%);
}
body {
  /*font-family: "Open Sans", sans-serif;*/
  font-family: Arial, Helvetica, sans-serif;
}

.required .control-label:after {
  content: " *";
  color: red;
}

.label-required{
color:red;
}
.control-label{
	margin-top: 5px;
}
.form-group i {
	line-height: 33px;
}
.input-group-btn i{
	line-height: 20px;
}
.padding-15{
    padding: 15px;
}

/* enable draggable positioning */
.swal2-container {
  align-items: flex-start !important;
  justify-content: flex-start !important;
}

.swal2-popup {
  margin: 0 !important;
}






.blur-bg {
    color: red;              /* text color */
    pointer-events: none;    /* disable click (optional) */
}


/*Header to start*/
.header_top {
  border-top: 2px solid #1f629a;
  background-color: #fff;
}
div#page-wrapper {
  margin-top: 150px;
  margin-bottom: 5%;
}
.navbar-default {
  /*  position: fixed;*/
  width: 100%;
  z-index: 1001;
}
.header_top h3 {
  color: #727472;
  text-align: center;
  margin-top: 15px;
  font-size: 21px;
}
.header_top img {
  margin-top: 6%;
  margin-bottom: 6%;
}
.inspiri_logo{
   margin: 0 !important;
   width: 75%;
   padding: 5px;
}
/*Header to end*/
/*Menu start*/
.header_portion {
  position: fixed;
  /*  overflow: hidden;*/
  width: 100%;
  top: 0;
  z-index: 1000;
}
.navbar {
  border-radius: 0;
}
.navbar-default {
  background-color: #1f629a;
  border-color: transparent;
  background-image: var(--gradientBlue);
}
.navbar-default .navbar-nav > li > a {
  color: white;
  font-weight: bold;
}
.navbar-default .navbar-nav > li > a:hover {
  color: white;
}
.navbar-default .navbar-nav > li > .active > a {
  color: white;
}
.navbar-default .navbar-nav > .active > a,
.navbar-default .navbar-nav > .active > a:focus,
.navbar-default .navbar-nav > .active > a:hover {
  background-color: #1f629a;
  color: white;
}
.dropdown-menu {
  background-color: #1f629a;
  background-image: var(--gradientBlue);
}
.dropdown-menu li a {
  color: #fff;
  font-weight: bold;
}
.bootstrap-datetimepicker-widget li a {
  color: #337ab7 !important;
}
.navbar-default .navbar-nav > .open > a,
.navbar-default .navbar-nav > .open > a:focus,
.navbar-default .navbar-nav > .open > a:hover {
  background-color: #fff;
  color: #1f629a;
}
.navbar-right >li{
   padding: 5px 0;
}
.navbar-right >li >a{
   padding: 0;
   color: #c2cae8;
}
i.fa.fa-user {
  font-size: 17px;
}
.version {
  color: #c2cae8;
  padding-left: 23px;
}
/*Menu End*/
/*body start*/
.form_heading {
  margin-bottom: 20px;
}
.tc {
  text-align: center;
}
.welcome {
  text-align: center;
  color: #727472;
  /*#727472*/
  padding-top: 5%;
}
.welcome h2 span {
  font-size: 45px;
}
.welcome h2 {
  font-size: 36px;
}
/*body End*/
/*form start*/
.form-group {
  padding-bottom: 3%;
  min-height: 33px;
  margin-bottom: 10px;
}
.new_form_wrapper
.form-group {
	  padding-bottom: 0% !important;
}
.form_heading {
  text-align: center;
  background: #FFF;
 background: -webkit-linear-gradient(to right, #1f629a, #FFF 15%);
  background: -o-linear-gradient(to right, #1f629a, #FFF 15%);
  background: -moz-linear-gradient(to right, #1f629a, #FFF 15%);
  background: linear-gradient(to right, #1f629a, #FFF 15%);
  color: #1f629a;
  padding: 5px;
}

.feature-heading{
	text-align: center;
  	color: #1f629a;
  	padding: 5px;
  	margin-bottom: 20px;
  	text-transform: capitalize;
}


.btn-default {
  color: #fff;
  background-color: #1f629a;
  border-color: #CCC;
}
.btn-default :hover {
  color: #fff;
  background-color: #1f629a;
  border-color: #CCC;
}
.btn-cancel {
  color: #fff;
  background-color: #727472;
  border-color: #727472;
}
.from_wrapper {
  background: #EBEFF2 none repeat scroll 0% 0%;
  margin-bottom: 20px;
    box-shadow: 0px 0px 5px 1px rgba(0, 0, 0, 0.1);
    border-radius: 12px;
}
div[data-ng-repeat]>ul>li {
    border-bottom: 1px solid #ddd;
    padding-top: 10px;
    padding-bottom: 15px;
}
div[data-ng-repeat]>ul>li:last-child{
    border-bottom: none;
}
div[data-ng-repeat] ul >li >ul >li, div[data-ng-repeat] li b{
    padding: 2px 0;
}
.list_wrapper {
  margin-bottom: 5%;
  padding-bottom: 2%;
  padding-left: 0;
  padding-right: 0;
}
.form_submit {
  margin-top: 2%;
  margin-bottom: 2%;
}
label {
  font-weight: normal;
}
/*form end*/
#loginbox .panel-info{
    border-radius: .5rem;
    box-shadow: 0 4px 25px 0 rgba(0,0,0,.1);
}
#loginbox .panel-info>.panel-heading{
    background-image: var(--gradientBlue);
    color: #fff;
    font-weight: 600;
    border: none;
}
#loginbox .btn-default{
    background-image: var(--gradientBlue);
    font-weight: 600;
}
/*side menu start*/
.atss {
  background: rgba(0, 0, 0, 0) none repeat scroll 0 0;
  position: fixed;
  width: 90px;
  z-index: 1000;
}
.atss-right {
  float: left;
  left: auto;
  left: 0;
}
a.at-svc-linkedin,
a.at-svc-startaid {
  background-color: rgba(255, 255, 255, 0.8);
}
