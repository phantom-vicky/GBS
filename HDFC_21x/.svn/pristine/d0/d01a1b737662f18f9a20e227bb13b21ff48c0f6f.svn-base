                                    <td class="old-value">{{(item && item.C020)?
                                        (item.C020.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C020? (item.C020.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian Address1</td>
                                    <td class="old-value">{{(item && item.C021)?
                                        (item.C021.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C021? (item.C021.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian Address2</td>
                                    <td class="old-value">{{(item && item.C022)?
                                        (item.C022.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C022? (item.C022.newValue) : ('')}}
                                    </td>
                                </tr>


                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian City</td>
                                    <td class="old-value">{{(item && item.C023)?
                                        (item.C023.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C023? (item.C023.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian State</td>
                                    <td class="old-value">{{(item && item.C024)?
                                        (item.C024.oldValue | getLabelFromValuesArray : vm.stateListLabelValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C024? (item.C024.newValue | getLabelFromValuesArray : vm.stateListLabelValue) : ('')}}
                                    </td>
