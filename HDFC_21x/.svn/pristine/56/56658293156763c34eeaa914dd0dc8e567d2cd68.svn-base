        </div>
        </div>
    <div class="audit-details">
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified By </b> : {{(vm.auditInfo.lastModifiedBy) ? (vm.auditInfo.lastModifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.lastVerifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Modified On</b> : {{ (vm.auditInfo.lastModifiedDate) ? (vm.auditInfo.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
                <span> <b> Last Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-3">
            </div>
        </div>
    </div>

<!--</div>-->


    <div class="text-center form_submit">
        <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="vm.bondNominationsForm.$invalid || vm.bondNominationsForm.$pristine">Submit
            <!--                        ng-disabled="cbdtSchemeParameterCreationForm.$invalid || cbdtSchemeParameterCreationForm.$pristine || vm.cbdtOTCCashActErrMsg">Submit-->
        </button>
        <button type="button" class="btn btn-cancel" id="cancelButton"
                onclick="window.location.href= '#!/cas_acknowledgement_number_maintenance/action/modify';">Cancel
        </button>
    </div>

    <div class="text-center">
        <notice-message-directive></notice-message-directive>
    </div>
</form>
</div>