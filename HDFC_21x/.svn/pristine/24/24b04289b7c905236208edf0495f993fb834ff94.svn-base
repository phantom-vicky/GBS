<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper">
    <h4 class="form_heading  feature-heading">Common Flag – Inquiry</h4>
    <sol-header></sol-header>
    <form name="managePermissionForm" role="form">


        <table class="table table-bordered">
            <tbody>

            <tr>

                <td width="50%" class="form-group">
                    <label class="control-label">Name Of The Module</label></td>
                <td width="50%">
                    <label class="control-label"><b>RBI Bond</b></label>
                </td>




            </tr>


            <tr>


                <td width="50%" class="form-group">
                    <label class="control-label">Name of the Bond Scheme</label></td>
                <td width="50%">
                    <label class="control-label" >{{vm.schemeName}}</label>
                </td>



            </tr>
            <tr>


                <td width="50%" class="form-group">
                    <label class="control-label">Remarks</label></td>
                <td width="50%">
                    <label class="control-label" >{{vm.remarks}}</label>
                </td>



            </tr>


            </tbody>
        </table>


        <!--        <h4 class="form_heading">Manage Permissions ({{vm.role.name | uppercase}})</h4>-->
        <div class="col-md-12 margin-btm">
            <div class="row">
                <h5 class="text-center sub-title">Selected Mandatory one from the below list</h5>
                <div class="col-md-12 map-div">
                    <div class="col-md-6">
                        <div>
                            <input type="text" class="form-control" id="unmappedDocumentSearcher" ng-model="unmappedDocumentSearcher" chars="alpha-numeric" placeholder="Search"  chars="alpha-numeric"oninput="this.value = this.value.replace(/\s+/g, '')">
                        </div>
                        <div class="row" style="height : 25px;"></div>
                        <h5>Non-Mandatory</h5>
                        <ul>
                            <li ng-repeat="item in vm.mapUnmMppedDocuments.unmappedDocumentsList | filter : unmappedDocumentSearcher">{{item.code}} - {{item.codeDescription}}</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <div>
                            <input type="text" class="form-control" id="mappedDocumentsSearcher" ng-model="mappedDocumentsSearcher" chars="alpha-numeric" placeholder="Search"  chars="alpha-numeric"oninput="this.value = this.value.replace(/\s+/g, '')">
                        </div>
                        <div class="row" style="height : 25px;"></div>
                        <h5>Mandatory</h5>
                        <ul>
                            <li ng-repeat="item in vm.mapUnmMppedDocuments.mappedDocumentsList | filter : mappedDocumentsSearcher">{{item.code}} - {{item.codeDescription}}</li>
                        </ul>
                    </div>
                </div>
                <div class="col-md-12 map-div text-center" ng-if="vm.mapUnmMppedDocuments == 'NO RECORDS'">
                    <h5> No Records Found to Display</h5>
                </div>
            </div>
        </div>
        <div class="audit-details">
            <div class="row">
                <!--                <div class="col-md-3">-->
                <!--												<span>-->
                <!--													<b> Created By </b> : {{vm.mapUnmMppedDocuments.createdBy}}-->
                <!--												</span>-->
                <!--                </div>-->
                <div class="col-md-3">
												<span>
													<b> Last Modified By </b> : {{(vm.mapUnmMppedDocuments.modifiedBy) ? (vm.mapUnmMppedDocuments.modifiedBy) : ('None')}}
												</span>
                </div>
                <div class="col-md-3">
												<span>
													<b> Last Verified By </b> : {{(vm.mapUnmMppedDocuments.verifiedBy) ? (vm.mapUnmMppedDocuments.verifiedBy) : ('None')}}
												</span>
                </div>
                <div class="col-md-3">
												<span>
													<b> Verify Status </b> : {{vm.mapUnmMppedDocuments.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}
												</span>
                </div>
            </div>
            <div class="row">
                <!--                <div class="col-md-3">-->
                <!--												<span>-->
                <!--													<b> Created On </b> : {{ vm.mapUnmMppedDocuments.createdDate | date : 'dd/MM/yyyy'}}-->
                <!--												</span>-->
                <!--                </div>-->
                <div class="col-md-3">
												<span>
													<b> Last Modified On</b> : {{ (vm.mapUnmMppedDocuments.modifiedDate) ? (vm.mapUnmMppedDocuments.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}
												</span>
                </div>
                <div class="col-md-3">
												<span>
													<b> Last Verified On </b> : {{(vm.mapUnmMppedDocuments.verifiedDate) ? (vm.mapUnmMppedDocuments.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}
												</span>
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>

        <div class="col-sm-offset-5 col-sm-8 form_submit">
<!--            <button type="button" class="btn btn-default" ng-disabled="managePermissionForm.$invalid || !vm.isSelectionValid" ng-click="vm.addPermissionSubmit()">Submit</button>-->
<!--            <button type="button" class="btn btn-cancel" ng-click="vm.showCancelConfirmation()">Cancel</button>-->
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/common_flag/action/inquiry';">Cancel
            </button>
        </div>

        <div class="isa_error" ng-if="vm.errorMsg" ng-bind="vm.errorMsg" style="text-align: center;">
        </div>
    </form>
</div>