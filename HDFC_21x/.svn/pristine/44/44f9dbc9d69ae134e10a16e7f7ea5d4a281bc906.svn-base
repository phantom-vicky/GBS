                <div class="col-sm-2">
                    <input type="text" inputmode="numeric" class="form-control" id="ceilingAmountWithoutPan"
                        maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8)"
                        name="maxNoOfChallan" ng-model="vm.cbdtSchemeParameter.C029.oldValue" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Ceiling Amount with PAN</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" inputmode="numeric" class="form-control" id="ceilingAmount" maxlength="8"
                        oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 8)" name="maxNoOfChallan"
                        ng-model="vm.cbdtSchemeParameter.C041.oldValue" />
                </div>
            </div>
        </div>

