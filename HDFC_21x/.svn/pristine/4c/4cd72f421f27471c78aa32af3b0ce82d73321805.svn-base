<div class="container from_wrapper">
<left-menu-directive></left-menu-directive>	
	<h4 class="form_heading">Corporate Service Request Master - {{action}}</h4>
	
	<form name="corporateServiceMasterForm" role="form" ng-submit="corporateServiceMasterInquiryForm(corporateServiceMasterForm.$valid)" novalidate>
				<div class="form-group required">
				<div class="col-sm-3"></div>
				  <label for="name" class ="control-label col-sm-3">Corporate ID</label>
			       <div class="col-sm-3 ">
				      <input type="text" class="form-control" ng-model="corporateServiceMaster.corporateId" id="corporateId" name="corporateId" required readonly="true">
				   </div>
				    <div class="col-sm-3 torch-top">
				      <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" data-target="#corporateIdModal" ng-click="getCorporateCode()"></i>
				      <i class="glyphicon glyphicon-remove clear cp" ng-click="clearCorporateCode()"></i>

				    <!--    <i id="corporateId">{{corporateServiceMaster.corporateId}}</i>  -->

				       <i id="corporateName">{{corporateServiceMaster.corporateCode}}</i> 

			       </div>
		        </div>
		        
		         <div class="col-sm-offset-5 col-sm-8 form_submit">
		       <button type="submit" class="btn btn-default"  id="submitButton" ng-disabled="corporateServiceMasterForm.$invalid">Submit</button>
		       <button type="submit" class="btn btn-cancel" id="cancelButton" onclick="cancelFn()">Cancel</button>

	       </div>
	   </form>
	   </div>
	<div class="modal" id="corporateIdModal" role="dialog">
	  <div class="modal-dialog">
	    <!-- Modal content-->
	    <div class="modal-content">
	      <div class="modal-header">
	        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
	        <h4 class="modal-title">Corporate ID List</h4>
	      </div>
	      <div class="modal-body">
	        <div class="list_wrapper" ng-if="corporateCodeList.length>0">
		        <div class="row">
					<div class="col-sm-10">
						<table class="table table-bordered list scroll">
						    <thead>
						      <tr>
						        <th>Corporate ID</th>
						        <th>Corporate Name</th>
						      </tr>
						    </thead>
						    <tbody>
						      <tr class="cp" ng-repeat="x in corporateCodeList" ng-click="setCorporateCode(x);">
						        <td>{{x.corporateId}}</td>
						       <td>{{x.corporateName}}</td>
						      </tr>
						    </tbody>
						 </table>
					</div>
				</div>
			</div>
			<div class="list_wrapper" ng-if="corporateCodeList.length==0">No records found to display.</div>
	      </div>
	    </div>
	  </div>
	</div>
	
	<div class="container list_wrapper" ng-if="corporateServiceMasterInquiryList.length>0">
		<table class="table table-bordered table-striped list">
		    <thead>
		   
		      <tr>
		      
		      	<th>Corporate ID</th>
		      	<th>Service Name</th>
		      	<th>Is Flat Rate for Commission? </th>
		      	<th>Commission (Amount/Percentage) </th>
		      	<th>Minimum Commission Amount   </th>
		      	<th>Maximum Contribution Amount  </th>
		      	<th>Effective From Date</th>
		      	<th>Effective To Date </th>
		      	<th>Service tax (In Percentage) </th>
		      	<th>Tier code </th>
		      	<th ng-if="action=='verify'">verify</th>
		      </tr>
		    </thead>
		    <tbody>
		      <tr ng-repeat="x in corporateServiceMasterInquiryList">
		      	<td>{{x.corporateId}}</td>
		        <td>{{x.serCode + ' / ' + x.serCodeDesc}}</td>
		        <td>{{x.isFlatRate}}</td>
		        <td>{{x.commission}}</td>
		        <td>{{x.minAmt}}</td>
		        <td>{{x.maxAmt}}</td>
		        <td>{{x.effFromDate | date : "dd/MM/y"}}</td>
		        <td>{{x.effToDate | date : "dd/MM/y"}}</td>
		        <td>{{x.serviceTax}}</td>
		        <td>{{x.tierCode}}</td>
		        <td ng-if="action=='verify'"><i class="glyphicon glyphicon-ok cp" ng-click="verify(x.id)"></i></td>
		      </tr>
		    </tbody>
	 	</table>
	</div>
	<div class="list_wrapper no_records_message" ng-if="corporateServiceMasterInquiryList.length==0">No records found to display.</div>
		
	
	 <div class="container list_wrapper" ng-if="corporateServiceMasterInquiryList>0">
	
	<table class="table table-bordered table-striped list">
	    <thead>
	      <tr>
	       	       
	      </tr>
	    </thead>
	    <tbody>
	      <tr >
	        <td>Corporate ID</td>
	        <td>{{corporateServiceMaster.corporateId}}</td>
	        <td></td>
	      </tr>
	       <tr >
	         <td>Corporate Name</td>
	        <td>{{corporateServiceMaster.corporateName}}</td>
	        <td></td>
	      </tr>
	       <tr >
	         <td>Service Name</td>
	        <td>{{corporateServiceMaster.serviceCode}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Is Flat Rate For Commission?</td>
	        <td>{{corporateServiceMaster.isFlatRate}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Commission(Amount in Percentage)</td>
	        <td>{{corporateServiceMaster.commission}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Commission Amount</td>
	        <td>{{corporateServiceMaster.minAmt}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Maximum Commission Amount</td>
	        <td>{{corporateServiceMaster.maxAmt}}</td>
	        <td></td>
	      </tr>
	      
	       <tr >
	        <td>Effective From Date</td>
	        <td>{{corporateServiceMaster.effFromDate}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Effective To Date</td>
	        <td>{{corporateServiceMaster.effToDate}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Service Tax(in Percentage)</td>
	        <td>{{corporateServiceMaster.serviceTax}}</td>
	        <td></td>
	      </tr>
	       <tr >
	       <td>Tier Code</td>
	        <td>{{corporateServiceMaster.tierCode}}</td>
	      </tr>
	      
	    </tbody>
	 </table>
	 </div>
	 