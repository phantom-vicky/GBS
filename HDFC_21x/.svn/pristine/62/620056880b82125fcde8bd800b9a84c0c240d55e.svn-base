package com.isl.gbm.cbs.integration.common;

public enum CbsBulkUploadEnum {


    BB("BB", "Branches of the Bank"),

    OAHP("OAHP", "Office Account Place Holder"),

    ID("ID", "Instruments Details"),

    TC("TC", "List of Transaction Codes"),

    OBD("OBD", "Other Bank Details"),

    BOB("BOB", "Branches of Other Bank"),

    MOCE("MOCE", "Maintainence of Calender Entries"),

    SC("SC", "Scheme Codes"),

    UWCI("UWCI", "User Work Class Information"),

    BIFSCC("BIFSCC", "Branch IFSC Code");

   private String cbsCode;

   private String cbsDesc;

    CbsBulkUploadEnum(String cbsCode, String cbsDesc) {
        this.cbsCode = cbsCode;
        this.cbsDesc = cbsDesc;
    }

    public String getCbsCode() {
        return cbsCode;
    }

    public void setCbsCode(String cbsCode) {
        this.cbsCode = cbsCode;
    }

    public String getCbsDesc() {
        return cbsDesc;
    }

    public void setCbsDesc(String cbsDesc) {
        this.cbsDesc = cbsDesc;
    }
}
