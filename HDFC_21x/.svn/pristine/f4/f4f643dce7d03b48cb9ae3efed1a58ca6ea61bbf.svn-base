<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">TDS Parameters for RBI Bond - Inquiry</h4>
    <sol-header></sol-header>
    <form name="tdsparameter" role="form">


<!--        <div class="row">-->
<!--            <div class="form-group">-->
<!--                <div class="col-sm-3"></div>-->
<!--                <div class="col-sm-4">-->
<!--                    <label for="moduleName" class="control-label">Name of the Module</label>-->
<!--                </div>-->
<!--                <div class="col-sm-4">-->
<!--                    <label><b>RBI Bond</b></label>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="solId" class="control-label">Branch Id</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="solId" ng-init=""
                           ng-model="vm.solId" required readonly>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Branch Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="solDesc" ng-init=""
                           name="solDesc" ng-model="vm.solDesc" required readonly>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="moduleName" class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-4">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

<!--        <div class="row">-->
<!--            <div class="form-group required">-->
<!--                <div class="col-sm-3"></div>-->
<!--                <div class="col-sm-3">-->
<!--                    <label for="moduleName" class="control-label">Name of the Bond Scheme</label>-->
<!--                </div>-->
<!--                <div class="col-sm-2">-->
<!--                    <select class="form-control" id="moduleName" name="moduleName"-->
<!--                            ng-model="vm.moduleId"-->
<!--                            ng-init="vm.addValidation();" ng-change="vm.versionEmpty();vm.fetchModuleName(vm.moduleId);" required>-->
<!--                        <option value="" hidden="true">Select</option>-->
<!--                        <option ng-repeat="item in vm.moduleNameList" value="{{item.moduleId}}">{{item.moduleName}}</option>-->
<!--                    </select>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeName" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="moduleName" ng-model="vm.schemeName" required readonly>
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="schemeNameSearcher" ng-click="vm.getInquiryTdsCodeTourch();"></i>
                    <i class="glyphicon glyphicon-remove clear cp" ng-click="vm.schemeName='';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="tdsParamCode" class="control-label">TDS Param Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="tdsParamCode"
                           ng-model="vm.tdsParamCode" chars="alpha-numeric" maxlength="5" required readonly>
                </div>
                <div class="col-sm-1">
                    <div ng-if="vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="branchIdSearch"
                           ng-click="vm.getInquiryTdsCodeTourch(vm.schemeCode);vm.searchSolId='';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.tdsParamCode='';vm.tdsParamCodeDesc='';vm.versionNo='';"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="tdsParamCodeDesc" class="control-label">TDS Param Code Description</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="tdsParamCodeDesc"
                           ng-model="vm.tdsParamCodeDesc" chars="alpha-numeric" required readonly>
                </div>
            </div>
        </div>

        <!-- <div class="row">
             <div class="form-group required">
                 <div class="col-sm-3"></div>
                 <div class="col-sm-3">
                     <label for="effFromDate" class="control-label">Effective From Date</label>
                 </div>
                 <div class="col-sm-2">
                     <p class="input-group">
                         <input type="text" class="form-control" id="effFromDate"
                                name="effFromDate" ng-model="vm.effFromDate"
                                uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.effFromDate=''"
                                datepicker-options="vm.dateOptions"
                                is-open="vm.effFromDatePicker.opened" close-text="Close"
                                maxlength="10" readonly required>
                         <span class="input-group-btn">
                             <button type="button" class="btn btn-secondary"
                                     ng-click="vm.effFromDatePicker.opened = true"
                                     id="effFromDateSearcher">
                                 <i class="glyphicon glyphicon-calendar"></i>
                             </button>
                         </span>
                     </p>
                 </div>
             </div>
         </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="versionNo" class="control-label">Version No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="versionNo"
                           ng-model="vm.versionNo" chars="alpha-numeric" maxlength="5" required readonly>
                </div>
                <div class="col-sm-1">
                    <div ng-if="vm.tdsParamCode">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="versionSearch"
                           ng-click="vm.getInquiryVersionNoTourch(vm.schemeCode);vm.searchSolId='';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.versionNo='';"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default"
                    ui-sref="tds_parameter_rbi_bond.inquiry_detail({obj:{
                                    moduleId: vm.schemeCode,
                                    moduleName: vm.schemeName,
                                    tdsParamCodeDesc: vm.tdsParamCodeDesc,
                                    tdsParamCode: vm.tdsParamCode,
                                    versionNo: vm.versionNo
								}})"
                    ng-disabled="tdsparameter.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/dc_rbi_bond_menu';">Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


<!-- TDS Param Code Details -->
<div class="modal" id="tdsCodeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">TDS Param Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.tdsCodeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" chars="alpha-numeric"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">

                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'tdsCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'tdsCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'tdsCode';" ng-class="(sortedColumn == 'tdsCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">TDS Param Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'tdsDesc')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'tdsDesc';" ng-class="(sortedColumn == 'tdsDesc')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">TDS Param code  description</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.tdsCodeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.tdsParamCode=x.tdsCode; vm.tdsParamCodeDesc=x.tdsDesc"  data-bs-dismiss="modal">
                                    <td>{{x.tdsCode}}</td>
                                    <td>{{x.tdsDesc}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.tdsCodeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!-- Version No Details -->
<div class="modal" id="versionModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Version No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.versionNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" chars="alpha-numeric"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">

                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'versionNo'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'versionNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'versionNo';" ng-class="(sortedColumn == 'versionNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Version No</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'effectiveFromDate')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'effectiveFromDate';" ng-class="(sortedColumn == 'effectiveFromDate')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Effective From Date</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'verifiedStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifiedStatus';" ng-class="(sortedColumn == 'verifiedStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Verified Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.versionNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.versionNo=x.versionNo; vm.effectiveFromDate = x.effectiveFromDate; "  data-bs-dismiss="modal">
                                    <td>{{x.versionNo}}</td>
                                    <td>{{x.effectiveFromDate}}</td>
                                    <td>{{x.verifiedStatus | getLabelFromValuesArray : vm.commonYesNoMetaData}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.versionNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>



<div class="modal" id="schemeNameSearcherPopUp" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Name of the bond scheme</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeNameList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric" ng-model="vm.schemeCode" ng-init="vm.schemeCode = ''" placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'schemeName'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';" ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';" ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Scheme Status</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeNameList | filter:vm.schemeCode | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode=x.schemeCode;vm.schemeName=x.schemeName"  data-bs-dismiss="modal">
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                <!--                                <tr class="cp" ng-repeat="x in vm.branchIdList" ng-click="vm.searchBranchId = x.branchId;vm.branchName = x.branchName;vm.crn.no=x.crn.no;" data-bs-dismiss="modal">-->
                                <!--                                    <td>{{x.branchId}}</td>-->
                                <!--                                    <td>{{x.branchName}}</td>-->
                                <!--                                </tr>-->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeNameList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>