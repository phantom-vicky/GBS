<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.populationreportData">

    <div class="text-right form_submit">

        <button type="submit" class="btn btn-default" onclick="window.location.href ='#!/dc';" id="homeButton">Home</button>

        <button type="submit" id="backButton" class="btn btn-cancel" onclick="window.location.href= '#!/population_report/action/inquiry';">Back</button>

    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="col-sm-12">


<!--            <table width="100%" class="table table-bordered">-->
<!--                <tr height="40">-->
<!--                    <h4 class="form_heading">Population Report</h4>-->
<!--                </tr>-->
<!--            </table>-->

            <div class="row">
                <h4 class="form_heading">Population Report</h4>
                <sol-header></sol-header>
                <table style="width:100%" class="table table-bordered" style="padding: 10px"
                       aria-label="Role Rights table">
                    <tr>
                        <th scope="" style="width:20%">As on Date (dd/mm/yyyy)</th>
                        <td style="width:20%">{{vm.date | date:'dd/MM/yyyy'}}</td>
                        <th scope="" style="width:20%">Total Count</th>
                        <td style="width:20%">{{vm.total}}</td>
                    </tr>
                </table>
            </div>

            <div class="row">
                <div class="col-sm-12">
                    <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                        <div class="col-sm-3" style="flex: 1">
                            <div class="form-group">
                                <table style="border-spacing: 2" aria-label="BLA Modification">
                                    <tr>
                                        <th scope="col"></th>
                                    </tr>
                                    <tr>
                                        <td>Show&nbsp;</td>
                                        <td>
                                            <select class="form-control pageDropDown" id="pageSize"
                                                    name="pageSize" data-ng-model="vm.pageSize"
                                                    data-ng-init="vm.pageSize='5'"
                                                    data-ng-change="vm.pageNo = 1; vm.getPopulationData();"
                                                    ng-disabled="vm.noDataFoundInSearch">
                                                <option value="5">5 per page</option>
                                                <option value="10">10 per page</option>
                                                <option value="20">20 per page</option>
                                                <option value="50">50 per page</option>
                                            </select>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                            <div class="form-group" style="margin-right: 15px">
                                <div class="input-group">
                                    <input type="text" id="search" class="form-control" data-ng-model="vm.searchValue" placeholder="Search" />
                                    <div class="input-group-addon">
                                        <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getPopulationData()"></span>
                                    </div>
                                    <div class="input-group-addon">
                                        <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchValue='';vm.pageNo = 1; vm.getPopulationData()"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <select class="form-control" id="export"
                                        name="export" data-ng-model="vm.selectedOption"
                                        data-ng-disabled="vm.noDataFoundInSearch"
                                        data-ng-init="vm.downloadType=''" data-ng-change="vm.getDownload()">
                                    <option value="">EXPORT</option>
                                    <option value="excel">EXCEL</option>
<!--                                    <option value="csv">CSV</option>-->
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list table-textWrap">
                            <thead data-ng-if="!vm.noDataFoundInSearch">
                            <tr class="thalign">
                                <th>S.No</th>
                                <th>User ID</th>
                                <th>User Name</th>
                                <th>Employee Code</th>
                                <th>Branch Code</th>
                                <th>Branch Name</th>
                                <th>Department Code</th>
                                <th>Department Name</th>
                                <th>Profile</th>
                                <th>Status</th>
                                <th>Creation Date & Time</th>
<!--                                <th>Creation Time</th>-->
                                <th>Last Password Changed Date & Time</th>
<!--                                <th>Last Password Changed time</th>-->
                                <th>Last Login Date & Time</th>
<!--                                <th>Last Login time</th>-->
                                <th>Last Modified Maker ID & Name</th>
                                <th>Maker Date & Time</th>
<!--                                <th>Maker time</th>-->
                                <th>Last Modified Checker ID & Name</th>
                                <th>Checker Date & Time</th>
<!--                                <th>Checker time</th>-->
                                <th>Disabled Date & Time</th>
<!--                                <th>Disabled time</th>-->
                                <th>Profile End/Deletion date & time</th>
<!--                                <th>Profile End/Deletion time</th>-->

                            </tr>
                            <tbody data-ng-if="!vm.noDataFoundInSearch">
                            <!--                            <tr >-->

                            <tr dir-paginate="x in vm.populationreportData | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
<!--                                <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>-->

                                <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                                <!--
                                                             <td>{{x.sNo}}</td>-->

                                <td>{{x.userId}}</td>
                                <td>{{x.userName}}</td>
                                <td>{{x.employeeCode}}</td>
                                <td>{{x.branchCode}}</td>
                                <td>{{x.branchName}}</td>
                                <td>{{x.departmentCode}}</td>
                                <td>{{x.departmentName}}</td>
                                <td>{{x.roleName}}</td>
                                <td>{{x.status}}</td>
                                <td>{{x.creationDateTime}}</td>
<!--                                <td>{{x.creationDateTime.split(" ").length === 2 ? x.creationDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.lastPwdChangedDateTime}}</td>
<!--                                <td>{{x.lastPwdChangedDateTime.split(" ").length === 2 ? x.lastPwdChangedDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.lastLoginDateTime}}</td>
<!--                                <td>{{x.lastLoginDateTime.split(" ").length === 2 ? x.lastLoginDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.lastModifiedIdName}}</td>
                                <td>{{x.lastModifiedDateTime}}</td>
<!--                                <td>{{x.lastModifiedDateTime.split(" ").length === 2 ? x.lastModifiedDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.lastCheckerId}}</td>
                                <td>{{x.lastCheckerDateTime}}</td>
<!--                                <td>{{x.lastCheckerDateTime.split(" ").length === 2 ? x.lastCheckerDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.disabledDateTime}}</td>
<!--                                <td>{{x.disabledDateTime.split(" ").length === 2 ? x.disabledDateTime.split(" ")[1] : null;}}</td>-->
                                <td>{{x.deletionDateTime}}</td>
<!--                                <td>{{x.deletionDateTime.split(" ").length === 2 ? x.deletionDateTime.split(" ")[1] : null;}}</td>-->

                            </tr>
                            </tbody>

                            <tbody data-ng-if="vm.noDataFoundInSearch">
                            <tr>
                                <td style="text-align: center">No Records Found</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>


                <div class="text-center form_submit">
        <span data-ng-show="vm.showPrevious">
          <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
        </span>
                    <span>
          <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
        </span>
                    <span data-ng-show="vm.showNext">
          <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
        </span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Population Report</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/population_report/action/inquiry';" >Back</button>
        </center>
    </div>
</div>


