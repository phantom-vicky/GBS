<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">{{vm.screenModule}} TOC Sharing Maintenance - Verify</h4>
    <sol-header></sol-header>
    <form name="tocSharingMaintenanceForm" role="form">

        <table class="table table-bordered table-striped list old-new-value-table">
            <tr>
                <td width="70%">Module</td>
                <td width="30%" style="text-transform: uppercase;">{{vm.moduleId | getLabelFromValuesArray : vm.moduleNameDetailsLabelValue}}</td>
            </tr>
        </table>

        <table class="table table-bordered table-striped list old-new-value-table">

            <thead>
            <tr>
                <th width="70%">Particular</th>
                <th>{{(vm.auditInfo.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th ng-if="vm.auditInfo.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>

            <tr>
                <td width="70%">Version No</td>
                <td class="old-value">{{(vm.versionEffDateDetails && vm.versionEffDateDetails.C002) ? (vm.versionEffDateDetails.C002.oldValue ) : ('')}}
                </td>
                <td ng-if="vm.auditInfo.previousOperationType == 'M'" class="new-value">
                    {{(vm.versionEffDateDetails && vm.versionEffDateDetails.C002) ? (vm.versionEffDateDetails.C002.newValue) : ('')}}
                </td>
            </tr>

            <tr>
                <td width="70%">Effective From Date</td>
                <td class="old-value">{{(vm.versionEffDateDetails && vm.versionEffDateDetails.C004) ? (vm.versionEffDateDetails.C004.oldValue ) : ('')}}
                </td>
                <td ng-if="vm.auditInfo.previousOperationType == 'M'" class="new-value">
                    {{(vm.versionEffDateDetails && vm.versionEffDateDetails.C004) ? (vm.versionEffDateDetails.C004.newValue) : ('')}}
                </td>
            </tr>
            <tr ng-repeat="item in vm.tocSharingList">
                <td width="70%">Sharing of {{item.C003.oldValue}} %</td>
                <td class="old-value">{{(item && item.C007)?
                    (item.C007.oldValue ) : ('')}}
                </td>
                <td ng-if="vm.auditInfo.previousOperationType == 'M'" class="new-value">{{(item && item.C007)?
                    (item.C007.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td width="70%">Rounding Factor</td>
                <td class="old-value" style="text-transform: uppercase;">{{(vm.roundOffValue)? (vm.roundOffValue.oldValue | getLabelFromValuesArray : vm.roundOff) : ('')}}
                </td>
                <td ng-if="vm.auditInfo.previousOperationType == 'M'" class="new-value" style="text-transform: uppercase;">
                    {{(vm.roundOffValue)? (vm.roundOffValue.newValue | getLabelFromValuesArray : vm.roundOff) : ('')}}
                </td>
            </tr>
            </tbody>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b style="margin-right: 1px;"> Created By </b> : {{vm.auditInfo.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b style="margin-right: 1px;"> Last Modified By </b> : {{(vm.auditInfo.modifiedBy) ? (vm.auditInfo.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b style="margin-right: 1px;"> Last Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : <span style="text-transform: uppercase;">{{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.auditInfo.modifiedDate) ? (vm.auditInfo.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="tocSharingMaintenanceForm.$invalid" ng-click="vm.submitVerifyForm()">Verify</button>
            <button type="button" id="cancelButton" class="btn btn-cancel"
                    ng-click="vm.showCancelConfirmation();">Cancel
            </button>
        </div>

    </form>
</div>
