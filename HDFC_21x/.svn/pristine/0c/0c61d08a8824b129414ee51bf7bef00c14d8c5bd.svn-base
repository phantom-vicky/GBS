<div class="container from_wrapper">
	<div class="loader-new" ng-if="vm.loader"></div>
	<left-menu-directive></left-menu-directive>

	<h4 class="form_heading">Place Holders Definition - Modification</h4>
	<div class="row" ng-if="vm.showModifyForm == false">
		<form name="generalSchemeParameterMaintenanceForm" role="form"
			ng-submit="submitForm(generalSchemeParameterMaintenanceForm.$valid)"
			novalidate>

			<div class="row">
				<div class="form-group">
					<div class="col-sm-2"></div>
					<label for="schemeType" class="control-label col-sm-5">
						Scheme Type</label>
					<div class="col-sm-2">
						<select class="form-control" id="schemeType" name="schemeType"
							ng-model="vm.schemeType" ng-init="vm.schemeType=''">
							<option value="">Select</option>
							<option value="common">Common</option>
							<option value="cbdt">CBDT</option>
							<option value="cbec">CBEC</option>
						</select>
					</div>
				</div>
			</div>
			<div class="col-sm-offset-5 col-sm-8 form_submit">
				<button type="submit" class="btn btn-default"
					ng-disabled="generalSchemeParameterMaintenanceForm.$invalid" ng-click="vm.submitModifySearcherForm()">Submit</button>
				<button type="button" id="cancelButton" class="btn btn-cancel"
					onclick="window.location.href ='#!/dc';">Cancel</button>
			</div>
		</form>
	</div>
	<!-- common -->
	<div class="row" ng-if="vm.showModifyForm == true">
		<div class="container">
			<form name="generalSchemeParameterMaintenanceForm" role="form"
				ng-submit="submitModifyForm(generalSchemeParameterMaintenanceForm.$valid)"
				novalidate>

				<div id="schemeType" ng-if="vm.schemeType == 'common'">

					<h4 class="form_heading">Common</h4>


					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Financial Year Start Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="financialYearStartDdate"
									ng-model="vm.financialYearStartDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="financialYearStartMonth"
									ng-model="vm.financialYearStartMonth">
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Financial Year End Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="financialYearEndDate" ng-model="vm.financialYearEndDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="financialYearEndMonth" ng-model="vm.financialYearEndMonth">
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Budget Year Start Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control" id="budgetStartDate"
									ng-model="vm.budgetStartDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control" id="budgetStartMonth"
									ng-model="vm.budgetStartMonth">
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Budget Year End Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control" id="budgetEndDate"
									ng-model="vm.budgetEndDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control" id="budgetEndMonth"
									ng-model="vm.budgetEndMonth">
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="age" class="control-label col-sm-5"> Minor
								Age</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="age"
									ng-model="vm.age" chars="only-numbers" onkeypress="return isNumber(event)">
							</div>

						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="instrumentValidation" class="control-label col-sm-5">
								Instrument Type for Instrument Validation</label>
							<div class="col-sm-2">
								<input type="text" class="form-control"
									id="instrumentValidation" ng-model="vm.instrumentValidation" chars="alpha-numeric"">
							</div>

						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="eodpending" class="control-label col-sm-5">
								Can EOD Continue If NFT Verification Is Pending</label>
							<div class="col-sm-2">
								<select class="form-control" id="eodpending" name="eodpending"
									ng-model="vm.eodpending">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>

							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="tocAmount" class="control-label col-sm-5">
								Minimum TOC Amount</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="tocAmount"
									ng-model="vm.tocAmount" chars="only-numbers" onkeypress="return isNumber(event)">
							</div>

						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="tocMode" class="control-label col-sm-5"> Turn
								Over Commission Mode</label>
							<div class="col-sm-2">
								<select class="form-control" id="tocMode" name="tocMode"
									ng-model="vm.tocMode">
									<option value="">Annual</option>
									<option value="1">Half-Yearly</option>
									<option value="2">Quarterly</option>
								</select>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cashAccount" class="control-label col-sm-5">Cash
								Account Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="cashAccount"
									name="cashAccount" ng-model="vm.cashAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cashAccountModal" id="cashAccountSearcher"
									ng-click="vm.getcashAccountDetails(vm.cashAccount)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cashAccount='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="clearingAccount" class="control-label col-sm-5">Clearing
								Sundry Account Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="clearingAccount"
									name="clearingAccount" ng-model="vm.clearingAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#clearingAccountModal" id="cashAccountSearcher"
									ng-click="vm.getclearingAccountDetails(vm.clearingAccount)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.clearingAccount='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="rbiBond" class="control-label col-sm-5">RBI
								Relief Bond LC Consolidation Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="rbiBond"
									name="rbiBond" ng-model="vm.rbiBond" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#rbiBondModal" id="cashAccountSearcher"
									ng-click="vm.getrbiBondDetails(vm.rbiBond)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.rbiBond='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="ddAccount" class="control-label col-sm-5">DD
								A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="ddAccount"
									name="ddAccount" ng-model="vm.ddAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#ddAccountModal" id="cashAccountSearcher"
									ng-click="vm.getddAccountDetails(vm.ddAccount)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.ddAccount='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="payOrderAccount" class="control-label col-sm-5">Pay
								Order A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="payOrderAccount"
									name="payOrderAccount" ng-model="vm.payOrderAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#payOrderAccountModal" id="payOrderAccountSearcher"
									ng-click="vm.getpayOrderAccountDetails(vm.payOrderAccount)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.payOrderAccount='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="ecsAccount" class="control-label col-sm-5">ECS
								A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="ecsAccount"
									name="ecsAccount" ng-model="vm.ecsAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#ecsAccountModal" id="ecsAccountSearcher"
									ng-click="vm.getecsAccountDetails(vm.ecsAccount)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.ecsAccount='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="tdsAccount" class="control-label col-sm-5">TDS
								A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="tdsAccount"
									name="tdsAccount" ng-model="vm.tdsAccount" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#tdsAccountModal" id="tdsAccountSearcher"
									ng-click="vm.gettdsAccountDetails(vm.tdsAccount)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.tdsAccount='';"></i>
							</div>
						</div>
					</div>
				</div>
				<!-- common -->

				<!-- CBDT -->


				<div id="schemeType" ng-if="vm.schemeType == 'cbdt'">
					<h4 class="form_heading">CBDT</h4>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Residual Year Start Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="residualYearStartDate" ng-model="vm.residualYearStartDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="residualYearStartMonth"
									ng-model="vm.residualYearStartMonth">
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="schemeType" class="control-label col-sm-5">
								Residual Year End Period(DD/MM)</label>
							<div class="col-sm-1">
								<input type="text" class="form-control" id="residualYearEndDate"
									ng-model="vm.residualYearEndDate">
							</div>

							<div class="col-sm-1">
								<input type="text" class="form-control"
									id="residualYearEndMonth" ng-model="vm.residualYearEndMonth">
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cbdtCollectionAccount" class="control-label col-sm-5">CBDT
								Collection A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control"
									id="cbdtCollectionAccount" name="cbdtCollectionAccount"
									ng-model="vm.cbdtCollectionAccount" chars="alpha-numeric"">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cbdtCollectionAccountModal" id="cbdtCollectionAccountSearcher"
									ng-click="vm.getcbdtCollectionAccountDetails(vm.cbdtCollectionAccount)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cbdtCollectionAccount='';"></i>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cbdtFocalPoint" class="control-label col-sm-5">CBDT
								Focal Point Consolidation A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="cbdtFocalPoint"
									name="cbdtFocalPoint" ng-model="vm.cbdtFocalPoint" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cbdtFocalPointModal" id="cbdtFocalPointSearcher"
									ng-click="vm.getcbdtFocalPointDetails(vm.cbdtFocalPoint)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cbdtFocalPoint='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cbdtLinkCell" class="control-label col-sm-5">CBDT
								Link Cell Consolidation A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="cbdtLinkCell"
									name="cbdtLinkCell" ng-model="vm.cbdtLinkCell" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cbdtLinkCellModal" id="cbdtLinkCellSearcher"
									ng-click="vm.getcbdtLinkCellDetails(vm.cbdtLinkCell)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cbdtLinkCell='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cbdtIncome" class="control-label col-sm-5">CBDT
								Income A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="cbdtIncome"
									name="cbdtIncome" ng-model="vm.cbdtIncome" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cbdtIncomeModal" id="cbdtIncomeSearcher"
									ng-click="vm.getcbdtIncomeDetails(vm.cbdtIncome)"></i> <i
									class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cbdtIncome='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="cbdtInternetParking" class="control-label col-sm-5">CBDT
								Internet Parking A/C Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="cbdtInternetParking"
									name="cbdtInternetParking" ng-model="vm.cbdtInternetParking" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#cbdtInternetParkingModal" id="cbdtInternetParkingSearcher"
									ng-click="vm.getcbdtInternetParkingDetails(vm.cbdtInternetParking)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.cbdtInternetParking='';"></i>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="bodpending" class="control-label col-sm-5">
								Can MCP be allowed, even If Consolidation is pending for Braches
								?</label>
							<div class="col-sm-2">
								<select class="form-control" id="cbdtMcpAllowed"
									name="cbdtMcpAllowed" ng-model="vm.cbdtMcpAllowed">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>

							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="bodpending" class="control-label col-sm-5">
								Is funds transfer to LC instead of FP permitted during MCP</label>
							<div class="col-sm-2">
								<select class="form-control" id="lcInsteadeofFp"
									name="lcInsteadeofFp" ng-model="vm.lcInsteadeofFp">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="bodpending" class="control-label col-sm-5">Is
								Retention allowed</label>
							<div class="col-sm-2">
								<select class="form-control" id="isRetensionAllowed"
									name="isRetensionAllowed" ng-model="vm.isRetensionAllowed">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="bodpending" class="control-label col-sm-5">
								Is CROWN Data file Received - Nodal Branch</label>
							<div class="col-sm-2">
								<select class="form-control" id="crownNodalBranch"
									name="crownNodalBranch" ng-model="vm.crownNodalBranch">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="bodpending" class="control-label col-sm-5">
								Is CROWN Data file Received - Link Cell</label>
							<div class="col-sm-2">
								<select class="form-control" id="crownLinkCell"
									name="crownLinkCell" ng-model="vm.crownLinkCell">
									<option value="">Select</option>
									<option value="Y">Yes</option>
									<option value="N">No</option>

								</select>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="errorTransaction" class="control-label col-sm-5">Error
								Challan Transaction Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="errorTransaction"
									name="errorTransaction" ng-model="vm.errorTransaction" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#errorTransactionModal" id="errorTransactionSearcher"
									ng-click="vm.geterrorTransactionDetails(vm.errorTransaction)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.errorTransaction='';"></i>
							</div>
						</div>
					</div>

					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="errorCollection" class="control-label col-sm-5">Error
								Challan Collection Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="errorCollection"
									name="errorCollection" ng-model="vm.errorCollection" chars="alpha-numeric">
							</div>
							<div class="col-sm-2 torch-top">
								<i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
									data-target="#errorCollectionModal" id="errorCollectionSearcher"
									ng-click="vm.geterrorCollectionDetails(vm.errorCollection)"></i>
								<i class="glyphicon glyphicon-remove clear cp"
									ng-click="vm.errorCollection='';"></i>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="form-group">
							<div class="col-sm-2"></div>
							<label for="errorNodalBranch" class="control-label col-sm-5">Error
								Challan Nodal Branch Collection Place Holder</label>
							<div class="col-sm-2">
								<input type="text" class="form-control" id="errorNodalBranch"
