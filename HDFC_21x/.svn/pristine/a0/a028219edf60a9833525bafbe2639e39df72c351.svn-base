			</td>
		</tr>
		<tr>
			<td>State Name</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C011)?
				(vm.oldNewValueList.C011.oldValue) : ('')}}
			</td>
			<td class="new-value" ng-if="vm.result.prevOperationType == 'M'">{{vm.oldNewValueList &&
				vm.oldNewValueList.C011? (vm.oldNewValueList.C011.newValue) : ('')}}
			</td>
		</tr>
		<tr>
			<td>Pin Code</td>
			<td class="old-value">{{(vm.oldNewValueList && vm.oldNewValueList.C012)?
