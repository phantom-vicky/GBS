<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">
    Disabling /Deactivating of brokers after 2 years of non-sourcing
  </h4>
  <sol-header></sol-header>

  <form name="disablingDeactivatingForm" role="form">
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-5">
          <label><b>RBI Bond</b></label>
        </div>
      </div>
    </div>
    <!--SBroker Agency Code-->
    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Broker Agency Code</label>
        </div>
        <div class="col-sm-2">
          <input
            type="text"
            class="form-control"
            data-ng-model="vm.brokerAgencyCode"
            readonly
          />
        </div>
        <div
          class="col-sm-2"
          style="
            display: flex;
            align-items: center;
            height: 34px;
            gap: 5px;
            padding-left: 0;
          "
        >
          <span
            class="glyphicon glyphicon-search cp"
            data-toggle="schemeName"
            data-ng-click="vm.getBrokerCode();"
          ></span>
          <span
            class="glyphicon glyphicon-remove clear cp"
            data-ng-click="vm.brokerAgencyCode=''"
          ></span>
        </div>
      </div>
    </div>

    <!--Scheme name-->
    <!--    <div class="row">-->
    <!--      <div class="form-group required">-->
    <!--        <div class="col-sm-3"></div>-->
    <!--        <div class="col-sm-3">-->
    <!--          <label class="control-label">Name of the Bond Scheme</label>-->
    <!--        </div>-->
    <!--        <div class="col-sm-2">-->
    <!--          <input-->
    <!--            type="text"-->
    <!--            class="form-control"-->
    <!--            id="schemeCode"-->
    <!--            data-ng-model="vm.schemeName"-->
    <!--            required-->
    <!--            readonly-->
    <!--          />-->
    <!--        </div>-->
    <!--        <div-->
    <!--          class="col-sm-2"-->
    <!--          style="-->
    <!--            display: flex;-->
    <!--            align-items: center;-->
    <!--            height: 34px;-->
    <!--            gap: 5px;-->
    <!--            padding-left: 0;-->
    <!--          "-->
    <!--        >-->
    <!--          <span-->
    <!--            class="glyphicon glyphicon-search cp"-->
    <!--            data-toggle="schemeName"-->
    <!--            id="treasurySearcher"-->
    <!--            data-ng-click="vm.getModuleName();"-->
    <!--          ></span>-->
    <!--          <span-->
    <!--            class="glyphicon glyphicon-remove clear cp"-->
    <!--            data-ng-click="vm.schemeCode ='';vm.schemeName =''; vm.schemeStatus='';-->
    <!--            vm.fromDate=''; vm.toDate='';"-->
    <!--          ></span>-->
    <!--        </div>-->
    <!--      </div>-->
    <!--    </div>-->

    <!--Status-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Status</label>
        </div>
        <div class="col-sm-2">
          <select
            class="form-control"
            id="financialYear"
            name="financialYear"
            data-ng-model="vm.status"
            data-ng-change="vm.setFinancialYear(vm.financialYear)"
            required
          >
            <option value="">Select</option>
            <option value="Disable">Disable</option>
            <option value="De-Activated">De-Activated</option>
            <option value="Active">Active</option>
            <option value="ALL">ALL</option>
          </select>
        </div>
      </div>
    </div>

    <!--FROM DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">From Date</label>
        </div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="efffromDate1"
              name="efffromDate"
              data-ng-model="vm.fromDate"
              data-uib-datepicker-popup="dd/MM/yyyy"
              data-ng-init="vm.fromDate=''; vm.fromDateVal()"
              data-ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
              data-datepicker-options="vm.fromDateOptions"
              data-is-open="vm.efffromDatePicker.opened"
              data-close-text="Close"
              maxlength="10"
              data-ng-blur="vm.textableDatePicker('efffromDate1',vm.fromDate)"
              data-ng-keyup="vm.autoslashing('efffromDate1')"
              data-chars="numbers-slash"
              required
            />
            <span class="input-group-btn" data-ng-if="vm.status">
              <button
                type="button"
                class="btn btn-secondary"
                data-ng-click="vm.efffromDatePicker.opened = true"
                id="efffromDateSearcher1"
              >
                <span class="glyphicon glyphicon-calendar"></span>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <!--TO DATE-->
    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">To Date</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="efftoDate"
              name="efftoDate"
              data-ng-model="vm.toDate"
              data-uib-datepicker-popup="dd/MM/yyyy"
              data-ng-init="vm.toDate=''"
              data-datepicker-options="vm.toDateOptions"
              data-is-open="vm.efftoDatePicker.opened"
              data-close-text="Close"
              maxlength="10"
              data-ng-blur="vm.textableDatePicker('efftoDate',vm.toDate)"
              data-ng-keyup="vm.autoslashing('efftoDate')"
              data-chars="numbers-slash"
              required
            />
            <span class="input-group-btn" data-ng-if="vm.fromDate">
              <button
                type="button"
                class="btn btn-secondary"
                data-ng-click="vm.efftoDatePicker.opened = true"
                id="efftoDateSearcher"
              >
                <span class="glyphicon glyphicon-calendar"></span>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <div class="text-center form_submit">
      <button
        type="submit"
        class="btn btn-default"
        id="submitButton"
        data-ui-sref="disabling_deactivating_of_brokers.inquiry_detail({obj:{
								status: vm.status,
								brokerAgencyCode : vm.brokerAgencyCode,
                                fromDate:vm.fromDate,
                                toDate: vm.toDate,
								}})"
        data-ng-disabled="disablingDeactivatingForm.$invalid"
      >
        Submit
      </button>
      <button
        type="button"
        class="btn btn-cancel"
        id="cancelButton"
        onclick="window.location.href = '#!/rbibond_gu_functionality'"
      >
        Cancel
      </button>
    </div>
    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>

<!--Scheme Name  and Status Model-->
<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button
          type="button"
          class="close"
          data-bs-dismiss="modal"
          data-ng-click="vm.modalSearch=''"
        >
          &times;
        </button>
        <h4 class="modal-title">Name of the Bond Scheme</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input
                  type="text"
                  class="form-control"
                  data-ng-model="vm.modalSearch"
                  data-ng-init="vm.modalSearch = ''"
                  placeholder="Search"
                  oninput="
                    this.value = this.value
                      .replace(/^\s+/, '')
                      .replace(/\s{2,}/g, ' ')
                  "
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table
                class="table table-bordered list scroll sort"
                aria-label=""
              >
                <thead
                  data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'"
                >
                  <tr>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Scheme Name
                    </th>
                    <th
                      scope="col"
                      class="modal-title title-case"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    data-ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                    data-ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemeStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length==0">
          No records found to display.
        </div>
      </div>
    </div>
  </div>
</div>

<!--Broker Agency Code-->
<div class="modal" id="brokerModel" role="dialog">
  <div class="modal-dialog">
    <!-- Modal content-->
    <div class="modal-content">
      <div class="modal-header">
        <button
          type="button"
          class="close"
          data-bs-dismiss="modal"
          data-ng-click="vm.searchSolId=''"
        >
          &times;
        </button>
        <h4 class="modal-title">Broker Agency Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.brokerAgencyCodeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input
                  type="text"
                  class="form-control"
                  data-ng-model="vm.searchSolId"
                  data-ng-init="vm.searchSolId = ''"
                  placeholder="Search"
                  minlength="4"
                  maxlength="10"
                  oninput="
                    this.value = this.value
                      .replace(/^\s+/, '')
                      .replace(/[^0-9a-zA-Z\s]/g, '')
                      .replace(/\s{2,}/g, ' ')
                  "
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table
                class="table table-bordered list scroll sort"
                aria-label=""
              >
                <thead
                  data-ng-init="reverseOrder=false;sortedColumn = 'brokerAgencyCode'"
                >
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';"
                      data-ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Agency Code
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';"
                      data-ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Name
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'branchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchId';"
                      data-ng-class="(sortedColumn == 'branchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Branch ID
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'verifyStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'verifyStatus';"
                      data-ng-class="(sortedColumn == 'verifyStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Verify Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    data-ng-repeat="x in vm.brokerAgencyCodeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                    data-ng-click="vm.brokerAgencyCode= x.brokerAgencyCode;vm.brokerName= x.brokerName;vm.branchId=x.branchId; vm.verifyStatus = x.verifyStatus;"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.brokerAgencyCode}}</td>
                    <td>{{x.brokerName}}</td>
                    <td>{{x.branchId}}</td>
                    <td>{{x.verifyStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div
          class="list_wrapper"
          data-ng-if="vm.brokerAgencyCodeList.length==0"
        >
          No records found to display.
        </div>
      </div>
    </div>
  </div>
</div>
