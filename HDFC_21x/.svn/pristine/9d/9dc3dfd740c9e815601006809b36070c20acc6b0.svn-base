    /**
     * Find by key.
     *
     * @param key the key
     * @return the nps scheme parameter keys 1
     */
    public static GbmCBECSchemeParameterKeys findByKey(final String key) {
        for (final GbmCBECSchemeParameterKeys gbmCBECSchemeParameterKeys : values()) {
            if (gbmCBECSchemeParameterKeys.getKey().equals(key)) {
                return gbmCBECSchemeParameterKeys;
            }
        }
        return null;
    }

    /**
     * The key.
     */
    private String key;

    /**
     * The description.
     */
    private String description;

    /**
     * Instantiates a new nps scheme parameter keys 1.
     *
     * @param key         the key
     * @param description the description
     * @return
     */
    private GbmCBECSchemeParameterKeys(final String key, final String description) {
        this.key = key;
        this.description = description;
    }

    /**
     * Gets the description.
     *
     * @return the description
     */
    public String getDescription() {
        return this.description;
    }

    /**
     * Gets the key.
     *
     * @return the key
     */
    public String getKey() {
        return this.key;
    }

}
