package com.isl.gbm.user.management.dao;

import com.isl.gbm.user.management.model.AdminLog;

import java.util.Date;
import java.util.List;

/**
 * The Class AdminLogDao.
 */
public interface AdminLogDao {

    /**
     * Save.
     *
     * @param adminLog the admin log
     */
    void save(AdminLog adminLog);

    /**
     * Gets the admin activity logs.
     *
     * @param date the date
     * @return the admin activity logs
     */
    List<AdminLog> getAdminActivityLogs(Date date);
}
