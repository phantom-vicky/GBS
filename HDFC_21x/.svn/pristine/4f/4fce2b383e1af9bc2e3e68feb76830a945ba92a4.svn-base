<div class="container from_wrapper">
<left-menu-directive></left-menu-directive>	
	<h4 class="form_heading">New Pension Scheme Parameter - Inquiry</h3>
	
<div class="row">
				<h5 class="col-sm-12 tc">
					<b>Scheme Type - New Pension Scheme</b>
				</h5>
			</div>
	<div class="loader"></div>
	<table class="table table-bordered table-striped list">
	    <thead>
	      <tr>
	        <th>Particular</th>
	        <th>Value</th>
	        <th>Description</th>
	       
	      </tr>
	    </thead>
	    <tbody>
	      <tr >
	        <td>Minimum Age Limit</td>
	        <td>{{schemeParameter.minAgeLimit}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Maximum Age Limit</td>
	        <td>{{schemeParameter.maxAgeLimit}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Number of Contribution in a Year</td>
	        <td>{{schemeParameter.minNoOfContrYr}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Initial Contribution Amount for Tier I Rs</td>
	        <td>{{schemeParameter.minAmtPerInitContT1}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Contribution Amount for Tier I Rs.</td>
	        <td>{{schemeParameter.minAmtPerContT1}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Initial Contribution Amount for Tier II Rs</td>
	        <td>{{schemeParameter.minAmtPerInitContT2}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Contribution Amount for Tier II Rs</td>
	        <td>{{schemeParameter.minAmtPerContT2}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Tier I Contribution per Year in Rs</td>
	        <td>{{schemeParameter.minContributionPerYr}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Maximum Number of Nominations</td>
	        <td>{{schemeParameter.maxNoOfNomination}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Minimum Tier II Contribution per Year in Rs</td>
	        <td>{{schemeParameter.minContributionPerYrT2}}</td>
	        <td></td>
	      </tr>
	       <tr >
	        <td>Remittance A/C for POP branch</td>
	        <td>{{schemeParameter.remittanceAcPlaceHolder}}</td>
	        <td>{{schemeParameter.remittanceAcTitle}}</td>
	      </tr>
	       <tr >
	        <td>Cash Account Place Holder</td>
	        <td>{{schemeParameter.phCashAc}}</td>
	        <td>{{schemeParameter.phCashAcTitle}}</td>
	      </tr>
	       <tr >
	        <td>Clearing Sundry Account Place Holder</td>
	        <td>{{schemeParameter.phClearingAc}}</td>
	        <td>{{schemeParameter.phClearingAcTitle}}</td>
	      </tr>
	       <tr >
	        <td>Internet Parking Account Number</td>
	        <td>{{schemeParameter.inetAcPlaceHolder}}</td>
	        <td>{{schemeParameter.inetAcTitle}}</td>
	      </tr>
	    </tbody>
	 </table>
	 
		<div class="row">
				<div class="col-sm-offset-5 col-sm-8 form_submit">
					<button type="button" class="btn btn-cancel" ui-sref="dc_nps_menu">Cancel</button>
				</div>
		</div>

  </div>
