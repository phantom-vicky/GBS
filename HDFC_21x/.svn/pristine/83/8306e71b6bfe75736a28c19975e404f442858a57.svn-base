                                            (vm.getDetails.guardianDetailsValueModel[0].C009.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsListMetaData)) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.guardianDetailsValueModel[0] &&
                                            vm.getDetails.guardianDetailsValueModel[0].C009? (vm.getDetails.guardianDetailsValueModel[0].C009.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.guardianDetailsListMetaData)) : ('')}}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Date of Birth</td>
                                        <td class="old-value">{{(vm.getDetails.guardianDetailsValueModel[0] && vm.getDetails.guardianDetailsValueModel[0].C010)?
