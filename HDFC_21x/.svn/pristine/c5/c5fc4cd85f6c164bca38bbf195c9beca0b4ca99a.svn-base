<div class="modal" id="brokerDetailsModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Broker Details List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.brokerDetailsList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <!-- Search Icon Click -->
                                <div class="input-group-addon cp" ng-click="vm.appliedSearch = vm.searchTranCode" title="Click to search">

                                <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchTranCode"
                                       ng-init="vm.searchTranCode = ''; vm.appliedSearch = ''"
                                       placeholder="Search"
                                       ng-change="vm.searchTranCode === '' ? (vm.appliedSearch = '') : null"
                                       ng-keyup="$event.keyCode === 13 && (vm.appliedSearch = vm.searchTranCode)">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'clgTranCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerAgencyCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerAgencyCode';" ng-class="(sortedColumn == 'brokerAgencyCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">HDFC Broker Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'brokerName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'brokerName';" ng-class="(sortedColumn == 'brokerName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'operativeAccBranchId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'operativeAccBranchId';" ng-class="(sortedColumn == 'operativeAccBranchId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Broker Group</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.brokerDetailsList |  filter:vm.appliedSearch  | orderBy:sortedColumn:reverseOrder"
                                    ng-click=" vm.subscriptionDetailsValueModel.C011.oldValue = x.brokerAgencyCode;vm.subscriptionDetailsValueModel.C045.oldValue=x.brokerName; "
                                    data-bs-dismiss="modal">
                                    <td>{{x.brokerAgencyCode}}</td>
                                    <td>{{x.brokerName}}</td>
                                    <td>{{x.operativeAccBranchId}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.brokerDetailsList.length==0">No
                    records found to display.</div>
            </div>

        </div>
    </div>
</div>
