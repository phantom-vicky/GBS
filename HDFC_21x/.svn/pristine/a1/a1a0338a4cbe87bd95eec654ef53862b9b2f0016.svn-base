<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.subsAccDetailList.length>0">
  <div class="container from_wrapper new_form_wrapper">
    <div class="text-right form_submit">
      <button type="submit" class="btn btn-default" onclick="window.location.href ='#!';" id="homeButton">Home</button>
      <button type="submit" id="backButton" class="btn btn-cancel" onclick="window.location.href='#!/rbiBond_bond_inquiry_subs_acc_det_report/action/inquiry';">Back</button>
    </div>
    <div class="col-sm-12">
      <h4 class="form_heading">Subscription Account Opened Details</h4>
      <sol-header></sol-header>
      <table style="width: 100%" class="table table-bordered" aria-label="Subscription Account Opened Details">
        <tr>
          <th scope="col">Name of the Bond Scheme</th>
          <td colspan="3">{{vm.schemeName}}</td>
          <th scope="col">Total Count</th>
          <td>{{vm.total}}</td>
        </tr>
        <tr>
          <th scope="col" >Account Opened Date from</th>
          <td >{{vm.fromDate | date: 'dd/MM/yyyy'}}</td>

        </tr>
        <tr>
          <th scope="col" >Account Opened Date to</th>
          <td >{{vm.toDate | date: 'dd/MM/yyyy'}}</td>
        </tr>
      </table>

      <div class="row">
        <div class="col-sm-12">
          <div class="row" style="display: flex; align-items: center; justify-content: space-between">
            <div class="col-sm-3" style="flex: 1">
              <div class="form-group">
                <table style="border-spacing: 2" aria-label="Subscription Account Opened Details">
                  <tr>
                    <th scope="col"></th>
                  </tr>
                  <tr>
                    <td>Show&nbsp;</td>
                    <td>
                      <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                              ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                              ng-change="vm.pageNo = 1; vm.getDetails();" data-ng-disabled="vm.noDataFoundInSearch">
                        <option value="5">5 per page</option>
                        <option value="10">10 per page</option>
                        <option value="20">20 per page</option>
                        <option value="50">50 per page</option>
                      </select>
                    </td>
                  </tr>
                </table>
              </div>
            </div>

            <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
              <div class="form-group" style="margin-right: 15px">
                <div class="input-group">
                  <input type="text" id="search" class="form-control" data-ng-model="vm.searchText" placeholder="Search"/>
                  <div class="input-group-addon">
                    <span class="glyphicon glyphicon-search" data-ng-click=" vm.pageNo = 1; vm.getDetails();"></span>
                  </div>
                  <div class="input-group-addon">
                    <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchText=''; vm.pageNo = 1; vm.getDetails();"></span>
                  </div>
                </div>
              </div>
              <div class="form-group">
                <select class="form-control" id="export" name="export" data-ng-model="vm.downloadType" data-ng-init="vm.downloadType=''" data-ng-change="vm.downloadReport()" data-ng-disabled="vm.noDataFoundInSearch">
                  <option value="">EXPORT</option>
                  <option value="excel">EXCEL</option>
                </select>
              </div>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table table-bordered table-striped list table-textWrap datatable" aria-label="Subscription Account Opened Details">
              <thead data-ng-if="!vm.noDataFoundInSearch">
                <tr class="thalign">
                  <th scope="col">S.NO</th>
                  <th scope="col">Mode of Investment</th>
                  <th scope="col">BLA No.</th>
                  <th scope="col">Holder Name</th>
                  <th scope="col">Holder PAN No</th>
                  <th scope="col">Subscription ID</th>
                  <th scope="col">Date of Subscription</th>
                  <th scope="col">Maturity Date</th>
                  <th scope="col">Mode of Holding</th>
                  <th scope="col">Subscription Amount Rs</th>
                  <th scope="col">Subscription Status</th>
                </tr>
              </thead>
              <tbody data-ng-if="!vm.noDataFoundInSearch">
              <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                  <td style="text-align: center">{{x.modeOfInvestment}}</td>
                  <td style="text-align: center">{{x.blaNo}}</td>
                  <td style="text-align: left">{{x.holderName}}</td>
                  <td style="text-align: left">{{x.holderPanNo}}</td>
                  <td style="text-align: left">{{x.subsId}}</td>
                  <td style="text-align: left">{{x.dateOfSubs}}</td>
                  <td style="text-align: right">{{x.maturityDate}}</td>
                  <td style="text-align: left">{{x.modeOfHolding}}</td>
                  <td style="text-align: right">{{vm.indianNumberFormat(x.subsAmount)}}</td>
                  <td style="text-align: left">{{x.subsStatus}}</td>
                </tr>
              </tbody>
              <tfoot data-ng-if="!vm.noDataFoundInSearch">
                <tr>
                  <th style="text-align: left" colspan="8" scope="col"></th>
                  <th style="text-align: left" scope="col">Total</th>
                  <th class="text-right" scope="col">{{vm.indianNumberFormat(vm.totalSubscriptionAmount)}}</th>
                  <th scope="col"></th>
                </tr>
              </tfoot>
              <tbody data-ng-if="vm.noDataFoundInSearch">
              <tr>
                <td style="text-align:center">No Records Found</td>
              </tr>
              </tbody>
            </table>
          </div>
          <br />
          <div class="text-center form_submit">
              <span data-ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
              </span>

            <span>
                <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

            <span data-ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
              </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
  <div class="list_wrapper no_records_message">
    <h4 class="form_heading">Subscription Account Opened Details</h4>
    No records found to display.
    <div style="text-align: center">
      <button type="button" class="btn btn-default" onclick="window.location.href='#!/rbiBond_bond_inquiry_subs_acc_det_report/action/inquiry';">Back</button>
    </div>
  </div>
</div>
