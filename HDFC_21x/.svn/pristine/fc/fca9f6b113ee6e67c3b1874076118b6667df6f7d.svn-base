package com.isl.gbm.rbibond.dto.scrolls;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class BondRegisterLedgerAccDTO {
    private String branchId;
    private String branchName;
    private String schemeCode;
    private String fromDate;
    private String toDate;
    private String dateOfTransaction;
    private String noOfInvestmentAcc;
    private String totInvestmentAmt;
    private String noOfTnsfInAcc;
    private String noOfTnsfInAmt;
    private String noOfTnsfOutAcc;
    private String noOfTnsfOutAmt;
    private String noOfRepayAcc;
    private String noOfRepayAmt;
    private String totAcc;
    private String totAmt;

    public String getBranchId() {
        return branchId;
    }

    public void setBranchId(String branchId) {
        this.branchId = branchId;
    }

    public String getBranchName() {
        return branchName;
    }

    public void setBranchName(String branchName) {
        this.branchName = branchName;
    }

    public String getSchemeCode() {
        return schemeCode;
    }

    public void setSchemeCode(String schemeCode) {
        this.schemeCode = schemeCode;
    }

    public String getFromDate() {
        return fromDate;
    }

    public void setFromDate(String fromDate) {
        this.fromDate = fromDate;
    }

    public String getToDate() {
        return toDate;
    }

    public void setToDate(String toDate) {
        this.toDate = toDate;
    }

    public String getDateOfTransaction() {
        return dateOfTransaction;
    }

    public void setDateOfTransaction(String dateOfTransaction) {
        this.dateOfTransaction = dateOfTransaction;
    }

    public String getNoOfInvestmentAcc() {
        return noOfInvestmentAcc;
    }

    public void setNoOfInvestmentAcc(String noOfInvestmentAcc) {
        this.noOfInvestmentAcc = noOfInvestmentAcc;
    }

    public String getTotInvestmentAmt() {
        return totInvestmentAmt;
    }

    public void setTotInvestmentAmt(String totInvestmentAmt) {
        this.totInvestmentAmt = totInvestmentAmt;
    }

    public String getNoOfTnsfInAcc() {
        return noOfTnsfInAcc;
    }

    public void setNoOfTnsfInAcc(String noOfTnsfInAcc) {
        this.noOfTnsfInAcc = noOfTnsfInAcc;
    }

    public String getNoOfTnsfInAmt() {
        return noOfTnsfInAmt;
    }

    public void setNoOfTnsfInAmt(String noOfTnsfInAmt) {
        this.noOfTnsfInAmt = noOfTnsfInAmt;
    }

    public String getNoOfTnsfOutAcc() {
        return noOfTnsfOutAcc;
    }

    public void setNoOfTnsfOutAcc(String noOfTnsfOutAcc) {
        this.noOfTnsfOutAcc = noOfTnsfOutAcc;
    }

    public String getNoOfTnsfOutAmt() {
        return noOfTnsfOutAmt;
    }

    public void setNoOfTnsfOutAmt(String noOfTnsfOutAmt) {
        this.noOfTnsfOutAmt = noOfTnsfOutAmt;
    }

    public String getNoOfRepayAcc() {
        return noOfRepayAcc;
    }

    public void setNoOfRepayAcc(String noOfRepayAcc) {
        this.noOfRepayAcc = noOfRepayAcc;
    }

    public String getNoOfRepayAmt() {
        return noOfRepayAmt;
    }

    public void setNoOfRepayAmt(String noOfRepayAmt) {
        this.noOfRepayAmt = noOfRepayAmt;
    }

    public String getTotAcc() {
        return totAcc;
    }

    public void setTotAcc(String totAcc) {
        this.totAcc = totAcc;
    }

    public String getTotAmt() {
        return totAmt;
    }

    public void setTotAmt(String totAmt) {
        this.totAmt = totAmt;
    }
}

