<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper">
	<h4 class="form_heading  feature-heading">Office Account Place
		Holder - Add</h4>
	<form name="officeAccountPlaceHolderForm" role="form">
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="bacid" class="control-label">Place Holder</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="bacid" name="bacid"
						ng-model="vm.officeAccountPlaceHolder.bacid" maxlength="16"
						required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="bacidDesc" class="control-label">Placeholder
						Description</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="bacidDesc"
						name="bacidDesc" ng-model="vm.officeAccountPlaceHolder.bacidDesc"
						maxlength="40" required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3 required">
					<label for="schmType" class="control-label">Type of Scheme</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" id="schmType"
						name="schmType" ng-model="vm.officeAccountPlaceHolder.schmType"
						maxlength="5" required chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText1" class="control-label">Additional
						Text1</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText1"
						id="additionalText1"
						ng-model="vm.officeAccountPlaceHolder.additionalText1"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText2" class="control-label">Additional
						Text2</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText2"
						id="additionalText2"
						ng-model="vm.officeAccountPlaceHolder.additionalText2"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
					<label for="additionalText3" class="control-label">Additional
						Text3</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						id="additionalText3"
						ng-model="vm.officeAccountPlaceHolder.additionalText3"
						maxlength="40" chars="alpha-numeric">
				</div>
			</div>
		</div>

		<div class="row">
			<div class="col-sm-offset-5 col-sm-8 form_submit">

				<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="officeAccountPlaceHolderForm.$invalid"
					ng-click="vm.add()">Submit</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="vm.showCancelConfirmation('office_account_place_holder.list');">Cancel</button>
			</div>
		</div>
		<button ng-click="vm.triggerApiRequest()">Download ZIP File</button>
		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>


