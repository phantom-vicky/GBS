                                        (vm.getDetails.masterDetailsValueModel[0].C023.oldValue | getLabelFromValuesArray : vm.stateMetaData) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C023? (vm.getDetails.masterDetailsValueModel[0].C023.newValue | getLabelFromValuesArray : vm.stateMetaData) : ('')}}
