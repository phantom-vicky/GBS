                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C008)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C008.oldValue) : ('')}}
                </td>
                <td ng-if="vm.verifyDeleteLists.previousOperationType == 'M'" class="new-value">
                    {{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C008)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C008.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch Address3</td>
                <td class="old-value">{{(vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue && vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C009)?
                    (vm.verifyDeleteLists.cbsBranchesOfOtherBankDetailsOldNewValue.C009.oldValue) : ('')}}
