<div class="container from_wrapper">
    <div class="loader-new" ng-if="vm.loader"></div>
    <dc-left-menu></dc-left-menu>
    <h4 class="form_heading">Bond Ledger Account Maintenance - Modify</h4>
    <sol-header></sol-header>

    <div class="container">
        <uib-accordion close-others="oneAtATime">
            <form name="vm.customerMasterForm" role="form"
                  ng-submit="vm.modifycustomerMaster(vm.customerMasterForm.$valid)">
                <div uib-accordion-group id="general-details"
                     class="panel-default panel panel-open"
                     heading="Bond Ledger Account Maintenance - Modify" is-open="true">

                    <div class="row">
                        <div class="form-group" ng-class="requiredClass">


                            <label class="control-label col-sm-3">Name of the Module</label>
                            <div class="col-sm-3">
                                :
                                <label class="data-bind">RBI Bond</label>
                            </div>

                            <label class="control-label col-sm-3">Name of the Bond Scheme</label>
                            <div class="col-sm-3">
                                :
                                <label class="data-bind">{{vm.schemeName}}</label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="form-group" ng-class="requiredClass">
                            <label class="control-label col-sm-3">Mode of Holding
                            </label>
                            <div class="col-sm-2">
                                :
                                <label class="data-bind" ng-if="vm.getDetails.masterDetailsValueModel[0].C001.oldValue=='MH001'" >Single</label>
                                <label class="data-bind" ng-if="vm.getDetails.masterDetailsValueModel[0].C001.oldValue=='MH002'" >Joint - Jointly</label>
                                <label class="data-bind" ng-if="vm.getDetails.masterDetailsValueModel[0].C001.oldValue=='MH003'" >Joint - Anyone or Survivor</label>
                                <label class="data-bind" ng-if="vm.getDetails.masterDetailsValueModel[0].C001.oldValue=='MH004'" >HUF</label>
                                <label class="data-bind" ng-if="vm.getDetails.masterDetailsValueModel[0].C001.oldValue=='MH005'" >Legal Guardian</label>
                            </div>
                            <div class="col-sm-1"></div>
                            <label for="isNri" class="control-label col-sm-3">Is NRI?
                            </label>
                            <div class="col-sm-2">
                                :
                                <label id="isNri" class="data-bind"
                                       ng-init="vm.customerMaster.isNri = vm.getDetails.masterDetailsValueModel[0].C003.oldValue">{{(vm.getDetails.masterDetailsValueModel[0].C003.oldValue)?(vm.getDetails.masterDetailsValueModel[0].C003.oldValue  | getLabelFromValuesArray : vm.commonYesNoMetaData) : ('')}} </label>
                            </div>
                        </div>
                    </div>

                </div>


                <div uib-accordion-group id="personal-details" class="panel"
                     heading='{{vm.titleText}}'
                     is-open="vm.personalDetailsOpen"
                     ng-class="(vm.customerPersonalDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                    <ng-form name="vm.customerPersonalDetails" >
                        <table class="table table-bordered">
                            <tbody>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Operative Account Number</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" ng-blur="vm.getSchemeTypeListOperative(vm.customerMasterDetails.C034.oldValue, 'acctNum')"
                                                       ng-model="vm.customerMasterDetails.C034.oldValue" required>
                                    <!--                                    <span class="alert-danger" ng-if="vm.errorMessage">Invalid Account Number</span>-->
                                    <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                </td>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMasterDetails.gbmTransactionMasterDto.tranMode == 'T'}">
                                    <label for="tranSolId" class="control-label">Operative Account Branch Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="tranSolId"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetails.C035.oldValue" chars="alpha-numeric" readonly disabled required>
                                        </div>
                                    </div>
                                </td>
                            </tr>


                            <tr>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMaster.nriFlag == 'Y'}">
                                    <label for="cbsCustomerId" class="control-label">CBS CIF ID</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="cbsCustomerId" ng-disabled="vm.customerMasterDetails.blaAccNo!=null"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetails.C004.oldValue"
                                                   chars="alpha-numeric" oninput="this.value = this.value.toUpperCase()" ng-disabled="vm.getDetails.verifiedStatus=='Y'" >
                                            <span class="alert-danger" ng-if="vm.errmsgSingle && vm.customerMaster.customerMasterDetails">
                                                {{vm.errmsgSingle}}</span>
                                        </div>

                                        <div class="col-sm-3" >
                                            <button ng-if="vm.customerMasterDetails.C004.oldValue" type="button" class="btn btn-default" id="cifBtn" ng-click="vm.getCbsCustFstJoinDetailsModify();"
                                                    ng-disabled="vm.getDetails.verifiedStatus=='Y' || !vm.customerMasterDetails.C004.oldValue || !vm.customerMasterDetails.C034.oldValue || vm.cbsErrorMessage">Fetch</button>
                                        </div>
                                    </div>
                                </td>

                                <td width="25%">
                                    <label class="control-label">Bond Ledger Account Number</label>
                                </td>
                                <td width="25%">

                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="blaNo"
                                                   name="blaNo"
                                                   ng-model="vm.customerMasterDetails.C005.oldValue" disabled>
                                        </div>
                                        <div class="col-sm-3 torch-top" ng-if="vm.getDetails.verifiedStatus=='N'">
                                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                               ng-click="vm.getBlaAccNoDetailsModify('torch');" id="blaNoSearcher"></i>
                                            <i class="glyphicon glyphicon-remove clear cp"
                                               ng-click="vm.customerMasterDetails.C005.oldValue='';vm.getClearAllData();" id="blaNoClose"></i>
                                        </div>
                                    </div>

                                </td>

                            </tr>
                            <tr>
                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Bond Holder First
                                    Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberFirstName" name="customerFirstName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C006.oldValue"
                                                       ng-disabled="vm.operativeAc == 'Y'"
                                                       chars="only-letters"
                                                       required ></td>
                                <td width="25%">Bond Holder Middle Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberMiddleName" name="customerMiddleName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C007.oldValue" chars="only-letters">
                                </td>
                            </tr>
                            <tr>
                                <td width="25%">Bond Holder Last Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberLastName" name="customerLastName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C008.oldValue" chars="only-letters">
                                </td>
                                <td width="25%" class="form-group required"><label
                                        class="control-label">Holder Type</label></td>
                                <td width="25%">
                                    <select class="form-control"
                                            ng-model="vm.customerMasterDetails.C009.oldValue" ng-change="vm.getValidations(vm.customerMasterDetails.C009.oldValue);" required ng-disabled="vm.getDetails.verifiedStatus=='Y'"  maxlength="10">
                                        <option value="">Select</option>
                                        <!--                                        <option ng-repeat="item in vm.C009List" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                        <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label>
                                </td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C010" name="C010"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C010.oldValue"
                                                       chars="only-letters" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       required></td>
                                <td width="25%" class="form-group required">
                                    <label for="subscriberFirstName" class="control-label">Mother Name</label>
                                </td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C011" name="C011"
                                                       maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetails.C011.oldValue" chars="only-letters" required>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Gender</label></td>
                                <td width="25%"><select class="form-control" id="C012" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        name="state" ng-model="vm.customerMasterDetails.C012.oldValue"
                                                        ng-required="!vm.customerMasterDetails.C012.oldValue">
                                    <option value="" hidden="true">Select</option>
                                    <option value="M" >MALE</option>
                                    <option value="F" >FEMALE</option>
                                </select></td>

                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Is Minor (Y/N)?</label></td>
                                <td width="25%"><select class="form-control" id="C014"  ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        name="C014" ng-model="vm.customerMasterDetails.C014.oldValue"
                                                        ng-change ="vm.customerMasterDetails.C013.oldValue=''"
                                                        required>
                                    <option value="" hidden="true">Select</option>
                                    <option value="Y"  ng-selected="vm.customerMasterDetails.C014.oldValue == 'Y'">YES</option>
                                    <option value="N" ng-selected="vm.customerMasterDetails.C014.oldValue == 'N'">NO</option>
                                </select></td>

                            </tr>
                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                               name="dateofBirth" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="vm.customerMasterDetails.C013.oldValue"
                                               ng-change="vm.checkAge(vm.customerMasterDetails.C014.oldValue, vm.customerMasterDetails.C013.oldValue,'modify','1')"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.dateOptions.opened"
                                               close-text="Close" maxlength="10" readonly required>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C014.oldValue == 'Y'}"><label
                                        for="birthCertificateNo" class="control-label">Details of Birth certificate submitted as per norms</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetails.C044.oldValue" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       maxlength="50" chars="alpha-numeric" ng-required="vm.customerMasterDetails.C014.oldValue == 'Y'">
                                </td>


                            </tr>
                            <tr>

                                <td width="25%" class="form-group "><label
                                        for="address1" class="control-label">Communication Address 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="address1" name="address1" ng-model="vm.customerMasterDetails.C015.oldValue"
                                                       maxlength="120"
                                                       ></td>


                                <td width="25%" ><label
                                        for="address2" class="control-label">Address 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="address2" name="address2"
                                                       ng-model="vm.customerMasterDetails.C016.oldValue" maxlength="120"
                                                       ng-init="vm.tempPresentPremise = vm.presentPremise" ></td>



                            </tr>
                            <tr>

                                <td width="25%" ><label
                                        for="presentFlat" class="control-label">Address 3</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetails.C017.oldValue"
                                                       maxlength="120"
                                ></td>


                                <td width="25%" >
                                    <label class="control-label">City</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="sadistrict" name="district" chars="only-letters" maxlength="40"
                                                       ng-model="vm.customerMasterDetails.C018.oldValue" onkeypress="return AvoidSpace(event)" ></td>

                            </tr>
                            <tr>

                                <td width="25%" class="form-group required">
                                    <label class="control-label">State</label></td>
                                <td width="25%"><select class="form-control" id="state"
                                                        name="state" ng-model="vm.customerMasterDetails.C019.oldValue"
                                                        ng-init="vm.getState()" required>
                                    <option value="" hidden="true">Select State</option>
                                    <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                </select></td>

                                <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                       ng-model="vm.customerMasterDetails.C020.oldValue"
                                                       onkeypress="return isNumber(event)" required></td>

                            </tr>
                            <tr>
                                <td width="25%">Phone Number</td>
                                <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                       id="saphoneNum" ng-model="vm.customerMasterDetails.C046.oldValue"
                                                       chars="only-numbers" onkeypress="return isNumber(event)"></td>

                                <td width="25%">Mobile Number</td>
                                <td width="25%">
                                    <input type="text" class="form-control" minlength="10" maxlength="10"
                                           id="mobileNumber" ng-model="vm.customerMasterDetails.C021.oldValue"
                                           chars="only-numbers" onkeypress="return isNumber(event)"></td>
                            </tr>
                            <tr>

                                <td width="25%" class="form-group"><label
                                        for="emailId" class="control-label">Email Id</label></td>
                                <td width="25%"><input type="email" class="form-control"
                                                       id="emailId" name="emailId" maxlength="50"
                                                       ng-model="vm.customerMasterDetails.C022.oldValue" ng-pattern="vm.emailPattern" chars="email">
                                    <span class="text-danger"
                                          ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                <td width="25%" ng-class="vm.customerMasterDetails.C001.oldValue=='MH004' ? 'form-group required' :(vm.customerMasterDetails.C009.oldValue == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.customerMasterDetails.C001.oldValue=='MH001' || vm.customerMasterDetails.C001.oldValue=='MH004'">

                                <label for="emailId" class="control-label">
                                    HUF registration / Power of Attorney number</label>
                                </td>

                                <td width="25%" ng-if="vm.customerMasterDetails.C001.oldValue=='MH001' || vm.customerMasterDetails.C001.oldValue=='MH004'"><input type="text" class="form-control" minlength="1" maxlength="30"
                                                       ng-required=" vm.customerMasterDetails.C001.oldValue=='MH004' || vm.customerMasterDetails.C009.oldValue == 'HT001'"
                                                       id="powerOfattorneyNo" ng-model="vm.customerMasterDetails.C023.oldValue"  ></td>

                            </tr>

                            <tr >
                                <td width="25%" ng-class="vm.customerMasterDetails.C001.oldValue=='MH004' ? 'form-group required' :(vm.customerMasterDetails.C009.oldValue == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.customerMasterDetails.C001.oldValue=='MH001' || vm.customerMasterDetails.C001.oldValue=='MH004'">

                                <label for="emailId" class="control-label">Power of Attorney/Karta Name</label>
                                </td>

                                <td width="25%" ng-if="vm.customerMasterDetails.C001.oldValue=='MH001' || vm.customerMasterDetails.C001.oldValue=='MH004'">
                                    <input type="text" class="form-control" minlength="1" maxlength="30"
                                           ng-required=" vm.customerMasterDetails.C001.oldValue=='MH004' || vm.customerMasterDetails.C009.oldValue == 'HT001'"
                                           id="kartaName" ng-model="vm.customerMasterDetails.C024.oldValue" >
                                </td>

                            </tr>

                            <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                <td width="25%" class="form-group">
                                    <label class="control-label">Date of Death of Bond Holder<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfDeathOfBondHolderOne"
                                               name="dateOfDeathOfBondHolderOne" ng-init="vm.dodVal()"
                                               ng-model="vm.customerMasterDetails.C051.oldValue" ng-change="vm.customerMasterDetails.C052.oldValue=''; vm.dodRecVal(vm.customerMasterDetails.C051.oldValue)"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dodCalenderOptions"
                                               is-open="vm.dateOfDeathOfBondHolderOneOption.opened"
                                               close-text="Close" maxlength="10" readonly>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfDeathOfBondHolderOneOption.opened = true"
                                                    id="dateOfDeathOfBondHolderOneOption">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C051.oldValue}">
                                    <label class="control-label">Date of Receipt of Death Certificate<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfReceiptOfDeathCertificateOne"
                                               name="dateOfReceiptOfDeathCertificateOne"
                                               ng-model="vm.customerMasterDetails.C052.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dodRecCalenderOptions"
                                               is-open="vm.dateOfReceiptOfDeathCertificateOneOption.opened"
                                               ng-required="vm.customerMasterDetails.C051.oldValue"
                                               close-text="Close" maxlength="10" readonly>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfReceiptOfDeathCertificateOneOption.opened = true"
                                                    id="dateOfReceiptOfDeathCertificateOneOption">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                            </tr>



                            </tbody>
                        </table>
                        <h4 class="form_heading" ng-if="vm.customerMasterDetails.C014.oldValue=='Y'">GUARDIAN DETAILS</h4>
                        <table class="table table-bordered" ng-if="vm.customerMasterDetails.C014.oldValue=='Y'">
                            <tbody>

                            <tr>
                                <td width="25%" >
                                    <label for="C025" class="control-label">Guardian Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="C025"
                                                   name="C025"
                                                   ng-init="vm.customerMasterDetails.C025.oldValue = ''"
                                                   ng-model="vm.customerMasterDetails.C025.oldValue" disabled>
                                        </div>
                                        <div ng-if="vm.getDetails.verifiedStatus !='Y'" class="col-sm-3 torch-top" >
                                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                               ng-click="vm.getGuardianDetails('select');" id="C025Searcher"></i>
                                            <i class="glyphicon glyphicon-remove clear cp"
                                               ng-click="vm.customerMasterDetails.C025.oldValue='';  vm.customerMasterDetails.C026.oldValue=''; vm.customerMasterDetails.C027.oldValue=''; vm.customerMasterDetails.C028.oldValue='';vm.customerMasterDetails.C029.oldValue=''; vm.customerMasterDetails.C030.oldValue='';vm.customerMasterDetails.C031.oldValue=''; vm.customerMasterDetails.C032.oldValue=''; vm.customerMasterDetails.C033.oldValue=''; " id="C025Close"></i>

                                        </div>
                                    </div>
                                </td>

                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C026" name="C026"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C026.oldValue"
                                                       chars="only-letters" required></td>

                            </tr>

                            <tr>
                                <td width="25%">Guardian Middle Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C027" name="C027"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C027.oldValue" chars="only-letters">
                                </td>

                                <td width="25%">Guardian Last Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C028" name="C028"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C028.oldValue" chars="only-letters">
                                </td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Relation with minor</label></td>
                                <td width="25%">
                                    <select class="form-control" id="C029"
                                            name="state" ng-model="vm.customerMasterDetails.C029.oldValue"
                                            required>
                                        <option value="" hidden="true">Select</option>
                                        <option value="RE001" >Father</option>
                                        <option value="RE002" >Mother</option>
                                        <option value="RE006" >Brother</option>
                                        <option value="RE007" >Sister</option>
                                        <option value="RE009" >Others</option>
<!--                                        <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                    </select>
                                </td>

                                <td width="25%" class="form-group">
                                    <label class="control-label">Date of Birth</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="C030"
                                               name="C030" ng-model="vm.customerMasterDetails.C030.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.submissionfifteenGH"
                                               is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>
                            </tr>


                            <tr>
                                <td width="25%" class="form-group "><label
                                        for="address1" class="control-label">Communication Address</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetails.C031.oldValue"
                                                       maxlength="120"
                                                       ></td>


                                <td width="25%">Mobile Number</td>
                                <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                       id="guardianMobileNumber" ng-model="vm.customerMasterDetails.C032.oldValue"
                                                       chars="only-numbers" onkeypress="return isNumber(event)"></td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group"><label
                                        for="emailId" class="control-label">Email Id</label></td>
                                <td width="25%"><input type="email" class="form-control"
                                                       id="C033" name="C033" maxlength="50"
                                                       ng-model="vm.customerMasterDetails.C033.oldValue" ng-pattern="vm.emailPattern" chars="email">
                                    <span class="text-danger"
                                          ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                            </tr>


                            </tbody>
                        </table>
