<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Drop Down Master - Verify/Reject</h4>
    <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="moduleName" class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-4">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

<!--        <div class="row">-->
<!--            <div class="form-group required">-->
<!--                <div class="col-sm-3"></div>-->
<!--                <div class="col-sm-3">-->
<!--                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>-->
<!--                </div>-->
<!--                <div class="col-sm-2">-->
<!--                    <input type="text" class="form-control" id="moduleName" ng-model="vm.schemeName" required readonly>-->
<!--                </div>-->
<!--                <div class="col-sm-2">-->
<!--                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName"-->
<!--                       id="treasurySearcher"-->
<!--                       ng-click="vm.getModuleNameAdd();"></i> <i-->
<!--                        class="glyphicon glyphicon-remove clear cp"-->
<!--                        ng-click="vm.schemeCode ='';vm.schemeName =''"></i>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">


                    <label for="dropDownType" class="control-label">Drop-down Type</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="dropDownType" name="dropDownType" ng-model="vm.dropDownType" required>
                        <option value="" hidden="true">Select</option>
                        <option ng-repeat="item in vm.dropDownInquiryList" ng-value="item" ng-bind="item.DESCRIPTION"></option>
                    </select>
                </div>
            </div>
        </div>


        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="drop_down_master.verify_detail({obj:{
								schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								schemeStatus: vm.schemeStatus,
                                dropDownType: vm.dropDownType
								}})"
                    ng-disabled="accountOpeningForm.$invalid">Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/drop_down_master/action/inquiry';">Cancel
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <!--                                    <th class="modal-title title-case" ng-show="false">Scheme Code</th>-->
                                    <th class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                        ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Scheme Name
                                    </th>
                                    <th class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                        ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                                    data-bs-dismiss="modal">
                                    <td style="display: none;">{{x.schemeCode}}</td>
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>