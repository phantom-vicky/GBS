<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper">
    <h4 class="form_heading">State/District/Pin Code Master - Add</h4>
    <sol-header></sol-header><br>
    <form name="stDtPinForm" role="form" enctype="multipart/form-data" novalidate>
            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-3"></div>
                    <label for="file" class="control-label col-sm-3">Upload
                        File(xls)</label>
                    <div class="col-sm-3">
                        <input  id="file" name="file" type="file"
                               ng-model="vm.stDtPin.file" file-model="vm.file"
                               accept="application/vnd.ms-excel" runat="server" required
                               valid-file>
                    <span class="text-danger" ng-show="vm.fileSizeError">
                       File size exceeds 5MB. Please upload a smaller file.
                    </span>
                    </div>
                    <div class="col-sm-3">
                        <a href="" ng-click="vm.downloadPincode()">Download the Template</a>
                    </div>
                </div>
            </div>

            <div class="col-sm-offset-5 col-sm-8 form_submit">
                <button type="submit" class="btn btn-default" id="uploadButton"
                        ng-disabled="stDtPinForm.$invalid"
                        ng-click="vm.uploadFileExistCheck();">Upload</button>
<!--                <button type="submit" class="btn btn-cancel" id="cancelButton"-->
<!--                        ng-click="vm.showCancelConfirmation('cbs_bulk_upload.list');">Cancel</button>-->
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/state_district_pin/action/inquiry';">Cancel
                </button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>


        </form>
</div>