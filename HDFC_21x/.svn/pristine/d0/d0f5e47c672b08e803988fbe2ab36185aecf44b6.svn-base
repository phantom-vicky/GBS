                            <button type="button" class="btn btn-cancel" id="cancelButton"
                                    onclick="window.location.href= '#!/rbi_bond_nominee_continuation/action/inquiry'">Cancel</button>
                        </div>


                    </form>
                </uib-accordion>








            <div class="audit-details">
                <div class="row">
                    <div class="col-md-3">
                        <span> <b> Created By </b> : {{vm.auditDetails.createdBy}} </span>
                    </div>
                    <div class="col-md-3">
                        <span> <b>Verified By </b> : {{(vm.auditDetails.verifiedBy) ? (vm.auditDetails.verifiedBy) : ('None')}}</span>
                    </div>
                    <div class="col-md-3">
                        <span> <b> Verify Status </b> : {{vm.auditDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3">
                        <span> <b> Created On </b> : {{ vm.auditDetails.createdDate | date : 'dd/MM/yyyy' : ('None')}}</span>
                    </div>
                    <div class="col-md-3">
                        <span> <b> Verified On </b> : {{(vm.auditDetails.verifiedDate) ? (vm.auditDetails.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                    </div>
                    <div class="col-md-3">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>