<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">RBI Bond TOC Slab Master Maintenance - Modify</h4>
    <sol-header></sol-header>
    <form name="rbi_bond_toc_slab_maintenance" role="form">
        <table class="table table-bordered">
            <tbody>
            <tr ng-init="vm.getModuleName();">
                <td width="20%" class="form-group"> <label  class="control-label">Name of the Module</label></td>
                <td width="30%"><label class="text-initial"><label><b>RBI Bond</b></label></label></td>
                <td width="20%"><label class="control-label">Version No</label></td>
                <td width="30%">{{vm.versionNo}}</td>
            </tr>
            <tr>
                <td width="20%" class="form-group"><label class="control-label">Name of the Bond Scheme</label></td>
                <td width="30%" class="break-word"><label>{{vm.schemeName | getLabelFromValuesArray : vm.moduleNameDetailsLabelValue}}</label></td>
                <td width="20%" class="form-group required"><label class="control-label">Effective From Date</label></td>
                <td width="30%"><p class="input-group width-60">
                    <input type="text" class="form-control" id="effFromDate"
                           name="effFromDate" ng-model="vm.effeFromDate"
                           uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.fromDate=''"
                           datepicker-options="vm.dateOptions"
                           is-open="vm.effFromDatePicker.opened" close-text="Close"
                           maxlength="10" readonly required>
                    <span class="input-group-btn">
                  </span>
                </p></td>

            </tr>
            <tr>
                <td width="20%" class="form-group required" ><label  class="control-label">CGST %</label></td>
                <td width="30%">
                    <input type="text" class="form-control" name="cgst" id="cgst" ng-change="vm.firstCharDotCgst(vm.cgst);" ng-pattern="/^(100(\.0)?|([1-9]?\d(\.\d{1,2})?)|0(\.\d{1,2})?)$/" maxlength="5" ng-keypress="vm.newPercentageCheck($event)" ng-model="vm.cgst" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" required>
                    <span ng-show="rbi_bond_toc_slab_maintenance.cgst.$error.pattern && rbi_bond_toc_slab_maintenance.cgst.$touched" class="text-red">
                       Please enter a valid percentage (e.g., 99.99 or 100.0).
                    </span>
                </td>
                <td width="20%" class="form-group required" ><label  class="control-label">SGST %</label></td>
                <td width="30%">
                    <input type="text" class="form-control" name="sgst" id="sgst" ng-change="vm.firstCharDotSgst(vm.sgst);" ng-pattern="/^(100(\.0)?|([1-9]?\d(\.\d{1,2})?)|0(\.\d{1,2})?)$/" maxlength="5"
                            ng-model="vm.sgst" ng-keypress="vm.newPercentageCheck($event)" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1')" required>
                    <span ng-show="rbi_bond_toc_slab_maintenance.sgst.$error.pattern && rbi_bond_toc_slab_maintenance.sgst.$touched" class="text-red">
                        Please enter a valid percentage (e.g., 99.99 or 100.0)
                    </span>
                </td>
            </tr>
            </tbody>
        </table>

        <div class="col-sm-12 text-right form_submit" ng-if="vm.showAddButton">
            <div class="row">
                <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRange()">
                    <span class="glyphicon glyphicon-plus">ADD</span>&nbsp;
                </a>
            </div>
        </div>

        <table class="table table-bordered table-striped list">
            <thead>
            <tr>
                <th width="10%">Flat Rate</th>
                <th width="20%">Nature of TOC</th>
                <th width="20%">Challan Types</th>
                <th width="10%">Minimum No of Challans / Amount</th>
                <th width="10%">Maximum No of Challans / Amount</th>
                <th width="10%">TOC Per Amount Rs.</th>
                <th width="10%">TOC in (Rs) per Challan / <br> TOC in (paise) Per Amount</th>
                <th width="10%">Rounding Factor</th>
                <th ng-if="vm.showAddButton">DELETE</th>
            </tr>
            </thead>
            <tbody>
            <tr ng-repeat = "item in vm.tocSlabList" ng-init="parentIndex=$index;">
                <td class="form-group">
                    <select class="form-control" id="flatRate[$index]" name="flatRate"
                            ng-model="item.C005.oldValue" required>
                        <option value="" hidden="true">Select</option>
                        <option value="Y">Yes</option>
                        <option value="N">No</option>
                    </select>
                </td>
                <td>
                    <select class="form-control" id="pensionType[$index1]" name="pensionType"
                            ng-model="item.C007.oldValue" ng-init="vm.getNatureOfTocList();" required>
                        <option value="">Select</option>
                        <option ng-repeat="items in vm.natureOfTocList" value="{{items.SUBCODE}}" ng-selected="{{item.C007.oldValue == items.SUBCODE}}">{{items.DESCRIPTION}}</option>
                    </select>
                </td>

                <td>
                    <select class="form-control" id="pensionType[$index]" ng-if="item.C007.oldValue == 'NP001'" name="pensionType"
                            ng-model="item.C014.oldValue" ng-init="vm.getPenionTocList();"  required>
                        <option value="">Select</option>
                        <option ng-repeat="items in vm.pensionTocList" value="{{items.SUBCODE}}" ng-selected="{{item.C014.oldValue == items.SUBCODE}}">{{items.DESCRIPTION}}</option>
                    </select>
                </td>


                <td>
                    <input type="text" class="form-control text-right" ng-if="item.C005.oldValue == 'Y'" id="minSlabCh[$index]"
                           chars="only-numbers" onkeypress="return isNumber(event)" placeholder="Min No.of Chellans"
                           limit-to="8" name="minSlabCh"
                           ng-model="item.C009.oldValue" required>
                    <input type="text" class="form-control text-right" ng-if="item.C005.oldValue == 'N'" id="minSlabAmt[$index]"
                           chars="only-numbers" onkeypress="return isNumber(event)"  placeholder="Min Amount"
                           limit-to="8" name="minSlabAmt"
                           ng-model="item.C009.oldValue" required>
                </td>

                <td>
                    <input type="text" class="form-control text-right" ng-if="item.C005.oldValue == 'Y'" id="maxSlabCh[$index]"
                           chars="only-numbers" onkeypress="return isNumber(event)"  placeholder="Max No.of Chellans"
                           limit-to="15" name="maxSlabCh"
                           ng-model="item.C010.oldValue" required>
                    <input type="text" class="form-control text-right" ng-if="item.C005.oldValue == 'N'" id="maxSlabAmt[$index]"
                           chars="only-numbers" onkeypress="return isNumber(event)" placeholder="Max Amount"
                           limit-to="8" name="maxSlabAmt"
                           ng-model="item.C010.oldValue" required>
                </td>

                <td ng-if="item.C005.oldValue == 'N'"><input type="text" class="form-control text-right" id="tocAmount[$index]"
                                                             chars="only-numbers" name="tocAmount" maxlength="5"
                                                             ng-model="item.C011.oldValue" required></td>
                <td ng-if="item.C005.oldValue == 'Y'"><label class="control-label"></label></td>

                <td><input type="text" class="form-control text-right" id="tocSlabValue[$index]"
                          name="tocSlabValue"   ng-pattern="/^\d{1,5}(\.\d+)?$/"
                           maxlength="10"
                           oninput="
               this.value = this.value.replace(/[^0-9.]/g, '');  /* Allow only numbers & dot */
               if (this.value.indexOf('.') === 0) this.value = this.value.replace('.', ''); /* Prevent starting with a dot */
               if ((this.value.match(/\./g) || []).length > 1) this.value = this.value.slice(0, -1); /* Prevent multiple dots */
               if (this.value.split('.')[0].length > 5) this.value = this.value.slice(0, -1); /* Restrict to 5 digits before dot */
           "
                           ng-model="item.C012.oldValue" required></td>

                <td>
                    <select class="form-control" id="roundOff[$index]" name="roundOff"
                            ng-model="item.C013.oldValue" ng-init="vm.getRoundFactList();"  required>
                        <option value="">Select</option>
                        <option ng-repeat="items in vm.roudingFactorList;" value="{{items.SUBCODE}}">{{items.DESCRIPTION}}</option>
                    </select>
                </td>

                <td ng-if="vm.showAddButton">
                    <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-click="vm.removeRange(item.ID, $index)">
                        <span class="glyphicon glyphicon-trash"></span>
                    </a>
                </td>


            </tr>
            </tbody>

            <tfoot>
            <tr>
                <th width="25%">Verified Status</th>
                <th width="25%">Yes</th>
            </tr>
            </tfoot>

        </table>
        <table class="table table-bordered table-striped list old-new-value-table">
            <tbody width="100%">
            <tr>
                <th width="50%">Rejection Remarks</th>
                <td width="50%">{{vm.rejectionRemarks}}</td>
            </tr>


            </tbody>
        </table>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b class="margin-right-1px"> Created By </b> : {{vm.auditInfo.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b class="margin-right-1px"> Last Modified By </b> : {{(vm.auditInfo.modifiedBy) ? (vm.auditInfo.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b class="margin-right-1px"> Last Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : <span class="text-initial">{{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.auditInfo.modifiedDate) ? (vm.auditInfo.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="rbi_bond_toc_slab_maintenance.$invalid" ng-click="vm.modifySubmit()">Modify</button>
            <button type="button" id="subButton" class="btn btn-cancel"
                    ng-click="vm.showCancelConfirmation('rbi_bond_toc_slab_maintenance.modify');">Cancel</button>
        </div>

    </form>
</div>
