<style>
    .displayN{display:none}
    .displayB{display:block}
</style>
<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class=" from_wrapper new_form_wrapper" ng-class="vm.ftsDetailFetch == true ? 'container' : 'container-fluid'">
    <div class="col-lg-1" ></div>
    <div class="" style="overflow-y:scroll;height:500px" ng-class="vm.ftsDetailFetch == true ? '' : 'col-lg-5'">
    <h4 class="form_heading">Bond Transfer in from Other Bank – ADD</h4>
    <sol-header></sol-header>

    <ul class="nav nav-tabs"  ng-init="vm.tabReferenceAdd='blaOpeningForm'">
        <li ng-class="{ 'active': vm.tabReferenceAdd == 'blaOpeningForm'}" ><a  ng-click="vm.tabReferenceAdd ='blaOpeningForm'" id="blaOpeningForm" >TRANSFER IN – ADD</a></li>
        <li  ng-class="{ 'active': vm.tabReferenceAdd == 'bondSubscriptionFlowForm'}"   ><a  ng-click="vm.tabReferenceAdd ='bondSubscriptionFlowForm'"  id="bondSubscriptionFlowForm">BOND SUBSCRIPTION WORKFLOW - ADD</a></li>
        <!--                                    <li ng-class="{active: vm.blaFlag !== 'Y'}">-->
        <!--                                        <a data-bs-toggle="tab" data-target="#customerMasterForm" ng-disabled="vm.isFieldsDisabled">BLA Opening – ADD</a>-->
        <!--                                    </li>-->
        <!--                                    <li ng-class="{active: vm.blaFlag === 'Y'}">-->
        <!--                                        <a data-bs-toggle="tab" data-target="#bondSubscriptionFlowForm">BOND SUBSCRIPTION WORKFLOW - ADD</a>-->
        <!--                                    </li>-->
    </ul>
    <div class="tab-content">

        <div id="customerMasterForm" class="tab-pane fade in active"  ng-show="vm.tabReferenceAdd=='blaOpeningForm'"  >
            <div class="tab-body">

                <uib-accordion close-others="oneAtATime">
                    <form name="vm.customerMasterForm" role="form"
                          ng-submit="vm.addcustomerMaster(vm.customerMasterForm.$valid)">

                        <div uib-accordion-group id="general-details"
                             class="panel-default panel panel-open"
                             heading="Bond Ledger Account Maintenance - Add" is-open="true">


                            <div class="row">
                                <div class="form-group" ng-class="requiredClass">
                                    <label class="control-label col-sm-3">Mode of Holding
                                    </label>
                                    <div class="col-sm-2">
                                        :
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >Joint - Jointly</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >Joint - Anyone or Survivor</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH004'" >HUF</label>
                                        <label class="data-bind" ng-if="vm.modeOfHolding=='MH005'" >Legal Guardian</label>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div uib-accordion-group id="personal-details1" class="panel"
                             heading='{{vm.titleText}}'
                             is-open="vm.personalDetailsOpen"
                             ng-class="(vm.customerMasterForm.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>


                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Bond Holder First
                                            Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberFirstName" name="customerFirstName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetails.bondHldFirstName"
                                                               ng-disabled="vm.operativeAc == 'Y'"
                                                               chars="only-letters"
                                                               required oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                        <td width="25%">Bond Holder Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberMiddleName" name="customerMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">Bond Holder Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberLastName" name="customerLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                        <td width="25%" class="form-group required"><label
                                                class="control-label">Holder Type</label></td>
                                        <td width="25%">
                                            <select class="form-control"
                                                    ng-model="vm.customerMasterDetails.holderType" ng-change="vm.getValidations(vm.customerMasterDetails.holderType);" required>
                                                <option value="" hidden="true">Select</option>
                                                <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label
                                                for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="fatherName" name="fatherName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetails.fatherName"
                                                               chars="only-letters" leading-space></td>
                                        <td width="25%">
                                            <label  class="control-label">Mother's Maiden Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="motherName" name="motherName"
                                                               maxlength="150" leading-space
                                                               ng-model="vm.customerMasterDetails.motherName" chars="only-letters" >
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Gender</label></td>
                                        <td width="25%"><select class="form-control" id="gender"
                                                                name="state" ng-model="vm.customerMasterDetails.gender"
                                                                ng-required="!vm.customerMasterDetails.gender">
                                            <option value="" hidden="true">Select</option>
                                            <option value="M" >MALE</option>
                                            <option value="F" >FEMALE</option>
                                            <option value="O" >OTHERS</option>
                                        </select></td>


                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Is Minor (Y/N)?</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   value="{{ vm.customerMasterDetails.isMinor === 'Y' ? 'YES' : 'NO' }}"
                                                   readonly>
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                        <td width="25%" ng-if="vm.modeOfHolding=='MH004'">
                                            <p class="input-group" >
                                                <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                       name="dateofBirth"
                                                       ng-model="vm.customerMasterDetails.bondHldDob" maxlength="10" readonly
                                                       ng-change="vm.checkAge(vm.customerMasterDetails.isMinor, vm.customerMasterDetails.bondHldDob,'add','1');"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.futureDateNot"
                                                       is-open="vm.dateOptions.opened"
                                                       close-text="Close" maxlength="10" readonly required>
                                                <!--                                                                    <span class="input-group-btn">-->
                                                <!--                                            <button type="button" class="btn btn-secondary"-->
                                                <!--                                                    ng-click="vm.dateOptions.opened = true"-->
                                                <!--                                                    id="bondHolderDateOfBirthOptions" ng-disabled="!vm.customerMasterDetails.isMinor">-->
                                                <!--                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                <!--                                            </button>-->
                                                <!--                                        </span>-->
                                            </p>
                                        </td>
                                        <td width="25%" ng-if="vm.modeOfHolding!=='MH004'">
                                            <p class="input-group" >
                                                <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                                       name="dateofBirth"
                                                       ng-model="vm.customerMasterDetails.bondHldDob"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.futureDateNot"
                                                       is-open="vm.dateOptions.opened"
                                                       close-text="Close" maxlength="10" readonly required>
                                                <!--                                                                    <span class="input-group-btn">-->
                                                <!--                                            <button type="button" class="btn btn-secondary"-->
                                                <!--                                                    ng-click="vm.dateOptions.opened = true"-->
                                                <!--                                                    id="bondHolderDateOfBirthOptions" ng-disabled="!vm.customerMasterDetails.isMinor">-->
                                                <!--                                                <i class="glyphicon glyphicon-calendar"></i>-->
                                                <!--                                            </button>-->
                                                <!--                                        </span>-->
                                            </p>
                                        </td>
                                        <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.isMinor != 'Y'}"><label
                                                for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br>as per norms</label></td>
                                        <td width="25%" ng-if="!vm.id && vm.blaFlag!='Y'"><input type="text" class="form-control"
                                                                                                 id="birthCertificateNo1" name="birthCertificateNo" ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"
                                                                                                 ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"

                                                                                                 maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetails.isMinor == 'Y'" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>


                                        <td width="25%" ng-if="(vm.id || vm.blaFlag=='Y')&&vm.customerMasterDetails.isMinor == 'Y'">
                                            <input type="text" class="form-control"
                                                   id="birthCertificateNo1" name="birthCertificateNo"
                                                   ng-model="vm.customerMasterDetails.detailsOfBirthCertificate" ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"
                                                   maxlength="30" chars="only-letters"
                                                   required>
                                        </td>
                                        <td width="25%" ng-if="(vm.id || vm.blaFlag=='Y')&&vm.customerMasterDetails.isMinor != 'Y'">
                                            <input type="text" class="form-control"
                                                   id="birthCertificateNo1" name="birthCertificateNo"
                                                   ng-model="vm.customerMasterDetails.detailsOfBirthCertificate"  ng-value="vm.customerMasterDetails.isMinor == 'Y' ? 'YES' : vm.customerMasterDetails.detailsOfBirthCertificate"
                                                   maxlength="30" chars="only-letters"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group required"><label
                                                for="address1" class="control-label">Communication Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address1" name="address1" ng-model="vm.customerMasterDetails.bondHldAddOne"
                                                               maxlength="500"
                                                               required   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" ><label
                                                for="address2" class="control-label">Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address2" name="address2"
                                                               ng-model="vm.customerMasterDetails.bondHldAddTwo" maxlength="500"
                                                               ng-init="vm.tempPresentPremise = vm.presentPremise"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                    </tr>
                                    <tr>

                                        <td width="25%" ><label
                                                for="presentFlat" class="control-label">Address 3</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetails.bondHldAddThree"
                                                               maxlength="500"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%"  class="form-group required">
                                            <label class="control-label">City</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sadistrict" name="district" chars="only-letters"  limit-To="35"
                                                               ng-model="vm.customerMasterDetails.bondHldCity" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">State</label></td>
                                        <td width="25%"><select class="form-control" id="state"
                                                                name="state" ng-model="vm.customerMasterDetails.bondHldState"
                                                                ng-init="vm.getState()" required>
                                            <option value="" hidden="true">Select State</option>
                                            <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                        </select></td>

                                        <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6" ng-blur="vm.getAddressOne(vm.customerMasterDetails.bondHldPinCode,'one')"
                                                               ng-model="vm.customerMasterDetails.bondHldPinCode"
                                                               onkeypress="return isNumber(event)" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                    </tr>
                                    <tr>
                                        <td width="25%">Phone Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                               id="saphoneNum" ng-model="vm.customerMasterDetails.bondHolderPhoneNumber"
                                                               chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="12"
                                                   id="mobileNumber" ng-model="vm.customerMasterDetails.bondHldMobNum"
                                                   chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')"></td>


                                    </tr>

                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%" ><input type="email" class="form-control"
                                                                id="emailId" name="emailId" maxlength="50"
                                                                ng-model="vm.customerMasterDetails.bondHldEmail"  chars="email" >
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                            <label for="emailId" class="control-label " > HUF registration / Power of Attorney number</label>
                                        </td>



                                        <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                            <input type="text" class="form-control" minlength="1" maxlength="20" chars="alpha-numeric"
                                                   id="powerOfattorneyNo" ng-model="vm.customerMasterDetails.hufRegPowerOfAttorney" chars="alpha-numeric"
                                                   ng-required="vm.modeOfHolding=='MH004' || vm.customerMasterDetails.holderType == 'HT001' " oninput="this.value = this.value.replace(/^\s+/, '')"></td>

                                    </tr>


                                    <tr >
                                        <td width="25%" ng-class="vm.modeOfHolding=='MH004' ? 'form-group required' :(vm.customerMasterDetails.holderType == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                            <label for="emailId" class="control-label ">Power of Attorney/Karta Name</label>
                                        </td>


                                        <td width="25%" ng-if="vm.modeOfHolding=='MH001' || vm.modeOfHolding=='MH004'">
                                            <input type="text" class="form-control" minlength="1" maxlength="30"
                                                   id="kartaName" ng-model="vm.customerMasterDetails.powerOfAttorneyKartaName"
                                                   ng-required=" vm.modeOfHolding=='MH004' || vm.customerMasterDetails.holderType == 'HT001'"  ng-keypress="vm.validateInput($event,'kartaName');">
                                        </td>




                                    </tr>


                                    </tbody>
                                </table>

                                <h4 class="form_heading" ng-if="vm.modeOfHolding=='MH004'">Coparceners Details of Karta</h4>
                                <div class="col-sm-12 text-right form_submit" ng-if="vm.modeOfHolding=='MH004'">
                                    <div class="row">
                                        <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRanges()">
                                            <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                        </a>

                                    </div>
                                </div>
                                <table class="table table-bordered table-striped" ng-if="vm.modeOfHolding=='MH004'">
                                    <tbody ng-repeat="item in vm.coparcenerslist">
                                    <tr>
                                        <td colspan="4">
                                            <div class="col-sm-12 text-right form_submit">
                                                <div class="row">

                                                    <a data-href="#" type="button" name="removeBtn" class="btn btn-delete" ng-if="vm.enableDelete" ng-click="vm.removeRanges(item.id.oldValue, $index)">
                                                        <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td colspan="4"><h4 class="form_heading">Coparceners Details of Karta {{$index+1}}</h4></td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label for="coparcenersName[$index]">Coparceners  Name <span class="text-danger"> * </span></label></label></td>
                                        <td class="form-group">
                                            <input type="text" class="form-control" id="coparcenersName[$index]"
                                                   chars="only-letters"
                                                   limit-to="50" name="coparcenersName"
                                                   ng-model="item.coparcenersName" required leading-space>
                                        </td>
                                        <td width="25%" class="form-group" ><label class="control-label">Relationship with Karta</label></td>
                                        <td class="form-group" ng-required="item.coparcenersName">
                                            <input type="text" class="form-control" id="coparcenersRelation[$index]"
                                                   chars="alpha-numeric"
                                                   limit-to="50" name="coparcenersRelation"
                                                   ng-model="item.coparcenersRelation"  oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>




                                    <tr>
                                        <td width="25%" class="form-group" >
                                            <label class="control-label">DOB</label></td>
                                        <td class="form-group" ng-required="item.coparcenersName">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="coparcenersDob{{$index}}" name="coparcenersDob"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       ng-blur="vm.textableDatePicker('coparcenersDob'+{{$index}},item.coparcenersDob);"
                                                       ng-keyup="vm.autoslashing('coparcenersDob'+{{$index}})" chars="numbers-slash"
                                                       datepicker-options="vm.futureDateNot"
                                                       ng-model="item.coparcenersDob" maxlengtth="10" ng-init="coparcener.datepickerOpened=false"
                                                       is-open="coparcener.datepickerOpened" close-text="Close" maxlength="10"  oninput="this.value = this.value.replace(/\s+/g, '')">

                                                <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="coparcener.datepickerOpened=true" >


                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                            </p>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>


                                <h4 class="form_heading" ng-if="vm.customerMasterDetails.isMinor=='Y'">GUARDIAN DETAILS</h4>
                                <table class="table table-bordered" ng-if="vm.customerMasterDetails.isMinor=='Y'">
                                    <tbody>

                                    <tr>
                                        <td width="25%" >
                                            <label for="guardianId" class="control-label">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId"
                                                           name="guardianId"
                                                           ng-model="vm.customerMasterDetails.guardianId" disabled>
                                                </div>
                                                <div class="col-sm-3 torch-top" >
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getGuardianDetails('select');" id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click=
                                                               "vm.customerMasterDetails.guardianId = '';
                                               vm.customerMasterDetails.guardianFirstName= '';
                                               vm.customerMasterDetails.guardianMiddleName='';
                                               vm.customerMasterDetails.guardianLastName='';
                                               vm.customerMasterDetails.relationWithMinor='';
                                               vm.customerMasterDetails.guardianDateOfBirth1='';
                                               vm.customerMasterDetails.guardianCommunicationAddress='';
                                               vm.customerMasterDetails.guardianMobileNo='';
                                               vm.customerMasterDetails.guardianEmailId=''; " id="guardianIdClose"></i>
                                                    <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianFirstName" name="guardianFirstName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.guardianFirstName"
                                                               chars="only-letters" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                    </tr>

                                    <tr>
                                        <td width="25%">Guardian Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianMiddleName" name="guardianMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>

                                        <td width="25%">Guardian Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianLastName" name="guardianLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation with minor</label></td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor" ng-init=""
                                                    name="relationWithMinor" ng-model="vm.customerMasterDetails.relationWithMinor"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Birth</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth1" ng-init="vm.guardDobValidation();"
                                                       name="guardianDateOfBirth" ng-model="vm.customerMasterDetails.guardianDateOfBirth1"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobOptions"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth1',vm.customerMasterDetails.guardianDateOfBirth1);"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth1')" chars="numbers-slash"
                                                       is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" >
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetails.guardianCommunicationAddress"
                                                               maxlength="30"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%">Mobile Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="12"
                                                               id="guardianMobileNumber" ng-model="vm.customerMasterDetails.guardianMobileNo"
                                                               chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"
                                                               id="guardianEmailId" name="guardianEmailId" maxlength="50"
                                                               ng-model="vm.customerMasterDetails.guardianEmailId" ng-pattern="vm.emailPattern" chars="email" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    </tr>


                                    </tbody>
                                </table>
                                <h4 class="form_heading">OTHERS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Whether the customer belongs to <br> HDFC?</label></td>
                                        <td width="25%">
                                            <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()">Yes
                                            <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.customerMasterDetails.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()">No
                                        </td>

                                        <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'" class="form-group required">
                                            <label class="control-label">Operative Account Number (Demo details)</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                            <input type="text" class="form-control"  ng-init="vm.customerMasterDetails.operativeAccNum ==''"
                                                   id="operativeAcc" name="operativeAcc" chars="numbers" maxlength="15"
                                                   ng-model="vm.customerMasterDetails.operativeAccNum"
                                                   ng-required="vm.customerMasterDetails.hdfcOtherBank == 'Y'"
                                                   ng-disabled="vm.customerMasterDetails.hdfcOtherBank != 'Y'"
                                                   oninput="this.value = this.value.toUpperCase()"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.hdfcOtherBank == 'Y'">
                                            <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetails(vm.customerMasterDetails.operativeAccNum);"
                                                    ng-disabled="!vm.customerMasterDetails.operativeAccNum || vm.customerMasterDetails.hdfcOtherBank != 'Y'">
                                                Fetch
                                            </button>
                                        </td>


                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Mode of Interest Payment/ Principal<br> Repayment</label>
                                        </td>
                                        <td width="25%">
                                            <select class="form-control" id="modeOfInterestPayment" ng-init=""
                                                    name="modeOfInterestPayment" ng-model="vm.customerMasterDetails.modeOfInterestPayment" ng-change="vm.modeOfInterestPaymentValidation(vm.customerMasterDetails.modeOfInterestPayment);"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.modeOfInterestPaymentList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                            <label class="control-label">Operative Account Number</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                            <input type="text" class="form-control"
                                                   id="operativeAcc" name="operativeAcc" chars="numbers" maxlength="15"
                                                   ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>
                                        </td>

                                    </tr>

                                    <tr>

                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                            <label class="control-label">Account Type code</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP001'">
                                            <select class="form-control" id="modeOfInterestPayment" ng-init=""
                                                    name="accountType" ng-model="vm.customerMasterDetails.accountType"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.accountTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>


                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                            <label class="control-label">DD/PO Account Number</label></td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP002'">
                                            <input type="text" class="form-control"
                                                   id="ddpoAccountNo" name="ddpoAccountNo" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'||vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                        <td width="25%" class="form-group required" >
                                            <label class="control-labelaria-controls">Bank Name</label></td>
                                        <!--                                                            <td width="25%">-->
                                        <!--                                                                <div class="row">-->
                                        <!--                                                                    <div class="col-sm-9">-->
                                        <!--                                                                        <input type="text" class="form-control" id="bankCode"-->
                                        <!--                                                                               name="bankCode"-->
                                        <!--                                                                               ng-model="vm.customerMasterDetails.bankCode"-->
                                        <!--                                                                               chars="alpha-numeric" disabled readonly required>-->
                                        <!--                                                                    </div>-->
                                        <!--                                                                    <div class="col-sm-3 torch-top">-->
                                        <!--                                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                        <!--                                                                           ng-click="vm.getOtherBankDetailsTorch();" id="otherBankSearcher"></i>-->
                                        <!--                                                                        <i class="glyphicon glyphicon-remove clear cp"-->
                                        <!--                                                                           ng-click="vm.bankCode = ''; vm.branchCode = ''" id="otherBankolIdClose"></i>-->
                                        <!--                                                                    </div>-->
                                        <!--                                                                </div>-->

                                        <!--                                                            </td>-->
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="bankCodeNonMicr"
                                                           name="bankCodeNonMicr"
                                                           ng-model="vm.customerMasterDetails.bankName"
                                                           chars="alpha-numeric" disabled>
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       id="otherBankSearcher"
                                                       ng-click="vm.getOtherBankDetailsTorch('bankName');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.bankCode='';vm.customerMasterDetails.bankName=''"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group" >
                                            <label class="control-label">Branch Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="micrBranchCode" maxlength="20"
                                                           ng-model="vm.customerMasterDetails.branchCode" chars="alpha-numeric" >
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-toggle="modal"
                                                       id="micrBranchCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorch('micrBranchCode');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.branchCode='';"></i>
                                                </div>
                                            </div>
                                        </td>
                                        <!--                                                            <td width="25%">-->
                                        <!--                                                                <div class="row">-->
                                        <!--                                                                    <div class="col-sm-9">-->
                                        <!--                                                                        <input type="text" class="form-control" id="branchCode"-->
                                        <!--                                                                               name="branchCodeNonMicr"-->
                                        <!--                                                                               ng-model="vm.customerMasterDetails.branchCode"-->
                                        <!--                                                                               chars="alpha-numeric" disabled readonly required>-->
                                        <!--                                                                    </div>-->
                                        <!--                                                                    <div class="col-sm-3 torch-top" ng-if="vm.customerMasterDetails.bankCode">-->
                                        <!--                                                                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"-->
                                        <!--                                                                           id="branchCode"-->
                                        <!--                                                                           ng-click="vm.getOtherBankDetailsTorch('branchCode');"></i> <i-->
                                        <!--                                                                            class="glyphicon glyphicon-remove clear cp"-->
                                        <!--                                                                            ng-click="vm.customerMasterDetails.branchCode='';"></i>-->
                                        <!--                                                                    </div>-->
                                        <!--                                                                </div>-->
                                        <!--                                                            </td>-->
                                    </tr>


                                    <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                        <td width="25%"  >
                                            <label for="guardianId" class="control-label">IFSC Code</label>
                                        </td>
                                        <td width="25%" >
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="instIfscCode" style="text-transform: uppercase" maxlength="11"
                                                           ng-model="vm.customerMasterDetails.ifscCode" chars="alpha-numeric"  ng-pattern="/^[A-Z]{4}[0-9]{7}$/" oninput="this.value = this.value.toUpperCase()"
                                                           ng-required="!vm.customerMasterDetails.micrCode" >
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-toggle="modal"
                                                       id="instIfscCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorch('ifsc');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.ifscCode='';"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Name of the Payee</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="nameOfthePayee" name="nameOfthePayee" chars="alpha-numeric" maxlength="150" ng-init="vm.customerMasterDetails.nameOfthePayee = vm.bondHolderName"
                                                   ng-model="vm.customerMasterDetails.nameOfthePayee" required  >
                                        </td>
                                    </tr>


                                    <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP003'">
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Credit Account Number</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="creditAccNo" name="creditAccNo" chars="alpha-numeric" maxlength="20"
                                                   ng-model="vm.customerMasterDetails.operativeAccNumber" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>

                                        <td width="25%">
                                        <td width="25%">
                                        </td>
                                    </tr>

                                    <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Operative Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control"
                                                   id="operativeAcc" name="operativeAcc" chars="numbers" maxlength="15"
                                                   ng-model="vm.customerMasterDetails.operativeAccNumber"  oninput="this.value = this.value.replace(/\s+/g, '')" required>
                                            <!--                                                            <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                        </td>


                                        <td width="25%" >
                                            <label for="guardianId" class="control-label">IFSC Code</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="instIfscCode"
                                                           ng-model="vm.customerMasterDetails.ifscCode" chars="alpha-numeric"
                                                           ng-pattern="/^[A-Z]{4}[0-9]{7}$/"
                                                           maxlength="11" style="text-transform: uppercase"  ng-required="!vm.customerMasterDetails.micrCode"  oninput="this.value = this.value.toUpperCase()">
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-toggle="modal"
                                                       id="instIfscCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorch('ifsc');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.ifscCode='';vm.customerMasterDetails.micrCode=''"></i>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr ng-if="vm.customerMasterDetails.modeOfInterestPayment == 'MP004'">

                                        <td width="25%">
                                            <label class="control-label">MICR Code</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="micrBankCode" maxlength="9"
                                                           ng-model="vm.customerMasterDetails.micrCode" chars="alpha-numeric" ng-required="!vm.customerMasterDetails.ifscCode" >
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-toggle="modal"
                                                       id="micrBankCodeSearch"
                                                       ng-click="vm.getOtherBankDetailsTorch('micrCodeBank');"></i> <i
                                                        class="glyphicon glyphicon-remove clear cp"
                                                        ng-click="vm.customerMasterDetails.micrCode='';"></i>
                                                </div>
                                            </div> </td>
                                    </tr>


                                    <tr>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">PAN No</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="panNumber"
                                                   name="panNumber" maxlength="10" chars="alpha-numeric"
                                                   ng-model="vm.customerMasterDetails.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>


                                    </tr>
                                    <tr ng-if="vm.aadharDisplay=='Y'">
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'">
                                            <label class="control-label" ng-class="{'required': vm.aadharMandatory == 'Y'}">Aadhaar No</label></td>
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'"><input type="text" class="form-control" chars="only-numbers"
                                                                                             id="aadharNum" chars="only-numbers" minlength="12" maxlength="12"
                                                                                             onkeypress="return isNumber(event)"
                                                                                             name="aadharNum" ng-model="vm.customerMasterDetails.aadhaarNo" oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.aadharMandatory == 'Y'"></td>

                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="30" leading-space
                                                               ng-model="vm.customerMasterDetails.witnessNameOne"
                                                               chars="only-letters" ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressOne" name="witnessAddressOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.witnessAddressOne"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="30" leading-space
                                                               ng-model="vm.customerMasterDetails.witnessNameTwo"
                                                               chars="only-letters" ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressTwo" name="witnessAddressTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetails.witnessAddressTwo"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">
                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificate" name="birthCertificate" value="KD001" ng-model="vm.customerMasterDetails.birthCertificate">
                                        <label for="birthCertificate">Birth Certificate</label><br>
                                        <input type="checkbox" id="passport" name="passport" value="KD002" ng-model="vm.customerMasterDetails.passport">
                                        <label for="passport">Passport</label><br>
                                        <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" value="KD003" ng-model="vm.customerMasterDetails.seniorCitizenCard">
                                        <label for="seniorCitizenCard">Senior Citizen Card</label><br>
                                        <input type="checkbox" id="voterId" name="voterId" value="KD004" ng-model="vm.customerMasterDetails.voterIdCard">
                                        <label for="voterId">Voter ID Card</label><br>
                                        <input type="checkbox" id="panCard" name="panCard" value="KD005" ng-model="vm.customerMasterDetails.panCard">
                                        <label for="panCard">Pan Card</label><br>
                                        <input type="checkbox" id="drivingLicence" name="drivingLicence" value="KD006" ng-model="vm.customerMasterDetails.drivingLicence">
                                        <label for="drivingLicence">Driving Licence</label><br>
                                        <input type="checkbox" id="rationCard" name="rationCard" value="KD007" ng-model="vm.customerMasterDetails.rationCard">
                                        <label for="rationCard">Ration Card</label><br>
                                        <input type="checkbox" id="others" name="others" value="KD008" ng-model="vm.customerMasterDetails.otherDocuments">
                                        <label for="others">Others</label><br>
                                    </div>

                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetails.otherDocuments">
                                            <label class="control-label">Details for Others</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetails.otherDocuments">
                                            <input type="text" class="form-control"
                                                   id="otherDetails" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetails.otherDetails" required oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetails.remarks" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>

                        <div uib-accordion-group id="joint-personal-details" class="panel"
                             heading="SECOND JOINT ACCOUNT HOLDER DETAILS"
                             is-open="vm.secondHolderDetails"
                             ng-class="(vm.secondJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.noOfJointAcc >= 2">
                            <ng-form name="vm.secondJoinAccountHolderDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Bond Second Holder First
                                            Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberFirstName" name="customerFirstName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldFirstName"
                                                               ng-disabled="vm.operativeAc == 'Y'"
                                                               chars="only-letters"
                                                               required oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                        <td width="25%">Bond Second Holder Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberMiddleName" name="customerMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldMidName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">Bond Second Holder Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberLastName" name="customerLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                        <td width="25%" class="form-group "><label
                                                class="control-label">Holder Type</label></td>
                                        <td width="25%">
                                            <select class="form-control"
                                                    ng-model="vm.customerMasterDetailsTwo.holderType" ng-change="vm.getValidations(vm.customerMasterDetailsTwo.holderType);"   maxlength="10" >
                                                <option value="" hidden="true">Select</option>
                                                <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT002">Power of Attorney</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                            </select>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%">
                                            <label for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="fatherName" name="fatherName"
                                                               maxlength="150" leading-space
                                                               ng-model="vm.customerMasterDetailsTwo.fatherName"
                                                               chars="only-letters" ></td>
                                        <td width="25%" >
                                            <label  class="control-label">Mother's Maiden Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="motherName" name="motherName"
                                                               maxlength="150" leading-space
                                                               ng-model="vm.customerMasterDetailsTwo.motherName" chars="only-letters" >
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Gender</label></td>
                                        <td width="25%"><select class="form-control" id="gender"
                                                                name="state" ng-model="vm.customerMasterDetailsTwo.gender"
                                                                ng-required="!vm.customerMasterDetailsTwo.gender">
                                            <option value="" hidden="true">Select</option>
                                            <option value="M" >MALE</option>
                                            <option value="F" >FEMALE</option>
                                            <option value="O" >OTHERS</option>
                                        </select></td>


                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Is Minor (Y/N)?</label></td>
                                        <td width="25%">
                                            <!--                                                                <select class="form-control" id="isMinor"-->
                                            <!--                                                                                    name="isMinor" ng-model="vm.customerMasterDetailsTwo.isMinor"-->
                                            <!--                                                                                    ng-required="!vm.customerMasterDetailsTwo.isMinor"-->
                                            <!--                                                                                    ng-change ="vm.customerMasterDetailsTwo.bondHldDob=''"-->
                                            <!--                                                                                    required>-->
                                            <!--                                                                <option value="" hidden="true">Select</option>-->
                                            <!--                                                                <option value="Y" >YES</option>-->
                                            <!--                                                                <option value="N" >NO</option>-->
                                            <!--                                                            </select>-->
                                            <input type="text" class="form-control"
                                                   value="{{ vm.customerMasterDetailsTwoFlag === 'Y' ? 'YES' : 'NO' }}"

                                                   readonly>
                                        </td>



                                    </tr>
                                    <tr>


                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                        <td width="25%">

                                            <p class="input-group">
                                                <input type="text" class="form-control" id="customerMasterDetailsTwoBondHldDob"
                                                       name="effFromDate" ng-model="vm.customerMasterDetailsTwo.bondHldDob"
                                                       ng-change="vm.checkAge(vm.customerMasterDetailsTwoFlag, vm.customerMasterDetailsTwo.bondHldDob,'add','2')"
                                                       uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.customerMasterDetailsTwo.bondHldDob='';"
                                                       datepicker-options="vm.futureDateNot"
                                                       is-open="vm.effFromDatePickerTwo.opened" close-text="Close"
                                                       maxlength="10" readonly required>
                                               <!-- <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effFromDatePickerTwo.opened = true"
                                    id="customerMasterDetailsTwoBondHldDobSearcher">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>



                                        <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsTwoFlag.isMinor == 'Y'}"><label
                                                for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br> as per norms</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                                               ng-value="vm.customerMasterDetailsTwo.isMinor == 'Y' ? 'YES' : vm.customerMasterDetailsTwo.detailsOfBirthCertificate"
                                                               maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetailsTwoFlag == 'Y'"  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address1" name="address1" ng-model="vm.customerMasterDetailsTwo.bondHldAddOne"
                                                               maxlength="500"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" ><label
                                                for="address2" class="control-label">Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address2" name="address2"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldAddTwo" maxlength="500"
                                                               ng-init="vm.tempPresentPremise = vm.presentPremise"   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>
                                    <tr>

                                        <td width="25%" ><label
                                                for="presentFlat" class="control-label">Address 3</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsTwo.bondHldAddThree"
                                                               maxlength="500"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" class="form-group">
                                            <label class="control-label">City</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sadistrict" name="district" chars="only-letters"  limit-To="35"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldCity"  ></td>

                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">State</label></td>
                                        <td width="25%"><select class="form-control" id="state"
                                                                name="state" ng-model="vm.customerMasterDetailsTwo.bondHldState"
                                                                ng-init="vm.getState()">
                                            <option value="" hidden="true">Select State</option>
                                            <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                        </select></td>

                                        <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldPinCode"  ng-blur="vm.getAddressOne(vm.customerMasterDetailsTwo.bondHldPinCode,'two')"
                                                               onkeypress="return isNumber(event)"></td>

                                    </tr>
                                    <tr>
                                        <td width="25%">Phone Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                               id="saphoneNum" ng-model="vm.customerMasterDetailsTwo.bondHolderPhoneNumber"
                                                               chars="only-numbers" onkeypress="return isNumber(event)"></td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="12"
                                                   id="mobileNumber" ng-model="vm.customerMasterDetailsTwo.bondHldMobNum"
                                                   chars="only-numbers" onkeypress="return isNumber(event)"></td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"
                                                               id="emailId" name="emailId" maxlength="50"
                                                               ng-model="vm.customerMasterDetailsTwo.bondHldEmail" ng-pattern="vm.emailPattern" chars="email">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>


                                    </tr>

                                    </tbody>
                                </table>



                                <h4 class="form_heading" ng-if="vm.customerMasterDetailsTwoFlag=='Y'">GUARDIAN DETAILS</h4>
                                <table class="table table-bordered" ng-if="vm.customerMasterDetailsTwoFlag=='Y'">
                                    <tbody>

                                    <tr>
                                        <td width="25%" >
                                            <label for="guardianId" class="control-label">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId"
                                                           name="guardianId"
                                                           ng-model="vm.customerMasterDetailsTwo.guardianId" disabled>
                                                </div>
                                                <div class="col-sm-3 torch-top" >
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getGuardianDetailsTwo('select');" id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="vm.customerMasterDetailsTwo.guardianId = '';
                                               vm.customerMasterDetailsTwo.guardianFirstName= '';
                                               vm.customerMasterDetailsTwo.guardianMiddleName='';
                                               vm.customerMasterDetailsTwo.guardianLastName='';
                                               vm.customerMasterDetailsTwo.relationWithMinor='';
                                               vm.customerMasterDetailsTwo.guardianDateOfBirth='';
                                               vm.customerMasterDetailsTwo.guardianCommunicationAddress='';
                                               vm.customerMasterDetailsTwo.guardianMobileNo='';
                                               vm.customerMasterDetailsTwo.guardianEmailId='';
                                            " id="guardianIdClose"></i>
                                                    <!--                                            "vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();"-->
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianFirstName" name="guardianFirstName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.guardianFirstName"
                                                               chars="only-letters" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                    </tr>

                                    <tr>
                                        <td width="25%">Guardian Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianMiddleName" name="guardianMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>

                                        <td width="25%">Guardian Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianLastName" name="guardianLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation with minor</label></td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor" ng-init=""
                                                    name="relationWithMinor" ng-model="vm.customerMasterDetailsTwo.relationWithMinor"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Birth</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth2" ng-init="vm.guardDobValidation();"
                                                       name="guardianDateOfBirth" ng-model="vm.customerMasterDetailsTwo.guardianDateOfBirth"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobOptions"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth2',vm.customerMasterDetailsTwo.guardianDateOfBirth);"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth2')" chars="numbers-slash"
                                                       is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" >
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsTwo.guardianCommunicationAddress"
                                                               maxlength="30"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%">Mobile Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="12"
                                                               id="guardianMobileNumber" ng-model="vm.customerMasterDetailsTwo.guardianMobileNo"
                                                               chars="only-numbers" onkeypress="return isNumber(event)" oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"
                                                               id="guardianEmailId" name="guardianEmailId" maxlength="50"
                                                               ng-model="vm.customerMasterDetailsTwo.guardianEmailId" ng-pattern="vm.emailPattern" chars="email">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    </tr>


                                    </tbody>
                                </table>
                                <h4 class="form_heading">OTHERS DETAILS</h4>

                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Whether the customer belongs to <br> HDFC?</label></td>
                                        <td width="25%">
                                            <input type="radio" id="hdfcOtherBankY1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()">Yes
                                            <input type="radio" id="hdfcOtherBankN1" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsTwo.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()">No
                                        </td>

                                        <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'" class="form-group required">
                                            <label class="control-label">Operative Account Number</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                            <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsTwo.operativeAccNum ==''"
                                                   id="operativeAcc" name="operativeAcc" chars="numbers" maxlength="15"
                                                   ng-model="vm.customerMasterDetailsTwo.operativeAccNum"
                                                   ng-required="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'"
                                                   ng-disabled="vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y'"
                                                   oninput="this.value = this.value.toUpperCase()"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsTwo.hdfcOtherBank == 'Y'">
                                            <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetailsTwo(vm.customerMasterDetailsTwo.operativeAccNum);"
                                                    ng-disabled="!vm.customerMasterDetailsTwo.operativeAccNum || vm.customerMasterDetailsTwo.hdfcOtherBank != 'Y'">
                                                Fetch
                                            </button>
                                        </td>
                                    </tr>


                                    <td width="25%" class="form-group required">
                                        <label class="control-label">PAN No</label></td>
                                    <td width="25%">
                                        <input type="text" class="form-control" id="panNumber"
                                               name="panNumber" maxlength="10" chars="alpha-numeric"
                                               ng-model="vm.customerMasterDetailsTwo.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                    </td>
                                    </tr>
                                    <tr  ng-if="vm.aadharDisplay=='Y'">
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'" ng-class="{'required': vm.aadharMandatory == 'Y'}">Aadhaar No</td>
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'"><input type="text" class="form-control"
                                                                                             id="aadharNum" chars="only-numbers" minlength="12" maxlength="12"
                                                                                             onkeypress="return isNumber(event)" chars="only-numbers"
                                                                                             name="aadharNum" ng-model="vm.customerMasterDetailsTwo.aadhaarNo" oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.aadharMandatory == 'Y'"></td>
                                    </tr>



                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="30" leading-space
                                                               ng-model="vm.customerMasterDetailsTwo.witnessNameOne"
                                                               ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressOne" name="witnessAddressOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessAddressOne"
                                                               chars="only-letters"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="30" leading-space
                                                               ng-model="vm.customerMasterDetailsTwo.witnessNameTwo"
                                                               chars="only-letters" ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressTwo" name="witnessAddressTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsTwo.witnessAddressTwo"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">
                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificateTwo" name="birthCertificateTwo" value="KD001" ng-model="vm.customerMasterDetailsTwo.birthCertificate">
                                        <label for="birthCertificateTwo">Birth Certificate</label><br>

                                        <input type="checkbox" id="passportTwo" name="passportTwo" value="KD002" ng-model="vm.customerMasterDetailsTwo.passport">
                                        <label for="passportTwo">Passport</label><br>

                                        <input type="checkbox" id="seniorCitizenCardTwo" name="seniorCitizenCardTwo" value="KD003" ng-model="vm.customerMasterDetailsTwo.seniorCitizenCard">
                                        <label for="seniorCitizenCardTwo">Senior Citizen Card</label><br>

                                        <input type="checkbox" id="voterIdTwo" name="voterIdTwo" value="KD004" ng-model="vm.customerMasterDetailsTwo.voterIdCard">
                                        <label for="voterIdTwo">Voter ID Card</label><br>

                                        <input type="checkbox" id="panCardTwo" name="panCardTwo" value="KD005" ng-model="vm.customerMasterDetailsTwo.panCard">
                                        <label for="panCardTwo">Pan Card</label><br>

                                        <input type="checkbox" id="drivingLicenceTwo" name="drivingLicenceTwo" value="KD006" ng-model="vm.customerMasterDetailsTwo.drivingLicence">
                                        <label for="drivingLicenceTwo">Driving Licence</label><br>

                                        <input type="checkbox" id="rationCardTwo" name="rationCardTwo" value="KD007" ng-model="vm.customerMasterDetailsTwo.rationCard">
                                        <label for="rationCardTwo">Ration Card</label><br>

                                        <input type="checkbox" id="othersTwo" name="othersTwo" value="KD008" ng-model="vm.customerMasterDetailsTwo.otherDocuments">
                                        <label for="othersTwo">Others</label><br>

                                    </div>

                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsTwo.otherDocuments">
                                            <label class="control-label">Details for Others</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsTwo.otherDocuments">
                                            <input type="text" class="form-control"
                                                   id="otherDetails" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsTwo.otherDetails" chars="only-letters" required oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsTwo.remarks" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>

                        <div uib-accordion-group id="joint-personal-details-three" class="panel"
                             heading="THIRD JOINT ACCOUNT HOLDER DETAILS"
                             is-open="vm.thirdHolderDetails"
                             ng-class="(vm.thirdJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.noOfJointAcc >= 3">
                            <ng-form name="vm.thirdJoinAccountHolderDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Bond Third Holder First
                                            Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberFirstName" name="customerFirstName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldFirstName"
                                                               chars="only-letters"
                                                               required oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                        <td width="25%">Bond Third Holder Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberMiddleName" name="customerMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldMidName" chars="only-letters"  oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">Bond Third Holder Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="subscriberLastName" name="customerLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                        <td width="25%" class="form-group"><label
                                                class="control-label">Holder Type</label></td>
                                        <td width="25%">
                                            <select class="form-control"
                                                    ng-model="vm.customerMasterDetailsThree.holderType" ng-change="vm.getValidations(vm.customerMasterDetailsThree.holderType);"  maxlength="10" >
                                                <option value="" hidden="true">Select</option>
                                                <!--                                        <option ng-repeat="item in vm.holderTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT002">Power of Attorney</option>

                                                <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                                <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                            </select>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label
                                                for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="fatherName" name="fatherName"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetailsThree.fatherName"
                                                               chars="only-letters" leading-space></td>
                                        <td width="25%">
                                            <label  class="control-label">Mother's Maiden Name</label>
                                        </td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="motherName" name="motherName"
                                                               maxlength="150" leading-space
                                                               ng-model="vm.customerMasterDetailsThree.motherName" chars="only-letters" >
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required" >
                                            <label class="control-label">Gender</label></td>
                                        <td width="25%"><select class="form-control" id="gender"
                                                                name="state" ng-model="vm.customerMasterDetailsThree.gender"
                                                                ng-required="!vm.customerMasterDetailsThree.gender">
                                            <option value="" hidden="true">Select</option>
                                            <option value="M" >MALE</option>
                                            <option value="F" >FEMALE</option>
                                            <option value="O" >OTHERS</option>
                                        </select></td>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Is Minor (Y/N)?</label>
                                        </td>
                                        <td width="25%">
                                            <!--                                                                <select class="form-control" id="isMinor"-->
                                            <!--                                                                                    name="isMinor" ng-model="vm.customerMasterDetailsThree.isMinor"-->
                                            <!--                                                                                    ng-required="!vm.customerMasterDetailsThree.isMinor"-->
                                            <!--                                                                                    ng-change ="vm.customerMasterDetailsThree.bondHldDob=''"-->
                                            <!--                                                                                    required>-->
                                            <!--                                                                <option value="" hidden="true">Select</option>-->
                                            <!--                                                                <option value="Y" >YES</option>-->
                                            <!--                                                                <option value="N" >NO</option>-->
                                            <!--                                                            </select>-->
                                            <input type="text" class="form-control"
                                                   value="{{vm.customerMasterDetailsThreeFlag === 'Y' ? 'YES' : 'NO' }}"
                                                   readonly>
                                        </td>
                                    </tr>
                                    <tr>

                                        <td> <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="effFromDate"
                                                       name="effFromDate" ng-model="vm.customerMasterDetailsThree.bondHldDob"
                                                       ng-change="vm.checkAge(vm.customerMasterDetailsThreeFlag , vm.customerMasterDetailsThree.bondHldDob,'add','3')"

                                                       uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.customerMasterDetailsThree.bondHldDob=''"
                                                       datepicker-options="vm.futureDateNot"
                                                       is-open="vm.effFromDatePicker.opened" close-text="Close"
                                                       maxlength="10" readonly>
                                                <!--<span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effFromDatePicker.opened = true"
                                    id="effFromDateSearcher">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>-->
                                            </p>
                                        </td>


                                        <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThreeFlag.isMinor  != 'Y'}"><label
                                                for="birthCertificateNo" class="control-label">Details of Birth certificate submitted <br> as per norms</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetailsThree.detailsOfBirthCertificate"
                                                               ng-value="vm.customerMasterDetailsThree.isMinor == 'Y' ? 'YES' : vm.customerMasterDetailsThree.detailsOfBirthCertificate"
                                                               maxlength="30" chars="only-letters" ng-required="vm.customerMasterDetailsThreeFlag  == 'Y'"  oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                                        </td>


                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address1" name="address1" ng-model="vm.customerMasterDetailsThree.bondHldAddOne"
                                                               maxlength="500"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%" ><label
                                                for="address2" class="control-label">Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="address2" name="address2"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldAddTwo" maxlength="500"
                                                               ng-init="vm.tempPresentPremise = vm.presentPremise"   oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>



                                    </tr>
                                    <tr>

                                        <td width="25%" ><label
                                                for="presentFlat" class="control-label">Address 3</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsThree.bondHldAddThree"
                                                               maxlength="500"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">City</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sadistrict" name="district" chars="only-letters"  limit-To="35"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldCity"  ></td>

                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">State</label></td>
                                        <td width="25%"><select class="form-control" id="state"
                                                                name="state" ng-model="vm.customerMasterDetailsThree.bondHldState"
                                                                ng-init="vm.getState()">
                                            <option value="" hidden="true">Select State</option>
                                            <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                        </select></td>

                                        <td width="25%" class="form-group"><label class="control-label">Pin Code</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldPinCode"  ng-blur="vm.getAddressOne(vm.customerMasterDetailsThree.bondHldPinCode,'three')"
                                                               onkeypress="return isNumber(event)"></td>

                                    </tr>


                                    <tr>
                                        <td width="25%">Phone Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                               id="saphoneNum" ng-model="vm.customerMasterDetailsThree.bondHolderPhoneNumber"
                                                               chars="only-numbers" onkeypress="return isNumber(event)"></td>

                                        <td width="25%">Mobile Number</td>
                                        <td width="25%">
                                            <input type="text" class="form-control" minlength="10" maxlength="12"
                                                   id="mobileNumber" ng-model="vm.customerMasterDetailsThree.bondHldMobNum"
                                                   chars="only-numbers" onkeypress="return isNumber(event)"></td>


                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"
                                                               id="emailId" name="emailId" maxlength="50"
                                                               ng-model="vm.customerMasterDetailsThree.bondHldEmail" ng-pattern="vm.emailPattern" chars="email">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>
                                    </tr>
                                    </tbody>
                                </table>
                                <h4 class="form_heading" ng-if="vm.customerMasterDetailsThreeFlag =='Y'">GUARDIAN DETAILS</h4>
                                <table class="table table-bordered" ng-if="vm.customerMasterDetailsThreeFlag =='Y'">
                                    <tbody>

                                    <tr>
                                        <td width="25%" >
                                            <label for="guardianId" class="control-label">Guardian Id</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="guardianId"
                                                           name="guardianId"
                                                           ng-model="vm.customerMasterDetailsThree.guardianId" disabled>
                                                </div>
                                                <div class="col-sm-3 torch-top" >
                                                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                       ng-click="vm.getGuardianDetailsThree('select');" id="guardianIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click=
                                                               "vm.customerMasterDetailsThree.guardianId = '';
                                            vm.customerMasterDetailsThree.guardianFirstName= '';
                                            vm.customerMasterDetailsThree.guardianMiddleName='';
                                            vm.customerMasterDetailsThree.guardianLastName='';
                                            vm.customerMasterDetailsThree.relationWithMinor='';
                                            vm.customerMasterDetailsThree.guardianDateOfBirth='';
                                            vm.customerMasterDetailsThree.guardianCommunicationAddress='';
                                            vm.customerMasterDetailsThree.guardianMobileNo='';
                                            vm.customerMasterDetailsThree.guardianEmailId='';"
                                                       id="guardianIdClose"></i>




                                                    <!--                                            vm.customerMasterDetails.guardianId =''; vm.getClearAllDatas();-->
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required"><label
                                                for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianFirstName" name="guardianFirstName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.guardianFirstName"
                                                               chars="only-letters" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                    </tr>

                                    <tr>
                                        <td width="25%">Guardian Middle Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianMiddleName" name="guardianMiddleName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.guardianMiddleName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>

                                        <td width="25%">Guardian Last Name</td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianLastName" name="guardianLastName"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.guardianLastName" chars="only-letters" oninput="this.value = this.value.replace(/\s+/g, '')">
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Relation with minor</label></td>
                                        <td width="25%">
                                            <select class="form-control" id="relationWithMinor" ng-init=""
                                                    name="relationWithMinor" ng-model="vm.customerMasterDetailsThree.relationWithMinor"
                                                    required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Date of Birth</label></td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="guardianDateOfBirth3" ng-init="vm.guardDobValidation();"
                                                       name="guardianDateOfBirth" ng-model="vm.customerMasterDetailsThree.guardianDateOfBirth"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.dobOptions"
                                                       ng-blur="vm.textableDatePicker('guardianDateOfBirth3',vm.customerMasterDetailsThree.guardianDateOfBirth);vm.futureNotAllowed('guardianDateOfBirth3',vm.customerMasterDetailsThree.guardianDateOfBirth)"
                                                       ng-keyup="vm.autoslashing('guardianDateOfBirth3')" chars="numbers-slash"
                                                       is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" readonly>
                                                <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                            </p>
                                        </td>
                                    </tr>


                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="address1" class="control-label">Communication Address</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsThree.guardianCommunicationAddress"
                                                               maxlength="30"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>


                                        <td width="25%">Mobile Number</td>
                                        <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="12"
                                                               id="guardianMobileNumber" ng-model="vm.customerMasterDetailsThree.guardianMobileNo"
                                                               chars="only-numbers" onkeypress="return isNumber(event)"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="emailId" class="control-label">Email Id</label></td>
                                        <td width="25%"><input type="email" class="form-control"
                                                               id="guardianEmailId" name="guardianEmailId" maxlength="50"
                                                               ng-model="vm.customerMasterDetailsThree.guardianEmailId" ng-pattern="vm.emailPattern" chars="email">
                                            <span class="text-danger"
                                                  ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                    </tr>


                                    </tbody>
                                </table>
                                <h4 class="form_heading">OTHERS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Whether the customer belongs to  <br> HDFC?</label></td>
                                        <td width="25%">
                                            <input type="radio" id="hdfcOtherBankY2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.hdfcOtherBank"  value="Y" ng-change="vm.handleHdfcSelection()">Yes
                                            <input type="radio" id="hdfcOtherBankN2" name="hdfcOtherBank" ng-model="vm.customerMasterDetailsThree.hdfcOtherBank"  value="N" ng-change="vm.handleHdfcSelection()">No
                                        </td>

                                        <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'" class="form-group required">
                                            <label class="control-label">Operative Account Number</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'">
                                            <input type="text" class="form-control"  ng-init="vm.customerMasterDetailsThree.operativeAccNum ==''"
                                                   id="operativeAcc" name="operativeAcc" chars="numbers" maxlength="15"
                                                   ng-model="vm.customerMasterDetailsThree.operativeAccNum"
                                                   ng-required="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'"
                                                   ng-disabled="vm.customerMasterDetailsThree.hdfcOtherBank != 'Y'"
                                                   oninput="this.value = this.value.toUpperCase()"
                                                   oninput="this.value = this.value.replace(/\s+/g, '')">
                                            <!--                                                                <span class="alert-danger" ng-if="vm.cbsErrorMessage">{{vm.cbsErrorMessage}}</span>-->
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsThree.hdfcOtherBank == 'Y'">
                                            <button type="button" class="btn btn-primary" ng-click="vm.getCbsCustFstJoinDetailsThree(vm.customerMasterDetailsThree.operativeAccNum);"
                                                    ng-disabled="!vm.customerMasterDetailsThree.operativeAccNum || vm.customerMasterDetailsThree.hdfcOtherBank != 'Y'">
                                                Fetch
                                            </button>
                                        </td>
                                    </tr>

                                    <td width="25%" class="form-group required">
                                        <label class="control-label">PAN No.</label>
                                    </td>
                                    <td width="25%" class="form-group required">
                                        <input type="text" class="form-control" id="panNumber"
                                               name="panNumber" maxlength="10" chars="alpha-numeric"
                                               ng-model="vm.customerMasterDetailsThree.panNo" ng-pattern="vm.panPattern" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                    </td>
                                    </tr>

                                    <tr ng-if="vm.aadharDisplay=='Y'">
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'" ng-class="{'required': vm.aadharMandatory == 'Y'}">Aadhaar No</td>
                                        <td width="25%" ng-if="vm.aadharCapture=='Y'"><input type="text" class="form-control"
                                                                                             id="aadharNum" chars="only-numbers" minlength="12" maxlength="12"
                                                                                             onkeypress="return isNumber(event)" chars="only-numbers"
                                                                                             name="aadharNum" ng-model="vm.customerMasterDetailsThree.aadhaarNo" oninput="this.value = this.value.replace(/\s+/g, '')" ng-required="vm.aadharMandatory == 'Y'"></td>
                                    </tr>




                                    </tbody>
                                </table>
                                <h4 class="form_heading">WITNESS DETAILS</h4>
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameOne" name="witnessNameOne"
                                                               maxlength="150" leading-space
                                                               ng-model="vm.customerMasterDetailsThree.witnessNameOne"
                                                               chars="only-letters" ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressOne" name="witnessAddressOne"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.witnessAddressOne"
                                                               oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessNameTwo" name="witnessNameTwo"
                                                               maxlength="150"
                                                               ng-model="vm.customerMasterDetailsThree.witnessNameTwo"
                                                               chars="only-letters" leading-space ></td>

                                        <td width="25%" class="form-group"><label
                                                for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                        <td width="25%"><input type="text" class="form-control"
                                                               id="witnessAddressTwo" name="witnessAddressTwo"
                                                               maxlength="30"
                                                               ng-model="vm.customerMasterDetailsThree.witnessAddressTwo"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');"></td>
                                    </tr>

                                    </tbody>
                                </table>
                                <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                                <table class="table table-bordered">
                                    <div class="col-md-12 map-div">
                                        <input type="checkbox" id="birthCertificateThree" name="birthCertificateThree" value="KD001" ng-model="vm.customerMasterDetailsThree.birthCertificate">
                                        <label for="birthCertificateThree">Birth Certificate</label><br>

                                        <input type="checkbox" id="passportThree" name="passportThree" value="KD002" ng-model="vm.customerMasterDetailsThree.passport">
                                        <label for="passportThree">Passport</label><br>

                                        <input type="checkbox" id="seniorCitizenCardThree" name="seniorCitizenCardThree" value="KD003" ng-model="vm.customerMasterDetailsThree.seniorCitizenCard">
                                        <label for="seniorCitizenCardThree">Senior Citizen Card</label><br>

                                        <input type="checkbox" id="voterIdThree" name="voterIdThree" value="KD004" ng-model="vm.customerMasterDetailsThree.voterIdCard">
                                        <label for="voterIdThree">Voter ID Card</label><br>

                                        <input type="checkbox" id="panCardThree" name="panCardThree" value="KD005" ng-model="vm.customerMasterDetailsThree.panCard">
                                        <label for="panCardThree">Pan Card</label><br>

                                        <input type="checkbox" id="drivingLicenceThree" name="drivingLicenceThree" value="KD006" ng-model="vm.customerMasterDetailsThree.drivingLicence">
                                        <label for="drivingLicenceThree">Driving Licence</label><br>

                                        <input type="checkbox" id="rationCardThree" name="rationCardThree" value="KD007" ng-model="vm.customerMasterDetailsThree.rationCard">
                                        <label for="rationCardThree">Ration Card</label><br>

                                        <input type="checkbox" id="othersThree" name="othersThree" value="KD008" ng-model="vm.customerMasterDetailsThree.otherDocuments">
                                        <label for="othersThree">Others</label><br>
                                    </div>

                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsThree.otherDocuments">
                                            <label class="control-label">Details for Others</label>
                                        </td>
                                        <td width="25%" ng-if="vm.customerMasterDetailsThree.otherDocuments">
                                            <input type="text" class="form-control"
                                                   id="otherDetails" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsThree.otherDetails" required oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>

                                        <td width="25%" class="form-group">
                                            <label class="control-label">Remarks</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="remarks" name="remarks"
                                                   maxlength="200"
                                                   ng-model="vm.customerMasterDetailsThree.remarks" oninput="this.value = this.value.replace(/^\s/, '')">
                                        </td>
                                    </tr>

                                </table>

                            </ng-form>
                        </div>
                    </form>
                </uib-accordion>




                <div class="text-center form_submit">

                    <button type="submit" class="btn btn-default" id="submitButton"  ng-click="vm.tabReferenceAdd ='bondSubscriptionFlowForm'"
                            ng-disabled="vm.customerMasterForm.$invalid">Next</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            onclick="window.location.href= '#!/rbi_bond_transfer_in/add';">Cancel</button>
                </div>
            </div>
        </div>
        <!-- TranCode Details -->
        <div id="subscriptionForm" class="tab-pane fade in active"  ng-show="vm.tabReferenceAdd=='bondSubscriptionFlowForm'">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="vm.bondSubscriptionFlowForm" role="form"
                          ng-submit="vm.submitAddForm">


                        <div uib-accordion-group id="personal-details" class="panel"
                             heading='BOND HOLDER DETAILS'
                             is-open="vm.personalDetailsOpen"
                             ng-class="(vm.customerPersonalDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>

                                    <tr>
                                        <td width="25%" >
                                            <label  class="control-label">Name of the Bond Scheme</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">{{vm.schemeName}}</label>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">Mode of Holding</label>
                                        </td>
                                        <td width="25%">

                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >Joint - Jointly</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >Joint - Anyone or Survivor</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH004'" >HUF</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH005'" >Legal Guardian</label>

                                        </td>
                                    </tr>


                                    <tr ng-if="(vm.modeOfHolding == 'MH001' || vm.modeOfHolding == 'MH004' || vm.modeOfHolding == 'MH005') && vm.blaFlag === 'Y'">
                                        <td width="25%" >
                                            <label  class="control-label">Bond Holder Name</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">{{vm.bondHolderName}}</label>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">Bond Ledger Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.singleBondAccNo}}</label>
                                        </td>
                                    </tr>



                                    <tr ng-if="(vm.modeOfHolding == 'MH002' || vm.modeOfHolding == 'MH003') && vm.blaFlag == 'Y'">
                                        <td width="25%" >
                                            <label  class="control-label">First joint Bond Holder Name</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">{{vm.firstJointHolderName}}</label>
                                        </td>

                                        <td width="25%">
                                            <label class="control-label">First joint Bond Holder BLA No.</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.firstJointHolderBlaNo}}</label>
                                        </td>
                                    </tr>

                                    <div ng-if="vm.noOfJointAcc  >= 2">
                                        <tr ng-if="(vm.modeOfHolding == 'MH002' || vm.modeOfHolding == 'MH003') && vm.noOfJointAcc >= 2 && vm.blaFlag == 'Y'">
                                            <td width="25%" >
                                                <label  class="control-label">Second joint Bond Holder Name</label>
                                            </td>
                                            <td width="25%">
                                                <label  class="control-label">{{vm.secondJointHolderName}}</label>
                                            </td>

                                            <td width="25%">
                                                <label class="control-label">Second joint Bond Holder BLA No.</label>
                                            </td>
                                            <td width="25%">
                                                <label class="control-label">{{vm.secondJointHolderBlaNo}}</label>
                                            </td>
                                        </tr>

                                    </div>

                                    <div ng-if="vm.noOfJointAcc  >= 3">
                                        <tr ng-if="(vm.modeOfHolding == 'MH002' || vm.modeOfHolding == 'MH003') && vm.noOfJointAcc >= 3 && vm.blaFlag == 'Y'">
                                            <td width="25%" >
                                                <label  class="control-label">Third joint Bond Holder Name</label>
                                            </td>
                                            <td width="25%">
                                                <label  class="control-label">{{vm.thirdJointHolderName}}</label>
                                            </td>

                                            <td width="25%">
                                                <label class="control-label">Third joint Bond Holder BLA No.</label>
                                            </td>
                                            <td width="25%">
                                                <label class="control-label">{{vm.thirdJointHolderBlaNo}}</label>
                                            </td>
                                        </tr>

                                    </div>


                                    <div>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Application No</label></td>
                                            <td width="25%">
                                                <label class="control-label">{{vm.ftsAppNum}}</label>
                                            </td>
                                        </tr>
                                    </div>

                                    </tbody>
                                </table>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="bond-subscription-details" class="panel"
                             heading='BOND SUBSCRIPTION  DETAILS'
                             is-open="vm.bondSubscriptionDetailsOpen"
                             ng-class="(vm.bondSubscriptionDetails.$invalid) ? 'panel-danger' : 'panel-success'">

                            <ng-form name="vm.bondSubscriptionDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>


                                    <tr>
                                        <td width="25%" class="form-group required"><label
                                                class="control-label">Transferor Bank Name</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="transferorBankName"
                                                   name="transferorBankName" maxlength="50" chars="only-letters"
                                                   ng-init="vm.transfererBankName = ''"
                                                   ng-model="vm.transfererBankName" required>
                                        </td>
                                        <td width="25%" class="form-group required"><label
                                                class="control-label">Transferor Branch Name</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="transferorBranchName"
                                                   name="transferorBranchName" maxlength="50" chars="only-letters"
                                                   ng-init="vm.transfererBranchName = ''"
                                                   ng-model="vm.transfererBranchName" required>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Account Transferred in date</label></td>
                                        <td width="25%">
                                            <label class="data-bind">{{vm.branchDate}}</label>
                                        </td>
                                        <td width="25%" class="form-group"><label
                                                class="control-label">Old BLA No.</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="oldBlaNo"
                                                   name="oldBlaNo" maxlength="50" chars="alpha-numeric"
                                                   ng-init="vm.oldBla = ''"
                                                   ng-model="vm.oldBla" >
                                        </td>
                                    </tr>
                                    <tr>

                                        <td width="25%" class="form-group required"><label
                                                class="control-label">RBI Code</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="rbiCode"
                                                   name="rbiCode"
                                                   ng-model="vm.rbiCode"
                                                   maxlength="10" chars="alpha-numeric"  required  oninput="this.value = this.value.replace(/\s/g, '')">
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label for="subscriptionAmount" class="control-label">Bond Subscription Amount</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control" maxlength="11"
                                                   id="subscriptionAmount" ng-model="vm.subscriptionAmount"  ng-change="vm.convertAmountToWords(vm.subscriptionAmount)" ng-blur="vm.validateMultiples(vm.subscriptionAmount, 'add');"
                                                   chars="only-numbers" onkeypress="return isNumber(event)"  required>
                                            <span class="alert-danger" ng-if="vm.depositMultiplesErrMsg">{{vm.depositMultiplesErrMsg}}</span>

                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label for="amountInWords" class="control-label">Amount in Words</label>
                                        </td>
                                        <td width="25%" >
                                            <input type="text" class="form-control"
                                                   id="amountInWords" ng-model="vm.wordsInRupees"
                                                   chars="only-numbers" onkeypress="return isNumber(event)" readonly required>

                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Bond Type</label>
                                        </td>
                                        <td width="25%" >
                                            <select class="form-control" id="bondType" ng-init="vm.bondType ==''"
                                                    name="bondType" ng-model="vm.bondType"
                                                    required>
                                                <option value=""  hidden="true">Select</option>
                                                <option value="C" data-ng-if="vm.schemeBondType !== 'NC' || vm.schemeBondType == 'B'">Cumulative</option>
                                                <option value="NC" data-ng-if="vm.schemeBondType !== 'C' || vm.schemeBondType == 'B'">Non-Cumulative</option>
                                                <!--                                                <option value="B" data-ng-if="vm.schemeBondType !== 'NC' && vm.schemeBondType !== 'C'">Both</option>-->

                                            </select>
                                        </td>

                                    </tr>
                                    <tr>


                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Account Open Date (dd/MM/yyyy)</label>
                                        </td>
                                        <td width="25%">
                                            <p class="input-group">
                                                <input type="text" class="form-control" id="accountOpeningDate"
                                                       name="accountOpeningDate"
                                                       ng-blur="vm.textableDatePicker('accountOpeningDate',vm.accountOpeningDate);"
                                                       ng-keyup="vm.autoslashing('accountOpeningDate')" chars="numbers-slash"
                                                       ng-model="vm.accountOpeningDate"
                                                       ng-init="vm.fromToDateValidation()"
                                                       ng-change="vm.fromToDateValidation() ; vm.getMaturityDate(vm.accountOpeningDate,vm.periodOfDeposit)"
                                                       uib-datepicker-popup="dd/MM/yyyy"
                                                       datepicker-options="vm.futureDateNot"
                                                       is-open="vm.efffromDateOptions.opened"
                                                       close-text="Close" maxlength="10" required readonly>
                                                <span class="input-group-btn">
                <button type="button" class="btn btn-secondary"
                        ng-click="vm.efffromDateOptions.opened = true"
                        id="efffromDateOptions">
                    <i class="glyphicon glyphicon-calendar"></i>
                </button>
            </span>
                                            </p>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Period of Deposit (months)</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.periodOfDeposit}}</label>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required"  ng-if="vm.accountOpeningDate">
                                            <label class="control-label">Maturity Date (dd/mm/yyyy)</label>
                                        </td>
                                        <td width="25%" ng-if="vm.accountOpeningDate">
                                            <label class="control-label" >{{vm.maturityDate}}</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">Interest Rate (%)</label>
                                        </td>
                                        <td width="25%">
                                            <label class="control-label">{{vm.rateOfInterest}}</label>
                                            <!--                        <input type="text" class="form-control"-->
                                            <!--                               id="rateOfInterest" ng-model="vm.rateOfInterest"-->
                                            <!--                               chars="only-numbers"  required oninput="this.value = this.value.replace(/\s+/g, '')">-->
                                        </td>




                                    </tr>

                                    <tr>

                                        <td width="25%" class="form-group required"  ng-if="vm.bondType =='C'">
                                            <label class="control-label">Maturity Amount</label>
                                        </td>
                                        <td width="25%" ng-if="vm.bondType =='C'">
                                            <label class="control-label" >{{vm.maturityAmt}}</label>
                                        </td>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Interest Paid up to</label>
                                        </td>

                                        <td width="15%" class="form-group required">
                                            <label for="month">Month:</label>
                                            <select id="month" ng-model="vm.intrstPaidMonthUpto" class="form-control" style="width: 100%;" required>
                                                <option value="" hidden="true">Select</option>
                                                <option ng-repeat="item in vm.monthList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                            </select>

                                            <label for="year" style="margin-top: 10px;">Year:</label>
                                            <select id="year" ng-model="vm.intrstPaidYearUpto" class="form-control" style="width: 100%;" required>
                                                <option value="" disabled>Select Year</option>
                                                <option ng-repeat="year in availableYears" ng-value="year">{{year}}</option>
                                            </select>
                                        </td>

                                    </tr>


                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Branch code- WBO</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="brokerId"
                                                           name="wboBranchCode"
                                                           ng-init="vm.wboBranchCode = ''"
                                                           ng-model="vm.wboBranchCode"
                                                           chars="alpha-numeric" readonly  required>
                                                </div>
                                                <div class="col-sm-3 torch-top">
                                                    <i class="glyphicon glyphicon-search cp" data-toggle="modal"
                                                       ng-click="vm.getWboBranchCode();" id="branchIdSearcher"></i>
                                                    <i class="glyphicon glyphicon-remove clear cp"
                                                       ng-click="vm.wboBranchCode = '';vm.wboBranchName='';" id="branchIdIdClose"></i>
                                                </div>
                                            </div>
                                        </td>

                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Branch Name- WBO</label>
                                        </td>
                                        <td width="25%">

                                            <input type="text" class="form-control" id="tranSolId"
                                                   name="tranSolId" ng-init="vm.wboBranchName=''"
                                                   ng-model="vm.wboBranchName" chars="alpha-numeric" readonly disabled required>
                                        </td>


                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required" ng-if="vm.modeOfHolding !=='MH004'">
                                            <label class="control-label">Do You want to add Nominee?</label></td>
                                        <td width="25%" ng-if="vm.modeOfHolding !=='MH004'">
                                            <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                                                <input type="radio" name="isNominee" id="isNominee{{$index}}" ng-change="vm.validateNominee();vm.showNomineeConfirmation();"
                                                       ng-model="vm.isNominee" ng-value="item.value" required>{{item.label}}
                                            </ng-container>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td width="25%" class="form-group required">
                                            <label class="control-label">Remarks</label></td>

                                        <td width="25%">

                                            <input type="text" class="form-control" id="remarkss"
                                                   name="remarkss" maxlength="200"
                                                   ng-model="vm.remarks" oninput="this.value = this.value.replace(/^\s/, '')" required>
                                        </td>
                                    </tr>






                                    </tbody>
                                </table>
                            </ng-form>
                        </div>


                        <div uib-accordion-group id="bond-nominee-details" class="panel"
                             heading='NOMINEE DETAILS'
                             is-open="vm.bondNomineeDetailsOpen"
                             ng-class="(vm.nominationDetailsForm.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.isNominee=='Y'">


                            <div>
                                <ng-form name ="vm.nominationDetailsForm">

                                    <table ng-repeat = "item in vm.nominationDetails" id="nominee{{$index}}" class="table table-bordered">
                                        <tbody>

                                        <tr>
                                            <td width="25%" colspan="4" align="right">
                                                <a data-href="#" type="button" name="addBtn" class="btn btn-primary" ng-click="vm.addRange()">
                                                    <span class="glyphicon glyphicon-plus"></span>&nbsp;ADD
                                                </a>
                                                <a data-href="#" type="button" name="removeBtn"  class="btn btn-delete" ng-click="vm.removeNominee($index); vm.calculateSum();">
                                                    <span class="glyphicon glyphicon-trash"></span>&nbsp;DELETE
                                                </a>
                                            </td>
                                        </tr>

                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Nominee First Name</label></td>
                                            <td width="25%"><input type="text" class="form-control" id="firstName[$index]" chars="only-letters"
                                                                   maxlength="50" name="firstName[$index]"
                                                                   ng-model="item.firstName" required oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                            <td width="25%">Nominee Middle Name</td>
                                            <td width="25%"><input type="text" class="form-control" id="middleName[$index]" chars="only-letters"
                                                                   maxlength="50" name="middleName[$index]"
                                                                   ng-model="item.middleName" oninput="this.value = this.value.replace(/\s+/g, '')"></td>
                                        </tr>

                                        <tr>
                                            <td width="25%">Nominee Last Name</td>
                                            <td width="25%"><input type="text" class="form-control" id="lastName[$index]" chars="only-letters"
                                                                   maxlength="50" name="lastName[$index]"
                                                                   ng-model="item.lastName" oninput="this.value = this.value.replace(/\s+/g, '')"></td>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Address1</label></td>
                                            <td width="25%"><input type="text" class="form-control" id="address1[$index]"

                                                                   maxlength="250" name="address1[$index]"
                                                                   ng-model="item.addressOne" required  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Address2</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="address2[$index]"

                                                       maxlength="250" name="address2[$index]"
                                                       ng-model="item.addressTwo"  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                            </td>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">City</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="city[$index]"
                                                       chars="only-letters"  limit-To="35"  name="city[$index]"
                                                       ng-model="item.city" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">State</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="state[$index]"
                                                        name="state[$index]"
                                                        ng-init="item.state = '';"
                                                        ng-model="item.state" required>
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                                    <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.statesRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                                </select>
                                            </td>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Pin Code</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="pinCode[$index]"
                                                       onkeypress="return event.charCode>=48 && event.charCode<=57" chars="alpha-numeric"
                                                       minlength="6" maxlength="10" name="pinCode[$index]" ng-blur="vm.getAddressOneNom(item.pinCode,$index,'nominee')"
                                                       ng-model="item.pinCode" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                        </tr>
                                        <tr>
                                            <td width="25%">
                                                <label class="control-label">Phone No</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="phoneNo[$index]"
                                                       onkeypress="return event.charCode>=48 && event.charCode<=57"
                                                       limit-to="10" name="phoneNo[$index]" chars="only-numbers"
                                                       ng-model="item.phoneNo" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                            <td width="25%" class="form-group">
                                                <label class="control-label">Nominee Status</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="nomineeStatus[$index]"
                                                        name="nomineeStatus[$index]"
                                                        ng-model="item.nomineeStatus">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.getNomineeStatusMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                </select>
                                            </td>
                                            </tr>
                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label required">Share Percentage</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="sharePercentage[$index]"
                                                       chars="float"
                                                       maxlength="3" name="sharePercentage[$index]"
                                                       ng-change="vm.calculateSum();"
                                                       ng-blur="vm.decimalConvert(item.sharePercentage, $index, $event)"
                                                       ng-model="item.sharePercentage" required>
                                                <span class="alert-danger" name="errorMsg{{$index}}" ng-show="vm.errorMsg[{{$index}}]">Entered Input should not exceed 100</span>
                                            </td>
                                        </tr>
                                        <tr>

                                            <td width="25%">
                                                <label class="control-label">Operative Account No</label>
                                            </td>
                                            <td width="25%">

                                                <input type="text" class="form-control" id="operativeNo[$index]" name="operativeNo[$index]" maxlength="16"
                                                       chars="numbers"
                                                       ng-model="item.operativeAccNo" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>

                                            <td width="25%" class="form-group required">
                                                <label class="control-label required">Is Nominee a Minor</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="nomineeMinor[$index]"
                                                        name="nomineeMinor[$index]"
                                                        ng-model="item.isNomineeMinor"
                                                        required disabled>
                                                    <option value="" hidden=true">Select</option>
                                                    <option value="Y">Yes</option>
                                                    <option value="N">No</option>
                                                </select>
                                            </td>

                                        </tr>


                                        <tr>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label required">Relation with Holder</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="relationWithHolder[$index]"
                                                        name="relationWithHolder[$index]"
                                                        ng-model="item.relationWithHolder" required>
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                                    <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.relationRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                                </select>
                                            </td>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label text-wrap">Date Of Birth(DD/MM/YYYY)</label></td>
                                            <td width="25%">
                                                <p class="input-group">
                                                    <input type="text" class="form-control" id="dateofBirth{{$index}}"
                                                           name="dateofBirth[$index]"
                                                           ng-model="item.dateOfBirthOfMinor"
                                                           uib-datepicker-popup="dd/MM/yyyy"
                                                           ng-init="vm.dateOfBirthOptionsFunc();"
                                                           datepicker-options="vm.dateOfBirthOptions"
                                                           is-open="item.dateOfBirthOptions.opened"
                                                           close-text="Close" maxlength="10"
                                                           ng-blur="vm.textableDatePickerManual('dateofBirth' + $index, item.dateOfBirthOfMinor,item);vm.minorChecking('dateofBirth' + $index, item.dateOfBirthOfMinor,item);"
                                                           ng-keyup="vm.autoslashing('dateofBirth' + $index )"
                                                           chars="numbers-slash" required>
                                                    <span class="input-group-btn">
                        <button type="button" class="btn btn-secondary"
                                ng-click="item.dateOfBirthOptions.opened = true"
                                id="sadateOptions">
                            <i class="glyphicon glyphicon-calendar"></i>
                        </button>
                    </span>
                                                </p>
                                            </td>
                                        </tr>

                                        <tr ng-if="item.isNomineeMinor == 'Y'">
                                            <td width="25%" class="form-group required">
                                                <label class="control-label">Guardian First Name</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianFirstName[$index]" chars="only-letters"
                                                       maxlength="50" name="guardianFirstName[$index]"
                                                       ng-model="item.guardianFirstName" required oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                            <td width="25%">
                                                <label class="control-label">Guardian Middle Name</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianMiddleName[$index]" chars="only-letters"
                                                       maxlength="50" name="guardianMiddleName[$index]"
                                                       ng-model="item.guardianMiddleName" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                        </tr>
                                        <tr ng-if="item.isNomineeMinor == 'Y'">
                                            <td width="25%">
                                                <label class="control-label">Guardian Last Name</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianLastName[$index]" chars="only-letters"
                                                       maxlength="50" name="guardianLastName[$index]"
                                                       ng-model="item.guardianLastName" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label required">Address1</label>
                                            </td>
                                            <td width="25%" >
                                                <input type="text" class="form-control" id="guardianAddress1[$index]"

                                                       maxlength="250" name="guardianAddress1[$index]"
                                                       ng-model="item.guardianAddressOne" required  oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                            </td>
                                        </tr>
                                        <tr ng-if="item.isNomineeMinor == 'Y'">
                                            <td width="25%">
                                                <label class="control-label">Address2</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianAddress2[$index]"

                                                       maxlength="250" name="guardianAddress2[$index]"
                                                       ng-model="item.guardianAddressTwo" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ');">
                                            </td>
                                            <td width="25%">
                                                <label class="control-label">City</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianCity[$index]"
                                                       chars="only-letters"
                                                       maxlength="35" name="guardianCity[$index]"
                                                       ng-model="item.guardianCity" oninput="this.value = this.value.replace(/\s+/g, '')">
                                            </td>
                                        </tr>
                                        <tr ng-if="item.isNomineeMinor == 'Y'">
                                            <td width="25%">
                                                <label class="control-label">State</label>
                                            </td>
                                            <td width="25%">
                                                <select class="form-control" id="guardianState[$index]"
                                                        name="guardianState[$index]"
                                                        ng-init="item.guardianState = '';"
                                                        ng-model="item.guardianState">
                                                    <option value="" hidden="true">Select</option>
                                                    <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                                    <!--                                            <option ng-repeat="item in vm.referenceValueMap[vm.statesRefId]" value="{{item.value}}">{{item.label}}</option>-->
                                                </select>
                                            </td>
                                            <td width="25%" class="form-group required">
                                                <label class="control-label required">Pin Code</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianPinCode[$index]"
                                                       onkeypress="return event.charCode>=48 && event.charCode<=57" chars="only-numbers"
                                                       limit-to="6" name="guardianPinCode[$index]" ng-blur="vm.getAddressOneNom(item.pinCode,$index,'guard')"
                                                       ng-model="item.guardianPinCode" required >
                                            </td>
                                        </tr>
                                        <tr ng-if="item.isNomineeMinor == 'Y'">
                                            <td width="25%">
                                                <label class="control-label">Mobile No</label>
                                            </td>
                                            <td width="25%">
                                                <input type="text" class="form-control" id="guardianMobileNo[$index]"
                                                       onkeypress="return event.charCode>=48 && event.charCode<=57"
                                                       chars="only-numbers"
                                                       limit-to="10" name="phoneNo[$index]"
                                                       ng-model="item.guardianMobileNo" >
                                            </td>

                                            <td width="25%" class="form-group"><label class="control-label">Email Id</label></td>
                                            <td width="25%"><input type="email" class="form-control"
                                                                   id="guardianEmailId" name="guardianEmailId" maxlength="50"
                                                                   ng-model="item.guardianEmail" ng-pattern="vm.emailPattern" chars="email">
                                                <span class="text-danger"
                                                      ng-show="vm.bondSubscriptionFlowForm.emailId.$error.pattern">Enter valid email address</span></td>

                                        </tr>

                                        </tbody>
                                    </table>
                                    <div class="row">
                                        <div class="form-group">
                                            <div class="col-sm-3">
                                                <label for="total" class="control-label">Total %</label>
                                            </div>
                                            <div class="col-sm-2">
                                                <input type="text" class="form-control text-right" id="total" ng-init="vm.calculateSum();"
                                                       chars="float" maxlength="5" ng-model="vm.total" readonly>
                                            </div>
                                        </div>
                                    </div>



                                </ng-form>
                            </div>
                        </div>
                    </form>
                </uib-accordion>



                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="submitButton"
                            ng-disabled="vm.bondSubscriptionFlowForm.$invalid || vm.depositMultiplesErrMsg || vm.customerMasterForm.$invalid"  ng-click="vm.addcustomerMaster();" >Submit</button>

                    <!--                    <button type="submit" class="btn btn-cancel" id="backbtn"-->
                    <!--                            ng-click="vm.tabReferenceAdd ='bondSubscriptionFlowForm'"  >Back-->
                    <!--                    </button>-->
                    <button type="submit" class="btn btn-default" id="submitButton1"  ng-click="vm.tabReferenceAdd ='blaOpeningForm'"
                    >back</button>
                    <button type="submit" class="btn btn-cancel" id="cancelButton"
                            onclick="window.location.href= '#!/rbi_bond_transfer_in/add';">Cancel</button>
                </div>
            </div>
            </form>
            <div class="modal" id="blaModal" role="dialog">
                <div class="modal-dialog">
                    <!-- Modal content-->
                    <div class="modal-content">
                        <div class="modal-header">
                            <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                            <h4 class="modal-title">BLA No List</h4>
                        </div>
                        <div class="modal-body">
                            <div class="loader_popup"></div>
                            <div class="list_wrapper" ng-if="vm.blaNoList.length>0">
                                <div class="col-sm-8 form_submit">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <div class="input-group-addon">
                                                <i class="glyphicon glyphicon-search"></i>
                                            </div>
                                            <input type="text" class="form-control"
                                                   ng-model="vm.versionNoSearch"
                                                   placeholder="Search">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-4 form_submit"></div>
                                <div class="row">

                                    <div class="col-sm-12">
                                        <table class="table table-bordered list scroll sort">
                                            <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                            <tr>
                                                <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                                <th ng-click="(sortedColumn == 'nameOfBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfBondHolder';" ng-class="(sortedColumn == 'nameOfBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                                <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                                <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                            </tr>
                                            </thead>
                                            <tbody>
                                            <tr class="cp"
                                                ng-repeat="x in vm.blaNoList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                                ng-click="vm.customerMaster.blaAccNo = x.blaNo; vm.jointHolderTypeCode = x.jointHolderTypeCode; vm.getBlaAccNoDetails(); " data-dismiss="modal">
                                                <td>{{x.blaNo}}</td>
                                                <td>{{x.nameOfBondHolder}}</td>
                                                <td>{{x.jointHolderType}}</td>
                                                <td>{{x.modeOfHolding}}</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="list_wrapper" ng-if="vm.blaNoList.length==0">No records found to display.</div>
                        </div>

                    </div>
                </div>
            </div>
