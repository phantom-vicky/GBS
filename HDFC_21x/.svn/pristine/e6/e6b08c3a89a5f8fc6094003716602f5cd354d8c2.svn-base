<div class="loader-new" ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">{{(vm.levelCode == '1')?('LINK Cell EOD for RBI Bond') : ('Collecting Branch EOD for RBI Bond') }}</h4>
    <sol-header></sol-header>

    <form name="pensionEodForm" role="form" ng-init="vm.timeValidation()">
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">EOD Date</label>
                </div>
                <div class="col-sm-3">
                    <label class="form-control">{{vm.masterSolDate}}</label>
                </div>
                <div class="col-sm-3"></div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-click="vm.navigateToNextState()">Start</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_admin_functionality';">Cancel</button>
        </div>
    </form>
</div>