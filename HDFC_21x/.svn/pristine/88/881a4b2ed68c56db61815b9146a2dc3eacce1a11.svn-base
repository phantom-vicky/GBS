<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.model">
    <div class="text-right form_submit" >
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!/rbibond_scroll_appendix_IV/action/inquiry';" id="homeButton">Home</button>
        <button type="button" id="cancel_Button" class="btn btn-cancel"
                onclick="window.location.href= '#!/rbibond_scroll_appendix_IV/action/inquiry';">Back</button>
    </div>
    <div class="container from_wrapper new_form_wrapper">
        <div class="row">
            <sol-header></sol-header>
        </div>
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered "
                           >
                        <thead>
                        <tr>
                            <th style="border: none;text-align: center;" colspan="9"><p>Name Of The bank {{vm.bankName}}</p></th>
                        </tr>

                        <tr>
                            <th style="border: none;border-bottom-color: #333333;text-align: center;" colspan="9"><p>Scheme Name {{vm.schemeName}}</p></th>
                        </tr>

                        <tr >
                            <th  style="border: none;text-align: center;"  colspan="9" ><p>Name of The branch {{vm.branch}}</p></th>
                        </tr>
                        <tr>
                            <th  style="border: none;text-align: center;"  colspan="9"><p>Name Of month {{vm.month}}</p></th>
                        </tr>
                        </thead>
                    </table>
                    <table class="table table-bordered table-striped list nowrap table-textWrap datatable"
                           ui-jq="dataTable" ui-options="vm.dataTableOption">
                        <h4 align="center">Repayment Scroll</h4>
                        <h4 align="center">Relief / Saving Bond</h4>
                        <thead>
                        <tr class="thalign">
                            <th>S.No</th>
                            <th>>Bond Ledger Account Number</th>
                            <th >Due Date of Repayment</th>
                            <th colspan="2">Amount Of Repayment</th>
                            <th >Credited to Bank Account Number</th>
                            <th colspan="2">>Amount paind In case Of cheque</th>
                            <th >Remarks</th>
                            <th>Initials</th>
                        </tr>
                        <tr>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th>Nominal value</th>
                            <th>Maturity Value</th>
                            <th></th>
                            <th>Clearing</th>
                            <th>transfer</th>
                            <th></th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        <tr ng-repeat="x in vm.model">
                            <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                            <td>{{x.blaNo}}</td>
                            <td align="center">{{x.dueDateRepay}}</td>
                            <td align="center">{{x.nominalValue}}</td>
                            <td align="center">{{x.maturityvalue}}</td>
                            <td align="right">{{x.creditAccNo}}</td>
                            <td align="center">{{x.clearing}}</td>
                            <td>{{x.transfer}}</td>
                            <td>{{x.remarks}}</td>
                            <td align="right">{{x.initials}}</td>
                        </tr>
                        </tbody>
                        <tfoot>
                        <tr>
                            <th></th>
                            <th></th>
                            <th class="text-center"> Total Rs.</th>
                            <th class="text-right">{{vm.mod}}</th>
                            <th class="text-right">{{vm.mod}}</th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Appendix IV Interest Payment Scroll</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href= '#!/Principal_scrollreport_5106_Mar 24_Appendix_XII.inquiry/action/inquiry';" >Back</button>
        </center>
    </div>
</div>