<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">Broker Master Maintenance - Verify/Reject</h4>
  <sol-header></sol-header>
  <form name="tdsparameter" role="form">
    <div class="row">
      <div class="form-group">
        <div class="col-sm-6">
          <label class="control-label">Name of the Module : <b>RBI Bond</b></label>
        </div>
        <div class="col-sm-2"></div>
        <div class="col-sm-4 text-right"></div>
      </div>
    </div>

    <table class="table table-bordered table-striped list old-new-value-table">
      <thead>
        <tr>
          <th>Particular</th>
          <th>{{(vm.verificationDetails == 'M')?('Old Value'): ('Value')}}</th>
          <th ng-if="vm.verificationDetails == 'M'">New Value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Broker Agency code</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C002)? (vm.tdsParameterList.C002.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C002)? (vm.tdsParameterList.C002.newValue) : ('')}}
          </td>
        </tr>

        <tr>
          <td>Broker Name</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C003)? (vm.tdsParameterList.C003.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C003)? (vm.tdsParameterList.C003.newValue) : ('')}}
          </td>
        </tr>

        <tr>
          <td>Broker Group</td>
          <td class="old-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C005)? (vm.tdsParameterList.C005.oldValue | getLabelFromValuesArray :
            vm.convertLabelValue(vm.brokerGroupList)) : ('')}}
          </td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C005)? (vm.tdsParameterList.C005.newValue | getLabelFromValuesArray :
            vm.convertLabelValue(vm.brokerGroupList)) : ('')}}
          </td>
        </tr>
        <tr>
          <td>Broker Sort code</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C006)? (vm.tdsParameterList.C006.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C006)? (vm.tdsParameterList.C006.newValue) : ('')}}
          </td>
        </tr>
        <!--<tr>
                    <td>HDFC/OTHER BANK</td>
                    <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C007)?
                        (vm.tdsParameterList.C007.oldValue) : ('')}}</td>
                    <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                        {{(vm.tdsParameterList && vm.tdsParameterList.C007)?
                        (vm.tdsParameterList.C007.newValue) : ('')}}
                    </td>
                </tr>-->

        <tr>
          <td>Operative Account Number</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C008)? (vm.tdsParameterList.C008.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C008)? (vm.tdsParameterList.C008.newValue) : ('')}}
          </td>
        </tr>

        <!-- <tr>
                     <td>HDFC Branch Code</td>
                     <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C010)?
                         (vm.tdsParameterList.C010.oldValue) : ('')}}</td>
                     <td ng-if="vm.verificationDetails == 'M'" class="new-value">
                         {{(vm.tdsParameterList && vm.tdsParameterList.C010)?
                         (vm.tdsParameterList.C010.newValue) : ('')}}
                     </td>
                 </tr>-->
        <tr>
          <td>Type Of Broker</td>
          <td class="old-value">
            {{ (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.oldValue === 'GR') ? 'GST REGISTERED' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.oldValue === 'GUR') ? 'GST UNREGISTERED' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.oldValue === 'I') ? 'INDIVIDUAL' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.oldValue === 'NI') ? 'NON-INDIVIDUAL' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.oldValue === 'CG') ? 'COMPOSITE GST' : '' }}
          </td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{ (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.newValue === 'GR') ? 'GST REGISTERED' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.newValue === 'GUR') ? 'GST UNREGISTERED' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.newValue === 'I') ? 'INDIVIDUAL' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.newValue === 'NI') ? 'NON-INDIVIDUAL' : '' }} {{
            (vm.tdsParameterList && vm.tdsParameterList.C011 && vm.tdsParameterList.C011.newValue === 'CG') ? 'COMPOSITE GST' : '' }}
          </td>
        </tr>
        <tr>
          <td>IFSC Code</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C012)? (vm.tdsParameterList.C012.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C012)? (vm.tdsParameterList.C012.newValue) : ('')}}
          </td>
        </tr>
        <tr>
          <td>GST No</td>
          <td class="old-value">{{(vm.tdsParameterList && vm.tdsParameterList.C013)? (vm.tdsParameterList.C013.oldValue) : ('')}}</td>
          <td ng-if="vm.verificationDetails == 'M'" class="new-value">
            {{(vm.tdsParameterList && vm.tdsParameterList.C013)? (vm.tdsParameterList.C013.newValue) : ('')}}
