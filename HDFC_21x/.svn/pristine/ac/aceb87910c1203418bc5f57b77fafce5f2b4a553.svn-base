<!-- Second Page-->
<div class="container from_wrapper">

<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<h4 class="form_heading">CAS Acknowledgement Number Maintenance - Inquiry</h4>
<sol-header></sol-header>

<!--<div class="container from_wrapper new_form_wrapper">-->
    <div class="row">
        <div class="col-sm-12">
            <div class="table-responsive">
                <table class="table table-bordered table-striped list">
                    <tr>
                        <td width="25%" class="form-group">
                            <label class="control-label">Name of the Bond Scheme</label></td>
                        <td width="25%">
                            <label class="control-label" >{{vm.schemeName}}</label>
                        </td>
                        <td width="25%" class="form-group">
                            <label class="control-label">Subscription Date</label></td>
                        <td width="25%">
                            <label class="control-label" >{{vm.subsDate}}</label>
                        </td>
                    </tr>
                    <tr>
                        <th  width="25%">CAS Acknowledgement Number</th>
                        <td  width="25%"><input type="text" class="form-control" id="casAckNum"
                                                name="casAckNum" chars="only-numbers" ng-model="vm.auditInfo.casAckNum" required readonly></td>
                        <th  width="25%">CAS Acknowledgement Date</th>
                        <td  width="25%"> <p class="input-group">
                            <input type="text" class="form-control" id="casAckDate"
                                   name="casAckDate" ng-model="vm.auditInfo.casAckDate" required readonly  >
                        </p></td>
                    </tr>
                    <tr>
                        <th width="25%">CAS Transfer Date</th>
                        <td width="25%">
                            <p class="input-group">
                                <input type="text" class="form-control" id="casTranDate" name="casTranDate"
                                       ng-model="vm.auditInfo.casTranDate" required readonly/>
                            </p>
                        </td>
                        <th  width="25%">Brokerage Advice Number</th>
                        <td  width="25%"><input type="text" ng-if="vm.brkAdviceNumber" class="form-control" id="brkAdviceNumber"
                                                name="brkAdviceNumber" chars="only-numbers" ng-model="vm.brkAdviceNumber" required readonly></td>
                    </tr>
                </table>
                <table class="table table-bordered table-striped list">

                    <thead>
                    <tr>
                        <th>S.No</th>
                        <th>Bond Ledger Account Number</th>
                        <th>Holder Name</th>
                        <th>Subscription ID</th>
                        <th>Subscription Amount</th>
                        <th>Bond Type</th>
                       <!-- <th>CAS Acknowledgement Number</th>
                        <th>CAS Acknowledgement Date (dd/mm/yyyy)</th>-->

                    </tr>
                    </thead>
                    <tbody>
                    <tr ng-repeat="items in vm.model">

                        <td>{{vm.itemsPerPage*(vm.currentPage-1)+$index+1}}</td>
                        <td>{{items.bondLedgeAccNum}}</td>
                        <td>{{items.holderName}}</td>
                        <td>{{items.subsId}}</td>
                        <td>{{vm.indianNumberFormat(items.subsAmt)}}</td>
                        <td>{{items.bondType}}</td>
                       <!-- <td>{{items.casAckNum}}</td>
                        <td>{{items.casAckDate}}</td>-->
                    </tr>
                    </tbody>
                    <tfoot>
                    <th colspan="1" style="text-align: right;">Total</th>
                    <th colspan="2">{{vm.model.length}}</th>
                    <th colspan="1" style="text-align: right;">Total Subscription Amount</th>
                    <th colspan="2">{{vm.indianNumberFormat(vm.totalSubScriptionAmount)}}</th>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="audit-details">
        <div class="row">
            <div class="col-md-4">
                <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
            </div>
            <div class="col-md-4">
                <span> <b> Last Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.verifiedBy) : ('None')}}</span>
            </div>
            <div class="col-md-4">
                <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <span> <b> Created On </b> : {{ vm.auditInfo.createdDate | date : 'dd/MM/yyyy'}}</span>
            </div>
            <div class="col-md-4">
                <span> <b> Last Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
            </div>
            <div class="col-md-4">
            </div>
        </div>
    </div>

<!--</div>-->


<div class="text-center form_submit">
    <button type="button" id="otherpen_cancelButton" class="btn btn-cancel"
            onclick="window.location.href='#!/cas_acknowledgement_number_maintenance/action/inquiry';">Back</button>
</div>
</div>