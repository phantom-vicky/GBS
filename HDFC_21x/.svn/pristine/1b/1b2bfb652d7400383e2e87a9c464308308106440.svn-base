.cp {
  cursor: pointer;
}
.modal-header,
.modal-footer {
  text-align: center;
  background: #FFF;
  background: -webkit-linear-gradient(to right, #1f629a, #FFF 25%);
  background: -o-linear-gradient(to right, #1f629a, #FFF 25%);
  background: -moz-linear-gradient(to right, #1f629a, #FFF 25%);
  background: linear-gradient(to right, #1f629a, #FFF 25%);
  color: #1f629a;
}
form .alert {
  padding: 2px 5px;
  font-size: 12px;
  -ms-filter: "progid:DXImageTransform.Microsoft.Alpha(Opacity=90)";
  /* IE 8 */
  filter: alpha(opacity=50);
  /* IE 5-7 */
  -moz-opacity: 0.9;
  /* Netscape */
  -khtml-opacity: 0.9;
  /* Safari 1.x */
  opacity: 0.9;
  /* Good browsers */
}
.list {
  background: #EBEFF2;
}
.scroll tbody {
  display: block;
  max-height: 300px;
  overflow-y: scroll;
}
.scroll thead,
.scroll tbody tr {
  display: table;
  width: 100%;
  table-layout: fixed;
  /* even columns width , fix width of table too*/
}
.scroll thead {
  width: calc(97%) /* scrollbar is average 1em/16px width, remove it from thead width */;
}
.home a:active,
.home a:link,
.home a:visited {
  color: #FFF !important;
}
.home .fa {
  font-size: 18px;
}
