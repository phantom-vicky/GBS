<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.model">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default" onclick="window.location.href='#!/dc';" id="homeButton">Home</button>
        <button type="submit" class="btn btn-default" data-ng-click="vm.printpage('CERTIFICATE OF INVESTMENT');">Print</button>
        <button type="button" id="cancel_Button" class="btn btn-cancel" onclick="window.location.href= '#!/rbibond_certificate_of_investment_report/action/inquiry';">Back</button>
    </div>
    <sol-header></sol-header>
<!--    style="border: 1px solid #ddd; padding: 2em"-->
    <div class="text-justify" id="section-to-print">
        <!-- Render different content based on vm.schemeFlag -->
        <div data-ng-if="vm.schemeFlag === 'Y' && vm.list" class="page-break" data-ng-repeat="list in vm.list">
            <div style="border: 1px solid #000; padding: 2em; font-family: 'Times New Roman'; margin:20px">
                <!-- Content for Scheme Y (vm.list) -->
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr>
                        <td></td>
                        <td align="right">
                            <p><b>Certificate No: {{list.certificateNo}}</b></p>
                        </td>
                    </tr>
                </table>

                <h3 align="center"><b>CERTIFICATE OF INVESTMENT</b></h3>
                <br/>
                <h4 align="center"><b>{{vm.schemeName}}</b></h4>
                <table width="100%" border="0" cellspacing="0" cellpadding="0">
                    <tr align="left" height="30">
                        <td>
                            <p>
                                <font face="TIMES NEW ROMAN" size="3"><b>TO : </b></font>
                            </p>
                            <p><b>{{list.holderName }}</b></p>
                            <p><b>{{list.bondAddress}}</b></p>
                            <p><b>{{list.city}}</b></p>
                            <p><b>{{list.state}}</b></p>
                            <p><b>{{list.pinCode}}</b></p>
                        </td>
                    </tr>

                    <tr valign="top" height="40" style="width:100%">
                        <td style="width:80%">
                            <p>
                                <font face="TIMES NEW ROMAN" size="4"><b>Dear Sir/Madam,</b></font>
                            </p>
                        </td>
                        <td style="width:20%">
                            <span><b>{{list.bondType}}</b></span> <br>
                            <span><b>Date:{{vm.currentDate}}</b></span>
                        </td>
                    </tr>

                    <tr valign="top" height="40">
                        <td colspan="4">
                            <p align="center">
                                <font face="TIMES NEW ROMAN" size="4"><b>Certificate of Investment</b></font>
                            </p>
                        </td>
                    </tr>
                    <tr align="left" valign="top" height="30">
                        <td>
                            <p>
                                <font face="Times New Roman" size="3">
                                    With reference to your Application No <b>{{list.nasikDate}}</b> dated
                                    <b>{{list.depositeDate }}</b>, we advise that your Bond Ledger Account No.
                                    <b>{{list.blaNo}}</b> has been credited with an amount of Rs.
                                    <b>{{vm.indianFormat(list.maturityAmt) }}</b> This amount will be due for repayment on
                                    <b>{{list.maturityDate }}</b>. The interest on the same will be payable on 01/01 & 01/07/repayment dates.
                                </font>
                            </p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td>
                            <p>The interest @ {{list.intrestRate}} on the same will be payable half yearly.</p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td>
                            <p><b>Maturity Amount Of The Said Investment: Rs. {{vm.indianFormat(list.maturityAmt)  }}</b></p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td>
                            <p><b>Nomination: {{list.nomineeId}}</b></p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td>
                            <p><b>Mode Of Operation: {{list.modeOfHolding}}</b></p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td>
                            <p><b>Applicant Holder: {{list.holderName}}</b></p>
                        </td>
                    </tr>
                    <tr valign="top" height="30">
                        <td><br/><br/><br/></td>
                    </tr>
                    <tr valign="top" height="30">
                        <td><p align="left">Yours Sincerely,</p></td>
                    </tr>



                </table>




                    <div style="margin-top: 30px">
                        <table border="0" style="border-collapse: collapse; width: 100%" aria-label="COI">
                            <tr>
                                <td style="text-align: left; vertical-align: top; width: 50%;">
                                    <div style="display: flex; flex-direction: column; align-items: left;">
                                        <img src="assets/images/nageswaran.jpg" class="img-responsive"
                                             alt="nageswaran" style="width: 200px; height: auto; margin-top: 10px;">

                                    </div>
                                </td>

                            </tr>

                        </table>


                        <div style="margin-top: 10px; text-align: left">
                            <p><b>Branch Reference Number: {{list.certificateNo}}</b></p>
                        </div>
                    </div>

            </div>

        </div>

        <div data-ng-if="vm.list1" class="page-break" data-ng-repeat="l1 in vm.list1">
            <!-- Content for Scheme N (vm.list1) -->
            <div style="border: 1px solid #000; padding: 2em; font-family: 'Times New Roman'; margin:20px">
                <!-- Header Section -->
<!--                <div style="text-align: center">-->
<!--                    <h3><b>Government of India</b> </h3>-->
<!--                    <h3><b>Certificate of Investment</b></h3>-->
<!--                    <h3 style="text-align: right"><b>CHENNAI</b></h3>-->
<!--                    <p align="left"><u>Annexure 1</u></p>-->
<!--                    <p align="left">Form 'A'</p>-->
<!--                    <h4>{{vm.schemeName}}</h4>-->
<!--                    <h4><u>Bond Ledger Account :{{l1.blaNo}}</u></h4>-->
<!--                </div>-->


                <table border="0" style="border-collapse: collapse; width: 100%; text-align: center" aria-label="">
                    <tr>
                        <th scope="col"></th>
                    </tr>
                    <tbody>
                    <tr>
                        <td style="text-align: left">Annexure 1</td>
                        <td style="text-align: center; font-weight: bold; font-size: 1.17em">Government of India</td>
                        <td style="text-align: right; font-weight: bold; font-size: 1.17em">
                            <span data-ng-if="vm.subscriptionId">DUPLICATE</span> <br>
                            <span>{{l1.receivingOffice}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="text-align: left">Form 'A'</td>
                        <td style="text-align: center; font-weight: bold; font-size: 1.17em">Certificate of Investment</td>
                        <td style="text-align: right"></td>
                    </tr>
                    <tr>
                        <td style="text-align: left"></td>
                        <td style="text-align: center; font-size: 1.12em; padding-top:10px;padding-bottom:10px"><strong>{{vm.schemeName}}</strong></td>
                        <td style="text-align: right"></td>
                    </tr>
                    <tr>
                        <td style="text-align: left"></td>
                        <td style="text-align: center; font-size: 1.12em"><strong>Bond Ledger Account: {{l1.blaNo}}</strong></td>
                        <td style="text-align: right"></td>
                    </tr>
                    </tbody>
                </table>

                <div style="text-align: right">
                    <p><b>{{l1.location}}</b></p>
                    <p><b>Date: {{vm.currentDate}}</b></p>
                </div>


                <!-- Address Section -->
                <div style="margin-top: 10px">
                    <p><b>To:</b></p>
                    {{l1.holderName}} <br>
                    {{l1.bondAddress}} <br>
                    {{l1.city}} <br>
                    {{l1.state}} {{vm.model.pinCode}} <br>
                </div>

                <!-- Bond Details Section -->
                <div style="margin-top: 10px">
                    We hereby certify that Shri/Smt <b>{{l1.holderName}}</b> is/are the holder(s) of
                        <b>{{vm.schemeName}}</b>/{{l1.modeOfHolding}} held in the Bond Ledger Account No.
                        <b>{{l1.blaNo}}</b> with {{l1.city}} as per details given below: <br>
                    Interest on the bonds is payable semi-annually with resetting of the coupon rate every
                        <b>{{vm.model.intPaymtDate1}}</b> & <b>{{l1.intPaymtDate2}}</b>. <br>
                    This issue is subject to the termsand conditions laid down in government of India Notification NO. <br>
                    {{l1.notificationNo}}/2020 dated {{l1.notificationDate}}
                </div>

                <h4 align="center">
                    <u><b>Details Of Bond Held In Bond Ledger Account</b></u>
                </h4>
                <table border="1" width="100%" cellpadding="10" cellspacing="0" style="text-align: center">
                    <thead>
                    <tr>
                        <th>Sr No.</th>
                        <th colspan="2">Investment</th>
                        <th>Certificate No.</th>
                        <th colspan="2">Transfer</th>
                        <th>Due Date of Repayment</th>
                        <th colspan="2">Repayment</th>
                        <th>Balance</th>
                        <th>Initials under Bank's seal</th>
                    </tr>
                    <tr>
                        <th></th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th></th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th></th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th></th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr>
                        <td>1</td>
                        <td>2</td>
                        <td>3</td>
                        <td>4</td>
                        <td>5</td>
                        <td>6</td>
                        <td>7</td>
                        <td>8</td>
                        <td>9</td>
                        <td>10</td>
                        <td>11</td>
                    </tr>
                    <tr>
                        <td>{{$index+1}}</td>
                        <td>{{l1.investmentDate}}</td>
                        <td>{{ vm.formatIndianCurrency(l1.investmentAmt) }}</td>
                        <td>{{l1.certificateNo}}</td>
                        <td>{{l1.transferDate}}</td>
                        <td>{{ vm.formatIndianCurrency(l1.transferAmt) }}</td>
                        <td>{{l1.maturityDate}}</td>
                        <td>{{l1.repaymentDate}}</td>
                        <td>{{ vm.formatIndianCurrency(l1.repaymentAmt) }}</td>
                        <td>{{ vm.formatIndianCurrency(l1.balance)}}</td>
                        <td>{{l1.initialUndrBankSeal}}</td>
                    </tr>
                    </tbody>
                    <tfoot>
                    <tr>
                        <td colspan="2"><b>Total:</b></td>
                        <td><b>{{ vm.formatIndianCurrency(l1.investmentAmt) }}</b></td>
                        <td></td>
                        <td></td>
                        <td><b>{{ vm.formatIndianCurrency(l1.repaymentAmt) }}</b></td>
                        <td></td>
                        <td></td>
                        <td><b>{{ vm.formatIndianCurrency(l1.transferAmt) }}</b></td>
                        <td><b>{{ vm.formatIndianCurrency(l1.balance)}}</b></td>
                        <td></td>
                    </tr>
                    </tfoot>
                </table>

                <!-- Total Investment Section -->
                <div style="margin-top: 10px">
                    <p>Total Investment Amount (Amount In Words): <b>({{vm.convertNumberToWords(l1.investmentAmt)}})</b></p>
                </div>

                <!-- Additional Details -->
                <div style="margin-top: 10px">
                    <p>Name of the Receiving Office: {{l1.receivingOffice}}</p>
                    <p>Branch Code / Ref No: {{l1.subscriptionId}}</p>
                    <p><b>Mode of Operation:</b> {{l1.modeOfHolding}}</p>
                    <p><b>Applicant Holder(s):</b> {{l1.holderName}}</p>
                </div>

                <!-- Footer Section -->
                <div style="margin-top: 30px">
                    <table border="0" style="border-collapse: collapse; width: 100%" aria-label="COI">
                        <tr>
                            <td style="text-align: left; vertical-align: top; width: 50%;">
                                <div style="display: flex; flex-direction: column; align-items: left;">
                                    <img src="assets/images/kesavan.jpg" class="img-responsive"
                                         alt="kesavan" style="width: 200px; height: auto; margin-bottom: 10px;">
                                    <div>
                                        Nomination Registered<br />
                                        at Sr No: {{l1.nomineeId || ''}}
                                    </div>
                                </div>
                            </td>
                            <td style="text-align: right; vertical-align: top; width: 20%;">
                                <img src="assets/images/nageswaran.jpg" class="img-responsive"
                                     alt="nageswaran" style="width: 200px; height: auto; margin-top: 10px;">
                            </td>
                        </tr>

                    </table>
                    <div style="margin-top: 10px; text-align: left">
                        <p>Note: This certificate is non-negotiable. It is a record of investment for the information of the holder and need not be surrendered, at the time of redemption.</p>
                    </div>


                </div>

                <!--                <div style="margin-top:20px; text-align:left;">-->
                <!--                    <p>Nomination Registered</p>-->
                <!--                    <p>at Sr No: {{vm.model.nomineeId || 'NULL'}}</p>-->
                <!--                </div>-->


            </div>
        </div>
    </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">BLA statement for bondholders</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default" onclick="window.location.href= '#!/BLA_statement_for_Bondholders_report.inquiry/action/inquiry';">Back</button>
        </center>
    </div>
</div>

<style>
  @media print {
    .page-break {
      page-break-before: always;
    }
  }
</style>