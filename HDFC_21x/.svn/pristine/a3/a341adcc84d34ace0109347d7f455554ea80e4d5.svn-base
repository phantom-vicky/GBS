<style>
    @media print {
      .page-break {
        page-break-before: always;
      }
    }
</style>


<style>
    .doc-list {
        list-style: none;
        padding-left: 0;
        margin-left: 0;
    }

    .doc-list li {
        position: relative;
        padding-left: 25px;
        margin-bottom: 10px;
        line-height: 1.5;
    }

    .doc-list li::before {
        content: "➢";
        position: absolute;
        left: 0;
        top: 0;
        font-weight: bold;
    }
</style>