                                        for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C047" name="C047"
                                                       maxlength="30" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetails.C047.oldValue"
                                                       chars="only-letters"></td>

                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C048" name="C048" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       maxlength="120"
                                                       ng-model="vm.customerMasterDetails.C048.oldValue"
                                                       ></td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C049" name="C049" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetails.C049.oldValue"
                                                       chars="only-letters"></td>

                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C050" name="C050" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       maxlength="120"
                                                       ng-model="vm.customerMasterDetails.C050.oldValue"
                                                       ></td>
