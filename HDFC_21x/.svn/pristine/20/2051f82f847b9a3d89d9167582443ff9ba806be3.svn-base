<div class="loader-new" data-ng-if="vm.loader"></div>
<div class="container from_wrapper new_form_wrapper">
  <h4 class="form_heading">Broker appointment /enrolled report and broker appointment letter to brokers</h4>
  <sol-header></sol-header>
  <form name="BrokerAppointmentForm" role="form">

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3">
          <label class="control-label">Name of the Module</label>
        </div>
        <div class="col-sm-5">
          <label><b>RBI Bond</b></label>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="brokerAgencyCode" class="control-label">Broker Agency Code</label></div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="brokerAgencyCode" data-ng-model="vm.brokerAgencyCode" readonly />
        </div>
        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0">
          <span class="glyphicon glyphicon-search cp" data-toggle="brokerAgencyCode" id="treasurySearch" data-ng-click="vm.getBrokerAgencyCode()"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.brokerAgencyCode=''"></span>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label for="schemeName" class="control-label">Name of the Bond Scheme</label></div>
        <div class="col-sm-2">
          <input type="text" class="form-control" id="schemeName" data-ng-model="vm.schemeName" required readonly />
        </div>
        <div class="col-sm-2" style="display: flex; align-items: center; height: 34px; gap: 5px; padding-left: 0">
          <span class="glyphicon glyphicon-search cp" data-toggle="schemeName" id="treasurySearch" data-ng-click="vm.getSchemeName()"></span>
          <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.schemeCode =''; vm.schemeName=''; vm.brokerAgencyCode=''; vm.fromDate=''; vm.toDate=''"></span>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">From Date (dd/mm/yyyy)</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="effFromDateR1"
              name="effFromDate"
              data-ng-model="vm.fromDate"
              data-uib-datepicker-popup="dd/MM/yyyy"
              data-ng-init="vm.fromDate=''; vm.fromDateVal()"
              data-ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
              data-datepicker-options="vm.fromDateOptions"
              data-is-open="vm.fromDatePicker.opened"
              data-close-text="Close"
              maxlength="10"
              required
              readonly
            />
            <span class="input-group-btn" data-ng-if="vm.schemeName">
              <button type="button" class="btn btn-secondary" data-ng-click="vm.fromDatePicker.opened = true" id="effFromDateSearcherR1">
                <span class="glyphicon glyphicon-calendar"></span>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="form-group required">
        <div class="col-sm-3"></div>
        <div class="col-sm-3"><label class="control-label">To Date (dd/mm/yyyy)</label></div>
        <div class="col-sm-2">
          <p class="input-group">
            <input
              type="text"
              class="form-control"
              id="effToDateR"
              name="effToDate"
              data-ng-model="vm.toDate"
              data-uib-datepicker-popup="dd/MM/yyyy"
              data-ng-init="vm.toDate=''"
              data-datepicker-options="vm.toDateOptions"
              data-is-open="vm.effToDatePicker.opened"
              data-close-text="Close"
              maxlength="10"
              readonly
              required
            />
            <span class="input-group-btn" data-ng-if="vm.fromDate">
              <button type="button" class="btn btn-secondary" data-ng-click="vm.effToDatePicker.opened = true" id="effToDateSearcherR">
                <span class="glyphicon glyphicon-calendar"></span>
              </button>
            </span>
          </p>
        </div>
      </div>
    </div>

    <div class="text-center form_submit">
      <button
        type="button"
        class="btn btn-default"
        id="submitButton"
        data-ui-sref="Broker_Appointment_Enrolled_Report_Letter.inquiry_details({obj:{
                        brokerAgencyCode    :   vm.brokerAgencyCode,
                        schemeCode          :   vm.schemeCode,
                        schemeName          :   vm.schemeName,
                        fromDate            :   vm.fromDate,
                        toDate              :   vm.toDate
                        }})"
        data-ng-disabled="BrokerAppointmentForm.$invalid"
      >
        Submit
      </button>
      <button type="button" class="btn btn-cancel" id="cancelButton" onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel</button>
    </div>

    <div class="text-center">
      <notice-message-directive></notice-message-directive>
    </div>
  </form>
</div>

<div class="modal" id="brokerAgencyModel" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.modalSearch=''">&times;</button>
        <h4 class="modal-title">Broker Agency Code</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.brokerAgencyCodeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input
                  type="text"
                  class="form-control"
                  data-ng-model="vm.modalSearch"
                  data-ng-init="vm.modalSearch = ''"
                  placeholder="Search"
                  oninput="this.value = this.value.replace(/[^a-zA-Z0-9 ]/g, '').replace(/^\s+/, '').replace(/\s{2,}/g, ' ')"
                />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="">
                <thead data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Agency Code
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Broker Name
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Branch ID
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      Verify Status
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="cp" data-ng-repeat="x in vm.brokerAgencyCodeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder" data-ng-click="vm.brokerAgencyCode = x.brokerAgencyCode;" data-bs-dismiss="modal">
                    <td>{{x.brokerAgencyCode}}</td>
                    <td>{{x.brokerName}}</td>
                    <td>{{x.branchID}}</td>
                    <td>{{x.verifyStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.brokerAgencyCodeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>

<div class="modal" id="schemeModel" role="dialog">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-bs-dismiss="modal" data-ng-click="vm.modalSearch=''">&times;</button>
        <h4 class="modal-title">Name of the Bond Scheme</h4>
      </div>
      <div class="modal-body">
        <div class="loader_popup"></div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length>0">
          <div class="col-sm-8 form_submit">
            <div class="form-group">
              <div class="input-group">
                <div class="input-group-addon">
                  <span class="glyphicon glyphicon-search"></span>
                </div>
                <input type="text" class="form-control" data-ng-model="vm.modalSearch" data-ng-init="vm.modalSearch = ''" placeholder="Search" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\s{2,}/g, ' ')" />
              </div>
            </div>
          </div>
          <div class="col-sm-4 form_submit"></div>
          <div class="row">
            <div class="col-sm-12">
              <table class="table table-bordered list scroll sort" aria-label="">
                <thead data-ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                  <tr>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                      data-ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      SCHEME NAME
                    </th>
                    <th
                      scope="col"
                      data-ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                      data-ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')"
                    >
                      STATUS
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr
                    class="cp"
                    data-ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                    data-ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                    data-bs-dismiss="modal"
                  >
                    <td>{{x.schemeName}}</td>
                    <td>{{x.schemeStatus}}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="list_wrapper" data-ng-if="vm.schemeList.length==0">No records found to display.</div>
      </div>
    </div>
  </div>
</div>
