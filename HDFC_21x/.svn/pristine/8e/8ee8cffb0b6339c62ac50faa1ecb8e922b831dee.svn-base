                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">

                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll sort">
                                        <thead ng-init="reverseOrder=false;sortedColumn = 'panNo'">
                                        <tr>
                                            <th ng-click="(sortedColumn == 'bankName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bankName';" ng-class="(sortedColumn == 'bankName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bank Name</th>
                                            <th ng-click="(sortedColumn == 'instIfscCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'instIfscCode';" ng-class="(sortedColumn == 'instIfscCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">IFSC Code</th>
                                            <th ng-click="(sortedColumn == 'micrBankCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBankCode';" ng-class="(sortedColumn == 'micrBankCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Bank Code</th>
                                            <th ng-click="(sortedColumn == 'micrBranchCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'micrBranchCode';" ng-class="(sortedColumn == 'micrBranchCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">MICR Branch Code</th>
                                            <!--                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bla No</th>-->
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.nonHdfcTorchList | filter:vm.search | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetails.ifscCode=x.instIfscCode;vm.customerMasterDetails.micrCode=x.micrBankCode;vm.customerMasterDetails.branchCode=x.micrBranchCode;" data-bs-dismiss="modal">
                                            <td>{{x.bankName}}</td>
                                            <td>{{x.instIfscCode}}</td>
                                            <td>{{x.micrBankCode}}</td>
                                            <td>{{x.micrBranchCode}}</td>

                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.panDataList.length==0">No records found to display.</div>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal" id="guardianModal" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Guardian List</h4>
                    </div>
                    <div class="modal-body">
                        <div class="loader_popup"></div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsList.length>0">
                            <div class="col-sm-8 form_submit">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="glyphicon glyphicon-search"></i>
                                        </div>
                                        <input type="text" class="form-control"
                                               ng-model="vm.versionNoSearch"
                                               placeholder="Search" chars="alpha-numeric">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll sort">
                                        <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                        <tr>
                                            <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                            <th ng-click="(sortedColumn == 'guardianName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'guardianName';" ng-class="(sortedColumn == 'guardianName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Guardian Name</th>
                                            <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                            <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.guardianDetailsList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetails.guardianId = x.guardianId; vm.getGuardianDetails();" data-bs-dismiss="modal">
                                            <td>{{x.blaNo}}</td>
                                            <td>{{x.guardianName}}</td>
                                            <td>{{x.nameOfTheBondHolder}}</td>
                                            <td>{{x.modeOfHolding}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsList.length==0">No records found to display.</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal" id="guardianModalTwo" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Guardian List</h4>
                    </div>
                    <div class="modal-body">
                        <div class="loader_popup"></div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsListTwo.length>0">
                            <div class="col-sm-8 form_submit">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="glyphicon glyphicon-search"></i>
                                        </div>
                                        <input type="text" class="form-control"
                                               ng-model="vm.versionNoSearch"
                                               placeholder="Search" chars="alpha-numeric">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll sort">
                                        <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                        <tr>
                                            <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                            <th ng-click="(sortedColumn == 'guardianName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'guardianName';" ng-class="(sortedColumn == 'guardianName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Guardian Name</th>
                                            <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                            <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.guardianDetailsListTwo | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetailsTwo.guardianId = x.guardianId; vm.getGuardianDetailsTwo();" data-bs-dismiss="modal">
                                            <td>{{x.blaNo}}</td>
                                            <td>{{x.guardianName}}</td>
                                            <td>{{x.nameOfTheBondHolder}}</td>
                                            <td>{{x.modeOfHolding}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsListTwo.length==0">No records found to display.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal" id="guardianModalThree" role="dialog">
            <div class="modal-dialog">
                <!-- Modal content-->
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                        <h4 class="modal-title">Guardian List</h4>
                    </div>
                    <div class="modal-body">
                        <div class="loader_popup"></div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsListThree.length>0">
                            <div class="col-sm-8 form_submit">
                                <div class="form-group">
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="glyphicon glyphicon-search"></i>
                                        </div>
                                        <input type="text" class="form-control"
                                               ng-model="vm.versionNoSearch"
                                               placeholder="Search" chars="alpha-numeric">
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-4 form_submit"></div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-bordered list scroll sort">
                                        <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                        <tr>
                                            <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                            <th ng-click="(sortedColumn == 'guardianName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'guardianName';" ng-class="(sortedColumn == 'guardianName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Guardian Name</th>
                                            <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';" ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                            <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        <tr class="cp"
                                            ng-repeat="x in vm.guardianDetailsListThree | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                            ng-click="vm.customerMasterDetailsThree.guardianId = x.guardianId; vm.getGuardianDetailsThree();" data-bs-dismiss="modal">
                                            <td>{{x.blaNo}}</td>
                                            <td>{{x.guardianName}}</td>
                                            <td>{{x.nameOfTheBondHolder}}</td>
                                            <td>{{x.modeOfHolding}}</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="list_wrapper" ng-if="vm.guardianDetailsListThree.length==0">No records found to display.</div>
                    </div>
                </div>
            </div>
        </div>
        <div id="reversalForm"  ng-show="vm.tabReferenceAdd=='reversalForm'" class="tab-pane  fade in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="vm.bondSubscriptionFlowForm" role="form" ng-submit="vm.submitAddForm();">
                        <div uib-accordion-group id="personal1-details" class="panel"
                             heading='BOND HOLDER REVERSAL DETAILS' is-open="vm.personalDetailsOpen"
                             ng-class="(vm.customerPersonalDetails.$invalid) ? 'panel-danger' : 'panel-success'">
                            <ng-form name="vm.customerPersonalDetails" ng-init="vm.customerMasterDetails">
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" >
                                            <label  class="control-label">Module Name</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label">RBI Bond</label>
                                        </td>
                                        <td width="25%">
                                            <label  class="control-label required">Name of the Bond Scheme</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="schemeCode"
                                                           ng-model="vm.schemeName"
                                                           chars="alpha-numeric" readonly required leading-space>
                                                </div>
                                                <!-- <div class="col-sm-3 torch-top">
                                                     <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                                                        id="treasurySearch"
                                                        ng-click="vm.getAddModuleName();"></i> <i
                                                         class="glyphicon glyphicon-remove clear cp"
                                                         ng-click="vm.schemeCode ='';vm.schemeName ='';vm.bondHolderName='';vm.blaNo='';vm.blaNum='';vm.panNo='';"></i>
                                                 </div>-->
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%"><label
                                                for="bondHolderName" class="control-label">Bond Holder Name</label></td>
                                        <td width="25%">
                                            <input type="text" class="form-control"  maxlength="50"
                                                   id="bondHolderName" name="bondHolderName" ng-model="vm.bondHolderName" chars="only-character" oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')" disabled>
                                        </td>
                                        <td width="25%"><label for="panNo" class="control-label">PAN No</label></td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="panNo" ng-model="vm.panNo"
                                                           chars="alpha-numeric" oninput="this.value = this.value.replace(/\s+/g, '')" disabled></div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label required">Mode of Holding</label>
                                        </td>
                                        <td width="25%">
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH001'" >Single</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH002'" >JOINT - JOINTLY</label>
                                            <label class="data-bind" ng-if="vm.modeOfHolding=='MH003'" >JOINT - ANYONE OR SURVIVOR</label>
                                        </td>
                                        <td width="25%">
                                            <label class="form-group required"> From BLA Account Number</label>
                                        </td>
                                        <td width="25%">
                                            <div class="row">
                                                <div class="col-sm-9">
                                                    <input type="text" class="form-control" id="blaAccNo" ng-model="vm.blaAccNo"
                                                           ng-init="vm.blaAccNo = '';" oninput="this.value = this.value.replace(/[^0-9]/g, '')"
                                                           chars="only-numbers" minlength="5" maxlength="20" required disabled></div>
                                                <div class="col-sm-3 torch-top" ng-if="vm.schemeName && vm.blaAccNo">
                                                                   <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal" id="versionNoSearch"
                                                                   ng-click="vm.getBlaAccNo();vm.searchSolId='';"></span>
                                                    <!--<span class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaAccNo = '';vm.bondScbId='';
                                                                            vm.blaAccNoTo='';vm.reversalRemarks='';"></span>-->
                                                </div></div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label class="control-label required">To BLA Account Number</label>
                                        </td>
                                        <td width="25%" ng-if="vm.blaFlag=='Y'">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" id="blaAccNoTo"
                                                           ng-model="vm.blaAccNoTo"
                                                           chars="only-numbers" minlength="5" maxlength="20" required disabled>
                                                </div>
                                                <!--<div class="col-sm-3 torch-top" ng-if="vm.schemeName && vm.blaAccNoTo">
                                                                        <span class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                                                              id="blaAccNoToSearch" ng-click="vm.getBlaAccNoTo();vm.searchSolId='';"></span>
                                                    <span class="glyphicon glyphicon-remove clear cp" ng-click="vm.blaAccNoTo = '';"></span>
                                                </div>-->
                                            </div>
                                        </td>
                                        <td width="25%" ng-if="vm.blaFlag=='N'">
                                            <div class="row">
                                                <div class="col-sm-12">
                                                    <input type="text" class="form-control" required disabled>
                                                </div>
                                            </div>
                                        </td>
                                        <td width="25%">
                                            <label for="count" class="control-label">Subscription Count</label>
                                        </td>
                                        <td width="25%">
                                            <input type="text" class="form-control" id="count" maxlength="50" name="count" ng-model="vm.count" disabled>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td width="25%">
                                            <label for="reversalRemarks" class="form-group required">Remarks</label>
                                        </td>
                                        <td width="25%">
                                                                        <textarea class="form-control" rows="3" id="reversalRemarks" maxlength="200" name="reversalRemarks" ng-model="vm.reversalRemarks" oninput="this.value = this.value.replace(/^\s/, '')"
                                                                                  required></textarea>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </ng-form>

                            <div class="table-responsive" ng-if="vm.subscriptionIdList.length>0">
                                <table class="table table-bordered table-striped list table-textWrap align-middle">
                                    <thead>
                                    <tr class="thalign">
                                        <th>S.No</th>
                                        <th>Subscription Id</th>
                                        <th>Subscription Date</th>
                                        <th>Subscription Amount</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr ng-repeat="x in vm.subscriptionIdList">
                                        <td align="center">{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                                        <td align="center">{{x.subscriptionId}}</td>
                                        <td align="center">{{x.subscriptionDate}}</td>
                                        <td align="center">{{x.subscriptionAmt}}</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="text-center form_submit">
<!--                            <button ng-if ="vm.blaFlag=='Y'"type="submit" class="btn btn-default" id="submitButton"-->
<!--                                    ng-disabled="vm.bondSubscriptionFlowForm.$invalid" ng-if="vm.blaAccNo.length=='14' && vm.blaAccNoTo.length == '14'">Add</button>-->

<!--                            <button ng-if ="vm.blaFlag=='N'"type="submit" class="btn btn-default" id="submitButton"-->
<!--                                    ng-disabled="vm.bondSubscriptionFlowForm.$invalid" ng-if="vm.blaAccNo.length=='14'">Add</button>-->

                            <button ng-if="vm.blaFlag == 'Y' && vm.blaAccNo.length >= 13 && vm.blaAccNoTo.length >= 13"
                                    type="submit" class="btn btn-default" id="submitButton"
                                    ng-disabled="vm.bondSubscriptionFlowForm.$invalid || vm.customerMasterForm1.$invalid">
                                Add
                            </button>

                            <!-- Button for blaFlag 'N' -->
                            <button ng-if="vm.blaFlag == 'N' && vm.blaAccNo.length >= 13"
                                    type="submit" class="btn btn-default" id="submitButton"
                                    ng-disabled="vm.bondSubscriptionFlowForm.$invalid || vm.customerMasterForm.$invalid">
                                Add
                            </button>
                            <button type="button" id="cancelButton" class="btn btn-cancel"
                                    onclick="window.location.href= '#!/Joint_type_change_Three_to_two/add';">Cancel
                            </button>
                        </div>
                    </form>
                </uib-accordion>
            </div>
        </div>
    </div>
</div>
<!--blaAccNoFrom Modal-->
<div class="modal" id="blaAccNoModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">From Bond Ledger Account Number</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaAccNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <em class="glyphicon glyphicon-search"></em>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNo'">
                                <tr>
                                    <th scope="" ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Pan Number</th>
                                    <th scope="" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode Of Holding</th>
                                    <th scope="" ng-click="(sortedColumn == 'fromBlaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'fromBlaNo';" ng-class="(sortedColumn == 'fromBlaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaAccNoList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaAccNo = x.fromBlaNo;vm.getSubscriptionId(x.fromBlaNo);" data-bs-dismiss="modal">
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                    <td>{{x.fromBlaNo}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaAccNoList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>
<!--blaAccNoTo-->
<div class="modal" id="blaAccNoToModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">To Bond Ledger Account Number</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaAccNoToList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <em class="glyphicon glyphicon-search"></em>
                                </div>
                                <input type="text" class="form-control" ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''" placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort" aria-label="">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'blaAccNoTo'">
                                <tr>
                                    <th scope="col" ng-click="(sortedColumn == 'blaAccNoTo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaAccNoTo';" ng-class="(sortedColumn == 'blaAccNoTo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Ledger Account Number</th>
                                    <th scope="col" ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';" ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Bond Holder Name</th>
                                    <th scope="col" ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode Of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaAccNoToList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaAccNoTo = x.toBlaNo;vm.getToBlaNo(x.toBlaNo);" data-bs-dismiss="modal">
                                    <td>{{x.toBlaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaAccNoToList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNum'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';" ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN NO</th>
                                    <th ng-click="(sortedColumn == 'panHldName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panHldName';" ng-class="(sortedColumn == 'panHldName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">PAN HOLDER NAME</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.panNo= x.panNum;vm.bondHolderName= x.panHldName;" data-bs-dismiss="modal">
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.panHldName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'subCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-show="false">Scheme Code</th>
                                    <th ng-click="(sortedColumn == 'subCodeDescription')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subCodeDescription';" ng-class="(sortedColumn == 'subCodeDescription')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">SCHEME NAME</th>
                                    <th ng-click="(sortedColumn == 'status')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'status';" ng-class="(sortedColumn == 'status')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">STATUS</th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.subCode;vm.schemeName= x.subCodeDescription;" data-bs-dismiss="modal">
                                    <td style="display: none;">{{x.subCode}}</td>
                                    <td>{{x.subCodeDescription}}</td>
                                    <td>{{x.status}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>