package com.isl.gbm.cbs.integration.dto.wrapper;

import com.isl.gbm.cbs.integration.dto.CalendarEntriesDto;
import com.isl.gbm.common.audit.log.dto.AuditLogDto;

public class CalendarEntriesDtoAuditLogWrapper {

    private CalendarEntriesDto dto;

    private AuditLogDto auditLogDto;

    public CalendarEntriesDto getDto() {
        return dto;
    }

    public void setDto(CalendarEntriesDto dto) {
        this.dto = dto;
    }

    public AuditLogDto getAuditLogDto() {
        return auditLogDto;
    }

    public void setAuditLogDto(AuditLogDto auditLogDto) {
        this.auditLogDto = auditLogDto;
    }

}
