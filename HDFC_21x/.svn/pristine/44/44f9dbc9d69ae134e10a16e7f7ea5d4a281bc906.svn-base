                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="igstRate" ng-keypress="vm.percentageCheckNew($event);"
                        ng-change="vm.percentageCheckChange(vm.cbdtSchemeParameter.C047,'C047');"
                        ng-model="vm.cbdtSchemeParameter.C047.oldValue" limit-to="5" oninput="
              this.value = this.value
                .replace(/[^0-9.]/g, '')
                .replace(/^(\.)/g, '')
            " required />
                </div>
            </div>
        </div>
