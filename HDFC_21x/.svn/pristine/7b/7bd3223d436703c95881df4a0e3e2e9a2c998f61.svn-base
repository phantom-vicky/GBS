<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Scheme Master - Inquiry</h4>
    <sol-header></sol-header>
    <form name="schemeMaster" role="form">
        <table class="table table-bordered table-striped list old-new-value-table">
            <thead>
            <tr>
                <th width="30%">Particular</th>
                <th width="35%">{{(vm.details.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                <th width="35%" ng-if="vm.details.previousOperationType == 'M'">New Value</th>
            </tr>
            </thead>
            <tbody>

            <tr>
                <td>Name of the Module</td>
                <td class="old-value">
                    <label><b>RBI Bond</b></label>
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    <label><b>RBI Bond</b></label>
                </td>
            </tr>
            <tr>
                <td>Branch Id</td>
                <td class="old-value">
                    {{(vm.solId)? (vm.solId) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.solId)?(vm.solId) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Branch Name</td>
                <td class="old-value" >
                    {{(vm.username)? (vm.username) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.username)?(vm.username) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Scheme Name</td>
                <td class="old-value">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C003.oldValue)? (vm.masterOldNewValueModel.C003.oldValue) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C003.newValue)? (vm.masterOldNewValueModel.C003.newValue) : ('')}}
                </td>
            </tr>
            <tr>
                <td>Status</td>
                <td class="old-value">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C004.oldValue)? (vm.masterOldNewValueModel.C004.oldValue) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.masterOldNewValueModel && vm.masterOldNewValueModel.C004.newValue)? (vm.masterOldNewValueModel.C004.newValue) : ('')}}
                </td>
            <tr>
                <td>Rejection Remarks</td>
                <td class="old-value">
                    {{(vm.details && vm.details.remarks)? (vm.details.remarks) : ('')}}
                </td>
                <td class="new-value" ng-if="vm.details.previousOperationType == 'M'">
                    {{(vm.details.newValue && vm.details.remarks)? (vm.details.remarks) : ('')}}
                </td>
            </tr>
        <!--<div class="row">
            <div class="form-group required">
        <div class="col-sm-3"></div>
            <div class="col-sm-3">
                <label class="control-label">Status</label>
            </div>
                <div class="col-sm-3">
                    <select name="status" id="status" name="status" ng-model="vm.masterOldNewValueModel.C004.oldValue" required disabled>
                        <option value="">Select</option>
                        <option value="Y">Enable</option>
                        <option value="N">Disable</option>
                    </select>
                </div>
            </div></div>-->
            </tbody>
        </table></form>

        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
					<span>
						<b> Created By </b> : {{vm.details.createdBy}}
					</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.details.modifiedBy) ? (vm.details.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
					<span>
						<b> Last Verified By </b> : {{(vm.details.verifiedBy) ? (vm.details.verifiedBy) : ('None')}}
					</span>
                </div>
                <div class="col-md-3">
					<span>
						<b> Verify Status </b> : {{vm.details.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}
					</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
					<span>
						<b> Created On </b> : {{ vm.details.createdDate | date : 'dd/MM/yyyy'}}
					</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.details.modifiedDate) ? (vm.details.modifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
					<span>
						<b> Last Verified On </b> : {{(vm.details.verifiedDate) ? (vm.details.verifiedDate | date : 'dd/MM/yyyy') : ('None')}}
					</span>
                </div>
                <div class="col-md-3"></div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/scheme_master_rbi_bond/action/inquiry';">Cancel
            </button>
        </div>
</div>

