                                                            ng-click="vm.blaClosureDateOne.opened = true"
                                                            id="blaClosureDateOneOption">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetails.C053.oldValue} "><label
                                        for="subscriberFirstName" class="control-label">BLA Closure Remarks</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C026" name="C026"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsTwo.C054.oldValue"
                                                       ng-required="vm.customerMasterDetailsTwo.C053.oldValue"
                                                       chars="only-letters"></td>

                            </tr>
                            <tr>

                                <td width="25%" class="form-group">
                                    <label class="control-label">Remarks</label>
                                </td>
                                <td width="25%" >
                                    <input type="text" class="form-control"
                                           id="remarks" name="remarks"
                                           maxlength="30"
                                           ng-model="vm.customerMasterDetailsTwo.C042.oldValue" chars="only-letters">
                                </td>
                            </tr>

                        </table>

                    </ng-form>
                </div>

                <div uib-accordion-group id="joint-personal-details-three" class="panel"
                     heading="THIRD JOINT ACCOUNT HOLDER DETAILS"
                     is-open="vm.thirdHolderDetails"
                     ng-class="(vm.thirdJoinAccountHolderDetails.$invalid) ? 'panel-danger' : 'panel-success'" ng-if="vm.getDetails.masterDetailsValueModel.length >= 3">

                    <ng-form name="vm.customerPersonalDetailsThree" >
                        <table class="table table-bordered">
                            <tbody>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Operative Account Number</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" ng-blur="vm.getSchemeTypeListOperativeThree(vm.customerMasterDetailsThree.C034.oldValue, 'acctNum')"
                                                       ng-model="vm.customerMasterDetailsThree.C034.oldValue" required>
                                    <!--                                    <span class="alert-danger" ng-if="vm.errorMessage">Invalid Account Number</span>-->
                                    <span class="alert-danger" ng-if="vm.cbsErrorMessageThree">{{vm.cbsErrorMessageThree}}</span>
                                </td>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMasterDetailsThree.gbmTransactionMasterDto.tranMode == 'T'}">
                                    <label for="tranSolId" class="control-label">Operative Account Branch Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="tranSolId"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetailsThree.C035.oldValue" chars="alpha-numeric" readonly disabled required>
                                        </div>
                                    </div>
                                </td>
                            </tr>


                            <tr>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMaster.nriFlag == 'Y'}">
                                    <label for="cbsCustomerId" class="control-label">CBS CIF ID</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="cbsCustomerId" ng-disabled="vm.customerMasterDetails.blaAccNo!=null"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetailsThree.C004.oldValue"
                                                   chars="alpha-numeric" oninput="this.value = this.value.toUpperCase()" ng-disabled="vm.getDetails.verifiedStatus=='Y'">
                                            <span class="alert-danger" ng-if="vm.errmsgSingle && vm.customerMaster.customerMasterDetailsThree">{{vm.errmsgSingle}}</span>
                                        </div>

                                        <div class="col-sm-3" >
                                            <button ng-if="vm.customerMasterDetailsThree.C004.oldValue" type="button" class="btn btn-default" id="cbsBtnThree" ng-click="vm.getCbsCustFstJoinDetailsThreeModify();"
                                                    ng-disabled="vm.getDetails.verifiedStatus=='Y' || !vm.customerMasterDetailsThree.C034.oldValue || !vm.customerMasterDetailsThree.C004.oldValue || vm.cbsErrorMessageThree">Fetch</button>
                                        </div>
                                    </div>
                                </td>

                                <td width="25%">
                                    <label class="control-label">Bond Ledger Account Number</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="blaNo"
                                                   name="blaNo"
                                                   ng-model="vm.customerMasterDetailsThree.C005.oldValue" disabled>
                                        </div>
                                        <div class="col-sm-3 torch-top" ng-if="vm.getDetails.verifiedStatus=='N'">
                                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                               ng-click="vm.getBlaAccNoDetailsThreeModify('torch');" id="blaNoSearcher"></i>
                                            <i class="glyphicon glyphicon-remove clear cp"
                                               ng-click="vm.customerMasterDetailsThree.C005.oldValue='';vm.getClearAllData();" id="blaNoClose"></i>
                                        </div>
                                    </div>
<!--                                    <div class="row">-->
<!--                                        <div class="col-sm-8">-->
<!--                                            <input type="text" class="form-control" id="bondLedgerAccNumber"-->
<!--                                                   name="bondLedgerAccNumber"-->
<!--                                                   ng-model="vm.customerMasterDetailsThree.C005.oldValue"-->
<!--                                                   chars="alpha-numeric" oninput="this.value = this.value.toUpperCase()" >-->
<!--                                        </div>-->

<!--                                        <div class="col-sm-3" >-->
<!--                                            <button type="button" class="btn btn-default" id="blaBtnThree" ng-click="vm.getBlaAccNoDetailsThreeModify('torch');"-->
<!--                                            >Fetch</button>-->
<!--                                        </div>-->
<!--                                    </div>-->
                                </td>

                            </tr>
                            <tr>
                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Bond Holder First
                                    Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberFirstName" name="customerFirstName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C006.oldValue"
                                                       ng-disabled="vm.operativeAc == 'Y'"
                                                       chars="only-letters"
                                                       required></td>
                                <td width="25%">Bond Holder Middle Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberMiddleName" name="customerMiddleName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C007.oldValue" chars="only-letters">
                                </td>
                            </tr>
                            <tr>
                                <td width="25%">Bond Holder Last Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="subscriberLastName" name="customerLastName"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C008.oldValue" chars="only-letters">
                                </td>
                                <td width="25%" class="form-group required"><label
                                        class="control-label">Holder Type</label></td>
                                <td width="25%">
                                    <select class="form-control" ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                            ng-model="vm.customerMasterDetailsThree.C009.oldValue" ng-change="vm.getValidations(vm.customerMasterDetailsThree.C009.oldValue);" maxlength="10" required>
                                        <option value="">Select</option>
                                        <!--                                        <option ng-repeat="item in vm.C009List" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH001'" value="HT001">Power of Attorney</option>

                                        <option data-ng-if="vm.modeOfHolding=='MH004'" value="HT002">Karta of HUF</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH002'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH003'" value="HT003">Individual</option>
                                        <option data-ng-if="vm.modeOfHolding=='MH005'" value="HT003">Individual</option>
                                    </select>
                                </td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Is NRI ?</label>
                                </td>
                                <td width="25%">
                                    <select class="form-control" nh-change="vm.customerMasterDetailsThree.C065.oldValue = ''"
                                            ng-model="vm.customerMasterDetailsThree.C003.oldValue" required>
                                        <option value="">Select</option>
                                        <option value="Y">Yes</option>
                                        <option value="N">No</option>
                                    </select>
                                </td>

                                <td ng-if="vm.customerMasterDetailsThree.C003.oldValue=='Y'" width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C003.oldValue == 'Y'}">
                                    <label class="control-label">Date of Becoming NRI<br>(DD/MM/YYYY)</label></td>
                                <td width="25%" ng-if="vm.customerMasterDetailsThree.C003.oldValue=='Y'">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfBecomingNriThree"
                                               name="dateOfBecomingNriThree"
                                               ng-model="vm.customerMasterDetailsThree.C065.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dobCalenderOptions"
                                               is-open="vm.dateOfBecomingNriThree.opened"
                                               close-text="Close" maxlength="10" readonly required>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfBecomingNriThree.opened = true"
                                                    id="dateOfBecomingNriThreeBtn">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                            </tr>

                            <tr>
                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Father Name/Spouse Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C010" name="C010"
                                                       maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C010.oldValue"
                                                       chars="only-letters"
                                                       required></td>
                                <td width="25%" class="form-group required">
                                    <label for="subscriberFirstName" class="control-label">Mother Name</label>
                                </td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C011" name="C011"
                                                       maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C011.oldValue" chars="only-letters" required>
                                </td>
                            </tr>
                            <tr>
                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Gender</label></td>
                                <td width="25%"><select class="form-control" id="C012"
                                                        ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        name="state" ng-model="vm.customerMasterDetailsThree.C012.oldValue"
                                                        ng-required="!vm.customerMasterDetailsThree.C012.oldValue">
                                    <option value="" hidden="true">Select</option>
                                    <option value="M" >MALE</option>
                                    <option value="F" >FEMALE</option>
                                </select></td>

                                <td width="25%" class="form-group required" >
                                    <label class="control-label">Is Minor (Y/N)?</label></td>
                                <td width="25%"><select class="form-control" id="C014"
                                                        ng-change="vm.customerMasterDetailsThree.C013.oldValue=''"
                                                        ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                        name="C014" ng-model="vm.customerMasterDetailsThree.C014.oldValue"
                                                        required>
                                    <option value="" hidden="true">Select</option>
                                    <option value="Y"  ng-selected="vm.customerMasterDetailsThree.C014.oldValue == 'Y'">YES</option>
                                    <option value="N" ng-selected="vm.customerMasterDetailsThree.C014.oldValue == 'N'">NO</option>
                                </select></td>





                            </tr>
                            <tr>


                                <td width="25%" class="form-group required">
                                    <label class="control-label">Bond Holder Date Of Birth<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="bondHolderDateOfBirth"
                                               name="dateofBirth"
                                               ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                               ng-model="vm.customerMasterDetailsThree.C013.oldValue"
                                               ng-change="vm.checkAge(vm.customerMasterDetailsThree.C014.oldValue, vm.customerMasterDetailsThree.C013.oldValue,'modify','3')"

                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.dateOptions.opened"
                                               close-text="Close" maxlength="10" readonly required>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOptions.opened = true"
                                                    id="bondHolderDateOfBirthOptions">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>


                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C014.oldValue == 'Y'}"><label
                                        for="birthCertificateNo" class="control-label">Details of Birth certificate submitted as per norms</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       id="birthCertificateNo" name="birthCertificateNo" ng-model="vm.customerMasterDetailsThree.C044.oldValue"
                                                       maxlength="50" chars="alpha-numeric" ng-required="vm.customerMasterDetailsThree.C014.oldValue == 'Y'">
                                </td>


                            </tr>
                            <tr>

                                <td width="25%" class="form-group required"><label
                                        for="address1" class="control-label">Communication Address 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="address1" name="address1" ng-model="vm.customerMasterDetailsThree.C015.oldValue"
                                                       maxlength="120"
                                                       required></td>


                                <td width="25%" ><label
                                        for="address2" class="control-label">Address 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="address2" name="address2"
                                                       ng-model="vm.customerMasterDetailsThree.C016.oldValue" maxlength="120"
                                                       ></td>



                            </tr>
                            <tr>

                                <td width="25%" ><label
                                        for="presentFlat" class="control-label">Address 3</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="presentFlat" name="presentFlat" ng-model="vm.customerMasterDetailsThree.C017.oldValue"
                                                       maxlength="120"
                                ></td>


                                <td width="25%" >
                                    <label class="control-label">City</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="sadistrict" name="district" chars="only-letters" maxlength="40"
                                                       ng-model="vm.customerMasterDetailsThree.C018.oldValue" onkeypress="return AvoidSpace(event)" ></td>

                            </tr>
                            <tr>

                                <td width="25%" class="form-group required">
                                    <label class="control-label">State</label></td>
                                <td width="25%"><select class="form-control" id="state"
                                                        name="state" ng-model="vm.customerMasterDetailsThree.C019.oldValue"
                                                        ng-init="vm.getState()" required>
                                    <option value="" hidden="true">Select State</option>
                                    <option ng-repeat="item in vm.stateList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>
                                </select></td>

                                <td width="25%" class="form-group required"><label class="control-label">Pin Code</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="sapinCode" name="pinCode" chars="only-numbers" minlength="6" maxlength="6"
                                                       ng-model="vm.customerMasterDetailsThree.C020.oldValue"
                                                       onkeypress="return isNumber(event)" required></td>

                            </tr>
                            <tr>
                                <td width="25%">Phone Number</td>
                                <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                       id="saphoneNum" ng-model="vm.customerMasterDetailsThree.C046.oldValue"
                                                       chars="only-numbers" onkeypress="return isNumber(event)"></td>

                                <td width="25%">Mobile Number</td>
                                <td width="25%">
                                    <input type="text" class="form-control" minlength="10" maxlength="10"
                                           id="mobileNumber" ng-model="vm.customerMasterDetailsThree.C021.oldValue"
                                           chars="only-numbers" onkeypress="return isNumber(event)"></td>


                            </tr>
                            <tr>

                                <td width="25%" class="form-group"><label
                                        for="emailId" class="control-label">Email Id</label></td>
                                <td width="25%"><input type="email" class="form-control"
                                                       id="emailId" name="emailId" maxlength="50"
                                                       ng-model="vm.customerMasterDetailsThree.C022.oldValue" ng-pattern="vm.emailPattern" chars="email">
                                    <span class="text-danger"
                                          ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                                <td width="25%" ng-class="vm.customerMasterDetailsThree.C001.oldValue=='MH004' ? 'form-group required' :(vm.customerMasterDetailsThree.C009.oldValue == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.customerMasterDetailsThree.C001.oldValue=='MH001' || vm.customerMasterDetailsThree.C001.oldValue=='MH004'">
                                    <label for="emailId" class="control-label">
                                     HUF registration / Power of Attorney number
                                    </label>
                                </td>
                                <td width="25%" ng-if="vm.customerMasterDetailsThree.C001.oldValue=='MH001' || vm.customerMasterDetailsThree.C001.oldValue=='MH004'"><input type="text" class="form-control" minlength="10" maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       id="powerOfattorneyNo" ng-model="vm.customerMasterDetailsThree.C023.oldValue"
                                                       ng-required=" vm.customerMasterDetailsThree.C001.oldValue=='MH004' || vm.customerMasterDetailsThree.C009.oldValue == 'HT001'"></td>

                            </tr>

                            <tr>
                                <td width="25%" ng-class="vm.customerMasterDetailsThree.C001.oldValue=='MH004' ? 'form-group required' :(vm.customerMasterDetailsThree.C009.oldValue == 'HT001' ? 'form-group required':'form-group')" ng-if="vm.customerMasterDetailsThree.C001.oldValue=='MH001' || vm.customerMasterDetailsThree.C001.oldValue=='MH004'">

                                <label for="emailId" class="control-label">Power of Attorney/Karta Name</label>
                                </td>
                                <td width="25%" ng-if="vm.customerMasterDetailsThree.C001.oldValue=='MH001' || vm.customerMasterDetailsThree.C001.oldValue=='MH004'"><input type="text" class="form-control"  maxlength="10"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       id="kartaName" ng-model="vm.customerMasterDetailsThree.C024.oldValue"
                                                       ng-required=" vm.customerMasterDetailsThree.C001.oldValue=='MH004' || vm.customerMasterDetailsThree.C009.oldValue == 'HT001'"></td>
                                <td></td>
                                <td></td>
                            </tr>

                            <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                <td width="25%" class="form-group">
                                    <label class="control-label">Date of Death of Bond Holder<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfDeathOfBondHolderThree"
                                               name="dateOfDeathOfBondHolderThree" ng-init="vm.dodVal()"
                                               ng-model="vm.customerMasterDetailsThree.C051.oldValue"
                                               ng-change="vm.customerMasterDetailsThree.C052.oldValue=''; vm.dodRecVal(vm.customerMasterDetailsThree.C051.oldValue)"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dodCalenderOptions"
                                               is-open="vm.dateOfDeathOfBondHolderThreeOption.opened"
                                               close-text="Close" maxlength="10" readonly>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfDeathOfBondHolderThreeOption.opened = true"
                                                    id="dateOfDeathOfBondHolderThreeOption">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C051.oldValue}">
                                    <label class="control-label">Date of Receipt of Death Certificate<br>(DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dateOfReceiptOfDeathCertificateThree"
                                               name="dateOfReceiptOfDeathCertificateThree"
                                               ng-model="vm.customerMasterDetailsThree.C052.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.dodRecCalenderOptions"
                                               is-open="vm.dateOfReceiptOfDeathCertificateThreeOption.opened"
                                               ng-required="vm.customerMasterDetailsThree.C051.oldValue"
                                               close-text="Close" maxlength="10" readonly>
                                        <span class="input-group-btn">
                                            <button type="button" class="btn btn-secondary"
                                                    ng-click="vm.dateOfReceiptOfDeathCertificateThreeOption.opened = true"
                                                    id="dateOfReceiptOfDeathCertificateThreeOption">
                                                <i class="glyphicon glyphicon-calendar"></i>
                                            </button>
                                        </span>
                                    </p>
                                </td>

                            </tr>
                            </tbody>
                        </table>
                        <h4 class="form_heading" ng-if="vm.customerMasterDetailsThree.C014.oldValue=='Y'">GUARDIAN DETAILS</h4>
                        <table class="table table-bordered" ng-if="vm.customerMasterDetailsThree.C014.oldValue=='Y'">
                            <tbody>

                            <tr>
                                <td width="25%" >
                                    <label for="C025" class="control-label">Guardian Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="C025"
                                                   name="C025"

                                                   ng-model="vm.customerMasterDetailsThree.C025.oldValue" disabled>
                                        </div>
                                        <div ng-if="vm.getDetails.verifiedStatus !='Y'" class="col-sm-3 torch-top" >
                                            <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                                               ng-click="vm.getGuardianDetails('select');" id="C025Searcher"></i>
                                            <i class="glyphicon glyphicon-remove clear cp"
                                               ng-click="vm.customerMasterDetailsThree.C025.oldValue='';  vm.customerMasterDetailsThree.C026.oldValue=''; vm.customerMasterDetailsThree.C027.oldValue=''; vm.customerMasterDetailsThree.C028.oldValue='';vm.customerMasterDetailsThree.C029.oldValue=''; vm.customerMasterDetailsThree.C030.oldValue='';vm.customerMasterDetailsThree.C031.oldValue=''; vm.customerMasterDetailsThree.C032.oldValue=''; vm.customerMasterDetailsThree.C033.oldValue=''; " id="C025Close"></i>
                                        </div>
                                    </div>
                                </td>

                                <td width="25%" class="form-group required"><label
                                        for="subscriberFirstName" class="control-label">Guardian First Name</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C026" name="C026"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C026.oldValue"
                                                       chars="only-letters" required></td>

                            </tr>

                            <tr>
                                <td width="25%">Guardian Middle Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C027" name="C027"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C027.oldValue" chars="only-letters">
                                </td>

                                <td width="25%">Guardian Last Name</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C028" name="C028"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C028.oldValue" chars="only-letters">
                                </td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Relation with minor</label></td>
                                <td width="25%">
                                    <select class="form-control" id="C029"
                                            name="state" ng-model="vm.customerMasterDetailsThree.C029.oldValue"
                                            required>
                                        <option value="" hidden="true">Select</option>
                                        <option value="RE001" >Father</option>
                                        <option value="RE002" >Mother</option>
                                        <option value="RE006" >Brother</option>
                                        <option value="RE007" >Sister</option>
                                        <option value="RE009" >Others</option>
<!--                                        <option ng-repeat="item in vm.guardianDetailsListMetaData" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>-->
                                    </select>
                                </td>

                                <td width="25%" class="form-group">
                                    <label class="control-label">Date of Birth</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="C030"
                                               name="C030" ng-model="vm.customerMasterDetailsThree.C030.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.submissionfifteenGH"
                                               is-open="vm.submissionfifteenGHPicker.opened" close-text="Close" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.submissionfifteenGHPicker.opened = true"
                                                            id="submissionfifteenGHSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>
                            </tr>


                            <tr>
                                <td width="25%" class="form-group "><label
                                        for="address1" class="control-label">Communication Address</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="guardianAddress" name="guardianAddress" ng-model="vm.customerMasterDetailsThree.C031.oldValue"
                                                       maxlength="120"
                                                       ></td>


                                <td width="25%">Mobile Number</td>
                                <td width="25%"><input type="text" class="form-control" minlength="10" maxlength="10"
                                                       id="guardianMobileNumber" ng-model="vm.customerMasterDetailsThree.C032.oldValue"
                                                       chars="only-numbers" onkeypress="return isNumber(event)"></td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group"><label
                                        for="emailId" class="control-label">Email Id</label></td>
                                <td width="25%"><input type="email" class="form-control"
                                                       id="C033" name="C033" maxlength="50"
                                                       ng-model="vm.customerMasterDetailsThree.C033.oldValue" ng-pattern="vm.emailPattern" chars="email">
                                    <span class="text-danger"
                                          ng-show="vm.customerMasterForm.emailId.$error.pattern">Enter valid email address</span></td>

                            </tr>


                            </tbody>
                        </table>
                        <h4 class="form_heading">OTHERS DETAILS</h4>
                        <table class="table table-bordered">
                            <tbody>

                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Operative Account Number</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="operativeAcc" name="operativeAcc" chars="alpha-numeric" maxlength="20" ng-blur="vm.getSchemeTypeListOperativeThree(vm.customerMasterDetailsThree.C034.oldValue, 'acctNum')"
                                                       ng-model="vm.customerMasterDetailsThree.C034.oldValue" required>
                                    <!--                                    <span class="alert-danger" ng-if="vm.errorMessage">Invalid Account Number</span>-->
                                    <span class="alert-danger" ng-if="vm.cbsErrorMessageThree">{{vm.cbsErrorMessageThree}}</span>
                                </td>
                                <td width="25%"
                                    ng-class="{'required': vm.customerMasterDetailsThree.gbmTransactionMasterDto.tranMode == 'T'}">
                                    <label for="tranSolId" class="control-label">Operative Account Branch Id</label>
                                </td>
                                <td width="25%">
                                    <div class="row">
                                        <div class="col-sm-9">
                                            <input type="text" class="form-control" id="tranSolId"
                                                   name="tranSolId"
                                                   ng-model="vm.customerMasterDetailsThree.C035.oldValue" chars="alpha-numeric" readonly disabled required>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                            <tr>
                                <td width="25%">PAN No.</td>
                                <td width="25%" class="form-group required" >
                                    <input type="text" class="form-control" id="panNumber"
                                           name="panNumber" maxlength="10"
                                           ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                           ng-model="vm.customerMasterDetailsThree.C036.oldValue" ng-pattern="vm.panPattern" required>
                                </td>
                                <td width="25%">Aadhaar No</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="aadharNum" chars="only-numbers" minlength="12" maxlength="12"
                                                       onkeypress="return isNumber(event)"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       name="aadharNum" ng-model="vm.customerMasterDetailsThree.C037.oldValue"></td>
                            </tr>


                            <tr>
                                <td width="25%" class="form-group required">
                                    <label class="control-label">Whether Form 15G/15H/Tax Exemption Certificate is Submitted?</label></td>
                                <td width="25%">
                                    <select class="form-control" id="sastate"
                                            name="state" ng-model="vm.customerMasterDetailsThree.C038.oldValue" ng-change="vm.formFifteenGValidationThreenM(vm.customerMasterDetailsThree.C038.oldValue);"
                                            required>
                                        <option value="" hidden="true">Select</option>
                                        <option ng-repeat="item in vm.formList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                                    </select>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C038.oldValue == 'TF001' || vm.customerMasterDetailsThree.C038.oldValue == 'TF002' || vm.customerMasterDetailsThree.C038.oldValue == 'TF003'} ">
                                    <label class="control-label">Date of Submission of Form 15G/15H/Tax Exemption Certificate</label>
                                </td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="dretirDate"
                                               name="retirDate" ng-model="vm.customerMasterDetailsThree.C039.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.dateOfSubTaxExThree.opened" close-text="Close"
                                               maxlength="10"
                                               ng-required="vm.customerMasterDetailsThree.C038.oldValue == 'TF001' || vm.customerMasterDetailsThree.C038.oldValue == 'TF002' || vm.customerMasterDetailsThree.C038.oldValue == 'TF003'" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.dateOfSubTaxExThree.opened = true"
                                                            id="dateOfReceiptTerminalSearcher">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>

                            </tr>

                            <tr>
                                <td width="25%" class="form-group">
                                    <label class="control-label">Financial Year</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="financialYear" name="financialYear" chars="alpha-numeric" maxlength="20"
                                                       ng-model="vm.customerMasterDetailsThree.C040.oldValue" readonly>
                                </td>

                                <td width="25%">TDS Rate Applicable%</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="tdsRateOne" ng-model="vm.customerMasterDetailsThree.C064.oldValue"  readonly></td>
                            </tr>


                            </tbody>
                        </table>
                        <h4 class="form_heading">WITNESS DETAILS</h4>
                        <table class="table table-bordered">
                            <tbody>
                            <tr>
                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Name 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C047" name="C047"
                                                       maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C047.oldValue"
                                                       chars="only-letters"></td>

                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Address 1</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C048" name="C048"
                                                       maxlength="120"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C048.oldValue"
                                                       ></td>
                            </tr>

                            <tr>
                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Name 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C049" name="C049"
                                                       maxlength="30"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C049.oldValue"
                                                       chars="only-letters"></td>

                                <td width="25%" class="form-group"><label
                                        for="subscriberFirstName" class="control-label">Witness Address 2</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C050" name="C050"
                                                       maxlength="120"
                                                       ng-disabled="vm.getDetails.verifiedStatus=='Y'"
                                                       ng-model="vm.customerMasterDetailsThree.C050.oldValue"
                                                       ></td>
                            </tr>

                            </tbody>
                        </table>
                        <h4 class="form_heading">SUPPORTING DOCUMENTS</h4>
                        <table class="table table-bordered">
                            <div class="col-md-12 map-div">
                                <input type="checkbox" id="birthCertificate" name="birthCertificate" value="KD001" ng-model="vm.customerMasterDetailsThree.C055.oldValue" ng-checked="vm.customerMasterDetailsThree.C055.oldValue">
                                <label for="birthCertificate">Birth Certificate</label><br>
                                <input type="checkbox" id="passport" name="passport" value="KD002" ng-model="vm.customerMasterDetailsThree.C056.oldValue" ng-checked="vm.customerMasterDetailsThree.C056.oldValue">
                                <label for="passport">Passport</label><br>
                                <input type="checkbox" id="seniorCitizenCard" name="seniorCitizenCard" value="KD003" ng-model="vm.customerMasterDetailsThree.C057.oldValue" ng-checked="vm.customerMasterDetailsThree.C057.oldValue">
                                <label for="seniorCitizenCard">Senior Citizen Card</label><br>
                                <input type="checkbox" id="voterId" name="voterId" value="KD004" ng-model="vm.customerMasterDetailsThree.C058.oldValue" ng-checked="vm.customerMasterDetailsThree.C058.oldValue">
                                <label for="voterId">Voter ID Card</label><br>
                                <input type="checkbox" id="panCard" name="panCard" value="KD005" ng-model="vm.customerMasterDetailsThree.C059.oldValue" ng-checked="vm.customerMasterDetailsThree.C059.oldValue">
                                <label for="panCard">Pan Card</label><br>
                                <input type="checkbox" id="drivingLicence" name="drivingLicence" value="KD006" ng-model="vm.customerMasterDetailsThree.C060.oldValue" ng-checked="vm.customerMasterDetailsThree.C060.oldValue">
                                <label for="drivingLicence">Driving Licence</label><br>
                                <input type="checkbox" id="rationCard" name="rationCard" value="KD007" ng-model="vm.customerMasterDetailsThree.C061.oldValue" ng-checked="vm.customerMasterDetailsThree.C061.oldValue">
                                <label for="rationCard">Ration Card</label><br>
                                <input type="checkbox" id="others" name="others" value="KD008" ng-model="vm.customerMasterDetailsThree.C062.oldValue" ng-checked="vm.customerMasterDetailsThree.C062.oldValue">
                                <label for="others">Others</label><br>
                            </div>


                            <tr>
                                <td width="25%" class="form-group required" ng-if="vm.customerMasterDetailsThree.C062.oldValue == true">
                                    <label class="control-label">Details for Others</label>
                                </td>
                                <td width="25%" ng-if="vm.customerMasterDetailsThree.C062.oldValue == true">
                                    <input type="text" class="form-control"
                                           id="otherDetails" name="remarks"
                                           maxlength="120"
                                           ng-model="vm.customerMasterDetailsThree.C041.oldValue" chars="only-letters" required>
                                </td>
                            </tr>
                            <tr ng-if="vm.getDetails.verifiedStatus=='Y'">
                                <td width="25%" class="form-group">
                                    <label class="control-label">BLA Closure Date<br> (DD/MM/YYYY)</label></td>
                                <td width="25%">
                                    <p class="input-group">
                                        <input type="text" class="form-control" id="blaClosureDateOne"
                                               name="blaClosureDateOne" ng-model="vm.customerMasterDetailsThree.C053.oldValue"
                                               uib-datepicker-popup="dd/MM/yyyy"
                                               datepicker-options="vm.retirDatePickerValidation"
                                               is-open="vm.blaClosureDateOne.opened" close-text="Close"
                                               maxlength="10" readonly>
                                        <span class="input-group-btn">
                                                    <button type="button" class="btn btn-secondary"
                                                            ng-click="vm.blaClosureDateOne.opened = true"
                                                            id="blaClosureDateOneOption">
                                                        <i class="glyphicon glyphicon-calendar"></i>
                                                    </button>
                                                </span>
                                    </p>
                                </td>

                                <td width="25%" class="form-group" ng-class="{'required': vm.customerMasterDetailsThree.C053.oldValue} "><label
                                        for="subscriberFirstName" class="control-label">BLA Closure Remarks</label></td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="C026" name="C026"
                                                       maxlength="30"
                                                       ng-model="vm.customerMasterDetailsThree.C054.oldValue"
                                                       ng-required="vm.customerMasterDetailsThree.C053.oldValue"
                                                       chars="only-letters"></td>

                            </tr>
                            <tr>

                                <td width="25%" class="form-group">
                                    <label class="control-label">Remarks</label>
                                </td>
                                <td width="25%" >
                                    <input type="text" class="form-control"
                                           id="remarks" name="remarks"
                                           maxlength="30"
                                           ng-model="vm.customerMasterDetailsThree.C042.oldValue" chars="only-letters">
                                </td>
                            </tr>
                        </table>

                    </ng-form>
                </div>

                <div class="audit-details">
                    <div class="row">
                        <div class="col-md-3">
                            <span> <b> Created By </b> : {{vm.getDetails.createdBy}} </span>
                        </div>
                        <div class="col-md-3">
                            <span> <b> Last Modified By </b> : {{(vm.getDetails.lastModifiedBy) ? (vm.getDetails.lastModifiedBy) : ('None')}}</span>
                        </div>
                        <div class="col-md-3">
                            <span> <b> Last Verified By </b> : {{(vm.getDetails.lastVerifiedBy) ? (vm.getDetails.lastVerifiedBy) : ('None')}}</span>
                        </div>
                        <div class="col-md-3">
                            <span> <b> Verify Status </b> : {{vm.getDetails.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-3">
                            <span> <b> Created On </b> : {{ vm.getDetails.createdDate | date : 'dd/MM/yyyy'}}</span>
                        </div>
                        <div class="col-md-3">
                            <span> <b> Last Modified On</b> : {{ (vm.getDetails.lastModifiedDate) ? (vm.getDetails.lastModifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                        </div>
                        <div class="col-md-3">
                            <span> <b> Last Verified On </b> : {{(vm.getDetails.lastVerifiedDate) ? (vm.getDetails.lastVerifiedDate | date : 'dd/MM/yyyy') : ('None')}}</span>
                        </div>
                        <div class="col-md-3">
                        </div>
                    </div>
                </div>

                <div class="text-center form_submit">
                    <button type="submit" class="btn btn-default" id="submitButton"
                            ng-disabled="vm.customerMasterForm.$invalid || vm.customerMasterForm.$pristine">Modify</button>
                    <button type="button" class="btn btn-cancel" id="cancelButton"
                            data-bs-dismiss="modal" ng-click="vm.showCancelConfirmation('bond_ledger_acc_main.modify');">Cancel</button>
                </div>
            </form>
        </uib-accordion>
    </div>


</div>






<div class="modal" id="blaModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA No List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.versionNoSearch"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'versionNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';" ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">BLA No</th>
                                    <th ng-click="(sortedColumn == 'nameOfBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfBondHolder';" ng-class="(sortedColumn == 'nameOfBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name of the Bond Holder</th>
                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';" ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Mode of Holding</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaNoList | filter:vm.versionNoSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.customerMasterDetails.C005.oldValue = x.blaNo; vm.getBlaAccNoDetailsModify(); " data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.nameOfBondHolder}}</td>
                                    <td>{{x.jointHolderType}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<div class="modal" id="blaJointModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA No List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaNoList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.versionNoSearch"
