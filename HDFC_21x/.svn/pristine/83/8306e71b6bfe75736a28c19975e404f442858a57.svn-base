<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">Joint Type Change Three To Two – Inquiry</h4>
    <sol-header></sol-header>
    <ul class="nav nav-tabs"  ng-init="vm.tabReferenceInq = 'pensionMastersaForm'">
        <li ng-click="vm.tabReferenceInq ='pensionMastersaForm'"  ng-class="{ 'active': vm.tabReferenceInq == 'pensionMastersaForm'}"><a ng-class="{ 'active': vm.tabReferenceInq == 'pensionMastersaForm'}">BLA Opening – INQUIRY</a></li>
        <!--
                <li><a data-bs-toggle="tab" data-target="#pensionMastersaForm1">BOND SUBSCRIPTION WORKFLOW - INQUIRY</a></li>
        -->
        <li ng-click="vm.tabReferenceInq ='reversalForm'" ng-class="{ 'active': vm.tabReferenceInq == 'reversalForm'}"><a  >BOND SUBSCRIPTION-REVERSAL-CHANGE - INQUIRY</a></li>
    </ul>
    <div class="tab-content" >
        <div id="pensionMastersaForm"   ng-show="vm.tabReferenceInq == 'pensionMastersaForm'" ng-if="vm.getDetails" class="tab-pane  in active">
            <div class="tab-body">
                <uib-accordion close-others="oneAtATime">
                    <form name="pensionMastersaForm" role="form" novalidate>

                        <div uib-accordion-group id="satreasury-details" class="panel"
                             heading="Bond Ledger Account Maintenance - Inquiry" is-open="true"
                             ng-class="(vm.treasuryDetailsForm.$invalid) ? 'panel-danger' : 'panel-default'">
                            <ng-form name="vm.treasuryDetailsForm">
                                <table class="table table-bordered">
                                    <tbody>
                                    <tr>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Name of the Bond Scheme</label></td>
                                        <td width="25%">
                                            <label class="control-label" >{{vm.schemeName}}</label>
                                        </td>
                                        <td width="25%" class="form-group">
                                            <label class="control-label">Mode of Holding</label></td>
                                        <td width="25%">
                                            <label class="data-bind">{{vm.selectedModeOfHolding}}</label>
                                        </td>
                                    </tr>
                                    </tbody>
                                </table>
                            </ng-form>
                        </div>

                        <div uib-accordion-group id="sapensioner-details" class="panel panel-default"
                             heading="{{vm.titleText}}">
                            <table class="table table-bordered table-striped list old-new-value-table">
                                <thead>
                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.getDetails.previousOperationType == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.getDetails.previousOperationType == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>


                                <tr>
                                    <td>Bond Ledger Account Number</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C005)?
                                        (vm.getDetails.masterDetailsValueModel[0].C005.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C005? (vm.getDetails.masterDetailsValueModel[0].C005.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bond Holder First name</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C006)?
                                        (vm.getDetails.masterDetailsValueModel[0].C006.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C006? (vm.getDetails.masterDetailsValueModel[0].C006.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bond Holder Middle Name</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C007)?
                                        (vm.getDetails.masterDetailsValueModel[0].C007.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C007? (vm.getDetails.masterDetailsValueModel[0].C007.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Bond Holder Last name</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C008)?
                                        (vm.getDetails.masterDetailsValueModel[0].C008.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C008? (vm.getDetails.masterDetailsValueModel[0].C008.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Holder Type</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C012)?
                                        (vm.getDetails.masterDetailsValueModel[0].C012.oldValue | getLabelFromValuesArray : vm.convertLabelValue(vm.holderTypeList)) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C012? (vm.getDetails.masterDetailsValueModel[0].C012.newValue | getLabelFromValuesArray : vm.convertLabelValue(vm.holderTypeList)) : ('')}}
                                    </td>
                                </tr>

                                <tr>
                                    <td>Father Name/Spouse Name</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C013)?
                                        (vm.getDetails.masterDetailsValueModel[0].C013.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C013? (vm.getDetails.masterDetailsValueModel[0].C013.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Mother's Maiden Name</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C014)?
                                        (vm.getDetails.masterDetailsValueModel[0].C014.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C014? (vm.getDetails.masterDetailsValueModel[0].C014.newValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Gender</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C015)?
