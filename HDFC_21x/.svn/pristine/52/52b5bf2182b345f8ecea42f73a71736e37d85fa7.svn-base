<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">BOND Subscription Account Closure On Maturity Death - Verify</h4>


    <form name="vm.bondClosureBefMaturForm" role="form">
        <table class="table table-bordered">
            <h5 class="form_heading">BOND HOLDER DETAILS</h5>

            <tbody>
            <tr>
                <td width="25%">Name of the Bond Scheme</td>
                <td width="25%">
                    <label class="data-bind" id="bondScheme">{{vm.schemeName}}</label>
                </td>
                <td width="25%">Mode of Holding</td>
                <td width="25%">
                    <label class="data-bind" id="modeOfHolding">{{vm.blaDetails[0].modeOfHolding}}</label>
                </td>
            </tr>
            <tr>
                <td width="25%">BLA Number</td>
                <td width="25%">
                    <label class="data-bind" id="blaNo">{{vm.blaNo}}</label>
                </td>

                <td width="25%"> Holder Type</td>
                <td width="25%">
                    <label class="data-bind" id="holderType">{{vm.blaDetails[0].holderType}}</label>
                </td>

            </tr>


            <tr ng-if="vm.blaDetails[0].modeOfHoldingCode=='MH003' || vm.blaDetails[0].modeOfHoldingCode=='MH002'">
                <td width="25%">First Joint Bond Holder BLA No</td>
                <td width="25%">
                    <label class="data-bind" id="joinBlaNo">{{vm.blaDetails.firstJointBondHolderBLA}}</label>
                </td>
                <td width="25%">First Joint Bond Holder Name</td>
                <td width="25%">
                    <label class="data-bind" id="firstJointHolderName">{{vm.blaDetails.firstJointBondHolderName}}</label>
                </td>
            </tr>
            <tr ng-if="vm.blaDetails[0].modeOfHoldingCode=='MH003' || vm.blaDetails[0].modeOfHoldingCode=='MH002'">
                <td width="25%">Second Joint Bond Holder BLA No</td>
                <td width="25%" >
                    <label class="data-bind" id="secJointHolderBlaNo">{{vm.blaDetails[0].secondJointBondHolderBLA}}</label>
                </td>
                <td width="25%">Second Joint Bond Holder Name</td>
                <td width="25%">
                    <label class="data-bind" id="secJointHolderName">{{vm.blaDetails[0].secondJointBondHolderName}}</label>
                </td>
            </tr>

            <tr>

                <td width="25%" ng-if="vm.blaDetails[0].modeOfHoldingCode=='MH001' || vm.blaDetails[0].modeOfHoldingCode=='MH004' || vm.blaDetails[0].modeOfHoldingCode=='MH005'">Bond Holder Name</td>
                <td width="25%" ng-if="vm.blaDetails[0].modeOfHoldingCode=='MH001' || vm.blaDetails[0].modeOfHoldingCode=='MH004' || vm.blaDetails[0].modeOfHoldingCode=='MH005'">
                    <label class="data-bind" id="holderName">{{vm.blaDetails[0].bondHolderName}}</label>
                </td>



            </tr>





            </tbody>
        </table>


        <!--BOND SUBSCRIPTION DETAILS:-->
        <table class="table table-bordered">
            <h5 class="form_heading">BOND SUBSCRIPTION DETAILS</h5>
            <tbody>

            <tr>
                <td width="25%" ><label>Subscription Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].subsDate | uppercase}}</label>
                </td>
                <td width="25%" ><label>Subscription ID</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].boSubsId}}</label></td>
            </tr>


            <tr>

                <td width="25%" ><label>Subscription  Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].subsAmt}}</label></td>

                <td width="25%" ><label>Bond Type</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].bondType}}</label></td>

            </tr>


            <tr>

                <td width="25%" ><label>Maturity Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].maturityDate |uppercase}}</label></td>

            </tr>

            <tr>
                <td align="center" colspan="4"><label><h3><b>OTHER SCHEMES INTEREST RELATED INFO</b></h3></label></td>
            </tr>

            <tr>
                <td width="25%" ><label>Pan No</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].panNo}}</label></td>

                <td width="25%" ><label>8% Interest Payout</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].interestPayOut8Per}}</label></td>
            </tr>

            <tr>
                <td width="25%" ><label>Non Cumulative Int</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].nonCumulativeInt}}</label></td>

                <td width="25%" ><label>Cumulative Int</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].cumulativeInt}}</label></td>
            </tr>

            <tr>
                <td width="25%" ><label>7.75% interest payout</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].interestPayOut7Per}}</label></td>

                <td width="25%" ><label>Non Cumulative Int 775</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].nonCumulativeIntFor7}}</label></td>
            </tr>





            <tr>

                <td width="25%" ><label>Cumulative Int 775</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].cumulativeIntFor7}}</label></td>

                <td width="25%" ><label>8.05% interest payout</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].interestPayOut85Per}}</label></td>

            </tr>



            <tr>
                <td width="25%" ><label>Non Cumulative Int 8.05%</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].nonCumulativeIntFor85}}</label></td>

                <td width="25%" ><label>Cumulative Int 8.05%</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].cumulativeIntFor85}}</label></td>


            </tr>

            <tr>



                <td width="25%" ><label>TOtal</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].total}}</label></td>

                <td width="25%" ><label>totalPayoutOfTheYear</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].totalPayoutOfTheYear}}</label></td>


            </tr>








            <tr>
                <td align="center" colspan="4"><label><h3><b>PAN STATUS</b></h3></label></td>
            </tr>

            <tr>
                <td width="25%" ><label>In-operative PAN</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].inOperativePAN}}</label></td>

                <td width="25%" ><label>Non- filers</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].nonFilers}}</label></td>
            </tr>





            <tr>
                <td align="center" colspan="4"><label><h3><b>TDS EXCEMPTION DETAILS</b></h3></label></td>
            </tr>
            <tr>
                <td width="25%" ><label>Age</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].age}}</label></td>

                <td width="25%" ><label>Taxable Limit</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].taxableLimit}}</label></td>
            </tr>
            <tr>

                <td width="25%" ><label>Waiver Document</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].waiverDocument}}</label></td>
                <td width="25%" ><label>Waiver Document Ref No</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].waiverDocumentRefNo}}</label></td>
            </tr>

            <tr>


                <td width="25%" ><label>Threshold_Exceed_Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].thresholdExceedAmount}}</label></td>

            </tr>

            <tr>

                <td width="25%" ><label>Threshold_Exceed_TDS_Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].thresholdExceedTDSAmount}}</label></td>
                <td width="25%" ><label>Excemption Rate %</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].exemptionRate}}</label></td>


            </tr>


            <tr>

                <td width="25%" ><label>Excemption_Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].exemptionAmount}}</label></td>
                <td width="25%" ><label>Excemption_TDS_Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].exemptionTDSAmount}}</label></td>

            </tr>

            <tr>

                <td width="25%" ><label>Surcharge %</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].surcharge}}</label></td>
                <td width="25%" ><label>Edu Cess %</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].eduCess}}</label></td>

            </tr>

            <tr>

                <td width="25%" ><label>Base Rate Amt</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].baseRateAmount}}</label></td>
                <td width="25%" ><label>Surcharge Amt</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].surchargeAmount}}</label></td>

            </tr>


            <tr>

                <td width="25%" ><label>Edu Cess Amt</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].eduCessAmount}}</label></td>
                <td width="25%" ><label>TDS Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].tdsAmount}}</label></td>

            </tr>

            <tr>

                <td width="25%" ><label>TDS Recovery  Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].tdsRecoveryAmount}}</label></td>
                <td width="25%" ><label>TDS Refund  Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].tdsRefundAmount}}</label></td>

            </tr>

            <tr>

                <td width="25%" ><label></label></td>
                <td width="25%" ><label></label></td>
                <td width="25%" ></td>
                <td width="25%" ></td>

            </tr>

            </tbody>
        </table>


        <!--ACCOUNT CLOSURE  DETAILS-->

        <table class="table table-bordered">
            <h5 class="form_heading">ACCOUNT CLOSURE  DETAILS</h5>
            <tbody>




            <tr>

                <td width="25%" ><label>Closure Type</label></td>
                <td width="25%" > <label>{{vm.closureType }}</label> </td>

                <td width="25%" ><label>Account Closed Date</label></td>
                <td width="25%" > <label>{{vm.subsDate | uppercase}}</label> </td>



            </tr>



            <tr>

                <td width="25%" ><label>Proceeds to be Paid to</label></td>
                <td width="25%" > <label>{{ vm.getLabelFromValuesArray1(vm.bondDetails[0].proceedsToBePaid, vm.proceedsToBePaidList) }}</label> </td>


                <td width="25%" ><label>Interest Paid up to</label></td>
                <td width="25%" > <label>{{vm.bondDetails[0].intPaid }}</label> </td>
            </tr>

            <tr>
                <td width="25%" ><label>Interest Calculation From Date</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].intCalFromDate | uppercase }}</label>
                </td>

                <td width="25%" ><label>Interest Calculation to Date</label></td>
                <td width="25%" > <label>{{vm.bondDetails[0].intCalToDate | uppercase}}</label></td>
            </tr>

            <tr>
                <td width="25%" ><label>Current Half Yearly Interest Rate</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].brokenIntRate}}</label>
                </td>

                <td width="25%" ><label>Current Half Yearly Interest Amount</label></td>
                <td width="25%" > <label>{{vm.bondDetails[0].brokenIntAmt}}</label></td>
            </tr>


            <tr>
                <td width="25%" ><label>Pending Interest</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].pendingInterest}}</label></td>

                <td width="25%" ><label>Total Interest before TDS</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].totIntBefTDS }}</label></td>

            </tr>

            <tr>
                <td width="25%" ><label>TDS Amount</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].tdsAmount}}</label></td>

                <td width="25%" ><label>Total Interest after TDS</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].totIntAftTDS}}</label></td>

            </tr>


            <tr>
                <td width="25%" ><label>Total Amount to be paid</label></td>
                <td width="25%" ><label>{{vm.bondDetails[0].totalAmtToBePaid}}</label></td>

                <td width="25%" >
                    <div class="row">
                        <div class="form-group required">
                            <div class="col-sm-6">
                                <label for="closeRemarks" class="control-label">Closure Remarks</label>
                            </div>
                        </div>
                    </div>


                </td>
                <td width="25%" ><input type="text" class="form-control" id="closeRemarks"
                                        chars="alpha-numeric"
                                        limit-to="100" name="closeRemarks" readonly
                                        ng-model="vm.bondDetails[0].closureRemarks" required>
                </td>

            </tr>
            <tr>
            <td width="25%" >
                <div class="row">
                    <div class="form-group required">
                        <div class="col-sm-6">
                            <label for="closeRemarks" class="control-label">Checker Remarks for Closure</label>
                        </div>
                    </div>
                </div>


            </td>
            <td width="25%" ><input type="text" class="form-control" id="closeRemarks"
                                    chars="alpha-numeric"
                                    limit-to="100" name="closeRemarks"
                                    ng-model="vm.checkerRemarks" required>
            </td>
                <td></td>
                <td></td>
            </tr>


            </tbody>
        </table>

        <div  ng-if="vm.bondDetails[0].proceedsToBePaid=='N'">
            <h5 class="form_heading">NOMINEE  DETAILS</h5>
            <div style="max-height: 400px; overflow-x: auto;">

                <table class="table table-bordered"  ng-if="vm.bondDetails[0].proceedsToBePaid=='N'" ng-repeat="x in vm.nomineeDetailsList" >
                    <!--                <table class="table table-bordered table-striped list table-textWrap">-->
                    <thead>
                    <tr align="center">
                        <th>Nominee {{$index+1}}</th>
                    </tr>
                    </thead>

                    <thead>
                    <tr>
                        <th>Nominee ID</th>
                        <th>Nominee Name</th>
                        <th>D.O.B</th>
                        <th>PAN No</th>
                        <th>Relation</th>
                        <th>Share %</th>
                        <th>Amount Settled Rs.</th>

                        <th>TDS Rate</th>
                        <th>TDS Amount</th>
                        <th>Payment Mode</th>
                        <th>Credit Account Number</th>
                        <th>Remarks</th>
                    </tr>
                    </thead>

                    <tbody   ng-init="vm.getTotalSharePer()">
                    <tr>

                        <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>

                        <td>{{x.nomineeName}}</td>

                        <td>{{x.nomineeDOB}}</td>

                        <td>{{x.panNo}}</td>

                        <td>
                            <select class="form-control" id="relationWithMinor" ng-init=""
                                    name="relationWithMinor" ng-model="x.relationShip" ng-disabled="true"
                                    required>
                                <option value="" hidden="true">Select</option>
                                <option ng-repeat="item in vm.guardianDetailsList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                            </select>
                        </td>

                        <td>{{x.sharePercentage}}</td>

                        <td>{{x.shareAmountSettled}}</td>
                        <td>{{x.tdsRate}}</td>

                        <td>{{x.tdsAmount}}</td>
                        <td> <select class="form-control" id="modeOfPayment" name="modeOfPayment"
                                     ng-change="x.accNum='';" ng-model="x.modeOfInterestPay" ng-disabled="true">
                            <option value="">Select</option>
                            <option  value="MP001" >Credit Account</option>
                            <option  value="MP002" >DD/PO</option></select></td>

                        <td class="form-control" ng-if="x.modeOfInterestPay == 'MP001'"><input type="text" class="form-control" ng-model="x.accNum" ng-disabled="true" ng-change="getCbsCustDetails(x.accNum)"
                                                                                               required >
                        </td>


                        <td class="form-control" ng-if="x.modeOfInterestPay == 'MP002'"><input type="text" class="form-control" ng-model="x.accNum"
                                                                                               ng-disabled="true"  required >
                        </td>


                        <td> <input type="text" id="x.remarks" name="x.remarks" class="form-control" ng-disabled="true" ng-model="x.remarks"  ></td>


                    </tr>
                    </tbody>







                    <table>
                        <tr ng-if="vm.nomineeDetailsList.length > 0">

                            <td class="form-group required"><label class="control-label">Total (%)</label></td>
                            <td > <input type="text" class="form-control" id="totSharePercenValue[$index]"
                                         limit-to="3" min="1" max="100" name="totSharePercenErr"
                                         ng-model="vm.totSharePercenValue" required readonly>
                                <span class="alert-danger" ng-if="vm.totSharePercenErr" ng-bind="vm.totSharePercenErr"></span>
                            </td>

                        </tr>
                    </table>


                </table>
            </div>
        </div>


        <!--        <table class="table table-bordered" ng-if="vm.proceedsToBePaid=='L'">-->
        <div  ng-if="vm.bondDetails[0].proceedsToBePaid=='L'">


            <h5 class="form_heading" >LEGAL HEIRS DETAILS</h5>

            <table class="table table-bordered table-striped" style="margin-bottom: 40px;" ng-repeat="x in vm.nomineeDetailsList">




                <thead>
                <tr>
                    <th>S No</th>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>PAN No</th>
                    <th>Relation</th>
                    <th>Share %</th>
                    <th>Amount Settled </th>

                    <th>TDS Rate</th>
                    <th>TDS Amount</th>
                    <th>Payment Mode</th>
                    <th>Credit Account Number</th>
                    <th>Remarks</th>

                </tr>

                </thead>
                <tbody>
                <tr>
                    <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                    <td>
                        {{x.nomineeName}}
                    </td>
                    <td>
                        {{x.nomineeDOB}}
                    </td>
                    <td>
                        {{x.panNo}}
                    </td>

                    <td>
                        <select class="form-control" id="relationShip[$index]" name="relationShip[$index]"
                                ng-model="x.relationShip" ng-disabled="true" required>
                            <option value="" hidden="true">Select</option>
                            <option ng-repeat="items in vm.guardianDetailsList" value="{{items.SUBCODE}}" >{{items.DESCRIPTION}}</option>
                        </select>
                    </td>



                    <td>
                        <input type="text" class="form-control" id="sharePercentage[$index]"
                               limit-to="3" name="sharePercentage"
                               min="1" max="100"
                               ng-model="x.sharePercentage" ng-disabled="true" required>
                    </td>

                    <td><input type="text" class="form-control" id="shareAmountSettled[$index]"
                               limit-to="250" name="shareAmountSettled[$index]"
                               ng-model="x.shareAmountSettled" required disabled readonly>
                    </td>
                    <td>{{x.tdsRate}}</td>

                    <td>{{x.tdsAmount}}</td>
                    <td>
                        <select class="form-control" id="modeOfInterestPaymenmt" name="modeOfInterestPay" ng-disabled="true"
                                ng-change="x.accNum='';x.accBranch='';"  ng-model="x.modeOfInterestPay" required>
                            <option value="">Select</option>
                            <option  value="MP001" >Credit Account</option>
                            <option  value="MP002" >DD/PO</option>
                            <!--                        <option  value="MP003" >NEFT</option>-->
                        </select>
                    </td>

                    <td class="form-control" ng-if="x.modeOfInterestPay == 'MP001'"><input type="text" class="form-control" ng-model="x.accNum" ng-change="getCbsCustDetails(x.accNum)"
                                                                                           ng-disabled="true"    required >
                    </td>


                    <td class="form-control" ng-if="x.modeOfInterestPay == 'MP002'"><input type="text" class="form-control" ng-model="x.accNum" ng-disabled="true"
                                                                                           required >
                    </td>

                    <td>
                        <input type="text" class="form-control" id="remarks[$index]"
                               limit-to="6" name="remarks"
                               ng-model="x.remarks"  ng-disabled="true">
                        <!--                    // chars="only-numbers"-->
                    </td>
                </tr>



                </tbody>

            </table>

        </div>



<div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.auditInfo.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verified By </b> : {{(vm.auditInfo.verifiedBy) ? (vm.auditInfo.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.auditInfo.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.auditInfo.createdDate}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verified On </b> : {{(vm.auditInfo.verifiedDate) ? (vm.auditInfo.verifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>



        <div class="text-center">
            <button type="submit" class="btn btn-default" id="verifyButton"
                    ng-click="vm.verifySubmit(vm.checkerRemarks);"
                    ng-disabled="vm.bondClosureBefMaturForm.$invalid">Verify
            </button>
            <button type="submit" class="btn btn-default" id="deleteButton" ng-click="vm.rejectReason(vm.bondDetails[0].closureRemarks);" ng-disabled="vm.bondClosureBefMaturForm.$invalid"
            >Reject
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/bond_sub_acc_closure_before_maturity/action/inquiry'">Cancel
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>

        </div>
    </form>
</div>




<div class="modal" id="permissionMappingDelete" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"> REJECTION REMARKS</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper">
                    <form name="permissionDelete" role="form">

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-2"></div>
                                <label class="control-label col-sm-3">Remarks</label>
                                <div class="col-sm-5">
                                    <select class="form-control list_wrapper" id="remarks[$index]"
                                            name="remarks[$index]"
                                            ng-model="vm.remarks" ng-init="vm.getRemarksList();" required>
                                        <option value="">Select</option>
                                        <option ng-repeat="item in vm.remarksList"
                                                name="{{item.subCode + parentIndex}}"
                                                id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">
                                            {{item.subCodeDescription}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-offset-5 col-sm-8 form_submit">
                            <button type="button" class="btn btn-default" data-bs-dismiss="modal"
                                    ng-disabled="permissionDelete.$invalid"
                                    ng-click="vm.deleteSubmit(vm.closureRemarks, vm.remarks)">
                                Submit
                            </button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
