					</td>
					<td>
						<label class="data-bind" id="islccrown" ng-if="vm.schemeType.islccrown == 'Y'">YES</label>
						<label class="data-bind" id="islccrown" ng-if="vm.schemeType.islccrown == 'N'">NO</label>
					</td>
					<td></td>
				</tr>
				<tr>
					<td>
						<label for="ph_suspenseac" class="control-label">CBEC Focal Point Consolidation Account Place Holder for SERVICE TAX</label>
					</td>
					<td><label class="data-bind" id="ph_suspenseac">{{vm.schemeType.ph_suspenseac}}</label></td>
