package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class CafuFileHeaderRecordDTO {

    private String recordIdentifier;
    private String fileName;
    private String originatingBranch;
    private String activationDate;
    private String theirReferenceNmbr;
    private String sourceOfUpload;
    private String sourceCode;
    private String dispatchBankArrangement;
    private String pdcFlag;

    public String getRecordIdentifier() {
        return recordIdentifier;
    }

    public void setRecordIdentifier(String recordIdentifier) {
        this.recordIdentifier = recordIdentifier;
    }

    public String getFileName() {
        return fileName;
    }

    public void setFileName(String fileName) {
        this.fileName = fileName;
    }

    public String getOriginatingBranch() {
        return originatingBranch;
    }

    public void setOriginatingBranch(String originatingBranch) {
        this.originatingBranch = originatingBranch;
    }

    public String getActivationDate() {
        return activationDate;
    }

    public void setActivationDate(String activationDate) {
        this.activationDate = activationDate;
    }

    public String getTheirReferenceNmbr() {
        return theirReferenceNmbr;
    }

    public void setTheirReferenceNmbr(String theirReferenceNmbr) {
        this.theirReferenceNmbr = theirReferenceNmbr;
    }

    public String getSourceOfUpload() {
        return sourceOfUpload;
    }

    public void setSourceOfUpload(String sourceOfUpload) {
        this.sourceOfUpload = sourceOfUpload;
    }

    public String getSourceCode() {
        return sourceCode;
    }

    public void setSourceCode(String sourceCode) {
        this.sourceCode = sourceCode;
    }

    public String getDispatchBankArrangement() {
        return dispatchBankArrangement;
    }

    public void setDispatchBankArrangement(String dispatchBankArrangement) {
        this.dispatchBankArrangement = dispatchBankArrangement;
    }

    public String getPdcFlag() {
        return pdcFlag;
    }

    public void setPdcFlag(String pdcFlag) {
        this.pdcFlag = pdcFlag;
    }
}
