<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Subscription Account Closure on Maturity - Normal - Verify/Reject</h4>
    <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-4">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-3">
                    <input type="text" class="form-control" id="schemeCode" ng-model="vm.schemeName" required readonly>
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeName" id="treasurySearcher"
                       ng-click="vm.verifyDetailPage('S');"></i>
                    <i class="glyphicon glyphicon-remove clear cp"
                       ng-click="vm.schemeCode ='';vm.schemeName =''; vm.schemeStatus=''; vm.name=''; vm.panNoName= ''; vm.blaNo=''; vm.fromDate= ''; vm.toDate='';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="bondHolderName" class="control-label">Name</label>
                </div>
                <div class="col-sm-3">
                    <input type="text" class="form-control" maxlength="50"
                           id="bondHolderName" name="bondHolderName" ng-model="vm.name"
                           chars="only-chars"
                           oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '')">
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="panNum" class="control-label">PAN No</label>
                </div>
                <div class="col-sm-3">
                    <input type="text" class="form-control" id="panNum"
                           ng-model="vm.panNoName" ng-init="vm.panNoName = '';"
                           chars="alpha-numeric" minlength="5" maxlength="10"
                           oninput="this.value = this.value.replace(/\s+/g, '')">
                </div>
                <div class="col-sm-2">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="panSearcher"
                       ng-click="vm.verifyDetailPage('P');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.panNoName ='';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="blaNo" class="control-label">Bond BLA No</label>
                </div>
                <div class="col-sm-3">
                    <input type="text" class="form-control" id="blaNo"
                           minlength="5" maxlength="17" chars="only-numbers" ng-model="vm.blaNo"
                           ng-init="vm.blaNo = '';">
                </div>
                <div class="col-sm-2" ng-if="vm.blaNo || vm.panNoName">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="treasurySearch"
                       ng-click="vm.verifyDetailPage('B');"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.blaNo ='';"></i>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Redemption From Date</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="fromDate"
                               name="fromDate" ng-model="vm.fromDate"
                               uib-datepicker-popup="dd/MM/yyyy"
                               data-datepicker-options="vm.fromDateOptions"
                               data-ng-init="vm.fromDate=''; vm.fromDateVal();"
                               data-ng-change="vm.toDateVal(vm.fromDate); vm.toDate=''"
                               is-open="vm.effFromDatePicker.opened"  close-text="Close"
                               ng-blur="vm.textableDatePicker('fromDate',vm.fromDate);vm.futureNotAllowedValidation(this,'fromDate',vm.fromDate)"
                               ng-keyup="vm.autoslashing('fromDate')" chars="numbers-slash"  required>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effFromDatePicker.opened = true"
                                    id="fromDateSearcher">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label class="control-label">Redemption To Date</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="toDate"
                               name="toDate" ng-model="vm.toDate"
                               uib-datepicker-popup="dd/MM/yyyy"
                               data-datepicker-options="vm.toDateOptions"
                               is-open="vm.effToDatePicker.opened"
                               ng-blur="vm.textableDatePicker('toDate',vm.toDate);vm.futureNotAllowedValidation(this,'toDate',vm.toDate)"
                               ng-keyup="vm.autoslashing('toDate')" chars="numbers-slash" close-text="Close"
                               required>
                        <span class="input-group-btn">
                            <button type="button" class="btn btn-secondary"
                                    ng-click="vm.effToDatePicker.opened = true"
                                    id="toDateSearcher">
                                <i class="glyphicon glyphicon-calendar"></i>
                            </button>
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="rbi_bnd_acc_cls_mty.verify_detail({obj:{
                         		schemeCode: vm.schemeCode,
								schemeName: vm.schemeName,
								name: vm.name,
								panNoName: vm.panNoName,
								blaNo: vm.blaNo,
								fromDate: vm.fromDate,
								toDate: vm.toDate
								}})"
                    ng-disabled="accountOpeningForm.$invalid">Submit
            </button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbi_bnd_acc_cls_mty/action/inquiry';">Cancel
            </button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


<!--Scheme Code Details Modal-->
<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Scheme Code</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.modalSearch" ng-init="vm.modalSearch = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=true;sortedColumn = 'schemeName'">
                                <tr>
                                    <!--                                    <th class="modal-title title-case" ng-show="false">Scheme Code</th>-->
                                    <th class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeName';"
                                        ng-class="(sortedColumn == 'schemeName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Scheme Name
                                    </th>
                                    <th class="modal-title title-case"
                                        ng-click="(sortedColumn == 'schemeStatus')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'schemeStatus';"
                                        ng-class="(sortedColumn == 'schemeStatus')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Status
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.modalSearch | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode = x.schemeCode; vm.schemeName = x.schemeName; vm.schemeStatus = x.schemeStatus"
                                    data-bs-dismiss="modal">
                                    <td style="display: none;">{{x.schemeCode}}</td>
                                    <td>{{x.schemeName}}</td>
                                    <td>{{x.schemeStatus}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<!-- BLA No Modal -->
<div class="modal" id="subscriptionModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA Number Modal</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search" chars="alpha-numeric">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNoName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNoName';"
                                        ng-class="(sortedColumn == 'panNoName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN No
                                    </th>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';"
                                        ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BLA No
                                    </th>
                                    <th ng-click="(sortedColumn == 'name')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'name';"
                                        ng-class="(sortedColumn == 'name')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Holder Name
                                    </th>
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                                        ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Mode Of Holding
                                    </th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.subscriptionList | filter : vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click=" vm.panNoName = x.panNoName; vm.blaNo = x.blaNo; vm.name = x.name; vm.modeOfHolding = x.modeOfHolding;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.panNoName}}</td>
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.name}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>

<!-- Pan No Details Start-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNoName'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNoName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNoName';"
                                        ng-class="(sortedColumn == 'panNoName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN NO
                                    </th>
                                    <th ng-click="(sortedColumn == 'name')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'name';"
                                        ng-class="(sortedColumn == 'name')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN HOLDER NAME
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.panNoName = x.panNoName; vm.name = x.name;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.panNoName}}</td>
                                    <td>{{x.name}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>
<!-- Pan No Details End-->

