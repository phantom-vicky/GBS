<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" data-ng-if="vm.model.length>0">
    <div class="container from_wrapper new_form_wrapper">

        <div class="text-right form_submit">
            <button type="submit" class="btn btn-default"
                    onclick="window.location.href ='#!/rbibond_gu_functionality';" id="homeButton">Home
            </button>

            <button type="button" id="cancel_Button" class="btn btn-cancel"
                    onclick="window.location.href= '#!/rbibond_bod_eod_status_inquiry_dc/action/inquiry';">Back
            </button>
        </div>




        <h4 class="form_heading">RBI Bond BOD_EOD Status Inquiry</h4>
        <sol-header></sol-header>

        <div>
            <table style="width:100% " class="table table-bordered" style="padding: 10px">
                <tr>
                    <th scope="col" ng-if="vm.statusInquiry">Status</th>
                    <td ng-if="vm.statusInquiry">{{ vm.statusInquiry === 'EP' ? 'EOD Pending' :
                        vm.statusInquiry === 'BC' ? 'BOD Completed' :
                        vm.statusInquiry === 'EC' ? 'EOD Completed' : vm.statusInquiry }}</td>
                </tr>
                <tr>
                    <th scope="col">Bod / Eod Date</th>
                    <td> {{vm.solDate | date : 'dd/MM/yyyy'}}</td>
                </tr>
                <tr>
                    <th scope="col">Module Name</th>
                    <td>RBI BOND</td>
                </tr>
                <tr>
                  <th scope="col" ng-if="vm.levelName">Level Name</th>
                  <td ng-if="vm.levelName">{{vm.levelName}}</td>
              </tr>
                <tr>
                    <th scope="col" ng-if="vm.branchId">Level Branch Id</th>
                    <td ng-if="vm.branchId">{{vm.branchId}}</td>
                </tr>

                <tr>
                    <th scope="col" ng-if="vm.branchId">Total Count</th>
                    <td ng-if="vm.branchId">{{vm.total}}</td>
                </tr>
            </table>
        </div>



        <form name="vm.bondNominationsForm" role="form">
            <div class="row" style="display: flex; align-items: center; justify-content: space-between;">
                <!-- Show Dropdown -->
                <div class="col-sm-3" style="flex: 1">
                    <div class="form-group">
                        <table style="border-spacing: 2">
                            <caption style="display: none">
                                RBI Bond BOD_EOD Status Inquiry
                            </caption>
                            <tr>
                                <th scope="col"></th>
                            </tr>
                            <tr>
                                <td>Show&nbsp;</td>
                                <td>
                                    <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                                            ng-model="vm.pageSize" ng-init="vm.pageSize='5'"
                                            ng-change="vm.pageNo = 1; vm.getDetails();">
                                        <option value="5">5 per page</option>
                                        <option value="10">10 per page</option>
                                        <option value="20">20 per page</option>
                                        <option value="50">50 per page</option>
                                    </select>                                </td>
                                <td>&nbsp;records per page</td>
                            </tr>
                        </table>
                    </div>
                </div>


                <!-- Search and Export Controls -->
                <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end;">
                    <!-- Search -->
                    <div class="form-group" style="margin-right: 15px;">
<!--                        <div class="input-group">-->
<!--                            <div class="input-group-addon">-->
<!--                                <i class="glyphicon glyphicon-search"></i>-->
<!--                            </div>-->
<!--                            <input-->
<!--                                    type="text"-->
<!--                                    id="search"-->
<!--                                    class="form-control"-->
<!--                                    ng-change="vm.updateFilteredRecords()"-->
<!--                                    ng-model="vm.searchText"-->
<!--                                    placeholder="Search"/>-->
<!--                        </div>-->



                        <div class="input-group">
                            <input type="text" id="search" class="form-control" data-ng-model="vm.searchText" placeholder="Search"/>
                            <div class="input-group-addon">
                                <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getDetails()"></span>
                            </div>
                            <div class="input-group-addon">
                                <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchText='';vm.pageNo = 1; vm.getDetails()"></span>
                            </div>
                        </div>
                    </div>



                    </div>


                    <!-- Export -->
                    <div class="form-group">
                        <select
                                class="form-control"
                                id="export"
                                name="export"
                                ng-model="vm.downloadType"
                                ng-init="vm.downloadType=''"
                                ng-change="vm.downloadReport()"
                        >
                            <option value="">EXPORT</option>
                            <option value="excel">EXCEL</option>
                        </select>
                    </div>
                </div>



            <div class="table-responsive">
                <table class="table table-bordered table-striped list nowrap table-textWrap datatable">
                    <thead data-ng-if="!vm.noDataFoundInSearch">
                    <tr>
                        <th scope="col">S.No</th>
                        <th scope="col">Branch ID</th>
                        <th scope="col">Branch Description</th>
                        <th scope="col">Level Name</th>
                    </tr>
                    </thead>
                    <tbody data-ng-if="!vm.noDataFoundInSearch">
<!--                    <tr ng-repeat="x in vm.filteredRecords.slice((vm.currentPage-1)*vm.pageSize, vm.currentPage*vm.pageSize)">-->
<!--                        <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>-->

                    <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">
                        <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                        <td>{{x.branchId}}</td>
                        <td>{{x.branchDesc}}</td>
                        <td>{{x.levelName}}</td>
                    </tr>
                    </tbody>
                    <tbody data-ng-if="vm.noDataFoundInSearch">
                    <tr>
                        <td style="text-align:center">No Records Found</td>
                    </tr>
                    </tbody>
                </table>
            </div>
<!--            <div class="row">-->
<!--                <div-->
<!--                        ng-if="vm.filteredRecords.length != 0"-->
<!--                        class="col-md-12 text-right"-->
<!--                >-->
<!--                    <div class="pagination-container">-->
<!--                        <ul class="pagination">-->
<!--                            <li ng-class="{disabled: vm.currentPage === 1}">-->
<!--                                <a href="javascript:void(0)" ng-click="vm.firstPage()"-->
<!--                                >First</a-->
<!--                                >-->
<!--                            </li>-->
<!--                            <li ng-class="{disabled: vm.currentPage === 1}">-->
<!--                                <a href="javascript:void(0)" ng-click="vm.prevPage()"-->
<!--                                >Prev</a-->
<!--                                >-->
<!--                            </li>-->
<!--                            <li-->
<!--                                    ng-repeat="page in vm.pages"-->
<!--                                    ng-class="{active: vm.page === vm.currentPage}"-->
<!--                            >-->
<!--                                <a href="javascript:void(0)" ng-click="vm.setPage(page)"-->
<!--                                >{{page}}</a-->
<!--                                >-->
<!--                            </li>-->
<!--                            <li ng-class="{disabled: vm.currentPage === vm.totalPages}">-->
<!--                                <a href="javascript:void(0)" ng-click="vm.nextPage()"-->
<!--                                >Next</a-->
<!--                                >-->
<!--                            </li>-->
<!--                            <li ng-class="{disabled: vm.currentPage === vm.totalPages}">-->
<!--                                <a href="javascript:void(0)" ng-click="vm.lastPage()"-->
<!--                                >Last</a>-->
<!--                            </li>-->
<!--                        </ul>-->
<!--                    </div>-->
<!--                </div>-->
<!--            </div>-->

    <div class="text-center form_submit">
              <span data-ng-show="vm.showPrevious">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goPreviousPage()">Prev</button>
              </span>

        <span>
                <button type="submit" class="btn btn-default" data-ng-disabled="true" data-ng-init="vm.pageNo=1" data-ng-model="vm.pageNo" data-ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}</button>
              </span>

        <span data-ng-show="vm.showNext">
                <button type="submit" class="btn btn-default" data-ng-click="vm.goNextPage();">Next</button>
              </span>
    </div>
    <div class="col-md-6">
                Showing {{(vm.currentPage-1)*vm.pageSize + 1}} to
                {{vm.maxValue()}} of
                {{vm.filteredRecords.length}} records
            </div>

        </form>
    </div>
</div>

<div class="container" data-ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading"> RBI Bond BOD_EOD Status Inquiry</h4>
        No records found to display.
        <div style="text-align: center">
            <button type="button" class="btn btn-default" onclick="window.location.href='#!/rbibond_bod_eod_status_inquiry_dc/action/inquiry';">Back</button>
        </div>
    </div>
</div>