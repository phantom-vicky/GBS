package com.isl.gbm.rbibond.dto.scrolls;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class CumulativeNonCumulativeDTO {

    private String cumulativeBlaNo;
    private String ncBlaNo;
    private String cumulativeAmount;
    private String ncAmount;
    private String cumulativeCas;
    private String ncCas;
    private String cumulativeDueDate;
    private String ncDueDate;
    private String cumulativeSch;
    private String ncSch;

    public String getCumulativeBlaNo() {
        return cumulativeBlaNo;
    }

    public void setCumulativeBlaNo(String cumulativeBlaNo) {
        this.cumulativeBlaNo = cumulativeBlaNo;
    }

    public String getNcBlaNo() {
        return ncBlaNo;
    }

    public void setNcBlaNo(String ncBlaNo) {
        this.ncBlaNo = ncBlaNo;
    }

    public String getCumulativeAmount() {
        return cumulativeAmount;
    }

    public void setCumulativeAmount(String cumulativeAmount) {
        this.cumulativeAmount = cumulativeAmount;
    }

    public String getNcAmount() {
        return ncAmount;
    }

    public void setNcAmount(String ncAmount) {
        this.ncAmount = ncAmount;
    }

    public String getCumulativeCas() {
        return cumulativeCas;
    }

    public void setCumulativeCas(String cumulativeCas) {
        this.cumulativeCas = cumulativeCas;
    }

    public String getNcCas() {
        return ncCas;
    }

    public void setNcCas(String ncCas) {
        this.ncCas = ncCas;
    }

    public String getCumulativeDueDate() {
        return cumulativeDueDate;
    }

    public void setCumulativeDueDate(String cumulativeDueDate) {
        this.cumulativeDueDate = cumulativeDueDate;
    }

    public String getNcDueDate() {
        return ncDueDate;
    }

    public void setNcDueDate(String ncDueDate) {
        this.ncDueDate = ncDueDate;
    }

    public String getCumulativeSch() {
        return cumulativeSch;
    }

    public void setCumulativeSch(String cumulativeSch) {
        this.cumulativeSch = cumulativeSch;
    }

    public String getNcSch() {
        return ncSch;
    }

    public void setNcSch(String ncSch) {
        this.ncSch = ncSch;
    }
}
