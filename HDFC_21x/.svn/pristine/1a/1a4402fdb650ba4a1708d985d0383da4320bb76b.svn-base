                                                       ng-model="vm.customerMasterDetails.C040.oldValue" readonly>
                                </td>

                                <td width="25%">TDS Rate Applicable%</td>
                                <td width="25%"><input type="text" class="form-control"
                                                       id="tdsRateOne" ng-model="vm.customerMasterDetails.C064.oldValue"  readonly></td>
                            </tr>


                            </tbody>
                        </table>
                        <h4 class="form_heading">WITNESS DETAILS</h4>
                        <table class="table table-bordered">
                            <tbody>
