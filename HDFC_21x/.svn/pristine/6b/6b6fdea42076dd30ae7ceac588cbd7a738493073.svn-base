<!--                    </div>-->
<!--                </div>-->
<!--                <div class="col-sm-2"></div>-->
<!--                <label for="confirmPassword" class="control-label col-sm-3">Confirm Password</label>-->
<!--                <div class="col-sm-2" ng-class="{ 'has-error': userRegistrationForm.confirmPassword.$dirty && (userRegistrationForm.confirmPassword.$error.required || userRegistrationForm.confirmPassword.$error.compareTo )}">-->
<!--                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" ng-model="vm.userDetails.confirmPassword"-->
<!--                           ng-disabled="userRegistrationForm.password.$error.pattern || vm.userDetails.userDomain == 'Finacle'" role="login"-->
<!--                           compare-to="vm.userDetails.password" maxlength="15" ng-required="vm.userDetails.userDomain != 'Finacle'" autocomplete="off" readonly-->
<!--                           onfocus="this.removeAttribute('readonly');">-->
<!--                    <div class="messages" ng-show="userRegistrationForm.confirmPassword.$touched">-->
<!--                        <p ng-show="userRegistrationForm.confirmPassword.$error.required">This field is required</p>-->
<!--                        <p ng-show="userRegistrationForm.confirmPassword.$dirty && userRegistrationForm.confirmPassword.$error.compareTo">Password doesn't match</p>-->
<!--                    </div>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->
        <div class="col-sm-offset-5 col-sm-8 form_submit">
            <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="userRegistrationForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="vm.showCancelConfirmation()">Cancel</button>
        </div>
        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>