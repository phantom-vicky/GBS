.white-bg{
	background: #f9f9f9;
    line-height: 40px;
    padding: 0px;
    margin: 15px;
    border: 1px solid #ddd;
    display: block;
    width: 50%;
    margin: 15px auto;
}

.white-bg label{
	margin-bottom: 0px;
}


