<div class="loader-new" ng-if="vm.loader"></div>
<cbs-left-menu></cbs-left-menu>
<div class="container from_wrapper new_form_wrapper" ng-if="!vm.newValueDisplay">
	<h4 class="form_heading  feature-heading">Other Bank Details - Modify</h4>
		<form name="otherBankDetailsForm" role="form">
		<div class="row">
			<div class="form-group required ">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankCode" class="control-label">Bank Code</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankCode" chars="alpha-numeric" id="bankCode" ng-model="vm.cbsOtherBankDetails.C001" maxlength="8" required>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankName" class="control-label">Bank Name</label>
				</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankName" chars="alpha-numeric"
						id="bankName" ng-model="vm.cbsOtherBankDetails.C002"
						maxlength="50">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankShortName" class="control-label">Bank Short
					Name</label>
					</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="bankShortName" chars="alpha-numeric"
						id="bankShortName" ng-model="vm.cbsOtherBankDetails.C003"
						maxlength="50">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText1" class="control-label">Additional
					Text1</label>
					</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText1"
						id="additionalText1" chars="alpha-numeric"
						ng-model="vm.cbsOtherBankDetails.C005" maxlength="40">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText2" class="control-label">Additional
					Text2</label>
					</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText2"
						id="additionalText2" chars="alpha-numeric"
						ng-model="vm.cbsOtherBankDetails.C006" maxlength="40">
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText3" class="control-label">Additional
					Text3</label>
					</div>
				<div class="col-sm-3">
					<input type="text" class="form-control" name="additionalText3"
						id="additionalText3" chars="alpha-numeric"
						ng-model="vm.cbsOtherBankDetails.C007" maxlength="40">
				</div>
			</div>
		</div>
		
	<div class="row" ng-if="vm.cbsOtherBankDetails">
		<div class="col-sm-7"></div>
		<label  ng-if="!vm.verified" class="control-label col-sm-5"><b>Verify Status : Y</b></label>
		<label  ng-if="vm.verified" class="control-label col-sm-5"><b>Verify Status : N</b></label>
	</div>
		<div class="row">
			<div class="text-center form_submit">
				<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="otherBankDetailsForm.$invalid" ng-click="vm.modify();">Update</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="vm.showCancelConfirmation('cbs_other_bank_details.modify');">Cancel</button>
			</div>
		</div>
		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>

<div class="container from_wrapper new_form_wrapper" ng-if="vm.newValueDisplay">
	<h4 class="form_heading  feature-heading">Other Bank Details - Modify</h4>
		<form name="otherBankDetailsForm" role="form">
		<div class="row form-group">
			<div class="col-sm-6"></div>
			<div class="col-sm-2">New Value</div>
			<div class="col-sm-2">Old Value</div>
		</div>
		<div class="row">
			<div class="form-group required ">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankCode" class="control-label">Bank Code</label>
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankCode" chars="alpha-numeric" id="bankCode" ng-model="vm.cbsOtherBankDetailsNewScope.bankCode" maxlength="8" required>
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankCode_old" chars="alpha-numeric" id="bankCode_old" ng-model="vm.cbsOtherBankDetails.bankCode" readonly>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankName" class="control-label">Bank Name</label>
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankName" chars="alpha-numeric" id="bankName" ng-model="vm.cbsOtherBankDetailsNewScope.bankName" maxlength="50">
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankName_old" chars="alpha-numeric" id="bankName_old" ng-model="vm.cbsOtherBankDetails.bankName" readonly>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="bankShortName" class="control-label">Bank Short
					Name</label>
					</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankShortName" chars="alpha-numeric" id="bankShortName" ng-model="vm.cbsOtherBankDetailsNewScope.bankShortName" maxlength="50">
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="bankShortName_old" chars="alpha-numeric" id="bankShortName_old" ng-model="vm.cbsOtherBankDetails.bankShortName" readonly>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText1" class="control-label">Additional
					Text1</label>
					</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText1" id="additionalText1" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetailsNewScope.additionalText1" maxlength="40">
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText1_old" id="additionalText1_old" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetails.additionalText1" readonly>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText2" class="control-label">Additional
					Text2</label>
					</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText2" id="additionalText2" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetailsNewScope.additionalText2" maxlength="40">
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText2_old" id="additionalText2_old" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetails.additionalText2" readonly>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="form-group">
				<div class="col-sm-3"></div>
				<div class="col-sm-3">
				<label for="additionalText3" class="control-label">Additional
					Text3</label>
					</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText3" id="additionalText3" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetailsNewScope.additionalText3" maxlength="40">
				</div>
				<div class="col-sm-2">
					<input type="text" class="form-control" name="additionalText3_old" id="additionalText3_old" chars="alpha-numeric" ng-model="vm.cbsOtherBankDetails.additionalText3" readonly>
				</div>
			</div>
		</div>
		<div class="row" ng-if="vm.cbsOtherBankDetails">
		<div class="col-sm-7"></div>
		
		<label class="control-label col-sm-5"><b>Verify Status : N</b></label>
	</div>
		<div class="row">
			<div class="text-center form_submit">
				<button type="submit" class="btn btn-default" id="submitButton"
					ng-disabled="otherBankDetailsForm.$invalid" ng-click="vm.modify();">Update</button>
				<button type="button" class="btn btn-cancel" id="cancelButton"
					ng-click="vm.showCancelConfirmation('cbs_other_bank_details.modify');">Cancel</button>
			</div>
		</div>
		<div class="text-center">
			<notice-message-directive></notice-message-directive>
		</div>
	</form>
</div>
