<user-left-menu></user-left-menu>
<!-- <left-menu-directive></left-menu-directive> -->
<div class="loader">
</div>
<div class="container from_wrapper">
    <h4 class="form_heading">Add Permission</h4>
    <form name="addPermissionForm" role="form" ng-submit="vm.addPermissionConfirmation()" novalidate>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <label for="module" class="control-label col-sm-3">Module</label>
                <div class="col-sm-3">
                    <select id="module" name="module" class="form-control" ng-options="module.id as module.name for module in vm.modules" ng-model="vm.permission.moduleId" ng-change="vm.getFeatures()" ng-change="vm.generatePermissionDispName()" required>
                        <option value="">Select Module</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <label for="feature" class="control-label col-sm-3">Feature</label>
                <div class="col-sm-3">
                    <select id="feature" name="feature" class="form-control" ng-options="feature.id as feature.name for feature in vm.features" ng-model="vm.permission.featureId" ng-change="vm.generatePermissionDispName()" required>
                        <option value="">Select Feature</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <label for="permissionType" class="control-label col-sm-3">Permission Type</label>
                <div class="col-sm-3">
                    <select id="permissionType" name="permissionType" class="form-control" ng-options="type as type for type in vm.permissionTypes" ng-model="vm.permission.type" ng-change="vm.generatePermissionDispName()" required>
                        <option value="">Select Permission Type</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <label for="displayName" class="control-label col-sm-3">Permission Display Name</label>
                <div class="col-sm-3">
                    <label class="col-sm-5" ng-bind="vm.permission.displayName"></label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <label for="description" class="control-label col-sm-3">Permission Description</label>
                <div class="col-sm-3">
                   <textarea class="form-control" id="description" name="description" ng-model="vm.permission.description" maxlength="200"></textarea>
                </div>
            </div>
        </div>
        <div class="col-sm-offset-5 col-sm-8 form_submit">
            <button type="submit" id="submit" name="submit" class="btn btn-default" ng-disabled="addPermissionForm.$invalid">Submit</button>
            <button type="button"  id="cancel" name="cancel" class="btn btn-cancel" ng-click="vm.showCancelConfirmation()">Cancel</button>
        </div>

        <notice-message-directive></notice-message-directive>
    </form>
</div>