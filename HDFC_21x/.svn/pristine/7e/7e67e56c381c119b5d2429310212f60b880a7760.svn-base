<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Accounting Entries - Modify</h4>
    <sol-header></sol-header>
    <form name="accountOpeningForm" role="form">
        <table class="table table-bordered table-striped list old-new-value-table" aria-label="">
            <thead>
            <tr>
                <td style="width: 50%">Name of the Module</td>
                <td style="width: 50%">
                    <label class="data-bind" id="moduleName"> RBI Bond</label>
                </td>
            </tr>
            <tr>
                <td style="width: 50%">Name of the Bond Scheme</td>
                <td style="width: 50%">
                    <label class="data-bind" id="schemeName">{{vm.schemeName}}</label>
                </td>
            </tr>
            <tr>
                <td style="width: 50%">Effective From Date</td>
                <td style="width: 50%">
                    <label class="data-bind" id="panNo"
                           model="vm.effectiveFromDate">{{vm.effectiveFromDate}}</label>
                </td>
            </tr>
            </thead>
        </table>
<!--Subscription Accounts-->
        <h5 class="form_heading">Subscription Accounts</h5>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="susCMS" class="control-label">SUSPENSE ACCT – CMS (Debit)</label>
                </div>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="susCMS" chars="only-numbers" maxlength="14"
                           ng-model="vm.suspAccCmsDbt" ng-init="vm.suspAccCmsDbt='';">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="susINet" class="control-label">SUSPENSE ACCT – INET (Debit)</label>
                </div>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="susINet" chars="only-numbers" maxlength="14"
                           ng-model="vm.suspAccInetDbt" ng-init="vm.suspAccInetDbt='';">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="rrbPay" class="control-label">RRB PAY (Credit)</label>
                </div>
                <div class="col-sm-4">
                    <input type="text" class="form-control" id="rrbPay" chars="only-numbers" maxlength="14"
                           ng-model="vm.rrbPayCr" ng-init="vm.rrbPayCr">
                </div>
            </div>
        </div>
        <h5 class="form_heading">Accounting entries for cash-in and net banking handling by cash-in application itself.
            Accounting entries will not happen for above account in GBS</h5>
