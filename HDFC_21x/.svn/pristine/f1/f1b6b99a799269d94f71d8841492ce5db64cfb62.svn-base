<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Bond Closure – CBT & CAT – Inquiry</h4>
    <sol-header></sol-header>
    <form name="customerMasterForm" role="form">
        <div class="col-sm-6 col-sm-offset-3">

            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label class="control-label">Name of the Module</label>
                    </div>
                    <div class="col-sm-4">
                        <label>RBI Bond</label>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="schemeCode"
                               ng-model="vm.schemeName"
                               chars="alpha-numeric" readonly required>
                    </div>
                    <div class="col-sm-2">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="schemeCode"
                           id="treasurySearch"
                           ng-click="vm.getModuleNameInq();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.schemeCode ='';vm.schemeName ='';vm.bondHolderName='';vm.blaNo ='';vm.panNum = '';vm.subscriptionId ='';"></i>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label class="control-label">Closure Type</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="radio" id="catCloserType" name="closerType" ng-model="vm.closerType" required
                               value="CAT" ng-init="vm.defaultSelectOption();" checked>CAT
                        <input type="radio" id="cbtCloserType" name="closerType" ng-model="vm.closerType" required
                               value="CBT">CBT
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group">
                    <div class="col-sm-6">
                        <label for="bondHolderName" class="control-label">Name</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" maxlength="100"
                               id="bondHolderName" name="bondHolderName" ng-model="vm.bondHolderName"
                               oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '').replace(/^\s/, '');">
                    </div>
                </div>
            </div>


            <div class="row">
                <div class="form-group ">
                    <div class="col-sm-6">
                        <label for="panNum" class="control-label">PAN No</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="panNum"
                               ng-model="vm.panNum" ng-init="vm.panNum = '';"
                               chars="alpha-numeric" minlength="5" maxlength="10"
                               oninput="this.value = this.value.replace(/\s+/g, '')">
                    </div>
                    <div class="col-sm-2" ng-if="vm.panNum || vm.bondHolderName && vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getPantorchInq();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNum ='';vm.blaNo ='';vm.subscriptionId ='';"></i>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="blaNo" class="control-label">BLA No</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="blaNo"
                               ng-model="vm.blaNo" ng-init="vm.blaNo = '';"
                               chars="only-numbers" minlength="5" maxlength="20" required>
                    </div>
                    <div class="col-sm-2" ng-if="vm.panNum || vm.blaNo && vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getblaNoInq();vm.subscriptionId ='';"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.blaNo ='';vm.subscriptionId ='';"></i>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="form-group required">
                    <div class="col-sm-6">
                        <label for="subscriptionId" class="control-label">Subscription ID</label>
                    </div>
                    <div class="col-sm-4">
                        <input type="text" class="form-control" id="subscriptionId"
                               ng-model="vm.subscriptionId" ng-init="vm.subscriptionId = '';"
                               chars="only-numbers" minlength="5" maxlength="20" required>
                    </div>
                    <div class="col-sm-2" ng-if="vm.subscriptionId || vm.blaNo  && vm.schemeName">
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="treasurySearch"
                           ng-click="vm.getsubscriptionIdInq();"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.subscriptionId ='';"></i>
                    </div>
                </div>
            </div>

            <div class="text-center form_submit">
                <button type="submit" class="btn btn-default" id="submitButton"
                        ui-sref="cancellation_subscription_cat_cbt.inquiry_detail({obj:{
								schemeCode: vm.schemeCode,
								blaNo: vm.blaNo,
								schemeName: vm.schemeName,
								closerType: vm.closerType,
								panNum: vm.panNum,
								bondHolderName: vm.bondHolderName,
								subscriptionId: vm.subscriptionId,
								}})"
                        ng-disabled="customerMasterForm.$invalid || vm.disableFlag">Submit
                </button>
                <button type="button" class="btn btn-cancel" id="cancelButton"
                        onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel
                </button>
            </div>
            <div class="text-center">
                <notice-message-directive></notice-message-directive>
            </div>
        </div>
    </form>
</div>
<!-- Cust Id Details Start-->
<div class="modal" id="panModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">PAN No</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'panNum'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'panNum')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panNum';"
                                        ng-class="(sortedColumn == 'panNum')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN NO
                                    </th>
                                    <th ng-click="(sortedColumn == 'panHldName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'panHldName';"
                                        ng-class="(sortedColumn == 'panHldName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        PAN HOLDER NAME
                                    </th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.PanTorch | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.panNum= x.panNum;vm.panHldName= x.panHldName;" data-bs-dismiss="modal">
                                    <td>{{x.panNum}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.PanTorch.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->

<div class="modal" id="schemeModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">SCHEME CODE</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.schemeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'subCode'">
                                <tr>
                                    <th class="modal-title title-case" ng-show="false">Scheme Code</th>
                                    <th ng-click="(sortedColumn == 'subCodeDescription')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subCodeDescription';"
                                        ng-class="(sortedColumn == 'subCodeDescription')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        SCHEME NAME
                                    </th>
                                    <th ng-click="(sortedColumn == 'status')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'status';"
                                        ng-class="(sortedColumn == 'status')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        STATUS
                                    </th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.schemeList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.schemeCode= x.subCode;vm.schemeName= x.subCodeDescription;"
                                    data-bs-dismiss="modal">
                                    <td style="display: none;">{{x.subCode}}</td>
                                    <td>{{x.subCodeDescription}}</td>
                                    <td>{{x.status}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.schemeList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->

<!-- Cust Id Details Start-->
<div class="modal" id="blaModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">BLA List</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search" chars="alpha-numeric">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'blaNo'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'blaNo')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'blaNo';"
                                        ng-class="(sortedColumn == 'blaNo')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        BLA NO
                                    </th>
                                    <th ng-click="(sortedColumn == 'nameOfTheBondHolder')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'nameOfTheBondHolder';"
                                        ng-class="(sortedColumn == 'nameOfTheBondHolder')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Name of the Bond Holder
                                    </th>
                                    <!--                                    <th ng-click="(sortedColumn == 'jointHolderType')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'jointHolderType';" ng-class="(sortedColumn == 'jointHolderType')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Joint Holder Type</th>-->
                                    <th ng-click="(sortedColumn == 'modeOfHolding')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'modeOfHolding';"
                                        ng-class="(sortedColumn == 'modeOfHolding')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        Mode of Holding
                                    </th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.blaDataList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.blaNo= x.blaNo;vm.nameOfTheBondHolder= x.nameOfTheBondHolder;vm.modeOfHolding= x.modeOfHolding;"
                                    data-bs-dismiss="modal">
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                    <td>{{x.modeOfHolding}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.blaDataList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>
<!-- Cust Id Details End-->


<!-- Cust Id Details Start-->
<div class="modal" id="subscriptionModel" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Subscription Id</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control"
                                       ng-model="vm.searchSolId" ng-init="vm.searchSolId = ''"
                                       placeholder="Search" chars="alpha-numeric">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">

                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll sort">
                                <thead ng-init="reverseOrder=false;sortedColumn = 'subscriptionId'">
                                <tr>
                                    <th ng-click="(sortedColumn == 'subscriptionId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'subscriptionId';"
                                        ng-class="(sortedColumn == 'subscriptionId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        SUBSCRIPTION ID
                                    </th>
                                    <th ng-click="(sortedColumn == 'bondHolderName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'bondHolderName';"
                                        ng-class="(sortedColumn == 'bondHolderName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">
                                        HOLDER NAME
                                    </th>

                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.subscriptionList | filter:vm.searchSolId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.subscriptionId= x.subscriptionId;" data-bs-dismiss="modal">
                                    <td>{{x.subscriptionId}}</td>
                                    <td>{{x.bondHolderName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.subscriptionList.length==0">No records found to display.</div>
            </div>

        </div>
    </div>
</div>