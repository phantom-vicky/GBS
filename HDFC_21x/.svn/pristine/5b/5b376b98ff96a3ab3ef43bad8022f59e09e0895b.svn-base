package com.isl.gbm.cbs.integration.dao;

import com.isl.gbm.cbs.integration.model.GeneralSetupDetails;

import java.util.List;

/**
 * The Interface GeneralSetupDao.
 *
 * @author harishbabu.t
 */
public interface GeneralSetupDao {

    /**
     * Find by id.
     *
     * @param id the id
     * @return the general setup details
     */
    GeneralSetupDetails findById(int id);

    /**
     * Gets the general setup details.
     *
     * @return the general setup details
     */
    List<GeneralSetupDetails> getGeneralSetupDetails();

    /**
     * Gets the general setup details.
     *
     * @param paramName the param name
     * @return the general setup details
     */
    GeneralSetupDetails getGeneralSetupDetails(String paramName);

    /**
     * Update.
     *
     * @param generalSetupDetailslist the general setup detailslist
     */
    void update(List<GeneralSetupDetails> generalSetupDetailslist);

    /**
     * Verify.
     *
     * @param generalSetupDetailslist the general setup detailslist
     */
    void verify(List<GeneralSetupDetails> generalSetupDetailslist);

}
