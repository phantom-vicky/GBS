<div class="loader-new" ng-if="vm.loader"></div>
<div class="container">

    <div id="loginbox" style="margin-top:50px;" class="mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
        <div class="panel panel-info">

            <div class="panel-heading">
                <div class="panel-title">Reset Password</div>      
            </div>
            <div style="padding-top:30px" class="panel-body">
                <div style="display:none" id="login-alert" class="alert alert-danger col-sm-12"></div>
                <form name="resetPasswordForm" class="form-horizontal" role="form" ng-submit="vm.updatePassword()" novalidate>
                   <div style="margin-bottom: 25px" class="input-group">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                        <input  id="login-password" autocomplete="off" type="password" class="form-control" name="password" placeholder="password" role="login" ng-model="vm.credentials.password"
                               ng-pattern="vm.passwordPattern" required maxlength='15'>
                    </div>
                    <div class="messages" ng-show="resetPasswordForm.password.$touched">
                        <p ng-show="resetPasswordForm.password.$error.required">This field is required</p>
                        <p ng-show="resetPasswordForm.password.$error.pattern">Password should be at least 8 characters long and should contain one number,one small letter,one capital letter and one special character.</p>
                    </div>
                    <div style="margin-bottom: 25px" class="input-group">
                        <span class="input-group-addon"><i class="glyphicon glyphicon-lock"></i></span>
                        <input  id="login-confirmPassword" autocomplete="off" type="password" class="form-control" name="confirmPassword" placeholder="confirmPassword" role="login" ng-model="vm.credentials.confirmPassword" compare-to="vm.credentials.password" required maxlength='15'>
                    </div>
                      <div class="messages" ng-show="resetPasswordForm.confirmPassword.$touched">
                        <p ng-show="resetPasswordForm.confirmPassword.$error.required">This field is required</p>
                        <p ng-show="resetPasswordForm.confirmPassword.$error.compareTo">Password doesn't match</p>
                    </div>                 
                    <div class="input-group">             
                    </div>
                    <div style="margin-top:10px" class="form-group">
                        <!-- Button -->
                        <div class="col-sm-12 controls">
                            <button type="submit" class="btn btn-default" ng-disabled="resetPasswordForm.$invalid">Submit</button>
                            <button type="button" class="btn btn-cancel" id="cancel" onclick="window.location.href= '#!/report_menu_page';">Cancel</button>

                        </div>
                    </div>
                    <p ng-show="vm.errorMsg" class="help-block alert alert-danger">{{ vm.errorMsg }}</p>
                </form>
            </div>
        </div>
    </div>
</div>

  