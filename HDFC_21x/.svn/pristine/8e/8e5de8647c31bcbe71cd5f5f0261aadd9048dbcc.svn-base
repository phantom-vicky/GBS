<user-left-menu></user-left-menu>
<div class="loader-new" ng-show="loader"></div>
<div class="container from_wrapper">


    <h4 class="form_heading  feature-heading">USER CREATION/ ROLE MAPPING - ADD</h4>
    <form name="userRegistrationForm" role="form" ng-submit="vm.addUserConfirmation(userRegistrationForm.$valid)" novalidate>


        <div class="row">
            <div class="form-group required">
                <label for="username" class="control-label col-sm-3">User Id/Login Id</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="username" name="username" ng-model="vm.userDetails.username"  ng-blur="vm.validateUsername();" maxlength="20" role="login" style="text-transform: none;"  ng-pattern="/^[A-Za-z][A-Za-z0-9]*$/"   autocomplete="off" readonly onfocus="this.removeAttribute('readonly');" chars="alpha-numeric" tabindex="1" required >
                </div>
                <div class="col-sm-2"></div>
                <label for="empName" class="control-label col-sm-3">Employee Name</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="empName" name="empName"      ng-pattern="/[a-zA-Z]/" ng-keypress="vm.validateInput($event,'empName')" ng-model="vm.userDetails.employeeName" maxlength="100"
                           tabindex="3" required leading-space>
                </div>
            </div>
        </div>


        <div class="row">
            <div class="form-group required">
                <!--<label for="password" class="control-label col-sm-3">Password</label>
                <div class="col-sm-2">
                    <input type="password" class="form-control" id="password" name="password" ng-model="vm.userDetails.password" ng-blur="vm.passwordError = vm.validatePassword(vm.userDetails.password);" minlength="12" maxlength="20" tabindex="2" required leading-space>

                <div ng-show="userRegistrationForm.password.$touched && vm.passwordError" class="text-danger">
                    {{ vm.passwordError }}
                </div></div>-->

                <div class="col-sm-3">
                    <label for="branchCode" class="control-label">Role</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="role"
                           ng-model="vm.userDetails.role"  tabindex="12" readonly required>
                </div>
                <div class="col-sm-1">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="roleSearch"
                       ng-click="vm.getAllRoles();"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.userDetails.role='';"></i>
                </div>
                <div class="col-sm-1"></div>
                <label for="empCode" class="control-label col-sm-3">Employee Code</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="empCode" name="empCode" ng-model="vm.userDetails.employeeCode" ng-blur="vm.validateEmployeeCode();" maxlength="20" chars="alpha-numeric" oninput="this.value = this.value.replace(/\s+/g, '')" tabindex="2" required leading-space>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">

                <div class="col-sm-3">
                    <label for="branchCode" class="control-label">Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchCode"
                           ng-model="vm.userDetails.branchCode" tabindex="4" readonly required>
                </div>
                <div class="col-sm-1">
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="branchCodeSearch"
                       ng-click="vm.getBranchDetails();"></i> <i
                        class="glyphicon glyphicon-remove clear cp"
                        ng-click="vm.userDetails.branchCode='';vm.userDetails.branchName='';"></i>
                </div>

                <div class="col-sm-1"></div>

                <label for="branchName" class="control-label col-sm-3">Branch Name</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchName" name="branchCode" ng-model="vm.userDetails.branchName" tabindex="5" leading-space readonly required>
                </div>

            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <label for="departmentCode" class="control-label col-sm-3">Department Code</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="departmentCode" name="departmentCode" ng-model="vm.userDetails.departmentCode" chars="only-numbers" leading-space tabindex="6" maxlength="5" required>
                </div>
                <div class="col-sm-2"></div>
                <label for="departmentName" class="control-label col-sm-3">Department Name</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" oninput="this.value = this.value.replace(/^\s+/, '').replace(/\d/g, '')"
                           id="departmentName"  name="departmentName" ng-model="vm.userDetails.departmentName" leading-space maxlength="50" tabindex="7" required>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group ">

                <label for="email" class="control-label col-sm-3">Email</label>
                <div class="col-sm-2">
                    <input type="email" class="form-control"
                           id="email" name="email" maxlength="50"
                           ng-model="vm.userDetails.email" ng-blur="vm.validateEmail();" ng-pattern="vm.emailPattern" oninput="this.value = this.value.replace(/\s+/g, '')"  tabindex="8" leading-space>
                </div>
                <div class="col-sm-2"></div>
                <label for="mobileNumber" class="control-label col-sm-3">Mobile No</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" minlength="10" maxlength="10"
                           id="mobileNumber" ng-model="vm.userDetails.MobileNo"
                           chars="only-numbers" onkeypress="return isNumber(event)" tabindex="9" leading-space>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="form-group">
                <label for="address" class="control-label col-sm-3">Address</label>
                <div class="col-sm-2">
                       <textarea  class="form-control"  ng-keypress="vm.validateInputAddress($event,'address')"  id="address" name="address" ng-model="vm.userDetails.address" tabindex="10" maxlength="100"  leading-space></textarea>
                </div>
                <div class="col-sm-2"></div>
                <label for="supervisorCode" class="control-label col-sm-3">Supervisor Code</label>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="supervisorCode" name="supervisorCode" ng-model="vm.userDetails.supervisorCode" maxlength="20" tabindex="11" chars="alpha-numeric" leading-space>
                </div>
            </div>
        </div>
        <div class="col-sm-offset-5 col-sm-8 form_submit">
            <button type="submit" class="btn btn-default" id="submitButton" ng-disabled="userRegistrationForm.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton" ng-click="vm.showCancelConfirmationToHome()">Cancel</button>
        </div>
        <div class="text-center">
         </div>
    </form>
</div>


<div class="modal" id="branchCodeModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Branch Codes</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.branchCodeList.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchCode')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchCode';" ng-class="(sortedColumn == 'branchCode')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch Code</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'branchName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'branchName';" ng-class="(sortedColumn == 'branchName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Branch name</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.branchCodeList | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.userDetails.branchCode = x.branchCode; vm.userDetails.branchName = x.branchName;" data-bs-dismiss="modal">
                                    <td>{{x.branchCode}}</td>
                                    <td>{{x.branchName}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.branchCodeList.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="roleModal" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title">Roles</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper" ng-if="vm.rolesResultSet.length>0">
                    <div class="col-sm-8 form_submit">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="input-group-addon">
                                    <i class="glyphicon glyphicon-search"></i>
                                </div>
                                <input type="text" class="form-control" chars="alpha-numeric"
                                       ng-model="vm.searchCustomerId" ng-init="vm.searchCustomerId = ''"
                                       placeholder="Search">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4 form_submit"></div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table table-bordered list scroll">
                                <thead ng-init="reverseOrder = false; sortedColumn = 'scssCustomerId'">
                                <tr>
<!--                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'roleId')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'roleId';" ng-class="(sortedColumn == 'roleId')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Id</th>-->
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'roleName')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'roleName';" ng-class="(sortedColumn == 'roleName')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Name</th>
                                    <th class="modal-title title-case" ng-click="(sortedColumn == 'roleDescription')?(reverseOrder=(!reverseOrder)): (reverseOrder = false);sortedColumn = 'roleDescription';" ng-class="(sortedColumn == 'roleDescription')?((reverseOrder)?('arrow-down') : ('arrow-up') ) : ('')">Description</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr class="cp"
                                    ng-repeat="x in vm.rolesResultSet | filter:vm.searchCustomerId | orderBy:sortedColumn:reverseOrder"
                                    ng-click="vm.userDetails.role = x.roleName; vm.userDetails.roleId = x.roleId;" data-bs-dismiss="modal">
<!--                                    <td>{{x.roleId}}</td>-->
                                    <td>{{x.roleName}}</td>
                                    <td>{{x.roleDescription}}</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="list_wrapper" ng-if="vm.rolesResultSet.length==0">No records found to display.</div>
            </div>
        </div>
    </div>
</div>