


    <div class="loader-new" data-ng-if="vm.loader"></div>
    <div class="container" data-ng-if="vm.model.length>0">
    <div class="container from_wrapper new_form_wrapper" >

    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!';" id="homeButton">Home
        </button>

        <button type="button" id="cancel_Button" class="btn btn-cancel"
                onclick="window.location.href= '#!/Bond_Interest_NOT_Calculated_Report_collecting_branch/action/inquiry';">Back
        </button>
    </div>
        <h4 class="form_heading">Bond Interest Not Calculated Report</h4>
        <sol-header></sol-header>

        <div>
        <table style="width: 100%" class="table table-bordered">
                    <tr>
                        <th scope="col">Name of the Bond Scheme</th>
                        <td >{{vm.schemeName}}</td>
                    </tr>
            <tr>
                <th scope="col">Interest payment for</th>
                <td>{{vm.interestPaid}}</td>
            </tr>
             <tr>
                 <th scope="col">Financial Year</th>
                 <td>{{vm.financialYear}}</td>
             </tr>
            <tr>
                <th scope="col">Total Count</th>
                <td>{{vm.total}}</td>
            </tr>
        </table>
        </div>

        <form name="vm.bondNominationsForm" role="form">

            <div class="row" style="display: flex; align-items: center; justify-content: space-between">
                <div class="col-sm-3" style="flex: 1">
                    <div class="form-group">
                        <table style="border-spacing: 2" aria-label="BPRR">
                            <tr>
                                <th scope="col"></th>
                            </tr>
                            <tr>
                                <td>Show&nbsp;</td>
                                <td>
                                    <select class="form-control pageDropDown" id="pageSize" name="pageSize"
                                            ng-model="vm.pageSize" ng-init="vm.pageSize='5'" ng-change="vm.pageNo='1'; vm.getBondInterestCalculatedReportDetails();">
                                        <option value="5">5 per page</option>
                                        <option value="10">10 per page</option>
                                        <option value="20">20 per page</option>
                                        <option value="50">50 per page</option>
                                    </select>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="col-sm-6" style="display: flex; align-items: center; justify-content: flex-end">
                    <div class="form-group" style="margin-right: 15px">
                        <div class="input-group">
                            <input type="text" id="search" class="form-control" data-ng-model="vm.searchValue" placeholder="Search" />
                            <div class="input-group-addon">
                                <span class="glyphicon glyphicon-search" data-ng-click="vm.pageNo = 1; vm.getBondInterestCalculatedReportDetails()"></span>
                            </div>
                            <div class="input-group-addon">
                                <span class="glyphicon glyphicon-remove clear cp" data-ng-click="vm.searchValue='';vm.pageNo = 1; vm.getBondInterestCalculatedReportDetails(); "></span>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <select class="form-control" id="export" name="export" data-ng-model="vm.downloadType" data-ng-init="vm.downloadType=''"data-ng-disabled="vm.noDataFoundInSearch" data-ng-change="vm.downloadReport()">
                            <option value="">EXPORT</option>
                            <option value="excel">EXCEL</option>
                            <option value="csv">CSV</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
            <table class="table table-bordered table-striped list table-textWrap datatable">
                                <thead  data-ng-if="!vm.noDataFoundInSearch">
                                <tr class="thalign">
                                    <th scope="col">S.No</th>
                                    <th scope="col">PAN No</th>
                                    <th scope="col">BLA No</th>
                                    <th scope="col">Holder Name</th>
                                    <th scope="col">Subscription Date</th>
                                    <th scope="col">Subscription Account No</th>
                                    <th scope="col">Subscription Amount (Rs)</th>
                                    <th scope="col">Interest Payment mode</th>
                                    <th scope="col">Gross Interest Amount</th>
                                    <th scope="col">Reasons</th>
                                </tr>
                                </thead>
                                <tbody data-ng-if="!vm.noDataFoundInSearch">
                                <tr dir-paginate="x in vm.filteredRecords | itemsPerPage: itemsPerPage" pagination-id="trailRunRep">

                                    <td>{{ ($index + 1) + ((vm.pageNo - 1) * vm.pageSize) }}</td>
                                    <td>{{x.panNo}}</td>
                                    <td>{{x.blaNo}}</td>
                                    <td>{{x.holderName}}</td>
                                    <td>{{x.subscriptionDate}}</td>
                                    <td>{{x.subscriptionAccountNo}}</td>
                                    <td >{{x.subscriptionAmount}}</td>
                                    <td>{{x.modeOfPaymentDescription}}</td>
                                    <td>{{x.grossInterestAmount}}</td>
                                    <td >{{x.reasons}}</td>
                                </tr>
                                </tbody>

                <tfoot data-ng-if="!vm.noDataFoundInSearch">

            <th scope="col"></th>
            <th scope="col"></th>
            <th scope="col"></th>
            <th scope="col"></th>
            <th scope="col"></th>
            <th scope="col">Subscription Total Account</th>
            <th scope="col">{{vm.indianNumberFormat(vm.subTotalAmountt | number:2)}}</th>
            <th scope="col">Gross Intrest Total Amount</th>
            <th scope="col">{{vm.indianNumberFormat(vm.grossTotalAmountt | number:2)}}</th>
            <th scope="col">Reasons</th>
                </tfoot>



                                <tbody>
                <tbody data-ng-if="vm.noDataFoundInSearch" >
                <tr >
                    <td colspan="14" style="text-align:center">No Records Found</td>
                </tr>
                </tbody>

                            </table>
            </div>
            <br>
            <div class="text-center form_submit">
                        <span ng-show="vm.showPrevious">
                        <button type="submit" class="btn btn-default" ng-click="vm.goPreviousPage()">Prev
                        </button>
                        </span>

                <span>
                          <button type="submit" class="btn btn-default" ng-disabled="true" ng-init="vm.pageNo=1" ng-model="vm.pageNo" ng-click="vm.paymentStatus();">{{vm.pageNo}} of {{vm.maxPages}}
                          </button>
                        </span>

                <span ng-show="vm.showNext">
                        <button type="submit" class="btn btn-default" ng-click="vm.goNextPage();" >Next
                        </button>
                        </span>
            </div>




        </form>
                    </div>
                </div>

<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Bond Interest Not Calculated Report </h4>
        No records found to display.
        <div style="text-align: center">
            <button type="button" class="btn btn-default" onclick="window.location.href='#!/Bond_Interest_NOT_Calculated_Report_collecting_branch/action/inquiry';">Back</button>
        </div>
    </div>
</div>