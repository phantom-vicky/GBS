package com.isl.gbm.cbs.integration.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class TranDetailsDTO {

    private String accountNumber;

    private String isSysAcct;

    private String reason;

    private String validityStatus;

    private String tranLeg;
    private String cbsBal;

    private String acctStatus;

    public String getAcctStatus() {
        return acctStatus;
    }

    public void setAcctStatus(String acctStatus) {
        this.acctStatus = acctStatus;
    }

    public String getCbsBal() {
        return cbsBal;
    }

    public void setCbsBal(String cbsBal) {
        this.cbsBal = cbsBal;
    }


    public String getAccountNumber() {
        return accountNumber;
    }

    public void setAccountNumber(String accountNumber) {
        this.accountNumber = accountNumber;
    }

    public String getIsSysAcct() {
        return isSysAcct;
    }

    public void setIsSysAcct(String isSysAcct) {
        this.isSysAcct = isSysAcct;
    }


    public String getReason() {
        return reason;
    }

    public void setReason(String reason) {
        this.reason = reason;
    }

    public String getValidityStatus() {
        return validityStatus;
    }

    public void setValidityStatus(String validityStatus) {
        this.validityStatus = validityStatus;
    }

    public String getTranLeg() {
        return tranLeg;
    }

    public void setTranLeg(String tranLeg) {
        this.tranLeg = tranLeg;
    }
}
