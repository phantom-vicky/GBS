								name="GBM_INT_06" ng-model="vm.generalSetupNewScope.GBM_INT_06"
								string-to-number required >
									<option ng-value="3">Through CBS Web Service Calls</option>
							</select></td>
							<td><select class="form-control" id="GBM_INT_06_old"
								name="GBM_INT_06_old" ng-model="vm.generalSetupScope.GBM_INT_06"
								string-to-number required disabled>
									<option ng-value="3">Through CBS Web Service Calls</option>
							</select></td>
						</tr>
						<tr>
							<td>GBM/INT/07</td>
							<td>To maintain transactions done through cheques from the
