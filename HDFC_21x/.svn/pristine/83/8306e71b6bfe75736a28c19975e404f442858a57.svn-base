                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Guardian Last  Name</td>
                                        <td class="old-value">{{(vm.getDetails.guardianDetailsValueModel[0] && vm.getDetails.guardianDetailsValueModel[0].C008)?
                                            (vm.getDetails.guardianDetailsValueModel[0].C008.oldValue) : ('')}}
                                        </td>
                                        <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.guardianDetailsValueModel[0] &&
