                                <tr>
                                    <td>Bond Holder Date of Birth (DD/MM/YYYY)</td>
                                    <td class="old-value">{{(vm.getDetails.masterDetailsValueModel[0] && vm.getDetails.masterDetailsValueModel[0].C009)?
                                        (vm.getDetails.masterDetailsValueModel[0].C009.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.getDetails.previousOperationType == 'M'">{{vm.getDetails.masterDetailsValueModel[0] &&
                                        vm.getDetails.masterDetailsValueModel[0].C009? (vm.getDetails.masterDetailsValueModel[0].C009.newValue) : ('')}}
