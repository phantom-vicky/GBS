package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class PreMaturityListDTO {

    private String panNo;
    private String holderName;
    private String age;
    private String blaNo;
    private String modeOfHolding;
    private String subsId;
    private String accOpenDate;
    private String maturityDate;
    private String subsAmt;

    public String getPanNo() {
        return panNo;
    }

    public void setPanNo(String panNo) {
        this.panNo = panNo;
    }

    public String getHolderName() {
        return holderName;
    }

    public void setHolderName(String holderName) {
        this.holderName = holderName;
    }

    public String getAge() {
        return age;
    }

    public void setAge(String age) {
        this.age = age;
    }

    public String getBlaNo() {
        return blaNo;
    }

    public void setBlaNo(String blaNo) {
        this.blaNo = blaNo;
    }

    public String getModeOfHolding() {
        return modeOfHolding;
    }

    public void setModeOfHolding(String modeOfHolding) {
        this.modeOfHolding = modeOfHolding;
    }

    public String getSubsId() {
        return subsId;
    }

    public void setSubsId(String subsId) {
        this.subsId = subsId;
    }

    public String getAccOpenDate() {
        return accOpenDate;
    }

    public void setAccOpenDate(String accOpenDate) {
        this.accOpenDate = accOpenDate;
    }

    public String getMaturityDate() {
        return maturityDate;
    }

    public void setMaturityDate(String maturityDate) {
        this.maturityDate = maturityDate;
    }

    public String getSubsAmt() {
        return subsAmt;
    }

    public void setSubsAmt(String subsAmt) {
        this.subsAmt = subsAmt;
    }

    @Override
    public String toString() {
        return "PreMaturityListDTO{" +
                "panNo='" + panNo + '\'' +
                ", holderName='" + holderName + '\'' +
                ", age='" + age + '\'' +
                ", blaNo='" + blaNo + '\'' +
                ", modeOfHolding='" + modeOfHolding + '\'' +
                ", subsId='" + subsId + '\'' +
                ", accOpenDate='" + accOpenDate + '\'' +
                ", maturityDate='" + maturityDate + '\'' +
                ", subsAmt='" + subsAmt + '\'' +
                '}';
    }
}
