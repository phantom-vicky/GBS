<!-- CBEC -->
<div class="modal" id="cbecCollectionAccountModal" role="dialog">
	<div class="modal-dialog">
		<!-- Modal content-->
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-bs-dismiss="modal">&times;</button>
				<h4 class="modal-title">CBEC Collection A/C Place Holder</h4>
			</div>
			<div class="modal-body">
				<div class="loader_popup"></div>
				<div class="list_wrapper"
					ng-if="vm.cbecCollectionAccountDetails .length>0">
					<div class="row">

						<div class="col-sm-12">
							<table class="table table-bordered list">
								<thead>
									<tr>
										<th>CBEC Collection A/C Place Holder</th>

									</tr>
								</thead>
								<tbody>
									<tr class="cp"
										ng-repeat="x in vm.cbecCollectionAccountDetails | filter:searchcbecCollectionAccount"
										ng-click="vm.cbecCollectionAccount = x.cbecCollectionAccount"
										data-bs-dismiss="modal">
										<td>{{x.cbecCollectionAccount}}</td>

									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="list_wrapper"
					ng-if="vm.cbecCollectionAccountDetails .length==0">No records
					found to display.</div>
			</div>

		</div>
	</div>
</div>

<div class="modal" id="FocalPointModal" role="dialog">
	<div class="modal-dialog">
		<!-- Modal content-->
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-bs-dismiss="modal">&times;</button>
				<h4 class="modal-title">CBEC Focal Point Consolidation A/C
					Place Holder for CENTRAL EXCISE TAX</h4>
			</div>
			<div class="modal-body">
				<div class="loader_popup"></div>
				<div class="list_wrapper" ng-if="vm.cbecFocalPointDetails .length>0">
					<div class="row">

						<div class="col-sm-12">
							<table class="table table-bordered list">
								<thead>
									<tr>
										<th>CBEC Focal Point Consolidation A/C Place Holder for
											CENTRAL EXCISE TAX</th>

									</tr>
								</thead>
								<tbody>
									<tr class="cp"
										ng-repeat="x in vm.cbecFocalPointDetails | filter:searchcbecFocalPoint"
										ng-click="vm.cbecFocalPoint = x.cbecFocalPoint"
										data-bs-dismiss="modal">
										<td>{{x.cbecFocalPoint}}</td>

									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
				<div class="list_wrapper"
					ng-if="vm.cbecFocalPointDetails .length==0">No records found
					to display.</div>
			</div>

		</div>
	</div>
</div>


<div class="modal" id="cbecFocalPointServiceTaxModal" role="dialog">
	<div class="modal-dialog">
		<!-- Modal content-->
		<div class="modal-content">
			<div class="modal-header">
				<button type="button" class="close" data-bs-dismiss="modal">&times;</button>
				<h4 class="modal-title">CBEC Focal Point Consolidation A/C
					Place Holder for Service TAX</h4>
			</div>
			<div class="modal-body">
				<div class="loader_popup"></div>
				<div class="list_wrapper"
					ng-if="vm.cbecFocalPointServiceTaxDetails .length>0">
					<div class="row">

						<div class="col-sm-12">
							<table class="table table-bordered list">
								<thead>
									<tr>
										<th>CBEC Focal Point Consolidation A/C Place Holder for
											Service TAX</th>

									</tr>
								</thead>
								<tbody>
									<tr class="cp"
										ng-repeat="x in vm.cbecFocalPointServiceTaxDetails | filter:searchcbecFocalPointServiceTax"
										ng-click="vm.cbecFocalPointServiceTax = x.cbecFocalPointServiceTax"
										data-bs-dismiss="modal">
