        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Is Separate Holder ID required for each Joint holder?</label>
                </div>
                <td width="25%">
                    <ng-container ng-repeat="item in vm.commonYesNoMetaData">
                        <input type="radio" name="isSeperateHolder" id="isSeperateHolder{{$index}}"
                            ng-model="vm.cbdtSchemeParameter.C037.oldValue" ng-value="item.value"
                            required />{{item.label}}
                    </ng-container>
                </td>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Batch size for Interest Payment</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="batchSize" chars="only-numbers"
                        ng-model="vm.cbdtSchemeParameter.C038.oldValue" minlength="1" maxlength="5" required />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
