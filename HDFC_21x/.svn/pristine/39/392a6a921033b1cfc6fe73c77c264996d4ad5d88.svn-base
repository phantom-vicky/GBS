<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">

    <h4 class="form_heading">Appendix IV Interest Payment Scroll</h4>
    <sol-header></sol-header>
    <form name="bondPrincipalRepayFrom" role="form">



        <div class="row" ng-init="vm.getModuleName();">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="schemeCode" class="control-label">Name of the Bond Scheme</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="schemeCode" name="schemCode"
                            ng-model="vm.schemeCode"  ng-change="vm.alert(vm.schemeCode)" required>
                        <option value="">Select</option>
                        <option ng-repeat="item in vm.schemeList" value="{{item.subCode}}" ng-bind="item.subCodeDescription"></option>
                    </select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label  class="control-label">Interest paid for </label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="interestPaid" name="interestPaid"
                           ng-model="vm.interestPaid"  ng-init="vm.interestPaid=''" required>
                        <option value="">Select</option>
                        <option  value="JAN-JUN">JAN-JUN</option>
                        <option  value="JUL-DEC">JUL-DEC</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label  class="control-label">Financial Year</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="financialYear" name="financialYear"
                           ng-model="vm.financialYear"  ng-init="vm.financialYear=''" required>
                        <option value="">Select</option>
                        <option  value="2023-2024">2023-2024</option>
                        <option value="2022-2023">2022-2023</option>
                    </select>
                </div>
            </div>
        </div>






        <div class="text-center form_submit">
            <button type="submit" id="submitbutton" class="btn btn-default"
                    ui-sref="rbibond_interest_repayment_scroll.inquiry_details({obj:{
                            schemeCode:vm.schemeCode,
                            intertestPaidFor:vm.interestPaid,
                            finacialYear:vm.financialYear,
                            schemeName:vm.schemeName
                        }})"
                    ng-disabled="bondPrincipalRepayFrom.$invalid">Submit</button>
            <button type="button" class="btn btn-cancel" id="cancelButton"
                    onclick="window.location.href= '#!/rbibond_gu_functionality';">Cancel
            </button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>


