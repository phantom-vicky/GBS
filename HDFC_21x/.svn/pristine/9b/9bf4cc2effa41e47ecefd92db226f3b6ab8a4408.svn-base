<!--                       id="treasurySearch"-->
<!--                       ng-click="vm.getModuleName();"></i> <i-->
<!--                        class="glyphicon glyphicon-remove clear cp"-->
<!--                        ng-click="vm.schemeCode ='';vm.schemeCode =''"></i>-->
<!--                </div>-->
<!--            </div>-->
<!--        </div>-->



        <div class="row">
            <div class="form-group required">
                <div class="col-sm-3"></div>
                <div class="col-sm-3">
                    <label for="panNumber" class="control-label">PAN NO.</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="panNumber"
                           name="panNumber" chars="alpha-numeric"
                           ng-model="vm.panNumber" ng-init="vm.panNumber=''"
                           onKeyDown="if(event.keyCode === 32) return false;" minlength="5" maxlength="10"
                           required>
                    </div>
                <div class="col-sm-2" ng-if="vm.panNumber"> <!--ng-if="vm.panNumber"-->
                    <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                       id="panNoSearch" ng-init="vm.disableFlag = true;"
                       ng-click="vm.getInqPanNumberDtls(); vm.disableFlag = false;"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.panNumber = '';"></i>
                </div>
            </div>
        </div>





        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ui-sref="death_marking_for_bla.inquiry_detail({obj:{
								panNumber: vm.panNumber,
								schemeCode: vm.schemeCode,
								}})"
                    ng-disabled="blaDodfrm.$invalid || vm.disableFlag">Submit</button>
            <button type="button" id="subButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/rbibond_gu_functionality'">Cancel</button>
        </div>

        <div class="text-center">
            <notice-message-directive></notice-message-directive>
        </div>
    </form>
</div>







