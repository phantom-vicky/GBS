                                        (item.C025.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
                                        item.C025? (item.C025.newValue) : ('')}}
                                    </td>
                                </tr>

                                <tr ng-if="item.C015.oldValue=='Y' || item.C015.newValue == 'Y'">
                                    <td>Guardian Mobile No.</td>
                                    <td class="old-value">{{(item && item.C026)?
                                        (item.C026.oldValue) : ('')}}
                                    </td>
                                    <td class="new-value" ng-if="vm.auditInfo.previousOperationType == 'M'">{{item &&
