<!-- Second Page-->
<div class="container from_wrapper">

<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<h4 class="form_heading">CAS ACKNOWLEDGEMENT NUMBER MAINTENANCE - Modify</h4>
<sol-header></sol-header>
<form name="vm.bondNominationsForm" role="form" ng-submit="vm.modifySubmit();">


<!--<div class="container from_wrapper new_form_wrapper">-->
    <div class="row">
        <div class="col-sm-12">
            <div class="table">
                <table class="table table-bordered table-striped list">

                    <thead>
                    <tr>
                        <th>Check box</th>
                        <th>S.No</th>
                        <th>Bond Ledger Account Number</th>
                        <th>Holder Name</th>
                        <th>Subscription ID</th>
                        <th>Subscription Amount</th>
                        <th>Bond Type</th>
                        <th>CAS Acknowledgement Number</th>
                        <th>CAS Acknowledgement Date (dd/mm/yyyy)</th>

                    </tr>
                    </thead>
                    <tbody>
                    <tr ng-repeat="items in vm.model" ng-init="parentIndex=$index;" ng-init="vm.modifySelectDetails[$index]={};">
                        <td>
                            <input type="checkbox" class="form-control" id="checkbox[$index]"
                                   name="checkbox[$index]"  ng-model="vm.checkbox[items.C004.oldValue]" >
                        </td>
                        <td>{{vm.itemsPerPage*(vm.currentPage-1)+$index+1}}</td>
                        <td>{{items.C005.oldValue}}</td>
                        <td>{{items.C006.oldValue}}</td>
                        <td>{{items.C004.oldValue}}</td>
                        <td>{{items.C010.oldValue}}</td>
                        <td>{{items.C007.oldValue}}</td>
                        <td ><input type="text" ng-required="vm.checkbox[items.C005.oldValue]" class="form-control" id="items.C008.oldValue"  name="items.C008.oldValue"  ng-model="items.C008.oldValue"
                        ng-value="items.C008.oldValue" chars="only-numbers"></td>
