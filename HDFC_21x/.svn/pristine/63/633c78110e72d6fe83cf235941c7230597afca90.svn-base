package com.isl.gbm.rbibond.dto.reports;

import com.fasterxml.jackson.annotation.JsonInclude;

import java.util.List;
@JsonInclude(JsonInclude.Include.NON_NULL)
public class ListOfNomineeDTO {
    private String nomineeName;
    private String nomineePanNumber;
    private String nomineeBlaNumber;
    private String nomineeDOB;
    private String nomineeSubscriptionID;

    public String getNomineeName() {
        return nomineeName;
    }

    public void setNomineeName(String nomineeName) {
        this.nomineeName = nomineeName;
    }

    public String getNomineePanNumber() {
        return nomineePanNumber;
    }

    public void setNomineePanNumber(String nomineePanNumber) {
        this.nomineePanNumber = nomineePanNumber;
    }

    public String getNomineeBlaNumber() {
        return nomineeBlaNumber;
    }

    public void setNomineeBlaNumber(String nomineeBlaNumber) {
        this.nomineeBlaNumber = nomineeBlaNumber;
    }

    public String getNomineeDOB() {
        return nomineeDOB;
    }

    public void setNomineeDOB(String nomineeDOB) {
        this.nomineeDOB = nomineeDOB;
    }

    public String getNomineeSubscriptionID() {
        return nomineeSubscriptionID;
    }

    public void setNomineeSubscriptionID(String nomineeSubscriptionID) {
        this.nomineeSubscriptionID = nomineeSubscriptionID;
    }
}
