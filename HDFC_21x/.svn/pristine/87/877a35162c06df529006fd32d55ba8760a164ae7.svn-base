<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <form name="blaForm" role="form">
        <h4 class="form_heading">BOND Freeze / Un-Freeze Verify/Reject</h4>
        <sol-header></sol-header>
        <div class="container from_wrapper new_form_wrapper" ng-if="vm.responseResultForVer.length>0">
            <div class="row">
                <div class="col-sm-12">

                    <table class="table table-bordered table-striped list old-new-value-table">
                        <thead>
                        <tr>
                            <td width="50%">Name of the Bond Scheme</td>
                            <td width="50%">
                                <label class="data-bind" id="schemeName">
                                    {{vm.schemeName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">PAN No</td>
                            <td width="50%">
                                <label class="data-bind" id="panNo">{{vm.panNoName}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">BLA No</td>
                            <td width="50%">
                                <label class="data-bind" id="blaNo">{{vm.blaNo}}</label>
                            </td>
                        </tr>
                        <tr>
                            <td width="50%">Subscription Id</td>
                            <td width="50%">
                                <label class="data-bind" id="subId">{{vm.subId}}</label>
                            </td>
                        </tr>
                        <tr>
                            <table class="table table-bordered table-striped list old-new-value-table">
                                <thead>
                                <tr>
                                    <th width="50%">Particular</th>
                                    <th>{{(vm.preOrpTyp == 'M')?('Old Value'): ('Value')}}</th>
                                    <th ng-if="vm.preOrpTyp == 'M'">New Value</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td>Does the principal amount need to be frozen?</td>
                                    <td class="old-value">{{(vm.amountFreezeOldValue)? (vm.amountFreezeOldValue) :
                                        ('')}}
                                    </td>
                                    <td ng-if="vm.preOrpTyp == 'M'" class="new-value">
                                        {{(vm.amountFreezeNewValue)? (vm.amountFreezeNewValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Does the Interest Payment need to be frozen?</td>
                                    <td class="old-value">{{(vm.interestFreezeOldValue)? (vm.interestFreezeOldValue) :
                                        ('')}}
                                    </td>
                                    <td ng-if="vm.preOrpTyp == 'M'" class="new-value">
                                        {{(vm.interestFreezeNewValue)? (vm.interestFreezeNewValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Is transferring out from another bank allowed?</td>
                                    <td class="old-value">{{(vm.transferAnotherBankOldValue)?
                                        (vm.transferAnotherBankOldValue) : ('')}}
                                    </td>
                                    <td ng-if="vm.preOrpTyp == 'M'" class="new-value">
                                        {{(vm.transferAnotherBankNewValue)? (vm.transferAnotherBankNewValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Maker Reason</td>
                                    <td class="old-value">{{(vm.makerRemarksOldValue)? (vm.makerRemarksOldValue) :
                                        ('')}}
                                    </td>
                                    <td ng-if="vm.preOrpTyp == 'M'" class="new-value">
                                        {{(vm.makerRemarksNewValue)? (vm.makerRemarksNewValue) : ('')}}
                                    </td>
                                </tr>
                                <tr>
                                    <td>Checker Reason</td>
                                    <td class="old-value">{{(vm.checkerRemarksOldValue)? (vm.checkerRemarksOldValue) :
                                        ('')}}
                                    </td>
                                    <td ng-if="vm.preOrpTyp == 'M'" class="new-value">
                                        {{(vm.checkerRemarksNewValue)? (vm.checkerRemarksNewValue) : ('')}}
                                    </td>
                                </tr>

                                <!-- <tr>
                                     <td>Does the principal amount need to be frozen?</td>
                                     <td>{{vm.amountFreezeOldValue}}</td>
                                     <td ng-if="vm.preOrpTyp = 'M'">{{vm.amountFreezeNewValue}}</td>
                                 </tr>
                                 <tr>
                                     <td>Does the Interest Payment need to be frozen?</td>
                                     <td>{{vm.interestFreezeOldValue}}</td>
                                     <td ng-if="vm.preOrpTyp = 'M'">{{vm.interestFreezeNewValue}}</td>
                                 </tr>
                                 <tr>
                                     <td>Is transferring out from another bank allowed?</td>
                                     <td>{{vm.transferAnotherBankOldValue}}</td>
                                     <td ng-if="vm.preOrpTyp = 'M'">{{vm.transferAnotherBankNewValue}}</td>
                                 </tr>
                                 <tr>
                                     <td>Maker Reason</td>
                                     <td>{{vm.makerRemarksOldValue}}</td>
                                     <td ng-if="vm.preOrpTyp = 'M'">{{vm.makerRemarksNewValue}}</td>
                                 </tr>
                                 <tr>
                                     <td>Checker Reason</td>
                                     <td>{{vm.checkerRemarksOldValue}}</td>
                                     <td ng-if="vm.preOrpTyp = 'M'">{{vm.checkerRemarksNewValue}}</td>
                                 </tr>-->
                                </tbody>
                            </table>
                        </tr>
                        <tr>
                            <td width="50%">Checker Reason</td>
                            <td width="50%">
                                <textarea class="form-control" rows="3"
                                          maxlength="200" id="makerRemarks"
                                          name="checkerRemarks"
                                          ng-model="vm.checkerRemarks"
                                          required></textarea>
                            </td>
                        </tr>
                    </table>
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped list nowrap table-textWrap">
                            <thead>
                            <th>Name of the Holder</th>
                            <th>DOB</th>
                            <th>BLA No</th>
                            <th>Subscription ID</th>
                            <th>Bond Type</th>
                            <th>Subscription Amount</th>
                            <th>Account Open Date</th>
                            <th>Maturity Date</th>
                            <th>Last Interest Paid</th>
                            </thead>
                            <tbody>
                            <tr ng-repeat="items in vm.responseResultForVer">
                                <td>{{items.name}}</td>
                                <td>{{items.dob}}</td>
                                <td>{{items.blaNo}}</td>
                                <td>{{items.subscriptionId}}</td>
                                <td>{{items.bondType}}</td>
                                <td>{{vm.indianNumberFormat(items.subscriptionAmount)}}</td>
                                <td>{{items.accountOpenDate}}</td>
                                <td>{{items.maturityDate}}</td>
                                <td>{{items.lastInterestPaid}}</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="audit-details">
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created By </b> : {{vm.audit.createdBy}} </span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified By </b> : {{(vm.audit.modifiedBy) ? (vm.audit.modifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified By </b> : {{(vm.audit.verifiedBy) ? (vm.audit.verifiedBy) : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Verify Status </b> : {{vm.audit.verifiedStatus  | getLabelFromValuesArray : vm.commonYesNoMetaData}}</span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <span> <b> Created On </b> : {{ vm.audit.createdDate | date : 'dd-MM-yyyy'}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Modified On</b> : {{ (vm.audit.modifiedDate) ? (vm.audit.modifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                    <span> <b> Last Verified On </b> : {{(vm.audit.verifiedDate) ? (vm.audit.verifiedDate | date : 'dd-MM-yyyy') : ('None')}}</span>
                </div>
                <div class="col-md-3">
                </div>
            </div>
        </div>
        <div class="text-center form_submit">
            <button type="submit" class="btn btn-default" id="submitButton"
                    ng-disabled="blaForm.$invalid" ng-click="vm.verifySubmit()">Verify
            </button>
            <button type="submit" class="btn btn-default" id="rejectButton"
                    ng-click="vm.rejectReason()">Reject
            </button>
            <button type="button" id="cancelButton" class="btn btn-cancel"
                    onclick="window.location.href= '#!/freeze_unfreeze/action/verify';">Cancel
            </button>
        </div>
    </form>
</div>

<div class="modal" id="permissionMappingDelete" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-bs-dismiss="modal">&times;</button>
                <h4 class="modal-title"> REJECTION REMARKS</h4>
            </div>
            <div class="modal-body">
                <div class="loader_popup"></div>
                <div class="list_wrapper">
                    <form name="permissionDelete" role="form">

                        <div class="row">
                            <div class="form-group">
                                <div class="col-sm-2"></div>
                                <label class="control-label col-sm-3">Remarks</label>
                                <div class="col-sm-5">
                                    <select class="form-control list_wrapper" id="remarks[$index]"
                                            name="remarks[$index]"
                                            ng-model="vm.remarks" ng-init="vm.getRemarksList();" required>
                                        <option value="">Select</option>
                                        <option ng-repeat="item in vm.remarksList"
                                                name="{{item.subCode + parentIndex}}"
                                                id="{{item.subCode + parentIndex}}" value="{{item.subCodeDescription}}">
                                            {{item.subCodeDescription}}
                                        </option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-offset-5 col-sm-8 form_submit">
                            <button type="button" class="btn btn-default" data-bs-dismiss="modal"
                                    ng-disabled="permissionDelete.$invalid"
                                    ng-click="vm.deleteSubmit(vm.remarks)">
                                Submit
                            </button>
                            <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>





