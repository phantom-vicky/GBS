package com.isl.gbm.rbibond.dto;

import com.fasterxml.jackson.annotation.JsonInclude;

@JsonInclude(JsonInclude.Include.NON_NULL)
public class RbiBondCentralizedInterestTrialRunReportDto {

    private String depositBranchId;

    private String scssCustomerId;

    private String holderName;

    private String scssAccountNumber;

    private String interestPeriodFrom;

    private String interestPeriodTo;

    private String interestPaymentThrough;

    private String creditAccountNumber;

    private String interestAmountCalculated;

    private String tdsAmount;

    private String otherDeduction1;

    private String otherDeduction2;

    private String netAmount;

    private String operativeAccountNumber;


    public String getOperativeAccountNumber() {
        return operativeAccountNumber;
    }

    public void setOperativeAccountNumber(String operativeAccountNumber) {
        this.operativeAccountNumber = operativeAccountNumber;
    }

    public String getDepositBranchId() {
        return depositBranchId;
    }

    public void setDepositBranchId(String depositBranchId) {
        this.depositBranchId = depositBranchId;
    }

    public String getScssCustomerId() {
        return scssCustomerId;
    }

    public void setScssCustomerId(String scssCustomerId) {
        this.scssCustomerId = scssCustomerId;
    }

    public String getHolderName() {
        return holderName;
    }

    public void setHolderName(String holderName) {
        this.holderName = holderName;
    }

    public String getScssAccountNumber() {
        return scssAccountNumber;
    }

    public void setScssAccountNumber(String scssAccountNumber) {
        this.scssAccountNumber = scssAccountNumber;
    }

    public String getInterestPeriodFrom() {
        return interestPeriodFrom;
    }

    public void setInterestPeriodFrom(String interestPeriodFrom) {
        this.interestPeriodFrom = interestPeriodFrom;
    }

    public String getInterestPeriodTo() {
        return interestPeriodTo;
    }

    public void setInterestPeriodTo(String interestPeriodTo) {
        this.interestPeriodTo = interestPeriodTo;
    }

    public String getInterestPaymentThrough() {
        return interestPaymentThrough;
    }

    public void setInterestPaymentThrough(String interestPaymentThrough) {
        this.interestPaymentThrough = interestPaymentThrough;
    }

    public String getCreditAccountNumber() {
        return creditAccountNumber;
    }

    public void setCreditAccountNumber(String creditAccountNumber) {
        this.creditAccountNumber = creditAccountNumber;
    }

    public String getInterestAmountCalculated() {
        return interestAmountCalculated;
    }

    public void setInterestAmountCalculated(String interestAmountCalculated) {
        this.interestAmountCalculated = interestAmountCalculated;
    }

    public String getTdsAmount() {
        return tdsAmount;
    }

    public void setTdsAmount(String tdsAmount) {
        this.tdsAmount = tdsAmount;
    }

    public String getOtherDeduction1() {
        return otherDeduction1;
    }

    public void setOtherDeduction1(String otherDeduction1) {
        this.otherDeduction1 = otherDeduction1;
    }

    public String getOtherDeduction2() {
        return otherDeduction2;
    }

    public void setOtherDeduction2(String otherDeduction2) {
        this.otherDeduction2 = otherDeduction2;
    }

