                ", control='" + control + '\'' +
                ", userName='" + userName + '\'' +
                ", control1='" + control1 + '\'' +
                ", ACHFileNumber='" + achFileNumber + '\'' +
                ", control2='" + control2 + '\'' +
                ", control3='" + control3 + '\'' +
                ", ledgerFolioNumber='" + ledgerFolioNumber + '\'' +
                ", userDefLimit='" + userDefLimit + '\'' +
                ", totalAmtInPaise='" + totalAmtInPaise + '\'' +
                ", settlementDate='" + settlementDate + '\'' +
                ", reserved1='" + reserved1 + '\'' +
                ", reserved2='" + reserved2 + '\'' +
                ", filler1='" + filler1 + '\'' +
                ", userNumber='" + userNumber + '\'' +
                ", userReference='" + userReference + '\'' +
                ", sponsorBankIFSCMICRIIN='" + sponsorBankIFSCMICRIIN + '\'' +
                ", userBankAccountNumber='" + userBankAccountNumber + '\'' +
                ", totalItems='" + totalItems + '\'' +
                ", settlementCycle='" + settlementCycle + '\'' +
                ", filler2='" + filler2 + '\'' +
                '}';
    }

    public String getAchTransactionCode() {
        return achTransactionCode;
    }

    public void setAchTransactionCode(String achTransactionCode) {
