<div class="loader-new" ng-if="vm.loader"></div>
<dc-left-menu></dc-left-menu>
<div class="container from_wrapper new_form_wrapper">
    <h4 class="form_heading">Broker Master Maintenance - Modify</h4>
    <sol-header></sol-header>
    <form name="tdsparameter" role="form">

        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="moduleName" class="control-label">Name of the Module</label>
                </div>
                <div class="col-sm-2">
                    <label><b>RBI Bond</b></label>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Agency Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerAgencyCode" ng-init="vm.brokerAgencyCode=''" limit-To="30" min="1"
                           name="brokerAgencyCode" ng-model="vm.brokerMasterList.C002.oldValue" required readonly>
                    <span class="alert-danger" ng-if="vm.brokerAgencyCodeErrorMessage">{{vm.brokerAgencyCodeErrorMessage}}</span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerName" ng-init="" limit-To="20" min="1"
                           name="brokerName" ng-model="vm.brokerMasterList.C003.oldValue" required  ng-keypress="vm.validateInput($event,'brokerName')" >
                </div>
            </div>
        </div>







        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Group</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="brokerGroup" name="brokerGroup"
                            ng-model="vm.brokerMasterList.C005.oldValue" ng-init="vm.getBrokerGroupMetaData()" required disabled>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.brokerGroupList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                    </select>
                </div>


            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Broker Sort code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="brokerSortCode" chars="alpha-numeric" maxlength="10"
                           name="brokerSortCode" ng-model="vm.brokerMasterList.C006.oldValue" required readonly leading-space>
                </div>
            </div>
        </div>

        <!--<div class="row">
        <div class="form-group required">
            <div class="col-sm-2"></div>

                <label class="control-label col-sm-5">HDFC/OTHER BANK</label>
            <div class="col-sm-2">
                <input type="radio" id="hdfcOtherBankY" name="hdfcOtherBank" ng-model="vm.brokerMasterList.C007.oldValue" required value="Y">Yes
                <input type="radio" id="hdfcOtherBankN" name="hdfcOtherBank" ng-model="vm.brokerMasterList.C007.oldValue" required value="N">No
            </div>
        </div>
        </div>.-->



        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Operative Account Number</label>
                </div>
                <div class="col-sm-2" >
                    <input type="text" class="form-control" id="operativeAccNoY" ng-init="vm.operativeAccNo=''" chars="only-numbers" maxlength="25"
                           name="operativeAccNo" ng-model="vm.brokerMasterList.C008.oldValue" required>
                </div>

            </div>
        </div>



       <!-- <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">HDFC Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="branchCode" ng-init=""
                           name="branchCode" ng-model="vm.brokerMasterList.C010.oldValue"  chars="alpha-numeric"  required leading-space>
                </div>
            </div>
        </div>-->

        <div class="row" ng-if="vm.brokerMasterList.C005.oldValue=='I001'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Type Of Broker</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="brokerType" name="brokerType"
                            ng-model="vm.brokerMasterList.C011.oldValue"  ng-init="vm.getMetaData()" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.brokerTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>
                    </select>
                </div>
            </div>
        </div>



        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="gstNo" class="control-label" >GST No</label>
                </div>
                <div class="col-sm-2">
                    <input type="text"  class="form-control" id="gstNo" ng-model="vm.brokerMasterList.C013.oldValue" name="gstNo"
                           maxlength="15"  chars="alpha-numeric" oninput="this.value = this.value.replace(/\s+/g, '')">
                </div>
            </div>
        </div>

        <div class="row" >
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="panTan" class="control-label">PAN</label>
                </div>
                <div class="col-sm-2" >
                    <input type="text"  class="form-control"  ng-pattern="vm.panPattern"name="panTan" id="panTan"
                           ng-model="vm.brokerMasterList.C014.oldValue"  chars="alpha-numeric"
                           maxlength="10"
                           oninput="this.value = this.value.replace(/\s+/g, '')"
                           required>
                </div>
            </div>
        </div>
       <!-- <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="dateOfBirth" class="control-label">Brokerage Create Date</label>
                </div>
                <div class="col-sm-2">

                    <p class="input-group">
                        <input type="text" class="form-control" id="brokerageCreateDate"
                               name="brokerageCreateDate"  ng-model="vm.brokerMasterList.C021.oldValue" maxlength="10"
                               uib-datepicker-popup="dd/MM/yyyy" ng-init="vm.toDate='';vm.fromToDateValidation()"
                               is-open="vm.brokerageCreateDate.opened" close-text="Close"
                               datepicker-options="vm.dobCalenderOptions" required readonly>
                        <span class="input-group-btn" >
                                    <button type="button" class="btn btn-secondary"
                                            ng-click="vm.brokerageCreateDate.opened = true"
                                            id="brokerageCreateDatePicker">
                                        <i class="glyphicon glyphicon-calendar"></i>
                                    </button>
                </span></p>

                </div>
            </div>
        </div>-->
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="brokerageCreateDate" class="control-label">Brokerage Create Date</label>
                </div>
                <div class="col-sm-2">
                    <p class="input-group">
                        <input type="text" class="form-control" id="brokerageCreateDate"
                               name="brokerageCreateDate" maxlength="10"
                               uib-datepicker-popup="dd/MM/yyyy"
                               is-open="vm.brokerageCreateDate.opened" close-text="Close"
                               ng-model="vm.brokerMasterList.C021.oldValue"
                               datepicker-options="vm.dobCalenderOptions"  ng-blur="vm.textableDatePicker('brokerageCreateDate',vm.brokerMasterList.C021.oldValue);vm.futureNotAllowed('brokerageCreateDate',vm.brokerMasterList.C021.oldValue)"
                               ng-keyup="vm.autoslashing('brokerageCreateDate')" chars="numbers-slash"
                               required>
                        <!--                            <span class="input-group-btn">-->
                        <!--                    <button type="button" class="btn btn-secondary" id="dateOfBirthPicker"-->
                        <!--                            ng-click="vm.dateOfBirth.opened = true">-->
                        <!--                        <i class="glyphicon glyphicon-calendar"></i>-->
                        <!--                    </button>-->
                        <!--                </span>-->
                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Status</label>
                </div>
                <div class="col-sm-2">
                    <input type="radio" id="enable" name="status" ng-model="vm.brokerMasterList.C036.oldValue"  value="Y">Enable
                    <input type="radio" id="disable" name="status" ng-model="vm.brokerMasterList.C036.oldValue"  value="N">Disable

                    <!--                        <option value="GR">GST registered</option>-->
                        <!--                        <option value="GU">GST unregistered</option>-->
                        <!--                        <option value="I">Individual</option>-->
                        <!--                        <option value="NI">Non-individual</option>-->
                        <!--                        <option value="CG">Composite GST</option>-->
                        <!--                        <option ng-repeat="item in vm.moduleNameList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>-->

                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Payment Mode</label>
                </div>
                <div class="col-sm-2">
                    <select class="form-control" id="paymentMode" name="paymentMode"  ng-change="vm.bankCode='';vm.branchCode='';"
                            ng-model="vm.brokerMasterList.C023.oldValue" ng-init="vm.getPaymentMetaData()" required>
                        <option value="" >Select</option>
                        <option ng-repeat="item in vm.paymentTypeList" value="{{item.SUBCODE}}">{{item.DESCRIPTION}}</option>

                        <!--                        <option value="GR">GST registered</option>-->
                        <!--                        <option value="GU">GST unregistered</option>-->
                        <!--                        <option value="I">Individual</option>-->
                        <!--                        <option value="NI">Non-individual</option>-->
                        <!--                        <option value="CG">Composite GST</option>-->
                        <!--                        <option ng-repeat="item in vm.moduleNameList" value="{{item.subCode}}">{{item.subCodeDescription}}</option>-->
                    </select>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP001'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Operative Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="operativeAccNo" ng-init="vm.operativeAccNo=''" chars="alpha-numeric" maxlength="25"
                           name="operativeAccNo" ng-model="vm.brokerMasterList.C008.oldValue"    oninput="this.value = this.value.replace(/\s+/g, '')" required>
                </div>
            </div>
        </div>

        <div class="row"  ng-if="vm.brokerMasterList.C023.oldValue == 'MP003'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">DD Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="ddAccNo" chars="alpha-numeric" maxlength="25"
                           name="ddAccNo" ng-model="vm.brokerMasterList.C008.oldValue" required>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label for="rbiCode" class="control-label">Bank Name</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="nonBankName"
                           ng-model="vm.brokerMasterList.C025.oldValue" chars="alpha-numeric" required readonly>
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="nonBankNameSearch"
                           ng-click="vm.nonHdfcTorchM('bankName');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.brokerMasterList.C025.oldValue='';vm.brokerMasterBankCode='';"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
            <div class="form-group required">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label class="control-label">Operative Account Number</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="operativeAccNo" ng-init="vm.operativeAccNo=''" chars="alpha-numeric" maxlength="25"
                           name="operativeAccNo" ng-model="vm.brokerMasterList.C008.oldValue"  oninput="this.value = this.value.replace(/\s+/g, '')" required>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">IFSC Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="instIfscCode" name="instIfscCode"
                           ng-model="vm.brokerMasterList.C026.oldValue"
                           ng-keypress="vm.ifscKeypress($event)"
                           ng-blur="vm.applyIfscToModifyField()"
                           ng-pattern="vm.ifscPattern" maxlength="11"
                           ng-required="!(vm.brokerMasterList.C027 && vm.brokerMasterList.C027.oldValue && vm.brokerMasterList.C027.oldValue.length > 0)">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="instIfscCodeSearch"
                           ng-click="vm.nonHdfcTorchM('ifsc');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.brokerMasterList.C026.oldValue='';"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Code Loc</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrCodeLoc" maxlength="3"
                           ng-model="vm.brokerMasterList.C027.oldValue" chars="alpha-numeric"
                           ng-required="!(vm.brokerMasterList.C026 && vm.brokerMasterList.C026.oldValue && vm.brokerMasterList.C026.oldValue.length > 0)">
                </div>

            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Bank Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBankCode"
                           ng-model="vm.brokerMasterList.C028.oldValue" chars="alpha-numeric"  maxlength="3">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="micrBankCodeSearch"
                           ng-click="vm.nonHdfcTorchM('micrCodeBank');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.brokerMasterList.C028.oldValue='';"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="row" ng-if="vm.brokerMasterList.C023.oldValue == 'MP002'|| vm.brokerMasterList.C023.oldValue == 'MP004' || vm.brokerMasterList.C023.oldValue == 'MP005'">
            <div class="form-group">
                <div class="col-sm-2"></div>
                <div class="col-sm-5">
                    <label  class="control-label">MICR Branch Code</label>
                </div>
                <div class="col-sm-2">
                    <input type="text" class="form-control" id="micrBranchCode"
                           ng-model="vm.brokerMasterList.C029.oldValue" chars="alpha-numeric" maxlength="3">
                </div>
                <div class="col-sm-1">
                    <div>
                        <i class="glyphicon glyphicon-search cp" data-bs-toggle="modal"
                           id="micrBranchCodeSearch"
                           ng-click="vm.nonHdfcTorchM('micrBranchCode');"></i> <i
                            class="glyphicon glyphicon-remove clear cp"
                            ng-click="vm.brokerMasterList.C029.oldValue='';"></i>
                    </div>
                </div>
            </div>
        </div>


