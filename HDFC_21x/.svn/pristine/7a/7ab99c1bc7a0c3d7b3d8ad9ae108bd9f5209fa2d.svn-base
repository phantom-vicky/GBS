<div class="loader-new" ng-if="vm.loader"></div>
<div class="container" ng-if="vm.dailyRemittanceLcList.length>0">
    <div class="text-right form_submit">
        <button type="submit" class="btn btn-default"
                onclick="window.location.href ='#!';" id="homeButton">Home</button>
        <button type="submit" class="btn btn-default"
                id="printButton" ng-click="vm.printpage();">Print</button>
        <button type="submit" id="backButton" class="btn btn-cancel"
                onclick="window.location.href='#!/rbiBond_daily_remit_lc/action/inquiry';">Back</button>
    </div>
    <div  class="container from_wrapper new_form_wrapper" id="section-to-print">
        <div class="col-sm-12">
<!--            <h4 class="form_heading">Daily Remittance to Link Cell </h4>-->
            <table class="table report-title-table">
                <tr>
                    <td>
                        <h5 class="modal-title">Bank Name :{{vm.bankName}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Branch Name : {{vm.loginSolDesc}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Branch Id : {{vm.loginSolId}}</h5>
                    </td>
                </tr>
                <tr>
                    <td>
                        <h5 class="modal-title">Scheme Name : {{vm.schemeName}}</h5>
                    </td>
                </tr>
            </table>

            <div>
                <table  width="100%">
                    <tr height="40">
                        <td><h4 class="form_heading">Daily Remittance to Link Cell</h4></td>
                    </tr>
                    <tr height="40">
                        <td align="right">Subscription Date: {{vm.date}}</td>
                    </tr>
                    <tr height="40">
                        <td align="left">Senior Manager</td>
                    </tr>
                    <tr height="40">
                        <td align="left">{{vm.bankName}}</td>
                    </tr>
                    <tr height="40">
                        <td align="left">Link Cell, {{vm.loginSolDesc}}</td>
                    </tr>
                    <tr height="40" rowspan="2">
                        <td align="left">{{vm.reg}}</td>
                    </tr>
                </table>
            </div>
            </br>
            <div class="row">
                <div class="col-sm-12">
                    <div class="table-responsive">


                        <table class="table table-bordered table-striped list">
                            <thead>

                            <tr class="thalign">
                                <th rowspan="2">S.NO</th>
                                <th rowspan="2">BL A/C No.</th>
                                <th rowspan="2">Name of the A/C Holder</th>
                                <th rowspan="2">Subscription ID</th>
                                <th colspan="2">Amount</th>
                                <th rowspan="2">Total</th>
                            </tr>

                            <tr CLASS="heading">
                            <th>Cumulative</th>
                            <th>Non-Cumulative</th>
                            </tr>
                            </thead>

                            <tbody>
                            <tr ng-repeat="x in vm.dailyRemittanceLcList">
                                <td>{{vm.itemsPerPage *(vm.currentPage-1)+$index+1}}</td>
                                <td align="center">{{x.blaNo}}</td>
                                <td align="left">{{x.holderName}}</td>
                                <td align="left">{{x.subsId}}</td>
                                <td align="right">{{x.culAmount}}</td>
                                <td align="right">{{x.nonCulAmount}}</td>
                                <td align="right">{{x.total}}</td>
                            </tr>
                            <tr>
                                <th align="center" colspan="4">Total</th>
                                <td align="right">{{vm.totCulAmt}}</td>
                                <td align="right">{{vm.totNonCulAmt}}</td>
                                <td align="right">{{vm.totAmt}}</td>
                            </tr>

                            </tbody>

                        </table>
                         <br><br><br>
                        <div>
                        <table>
                            <tr>
                                <td align="right" colspan="7" style="padding-left: 100rem;">Branch Manager</td>
                            </tr>
                        </table>
                          <br><br>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>
<div class="container" ng-if="vm.noDataFound">
    <div class="list_wrapper no_records_message">
        <h4 class="form_heading">Daily Remittance to Link Cell</h4>
        No records found to display.
        <center>
            <button type="button" class="btn btn-default"
                    onclick="window.location.href='#!/rbiBond_daily_remit_lc/inquiry';">Back</button>
        </center>
    </div>
</div>
